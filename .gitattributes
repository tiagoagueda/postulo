# Normalise to LF in the repository; Git may check out CRLF locally on Windows.
* text=auto eol=lf

# Translations are text but tooling is picky about them
*.po text eol=lf
*.pot text eol=lf
*.mo binary
*.ttf binary

# Built from assets/css/app.css and the templates by `npm run build:css`. Marked so a
# forge collapses it by default and nobody reviews it line by line -- but *not* `-diff`,
# because since #159 it is written expanded and the diff is worth reading: a Tailwind
# upgrade that changes a base rule shows up as a handful of lines.
src/postulo/static/css/app.css linguist-generated=true

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.sqlite3 binary

# Generated; keep diffs quiet in review
uv.lock linguist-generated=true

# The official catalogue is signed over its exact bytes, so nothing may rewrite them.
catalogue/official/* -text

# Vendored exactly as the package ships it. leaflet's stylesheet and licence arrive with CRLF line
# endings, and `npm run sync:vendor` copies bytes: normalising them to LF here made the copy in the
# repository differ from the copy in node_modules on every machine that is not a Windows one.
src/postulo/static/js/vendor/leaflet/LICENSE.txt -text
src/postulo/static/js/vendor/leaflet/leaflet.css -text

# European Digital Credentials kept as test fixtures (#670): a seal covers exact bytes, so
# not a newline is changed on the way in or out.
tests/data/edc/*.jsonld -text
