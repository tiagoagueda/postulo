# Normalise to LF in the repository; Git may check out CRLF locally on Windows.
* text=auto eol=lf

# Translations are text but tooling is picky about them
*.po text eol=lf
*.pot text eol=lf
*.mo binary

# Built from assets/css/app.css and the templates by `npm run build:css`. Marked so a
# forge collapses it by default and nobody reviews it line by line -- but *not* `-diff`,
# because since #159 it is written expanded and the diff is worth reading: a Tailwind
# upgrade that changes a base rule shows up as a handful of lines.
src/postulo/static/css/app.css linguist-generated=true

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.sqlite3 binary

# Generated; keep diffs quiet in review
uv.lock linguist-generated=true
