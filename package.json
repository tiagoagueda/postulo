{
  "name": "postulo-assets",
  "private": true,
  "description": "Stylesheet and icon build for Postulo. Node is only needed to change the CSS or the icon set; the results are committed so the application runs without it.",
  "scripts": {
    "build:css": "tailwindcss --input assets/css/app.css --output src/postulo/static/css/app.css --minify",
    "watch:css": "tailwindcss --input assets/css/app.css --output src/postulo/static/css/app.css --watch",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:vendor": "node scripts/sync-vendor.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "axe-core": "^4.13.0",
    "lucide-static": "1.41.0",
    "tailwindcss": "^4.0.0"
  }
}
