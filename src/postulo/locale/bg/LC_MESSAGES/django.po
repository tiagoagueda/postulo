msgstr "Този файл влага частите си по-дълбоко, отколкото го прави календар."

#: src/postulo/jobs/logos.py
#, python-format
msgid "That file took longer than %(seconds)s second to arrive."
msgid_plural "That file took longer than %(seconds)s seconds to arrive."
msgstr[0] "Пристигането на файла отне повече от %(seconds)s секунда."
msgstr[1] "Пристигането на файла отне повече от %(seconds)s секунди."

