#: src/postulo/core/messaging_services.py
#, python-format
msgid "That does not look like a handle on %(service)s. Choose “Other” to list a handle of another shape."
msgstr "Това не прилича на потребителско име в %(service)s. Изберете „Друго“, за да добавите потребителско име с друга форма."

