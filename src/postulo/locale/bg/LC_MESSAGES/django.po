#: src/postulo/core/channels.py src/postulo/core/phones.py
msgid "That number has no country in front of it, so nowhere else can dial it. Choose the country, or write it starting with +."
msgstr "Пред този номер няма код на държава, затова не може да бъде набран от другаде. Изберете държавата или го въведете, започвайки с +."

#: src/postulo/core/phone_numbers.py
msgid "That number has to be confirmed before it can get you back in."
msgstr "Този номер трябва да бъде потвърден, преди да може да ви помогне да влезете отново."

#: src/postulo/core/phone_numbers.py
msgid "That number is already recorded on this instance as somebody's own. A person's own telephone numbers are kept unique across every account here, so it may belong to somebody else."
msgstr "Този номер вече е записан в тази инстанция като собствен номер на някого. Собствените телефонни номера на човек са уникални за всички акаунти тук, така че може да принадлежи на някой друг."

#: src/postulo/core/phones.py
#, python-format
msgid "That number is not a length %(country)s uses."
msgstr "Този номер няма дължина, която се използва в %(country)s."

#: src/postulo/core/phones.py
#, python-format
msgid "That number is too long for %(country)s."
msgstr "Този номер е твърде дълъг за %(country)s."

#: src/postulo/core/phones.py
msgid "That number is too long."
msgstr "Този номер е твърде дълъг."

#: src/postulo/core/phones.py
#, python-format
msgid "That number is too short for %(country)s."
msgstr "Този номер е твърде къс за %(country)s."

#: src/postulo/core/phones.py
msgid "That number is too short."
msgstr "Този номер е твърде къс."

#: src/postulo/core/server_views.py
msgid "That package is no longer waiting; upload it again."
msgstr "Този пакет вече не чака; качете го отново."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "That page could not be fetched: %(reason)s"
msgstr "Тази страница не можа да бъде извлечена: %(reason)s"

#: src/postulo/plugins/fetching.py
#, python-format
msgid "That page is larger than %(limit)s MB, so it was not read."
msgstr "Тази страница е по-голяма от %(limit)s МБ, затова не беше прочетена."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "That page returned %(status)s."
msgstr "Тази страница върна %(status)s."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "That page took longer than %(seconds)s second to arrive, so it was not read."
msgid_plural "That page took longer than %(seconds)s seconds to arrive, so it was not read."
msgstr[0] "Зареждането на страницата отне повече от %(seconds)s секунда, затова тя не беше прочетена."
msgstr[1] "Зареждането на страницата отне повече от %(seconds)s секунди, затова тя не беше прочетена."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "That page was sent with the content encoding “%(coding)s”, which Postulo does not unpack, so it was not read."
msgstr "Тази страница е изпратена с кодиране на съдържанието „%(coding)s“, което Postulo не разопакова, затова не беше прочетена."

#: src/postulo/applications/forms.py
msgid "That person is not recorded at this service."
msgstr "Това лице не е записано в тази служба."

#: src/postulo/accounts/avatars.py
#, python-format
msgid "That picture is over %(megabytes)s MB. A smaller one, please."
msgstr "Това изображение е над %(megabytes)s MB. Моля, изберете по-малко."

#: src/postulo/plugins/views.py
msgid "That plugin is no longer installed."
msgstr "Тази добавка вече не е инсталирана."

#: src/postulo/plugins/syncing.py src/postulo/plugins/views.py
msgid "That plugin is switched off for you."
msgstr "Тази добавка е изключена за вас."

#: src/postulo/jobs/surface.py
msgid "That record is not yours to change."
msgstr "Нямате право да променяте този запис."

#: src/postulo/core/mail_auth.py src/postulo/plugins/consent.py
msgid "That reply did not come from a request Postulo made."
msgstr "Този отговор не идва от заявка, направена от Postulo."

#: src/postulo/core/views_access.py
msgid "That rule existed, and is changed."
msgstr "Това правило вече съществуваше и е променено."

#: src/postulo/applications/views.py
msgid "That suggestion has already been answered."
msgstr "На това предложение вече е отговорено."

#: src/postulo/jobs/capture_views.py
msgid "That was the last capture waiting."
msgstr "Това беше последното чакащо прихващане."

#: src/postulo/core/design.py
msgid "That worked."
msgstr "Получи се."

#: src/postulo/jobs/models.py
#, python-format
msgid "That would make a loop: %(name)s is already part of this one."
msgstr "Това би създало цикъл: %(name)s вече е част от тази верига."

#: src/postulo/jobs/models.py
#, python-format
msgid "That would make a loop: %(name)s was already acquired by this one."
msgstr "Това би създало кръг: %(name)s вече е придобита от тази компания."

#: src/postulo/applications/views.py src/postulo/jobs/views.py
#, python-format
msgid "The %(count)d document you sent is kept, and still says where it went."
msgid_plural "The %(count)d documents you sent are kept, and still say where they went."
msgstr[0] "%(count)d изпратен документ се запазва и продължава да сочи къде е отишъл."
msgstr[1] "%(count)d изпратени документа се запазват и продължават да сочат къде са отишли."

#: src/postulo/jobs/views.py
#, python-format
msgid "The %(count)d file its history points at is kept where it is."
msgid_plural "The %(count)d files its history points at are kept where they are."
msgstr[0] "%(count)d файл, към който сочи историята му, остава там, където е."
msgstr[1] "%(count)d файла, към които сочи историята му, остават там, където са."

#: src/postulo/documents/pdf.py
#, python-format
msgid "The %(name)s PDF backend is configured but not usable. %(hint)s"
msgstr "PDF модулът %(name)s е конфигуриран, но не може да се използва. %(hint)s"

#: src/postulo/documents/archiving.py src/postulo/plugins/syncing.py
#, python-format
msgid "The %(plugin)s plugin is not installed."
msgstr "Добавката %(plugin)s не е инсталирана."

#: src/postulo/documents/models.py src/postulo/documents/themes.py
#, python-format
msgid "The %(theme)s theme does not set this type of document."
msgstr "Темата %(theme)s не оформя този вид документи."

#: src/postulo/templates/server/logs.html
msgid "The /logs endpoint is on and has no token."
msgstr "Крайната точка /logs е включена и няма токен."

#: src/postulo/resume/importing.py
#, python-format
msgid "The address %(address)s is already listed for somebody you deal with, so it was not added."
msgstr "Адресът %(address)s вече е записан за някого, с когото си имате работа, затова не беше добавен."

#: src/postulo/jobs/logos.py src/postulo/resume/links.py
#, python-format
msgid "The address answered %(code)s."
msgstr "Адресът отговори %(code)s."

#: src/postulo/jobs/logos.py
msgid "The address answered with nothing."
msgstr "Адресът не върна нищо."

#: src/postulo/jobs/tiles.py
msgid "The address must hold {z}, {x} and {y}, where each tile's numbers go."
msgstr "Адресът трябва да съдържа {z}, {x} и {y} на местата, където се поставят номерата на всяка плочка."

#: src/postulo/core/server_forms.py
msgid "The address people see it came from. Many servers refuse to send as an address they do not host."
msgstr "Адресът, от който хората виждат, че идва писмото. Много сървъри отказват да изпращат от адрес, който не обслужват."

#: src/postulo/applications/forms.py
msgid "The agency or employment service it went through, from the companies you have recorded. Companies in Employment activities, and public employment services, are offered first; add that industry to a company to have it offered here. The company on the posting stays the employer."
msgstr "Агенцията или службата по заетостта, чрез която е минала, измежду записаните от вас компании. Първо се предлагат компаниите с отрасъл „Дейности по наемане и предоставяне на работна сила“ и публичните служби по заетостта; добавете този отрасъл към компания, за да се предлага тук. Компанията от обявата остава работодател."

#: src/postulo/resume/lookups.py
#, python-format
msgid "The answer from %(service)s could not be read."
msgstr ""

#: src/postulo/resume/lookups.py
#, python-format
msgid "The answer from %(service)s was larger than a record should be."
msgstr ""

#: src/postulo/jobs/models.py
msgid "The application deadline, if stated."
msgstr "Крайният срок за кандидатстване, ако е посочен."

#: src/postulo/core/server_forms.py
msgid "The application registered with the provider. Not a secret: it is the secret beside it that is."
msgstr "Приложението, регистрирано при доставчика. Не е тайна — тайната е стойността до него."

#: src/postulo/core/mail_choices.py
msgid "The application sends on its own"
msgstr "Приложението изпраща самостоятелно"

#: src/postulo/templates/server/backup_restore.html
msgid "The archive is signed by this instance's key."
msgstr "Архивът е подписан с ключа на тази инстанция."

#: src/postulo/templates/server/backup_restore.html
msgid "The archive opens and its database matches its checksum."
msgstr "Архивът се отваря и базата данни в него съвпада с контролната си сума."

#: src/postulo/accounts/forms.py
msgid "The arrows on Your career move an entry past its neighbour. If you cannot use them, or would rather type a number, each entry's form shows its place as a number: lower first."
msgstr "Стрелките в „Вашата кариера“ преместват запис покрай съседния. Ако не можете да ги използвате или предпочитате да въведете число, формулярът на всеки запис показва мястото му като число: по-малкото е по-напред."

#: src/postulo/templates/settings/appearance.html
msgid "The arrows put them in your order, and the order decides what stays in reach: the row across the top holds as many as there is room for and the rest are under More, and the bar at the foot of a phone's screen holds them all in this order, scrolling sideways where they do not fit."
msgstr ""

#: src/postulo/resume/forms.py
msgid "The association, society or club, as a CV should print it. It is linked to the company of that name among yours, and added to your companies if there is none. A membership of a union, a party or a congregation says something about you, and is yours to leave off any CV; nothing here asks for one."
msgstr "Асоциацията, дружеството или клубът, както трябва да се отпечата в автобиографията. Свързва се с компанията с това име сред вашите и се добавя към компаниите ви, ако няма такава. Членството в синдикат, партия или религиозна общност казва нещо за вас и сами решавате дали да го пропуснете от автобиографията; нищо тук не го изисква."

#: src/postulo/documents/forms.py
msgid "The author, and the title with your name in it, go into the PDF's properties, as they always have. Untick it to send files without them."
msgstr "Авторът и заглавието с вашето име отиват в свойствата на PDF файла, както винаги досега. Премахнете отметката, за да изпращате файлове без тях."

#: src/postulo/core/design.py
msgid "The background. Everything else is above it."
msgstr "Фонът. Всичко останало е над него."

#: src/postulo/core/slow.py
msgid "The backup is written and checked."
msgstr "Резервното копие е записано и проверено."

#: src/postulo/templates/server/design.html
msgid "The box first, the question beside it, and what it means under that."
msgstr "Първо полето, въпросът до него и какво означава под него."

#: src/postulo/accounts/forms.py
msgid "The breadcrumb is a thin line under the bar that opens while the pointer or the keyboard focus is on it, and closes on Escape. A touch screen has no hover, so there it is drawn whole."
msgstr "Навигационната пътечка е тънка линия под лентата, която се разгъва, докато показалецът или фокусът на клавиатурата е върху нея, и се затваря с Escape. Сензорният екран няма посочване, затова там тя се показва изцяло."

#: src/postulo/templates/jobs/company_map.html
msgid "The browser could not say where you are. The map stays where it was."
msgstr "Браузърът не можа да определи къде се намирате. Картата остава където беше."

#: src/postulo/templates/jobs/company_map.html
msgid "The browser was not allowed to say where you are, so the map stays where it was."
msgstr "Браузърът няма разрешение да съобщи къде се намирате, затова картата остава където беше."

#: src/postulo/accounts/forms.py
msgid "The calendar and the reports start their weeks on it. Left at the language's usual, it follows the language you read Postulo in."
msgstr "Календарът и отчетите започват седмиците си от този ден. Ако е оставено „Обичайното за езика“, той следва езика, на който четете Postulo."

#: src/postulo/templates/help/calendar.html
msgid "The calendar can be downloaded as an iCalendar file, for the period and kinds on the screen, and a file from another calendar can be read in, with a review of what it holds before anything is added."
msgstr "Календарът може да бъде изтеглен като файл iCalendar за периода и видовете, показани на екрана, а файл от друг календар може да бъде импортиран, като преди да се добави каквото и да е, се преглежда съдържанието му."

#: src/postulo/accounts/forms.py
msgid "The calendar's period buttons"
msgstr "Бутоните за период на календара"

#: src/postulo/templates/jobs/capture_page_forget.html
msgid "The capture stays as it is, and so does any listing it became."
msgstr "Прихващането остава както е, както и всяка обява, в която се е превърнало."

#: src/postulo/templates/jobs/contact_vcards.html
msgid "The cards in the file"
msgstr "Картите във файла"

#: src/postulo/plugins/catalogue.py
#, python-format
msgid "The catalogue expired on %(date)s; an old copy may have been served."
msgstr "Каталогът е изтекъл на %(date)s; възможно е да е предоставено старо копие."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue is not readable JSON."
msgstr "Каталогът не е четим JSON."

#: src/postulo/plugins/catalogue.py
#, python-format
msgid "The catalogue is older than one already seen (%(old)d, after %(new)d)."
msgstr "Каталогът е по-стар от вече видян (%(old)d след %(new)d)."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue's expiry is not a date."
msgstr "Срокът на валидност на каталога не е дата."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue's serial number is not a counter."
msgstr "Серийният номер на каталога не е брояч."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue's signature does not match its contents; it was not used."
msgstr "Подписът на каталога не съответства на съдържанието му; той не беше използван."

#: src/postulo/plugins/catalogue.py
#, python-format
msgid "The catalogue's signature or key is not readable: %(error)s"
msgstr "Подписът или ключът на каталога не е четим: %(error)s"

#: src/postulo/core/server_views.py
msgid "The catalogues answered, and list nothing yet."
msgstr "Каталозите отговориха, но още не съдържат нищо."

#: src/postulo/resume/registry.py
msgid "The categories you hold, as codes. Postulo never keeps the licence number, a photograph or anything else a licence carries."
msgstr "Категориите, които притежавате, като кодове. Postulo никога не пази номера на свидетелството, снимка или каквото и да е друго от него."

#: src/postulo/resume/forms.py
msgid "The chapter's number or name, where you are citing a chapter."
msgstr "Номерът или заглавието на главата, ако цитирате глава."

#: src/postulo/templates/jobs/company_map.html
msgid "The city dataset has not been downloaded on this instance, so no place is on the map: run manage.py fetch_geonames to download it."
msgstr "Наборът данни за градове не е изтеглен в тази инстанция, затова няма места на картата: изпълнете manage.py fetch_geonames, за да го изтеглите."

#: src/postulo/templates/server/email.html
#, python-format
msgid "The client secret is set by <code>%(variable)s</code> in the environment; change it there. It is never shown here."
msgstr "Клиентската тайна е зададена от <code>%(variable)s</code> в средата; променете я там. Тук никога не се показва."

#: src/postulo/documents/printing.py
msgid "The code repository chosen for this CV is no longer in your details, so it prints none."
msgstr "Хранилището с код, избрано за тази автобиография, вече не е във вашите данни, затова не се отпечатва нито едно."

#: src/postulo/resume/forms.py
msgid "The Common European Framework levels. “Not stated” prints nothing at all, which is the honest answer where you have never been tested — a level is a claim somebody may test in an interview."
msgstr "Нивата от Общата европейска референтна рамка. „Не е посочено“ не отпечатва нищо, което е честният отговор, ако никога не са ви оценявали — нивото е твърдение, което някой може да провери на интервю."

#: src/postulo/templates/jobs/company_places.html
msgid "The companies' addresses on the map, as a file other mapping tools read, and points read back in."
msgstr "Адресите на компаниите на картата като файл, който други картографски инструменти могат да четат, и обратно импортиране на точки."

#: src/postulo/templates/partials/import_owner.html
msgid "The companies, contacts and listings it adds. Applications and notes are always yours."
msgstr "Компаниите, контактите и обявите, които добавя. Кандидатурите и бележките винаги са ваши."

#: src/postulo/core/kind_files.py
#, fuzzy, python-format
msgid "The company %(name)s is not in your account, and is added with it."
msgstr "Компанията %(name)s я няма във вашия акаунт, затова се добавя заедно с него."

#: src/postulo/templates/jobs/company_places.html
msgid "The company has no address to place."
msgstr "Компанията няма адрес, който да бъде поставен."

#: src/postulo/templates/jobs/company_wikidata.html
msgid "The company has no address to put it on: add one, and fetch again."
msgstr "Компанията няма адрес, към който да се добави: добавете адрес и изтеглете отново."

#: src/postulo/templates/applications/application_intake.html
msgid "The company is matched by name and created if it is new. Only the company and the job title are required; everything else can be filled in later."
msgstr "Компанията се съпоставя по име и се създава, ако е нова. Задължителни са само компанията и длъжността; всичко останало може да се попълни по-късно."

#: src/postulo/applications/forms.py
msgid "The company is recorded as dissolved. Tick this to add the listing."
msgstr "Компанията е записана като прекратена. Отметнете това, за да добавите обявата."

#: src/postulo/jobs/models.py
msgid "The company it became part of, if that company is recorded here."
msgstr "Компанията, от която е станала част, ако тази компания е записана тук."

#: src/postulo/jobs/models.py
msgid "The company this one belongs to, if it belongs to one."
msgstr "Компанията, към която принадлежи тази, ако принадлежи към някоя."

#: src/postulo/documents/models.py
msgid "The company you are applying to"
msgstr "Компанията, в която кандидатствате"

#: src/postulo/jobs/register_lookup.py
msgid "the company's LEI"
msgstr ""

#: src/postulo/core/web_links.py
msgid "The company's LinkedIn page, or wherever it posts."
msgstr "Страницата на компанията в LinkedIn или където другаде публикува."

#: src/postulo/core/web_links.py
msgid "The company's own pages: its LinkedIn page, its Mastodon or Bluesky account, its YouTube channel — as many as are worth keeping, with one marked as the one to show."
msgstr "Собствените страници на компанията: страницата ѝ в LinkedIn, акаунтът ѝ в Mastodon или Bluesky, каналът ѝ в YouTube — колкото си струва да се пазят, като един е отбелязан за показване."

#: src/postulo/jobs/register_lookup.py
msgid "the company's register number"
msgstr ""

#: src/postulo/documents/archiving.py src/postulo/notifications/webhooks.py
msgid "The connection is gone or switched off."
msgstr "Връзката липсва или е изключена."

#: src/postulo/plugins/secrets.py
msgid "The connection's secrets cannot be read: they were encrypted under a different key. If SECRET_KEY was rotated, set POSTULO_FIELD_KEY to the old key, or enter the secrets again."
msgstr "Тайните на връзката не могат да бъдат прочетени: шифровани са с друг ключ. Ако SECRET_KEY е сменен, задайте POSTULO_FIELD_KEY на стария ключ или въведете тайните отново."

#: src/postulo/templates/help/contact_block.html
msgid "The contact block is what a CV prints under your name, and each CV chooses which parts of it to print under its own <em>Settings</em>. A letter prints only your email address, your telephone number and where you are."
msgstr "Блокът за контакт е онова, което автобиографията отпечатва под името ви, а всяка автобиография избира кои части от него да отпечата в собствените си <em>Настройки</em>. Писмото отпечатва само имейл адреса ви, телефонния ви номер и къде се намирате."

#: src/postulo/documents/views.py
msgid "The copy could not be sent; the document says why."
msgstr "Копието не можа да бъде изпратено; документът показва защо."

#: src/postulo/core/server_forms.py
msgid "The credit the tiles' licence asks for, drawn on the map as plain text. For example: © OpenStreetMap contributors"
msgstr "Указанието за авторство, което изисква лицензът на плочките, показано на картата като обикновен текст. Например: © OpenStreetMap contributors"

#: src/postulo/templates/settings/appearance.html
msgid "The dashboard lists open applications nothing has happened to for a while, with nothing planned. Recruiters' own advice clusters around two to three weeks."
msgstr "Таблото за управление изброява отворени кандидатури, с които от известно време нищо не се е случило и нищо не е планирано. Самите рекрутери най-често съветват да се изчакат две до три седмици."

#: src/postulo/api/routers/companies.py src/postulo/jobs/forms.py
msgid "The date cannot be in the future."
msgstr "Датата не може да бъде в бъдещето."

#: src/postulo/jobs/models.py
msgid "The date it became true, if known."
msgstr "Датата, от която е вярно, ако е известна."

#: src/postulo/documents/forms.py
msgid "The date on the letter, as a date. Leave it empty when you do not know."
msgstr "Датата на писмото, като дата. Оставете полето празно, ако не я знаете."

#: src/postulo/applications/forms.py
msgid "The date you mean to have sent it by. It is not a reminder — set one of those if you want telling."
msgstr "Датата, до която смятате да сте го изпратили. Не е напомняне — задайте напомняне, ако искате да ви бъде напомнено."

#: src/postulo/jobs/forms.py
msgid "The day it was true or reported, not today's date unless it is."
msgstr "Денят, в който е било вярно или е съобщено, а не днешната дата, освен ако не е тя."

#: src/postulo/resume/forms.py
msgid "The day you read the count. A count changes, so a CV prints the month and the year beside it."
msgstr ""

#: src/postulo/templates/server/plugins.html
msgid "The default for every account. One person's exceptions are on their row under People. Switching a plugin off stops it being used and deletes nothing."
msgstr "Стойността по подразбиране за всеки акаунт. Изключенията за отделен човек са на неговия ред в „Хора“. Изключването на добавка спира използването ѝ и не изтрива нищо."

#: src/postulo/jobs/capture_views.py
msgid "the discarded captures"
msgstr "отхвърлените прихващания"

#: src/postulo/plugins/catalogue.py
msgid "The download could not be saved here."
msgstr "Изтегленото не може да бъде запазено тук."

#: src/postulo/plugins/catalogue.py
msgid "The download is far larger than a plugin should be."
msgstr "Изтегленият файл е много по-голям, отколкото би трябвало да е една добавка."

#: src/postulo/plugins/catalogue.py
msgid "The download is taking too long."
msgstr "Изтеглянето отнема твърде дълго."

#: src/postulo/documents/models.py
msgid "The earlier version this supersedes. The old file is kept."
msgstr "По-ранната версия, която тази заменя. Старият файл се пази."

#: src/postulo/resume/forms.py
msgid "The edition or version, as it says on it."
msgstr "Изданието или версията, както пише на него."

#: src/postulo/documents/printing.py
msgid "The email address chosen for this CV is no longer one of your confirmed addresses, so it prints none."
msgstr "Имейл адресът, избран за тази автобиография, вече не е един от потвърдените ви адреси, затова не се отпечатва нито един."

#: src/postulo/applications/forms.py
msgid "The employer as a whole"
msgstr "Работодателят като цяло"

#: src/postulo/jobs/forms.py
msgid "The employer's own closing date, if the posting gives one. Empty means unknown, not open forever."
msgstr "Собствената крайна дата на работодателя, ако обявата дава такава. Празното означава неизвестно, а не отворено завинаги."

#: src/postulo/resume/candidate.py
msgid "The entry it belongs to cannot be added."
msgstr "Записът, към който принадлежи, не може да бъде добавен."

#: src/postulo/resume/candidate.py
msgid "The entry it belongs to is not in the file."
msgstr "Записът, към който принадлежи, не е във файла."

#: src/postulo/documents/forms.py
msgid "The entry of your career this is the proof of. Used for a certificate, a diploma or a diploma supplement; a diploma and its supplement point at the same entry."
msgstr "Записът от кариерата ви, който това доказва. Използва се за сертификат, диплома или приложение към диплома; дипломата и приложението към нея сочат към един и същ запис."

#: src/postulo/core/server_views.py src/postulo/plugins/forms.py
#, python-format
msgid "The environment sets “%(name)s”, so it cannot be changed here."
msgstr "Средата задава „%(name)s“, затова не може да се променя тук."

#: src/postulo/templates/500.html
msgid "The error has been logged. If you administer this instance, the server log will have the details."
msgstr "Грешката е записана в дневника. Ако администрирате тази инстанция, подробностите са в дневника на сървъра."

#: src/postulo/templates/resume/item_form.html
#, python-format
msgid "The ESCO classification knows this skill as “%(name)s”. Where you have not written your own, a CV in another of the classification's languages prints the name it gives the skill there."
msgstr "Класификацията ESCO познава това умение като „%(name)s“. Където не сте написали собствено, автобиография на друг от езиците на класификацията отпечатва името, което тя дава на умението там."

#: src/postulo/resume/forms.py
msgid "The event’s name, as a CV should print it: “PyCon Portugal 2025”."
msgstr "Името на събитието, както трябва да се отпечата в автобиографията: „PyCon Portugal 2025“."

#: src/postulo/templates/jobs/industry_list.html
msgid "The fields your companies operate in, in your own words. A company may be in several."
msgstr "Областите, в които компаниите ви работят, с ваши думи. Една компания може да е в няколко."

#: src/postulo/applications/forms.py
msgid "The figure as they wrote it, before tax."
msgstr "Сумата, както са я написали, преди данъци."

#: src/postulo/templates/applications/ical_import.html
#: src/postulo/templates/core/kind_file.html
#: src/postulo/templates/jobs/contact_vcards.html
#: src/postulo/templates/resume/candidate_file.html
#: src/postulo/templates/resume/europass_import.html
msgid "The file"
msgstr "Файлът"

#: src/postulo/applications/ical_import.py
#, python-format
msgid "the file %(name)s"
msgstr "файлът %(name)s"

#: src/postulo/resume/candidate.py
#, python-format
msgid "The file also holds %(names)s, which this page does not read."
msgstr "Файлът съдържа също %(names)s, които тази страница не чете."

#: src/postulo/core/csv_import.py
msgid "The file could not be read: a cell is over 128 KiB. A quotation mark that is never closed is the usual cause."
msgstr "Файлът не можа да бъде прочетен: клетка е над 128 KiB. Обичайна причина е кавичка, която никога не е затворена."

#: src/postulo/applications/ical_import.py
msgid "The file does not say which time zone this is in. Choose one."
msgstr "Файлът не посочва в коя часова зона е това. Изберете зона."

#: src/postulo/applications/ical_import.py
msgid "The file gives this the same identifier as an entry above it."
msgstr "Файлът дава на това същия идентификатор като на запис над него."

#: src/postulo/applications/ical_import.py
msgid "The file gives this time without a time zone."
msgstr "Файлът дава този час без часова зона."

#: src/postulo/resume/candidate.py
msgid "The file has another of this type, and a person has one of each."
msgstr "Файлът съдържа друг запис от този вид, а човек има само по един от всеки."

#: src/postulo/resume/candidate.py
#, fuzzy
msgid "The file has two groups under the number it names."
msgstr "Файлът има две групи под номера, който назовава."

#: src/postulo/resume/candidate.py
msgid "The file has two publications under the number it names, so it will be a count for all of your work."
msgstr ""

#: src/postulo/templates/jobs/contact_vcards.html
#, python-format
msgid "The file holds %(counter)s more card than the first %(limit)s, which are the ones shown."
msgid_plural "The file holds %(counter)s more cards than the first %(limit)s, which are the ones shown."
msgstr[0] "Файлът съдържа още %(counter)s карта след първите %(limit)s, които са показани."
msgstr[1] "Файлът съдържа още %(counter)s карти след първите %(limit)s, които са показани."

#: src/postulo/core/kind_files.py
#, python-format
msgid "The file holds more than %(limit)s rows. The first %(limit)s are read."
msgstr "Файлът съдържа повече от %(limit)s реда. Прочитат се първите %(limit)s."

#: src/postulo/core/csv_import.py
msgid "The file holds no rows."
msgstr "Файлът не съдържа редове."

#: src/postulo/core/csv_import.py
msgid "The file is empty."
msgstr "Файлът е празен."

#: src/postulo/documents/archiving.py
msgid "The file is missing from this server, so it was not sent."
msgstr "Файлът липсва на този сървър, затова не е изпратен."

#: src/postulo/core/csv_import.py src/postulo/core/views_import.py
msgid "The file is over 2 MB. A job search is not that big."
msgstr "Файлът е над 2 МБ. Едно търсене на работа не е толкова голямо."

#: src/postulo/templates/documents/upload_form.html
msgid "The file itself cannot be changed. Upload the new one and mark it as superseding this, so what you sent still means the file you sent."
msgstr "Самият файл не може да се променя. Качете новия и го отбележете като заместващ този, така че изпратеното да продължи да означава файла, който сте изпратили."

#: src/postulo/applications/ical_import.py
msgid "The file marks this as cancelled."
msgstr "Файлът отбелязва това като отменено."

#: src/postulo/applications/ical_import.py
#, python-format
msgid "The file names a time zone, “%(zone)s”, that Postulo does not know."
msgstr "Файлът посочва часова зона „%(zone)s“, която Postulo не познава."

#: src/postulo/documents/archiving.py
msgid "The file no longer matches what was recorded for it, so it was not sent."
msgstr "Файлът вече не съвпада с това, което е записано за него, затова не е изпратен."

#: src/postulo/resume/candidate.py
msgid "The file words it differently. Yours is left as it is."
msgstr "Файлът го формулира различно. Вашият вариант се оставя както е."

#: src/postulo/templates/help/links.html
msgid "The filled star marks the primary of each sort: the one a CV prints, unless its own <em>Settings</em> say otherwise. Letters print none. Press another row's star and save to change it. The bin removes a row at once, after asking, without waiting for <em>Save</em>."
msgstr "Запълнената звезда отбелязва основния от всеки вид: този, който автобиографията отпечатва, освен ако собствените ѝ <em>Настройки</em> не казват друго. Писмата не отпечатват нито един. Натиснете звездата на друг ред и запазете, за да го промените. Кошчето премахва ред веднага, след като попита, без да чака <em>Запазване</em>."

#: src/postulo/templates/help/postal_addresses.html
msgid "The filled star marks the primary. Your CVs and letters never print a street: they print the town and country of the primary address, unless <em>Location</em> in the contact block says something else."
msgstr "Запълнената звезда отбелязва основния. Вашите автобиографии и писма никога не отпечатват улица: отпечатват града и държавата на основния адрес, освен ако <em>Местоположение</em> в блока за контакт не казва нещо друго."

#: src/postulo/templates/help/telephone_numbers.html
msgid "The filled star marks the primary: the number your documents print, unless a CV's own <em>Settings</em> say otherwise. Press another row's star and save to change it. The bin removes a row at once, after asking, without waiting for <em>Save</em>; removing the primary gives the star to another number, as the question says before you answer it."
msgstr "Запълнената звезда отбелязва основния: номера, който документите ви отпечатват, освен ако собствените <em>Настройки</em> на автобиографията не казват друго. Натиснете звездата на друг ред и запазете, за да го промените. Кошчето премахва ред веднага, след като попита, без да чака <em>Запазване</em>; премахването на основния дава звездата на друг номер, както казва въпросът, преди да отговорите."

#: src/postulo/templates/server/design.html
msgid "The first"
msgstr "Първият"

#: src/postulo/resume/candidate.py
#, python-format
msgid "The first %(count)s is read, and the rest are not."
msgid_plural "The first %(count)s are read, and the rest are not."
msgstr[0] "Прочита се първият %(count)s, останалите — не."
msgstr[1] "Прочитат се първите %(count)s, останалите — не."

#: src/postulo/templates/documents/cv_form.html
msgid "The first choice in each list follows your details: mark another number as primary there and this CV prints it. One you choose here stays, whatever becomes primary. If you later delete it from your details, this CV prints none of that kind until you choose again, and never another in its place. What you have already sent does not change."
msgstr "Първият избор във всеки списък следва вашите данни: отбележете там друг номер като основен и тази автобиография ще го отпечата. Избраният тук остава, независимо кой стане основен. Ако по-късно го изтриете от данните си, тази автобиография не отпечатва нищо от този вид, докато не изберете отново, и никога друг на негово място. Вече изпратеното не се променя."

