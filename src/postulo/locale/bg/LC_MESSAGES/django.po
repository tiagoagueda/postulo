msgstr "Този файл не е GeoJSON."

#: src/postulo/resume/views.py
#, python-format
msgid "That file is over %(limit)s MB. A CV is not that big."
msgstr "Този файл надхвърля %(limit)s МБ. Автобиографията не е толкова голяма."

