#: src/postulo/core/help.py
msgid "The picture that stands for you on these pages: one you upload, your Gravatar, or your initials."
msgstr "Bildet som representerer deg på disse sidene: et du laster opp, Gravatar-bildet ditt eller initialene dine."

#: src/postulo/core/server_views.py
msgid "The plugins that ship inside Postulo. Nothing is fetched."
msgstr "Programtilleggene som følger med i Postulo. Ingenting hentes."

#: src/postulo/templates/applications/application_detail.html
#: src/postulo/templates/jobs/partials/listing_row.html
msgid "The posting"
msgstr "Annonsen"

#: src/postulo/templates/applications/report.html
msgid "the posting"
msgstr "annonsen"

#: src/postulo/templates/applications/application_intake.html
#: src/postulo/templates/jobs/capture_review.html
#: src/postulo/templates/jobs/listing_form.html
msgid "The posting itself"
msgstr "Selve annonsen"

#: src/postulo/jobs/forms.py
msgid "The posting's own address, kept so you can go back to it. Postulo reads the page when you capture it and never fetches it again."
msgstr "Annonsens egen adresse, beholdt så du kan gå tilbake til den. Postulo leser siden når du fanger den, og henter den aldri igjen."

#: src/postulo/plugins/consent.py
#, python-format
msgid "The provider answered %(status)s."
msgstr "Leverandøren svarte %(status)s."

#: src/postulo/core/mail_auth.py
msgid "The provider sent no refresh token, so mail would stop within the hour. Check that offline access is allowed for this application."
msgstr "Leverandøren sendte ikke noe oppdateringstoken, så e-posten ville stoppe innen en time. Sjekk at frakoblet tilgang er tillatt for dette programmet."

#: src/postulo/plugins/consent.py
msgid "The provider will not renew this. Somebody has to agree to it again."
msgstr "Leverandøren fornyer ikke dette. Noen må samtykke igjen."

#: src/postulo/plugins/consent.py
msgid "The provider's reply was not readable."
msgstr "Leverandørens svar kunne ikke leses."

#: src/postulo/plugins/consent.py
msgid "The provider's token address redirected, and Postulo does not follow it."
msgstr "Leverandørens tokenadresse omdirigerte, og Postulo følger ikke omdirigeringen."

#: src/postulo/applications/forms.py
msgid "The public employment service you are registered with. Add it under Companies, as a public employment service, if it is not here."
msgstr "Den offentlige arbeidsformidlingen du er registrert hos. Legg den til under Selskaper, som offentlig arbeidsformidling, hvis den ikke finnes her."

#: src/postulo/applications/views.py
msgid "The reason was not kept: only an application that was rejected, withdrawn or ghosted has one."
msgstr "Grunnen ble ikke beholdt: bare en søknad som ble avvist, trukket tilbake eller ghostet, har en."

#: src/postulo/notifications/webhooks.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Mottakeren svarte %(status)s."

#: src/postulo/templates/server/data_protection.html
msgid "The record of what this instance processes, and who receives it."
msgstr "Protokollen over hva denne installasjonen behandler, og hvem som mottar det."

#: src/postulo/documents/models.py
msgid "The referee sends it themselves"
msgstr "Referansepersonen sender det selv"

#: src/postulo/jobs/rendering.py
msgid "The renderer could not be started."
msgstr "Gjengivelsesprogrammet kunne ikke startes."

#: src/postulo/templates/jobs/capture_page.html
msgid "The rendering"
msgstr "Gjengivelsen"

#: src/postulo/jobs/rendering.py
msgid "The rendering came out larger than this instance keeps."
msgstr "Gjengivelsen ble større enn det denne installasjonen beholder."

#: src/postulo/templates/jobs/capture_page_forget.html
#, python-format
msgid "The rendering kept of the page that “%(title)s” was read from will be deleted permanently."
msgstr "Gjengivelsen som er beholdt fra siden «%(title)s» ble lest fra, blir slettet permanent."

#: src/postulo/templates/jobs/capture_page.html
msgid "The rendering, in a box that scrolls"
msgstr "Gjengivelsen, i en boks som kan rulles"

#: src/postulo/jobs/pages.py
msgid "The request did not say how large the rendering is."
msgstr "Forespørselen oppga ikke hvor stor gjengivelsen er."

#: src/postulo/api/problems.py
#, python-format
msgid "The request is larger than %(limit)s, which is the most this call reads."
msgstr "Forespørselen er større enn %(limit)s, som er det meste dette kallet leser."

#: src/postulo/api/problems.py
msgid "The request was not in the shape this call takes."
msgstr "Forespørselen hadde ikke den formen dette kallet tar imot."

#: src/postulo/templates/resume/europass_import.html
msgid "The rest of the file is still worth importing. What is listed here is not, and you can add it by hand afterwards."
msgstr "Resten av filen er fortsatt verdt å importere. Det som står oppført her, er det ikke, og du kan legge det til manuelt etterpå."

#: src/postulo/templates/applications/application_intake.html
#: src/postulo/templates/jobs/capture_review.html
#: src/postulo/templates/jobs/listing_form.html
msgid "The role"
msgstr "Stillingen"

#: src/postulo/applications/forms.py
msgid "The route it went through. The report counts by this, including how many went through the public employment service's own board."
msgstr "Kanalen den gikk gjennom. Rapporten teller etter dette, inkludert hvor mange som gikk gjennom den offentlige arbeidsformidlingens egen stillingsportal."

#: src/postulo/jobs/conflicts.py
msgid "The same advert"
msgstr "Samme annonse"

#: src/postulo/templates/jobs/capture_review.html
msgid "The same advert on another board is evidence about the job. Adding this capture to a listing's history keeps it, with any page it kept, and makes no second listing."
msgstr "Den samme annonsen på en annen stillingsportal sier noe om jobben. Å legge denne fangsten til i en utlysnings historikk beholder den, med eventuell side den beholdt, og lager ingen ny utlysning."

#: src/postulo/jobs/conflicts.py
msgid "The same email address"
msgstr "Samme e-postadresse"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same email address: %(email)s"
msgstr "Samme e-postadresse: %(email)s"

#: src/postulo/templates/documents/cv_detail.html
msgid "The same entries without the layout, in this document's language. None of these is filed as a version you sent."
msgstr "De samme oppføringene uten oppsettet, på dokumentets språk. Ingen av disse arkiveres som en versjon du sendte."

#: src/postulo/applications/widgets.py
msgid "The same figures by sector, and by industry within each. A company in three fields counts in all three."
msgstr "De samme tallene etter sektor, og etter bransje innenfor hver. Et selskap innen tre felt teller i alle tre."

#: src/postulo/jobs/conflicts.py
msgid "The same identifier"
msgstr "Den samme identifikatoren"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same identifier: %(identifier)s"
msgstr "Samme identifikator: %(identifier)s"

#: src/postulo/jobs/conflicts.py src/postulo/jobs/duplicates.py
msgid "The same name"
msgstr "Samme navn"

#: src/postulo/jobs/duplicates.py
msgid "The same name, once the legal form is set aside"
msgstr "Samme navn når selskapsformen holdes utenfor"

#: src/postulo/templates/jobs/conflicts.html
msgid "The same thing twice"
msgstr "Det samme to ganger"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same website: %(domain)s"
msgstr "Samme nettsted: %(domain)s"

#: src/postulo/templates/server/overview.html
msgid "The scheduler asks once a day; run manage.py check_for_updates to ask now."
msgstr "Planleggeren spør én gang om dagen; kjør manage.py check_for_updates for å spørre nå."

#: src/postulo/core/server_forms.py
msgid "The schemes were not sent with this request, so nothing was changed. To define none, empty the box and save."
msgstr "Identifikatortypene ble ikke sendt med denne forespørselen, så ingenting ble endret. For ikke å definere noen, tøm feltet og lagre."

#: src/postulo/applications/widgets.py
msgid "The search in four numbers"
msgstr "Søket i fire tall"

#: src/postulo/templates/server/design.html
msgid "The second"
msgstr "Den andre"

#: src/postulo/resume/forms.py
msgid "The series it belongs to, if any."
msgstr "Serien den tilhører, hvis noen."

#: src/postulo/core/mail.py
msgid "The server does not offer STARTTLS. Turn it off, or use a port that does."
msgstr "Serveren tilbyr ikke STARTTLS. Slå den av, eller bruk en port som gjør det."

#: src/postulo/core/mail.py
#, python-format
msgid "The server refused those credentials: %(detail)s"
msgstr "Serveren avviste disse påloggingsopplysningene: %(detail)s"

#: src/postulo/core/server_forms.py
msgid "The server that accepts the mail — its name, not an address."
msgstr "Serveren som tar imot e-posten – navnet, ikke en adresse."

#: src/postulo/plugins/fetching.py
msgid "The site asked us to slow down (429). Try again in a few minutes."
msgstr "Nettstedet ba oss senke farten (429). Prøv igjen om noen minutter."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "The site is having trouble (%(status)s). That is their end, not yours."
msgstr "Nettstedet har problemer (%(status)s). Det er i deres ende, ikke din."

#: src/postulo/plugins/fetching.py
msgid "The site redirected without saying where to."
msgstr "Nettstedet omdirigerte uten å si hvor til."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "The site refused the request (%(status)s). Large sites often sit behind bot protection that turns away anything that is not a browser, even when the page is perfectly visible to you. Paste the page source in below instead."
msgstr "Nettstedet avviste forespørselen (%(status)s). Store nettsteder sitter ofte bak botbeskyttelse som avviser alt som ikke er en nettleser, selv når siden er helt synlig for deg. Lim inn sidekilden under i stedet."

#: src/postulo/templates/jobs/capture_form.html
msgid "The site refuses Postulo, or the posting needs a login"
msgstr "Nettstedet avviser Postulo, eller annonsen krever innlogging"

#: src/postulo/templates/jobs/capture_form.html
msgid "The site's robots.txt is honoured."
msgstr "Nettstedets robots.txt respekteres."

#: src/postulo/templates/server/design.html
msgid "The smallest size, for a label beside something."
msgstr "Den minste størrelsen, for en etikett ved siden av noe."

#: src/postulo/documents/printing.py
msgid "The social profile chosen for this CV is no longer in your details, so it prints none."
msgstr "Den sosiale profilen som er valgt for denne CV-en, finnes ikke lenger i opplysningene dine, så den skriver ikke ut noen."

#: src/postulo/resume/forms.py
msgid "The sort of event. “Not stated” prints nothing."
msgstr "Typen arrangement. «Ikke oppgitt» skriver ikke ut noe."

#: src/postulo/templates/jobs/capture_page.html
msgid "The source"
msgstr "Kilden"

#: src/postulo/templates/server/capture.html
msgid "The source is a stranger's markup. It is kept as text, shown as text and downloaded as text, and never drawn as a page."
msgstr "Kilden er en fremmeds oppmerking. Den beholdes som tekst, vises som tekst og lastes ned som tekst, og gjengis aldri som en side."

#: src/postulo/templates/jobs/capture_page_forget.html
#, python-format
msgid "The source kept of the page that “%(title)s” was read from will be deleted permanently."
msgstr "Kilden som er beholdt fra siden «%(title)s» ble lest fra, blir slettet permanent."

#: src/postulo/jobs/pages.py
msgid "The source of the page could not be kept."
msgstr "Kilden til siden kunne ikke beholdes."

#: src/postulo/templates/jobs/capture_review.html
msgid "The source of the page this was read from was kept."
msgstr "Kilden til siden dette ble lest fra, ble beholdt."

#: src/postulo/jobs/pages.py
#, python-format
msgid "The source of the page was not kept. %(why)s"
msgstr "Kilden til siden ble ikke beholdt. %(why)s"

#: src/postulo/templates/jobs/capture_page.html
msgid "The source, as text"
msgstr "Kilden, som tekst"

#: src/postulo/core/csv_import.py
msgid "The spreadsheet gave a status but no date, so this application is not counted in figures measured from the date it was sent. Set it on the application to include it."
msgstr "Regnearket ga en status, men ingen dato, så denne søknaden telles ikke i tall som måles fra datoen den ble sendt. Sett datoen på søknaden for å få den med."

#: src/postulo/applications/widgets.py
msgid "The stage each application had reached when it was rejected, withdrawn or ghosted, and the reason where one was given."
msgstr "Fasen hver søknad hadde nådd da den ble avvist, trukket tilbake eller ghostet, og grunnen der en ble oppgitt."

#: src/postulo/templates/widgets/endings.html
msgid "The stage is read from each timeline: where the application stood when it ended."
msgstr "Fasen leses fra hver tidslinje: hvor søknaden sto da den ble avsluttet."

#: src/postulo/templates/help/identifiers.html
msgid "The star at the start of a row marks your primary identifier. A CV prints it first, and alone where its template has room for only one. Removing it hands the star to the next row."
msgstr "Stjernen i starten av en rad markerer hovedidentifikatoren din. En CV skriver den ut først, og alene der malen bare har plass til én. Fjerner du den, går stjernen til neste rad."

#: src/postulo/applications/forms.py
msgid "The start date they proposed, if one was."
msgstr "Startdatoen de foreslo, hvis de foreslo en."

#: src/postulo/core/mail_auth.py
msgid "The stored mail credentials cannot be read on this instance."
msgstr "De lagrede påloggingsopplysningene for e-post kan ikke leses på denne installasjonen."

#: src/postulo/documents/forms.py
msgid "The subject has to be one line."
msgstr "Emnet må være én linje."

#: src/postulo/templates/settings/appearance.html
msgid "The switch at the top right cycles through the same three; this is the explicit version."
msgstr "Bryteren øverst til høyre går gjennom de samme tre; dette er den eksplisitte varianten."

#: src/postulo/core/views_tables.py
msgid "The table opens plain again."
msgstr "Tabellen åpnes vanlig igjen."

#: src/postulo/templates/help/listings.html
msgid "The tabs sort them by where they stand, and the search box over the table narrows what is listed. Columns and filters can be chosen and kept as a saved view."
msgstr "Fanene sorterer dem etter hvor de står, og søkefeltet over tabellen snevrer inn det som vises. Kolonner og filtre kan velges og tas vare på som en lagret visning."

#: src/postulo/templates/server/design.html
msgid "The tag palette"
msgstr "Etikettpaletten"

#: src/postulo/jobs/forms.py
msgid "The team they are in, if you know it. A new name joins the company's list."
msgstr "Teamet de er i, hvis du vet det. Et nytt navn havner på selskapets liste."

#: src/postulo/documents/printing.py
msgid "The telephone number chosen for this CV is no longer in your details, so it prints none."
msgstr "Telefonnummeret som er valgt for denne CV-en, finnes ikke lenger i opplysningene dine, så den skriver ikke ut noe."

#: src/postulo/resume/importing.py
#, python-format
msgid "The telephone number of %(name)s was not added."
msgstr "Telefonnummeret til %(name)s ble ikke lagt til."

#: src/postulo/templates/documents/cv_text.html
msgid "The text of this document"
msgstr "Teksten i dette dokumentet"

#: src/postulo/templates/server/design.html
msgid "The thing to do next"
msgstr "Det neste som skal gjøres"

#: src/postulo/templates/server/defaults.html
#, python-format
msgid "The time zone is set by the environment: <code>%(variable)s</code> = %(zone)s. Remove it from the environment to change it here."
msgstr "Tidssonen settes av miljøet: <code>%(variable)s</code> = %(zone)s. Fjern den fra miljøet for å endre den her."

#: src/postulo/documents/models.py
msgid "The town and country from your details, never a street."
msgstr "Byen og landet fra opplysningene dine, aldri en gateadresse."

#: src/postulo/accounts/forms.py
msgid "The town or city as you would write it. It is only ever text: it is not looked up and never put on a map."
msgstr "Byen eller tettstedet slik du ville skrevet det. Det er alltid bare tekst: det slås ikke opp og plasseres aldri på et kart."

#: src/postulo/resume/forms.py
msgid "The university, laboratory or body behind it: a thesis's school."
msgstr "Universitetet, laboratoriet eller organet bak det: lærestedet for en avhandling."

#: src/postulo/applications/forms.py src/postulo/jobs/forms.py
msgid "The upper figure cannot be below the lower one."
msgstr "Det øvre tallet kan ikke være under det nedre."

#: src/postulo/templates/documents/rendered_compare.html
msgid "The version before it"
msgstr "Versjonen før"

#: src/postulo/resume/forms.py
msgid "The volume, as the publisher numbers it."
msgstr "Bindet, slik utgiveren nummererer det."

#: src/postulo/resume/importing.py
#, python-format
msgid "The website %(site)s is already among your links, so it was not added."
msgstr "Nettstedet %(site)s er allerede blant lenkene dine, så det ble ikke lagt til."

#: src/postulo/documents/printing.py
msgid "The website chosen for this CV is no longer in your details, so it prints none."
msgstr "Nettstedet som er valgt for denne CV-en, finnes ikke lenger i opplysningene dine, så den skriver ikke ut noe."

#: src/postulo/resume/importing.py
#, python-format
msgid "The website “%(value)s” is not a valid address, so it was not added."
msgstr "Nettstedet «%(value)s» er ikke en gyldig adresse, så det ble ikke lagt til."

#: src/postulo/plugins/catalogue.py
msgid "The wheel does not match the checksum the catalogue published for it."
msgstr "Wheel-filen stemmer ikke med kontrollsummen katalogen publiserte for den."

#: src/postulo/plugins/installing.py
msgid "The wheel has an encrypted member, which a plugin never needs."
msgstr "Wheel-filen har et kryptert medlem, noe et programtillegg aldri trenger."

#: src/postulo/plugins/installing.py
msgid "The wheel has no metadata; it may be damaged."
msgstr "Wheel-filen har ingen metadata; den kan være skadet."

#: src/postulo/plugins/installing.py
msgid "The wheel holds far more files than any plugin does."
msgstr "Wheel-filen inneholder langt flere filer enn noe programtillegg gjør."

#: src/postulo/plugins/installing.py
msgid "The wheel's metadata cannot be read; it may be damaged."
msgstr "Metadataene i wheel-filen kan ikke leses; den kan være skadet."

#: src/postulo/plugins/installing.py
msgid "The wheel's metadata is far larger than any plugin's."
msgstr "Metadataene i wheel-filen er langt større enn for noe programtillegg."

#: src/postulo/templates/documents/rendered_compare.html
msgid "The words are the same in both. If the two PDFs look different, what changed is how they are set: the theme, or the layout."
msgstr "Ordene er de samme i begge. Hvis de to PDF-ene ser forskjellige ut, er det som er endret, hvordan de er satt opp: temaet eller oppsettet."

#: src/postulo/templates/documents/letter_detail.html
msgid "The words without the layout, in this letter's language. None of these is filed as a version you sent."
msgstr "Ordene uten oppsett, på språket til dette brevet. Ingen av disse arkiveres som en versjon du sendte."

#: src/postulo/core/errands.py
msgid "The work was interrupted before it finished. Please try again."
msgstr "Arbeidet ble avbrutt før det var ferdig. Prøv igjen."

#: src/postulo/jobs/merging.py
msgid "Their entry among your references"
msgstr "Deres oppføring blant referansene dine"

#: src/postulo/jobs/merging.py
msgid "Their entry among your references: you already have one for the other."
msgstr "Deres oppføring blant referansene dine: du har allerede en for den andre."

#: src/postulo/jobs/forms.py
msgid "Their job title, as they give it themselves."
msgstr "Stillingstittelen deres, slik de selv oppgir den."

#: src/postulo/templates/jobs/share.html
msgid "Their username or email address on this instance, exactly."
msgstr "Brukernavnet eller e-postadressen deres på denne installasjonen, nøyaktig."

#: src/postulo/accounts/models.py src/postulo/documents/models.py
msgid "theme"
msgstr "tema"

#: src/postulo/core/context_processors.py
#, python-format
msgid "Theme: %(current)s. Switch to: %(next)s."
msgstr "Tema: %(current)s. Bytt til: %(next)s."

#: src/postulo/core/context_processors.py
#, python-format
msgid "Theme: %(theme)s"
msgstr "Tema: %(theme)s"

#: src/postulo/templates/accounts/delete_account.html
msgid "Then delete"
msgstr "Slett deretter"

#: src/postulo/core/messaging_handles.py
#, python-format
msgid "There are at most %(max)s messaging handles here."
msgstr "Det kan være høyst %(max)s meldingsbrukernavn her."

#: src/postulo/resume/views.py
msgid "There are no links to check."
msgstr "Det er ingen lenker å sjekke."

#: src/postulo/core/views_access.py
msgid "There is a group of that name already."
msgstr "Det finnes allerede en gruppe med det navnet."

#: src/postulo/jobs/slow.py
msgid "There is no address to fetch it from again."
msgstr "Det finnes ingen adresse å hente den fra på nytt."

#: src/postulo/documents/archiving.py
msgid "There is no file to send."
msgstr "Det finnes ingen fil å sende."

#: src/postulo/resume/candidate.py
msgid "There is no handle here to read."
msgstr "Det er ikke noe brukernavn her å lese."

#: src/postulo/jobs/pages.py
msgid "There is no kept source to draw from, and a rendering is drawn from it."
msgstr "Det finnes ingen beholdt kilde å gjengi fra, og en gjengivelse lages ut fra den."

#: src/postulo/core/server_views.py
msgid "There is no repository by that name."
msgstr "Det finnes ikke noe depot med det navnet."

#: src/postulo/plugins/fetching.py
msgid "There is nothing at that address (404). Check the link."
msgstr "Det er ingenting på den adressen (404). Sjekk lenken."

#: src/postulo/templates/jobs/merge.html
msgid "There is nothing else to merge it with."
msgstr "Det er ingenting annet å slå det sammen med."

#: src/postulo/templates/404.html
msgid "There is nothing here, or it is not yours to see."
msgstr "Det er ingenting her, eller det er ikke ditt å se."

#: src/postulo/templates/core/kind_file.html
#: src/postulo/templates/resume/candidate_file.html
msgid "There is nothing in this file to add: what it holds, you already have, or cannot be added."
msgstr "Det er ingenting i denne filen å legge til: det den inneholder, har du allerede, eller det kan ikke legges til."

#: src/postulo/templates/documents/cv_text.html
msgid "There is nothing on this document yet, so there is no text to copy."
msgstr "Det er ingenting i dette dokumentet ennå, så det er ingen tekst å kopiere."

#: src/postulo/plugins/installing.py
msgid "There is nothing to go back to: no plugin has been installed since."
msgstr "Det er ingenting å gå tilbake til: ingen programtillegg er installert siden."

#: src/postulo/applications/views_ical.py src/postulo/core/views_kind_files.py
#: src/postulo/jobs/vcard_views.py src/postulo/resume/views.py
#: src/postulo/resume/views_candidate.py
msgid "There is nothing waiting to be imported."
msgstr "Det er ingenting som venter på å bli importert."

#: src/postulo/jobs/pages.py
msgid "There was nothing to keep."
msgstr "Det var ingenting å beholde."

#: src/postulo/templates/widgets/insight_counters.html
#, python-format
msgid "These figures come from %(total)s application. Read them as a record of what happened, not as a rate that predicts anything."
msgid_plural "These figures come from %(total)s applications — too few to draw conclusions from. Read them as a record of what happened, not as rates that predict anything."
msgstr[0] "Disse tallene kommer fra %(total)s søknad. Les dem som en oversikt over hva som skjedde, ikke som en andel som forutsier noe."
msgstr[1] "Disse tallene kommer fra %(total)s søknader – for få til å trekke slutninger fra. Les dem som en oversikt over hva som skjedde, ikke som andeler som forutsier noe."

#: src/postulo/templates/cotton/duplicates.html
msgid "These look like the same one, and may not be. Nothing is merged unless you say so, and you are shown what would move first."
msgstr "Disse ser ut som den samme, men er det kanskje ikke. Ingenting slås sammen med mindre du sier det, og du får først se hva som ville blitt flyttet."

#: src/postulo/templates/jobs/move_owner.html
msgid "These no longer see it, and each keeps a copy of their own of what their applications, notes and other records point at:"
msgstr "Disse ser den ikke lenger, og hver av dem beholder en egen kopi av det deres søknader, notater og andre oppføringer peker på:"

#: src/postulo/templates/server/logs.html
msgid "These records are also served at <code>/logs</code> for a log collector, behind the token in POSTULO_LOGS_TOKEN. Anything holding that token can read everything on this page."
msgstr "Disse oppføringene serveres også på <code>/logs</code> for en loggsamler, bak tokenet i POSTULO_LOGS_TOKEN. Alt som har det tokenet, kan lese alt på denne siden."

#: src/postulo/templates/server/logs.html
msgid "These records can name people and their applications."
msgstr "Disse oppføringene kan navngi personer og søknadene deres."

#: src/postulo/templates/documents/cv_detail.html
