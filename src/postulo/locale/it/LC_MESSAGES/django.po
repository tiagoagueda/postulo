msgstr "Il sito web «%(value)s» non è un indirizzo valido, quindi non è stato aggiunto."

#: src/postulo/plugins/catalogue.py
msgid "The wheel does not match the checksum the catalogue published for it."
msgstr "Il wheel non corrisponde al checksum che il catalogo ha pubblicato per esso."

#: src/postulo/plugins/installing.py
msgid "The wheel has an encrypted member, which a plugin never needs."
msgstr "Il wheel contiene un membro cifrato, di cui un plugin non ha mai bisogno."

#: src/postulo/plugins/installing.py
msgid "The wheel has no metadata; it may be damaged."
msgstr "Il wheel non ha metadati; potrebbe essere danneggiato."

