msgstr "Kjo fotografi nuk është ajo që printon një CV. Fotografia e CV-së ruhet veçmas, pak më poshtë."

#: src/postulo/templates/jobs/listing_apply.html
msgid "This records the application. The listing leaves your to-decide list and the timeline begins."
msgstr "Kjo e regjistron aplikimin. Shpallja largohet nga lista juaj për të vendosur dhe vija kohore nis."

