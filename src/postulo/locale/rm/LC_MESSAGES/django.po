msgstr "Ils tabs als zavran tenor lur stadi, ed il champ da tschertga sur la tabella restrenscha tge che vegn enumerà. Colonnas e filters pon vegnir tschernids e conservads sco vista arcunada."

#: src/postulo/templates/server/design.html
msgid "The tag palette"
msgstr "La paletta da las etichettas"

#: src/postulo/jobs/forms.py
msgid "The team they are in, if you know it. A new name joins the company's list."
msgstr "La gruppa en la quala la persuna lavura, sche Vus savais quai. In nov num vegn agiuntà a la glista da l'interpresa."

#: src/postulo/documents/printing.py
msgid "The telephone number chosen for this CV is no longer in your details, so it prints none."
msgstr "Il numer da telefon tschernì per quest CV n'è betg pli en Vossas datas, perquai na stampa el nagin."

#: src/postulo/resume/importing.py
#, python-format
msgid "The telephone number of %(name)s was not added."
msgstr "Il numer da telefon da %(name)s n'è betg vegnì agiuntà."

#: src/postulo/core/views_backups.py
