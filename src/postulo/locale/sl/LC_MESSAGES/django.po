msgstr "Vrstica, ko vtičnik meni, da se je nekaj zgodilo, in čaka na vas."

#: src/postulo/core/identifiers.py
msgid "A link cannot hold a curly bracket other than {value}, a backslash, or a line break."
msgstr "Povezava ne sme vsebovati zavitega oklepaja, razen {value}, obratne poševnice ali preloma vrstice."

#: src/postulo/core/identifiers.py
msgid "A link holds {value}, which is where the identifier goes."
msgstr "Povezava vsebuje {value}, kamor pride identifikator."

