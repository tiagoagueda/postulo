msgstr[0] "<strong>%(name)s</strong>: %(rows)s vrstica. Spodnji predlogi izhajajo iz imen glav; popravite jih, nato pred uvozom preverite predogled."
msgstr[1] "<strong>%(name)s</strong>: %(rows)s vrstici. Spodnji predlogi izhajajo iz imen glav; popravite jih, nato pred uvozom preverite predogled."
msgstr[2] "<strong>%(name)s</strong>: %(rows)s vrstice. Spodnji predlogi izhajajo iz imen glav; popravite jih, nato pred uvozom preverite predogled."
