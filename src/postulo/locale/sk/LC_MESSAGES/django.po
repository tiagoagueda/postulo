msgstr "Vaše. Nikto iný ich nevidí a nikdy sa neobjavia v dokumente."

#: src/postulo/documents/forms.py
msgid "Yours. They go nowhere with the file."
msgstr "Vaše. So súborom nikam nejdú."

#: src/postulo/templates/jobs/share.html
msgid "Yours: only you can share it, give it to a group or delete it."
msgstr "Vaše: iba vy ho môžete zdieľať, odovzdať skupine alebo vymazať."

