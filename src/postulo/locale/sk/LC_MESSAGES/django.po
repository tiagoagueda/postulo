msgstr "„%(record)s“ by sa zobrazilo %(names)s, ktorí vidia „%(parent)s“; najprv to s nimi zdieľajte."

#: src/postulo/jobs/sharing.py
#, python-format
msgid "“%(target)s” is not shared with %(names)s, who can see this; share it with them first."
msgstr "„%(target)s“ nie je zdieľané s %(names)s, ktorí vidia toto; najprv to s nimi zdieľajte."

