#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” has %(count)s row in the file."
msgid_plural "“%(name)s” has %(count)s rows in the file."
msgstr[0] "„%(name)s“ má v súbore %(count)s riadok."
msgstr[1] "„%(name)s“ má v súbore %(count)s riadky."
msgstr[2] "„%(name)s“ má v súbore %(count)s riadkov."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is gone. Anything installed from it stays installed."
msgstr "Zdroj „%(name)s“ bol odstránený. Všetko, čo sa z neho nainštalovalo, zostáva nainštalované."

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” is in the file, and is not written the way this page reads it."
msgstr "„%(name)s“ je v súbore, ale nie je zapísané tak, ako to táto stránka číta."

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” is not a part of an entry that Postulo translates."
msgstr "„%(name)s“ nie je časť záznamu, ktorú Postulo prekladá."

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” is not a part of the career that Postulo translates."
msgstr "„%(name)s“ nie je časť kariéry, ktorú Postulo prekladá."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is off. Nothing new is installed or updated from it; what was already installed goes on working."
msgstr "Zdroj „%(name)s“ je vypnutý. Nič nové sa z neho neinštaluje ani neaktualizuje; čo už bolo nainštalované, funguje ďalej."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is on. Plugins may be installed and updated from it."
msgstr "Zdroj „%(name)s“ je zapnutý. Dajú sa z neho inštalovať a aktualizovať zásuvné moduly."

#: src/postulo/resume/views.py
#, python-format
msgid "“%(name)s” was added to your companies as Education."
msgstr "„%(name)s“ sa pridala k vašim firmám ako Vzdelávanie."

#: src/postulo/templates/partials/confirm_delete.html
#, python-format
msgid "“%(name)s” will be deleted permanently."
msgstr "Položka „%(name)s“ bude natrvalo vymazaná."

#: src/postulo/templates/connections/confirm_delete.html
#, python-format
msgid "“%(name)s” will be removed, and the secrets stored for it deleted."
msgstr "Položka „%(name)s“ bude odobratá a tajné kľúče, ktoré sú pre ňu uložené, budú vymazané."

#: src/postulo/templates/jobs/conflicts.html
