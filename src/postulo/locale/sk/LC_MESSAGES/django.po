#: src/postulo/documents/forms.py
msgid "Yours to set and never enforced: after it, Postulo warns and does not block."
msgstr "Nastavujete ho vy a nikdy sa nevynucuje: po ňom Postulo upozorní, ale nezablokuje."

#: src/postulo/applications/forms.py
msgid "Yours, not the employer's. The list can be sorted and narrowed by it."
msgstr "Vaše, nie zamestnávateľa. Zoznam sa podľa toho dá zoradiť a zúžiť."

#: src/postulo/applications/forms.py
msgid "Yours, to prepare with. Nothing here is sent to anybody, and it is left out of the calendar files."
msgstr "Iba pre vás, na prípravu. Nič z toho sa nikomu neposiela a do súborov kalendára sa nezahŕňa."

