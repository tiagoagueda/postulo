msgstr "Le téléchargement est bien plus gros qu'un plugin ne devrait l'être."

#: src/postulo/plugins/catalogue.py
msgid "The download is taking too long."
msgstr "Le téléchargement prend trop de temps."

#: src/postulo/documents/models.py
