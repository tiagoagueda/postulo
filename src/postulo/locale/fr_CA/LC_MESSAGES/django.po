msgstr "« %(name)s » sera supprimé définitivement."

#: src/postulo/templates/connections/confirm_delete.html
#, python-format
msgid "“%(name)s” will be removed, and the secrets stored for it deleted."
msgstr "« %(name)s » sera retirée, et les secrets conservés pour elle supprimés."

#: src/postulo/templates/jobs/conflicts.html
#, python-format
msgid "“%(record)s” is shared with %(who)s, who cannot see what it points at:"
