#, python-format
msgid "“%(record)s” would be shown to %(names)s, who can see “%(parent)s”; share it with them first."
msgstr "“%(record)s” serait montré à %(names)s, qui peut voir “%(parent)s”; partagez-le d'abord avec eux."

#: src/postulo/jobs/sharing.py
#, python-format
msgid "“%(target)s” is not shared with %(names)s, who can see this; share it with them first."
msgstr "La fiche « %(target)s » n'est pas partagée avec %(names)s, qui voient pourtant la fiche actuelle; partagez-la d'abord avec eux."

