#, python-format
msgid "“%(name)s” is not a part of the career that Postulo translates."
msgstr "« %(name)s » n'est pas une partie du parcours que Postulo traduit."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is off. Nothing new is installed or updated from it; what was already installed goes on working."
msgstr "« %(name)s » est désactivé. Rien de neuf n'est installé ni mis à jour depuis ce dépôt; ce qui était installé continue de fonctionner."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is on. Plugins may be installed and updated from it."
msgstr "« %(name)s » est activé. Des plugins peuvent être installés et mis à jour depuis ce dépôt."

#: src/postulo/resume/views.py
#, python-format
msgid "“%(name)s” was added to your companies as Education."
msgstr "« %(name)s » a été ajoutée à vos entreprises dans le secteur Éducation et formation."

#: src/postulo/templates/partials/confirm_delete.html
#, python-format
