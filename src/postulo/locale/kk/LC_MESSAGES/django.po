msgstr "Бұл Ed25519 ашық кілті емес: %(error)s"

#: src/postulo/applications/ical_reader.py
msgid "That is not an iCalendar file."
msgstr "Бұл iCalendar файлы емес."

#: src/postulo/resume/lookups.py
msgid "That is not an ORCID."
msgstr ""

#: src/postulo/applications/views.py
msgid "That is not an outcome Postulo recognises."
msgstr "Бұл Postulo танитын нәтиже емес."

#: src/postulo/applications/views.py
msgid "That is not something Postulo can do about it."
msgstr "Postulo бұған қатысты мұндай әрекет жасай алмайды."

#: src/postulo/applications/views.py src/postulo/jobs/listing_views.py
#: src/postulo/jobs/views.py
msgid "That is not something Postulo can do to several at once."
msgstr "Postulo мұны бірнешеуіне бірден жасай алмайды."

#: src/postulo/core/server_views.py
msgid "That is not something this page does."
msgstr "Бұл бет мұны істемейді."

#: src/postulo/accounts/views.py
msgid "That is not the address on this account."
msgstr "Бұл осы тіркелгінің мекенжайы емес."

#: src/postulo/core/channels.py
msgid "That is not the shape of an email address."
msgstr "Бұл электрондық пошта мекенжайының пішіміне сәйкес келмейді."

#: src/postulo/core/server_views.py
msgid "That is not the username."
msgstr "Бұл пайдаланушы аты емес."

#: src/postulo/core/kind_files.py
#, fuzzy
msgid "That is somebody's own record, details and career. It is read from Your record as a file, under Your career."
msgstr "Бұл — біреудің жеке деректері, мәліметтері мен мансабы. Ол «Сіздің мансабыңыз» бөліміндегі «Сіздің деректеріңіз» бетінен файл ретінде оқылады."

#: src/postulo/core/kind_files.py
msgid "That is the export of a whole account. This page reads only the file it offers to download itself, which holds one kind of record."
msgstr "Бұл — тұтас тіркелгінің экспорты. Бұл бет тек өзі жүктеп алуға ұсынатын, бір түрдегі жазбаларды қамтитын файлды оқиды."

#: src/postulo/resume/candidate.py
msgid "That is the export of a whole account. This page reads only the file it offers to download itself: one person's own record, without the applications."
