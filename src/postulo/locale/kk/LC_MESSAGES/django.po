msgstr "аяқталу себебі"

#: src/postulo/jobs/models.py
msgid "why it was discarded"
msgstr "шеттету себебі"

#: src/postulo/templates/core/import_csv_done.html
msgid "Why rows were skipped"
msgstr "Жолдар неге өткізіп жіберілді"

