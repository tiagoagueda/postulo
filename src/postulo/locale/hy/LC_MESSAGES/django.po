#: src/postulo/notifications/transport.py
#, python-format
msgid "%(label)s is how this instance sends mail, and mail is the only way back into an account here — %(count)d of them would have no way in. Set up another transport first."
msgid_plural "%(label)s is how this instance sends mail, and mail is the only way back into accounts here — %(count)d of them would have no way in. Set up another transport first."
msgstr[0] "Այս տեղակայումը փոստ է ուղարկում %(label)s-ի միջոցով, իսկ փոստն այստեղ հաշիվ վերադառնալու միակ ճանապարհն է — դրանցից %(count)d-ը ներս մտնելու ճանապարհ չէր ունենա։ Նախ կարգավորեք մեկ այլ փոխադրիչ։"
msgstr[1] "Այս տեղակայումը փոստ է ուղարկում %(label)s-ի միջոցով, իսկ փոստն այստեղ հաշիվներ վերադառնալու միակ ճանապարհն է — դրանցից %(count)d-ը ներս մտնելու ճանապարհ չէր ունենա։ Նախ կարգավորեք մեկ այլ փոխադրիչ։"

