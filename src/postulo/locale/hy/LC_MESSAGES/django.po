#: src/postulo/applications/models.py src/postulo/jobs/models.py
msgid "The location"
msgstr "Գտնվելու վայրը"

#: src/postulo/jobs/views.py
msgid "The logo is gone."
msgstr "Լոգոն հեռացվեց։"

#: src/postulo/jobs/views.py
msgid "The logo was changed."
msgstr "Լոգոտիպը փոխվեց։"

#: src/postulo/jobs/views.py
#, python-format
msgid "The logo was not changed: %(problem)s"
msgstr "Լոգոն չփոխվեց՝ %(problem)s"

#: src/postulo/templates/applications/report.html
msgid "The longest gap is measured inside this period, so a silence that began before it is not carried in. A period still running is only counted up to today."
msgstr "Ամենաերկար ընդմիջումը չափվում է այս ժամանակահատվածի ներսում, ուստի դրանից առաջ սկսված լռությունը հաշվի չի առնվում։ Դեռ ընթացող ժամանակահատվածը հաշվարկվում է միայն մինչև այսօր։"

#: src/postulo/templates/applications/report_print.html
msgid "The longest gap is measured inside this period. A period still running is counted up to the day this was produced. A week marked (part) reaches outside the period; nothing from outside it is counted."
msgstr "Ամենաերկար ընդմիջումը չափվում է այս ժամանակահատվածի ներսում։ Դեռ ընթացող ժամանակահատվածը հաշվարկվում է մինչև այս հաշվետվության ստեղծման օրը։ «(մաս)» նշումով շաբաթը դուրս է գալիս ժամանակահատվածից․ դրանից դուրս ոչինչ հաշվի չի առնվում։"

#: src/postulo/core/server_views.py
msgid "The mail backend accepted nothing."
msgstr "Փոստ ուղարկող համակարգը ոչինչ չընդունեց։"

#: src/postulo/documents/views.py
msgid "The mail server did not take the message, so nothing was sent or recorded."
msgstr "Փոստի սերվերը չընդունեց հաղորդագրությունը, ուստի ոչինչ չուղարկվեց և չգրանցվեց։"

#: src/postulo/templates/server/email.html
msgid "The mailbox this instance sends from"
msgstr "Փոստարկղը, որից ուղարկում է այս տեղակայումը"

#: src/postulo/templates/server/maps.html
msgid "The map is drawn on OpenStreetMap's public tiles. Each viewer's browser fetches them from tile.openstreetmap.org, which learns that browser's address and the area it looks at — where that person's companies are. It is sent this instance's address as the page asking, never the page itself."
msgstr "Քարտեզը գծվում է OpenStreetMap-ի հանրային սալիկների վրա։ Յուրաքանչյուր դիտողի դիտարկիչը դրանք բերում է tile.openstreetmap.org-ից, որն իմանում է այդ դիտարկիչի հասցեն և այն տարածքը, որին նա նայում է, այսինքն՝ որտեղ են այդ մարդու ընկերությունները։ Նրան ուղարկվում է այս տեղակայման հասցեն՝ որպես հարցում կատարող էջ, բայց երբեք ոչ էջն ինքը։"

#: src/postulo/templates/server/maps.html
msgid "The map is drawn on the tiles at the address below. When it is on another server, that server learns each viewer's address and the area they look at; on this instance's own address, nothing is sent anywhere."
msgstr "Քարտեզը գծվում է ստորև նշված հասցեի սալիկների վրա։ Երբ այն այլ սերվերում է, այդ սերվերն իմանում է յուրաքանչյուր դիտողի հասցեն և այն տարածքը, որին նա նայում է․ այս տեղակայման սեփական հասցեի դեպքում ոչինչ ոչ մի տեղ չի ուղարկվում։"

#: src/postulo/templates/server/maps.html
msgid "The map is drawn on the world's outline, kept on this instance. Nothing is fetched from anywhere, and the map cannot show streets."
msgstr "Քարտեզը գծվում է աշխարհի ուրվագծի վրա, որը պահվում է այս տեղակայումում։ Ոչինչ ոչ մի տեղից չի բերվում, և քարտեզը չի կարող փողոցներ ցույց տալ։"

#: src/postulo/templates/resume/preview.html
msgid "The master record. A CV variant selects from this; it never copies it."
msgstr "Հիմնական գրառումը։ CV-ի տարբերակն ընտրում է դրանից, բայց երբեք չի պատճենում այն։"

#: src/postulo/documents/printing.py
msgid "The messaging handle chosen for this CV is no longer in your details, so it prints none."
msgstr "Այս CV-ի համար ընտրված մեսենջերի անունն այլևս ձեր տվյալներում չէ, ուստի ոչինչ չի տպվում։"

#: src/postulo/templates/server/backups.html
msgid "The next backup may not fit."
msgstr "Հաջորդ պահուստային պատճենը կարող է չտեղավորվել։"

#: src/postulo/applications/widgets.py
msgid "The next interviews in the diary, and any that passed without an outcome."
msgstr "Օրացույցի մոտակա հարցազրույցները և նրանք, որոնք անցել են առանց արդյունքի։"

#: src/postulo/templates/accounts/profile.html
#: src/postulo/templates/jobs/partials/row_removals.html
msgid "The next one in the list becomes the primary."
msgstr "Ցանկում հաջորդը դառնում է հիմնական։"

#: src/postulo/templates/server/data_protection.html
msgid "The notice"
msgstr "Ծանուցումը"

#: src/postulo/templates/partials/phone_numbers.html
msgid "The number that gets you back in is separate from the one your documents print, so changing what a recruiter dials does not change how you prove it is you. It has to be confirmed first, and switching off several telephone numbers never takes it away."
msgstr "Մուտքը վերականգնելու համարն առանձին է այն համարից, որը տպվում է ձեր փաստաթղթերում, ուստի հավաքագրողի հավաքած համարը փոխելով՝ չեք փոխում ձեր ինքնությունը հաստատելու եղանակը։ Այն նախ պետք է հաստատվի, և մի քանի հեռախոսահամար անջատելը երբեք չի հեռացնում այն։"

#: src/postulo/applications/models.py
msgid "The office, the remote arrangement, or the days of each."
msgstr "Գրասենյակը, հեռավար աշխատանքի պայմանավորվածությունը կամ յուրաքանչյուրի օրերը։"

#: src/postulo/core/server_views.py
msgid "The official repository is emptied, not removed."
msgstr "Պաշտոնական պահոցը դատարկվում է, բայց չի հեռացվում։"

#: src/postulo/templates/applications/report.html
msgid "The one after"
msgstr "Հաջորդը"

#: src/postulo/templates/applications/report.html
msgid "The one before"
msgstr "Նախորդը"

#: src/postulo/templates/jobs/merge.html
msgid "The one chosen here is merged into the one above. The next page shows what would move, and nothing moves before it."
msgstr "Այստեղ ընտրվածը միավորվում է վերևում նշվածի մեջ։ Հաջորդ էջը ցույց է տալիս, թե ինչ կտեղափոխվի, և մինչ այդ ոչինչ չի տեղափոխվում։"

#: src/postulo/jobs/merging.py
msgid "The one it has"
msgstr "Դրանում եղածը"

#: src/postulo/documents/models.py
msgid "The opening paragraph, if you use one."
msgstr "Ներածական պարբերությունը, եթե այն օգտագործում եք։"

#: src/postulo/resume/importing.py
#, python-format
msgid "The ORCID iD “%(value)s” is not valid, so it was not added."
msgstr "«%(value)s» ORCID iD-ն վավեր չէ, ուստի չավելացվեց։"

#: src/postulo/templates/jobs/merge.html
msgid "The other record is deleted once everything has moved, and this cannot be undone."
msgstr "Մյուս գրառումը ջնջվում է, երբ ամեն ինչ տեղափոխվի, և սա հնարավոր չէ հետարկել։"

#: src/postulo/templates/cotton/listing_history.html
#: src/postulo/templates/jobs/capture_page.html
#: src/postulo/templates/jobs/posting_detail.html
msgid "The page as captured"
msgstr "Էջը՝ ինչպես որսվել է"

#: src/postulo/jobs/rendering.py
msgid "The page could not be drawn."
msgstr "Էջը հնարավոր չեղավ գծել։"

#: src/postulo/accounts/forms.py
msgid "The page exactly as it was read, kept beside what was read from it, so that you can check one against the other and a better parser can read it again. It holds whatever the page addressed to you: your name if you were signed in, and the tracking in its links. Kept as text, and never shown as a page."
msgstr "Էջը ճիշտ այնպես, ինչպես կարդացվել է, պահված դրանից կարդացածի կողքին, որպեսզի կարողանաք մեկը մյուսի հետ համեմատել, իսկ ավելի լավ վերլուծիչը կարողանա այն նորից կարդալ։ Այն պարունակում է այն ամենը, ինչ էջը հասցեագրել էր ձեզ՝ ձեր անունը, եթե մուտք գործած էիք, և հետևման տվյալները նրա հղումներում։ Պահվում է որպես տեքստ և երբեք չի ցուցադրվում որպես էջ։"

#: src/postulo/jobs/capture_views.py
msgid "The page it kept, its source and its picture"
msgstr "Նրա պահած էջը, էջի կոդը և պատկերը"

#: src/postulo/templates/server/capture.html
#: src/postulo/templates/settings/capture.html
#, python-format
msgid "The page of a capture that never became a listing is deleted a day after it was captured. A capture that was saved keeps its page for as long as it exists."
msgid_plural "The page of a capture that never became a listing is deleted %(counter)s days after it was captured. A capture that was saved keeps its page for as long as it exists."
msgstr[0] "Որսի էջը, որը երբեք չի դարձել հայտարարություն, ջնջվում է որսելուց %(counter)s օր անց։ Պահպանված որսը պահում է իր էջը այնքան ժամանակ, որքան գոյություն ունի։"
msgstr[1] "Որսի էջը, որը երբեք չի դարձել հայտարարություն, ջնջվում է որսելուց %(counter)s օր անց։ Պահպանված որսը պահում է իր էջը այնքան ժամանակ, որքան գոյություն ունի։"

#: src/postulo/templates/jobs/capture_review.html
msgid "The page this was read from was kept: its source, and a rendering of it."
msgstr "Էջը, որից սա կարդացվել է, պահվել է՝ նրա կոդը և պատկերը։"

#: src/postulo/jobs/rendering.py
#, python-format
msgid "The page was not drawn within %(seconds)s second, so it was left."
msgid_plural "The page was not drawn within %(seconds)s seconds, so it was left."
msgstr[0] "Էջը չգծվեց %(seconds)s վայրկյանի ընթացքում, ուստի այն թողնվեց։"
msgstr[1] "Էջը չգծվեց %(seconds)s վայրկյանի ընթացքում, ուստի այն թողնվեց։"

#: src/postulo/resume/forms.py
msgid "The page you read it on. A CV does not print it."
msgstr ""

#: src/postulo/jobs/forms.py
msgid "The part of the economy it is in. Narrows the suggestions below, and an industry of your own added here is filed under it."
msgstr "Տնտեսության այն մասը, որին այն պատկանում է։ Նեղացնում է ստորև բերված առաջարկները, և այստեղ ավելացված ձեր սեփական ոլորտը դասվում է դրա ներքո։"

#: src/postulo/jobs/forms.py
msgid "The part of the economy this industry is in. You may leave it empty."
msgstr "Տնտեսության այն մասը, որին պատկանում է այս ոլորտը։ Կարող եք թողնել դատարկ։"

#: src/postulo/templates/server/email.html
#, python-format
msgid "The password is set by <code>%(variable)s</code> in the environment; change it there. It is never shown here."
msgstr "Գաղտնաբառը սահմանվում է միջավայրում՝ <code>%(variable)s</code> փոփոխականով․ փոխեք այն այնտեղ։ Այստեղ այն երբեք չի ցուցադրվում։"

#: src/postulo/applications/models.py src/postulo/jobs/models.py
msgid "The pay"
msgstr "Վարձատրությունը"

#: src/postulo/resume/registry.py
msgid "The people who will vouch for you, kept as contacts. A CV prints one only once they have agreed, and never their email address or number unless you say so."
msgstr "Այն մարդիկ, ովքեր հանձնարարական կտան ձեր մասին, պահված որպես կոնտակտներ։ CV-ն որևէ մեկին տպում է միայն նրա համաձայնությունից հետո, և երբեք՝ նրա էլ. փոստի հասցեն կամ հեռախոսահամարը, եթե դուք դա չեք նշել։"

#: src/postulo/applications/forms.py
msgid "The person at the company this went through, where there was one."
msgstr "Ընկերության այն մարդը, ում միջոցով սա անցավ, եթե այդպիսին կար։"

#: src/postulo/documents/forms.py
msgid "The person who wrote it, from your contacts."
msgstr "Այն անձը, ով գրել է այն, ձեր կոնտակտներից։"

#: src/postulo/documents/models.py
msgid "The person you are writing to, if the application names one"
msgstr "Անձը, ում գրում եք, եթե դիմումում նշված է այդպիսին"

#: src/postulo/documents/models.py
msgid "The photo from your details, beside your name. It is in the PDF and the preview; the plain text and the Word file leave it out."
msgstr "Ձեր տվյալների լուսանկարը՝ ձեր անվան կողքին։ Այն առկա է PDF-ում և նախադիտման մեջ․ պարզ տեքստը և Word ֆայլը այն բաց են թողնում։"

#: src/postulo/core/help.py
msgid "The picture that stands for you on these pages: one you upload, your Gravatar, or your initials."
msgstr "Նկարը, որը ներկայացնում է ձեզ այս էջերում՝ ձեր վերբեռնածը, ձեր Gravatar-ը կամ ձեր սկզբնատառերը։"

#: src/postulo/core/server_views.py
msgid "The plugins that ship inside Postulo. Nothing is fetched."
msgstr "Postulo-ի հետ եկող հավելումները։ Ոչինչ չի ներբեռնվում։"

#: src/postulo/templates/applications/application_detail.html
#: src/postulo/templates/jobs/partials/listing_row.html
msgid "The posting"
msgstr "Հայտարարությունը"

#: src/postulo/templates/applications/report.html
msgid "the posting"
msgstr "հայտարարությունը"

#: src/postulo/templates/applications/application_intake.html
#: src/postulo/templates/jobs/capture_review.html
#: src/postulo/templates/jobs/listing_form.html
msgid "The posting itself"
msgstr "Ինքը՝ հայտարարությունը"

#: src/postulo/jobs/forms.py
msgid "The posting's own address, kept so you can go back to it. Postulo reads the page when you capture it and never fetches it again."
msgstr "Հայտարարության սեփական հասցեն՝ պահված, որպեսզի կարողանաք վերադառնալ դրան։ Postulo-ն կարդում է էջը, երբ այն որսում եք, և այլևս երբեք չի բերում այն։"

#: src/postulo/plugins/consent.py
#, python-format
msgid "The provider answered %(status)s."
msgstr "Մատակարարը պատասխանեց %(status)s։"

#: src/postulo/core/mail_auth.py
msgid "The provider sent no refresh token, so mail would stop within the hour. Check that offline access is allowed for this application."
msgstr "Մատակարարը թարմացման թոքեն չուղարկեց, ուստի փոստը կդադարեր մեկ ժամվա ընթացքում։ Ստուգեք, որ այս հավելվածի համար անցանց մուտքը թույլատրված է։"

#: src/postulo/plugins/consent.py
msgid "The provider will not renew this. Somebody has to agree to it again."
msgstr "Մատակարարը սա չի երկարաձգի։ Ինչ-որ մեկը պետք է նորից համաձայնություն տա։"

#: src/postulo/plugins/consent.py
msgid "The provider's reply was not readable."
msgstr "Մատակարարի պատասխանը հնարավոր չեղավ կարդալ։"

#: src/postulo/plugins/consent.py
msgid "The provider's token address redirected, and Postulo does not follow it."
msgstr "Մատակարարի թոքենի հասցեն վերահղում կատարեց, և Postulo-ն չի հետևում դրան։"

#: src/postulo/applications/forms.py
msgid "The public employment service you are registered with. Add it under Companies, as a public employment service, if it is not here."
msgstr "Զբաղվածության պետական ծառայությունը, որտեղ գրանցված եք։ Եթե այն այստեղ չէ, ավելացրեք այն «Ընկերություններ» բաժնում՝ որպես զբաղվածության պետական ծառայություն։"

#: src/postulo/resume/candidate.py
msgid "The publication it counts cannot be added, so it will be a count for all of your work."
msgstr ""

#: src/postulo/resume/candidate.py
msgid "The publication it counts is not in the file, so it will be a count for all of your work."
msgstr ""

#: src/postulo/applications/views.py
msgid "The reason was not kept: only an application that was rejected, withdrawn or ghosted has one."
msgstr "Պատճառը չպահվեց․ պատճառ ունի միայն մերժված, հետ վերցված կամ անպատասխան մնացած դիմումը։"

#: src/postulo/notifications/webhooks.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Ստացողը պատասխանեց՝ %(status)s։"

#: src/postulo/templates/server/data_protection.html
msgid "The record of what this instance processes, and who receives it."
msgstr "Մշակման գործողությունների գրանցամատյան՝ ինչ է մշակում այս տեղակայումը և ով է այն ստանում։"

#: src/postulo/documents/models.py
msgid "The referee sends it themselves"
msgstr "Հանձնարարական տվողն ինքն է ուղարկում այն"

#: src/postulo/jobs/rendering.py
msgid "The renderer could not be started."
msgstr "Գծող շարժիչը հնարավոր չեղավ գործարկել։"

#: src/postulo/templates/jobs/capture_page.html
msgid "The rendering"
msgstr "Էջի պատկերը"

#: src/postulo/jobs/rendering.py
msgid "The rendering came out larger than this instance keeps."
msgstr "Էջի պատկերը ստացվեց ավելի մեծ, քան պահում է այս տեղակայումը։"

#: src/postulo/templates/jobs/capture_page_forget.html
#, python-format
msgid "The rendering kept of the page that “%(title)s” was read from will be deleted permanently."
msgstr "Այն էջի պատկերը, որից կարդացվել է «%(title)s» հայտարարությունը, ընդմիշտ կջնջվի։"

#: src/postulo/templates/jobs/capture_page.html
msgid "The rendering, in a box that scrolls"
msgstr "Էջի պատկերը՝ ոլորվող շրջանակում"

#: src/postulo/jobs/pages.py
msgid "The request did not say how large the rendering is."
msgstr "Հարցումը չնշեց էջի պատկերի չափը։"

#: src/postulo/api/problems.py
#, python-format
msgid "The request is larger than %(limit)s, which is the most this call reads."
msgstr "Հարցումը գերազանցում է %(limit)s սահմանը, որն ամենաշատն է, ինչ կարդում է այս կանչը։"

#: src/postulo/api/problems.py
msgid "The request was not in the shape this call takes."
msgstr "Հարցումն այն ձևով չէր, որն ընդունում է այս կանչը։"

#: src/postulo/templates/resume/europass_import.html
msgid "The rest of the file is still worth importing. What is listed here is not, and you can add it by hand afterwards."
msgstr "Ֆայլի մնացած մասը դեռ արժե ներմուծել։ Այստեղ թվարկվածը՝ ոչ, և կարող եք այն հետո ձեռքով ավելացնել։"

#: src/postulo/templates/applications/application_intake.html
#: src/postulo/templates/jobs/capture_review.html
#: src/postulo/templates/jobs/listing_form.html
msgid "The role"
msgstr "Պաշտոնը"

#: src/postulo/applications/forms.py
msgid "The route it went through. The report counts by this, including how many went through the public employment service's own board."
msgstr "Ուղին, որով այն անցավ։ Հաշվետվությունը հաշվում է ըստ սրա, այդ թվում՝ քանիսն են անցել զբաղվածության պետական ծառայության սեփական աշխատանքի կայքով։"

#: src/postulo/jobs/conflicts.py
msgid "The same advert"
msgstr "Նույն հայտարարությունը"

#: src/postulo/templates/jobs/capture_review.html
msgid "The same advert on another board is evidence about the job. Adding this capture to a listing's history keeps it, with any page it kept, and makes no second listing."
msgstr "Նույն հայտարարությունը մեկ այլ աշխատանքի կայքում ապացույց է աշխատանքի մասին։ Այս որսը հայտարարության պատմությանն ավելացնելիս այն պահվում է իր պահած էջի հետ միասին, և երկրորդ հայտարարություն չի ստեղծվում։"

#: src/postulo/jobs/conflicts.py
msgid "The same email address"
msgstr "Նույն էլ. փոստի հասցեն"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same email address: %(email)s"
msgstr "Նույն էլ. փոստի հասցեն՝ %(email)s"

#: src/postulo/templates/documents/cv_detail.html
msgid "The same entries without the layout, in this document's language. None of these is filed as a version you sent."
msgstr "Նույն գրառումները՝ առանց ձևավորման, այս փաստաթղթի լեզվով։ Սրանցից ոչ մեկը չի պահվում որպես ձեր ուղարկած տարբերակ։"

#: src/postulo/applications/widgets.py
msgid "The same figures by sector, and by industry within each. A company in three fields counts in all three."
msgstr "Նույն ցուցանիշները՝ ըստ ճյուղի, և ըստ ոլորտի՝ յուրաքանչյուրի ներսում։ Երեք ոլորտում գործող ընկերությունը հաշվվում է երեքում էլ։"

#: src/postulo/jobs/conflicts.py
msgid "The same identifier"
msgstr "Նույն նույնացուցիչը"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same identifier: %(identifier)s"
msgstr "Նույն նույնացուցիչը՝ %(identifier)s"

#: src/postulo/jobs/conflicts.py src/postulo/jobs/duplicates.py
msgid "The same name"
msgstr "Նույն անունը"

#: src/postulo/jobs/duplicates.py
msgid "The same name, once the legal form is set aside"
msgstr "Նույն անունը՝ առանց իրավական ձևը հաշվի առնելու"

#: src/postulo/templates/jobs/conflicts.html
msgid "The same thing twice"
msgstr "Նույն բանը երկու անգամ"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same website: %(domain)s"
msgstr "Նույն կայքը՝ %(domain)s"

#: src/postulo/templates/server/overview.html
msgid "The scheduler asks once a day; run manage.py check_for_updates to ask now."
msgstr "Պլանավորիչը հարցնում է օրը մեկ անգամ․ հիմա հարցնելու համար գործարկեք manage.py check_for_updates։"

#: src/postulo/core/server_forms.py
msgid "The schemes were not sent with this request, so nothing was changed. To define none, empty the box and save."
msgstr "Սխեմաները չեն ուղարկվել այս հարցման հետ, ուստի ոչինչ չփոխվեց։ Որպեսզի ոչ մի սխեմա չսահմանեք, դատարկեք դաշտը և պահպանեք։"

#: src/postulo/applications/widgets.py
msgid "The search in four numbers"
msgstr "Որոնումը չորս թվով"

#: src/postulo/templates/server/design.html
msgid "The second"
msgstr "Երկրորդը"

#: src/postulo/resume/forms.py
msgid "The series it belongs to, if any."
msgstr "Մատենաշարը, որին այն պատկանում է, եթե կա։"

#: src/postulo/core/mail.py
msgid "The server does not offer STARTTLS. Turn it off, or use a port that does."
msgstr "Սերվերը STARTTLS չի առաջարկում։ Անջատեք այն կամ օգտագործեք պորտ, որն առաջարկում է։"

#: src/postulo/core/mail.py
#, python-format
msgid "The server refused those credentials: %(detail)s"
msgstr "Սերվերը մերժեց այդ մուտքի տվյալները՝ %(detail)s"

#: src/postulo/core/server_forms.py
msgid "The server that accepts the mail — its name, not an address."
msgstr "Սերվերը, որն ընդունում է փոստը — դրա անունը, ոչ թե հասցեն։"

#: src/postulo/core/server_forms.py
msgid "The service's base address. Left empty with Nominatim, OpenStreetMap's public instance is used: https://nominatim.openstreetmap.org. For your own: for example https://photon.example.org"
msgstr ""

#: src/postulo/plugins/fetching.py
msgid "The site asked us to slow down (429). Try again in a few minutes."
msgstr "Կայքը խնդրեց դանդաղեցնել հարցումները (429)։ Փորձեք նորից մի քանի րոպեից։"

#: src/postulo/plugins/fetching.py
#, python-format
msgid "The site is having trouble (%(status)s). That is their end, not yours."
msgstr "Կայքը խնդիրներ ունի (%(status)s)։ Խնդիրը նրանց կողմում է, ոչ թե ձեր։"

#: src/postulo/plugins/fetching.py
msgid "The site redirected without saying where to."
msgstr "Կայքը վերահղեց՝ չասելով ուր։"

#: src/postulo/plugins/fetching.py
#, python-format
msgid "The site refused the request (%(status)s). Large sites often sit behind bot protection that turns away anything that is not a browser, even when the page is perfectly visible to you. Paste the page source in below instead."
msgstr "Կայքը մերժեց հարցումը (%(status)s)։ Խոշոր կայքերը հաճախ օգտագործում են բոտերից պաշտպանություն, որը մերժում է այն ամենը, ինչ դիտարկիչ չէ, նույնիսկ երբ էջը ձեզ համար լիովին տեսանելի է։ Փոխարենը ստորև տեղադրեք էջի կոդը։"

#: src/postulo/templates/jobs/capture_form.html
msgid "The site refuses Postulo, or the posting needs a login"
msgstr "Կայքը մերժում է Postulo-ն, կամ հայտարարությունը մուտք է պահանջում"

#: src/postulo/templates/jobs/capture_form.html
msgid "The site's robots.txt is honoured."
msgstr "Կայքի robots.txt-ը հարգվում է։"

#: src/postulo/templates/server/design.html
msgid "The smallest size, for a label beside something."
msgstr "Ամենափոքր չափը՝ ինչ-որ բանի կողքին պիտակի համար։"

#: src/postulo/documents/printing.py
msgid "The social profile chosen for this CV is no longer in your details, so it prints none."
msgstr "Այս CV-ի համար ընտրված սոցիալական պրոֆիլն այլևս ձեր տվյալներում չէ, ուստի ոչինչ չի տպվում։"

#: src/postulo/resume/forms.py
msgid "The sort of event. “Not stated” prints nothing."
msgstr "Միջոցառման տեսակը։ «Նշված չէ» տարբերակը ոչինչ չի տպում։"

#: src/postulo/templates/jobs/capture_page.html
msgid "The source"
msgstr "Էջի կոդը"

#: src/postulo/templates/server/capture.html
msgid "The source is a stranger's markup. It is kept as text, shown as text and downloaded as text, and never drawn as a page."
msgstr "Կոդը օտար մարդու նշագրում է։ Այն պահվում է որպես տեքստ, ցուցադրվում է որպես տեքստ և ներբեռնվում է որպես տեքստ, և երբեք չի գծվում որպես էջ։"

#: src/postulo/templates/jobs/capture_page_forget.html
#, python-format
msgid "The source kept of the page that “%(title)s” was read from will be deleted permanently."
msgstr "Այն էջի կոդը, որից կարդացվել է «%(title)s» հայտարարությունը, ընդմիշտ կջնջվի։"

#: src/postulo/jobs/pages.py
msgid "The source of the page could not be kept."
msgstr "Էջի կոդը հնարավոր չեղավ պահել։"

#: src/postulo/templates/jobs/capture_review.html
msgid "The source of the page this was read from was kept."
msgstr "Պահվել է այն էջի կոդը, որից սա կարդացվել է։"

#: src/postulo/jobs/pages.py
#, python-format
msgid "The source of the page was not kept. %(why)s"
msgstr "Էջի կոդը չպահվեց։ %(why)s"

#: src/postulo/templates/jobs/capture_page.html
msgid "The source, as text"
msgstr "Էջի կոդը՝ որպես տեքստ"

#: src/postulo/core/csv_import.py
msgid "The spreadsheet gave a status but no date, so this application is not counted in figures measured from the date it was sent. Set it on the application to include it."
msgstr "Աղյուսակում նշված է կարգավիճակ, բայց ոչ ամսաթիվ, ուստի այս դիմումը հաշվի չի առնվում ուղարկման ամսաթվից հաշվարկվող ցուցանիշներում։ Այն ներառելու համար նշեք ամսաթիվը դիմումում։"

#: src/postulo/applications/widgets.py
msgid "The stage each application had reached when it was rejected, withdrawn or ghosted, and the reason where one was given."
msgstr "Յուրաքանչյուր դիմումի հասած փուլը, երբ այն մերժվեց, հետ վերցվեց կամ մնաց անպատասխան, և պատճառը, եթե այն նշվել է։"

#: src/postulo/templates/widgets/endings.html
msgid "The stage is read from each timeline: where the application stood when it ended."
msgstr "Փուլը կարդացվում է յուրաքանչյուր ժամանակագրությունից՝ որտեղ էր դիմումը, երբ ավարտվեց։"

#: src/postulo/templates/help/identifiers.html
msgid "The star at the start of a row marks your primary identifier. A CV prints it first, and alone where its template has room for only one. Removing it hands the star to the next row."
msgstr "Տողի սկզբում աստղը նշում է ձեր հիմնական նույնացուցիչը։ CV-ն այն տպում է առաջինը, և միայնակ, եթե իր ձևանմուշում տեղ կա միայն մեկի համար։ Այն հեռացնելիս աստղն անցնում է հաջորդ տողին։"

#: src/postulo/applications/forms.py
msgid "The start date they proposed, if one was."
msgstr "Նրանց առաջարկած սկսելու ամսաթիվը, եթե այդպիսին կար։"

#: src/postulo/core/mail_auth.py
msgid "The stored mail credentials cannot be read on this instance."
msgstr "Պահված փոստի մուտքի տվյալները հնարավոր չէ կարդալ այս տեղակայումում։"

#: src/postulo/documents/forms.py
msgid "The subject has to be one line."
msgstr "Թեման պետք է լինի մեկ տող։"

#: src/postulo/templates/settings/appearance.html
msgid "The switch at the top right cycles through the same three; this is the explicit version."
msgstr "Վերևի աջ անկյունի փոխարկիչը հերթով անցնում է նույն երեքով․ սա դրա բացահայտ տարբերակն է։"

#: src/postulo/core/views_tables.py
msgid "The table opens plain again."
msgstr "Աղյուսակը կրկին բացվում է իր պարզ տեսքով։"

#: src/postulo/templates/help/listings.html
msgid "The tabs sort them by where they stand, and the search box over the table narrows what is listed. Columns and filters can be chosen and kept as a saved view."
msgstr "Ներդիրները դրանք բաժանում են ըստ կարգավիճակի, իսկ աղյուսակի վերևի որոնման դաշտը նեղացնում է ցուցակը։ Սյուներն ու զտիչները կարելի է ընտրել և պահել որպես պահպանված տեսք։"

#: src/postulo/templates/server/design.html
msgid "The tag palette"
msgstr "Պիտակների գունապնակը"

#: src/postulo/jobs/forms.py
msgid "The team they are in, if you know it. A new name joins the company's list."
msgstr "Թիմը, որում նա է, եթե գիտեք։ Նոր անունն ավելանում է ընկերության ցանկին։"

#: src/postulo/documents/printing.py
msgid "The telephone number chosen for this CV is no longer in your details, so it prints none."
msgstr "Այս CV-ի համար ընտրված հեռախոսահամարն այլևս ձեր տվյալներում չէ, ուստի ոչինչ չի տպվում։"

#: src/postulo/resume/importing.py
#, python-format
msgid "The telephone number of %(name)s was not added."
msgstr "%(name)s-ի հեռախոսահամարը չավելացվեց։"

#: src/postulo/templates/documents/cv_text.html
msgid "The text of this document"
msgstr "Այս փաստաթղթի տեքստը"

#: src/postulo/templates/server/design.html
msgid "The thing to do next"
msgstr "Հաջորդ անելիքը"

#: src/postulo/templates/server/defaults.html
#, python-format
msgid "The time zone is set by the environment: <code>%(variable)s</code> = %(zone)s. Remove it from the environment to change it here."
msgstr "Ժամային գոտին սահմանում է միջավայրը՝ <code>%(variable)s</code> = %(zone)s։ Հեռացրեք այն միջավայրից՝ այստեղ փոխելու համար։"

#: src/postulo/documents/models.py
msgid "The town and country from your details, never a street."
msgstr "Քաղաքը և երկիրը ձեր տվյալներից, երբեք՝ փողոցը։"

#: src/postulo/accounts/forms.py
msgid "The town or city as you would write it. It is only ever text: it is not looked up and never put on a map."
msgstr "Քաղաքը այնպես, ինչպես կգրեիք այն։ Այն միշտ միայն տեքստ է․ այն չի փնտրվում և երբեք չի դրվում քարտեզի վրա։"

#: src/postulo/resume/forms.py
msgid "The university, laboratory or body behind it: a thesis's school."
msgstr "Համալսարանը, լաբորատորիան կամ մարմինը, որի ներքո է այն․ թեզի դեպքում՝ ուսումնական հաստատությունը։"

#: src/postulo/applications/forms.py src/postulo/jobs/forms.py
msgid "The upper figure cannot be below the lower one."
msgstr "Վերին թիվը չի կարող փոքր լինել ստորինից։"

#: src/postulo/templates/documents/rendered_compare.html
msgid "The version before it"
msgstr "Դրան նախորդող տարբերակը"

#: src/postulo/resume/forms.py
msgid "The volume, as the publisher numbers it."
msgstr "Հատորը, ինչպես համարակալում է հրատարակիչը։"

#: src/postulo/resume/importing.py
#, python-format
msgid "The website %(site)s is already among your links, so it was not added."
msgstr "%(site)s կայքն արդեն ձեր հղումների մեջ է, ուստի չավելացվեց։"

#: src/postulo/documents/printing.py
msgid "The website chosen for this CV is no longer in your details, so it prints none."
msgstr "Այս CV-ի համար ընտրված կայքն այլևս ձեր տվյալներում չէ, ուստի ոչինչ չի տպվում։"

#: src/postulo/resume/importing.py
#, python-format
msgid "The website “%(value)s” is not a valid address, so it was not added."
msgstr "«%(value)s» կայքը վավեր հասցե չէ, ուստի չավելացվեց։"

#: src/postulo/plugins/catalogue.py
msgid "The wheel does not match the checksum the catalogue published for it."
msgstr "Wheel փաթեթը չի համապատասխանում այն ստուգիչ գումարին, որը կատալոգը հրապարակել է դրա համար։"

#: src/postulo/plugins/installing.py
msgid "The wheel has an encrypted member, which a plugin never needs."
msgstr "Անիվը գաղտնագրված տարր ունի, որը հավելմանը երբեք պետք չէ։"

#: src/postulo/plugins/installing.py
msgid "The wheel has no metadata; it may be damaged."
msgstr "Wheel փաթեթը մետատվյալներ չունի․ այն կարող է վնասված լինել։"

#: src/postulo/plugins/installing.py
msgid "The wheel holds far more files than any plugin does."
msgstr "Անիվը պարունակում է շատ ավելի ֆայլեր, քան որևէ հավելում։"

#: src/postulo/plugins/installing.py
msgid "The wheel's metadata cannot be read; it may be damaged."
msgstr "Անիվի մետատվյալները հնարավոր չէ կարդալ․ այն կարող է վնասված լինել։"

#: src/postulo/plugins/installing.py
msgid "The wheel's metadata is far larger than any plugin's."
msgstr "Անիվի մետատվյալները շատ ավելի մեծ են, քան որևէ հավելմանը։"

#: src/postulo/templates/documents/rendered_compare.html
msgid "The words are the same in both. If the two PDFs look different, what changed is how they are set: the theme, or the layout."
msgstr "Բառերը երկուսում էլ նույնն են։ Եթե երկու PDF-ները տարբեր տեսք ունեն, փոխվել է դրանց ձևավորումը՝ թեման կամ դասավորությունը։"

#: src/postulo/templates/documents/letter_detail.html
msgid "The words without the layout, in this letter's language. None of these is filed as a version you sent."
msgstr "Բառերը՝ առանց ձևավորման, այս նամակի լեզվով։ Սրանցից ոչ մեկը չի պահվում որպես ձեր ուղարկած տարբերակ։"

#: src/postulo/core/errands.py
msgid "The work was interrupted before it finished. Please try again."
msgstr "Աշխատանքն ընդհատվեց մինչև ավարտը։ Կրկին փորձեք։"

#: src/postulo/jobs/merging.py
msgid "Their entry among your references"
msgstr "Նրանց գրառումը ձեր հանձնարարականների մեջ"

#: src/postulo/jobs/merging.py
msgid "Their entry among your references: you already have one for the other."
msgstr "Նրանց գրառումը ձեր հանձնարարականների մեջ․ մյուսի համար արդեն ունեք մեկը։"

#: src/postulo/jobs/forms.py
msgid "Their job title, as they give it themselves."
msgstr "Նրանց պաշտոնի անվանումը, ինչպես իրենք են այն ներկայացնում։"

#: src/postulo/templates/jobs/share.html
msgid "Their username or email address on this instance, exactly."
msgstr "Նրա օգտանունը կամ էլ. փոստի հասցեն այս տեղակայման մեջ՝ ճշգրիտ։"

#: src/postulo/accounts/models.py src/postulo/documents/models.py
msgid "theme"
msgstr "թեմա"

#: src/postulo/core/context_processors.py
#, python-format
msgid "Theme: %(current)s. Switch to: %(next)s."
msgstr "Թեմա՝ %(current)s։ Անցնել՝ %(next)s։"

#: src/postulo/core/context_processors.py
#, python-format
msgid "Theme: %(theme)s"
msgstr "Թեմա՝ %(theme)s"

#: src/postulo/templates/accounts/delete_account.html
msgid "Then delete"
msgstr "Ապա ջնջել"

#: src/postulo/core/messaging_handles.py
#, python-format
msgid "There are at most %(max)s messaging handles here."
msgstr "Այստեղ կարող է լինել առավելագույնը %(max)s մեսենջերի անուն։"

#: src/postulo/resume/views.py
msgid "There are no links to check."
msgstr "Ստուգելու հղումներ չկան։"

#: src/postulo/core/views_access.py
msgid "There is a group of that name already."
msgstr "Այդ անունով խումբ արդեն կա։"

#: src/postulo/jobs/slow.py
msgid "There is no address to fetch it from again."
msgstr "Հասցե չկա, որտեղից այն կարելի է նորից բերել։"

#: src/postulo/documents/archiving.py
msgid "There is no file to send."
msgstr "Ուղարկելու ֆայլ չկա։"

#: src/postulo/resume/candidate.py
msgid "There is no handle here to read."
msgstr "Այստեղ կարդալու մեսենջերի անուն չկա։"

#: src/postulo/jobs/pages.py
msgid "There is no kept source to draw from, and a rendering is drawn from it."
msgstr "Չկա պահված էջի կոդ, որից կարելի է գծել, իսկ էջի պատկերը գծվում է դրանից։"

#: src/postulo/core/server_views.py
msgid "There is no repository by that name."
msgstr "Այդ անունով պահոց չկա։"

#: src/postulo/plugins/fetching.py
msgid "There is nothing at that address (404). Check the link."
msgstr "Այդ հասցեում ոչինչ չկա (404)։ Ստուգեք հղումը։"

#: src/postulo/templates/jobs/merge.html
msgid "There is nothing else to merge it with."
msgstr "Այն միավորելու ուրիշ ոչինչ չկա։"

#: src/postulo/templates/404.html
msgid "There is nothing here, or it is not yours to see."
msgstr "Այստեղ ոչինչ չկա, կամ դուք այն տեսնելու իրավունք չունեք։"

#: src/postulo/templates/core/kind_file.html
#: src/postulo/templates/resume/candidate_file.html
msgid "There is nothing in this file to add: what it holds, you already have, or cannot be added."
msgstr "Այս ֆայլում ավելացնելու ոչինչ չկա․ դրա պարունակությունն արդեն ունեք, կամ այն հնարավոր չէ ավելացնել։"

#: src/postulo/templates/documents/cv_text.html
msgid "There is nothing on this document yet, so there is no text to copy."
msgstr "Այս փաստաթղթում դեռ ոչինչ չկա, ուստի պատճենելու տեքստ չկա։"

#: src/postulo/plugins/installing.py
msgid "There is nothing to go back to: no plugin has been installed since."
msgstr "Վերադառնալու բան չկա․ այդ ժամանակից ի վեր ոչ մի հավելում չի տեղադրվել։"

#: src/postulo/applications/views_ical.py src/postulo/core/views_kind_files.py
#: src/postulo/jobs/vcard_views.py src/postulo/resume/views.py
#: src/postulo/resume/views_candidate.py
msgid "There is nothing waiting to be imported."
msgstr "Ներմուծման սպասող ոչինչ չկա։"

#: src/postulo/jobs/pages.py
msgid "There was nothing to keep."
msgstr "Պահելու բան չկար։"

#: src/postulo/templates/widgets/insight_counters.html
#, python-format
msgid "These figures come from %(total)s application. Read them as a record of what happened, not as a rate that predicts anything."
msgid_plural "These figures come from %(total)s applications — too few to draw conclusions from. Read them as a record of what happened, not as rates that predict anything."
msgstr[0] "Այս թվերը հիմնված են %(total)s դիմումի վրա։ Դիտեք դրանք որպես կատարվածի արձանագրություն, ոչ թե որևէ բան կանխատեսող ցուցանիշ։"
msgstr[1] "Այս թվերը հիմնված են %(total)s դիմումի վրա — չափազանց քիչ՝ եզրակացություններ անելու համար։ Դիտեք դրանք որպես կատարվածի արձանագրություն, ոչ թե որևէ բան կանխատեսող ցուցանիշներ։"

#: src/postulo/templates/cotton/duplicates.html
msgid "These look like the same one, and may not be. Nothing is merged unless you say so, and you are shown what would move first."
msgstr "Սրանք կարծես նույն գրառումն են, բայց կարող է և այդպես չլինել։ Ոչինչ չի միավորվում առանց ձեր համաձայնության, և նախ ձեզ ցույց է տրվում, թե ինչ կտեղափոխվի։"

#: src/postulo/templates/jobs/move_owner.html
msgid "These no longer see it, and each keeps a copy of their own of what their applications, notes and other records point at:"
msgstr "Սրանք այլևս չեն տեսնում այն, և յուրաքանչյուրը պահում է իր սեփական պատճենը այն ամենի, ինչին հղվում են իր դիմումները, նշումները և այլ գրառումները․"

#: src/postulo/templates/server/logs.html
msgid "These records are also served at <code>/logs</code> for a log collector, behind the token in POSTULO_LOGS_TOKEN. Anything holding that token can read everything on this page."
msgstr "Այս գրառումները հասանելի են նաև <code>/logs</code> հասցեով՝ մատյանների հավաքիչի համար, POSTULO_LOGS_TOKEN-ում պահվող թոքենով։ Ով որ ունի այդ թոքենը, կարող է կարդալ այս էջում եղած ամեն ինչ։"

#: src/postulo/templates/server/logs.html
msgid "These records can name people and their applications."
msgstr "Այս գրառումներում կարող են նշված լինել մարդիկ և նրանց դիմումները։"

