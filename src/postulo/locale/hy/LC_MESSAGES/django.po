msgstr "Արխիվ՝ վերականգնելու համար"

#: src/postulo/plugins/secrets.py
msgid "An authenticator's secret cannot be read: it was encrypted under a different key. If SECRET_KEY was rotated, set POSTULO_FIELD_KEY to the old key."
msgstr "Նույնականացման հավելվածի գաղտնիքը հնարավոր չէ կարդալ․ այն գաղտնագրվել է այլ բանալիով։ Եթե SECRET_KEY բանալին փոխվել է, սահմանեք POSTULO_FIELD_KEY փոփոխականը հին բանալիով։"

