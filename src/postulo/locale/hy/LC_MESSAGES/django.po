#: src/postulo/templates/resume/publication_orcid.html
msgid "You already have this one."
msgstr ""

#: src/postulo/resume/candidate.py
msgid "You already hold the most nationalities a profile can."
msgstr "Դուք արդեն ունեք պրոֆիլի համար թույլատրելի առավելագույն քանակով քաղաքացիություններ։"

#: src/postulo/resume/candidate.py
msgid "You already list this address for somebody you deal with, and an address is listed once."
msgstr "Այս հասցեն արդեն նշված է այն մարդկանցից մեկի համար, որոնց հետ գործ ունեք, իսկ հասցեն նշվում է մեկ անգամ։"

#: src/postulo/templates/jobs/company_map.html
msgid "You are about here"
msgstr "Դուք մոտավորապես այստեղ եք"

#: src/postulo/accounts/views.py
msgid "You are already signed in."
msgstr "Դուք արդեն մուտք եք գործել։"

#: src/postulo/templates/accounts/groups.html
msgid "You are in no group. An administrator adds people to groups."
msgstr "Դուք ոչ մի խմբում չեք։ Մարդկանց խմբերին ավելացնում է ադմինիստրատորը։"

#: src/postulo/templates/accounts/groups.html
msgid "You are its last member and it still owns records: give them to somebody, or delete them, before you leave."
msgstr "Դուք դրա վերջին անդամն եք, և այն դեռ գրառումներ ունի․ հեռանալուց առաջ դրանք տվեք մեկ ուրիշի կամ ջնջեք։"

#: src/postulo/accounts/views.py
#, python-format
msgid "You are no longer in %(name)s."
msgstr "Դուք այլևս %(name)s-ում չեք։"

#: src/postulo/templates/server/plugins.html
msgid "You are not authorised to change settings."
msgstr "Դուք կարգավորումները փոխելու թույլտվություն չունեք։"

#: src/postulo/templates/server/design.html
msgid "You are reading this comfortable."
msgstr "Սա կարդում եք «Ազատ» խտությամբ։"

#: src/postulo/templates/server/design.html
msgid "You are reading this compact."
msgstr "Սա կարդում եք «Սեղմ» խտությամբ։"

#: src/postulo/templates/accounts/delete_account.html
msgid "You are the last administrator of this instance, and an instance needs one. Make somebody else an administrator under Server settings → People, then come back."
msgstr "Դուք այս տեղակայման վերջին ադմինիստրատորն եք, իսկ տեղակայմանը մեկը պետք է։ Նախ ուրիշին դարձրեք ադմինիստրատոր «Սերվերի կարգավորումներ → Մարդիկ» բաժնում, ապա վերադարձեք։"

#: src/postulo/templates/core/partials/errand_state.html
msgid "You can close this. The work carries on without you."
msgstr "Կարող եք փակել սա։ Աշխատանքը կշարունակվի առանց ձեզ։"

#: src/postulo/templates/core/export.html
msgid "You can delete your account yourself: every record, every file on the disk, tokens, connections, and the account. The export above is the safety net; take it first."
msgstr "Հաշիվը կարող եք ինքներդ ջնջել՝ յուրաքանչյուր գրառում, սկավառակի յուրաքանչյուր ֆայլ, թոքենները, կապերը և ինքը՝ հաշիվը։ Վերևի արտահանումն ապահովության միջոց է․ նախ կատարեք այն։"

#: src/postulo/templates/help/identifiers.html
msgid "You can have one of each kind, except <em>Other</em>. A kind you have already recorded cannot be chosen on another row, and saving refuses a second one and says which kind it is. Saving adds the row you filled in and offers an empty one for the next."
msgstr "Կարող եք ունենալ յուրաքանչյուր տեսակից մեկը, բացի <em>Այլ</em> տեսակից։ Արդեն գրանցված տեսակը հնարավոր չէ ընտրել այլ տողում, և պահպանելիս երկրորդը մերժվում է՝ նշելով, թե որ տեսակն է։ Պահպանելը ավելացնում է ձեր լրացրած տողը և առաջարկում դատարկ տող հաջորդի համար։"

#: src/postulo/templates/core/partials/errand_state.html
msgid "You can leave this page. The work carries on without you."
msgstr "Կարող եք լքել այս էջը։ Աշխատանքը կշարունակվի առանց ձեզ։"

#: src/postulo/templates/jobs/move_owner.html
msgid "You can no longer delete it, share it or take it back on your own."
msgstr "Դուք այլևս չեք կարող ինքնուրույն ջնջել այն, կիսվել դրանով կամ հետ վերցնել այն։"

#: src/postulo/accounts/forms.py
msgid "You can sign in with this or with your address. Nobody else sees it — Postulo shows people your name."
msgstr "Կարող եք մուտք գործել սրանով կամ ձեր հասցեով։ Ուրիշ ոչ ոք այն չի տեսնում — Postulo-ն մարդկանց ցույց է տալիս ձեր անունը։"

#: src/postulo/core/server_views.py
msgid "You cannot deactivate the account you are signed in with."
msgstr "Չեք կարող անջատել այն հաշիվը, որով մուտք եք գործել։"

#: src/postulo/jobs/ownership.py
msgid "You cannot give it to them."
msgstr "Դուք չեք կարող այն տալ նրանց։"

#: src/postulo/plugins/policy.py
msgid "You chose this."
msgstr "Դուք եք դա ընտրել։"

#: src/postulo/templates/jobs/listing_apply.html
msgid "You have applied to this one before. Recording a second application is fine; both stay on the record."
msgstr "Դուք արդեն դիմել եք սրան։ Երկրորդ դիմում գրանցելը խնդիր չէ․ երկուսն էլ պահպանվում են։"

#: src/postulo/core/phone_numbers.py
#, python-format
msgid "You have been told about a lot of numbers already recorded here. That answer is available again in %(minutes)d minute."
msgid_plural "You have been told about a lot of numbers already recorded here. That answer is available again in %(minutes)d minutes."
msgstr[0] "Ձեզ արդեն տեղեկացվել է այստեղ գրանցված բազմաթիվ համարների մասին։ Այդ պատասխանը կրկին հասանելի կլինի %(minutes)d րոպեից։"
msgstr[1] "Ձեզ արդեն տեղեկացվել է այստեղ գրանցված բազմաթիվ համարների մասին։ Այդ պատասխանը կրկին հասանելի կլինի %(minutes)d րոպեից։"

#: src/postulo/resume/views.py
#, python-format
msgid "You have fetched as many addresses as are allowed for now: %(count)d link was not checked. Check again later for the rest."
msgid_plural "You have fetched as many addresses as are allowed for now: %(count)d links were not checked. Check again later for the rest."
msgstr[0] "Այս պահին թույլատրվածի չափով հասցեներ արդեն բեռնել եք․ %(count)d հղում չստուգվեց։ Մնացածը կրկին ստուգեք ավելի ուշ։"
msgstr[1] "Այս պահին թույլատրվածի չափով հասցեներ արդեն բեռնել եք․ %(count)d հղում չստուգվեց։ Մնացածը կրկին ստուգեք ավելի ուշ։"

#: src/postulo/core/correspondence.py
msgid "You have no outbox set up, so there is nothing to send from your own address with."
msgstr "Դուք չունեք կարգավորված ելքային արկղ, ուստի ձեր սեփական հասցեից ուղարկելու բան չկա։"

#: src/postulo/templates/settings/account.html
#, python-format
msgid "You have no recovery codes. Lose the device holding your passkey and there is nothing else to try. <a class=\"underline\" href=\"%(url)s\">Generate some</a> and keep them somewhere that is not the device."
msgstr "Վերականգնման կոդեր չունեք։ Եթե կորցնեք ձեր անցաբանալին կրող սարքը, ուրիշ փորձելու բան չի մնա։ <a class=\"underline\" href=\"%(url)s\">Ստեղծեք մի քանիսը</a> և պահեք դրանք այդ սարքից դուրս։"

#: src/postulo/templates/jobs/posting_detail.html
msgid "You have not applied to this one."
msgstr "Դուք սրան չեք դիմել։"

#: src/postulo/templates/widgets/selectivity.html
msgid "You have not noted any listings yet, so there is nothing to be choosy about."
msgstr "Դեռ ոչ մի հայտարարություն չեք գրանցել, ուստի ընտրելու բան չկա։"

#: src/postulo/templates/widgets/selectivity.html
#, python-format
msgid "You have noticed %(counter)s listing; applied to %(applied)s (%(share)s%%) and discarded %(discarded)s."
msgid_plural "You have noticed %(counter)s listings; applied to %(applied)s (%(share)s%%) and discarded %(discarded)s."
msgstr[0] "Նկատել եք %(counter)s հայտարարություն․ դիմել եք %(applied)s-ին (%(share)s%%) և հրաժարվել %(discarded)s-ից։"
msgstr[1] "Նկատել եք %(counter)s հայտարարություն․ դիմել եք %(applied)s-ին (%(share)s%%) և հրաժարվել %(discarded)s-ից։"

#: src/postulo/resume/candidate.py
msgid "You have one like it with other dates. Both will be in your record."
msgstr "Դուք ունեք նմանատիպ մեկը՝ այլ ամսաթվերով։ Երկուսն էլ կլինեն ձեր գրառումներում։"

#: src/postulo/templates/core/dashboard.html
msgid "You have taken everything off it. Put something back whenever you like."
msgstr "Դուք ամեն ինչ հանել եք դրանից։ Ինչ-որ բան վերադարձրեք, երբ ցանկանաք։"

#: src/postulo/templates/accounts/delete_account.html
msgid "You leave your groups; what they own stays theirs."
msgstr "Դուք լքում եք ձեր խմբերը․ այն, ինչ նրանց է պատկանում, մնում է նրանցը։"

#: src/postulo/documents/models.py
msgid "You send it"
msgstr "Ուղարկում եք դուք"

#: src/postulo/templates/settings/account.html
msgid "You will be asked for the current one first."
msgstr "Նախ ձեզնից կպահանջվի ընթացիկը։"

#: src/postulo/templates/account/recovery_set_password.html
msgid "You will still sign in afterwards, and still give your second factor if you have one. This link changes the password and nothing else."
msgstr "Դրանից հետո դուք դեռ պետք է մուտք գործեք և, եթե ունեք, տրամադրեք ձեր երկրորդ գործոնը։ Այս հղումը փոխում է գաղտնաբառը և ուրիշ ոչինչ։"

#: src/postulo/accounts/views.py
msgid "Your account and everything in it have been deleted."
msgstr "Ձեր հաշիվը և դրանում եղած ամեն ինչ ջնջվել են։"

#: src/postulo/templates/403.html
msgid "Your account does not have access to this page."
msgstr "Ձեր հաշիվն այս էջին հասանելիություն չունի։"

#: src/postulo/templates/core/dashboard.html
#, python-format
msgid "Your account has no full name yet. Every document starts from it: <a href=\"%(profile_url)s\" class=\"font-medium underline\">add your name</a>."
msgstr "Ձեր հաշիվը դեռ լրիվ անուն չունի։ Յուրաքանչյուր փաստաթուղթ սկսվում է դրանից՝ <a href=\"%(profile_url)s\" class=\"font-medium underline\">ավելացրեք ձեր անունը</a>։"

#: src/postulo/documents/printing.py
msgid "Your account's address"
msgstr "Ձեր հաշվի հասցեն"

#: src/postulo/core/help.py
msgid "Your addresses on the web, a card for each sort, with one of each marked as the one to show."
msgstr "Ձեր վեբ հասցեները՝ յուրաքանչյուր տեսակի համար մեկ քարտ, և ամեն տեսակից մեկը նշված է որպես ցուցադրվող։"

#: src/postulo/applications/forms.py
msgid "Your adviser, where you have recorded them at that service."
msgstr "Ձեր խորհրդատուն, եթե նրան գրանցել եք այդ ծառայությունում։"

#: src/postulo/templates/applications/application_intake.html
msgid "Your application"
msgstr "Ձեր դիմումը"

#: src/postulo/templates/settings/account.html
msgid "Your browser will only make a passkey on a page served over HTTPS. This instance is being reached over plain HTTP, so passkeys cannot be offered here. That is the browser's rule, not a setting on this server."
msgstr "Ձեր դիտարկիչն անցաբանալի է ստեղծում միայն HTTPS-ով մատուցվող էջում։ Այս տեղակայմանը հասնում են սովորական HTTP-ով, ուստի անցաբանալիներն այստեղ հնարավոր չէ առաջարկել։ Դա դիտարկիչի կանոնն է, ոչ թե այս սերվերի կարգավորումը։"

#: src/postulo/templates/jobs/capture_page.html
msgid "Your captures do not keep the page they are read from. Switching it on applies to the captures made afterwards."
msgstr "Ձեր որսերը չեն պահում այն էջը, որից կարդացվում են։ Դա միացնելը վերաբերում է դրանից հետո կատարված որսերին։"

#: src/postulo/core/help.py src/postulo/core/search.py
#: src/postulo/templates/base.html src/postulo/templates/documents/cv_list.html
#: src/postulo/templates/resume/candidate_file.html
#: src/postulo/templates/resume/overview.html
#: src/postulo/templates/settings/accessibility.html
msgid "Your career"
msgstr "Ձեր կարիերան"

#: src/postulo/templates/widgets/shortcuts.html
msgid "Your career record"
msgstr "Ձեր կարիերայի գրառումը"

#: src/postulo/templates/resume/translations.html
#, python-format
msgid "Your career record is written in %(original)s. What you type here is what a CV in another language prints instead."
msgstr "Ձեր կարիերայի գրառումը գրված է %(original)s լեզվով։ Այն, ինչ գրում եք այստեղ, կտպվի դրա փոխարեն այլ լեզվով CV-ում։"

#: src/postulo/templates/core/export.html
msgid "Your companies, contacts, listings or applications in a JSON file each: to keep, to read, or to put into another account. Importing only adds; it never changes what you have."
msgstr "Ձեր ընկերությունները, կոնտակտները, հայտարարությունները կամ դիմումները՝ յուրաքանչյուրն առանձին JSON ֆայլում՝ պահելու, կարդալու կամ այլ հաշիվ տեղափոխելու համար։ Ներմուծումը միայն ավելացնում է․ այն երբեք չի փոխում ձեր ունեցածը։"

#: src/postulo/templates/jobs/contact_vcards.html
msgid "Your contacts in a .vcf file an address book reads, and the cards of one put back. Nothing is added from a file until you have seen it and ticked what you want."
