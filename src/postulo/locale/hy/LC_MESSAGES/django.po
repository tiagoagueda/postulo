msgstr "Մեկն արդեն պատրաստ է"

#: src/postulo/templates/core/export.html
msgid "One kind of record as a file"
msgstr "Մեկ տեսակի գրառումներ՝ որպես ֆայլ"

#: src/postulo/templates/core/kind_file.html
msgid "One kind of record in a JSON file of its own: to keep, to read, or to hand to another Postulo."
msgstr "Մեկ տեսակի գրառումներ առանձին JSON ֆայլում՝ պահելու, կարդալու կամ մեկ այլ Postulo-ի հանձնելու համար։"

#: src/postulo/resume/models.py
msgid "One line, for whoever is reading the CV."
msgstr "Մեկ տող՝ նրա համար, ով կարդում է CV-ն։"

#: src/postulo/templates/accounts/profile.html
#, python-format
msgid "One more number is kept and not shown, because <em>Several telephone numbers</em> is switched off. It comes back untouched if it is switched on."
msgid_plural "%(counter)s more numbers are kept and not shown, because <em>Several telephone numbers</em> is switched off. They come back untouched if it is switched on."
msgstr[0] "Եվս մեկ համար պահվում է և ցույց չի տրվում, քանի որ <em>Մի քանի հեռախոսահամար</em> գործառույթն անջատված է։ Այն կվերադառնա անփոփոխ, եթե գործառույթը միացվի։"
msgstr[1] "Եվս %(counter)s համար պահվում է և ցույց չի տրվում, քանի որ <em>Մի քանի հեռախոսահամար</em> գործառույթն անջատված է։ Դրանք կվերադառնան անփոփոխ, եթե գործառույթը միացվի։"

#: src/postulo/templates/jobs/contact_form.html
#, python-format
msgid "One more number is kept for this contact and not shown, because <em>Several telephone numbers</em> is switched off."
msgid_plural "%(counter)s more numbers are kept for this contact and not shown, because <em>Several telephone numbers</em> is switched off."
msgstr[0] "Այս կոնտակտի համար պահվում է եվս մեկ համար, որը ցույց չի տրվում, քանի որ <em>Մի քանի հեռախոսահամար</em> գործառույթն անջատված է։"
msgstr[1] "Այս կոնտակտի համար պահվում է եվս %(counter)s համար, որոնք ցույց չեն տրվում, քանի որ <em>Մի քանի հեռախոսահամար</em> գործառույթն անջատված է։"

#: src/postulo/resume/forms.py
msgid "One name per line, as for the authors."
msgstr "Մեկ անուն՝ մեկ տողում, ինչպես հեղինակների դեպքում։"

#: src/postulo/resume/forms.py
msgid "One name per line, as you would write it: “Knuth, Donald E.”."
msgstr "Մեկ անուն՝ մեկ տողում, ինչպես կգրեիք՝ «Knuth, Donald E.»։"

#: src/postulo/templates/server/design.html
msgid "One nobody may change"
msgstr "Մեկը, որը ոչ ոք չի կարող փոխել"

#: src/postulo/templates/server/design.html
msgid "One of a few"
msgstr "Մի քանիսից մեկը"

#: src/postulo/templates/server/design.html
msgid "One of a list. Without scripts it is the browser's own select; with them, a button and a list whose options can hold a flag or an icon."
msgstr "Մեկը ցուցակից։ Առանց սկրիպտների այն դիտարկիչի սեփական ընտրիչն է, սկրիպտներով՝ կոճակ և ցուցակ, որի տարբերակները կարող են պարունակել դրոշ կամ պատկերակ։"

#: src/postulo/documents/views.py
msgid "One of the files you chose could not be read, so nothing was sent."
msgstr "Ձեր ընտրած ֆայլերից մեկը հնարավոր չեղավ կարդալ, ուստի ոչինչ չուղարկվեց։"

#: src/postulo/templates/documents/rendered_compare.html
msgid "One of these was frozen before Postulo kept the words of a document beside its PDF, so they cannot be compared line by line. Both can still be downloaded."
msgstr "Դրանցից մեկը սառեցվել է նախքան Postulo-ն կսկսեր պահել փաստաթղթի բառերը նրա PDF-ի կողքին, ուստի դրանք հնարավոր չէ համեմատել տող առ տող։ Երկուսն էլ դեռ կարելի է ներբեռնել։"

#: src/postulo/resume/forms.py
msgid "One of your contacts. Their name, role, company and how to reach them are kept on the contact’s page; a person who is not a contact yet is added there."
msgstr "Ձեր կոնտակտներից մեկը։ Նրա անունը, պաշտոնը, ընկերությունը և կապի միջոցները պահվում են կոնտակտի էջում․ մարդը, որը դեռ կոնտակտ չէ, ավելացվում է այնտեղ։"

#: src/postulo/templates/jobs/capture_form.html
msgid "One page is fetched — the one you pasted. Postulo never crawls."
msgstr "Ներբեռնվում է մեկ էջ՝ այն, որը տեղադրեցիք։ Postulo-ն երբեք ինքնաշխատ կերպով չի անցնում կայքի էջերով։"

#: src/postulo/templates/server/capture.html
msgid "One page per request, public addresses only, never a crawl. These are fixed."
msgstr "Մեկ էջ յուրաքանչյուր հարցման համար, միայն հանրային հասցեներ, երբեք ինքնաշխատ շրջանցում։ Սրանք անփոփոխ են։"

#: src/postulo/templates/server/capture.html
#, python-format
msgid "One page, %(weight)s"
msgid_plural "%(counter)s pages, %(weight)s"
msgstr[0] "%(counter)s էջ, %(weight)s"
msgstr[1] "%(counter)s էջ, %(weight)s"

#: src/postulo/templates/settings/capture.html
#, python-format
msgid "One page, weighing %(weight)s of the %(room)s this instance keeps for one account."
msgid_plural "%(counter)s pages, weighing %(weight)s of the %(room)s this instance keeps for one account."
msgstr[0] "%(counter)s էջ՝ %(weight)s ծավալով այն %(room)s տարածքից, որ այս տեղակայումը պահում է մեկ հաշվի համար։"
msgstr[1] "%(counter)s էջ՝ %(weight)s ծավալով այն %(room)s տարածքից, որ այս տեղակայումը պահում է մեկ հաշվի համար։"

#: src/postulo/templates/settings/account.html
#, python-format
msgid "One passkey on this account. It signs you in with a fingerprint, your face or a PIN, and there is no password to leak."
msgid_plural "%(total)s passkeys on this account. They sign you in with a fingerprint, your face or a PIN, and there is no password to leak."
msgstr[0] "Այս հաշվում մեկ անցաբանալի կա։ Այն թույլ է տալիս մուտք գործել մատնահետքով, դեմքի ճանաչմամբ կամ PIN-ով, և արտահոսելու գաղտնաբառ չկա։"
msgstr[1] "Այս հաշվում %(total)s անցաբանալի կա։ Դրանք թույլ են տալիս մուտք գործել մատնահետքով, դեմքի ճանաչմամբ կամ PIN-ով, և արտահոսելու գաղտնաբառ չկա։"

#: src/postulo/resume/forms.py
msgid "One per line. A CV prints them as bullets."
msgstr "Մեկը՝ մեկ տողում։ CV-ն դրանք տպում է որպես կետերով ցուցակ։"

#: src/postulo/core/views_kind_files.py
#, python-format
msgid "One record was added. Nothing you already had was changed or removed."
msgid_plural "%(total)s records were added. Nothing you already had was changed or removed."
msgstr[0] "%(total)s գրառում ավելացվեց։ Ձեր արդեն ունեցածից ոչինչ չփոխվեց և չհեռացվեց։"
msgstr[1] "%(total)s գրառում ավելացվեց։ Ձեր արդեն ունեցածից ոչինչ չփոխվեց և չհեռացվեց։"

#: src/postulo/templates/jobs/company_form.html
msgid "One request to www.wikidata.org for this company's item; nothing is kept until you say so."
msgstr "Մեկ հարցում www.wikidata.org-ին այս ընկերության տարրի համար․ ոչինչ չի պահվում, մինչև դուք չասեք։"

#: src/postulo/templates/help/postal_addresses.html
msgid "One row for each address you want to keep. <em>Kind</em> says which it is and can be left blank. Choose <em>Other</em> and a box asks what to call it."
msgstr "Մեկ տող յուրաքանչյուր հասցեի համար, որը ցանկանում եք պահել։ <em>Տեսակ</em> դաշտը նշում է, թե որն է այն, և կարող է դատարկ մնալ։ Ընտրեք <em>Այլ</em>, և դաշտը կհարցնի, թե ինչպես այն անվանել։"

#: src/postulo/templates/help/telephone_numbers.html
msgid "One row for each number. A new number goes in the empty row at the end of the list: saving the page adds it and offers another empty row."
msgstr "Մեկ տող յուրաքանչյուր համարի համար։ Նոր համարը մուտքագրվում է ցանկի վերջում գտնվող դատարկ տողում․ էջը պահպանելիս այն ավելացվում է, և առաջարկվում է ևս մեկ դատարկ տող։"

#: src/postulo/core/kind_files.py
#, python-format
msgid "One row is not a record, and is not read."
msgid_plural "%(count)s rows are not records, and are not read."
msgstr[0] "%(count)s տող գրառում չէ և չի կարդացվում։"
msgstr[1] "%(count)s տող գրառում չեն և չեն կարդացվում։"

#: src/postulo/core/templatetags/postulo.py
#, python-format
msgid "One row ticked."
msgid_plural "%(count)s rows ticked."
msgstr[0] "%(count)s տող է նշված։"
msgstr[1] "%(count)s տող է նշված։"

#: src/postulo/templates/cotton/identifier_schemes.html
msgid "One scheme, written out:"
msgstr "Մեկ սխեմա՝ ամբողջությամբ գրված․"

#: src/postulo/templates/server/email.html
#, python-format
msgid "One setting below is stored here and overridden by the environment. Remove that variable and the stored value takes over, without anybody editing anything."
msgid_plural "%(counter)s of the settings below are stored here and overridden by the environment. Remove those variables and the stored values take over, without anybody editing anything."
msgstr[0] "Ստորև բերված կարգավորումներից մեկը պահված է այստեղ, բայց միջավայրը վերասահմանում է այն։ Հեռացրեք այդ փոփոխականը, և կգործի պահված արժեքը՝ առանց որևէ բան խմբագրելու։"
msgstr[1] "Ստորև բերված %(counter)s կարգավորում պահված է այստեղ, բայց միջավայրը վերասահմանում է դրանք։ Հեռացրեք այդ փոփոխականները, և կգործեն պահված արժեքները՝ առանց որևէ բան խմբագրելու։"

#: src/postulo/templates/applications/partials/board.html
#, python-format
msgid "One settled application matches these filters. The board shows only what is still live; <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">see it in the table</a>."
msgid_plural "%(counter)s settled applications match these filters. The board shows only what is still live; <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">see them in the table</a>."
msgstr[0] "%(counter)s ավարտված դիմում է համապատասխանում այս զտիչներին։ Տախտակը ցույց է տալիս միայն դեռ ընթացքի մեջ գտնվողները․ <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">տեսեք այն աղյուսակում</a>։"
msgstr[1] "%(counter)s ավարտված դիմում է համապատասխանում այս զտիչներին։ Տախտակը ցույց է տալիս միայն դեռ ընթացքի մեջ գտնվողները․ <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">տեսեք դրանք աղյուսակում</a>։"

#: src/postulo/templates/applications/interview_form.html
msgid "One that has already happened is recorded straight onto the timeline as held."
msgstr "Արդեն տեղի ունեցածն անմիջապես գրանցվում է ժամանակագրության մեջ որպես կայացած։"

#: src/postulo/templates/api/token_list.html
#, python-format
msgid "One token is good for something right now."
msgid_plural "%(counter)s tokens are good for something right now."
msgstr[0] "%(counter)s թոքեն այս պահին գործածելի է։"
msgstr[1] "%(counter)s թոքեն այս պահին գործածելի է։"

#: src/postulo/templates/documents/cv_list.html
msgid "One variant per kind of role. Each selects from your career record; a portfolio leads with the work."
msgstr "Մեկ տարբերակ յուրաքանչյուր տեսակի պաշտոնի համար։ Յուրաքանչյուրն ընտրում է ձեր կարիերայի գրառումից․ պորտֆոլիոն սկսվում է աշխատանքներից։"

#: src/postulo/documents/forms.py
msgid "One you add to your details later is not printed until you tick it here."
msgstr "Նույնացուցիչը, որը հետագայում կավելացնեք ձեր տվյալներին, չի տպվի, քանի դեռ այստեղ չեք նշել այն։"

#: src/postulo/templates/accounts/delete_account.html
msgid "One zip with every record and every file, which imports into a fresh account on any Postulo."
msgstr "Մեկ zip ֆայլ՝ բոլոր գրառումներով և ֆայլերով, որը կարելի է ներմուծել նոր հաշվում՝ ցանկացած Postulo տեղակայումում։"

#: src/postulo/resume/publications.py
msgid "Online"
msgstr "Առցանց"

#: src/postulo/templates/jobs/company_detail.html
#, python-format
msgid "Only %(name)s"
msgstr "Միայն %(name)s"

#: src/postulo/jobs/surface.py
msgid "Only a company's or a contact's details can be written."
msgstr "Կարելի է գրել միայն ընկերության կամ կոնտակտի տվյալները։"

#: src/postulo/jobs/capture_views.py
msgid "Only a discarded capture can be put back."
msgstr "Միայն այն որսը, որից հրաժարվել եք, կարելի է վերադարձնել։"

#: src/postulo/resume/forms.py
msgid "Only checked for its shape and linked on a CV as https://doi.org/…; Postulo never looks it up."
msgstr "Ստուգվում է միայն դրա ձևը, և CV-ում այն հղվում է https://doi.org/… հասցեով․ Postulo-ն այն երբեք չի փնտրում։"

#: src/postulo/templates/documents/cv_detail.html
msgid "Only entries not already on it are listed."
msgstr "Թվարկված են միայն այն գրառումները, որոնք դեռ այնտեղ չեն։"

#: src/postulo/templates/server/email.html
msgid "Only for a provider that no longer accepts a password. Your own mail server needs none of this."
msgstr "Միայն այն մատակարարի համար, որն այլևս գաղտնաբառեր չի ընդունում։ Ձեր սեփական փոստային սերվերին սրանից ոչինչ պետք չէ։"

#: src/postulo/applications/forms.py
msgid "Only for Rejected, Withdrawn and Ghosted, and never required. A reason you learn later can be added then: choose the same status again, and the reason."
