msgstr "Մատենագիտությունը սովորաբար նշում է նաև՝ %(fields)s։ Առանց դրանց սխալ չկա․ ավելացրեք դրանք, եթե ունեք։"

#: src/postulo/core/models.py
msgid "A blog, a portfolio — what to call it. Left blank, the host is shown."
msgstr "Բլոգ, պորտֆոլիո — ինչպես անվանել այն։ Դատարկ թողնելու դեպքում ցուցադրվում է հոստը։"

#: src/postulo/applications/models.py
msgid "A bonus, commission, or a target: in their words, since the terms vary."
msgstr "Պարգևավճար, միջնորդավճար կամ նպատակային ցուցանիշ՝ նրանց բառերով, քանի որ պայմանները տարբեր են։"

#: src/postulo/templates/server/design.html
msgid "A box that grows with what is typed into it."
msgstr "Դաշտ, որը մեծանում է մուտքագրվող տեքստի հետ։"

#: src/postulo/templates/api/token_list.html
msgid "A browser extension needs only the first. Give an agent read alone until you trust it with write."
msgstr "Դիտարկիչի ընդլայնմանը պետք է միայն առաջինը։ Գործակալին տվեք միայն կարդալու իրավունք, մինչև վստահեք նրան նաև գրելը։"

#: src/postulo/templates/server/overview.html
#, python-format
msgid "A bug report is worth as much as anything else here. The repository is at <a href=\"%(repo)s\" class=\"underline\">source.tiagoagueda.com/postulo</a>, and <a href=\"%(guide)s\" class=\"underline\">CONTRIBUTING</a> says how a change lands."
msgstr "Վրիպակի հաղորդումն այստեղ նույնքան արժեքավոր է, որքան ցանկացած այլ բան։ Պահոցը գտնվում է <a href=\"%(repo)s\" class=\"underline\">source.tiagoagueda.com/postulo</a> հասցեում, իսկ <a href=\"%(guide)s\" class=\"underline\">CONTRIBUTING</a>-ը նկարագրում է, թե ինչպես է փոփոխությունը հայտնվում ծրագրում։"

#: src/postulo/templates/core/export.html
#, python-format
msgid "A built archive is kept for one hour and then deleted, because it holds everything."
msgid_plural "A built archive is kept for %(hours)s hours and then deleted, because it holds everything."
msgstr[0] "Պատրաստված արխիվը պահվում է %(hours)s ժամ, ապա ջնջվում է, քանի որ այն պարունակում է ամեն ինչ։"
msgstr[1] "Պատրաստված արխիվը պահվում է %(hours)s ժամ, ապա ջնջվում է, քանի որ այն պարունակում է ամեն ինչ։"

#: src/postulo/resume/driving.py
msgid "a bus with a trailer"
msgstr "ավտոբուս՝ կցորդով"

#: src/postulo/templates/applications/ical_import.html
msgid "A calendar exported from another application, or one Postulo wrote. Repeating events, attachments, links, alarms and the people invited are not read."
msgstr "Այլ հավելվածից արտահանված կամ Postulo-ի գրած օրացույց։ Կրկնվող իրադարձությունները, կցորդները, հղումները, զգուշացումները և հրավիրվածները չեն կարդացվում։"

#: src/postulo/api/api.py
msgid "A capture cannot come after the last of its batch."
msgstr "Որսը չի կարող լինել իր խմբաքանակի վերջինից հետո։"

#: src/postulo/templates/server/capture.html
msgid "A capture keeps what it read and throws the page away. It can keep the page as well: the source as it was parsed, and a rendering of the whole page. Both are off until you switch them on, because keeping a copy of somebody else's page is a decision to make on purpose. Each person then switches them on for their own captures; what is off here is off for everybody."
msgstr "Որսը պահում է իր կարդացածը և դեն է նետում էջը։ Այն կարող է պահել նաև էջը՝ կոդը այնպես, ինչպես վերլուծվել է, և ամբողջ էջի պատկերը։ Երկուսն էլ անջատված են, մինչև չմիացնեք դրանք, քանի որ ուրիշի էջի պատճենը պահելը որոշում է, որը պետք է կայացնել գիտակցաբար։ Այնուհետև յուրաքանչյուր մարդ դրանք միացնում է իր սեփական որսերի համար․ այն, ինչ անջատված է այստեղ, անջատված է բոլորի համար։"

#: src/postulo/templates/jobs/capture_form.html
#: src/postulo/templates/jobs/capture_review.html
#, python-format
msgid "A capture of this address from %(when)s is still waiting for review."
msgstr "Այս հասցեի %(when)s-ի որսը դեռ սպասում է վերանայման։"

#: src/postulo/templates/settings/capture.html
msgid "A capture reads a page and keeps what it understood. The page itself is the evidence: when the advert is gone, what was kept of it is all there is to check the reading against."
msgstr "Որսը կարդում է էջը և պահում այն, ինչ հասկացել է։ Էջն ինքն է ապացույցը․ երբ հայտարարությունն անհետանում է, կարդացածը կարելի է ստուգել միայն դրանից պահվածի հետ։"

#: src/postulo/resume/driving.py
msgid "a car or light van with a heavier trailer"
msgstr "մարդատար ավտոմեքենա կամ թեթև ֆուրգոն՝ ավելի ծանր կցորդով"

#: src/postulo/templates/server/design.html
msgid "A card"
msgstr "Քարտ"

#: src/postulo/templates/server/design.html
msgid "A card whose help belongs to the card has a question mark in its corner: one sentence when it is rested on, and the card's help in a drawer when it is pressed."
msgstr "Քարտը, որի օգնությունը վերաբերում է հենց քարտին, իր անկյունում ունի հարցական նշան՝ մեկ նախադասություն, երբ սլաքը պահում եք դրա վրա, և քարտի օգնությունը կողային վահանակում, երբ սեղմում եք այն։"

#: src/postulo/templates/server/design.html
msgid "A card with a question mark"
msgstr "Հարցական նշանով քարտ"

#: src/postulo/jobs/vcards.py
msgid "A card with no name"
msgstr "Առանց անվան քարտ"

#: src/postulo/core/design.py
msgid "A card, a table, the masthead once you have scrolled."
msgstr "Քարտ, աղյուսակ, էջի գլխամասը՝ ոլորելուց հետո։"

#: src/postulo/resume/driving.py
msgid "A category is listed once."
msgstr "Կատեգորիան նշվում է մեկ անգամ։"

#: src/postulo/templates/applications/offer_form.html
msgid "A change is written on the timeline as a revision, so the record says what moved."
msgstr "Փոփոխությունը ժամանակագրության մեջ գրանցվում է որպես խմբագրություն, ուստի գրառումը ցույց է տալիս, թե ինչ է փոխվել։"

#: src/postulo/templates/server/design.html
#, fuzzy
msgid "A chip"
msgstr "Պիտակիկ"

#: src/postulo/templates/server/design.html
msgid "A choice"
msgstr "Ընտրություն"

#: src/postulo/templates/server/design.html
msgid "A choice in a dialog"
msgstr "Ընտրություն երկխոսության մեջ"

#: src/postulo/templates/server/design.html
msgid "A chooser with a flag beside it"
msgstr "Ընտրիչ՝ կողքին դրոշով"

#: src/postulo/templates/server/email.html
msgid "A client secret is stored. It is never shown."
msgstr "Հաճախորդի գաղտնիքը պահված է։ Այն երբեք չի ցուցադրվում։"

#: src/postulo/jobs/vcards.py
msgid "A company"
msgstr "Ընկերություն"

#: src/postulo/jobs/models.py
msgid "A company cannot acquire itself."
msgstr "Ընկերությունը չի կարող ձեռք բերել ինքն իրեն։"

#: src/postulo/jobs/models.py
msgid "A company cannot be part of itself."
msgstr "Ընկերությունը չի կարող լինել իր իսկ մասը։"

#: src/postulo/jobs/services.py
msgid "A company carries one identifier per scheme."
msgstr "Ընկերությունը յուրաքանչյուր սխեմայից կարող է ունենալ միայն մեկ նույնացուցիչ։"

#: src/postulo/templates/widgets/industries.html
msgid "A company in several sectors or industries counts in each of them."
msgstr "Մի քանի ճյուղերում կամ ոլորտներում գործող ընկերությունը հաշվվում է դրանցից յուրաքանչյուրում։"

#: src/postulo/jobs/surface.py
msgid "A company needs a name."
msgstr "Ընկերությանն անուն է պետք։"

#: src/postulo/templates/jobs/company_map.html
msgid "A company with addresses in several places is counted at each, so the counts add up to more than the companies there are."
msgstr "Մի քանի վայրերում հասցեներ ունեցող ընկերությունը հաշվվում է դրանցից յուրաքանչյուրում, ուստի թվերի գումարն ավելի մեծ է, քան այնտեղ եղած ընկերությունների թիվը։"

#: src/postulo/core/kind_files.py
msgid "A company with the same identifier is already yours."
msgstr "Նույն նույնացուցիչով ընկերություն արդեն ունեք։"

#: src/postulo/api/routers/companies.py src/postulo/jobs/surface.py
msgid "A company's links are its social profiles."
msgstr "Ընկերության հղումները նրա սոցիալական պրոֆիլներն են։"

#: src/postulo/templates/core/search.html
msgid "A company, a role, a phrase from a letter, a name…"
msgstr "Ընկերություն, պաշտոն, նախադասություն նամակից, անուն…"

#: src/postulo/templates/server/design.html
msgid "A confirmation asks one question and says what answering it does. Here, nothing."
msgstr "Հաստատումը մեկ հարց է տալիս և ասում, թե ինչ կանի պատասխանը։ Այստեղ՝ ոչինչ։"

#: src/postulo/jobs/vcards.py
#, python-format
msgid "A contact at %(company)s"
msgstr "Կոնտակտ %(company)s ընկերությունում"

#: src/postulo/jobs/vcards.py
#, python-format
msgid "A contact at %(company)s, in %(department)s"
msgstr "Կոնտակտ %(company)s ընկերությունում, %(department)s բաժնում"

#: src/postulo/jobs/vcards.py
msgid "A contact at no company"
msgstr "Կոնտակտ առանց ընկերության"

#: src/postulo/core/messaging_handles.py
#, python-format
msgid "A contact has at most %(max)s messaging handles."
msgstr "Կոնտակտը կարող է ունենալ առավելագույնը %(max)s մեսենջերի անուն։"

#: src/postulo/jobs/surface.py
msgid "A contact needs a name."
msgstr "Կոնտակտին անուն է պետք։"

#: src/postulo/templates/server/design.html
msgid "A country and a number in one group"
msgstr "Երկիր և համար մեկ խմբում"

#: src/postulo/templates/server/backups.html
msgid "A cron line on the host still works the same way and is described on the wiki page about backups."
msgstr "Հոստ մեքենայի վրա cron տողը շարունակում է աշխատել նույն կերպ և նկարագրված է պահուստավորման մասին վիքի էջում։"

#: src/postulo/templates/core/import_csv.html
msgid "A CSV file"
msgstr "CSV ֆայլ"

#: src/postulo/documents/forms.py
msgid "A CV leads with a career, a portfolio with work. It decides which themes are offered below."
msgstr "CV-ն սկսվում է կարիերայով, պորտֆոլիոն՝ աշխատանքներով։ Դա որոշում է, թե որ թեմաներն են առաջարկվում ստորև։"

#: src/postulo/templates/help/documents.html
msgid "A CV or a letter can be downloaded as the formats this instance offers, previewed beside its controls, and compared with an earlier version that was sent."
msgstr "CV-ն կամ նամակը կարելի է ներբեռնել այս տեղակայման առաջարկած ձևաչափերով, նախադիտել կառավարման տարրերի կողքին և համեմատել ավելի վաղ ուղարկված տարբերակի հետ։"

#: src/postulo/templates/help/cv_photo.html
msgid "A CV photo is a photograph for your CVs, kept apart from your picture above: the picture stands for you on these pages, and the CV photo is only ever printed on a CV."
msgstr "CV-ի լուսանկարը ձեր CV-ների համար նախատեսված լուսանկար է, որը պահվում է վերևի ձեր նկարից առանձին․ նկարը ներկայացնում է ձեզ այս էջերում, իսկ CV-ի լուսանկարը տպվում է միայն CV-ի վրա։"

#: src/postulo/templates/accounts/profile.html
msgid "A CV photo is kept."
msgstr "CV-ի լուսանկար պահված է։"

#: src/postulo/templates/resume/overview.html
msgid "A CV prints a skill under its group. Open one to choose it."
msgstr "CV-ն հմտությունը տպում է իր խմբի ներքո։ Բացեք որևէ մեկը՝ խումբն ընտրելու համար։"

#: src/postulo/resume/forms.py
msgid "A CV prints only the year, so the day makes no difference."
msgstr "CV-ն տպում է միայն տարին, ուստի օրը նշանակություն չունի։"

#: src/postulo/resume/forms.py
msgid "A CV prints the month and the year, so the day makes no difference."
msgstr "CV-ն տպում է ամիսը և տարին, ուստի օրը նշանակություն չունի։"

#: src/postulo/templates/help/cv_photo.html
msgid "A CV prints the photo only when you tick that on the CV. The plain text and the Word file never carry it. Tick <em>Remove the CV photo</em> and save to take it away."
msgstr "CV-ն տպում է լուսանկարը միայն այն դեպքում, երբ դա նշում եք CV-ում։ Պարզ տեքստը և Word ֆայլը երբեք այն չեն պարունակում։ Նշեք <em>Հեռացնել CV-ի լուսանկարը</em> և պահպանեք՝ այն հեռացնելու համար։"

#: src/postulo/templates/help/identifiers.html
msgid "A CV prints your identifiers in its contact block: all of them, the ones you tick for it, or none, as its own <em>Settings</em> say. The bin removes a row at once, after asking, and its kind can then be chosen again."
msgstr "CV-ն ձեր նույնացուցիչները տպում է իր կոնտակտային բլոկում՝ բոլորը, ձեր նշածները կամ ոչ մեկը, ինչպես նշված է նրա <em>Կարգավորումներ</em> բաժնում։ Աղբամանը հեռացնում է տողը միանգամից՝ հարցնելուց հետո, որից հետո դրա տեսակը կարելի է կրկին ընտրել։"

#: src/postulo/core/gdpr.py
msgid "A CV that was already sent keeps them, as it was sent."
msgstr "Արդեն ուղարկված CV-ն դրանք պահում է այնպես, ինչպես ուղարկվել է։"

#: src/postulo/core/personal.py
msgid "A date of birth cannot be in the future."
msgstr "Ծննդյան ամսաթիվը չի կարող լինել ապագայում։"

#: src/postulo/core/personal.py
#, python-format
msgid "A date of birth is not before %(year)s."
msgstr "Ծննդյան ամսաթիվը չի կարող լինել %(year)s թվականից առաջ։"

#: src/postulo/core/design.py
msgid "A deep blue. Ten steps, of which the interface spends a handful."
msgstr "Խորը կապույտ։ Տասը աստիճան, որոնցից միջերեսն օգտագործում է մի քանիսը։"

#: src/postulo/jobs/surface.py
msgid "A department needs a name."
msgstr "Բաժնին անուն է պետք։"

#: src/postulo/resume/publications.py
msgid "A DOI looks like 10.1000/182: “10.”, a number, a slash and the rest."
msgstr "DOI-ն ունի այսպիսի տեսք՝ 10.1000/182․ «10.», թիվ, թեք գիծ և մնացածը։"

#: src/postulo/templates/documents/letter_detail.html
msgid "A draft is kept nowhere, and marks whatever it has nothing to fill in. A letter is filed when you record what you sent with an application."
msgstr "Սևագիրը ոչ մի տեղ չի պահվում և նշում է այն ամենը, ինչի համար լրացնելու տվյալ չունի։ Նամակը պահվում է, երբ գրանցում եք, թե ինչ եք ուղարկել դիմումի հետ։"

#: src/postulo/resume/candidate.py
msgid "A driving licence"
msgstr "Վարորդական վկայական"

#: src/postulo/documents/properties.py
msgid "A few words a search of your own files could use, separated by commas. Stuffing them does not help with applicant tracking software, and can count against an application."
msgstr "Մի քանի բառ, որոնք կարող է օգտագործել ձեր սեփական ֆայլերի որոնումը, ստորակետերով բաժանված։ Դրանցով ֆայլը լցնելը չի օգնում դիմորդների հետագծման համակարգերում և կարող է նույնիսկ վնասել դիմումին։"

#: src/postulo/resume/forms.py
msgid "A few words about it, where the title does not say enough."
msgstr "Մի քանի բառ դրա մասին, երբ վերնագիրը բավարար չի ասում։"

#: src/postulo/templates/server/design.html
msgid "A field nobody may change"
msgstr "Դաշտ, որը ոչ ոք չի կարող փոխել"

#: src/postulo/templates/server/design.html
msgid "A field that was refused"
msgstr "Մերժված դաշտ"

#: src/postulo/templates/server/design.html
msgid "A field whose help is a tooltip"
msgstr "Դաշտ, որի օգնությունը հուշում է"

#: src/postulo/templates/server/design.html
msgid "A figure"
msgstr "Ցուցանիշ"

#: src/postulo/jobs/forms.py
msgid "A file from your documents"
msgstr "Ֆայլ ձեր փաստաթղթերից"

#: src/postulo/templates/jobs/posting_detail.html
msgid "A file goes under Files first; an entry points at it rather than keeping a copy."
msgstr "Ֆայլը նախ դրվում է «Ֆայլեր» բաժնում․ գրառումը հղում է դրան՝ պատճեն պահելու փոխարեն։"

#: src/postulo/templates/resume/europass_import.html
msgid "A file that Postulo itself wrote is read on a page of its own."
msgstr "Postulo-ի կողմից գրված ֆայլը կարդացվում է առանձին էջում։"

#: src/postulo/templates/core/kind_file.html
#, python-format
msgid "A file this page made, here or on another Postulo, of up to %(size)s MB and %(most)s records. You are shown what is in it, and what adding it would do, before anything is added."
msgstr "Այս էջի ստեղծած ֆայլ՝ այստեղ կամ մեկ այլ Postulo-ում, մինչև %(size)s ՄԲ և %(most)s գրառում։ Նախքան որևէ բան կավելացվի, ձեզ ցույց է տրվում, թե ինչ կա դրանում և ինչ կանի դրա ավելացումը։"

#: src/postulo/templates/resume/candidate_file.html
msgid "A file this page made, here or on another Postulo. You are shown what is in it, and what adding it would do, before anything is added."
msgstr "Այս էջի ստեղծած ֆայլ՝ այստեղ կամ մեկ այլ Postulo-ում։ Նախքան որևէ բան ավելացվի, ձեզ ցույց է տրվում, թե ինչ կա դրանում և ինչ կանի դրա ավելացումը։"

#: src/postulo/templates/help/your_name.html
msgid "A form of address is what is written before a name, and pronouns say how to refer to you. Nothing is assumed when either is blank, and neither is ever worked out from your name."
msgstr "Դիմելաձևն այն է, ինչ գրվում է անունից առաջ, իսկ դերանունները ցույց են տալիս, թե ինչպես դիմել ձեզ։ Երբ դրանցից որևէ մեկը դատարկ է, ոչինչ չի ենթադրվում, և դրանցից ոչ մեկը երբեք չի բխեցվում ձեր անունից։"

#: src/postulo/core/help.py
msgid "A form of address is written before your name, and your pronouns say how to refer to you. Both are optional, nothing is assumed when they are blank, and each is kept as a choice that your pages and documents show in their own language."
msgstr "Դիմելաձևը գրվում է ձեր անունից առաջ, իսկ ձեր դերանունները ցույց են տալիս, թե ինչպես դիմել ձեզ։ Երկուսն էլ պարտադիր չեն, դատարկ լինելու դեպքում ոչինչ չի ենթադրվում, և յուրաքանչյուրը պահվում է որպես ընտրություն, որը ձեր էջերն ու փաստաթղթերը ցույց են տալիս իրենց լեզվով։"

#: src/postulo/core/views_access.py
msgid "A group needs a name."
msgstr "Խումբը պետք է անվանում ունենա։"

#: src/postulo/core/messaging_services.py
#, python-format
msgid "A handle is at most %(max)s characters, on one line."
msgstr "Անունը կարող է լինել առավելագույնը %(max)s նիշ՝ մեկ տողում։"

#: src/postulo/core/messaging_services.py
msgid "A handle is needed."
msgstr "Անունը պարտադիր է։"

#: src/postulo/templates/help/messaging.html
msgid "A handle is shown as text and is never a link: a matrix.to or t.me address belongs to a third party, and Postulo opens and builds none that you did not ask for."
msgstr "Մեսենջերի անունը ցուցադրվում է որպես տեքստ և երբեք հղում չէ․ matrix.to կամ t.me հասցեն պատկանում է երրորդ կողմի, և Postulo-ն չի բացում և չի կառուցում որևէ այդպիսի հասցե, որը դուք չեք խնդրել։"

#: src/postulo/resume/candidate.py
msgid "A handle with nothing in it"
msgstr "Դատարկ մեսենջերի անուն"

#: src/postulo/templates/server/design.html
msgid "A heading, the sentence under it, and then whatever the card is for."
msgstr "Վերնագիր, դրա տակի նախադասությունը, ապա այն, ինչի համար է քարտը։"

#: src/postulo/jobs/vcards.py
msgid "a job title"
msgstr "պաշտոնի անվանում"

#: src/postulo/documents/integrity.py
msgid "a JPEG picture"
msgstr "JPEG պատկեր"

#: src/postulo/resume/publications.py
msgid "A key holds letters, digits and the characters - _ : . + / and nothing else."
msgstr "Բանալին կարող է պարունակել տառեր, թվանշաններ և - _ : . + / նշանները, և ուրիշ ոչինչ։"

#: src/postulo/templates/server/design.html
msgid "A key to press: <kbd class=\"kbd\">/</kbd> opens the search from anywhere."
msgstr "Սեղմելու ստեղն՝ <kbd class=\"kbd\">/</kbd> ստեղնը բացում է որոնումը ցանկացած տեղից։"

#: src/postulo/jobs/forms.py
msgid "A known service"
msgstr "Հայտնի ծառայություն"

#: src/postulo/documents/forms.py
msgid "A language tag such as fr or pt-BR. A screen reader announces the file in it."
msgstr "Լեզվի պիտակ, օրինակ՝ fr կամ pt-BR։ Էկրանի ընթերցիչը ֆայլը կհնչեցնի այդ լեզվով։"

#: src/postulo/templates/settings/locale.html
msgid "A language that is still being translated shows English wherever its translation has not reached. That is normal here, and the percentage says how much is done."
msgstr "Լեզուն, որը դեռ թարգմանվում է, ցուցադրում է անգլերեն այնտեղ, ուր թարգմանությունը դեռ չի հասել։ Դա այստեղ բնական է, և տոկոսը ցույց է տալիս, թե որքանն է արված։"

#: src/postulo/documents/forms.py src/postulo/documents/models.py
msgid "A letter cannot expire before it was written."
msgstr "Նամակի ժամկետը չի կարող լրանալ նախքան այն գրվելը։"

#: src/postulo/documents/forms.py
msgid "A letter the referee sends themselves is not offered as a file to attach to an application."
msgstr "Նամակը, որը հանձնարարական տվողն ինքն է ուղարկում, չի առաջարկվում որպես դիմումին կցվող ֆայլ։"

#: src/postulo/templates/server/data_protection.html
msgid "A limit is never enforced on its own: the dry run says what the policy would touch, and the erasures are performed one by one from a company's page. This button deletes nothing."
msgstr "Սահմանաչափը երբեք ինքնաբերաբար չի կիրառվում․ փորձնական գործարկումը ցույց է տալիս, թե ինչի վրա կազդեր քաղաքականությունը, իսկ ջնջումները կատարվում են մեկ առ մեկ՝ ընկերության էջից։ Այս կոճակը ոչինչ չի ջնջում։"

#: src/postulo/documents/models.py
msgid "A line at the end, which names nobody. A reference from your career is printed only once the person has agreed, whatever this says."
msgstr "Վերջում մի տող, որը ոչ ոքի անունը չի նշում։ Ձեր կարիերայից հանձնարարականը տպվում է միայն այն բանից հետո, երբ անձը համաձայնել է, անկախ նրանից, թե ինչ է նշված այստեղ։"

#: src/postulo/resume/forms.py
msgid "A line of your own, such as what the count covers."
msgstr ""

#: src/postulo/resume/forms.py
msgid "A line or two. It prints under the dates on a CV."
msgstr "Մեկ-երկու տող։ CV-ում այն տպվում է ամսաթվերի տակ։"

#: src/postulo/core/models.py
msgid "A line under the name on the home page, and the web app's description. Optional."
msgstr "Տող անվան տակ գլխավոր էջում և վեբ հավելվածի նկարագրությունը։ Ոչ պարտադիր։"

#: src/postulo/accounts/forms.py
msgid "A line under the navigation bar that says where you are — Companies, then this company — with a link back to each step. It stays with the bar as you scroll. Pages that have no place in a hierarchy draw none, and a phone's narrow screen never does."
msgstr "Նավարկման գոտու տակ գտնվող տող, որը ցույց է տալիս, թե որտեղ եք — «Ընկերություններ», ապա այս ընկերությունը —, յուրաքանչյուր քայլին վերադառնալու հղումով։ Ոլորելիս այն մնում է գոտու հետ։ Այն էջերը, որոնք հիերարխիայում տեղ չունեն, այն չեն գծում, իսկ հեռախոսի նեղ էկրանին այն երբեք չի գծվում։"

#: src/postulo/applications/widgets.py
msgid "A line when a plugin thinks something happened and is waiting for you."
msgstr "Տող, երբ հավելումը կարծում է, որ ինչ-որ բան է եղել և սպասում է ձեզ։"

#: src/postulo/core/identifiers.py
msgid "A link cannot hold a curly bracket other than {value}, a backslash, or a line break."
msgstr "Հղումը չի կարող պարունակել ձևավոր փակագիծ (բացի {value}-ից), հակառակ թեք գիծ կամ տողադարձ։"

#: src/postulo/core/identifiers.py
msgid "A link holds {value}, which is where the identifier goes."
msgstr "Հղումը պարունակում է {value}, որի տեղում դրվում է նույնացուցիչը։"

#: src/postulo/core/identifiers.py
#, python-format
msgid "A link is %(most)d characters long at most."
msgstr "Հղումը կարող է լինել առավելագույնը %(most)d նիշ։"

#: src/postulo/core/identifiers.py
msgid "A link is a complete web address that begins with http:// or https://."
msgstr "Հղումը ամբողջական վեբ հասցե է, որը սկսվում է http:// կամ https:// մասով։"

#: src/postulo/core/web_links.py
msgid "A link needs an address."
msgstr "Հղմանը հասցե է պետք։"

#: src/postulo/resume/candidate.py
msgid "A link with no address"
msgstr "Առանց հասցեի հղում"

#: src/postulo/core/web_links.py
msgid "A LinkedIn, a Mastodon, a Bluesky — as many as are worth showing, with one of them marked as the one to show. Documents print that one."
msgstr "LinkedIn, Mastodon, Bluesky — այնքան, որքան արժե ցույց տալ, որոնցից մեկը նշված է որպես ցուցադրվողը։ Փաստաթղթերը տպում են այդ մեկը։"

#: src/postulo/core/server_forms.py
msgid "A list of schemes, checked when you save. Leave the box empty to define none. What a scheme can say is listed under the box."
msgstr "Սխեմաների ցանկ, որը ստուգվում է պահպանելիս։ Թողեք դաշտը դատարկ, որպեսզի ոչ մի սխեմա չսահմանեք։ Թե ինչ կարող է պարունակել սխեման, նշված է դաշտի տակ։"

#: src/postulo/templates/server/design.html
msgid "A list with nothing in it. There were sixteen of these written two ways; there is one now."
msgstr "Դատարկ ցուցակ։ Սրանցից տասնվեցը գրված էին երկու ձևով, հիմա մեկն է։"

#: src/postulo/templates/help/listings.html
msgid "A listing is a posting you have noticed, before you have decided anything about it. <em>Capture a posting</em> reads one from its address; <em>Add a listing</em> is for one you type in yourself, such as a role you heard about."
msgstr "Հայտարարություն է կոչվում ձեր նկատած թափուր տեղը՝ նախքան դրա մասին որևէ բան որոշելը։ <em>Որսալ հայտարարություն</em> կոճակը կարդում է այն իր հասցեից․ <em>Ավելացնել հայտարարություն</em> կոճակը նախատեսված է այն հայտարարությունների համար, որոնք ինքներդ եք մուտքագրում, օրինակ՝ պաշտոն, որի մասին լսել եք։"

#: src/postulo/templates/core/import_csv.html
msgid "A listing keeps its deadline, which the closing-soon notice then watches, and its tags are written into its description."
msgstr "Հայտարարությունը պահում է իր վերջնաժամկետը, որին այնուհետև հետևում է «շուտով փակվում է» ծանուցումը, իսկ դրա պիտակները գրվում են նկարագրության մեջ։"

#: src/postulo/templates/jobs/capture_review.html
msgid "A listing with this title at this company exists; a board that mints a fresh address per visit may be showing you the same advert."
msgstr "Այս ընկերությունում այս վերնագրով հայտարարություն արդեն կա․ աշխատանքի կայքը, որը յուրաքանչյուր այցի համար նոր հասցե է ստեղծում, գուցե ձեզ նույն հայտարարությունն է ցույց տալիս։"

#: src/postulo/notifications/base.py
msgid "A listing you are considering closes soon"
msgstr "Ձեր դիտարկած հայտարարություններից մեկը շուտով փակվում է"

#: src/postulo/templates/server/design.html
msgid "A long list, with a box to narrow it"
msgstr "Երկար ցուցակ՝ այն նեղացնելու վանդակով"

#: src/postulo/templates/server/design.html
msgid "A longer answer"
msgstr "Ավելի երկար պատասխան"

#: src/postulo/resume/driving.py
msgid "a lorry with a trailer"
msgstr "բեռնատար՝ կցորդով"

#: src/postulo/resume/driving.py
msgid "a medium-sized lorry with a trailer"
msgstr "միջին բեռնատար՝ կցորդով"

#: src/postulo/templates/applications/appointment_form.html
msgid "A meeting with your adviser at the public employment service you are registered with. Postulo cannot read these from the service, so you enter them here."
msgstr "Հանդիպում ձեր խորհրդատուի հետ զբաղվածության պետական ծառայությունում, որտեղ գրանցված եք։ Postulo-ն չի կարող դրանք կարդալ ծառայությունից, ուստի դուք դրանք մուտքագրում եք այստեղ։"

#: src/postulo/core/messaging_handles.py
msgid "A messaging handle needs a handle."
msgstr "Մեսենջերի անունը չի կարող դատարկ լինել։"

#: src/postulo/resume/driving.py
msgid "a minibus with a trailer"
msgstr "միկրոավտոբուս՝ կցորդով"

#: src/postulo/core/help.py
msgid "A mobile, a desk line, a switchboard — as many as are worth keeping, with one of them marked as the one to use. Documents print that one."
msgstr "Բջջային, աշխատասեղանի հեռախոս, կենտրոնական համար — այնքան, որքան արժե պահել, որոնցից մեկը նշվում է որպես օգտագործվելիք։ Փաստաթղթերը տպում են այդ մեկը։"

#: src/postulo/plugins/provenance.py
msgid "A module: it ships inside Postulo and cannot be removed."
msgstr "Մոդուլ․ այն ներառված է Postulo-ում և հնարավոր չէ հեռացնել։"

#: src/postulo/templates/applications/report.html
msgid "A month"
msgstr "Մեկ ամիս"

#: src/postulo/core/messaging_services.py
#, python-format
msgid "A name is at most %(max)s characters."
msgstr "Անվանումը կարող է լինել առավելագույնը %(max)s նիշ։"

#: src/postulo/templates/help/identifiers.html
msgid "A name is not an identity: two researchers share one, and one researcher publishes under three. An identifier says which person you are whatever the name, and an application form for an academic post asks for an ORCID by name."
msgstr "Անունը ինքնություն չէ․ երկու հետազոտող կարող են ունենալ նույն անունը, իսկ մեկ հետազոտողը կարող է հրապարակումներ անել երեք տարբեր անուններով։ Նույնացուցիչը ցույց է տալիս, թե ով եք դուք՝ անկախ անունից, և ակադեմիական պաշտոնի դիմումի ձևը հստակորեն պահանջում է ORCID։"

#: src/postulo/templates/server/design.html
msgid "A new one"
msgstr "Նորը"

#: src/postulo/templates/server/design.html
msgid "A number and what it counts. The colour is a second signal, never the only one."
msgstr "Թիվ և այն, ինչ այն հաշվում է։ Գույնը երկրորդ ազդանշան է, երբեք՝ միակը։"

#: src/postulo/core/models.py
msgid "A number has to be confirmed before it can get you back in. Nobody has answered on this one."
msgstr "Համարը պետք է հաստատվի, որպեսզի դրանով կարողանաք վերականգնել մուտքը։ Այս համարին դեռ ոչ ոք չի պատասխանել։"

#: src/postulo/templates/help/telephone_numbers.html
msgid "A number in its international form is kept once on this instance. If it is already recorded here, saving says so, and takes it from nobody."
msgstr "Միջազգային ձևաչափով համարն այս տեղակայումում պահվում է միայն մեկ անգամ։ Եթե այն արդեն գրանցված է այստեղ, պահպանելիս դա կնշվի, և այն ոչ ոքից չի վերցվի։"

#: src/postulo/templates/partials/phone_numbers.html
msgid "A number is kept once on this instance. If one is already recorded here, saving says so rather than taking it from whoever has it."
msgstr "Համարն այս տեղակայումում կարող է գրանցված լինել միայն մեկ անգամ։ Եթե այն արդեն գրանցված է այստեղ, պահպանելիս դա կնշվի, և համարը չի վերցվի նրանից, ում այն պատկանում է։"

#: src/postulo/jobs/surface.py
msgid "A number is needed."
msgstr "Անհրաժեշտ է համար։"

#: src/postulo/templates/help/telephone_numbers.html
msgid "A number its country cannot have is refused, and the refusal says why. A number Postulo cannot place is kept as you typed it, with a note beside it. One recorded before numbers were checked stays as it is, marked, until you change it. Nothing here proves that a number is yours."
msgstr "Համարը, որը նրա երկիրը չի կարող ունենալ, մերժվում է, և մերժումը նշում է պատճառը։ Համարը, որը Postulo-ն չի կարող որոշել, պահվում է այնպես, ինչպես մուտքագրել եք, կողքին նշումով։ Նախքան համարների ստուգումը գրանցվածը մնում է ինչպես կա՝ նշված, մինչև այն փոխեք։ Այստեղ ոչինչ չի ապացուցում, որ համարը ձերն է։"

#: src/postulo/resume/candidate.py
msgid "A number with nothing in it"
msgstr "Դատարկ թվային դաշտ"

#: src/postulo/templates/server/plugins.html
#, python-format
msgid "A package registers a source under the <code>%(group)s</code> entry-point group. A plugin appears as soon as it is installed, in every part of this instance and without a restart. Entry points are all it can bring: a plugin with pages or tables of its own has to be built into the image. A source that fails to load is logged and left out, and the built-in ones keep working."
msgstr "Փաթեթը գրանցում է աղբյուրը <code>%(group)s</code> մուտքի կետերի խմբի տակ։ Հավելումը հայտնվում է հենց տեղադրվելուն պես՝ այս տեղակայման ամեն մասում և առանց վերագործարկման։ Մուտքի կետերը միակն են, ինչ այն կարող է բերել․ սեփական էջեր կամ աղյուսակներ ունեցող հավելումը պետք է ներկառուցվի պատկերի մեջ։ Աղբյուրը, որը չի բեռնվում, գրանցվում է մատյանում և դուրս թողնվում, իսկ ներկառուցվածները շարունակում են աշխատել։"

#: src/postulo/templates/server/design.html
msgid "A page title"
msgstr "Էջի վերնագիր"

#: src/postulo/templates/settings/account.html
#, python-format
msgid "A passkey is tied to the address you made it at, which here is %(host)s. Reaching this instance by another name, or moving it, will not carry your passkeys over."
msgstr "Անցաբանալին կապված է այն հասցեի հետ, որտեղ այն ստեղծել եք, իսկ այստեղ դա %(host)s է։ Այս տեղակայմանը այլ անունով հասնելը կամ այն տեղափոխելը ձեր անցաբանալիները հետը չի տանի։"

#: src/postulo/core/server_forms.py
msgid "A password is right for your own mail server, and for Gmail with an app password. Microsoft 365 stops accepting passwords for sending mail by default at the end of December 2026; after that it needs XOAUTH2."
msgstr "Գաղտնաբառը հարմար է ձեր սեփական փոստային սերվերի համար, ինչպես նաև Gmail-ի համար՝ հավելվածի գաղտնաբառով։ Microsoft 365-ը 2026 թ․ դեկտեմբերի վերջից լռելյայն այլևս չի ընդունում գաղտնաբառեր փոստ ուղարկելու համար․ դրանից հետո անհրաժեշտ է XOAUTH2։"

#: src/postulo/templates/server/email.html
msgid "A password is stored. It is never shown, not even its length."
msgstr "Գաղտնաբառը պահված է։ Այն երբեք ցույց չի տրվում, նույնիսկ դրա երկարությունը։"

#: src/postulo/core/mail_choices.py
msgid "A password, or an app password"
msgstr "Գաղտնաբառ կամ հավելվածի գաղտնաբառ"

#: src/postulo/documents/integrity.py
msgid "a PDF"
msgstr "PDF ֆայլ"

#: src/postulo/templates/server/design.html
msgid "A person, a company or a plugin, as initials on a colour until there is a picture."
msgstr "Մարդ, ընկերություն կամ հավելում՝ որպես սկզբնատառեր գունավոր ֆոնի վրա, մինչև նկար լինի։"

#: src/postulo/core/web_links.py
msgid "A personal site, a blog, a portfolio — as many as are worth showing, with one of them marked as the one to show. Documents print that one."
msgstr "Անձնական կայք, բլոգ, պորտֆոլիո — այնքան, որքան արժե ցույց տալ, որոնցից մեկը նշված է որպես ցուցադրվողը։ Փաստաթղթերը տպում են այդ մեկը։"

#: src/postulo/core/help.py
msgid "A photograph for your CVs, kept apart from your picture. It is kept as you frame it, and a CV prints it only when you tick that on the CV. The plain text and the Word file never carry it."
msgstr "Լուսանկար ձեր CV-ների համար՝ ձեր նկարից առանձին։ Այն պահվում է այնպես, ինչպես դուք եք այն կադրավորում, և CV-ն այն տպում է միայն այն դեպքում, երբ դա նշել եք տվյալ CV-ում։ Պարզ տեքստը և Word ֆայլը այն երբեք չեն պարունակում։"

#: src/postulo/templates/jobs/capture_page.html
#, python-format
msgid "A picture of the page that “%(title)s” was read from"
msgstr "Այն էջի պատկերը, որից կարդացվել է «%(title)s» հայտարարությունը"

#: src/postulo/accounts/forms.py
msgid "A picture of the whole page. One sent by your browser extension shows the page as you were seeing it, signed in or not. Where there is none, one can be drawn here from the kept source, with scripts and the network off: the words of the page, without its looks."
msgstr "Ամբողջ էջի պատկերը։ Ձեր դիտարկիչի ընդլայնման ուղարկածը ցույց է տալիս էջն այնպես, ինչպես դուք էիք այն տեսնում՝ մուտք գործած, թե ոչ։ Եթե այդպիսին չկա, այն կարելի է գծել այստեղ պահված էջի կոդից՝ անջատված սկրիպտներով և ցանցով․ էջի բառերը՝ առանց դրա արտաքին տեսքի։"

#: src/postulo/templates/jobs/capture_page.html
msgid "A picture taken in a browser shows the page as it was being seen there, signed in or not."
msgstr "Դիտարկիչում արված պատկերը ցույց է տալիս էջն այնպես, ինչպես այն երևում էր այնտեղ՝ մուտք գործած կամ ոչ։"

#: src/postulo/templates/help/your_picture.html
#, python-format
msgid "A picture you upload has to be %(formats)s, of no more than %(megabytes)s MB and no more than %(megapixels)s megapixels. What the file is decides, not what it is called. Anything else is refused, with the reason, and the picture you had stays."
msgstr "Վերբեռնվող նկարը պետք է լինի %(formats)s ձևաչափով, ոչ ավելի, քան %(megabytes)s ՄԲ և ոչ ավելի, քան %(megapixels)s մեգապիքսել։ Որոշիչն այն է, թե ինչ է ֆայլն իրականում, ոչ թե ինչպես է այն կոչվում։ Մնացած ամեն ինչ մերժվում է՝ պատճառի նշմամբ, և ձեր նախկին նկարը մնում է։"

#: src/postulo/templates/help/your_picture.html
msgid "A picture you uploaded is shown rather than your Gravatar, and your Gravatar rather than your initials. <em>Remove the uploaded picture</em> is offered once there is one: tick it and save, and the file is deleted."
msgstr "Ձեր վերբեռնած նկարը ցուցադրվում է Gravatar-ի փոխարեն, իսկ Gravatar-ը՝ ձեր սկզբնատառերի փոխարեն։ <em>Հեռացնել վերբեռնված նկարը</em> տարբերակն առաջարկվում է, երբ նկար կա․ նշեք այն և պահպանեք, և ֆայլը կջնջվի։"

#: src/postulo/templates/accounts/profile.html
#: src/postulo/templates/jobs/contact_form.html
msgid "A pin for it is drawn on your map, at its postcode or town, and only you can see it."
msgstr "Դրա համար նշիչ է դրվում ձեր քարտեզին՝ իր փոստային ինդեքսի կամ քաղաքի վրա, և միայն դուք կարող եք տեսնել այն։"

#: src/postulo/templates/partials/postal_addresses.html
msgid "A place rather than a whole address, and kept as it is. For post to reach it:"
msgstr "Վայր է, ոչ թե ամբողջական հասցե, և պահվում է այնպես, ինչպես կա։ Որպեսզի փոստն այնտեղ հասնի՝"

#: src/postulo/documents/integrity.py
msgid "a plain text file"
msgstr "պարզ տեքստային ֆայլ"

#: src/postulo/templates/widgets/suggestions.html
#, python-format
msgid "A plugin has suggested one thing that may have happened: <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">look at it</a>."
msgid_plural "Plugins have suggested %(counter)s things that may have happened: <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">look at them</a>."
msgstr[0] "Հավելումն առաջարկել է մեկ բան, որը գուցե տեղի է ունեցել՝ <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">նայեք դրան</a>։"
msgstr[1] "Հավելումներն առաջարկել են %(counter)s բան, որոնք գուցե տեղի են ունեցել՝ <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">նայեք դրանց</a>։"

#: src/postulo/templates/applications/suggestion_list.html
msgid "A plugin that reads a mailbox or a calendar for you files what it finds here, and it stays here until you accept or decline it."
msgstr "Հավելումը, որը ձեզ համար փոստարկղ կամ օրացույց է կարդում, գտածն այստեղ է դնում, և այն մնում է այստեղ, մինչև ընդունեք կամ մերժեք։"

#: src/postulo/templates/server/plugins.html
msgid "A plugin's own file is checked against the checksum its catalogue signed. Its requirements are not: those are fetched from PyPI when it is installed, and are whatever is served that day. Trusting a plugin means trusting its list of requirements too. Postulo installs only built wheels, never a source package that would run its own code while installing, and records everything that arrived."
msgstr "Հավելման սեփական ֆայլը ստուգվում է այն ստուգիչ գումարով, որը ստորագրել է դրա կատալոգը։ Դրա պահանջները չեն ստուգվում․ դրանք բերվում են PyPI-ից տեղադրման ժամանակ, և լինում են այն, ինչ այդ օրը տրամադրվում է։ Հավելմանը վստահելը նշանակում է վստահել նաև դրա պահանջների ցանկին։ Postulo-ն տեղադրում է միայն կառուցված wheel փաթեթներ, երբեք ելակետային փաթեթ, որը տեղադրման ժամանակ կգործարկեր իր սեփական կոդը, և գրանցում է այն ամենը, ինչ եկել է։"

#: src/postulo/documents/integrity.py
msgid "a PNG picture"
msgstr "PNG պատկեր"

#: src/postulo/core/design.py
msgid "A popover or a menu, over the page rather than in it."
msgstr "Թռուցիկ պատուհան կամ ընտրացանկ՝ էջի վրա, ոչ թե դրա ներսում։"

#: src/postulo/resume/registry.py
msgid "A portfolio, a profile, a video: work of yours that already lives somewhere."
msgstr "Պորտֆոլիո, պրոֆիլ, տեսանյութ՝ ձեր աշխատանքը, որն արդեն ինչ-որ տեղ ապրում է։"

#: src/postulo/notifications/base.py
msgid "A posting arrives through the capture API"
msgstr "Հայտարարությունը գալիս է որսի API-ի միջոցով"

#: src/postulo/templates/jobs/listing_form.html
msgid "A posting you have noticed. The company and the title are enough to start; the rest can come later."
msgstr "Հայտարարություն, որը նկատել եք։ Ընկերությունն ու վերնագիրը բավական են սկսելու համար․ մնացածը կարող է ավելի ուշ գալ։"

#: src/postulo/resume/forms.py
msgid "A prize, a scholarship, a “best paper”: recognition, with nothing to check and no expiry. A credential that may lapse is a certification, and a degree’s classification, such as “cum laude”, is that education entry’s grade."
msgstr "Մրցանակ, կրթաթոշակ, «լավագույն հոդված»․ ճանաչում՝ առանց ստուգելու բանի և առանց ժամկետի։ Փաստաթուղթը, որի ժամկետը կարող է լրանալ, հավաստագիր է, իսկ աստիճանի դասակարգումը, օրինակ՝ «cum laude», այդ կրթության գրառման գնահատականն է։"

#: src/postulo/resume/candidate.py
#, python-format
msgid "A profile holds at most %(most)s nationalities, and this lists more."
msgstr "Պրոֆիլը կարող է ունենալ առավելագույնը %(most)s քաղաքացիություն, իսկ այստեղ ավելին է նշված։"

#: src/postulo/core/web_links.py
msgid "A profile on a forge, or one project worth showing — as many as are worth listing, with one of them marked as the one to show. Documents print that one."
msgstr "Պրոֆիլ կոդի պահոցների կայքում կամ մեկ նախագիծ, որ արժե ցույց տալ — այնքան, որքան արժե թվարկել, որոնցից մեկը նշված է որպես ցուցադրվողը։ Փաստաթղթերը տպում են այդ մեկը։"

#: src/postulo/core/web_links.py
msgid "A profile on GitHub, Forgejo, GitLab or similar."
msgstr "Պրոֆիլ GitHub-ում, Forgejo-ում, GitLab-ում կամ նմանատիպ վայրում։"

#: src/postulo/resume/forms.py
msgid "A programme, the slides or a recording. A CV does not print it."
msgstr "Ծրագիր, սլայդներ կամ ձայնագրություն։ CV-ն այն չի տպում։"

#: src/postulo/resume/forms.py
msgid "A public page for the course or its certificate."
msgstr "Դասընթացի կամ դրա վկայականի հանրային էջ։"

#: src/postulo/templates/server/plugins.html
msgid "A Python wheel (<code>.whl</code>) built for any platform. Postulo reads what it says about itself and shows you that before anything is installed."
msgstr "Python wheel փաթեթ (<code>.whl</code>)՝ կառուցված բոլոր հարթակների համար։ Postulo-ն կարդում է, թե ինչ է այն ասում իր մասին, և ցույց է տալիս դա ձեզ, նախքան որևէ բան տեղադրվի։"

#: src/postulo/templates/applications/report.html
msgid "A quarter"
msgstr "Մեկ եռամսյակ"

#: src/postulo/templates/server/design.html
msgid "A question over the page, answered before anything is done. This one asks about nothing, and neither answer changes anything."
msgstr "Էջի վրա բացվող հարց, որին պատասխանում են, նախքան որևէ բան արվի։ Այս մեկը ոչ մի բանի մասին չի հարցնում, և ոչ մի պատասխան ոչինչ չի փոխում։"

#: src/postulo/templates/server/logs.html
msgid "A quiet log is the one you want."
msgstr "Լուռ մատյանն է հենց այն, ինչ ձեզ պետք է։"

#: src/postulo/resume/forms.py
msgid "A range such as 41–52, or one page."
msgstr "Միջակայք, օրինակ՝ 41–52, կամ մեկ էջ։"

#: src/postulo/documents/forms.py
msgid "A referee who is not a contact yet. Their name is enough; it is added to your contacts without a company, and is used instead of the choice above."
msgstr "Հանձնարարական տվող, որը դեռ ձեր կոնտակտը չէ։ Բավական է նրա անունը․ նա կավելացվի ձեր կոնտակտներին առանց ընկերության և կօգտագործվի վերևի ընտրության փոխարեն։"

#: src/postulo/applications/ical_import.py
msgid "A reminder"
msgstr "Հիշեցում"

#: src/postulo/notifications/base.py
msgid "A reminder falls due"
msgstr "Հիշեցման ժամկետը լրանում է"

#: src/postulo/applications/forms.py
msgid "A reminder falls due a day ahead, when there is a day ahead."
msgstr "Հիշեցումը գալիս է մեկ օր առաջ, եթե մինչ այդ դեռ մեկ օր կա։"

#: src/postulo/accounts/models.py
msgid "A reminder of who this is for."
msgstr "Հիշեցում այն մասին, թե ում համար է սա։"

#: src/postulo/core/server_forms.py
msgid "A rendering heavier than this is refused before it is read. Left empty, the instance's own setting applies."
msgstr "Սրանից ծանր էջի պատկերը մերժվում է նախքան կարդացվելը։ Դատարկ թողնելու դեպքում գործում է տեղակայման սեփական կարգավորումը։"

#: src/postulo/jobs/pages.py
msgid "A rendering is a PNG, JPEG or WebP image, or a PDF, and the request did not say which."
msgstr "Էջի պատկերը PNG, JPEG կամ WebP պատկեր է կամ PDF, և հարցումը չնշեց, թե որը։"

#: src/postulo/jobs/pages.py
#, python-format
msgid "A rendering is a PNG, JPEG or WebP image, or a PDF. That was %(kind)s."
msgstr "Էջի պատկերը PNG, JPEG կամ WebP պատկեր է կամ PDF։ Ստացվածը %(kind)s էր։"

#: src/postulo/templates/jobs/capture_review.html
msgid "A rendering of the page this was read from was kept."
msgstr "Պահվել է այն էջի պատկերը, որից սա կարդացվել է։"

#: src/postulo/templates/widgets/shortcuts.html
msgid "A report on a period"
msgstr "Հաշվետվություն մի ժամանակահատվածի մասին"

#: src/postulo/templates/server/backup_restore.html
msgid "A restore replaces everything on this instance with what is in the archive, so nothing else may be using the database while it runs. Stop the web service, the scheduler and the worker first, restore, and start them again. Run these on the machine that hosts the instance, not in this browser. The restore command is given <code>--force</code> because this instance already has accounts."
msgstr "Վերականգնումը փոխարինում է այս տեղակայման ամեն ինչ արխիվի պարունակությամբ, ուստի դրա ընթացքում ոչ մի այլ բան չպետք է օգտագործի տվյալների բազան։ Նախ կանգնեցրեք վեբ ծառայությունը, պլանավորիչը և աշխատող պրոցեսը, կատարեք վերականգնումը, ապա նորից գործարկեք դրանք։ Գործարկեք սրանք այն մեքենայի վրա, որը սպասարկում է տեղակայումը, ոչ թե այս դիտարկիչում։ Վերականգնման հրամանին տրվում է <code>--force</code>, քանի որ այս տեղակայումն արդեն հաշիվներ ունի։"

#: src/postulo/templates/server/design.html
msgid "A row"
msgstr "Տող"

#: src/postulo/templates/help/messaging.html
msgid "A row is one way of being reached on a messaging service: Matrix, XMPP, Signal, Telegram, Threema or another. Choose the service, give the handle, and name the service yourself under <em>Other</em>. As many as are worth keeping, with one marked as the one to use."
msgstr "Տողը մեսենջերային ծառայությունում ձեզ հետ կապվելու մեկ եղանակ է՝ Matrix, XMPP, Signal, Telegram, Threema կամ այլ։ Ընտրեք ծառայությունը, նշեք անունը, իսկ <em>Այլ</em>-ի դեպքում ծառայությունն ինքներդ անվանեք։ Այնքան, որքան արժե պահել, որոնցից մեկը նշված է որպես օգտագործվողը։"

#: src/postulo/templates/core/import_csv.html
msgid "A row whose status is draft becomes a listing and any other status an application; a row with no status becomes an application if it has a date applied and a listing if it has none. Applications are dated as the spreadsheet says and marked as imported on their timeline."
msgstr "Տողը, որի կարգավիճակը սևագիր է, դառնում է հայտարարություն, իսկ ցանկացած այլ կարգավիճակով տողը՝ դիմում․ առանց կարգավիճակի տողը դառնում է դիմում, եթե ունի դիմելու ամսաթիվ, և հայտարարություն, եթե չունի։ Դիմումները թվագրվում են այնպես, ինչպես նշված է էլեկտրոնային աղյուսակում, և իրենց ժամանակագրության մեջ նշվում են որպես ներմուծված։"

#: src/postulo/jobs/capture_views.py
msgid "A saved capture is part of its listing. It goes when the listing does."
msgstr "Պահպանված որսը իր հայտարարության մասն է։ Այն հեռանում է հայտարարության հետ միասին։"

#: src/postulo/templates/server/overview.html
msgid "A scheduled backup was due and nothing took it."
msgstr "Պլանավորված պահուստավորման ժամկետը եկել էր, և ոչինչ այն չկատարեց։"

#: src/postulo/templates/server/backups.html
msgid "A scheduled backup was due and nothing took it. Is the scheduler running? A backup on a schedule needs it."
msgstr "Պլանավորված պահուստավորման ժամկետը եկել էր, և ոչինչ այն չկատարեց։ Պլանավորիչն աշխատո՞ւմ է։ Պլանավորված պահուստավորման համար այն անհրաժեշտ է։"

#: src/postulo/accounts/forms.py
msgid "A scheme left out is not drawn in a company's summary. It is never deleted: its values stay in the forms, in the export and on any CV you chose to print them on."
msgstr "Բաց թողնված սխեման չի գծվում ընկերության ամփոփման մեջ։ Այն երբեք չի ջնջվում․ դրա արժեքները մնում են ձևաթղթերում, արտահանման մեջ և ցանկացած CV-ում, որում ընտրել եք դրանք տպել։"

#: src/postulo/resume/forms.py
msgid "A school, a company, a platform: as a CV should print it. It is linked to the company of that name among yours, and added to your companies if there is none."
msgstr "Դպրոց, ընկերություն, հարթակ՝ ինչպես պետք է տպվի CV-ում։ Այն կապվում է ձեր ընկերություններից նույն անվանումն ունեցողի հետ և ավելացվում է ձեր ընկերություններին, եթե այդպիսին չկա։"

#: src/postulo/core/models.py
msgid "A second signal beside the word, never instead of it."
msgstr "Երկրորդ նշան բառի կողքին, երբեք՝ դրա փոխարեն։"

#: src/postulo/templates/server/design.html
msgid "A section heading"
msgstr "Բաժնի վերնագիր"

#: src/postulo/templates/core/home.html
msgid "A self-hosted job application manager, written from the applicant's side of the table. Your applications, your CVs, your cover letters, on your server."
msgstr "Սեփական սերվերում տեղակայվող աշխատանքի դիմումների կառավարիչ՝ գրված սեղանի դիմորդի կողմից նայելով։ Ձեր դիմումները, ձեր CV-ները, ձեր ուղեկցող նամակները՝ ձեր սերվերում։"

#: src/postulo/templates/server/groups.html
msgid "A set of accounts. A group can own companies, contacts and listings, which every member can then see, change, share and delete, and records can be shared with it; it is also what an access rule on a plugin or a module points at. Whoever leaves keeps a copy of what their own records need; a group that still owns records cannot lose its last member or be deleted."
msgstr "Հաշիվների խումբ։ Խումբը կարող է ունենալ ընկերություններ, կոնտակտներ և հայտարարություններ, որոնք այնուհետև յուրաքանչյուր անդամ կարող է տեսնել, փոխել, կիսվել և ջնջել, և գրառումները կարող են կիսվել դրա հետ․ այն նաև այն է, ինչին հղվում է հավելման կամ մոդուլի մուտքի կանոնը։ Ով հեռանում է, պահում է այն բանի պատճենը, ինչ անհրաժեշտ է իր սեփական գրառումներին․ խումբը, որը դեռ գրառումներ ունի, չի կարող կորցնել իր վերջին անդամին կամ ջնջվել։"

#: src/postulo/accounts/models.py
msgid "A short professional title, such as “Backend engineer”."
msgstr "Կարճ մասնագիտական վերնագիր, օրինակ՝ «Backend ինժեներ»։"

#: src/postulo/templates/server/person_recovery.html
#, python-format
msgid "A single-use link that lets %(name)s choose a new password, good for %(minutes)s minute. Postulo does not send it anywhere: you hand it over yourself, by whatever means you already trust."
msgid_plural "A single-use link that lets %(name)s choose a new password, good for %(minutes)s minutes. Postulo does not send it anywhere: you hand it over yourself, by whatever means you already trust."
msgstr[0] "Մեկանգամյա հղում, որը թույլ է տալիս %(name)s օգտատիրոջը ընտրել նոր գաղտնաբառ և գործում է %(minutes)s րոպե։ Postulo-ն այն ոչ մի տեղ չի ուղարկում․ դուք ինքներդ եք այն փոխանցում՝ ցանկացած միջոցով, որին արդեն վստահում եք։"
msgstr[1] "Մեկանգամյա հղում, որը թույլ է տալիս %(name)s օգտատիրոջը ընտրել նոր գաղտնաբառ և գործում է %(minutes)s րոպե։ Postulo-ն այն ոչ մի տեղ չի ուղարկում․ դուք ինքներդ եք այն փոխանցում՝ ցանկացած միջոցով, որին արդեն վստահում եք։"

#: src/postulo/templates/help/install.html
msgid "A site can only be installed when it is served over HTTPS. If no browser offers to install it, ask whoever runs this server."
msgstr "Կայքը կարելի է տեղադրել միայն այն դեպքում, երբ այն սպասարկվում է HTTPS-ով։ Եթե ոչ մի դիտարկիչ չի առաջարկում այն տեղադրել, դիմեք այս սերվերը սպասարկողին։"

#: src/postulo/accounts/forms.py
msgid "A small key cap beside Save and next, Discard and next, Skip to the next and the search box. Turning it off hides the caps only; the keys keep working (see above), and a screen reader is still told about them."
msgstr "Ստեղնի փոքրիկ պատկեր «Պահպանել և անցնել հաջորդին», «Մի կողմ դնել և անցնել հաջորդին», «Բաց թողնել և անցնել հաջորդին» կոճակների և որոնման դաշտի կողքին։ Անջատելը թաքցնում է միայն պատկերները․ ստեղները շարունակում են աշխատել (տես վերևում), և էկրանի ընթերցիչը դրանց մասին դեռ տեղեկացվում է։"

#: src/postulo/templates/server/design.html
msgid "A small one"
msgstr "Փոքրը"

#: src/postulo/templates/help/links.html
msgid "A social profile is one to a service: a service another row already uses is greyed out in the menu and cannot be chosen again, and saving refuses a second one. A service that lives on many servers, such as Mastodon, and <em>Other</em> can be used as often as you like, and so can the cards of code repositories. Rows that already shared a service stay as they are, with a note, until you change them."
msgstr "Սոցիալական պրոֆիլը մեկն է յուրաքանչյուր ծառայության համար․ մեկ այլ տողում արդեն օգտագործվող ծառայությունը ընտրացանկում մոխրագույն է և չի կարող կրկին ընտրվել, իսկ պահպանումը մերժում է երկրորդը։ Բազմաթիվ սերվերներում գործող ծառայությունը, օրինակ՝ Mastodon-ը, և <em>Այլ</em>-ը կարող են օգտագործվել այնքան, որքան ցանկանում եք, ինչպես նաև կոդի պահոցների քարտերը։ Տողերը, որոնք արդեն ընդհանուր ծառայություն ունեին, մնում են այնպես, ինչպես կան, նշումով, մինչև դուք դրանք փոխեք։"

#: src/postulo/templates/applications/application_form.html
msgid "A status changed here is recorded on the timeline, the same as anywhere else."
msgstr "Այստեղ փոխված կարգավիճակը գրանցվում է ժամանակագրության մեջ, ինչպես ամենուր։"

#: src/postulo/plugins/syncing.py
msgid "A sync of this connection is already running."
msgstr "Այս կապի համաժամեցումն արդեն ընթացքում է։"

#: src/postulo/templates/server/design.html
msgid "A table inside a card"
msgstr "Աղյուսակ քարտի ներսում"

#: src/postulo/resume/forms.py
msgid "A talk, a workshop, a panel or a committee, or an event you took part in: one place on set days. Learning with a provider, a length and an outcome belongs in Courses, and a paper in Publications. Listing an event you only attended is your call."
msgstr "Ելույթ, սեմինար, քննարկում կամ հանձնաժողով, կամ միջոցառում, որին մասնակցել եք՝ մեկ վայրում, որոշակի օրերին։ Մատակարարի մոտ ուսումը՝ տևողությամբ և արդյունքով, պատկանում է «Դասընթացներ» բաժնին, իսկ հոդվածը՝ «Հրապարակումներ» բաժնին։ Միայն որպես ունկնդիր մասնակցած միջոցառումը նշելը ձեր որոշումն է։"

#: src/postulo/core/channels.py
#, python-format
msgid "A telephone number has between %(low)d and %(high)d digits, and that one has %(count)d."
msgstr "Հեռախոսահամարն ունի %(low)d-ից %(high)d թվանշան, իսկ այդ մեկը՝ %(count)d։"

#: src/postulo/templates/help/messaging.html
msgid "A telephone number that is also on a messaging app belongs under <em>Telephone numbers</em>. The filled star marks the primary. The bin removes a row at once, after asking, without waiting for <em>Save</em>."
msgstr "Հեռախոսահամարը, որը նաև մեսենջերում է, պետք է լինի <em>Հեռախոսահամարներ</em> բաժնում։ Լցված աստղը նշում է հիմնականը։ Աղբամանը հեռացնում է տողն անմիջապես՝ նախ հարցնելով, առանց սպասելու <em>Պահպանել</em>-ին։"

#: src/postulo/templates/core/import_csv.html
