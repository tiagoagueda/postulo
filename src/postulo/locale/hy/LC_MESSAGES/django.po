msgstr "Դրանից բացի նաև ձեր պրոֆիլը, ձեր կարիերայի գրառումը, պիտակները, ժամանակագրության յուրաքանչյուր գրառում և յուրաքանչյուր հիշեցում։ Արխիվը պարունակում է մեկ ընթեռնելի JSON ֆայլ և մեդիա թղթապանակ։"

#: src/postulo/jobs/models.py
msgid "PNG image"
msgstr "PNG պատկեր"

#: src/postulo/jobs/forms.py
msgid "PNG, JPEG, GIF, WebP or SVG. It is re-encoded at its own size, with nothing else the file carried; an SVG is kept as a vector and stripped of everything but the drawing."
msgstr "PNG, JPEG, GIF, WebP կամ SVG։ Այն վերակոդավորվում է իր սեփական չափով՝ առանց ֆայլի պարունակած որևէ այլ բանի․ SVG-ն պահվում է որպես վեկտոր և մաքրվում է ամեն ինչից, բացի գծանկարից։"

#: src/postulo/templates/jobs/company_places.html
#, python-format
msgid "Points are matched to your companies by name, or by a wikidata property; at most %(limit)s are read. Nothing is placed until you tick it."
msgstr "Կետերը համապատասխանեցվում են ձեր ընկերություններին ըստ անվանման կամ Wikidata հատկության․ կարդացվում է առավելագույնը %(limit)s։ Քարտեզի վրա ոչինչ չի դրվում, մինչև չնշեք։"

#: src/postulo/core/models.py
msgid "port"
msgstr "պորտ"

#: src/postulo/core/mail.py
#, python-format
msgid "Port %(port)s expects a connection in the clear that is upgraded afterwards. Choose “STARTTLS, after connecting”, or use port 465."
msgstr "%(port)s պորտը սպասում է չգաղտնագրված կապի, որը հետո դառնում է գաղտնագրված։ Ընտրեք «STARTTLS, միանալուց հետո» կամ օգտագործեք 465 պորտը։"

#: src/postulo/core/mail.py
msgid "Port 465 expects TLS from the first byte, so it is waiting for a certificate while Postulo waits for a greeting. Choose “TLS from the first byte”, or use port 587 with STARTTLS."
msgstr "465 պորտը սպասում է TLS առաջին իսկ բայթից, ուստի այն սպասում է հավաստագրի, մինչդեռ Postulo-ն սպասում է ողջույնի։ Ընտրեք «TLS առաջին բայթից» կամ օգտագործեք 587 պորտը STARTTLS-ով։"

