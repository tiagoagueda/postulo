#: src/postulo/core/server_views.py:879
#, python-format, draft
msgid "“%(name)s” is on. Plugins may be installed and updated from it."
msgstr ""
"«%(name)s»-ը միացված է։ Նրանից կարելի է հավելումներ տեղադրել և թարմացնել։"

