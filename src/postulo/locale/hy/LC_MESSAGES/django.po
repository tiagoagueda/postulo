msgid "Wikidata"
msgstr "Wikidata"

#: src/postulo/jobs/wikidata.py
#, python-format
msgid "Wikidata answered %(status)s."
msgstr "Wikidata-ն պատասխանեց՝ %(status)s։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata asked for fewer requests. Try again later."
msgstr "Wikidata-ն խնդրեց ավելի քիչ հարցումներ։ Կրկին փորձեք ավելի ուշ։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata could not be reached."
msgstr "Wikidata-ին հնարավոր չեղավ միանալ։"

#: src/postulo/jobs/views.py
msgid "Wikidata gives its name in that language. Fetch again to change it, or take it off first."
msgstr "Wikidata-ն տալիս է դրա անվանումն այդ լեզվով։ Այն փոխելու համար կրկին բերեք կամ նախ հանեք այն։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata has no item with that identifier."
msgstr "Wikidata-ում այդ նույնացուցիչով տարր չկա։"

#: src/postulo/templates/jobs/company_wikidata.html
#, python-format
msgid "Wikidata names %(qid)s as its replacement; no company here carries that identifier."
msgstr "Wikidata-ն որպես դրա փոխարինող նշում է %(qid)s-ը․ այստեղ ոչ մի ընկերություն այդ նույնացուցիչը չունի։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata redirected too many times."
msgstr "Wikidata-ն չափազանց շատ անգամ վերահղեց։"

#: src/postulo/templates/jobs/company_wikidata.html
msgid "Wikidata says this organisation has ended. Choose whether to record it; the legal state is shown to everybody who can see this company."
msgstr "Wikidata-ն ասում է, որ այս կազմակերպությունը դադարել է գոյություն ունենալ։ Ընտրեք, արդյոք գրանցել դա․ իրավական կարգավիճակը ցուցադրվում է բոլորին, ովքեր կարող են տեսնել այս ընկերությունը։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata sent the request somewhere else."
msgstr "Wikidata-ն հարցումն ուղարկեց այլ տեղ։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata took too long to answer."
msgstr "Wikidata-ն չափազանց երկար էր պատասխանում։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata's answer was larger than an item should be."
msgstr "Wikidata-ի պատասխանն ավելի մեծ էր, քան կարող է լինել տարրը։"

#: src/postulo/jobs/wikidata.py
msgid "Wikidata's answer was not an item."
msgstr "Wikidata-ի պատասխանը տարր չէր։"

#: src/postulo/templates/jobs/company_wikidata.html
msgid "Wikidata's data is in the public domain (CC0). Keeping these replaces any name you typed for the same language, and takes off a name an earlier fetch gave that this one did not."
msgstr "Wikidata-ի տվյալները հանրային սեփականություն են (CC0)։ Սրանք պահելը փոխարինում է նույն լեզվով ձեր մուտքագրած ցանկացած անվանում և հեռացնում է այն անվանումը, որը տվել էր նախորդ բերումը, բայց այս մեկը չտվեց։"

#: src/postulo/core/file_review.py
msgid "Will be added"
msgstr "Կավելացվի"

#: src/postulo/templates/settings/account.html
msgid "With a passkey: no code. The passkey is both factors already."
msgstr "Անցաբանալիով՝ առանց կոդի։ Անցաբանալին ինքնին արդեն երկու գործոն է։"

#: src/postulo/templates/settings/account.html
msgid "With a password: you are asked for your second factor every time."
msgstr "Գաղտնաբառով՝ ձեր երկրորդ գործոնը պահանջվում է ամեն անգամ։"

#: src/postulo/templates/settings/account.html
#, python-format
msgid "With a password: you are asked for your second factor, unless you marked this browser as trusted. That lasts %(days)s day."
msgid_plural "With a password: you are asked for your second factor, unless you marked this browser as trusted. That lasts %(days)s days."
msgstr[0] "Գաղտնաբառով՝ ձեր երկրորդ գործոնը պահանջվում է, եթե այս դիտարկիչը չեք նշել որպես վստահելի։ Դա գործում է %(days)s օր։"
msgstr[1] "Գաղտնաբառով՝ ձեր երկրորդ գործոնը պահանջվում է, եթե այս դիտարկիչը չեք նշել որպես վստահելի։ Դա գործում է %(days)s օր։"

