msgstr "Սա %(service)s ծառայության անվան տեսք չունի։ Ընտրեք «Այլ»՝ այլ ձևի անուն ավելացնելու համար։"

#: src/postulo/core/messaging_services.py
#, python-format
msgid "That does not look like a handle on %(service)s. One looks like %(example)s; choose “Other” to list a handle of another shape."
msgstr "Սա %(service)s ծառայության անվան տեսք չունի։ Այն սովորաբար այսպիսին է՝ %(example)s․ ընտրեք «Այլ»՝ այլ ձևի անուն ավելացնելու համար։"

#: src/postulo/core/link_services.py
#, python-format
msgid "That does not look like an address on %(service)s. Choose “Other” to list an address of another shape."
msgstr "Սա %(service)s ծառայության հասցեի տեսք չունի։ Ընտրեք «Այլ»՝ այլ ձևի հասցե ավելացնելու համար։"

#: src/postulo/core/link_services.py
#, python-format
msgid "That does not look like an address on %(service)s. One looks like %(example)s; choose “Other” to list an address of another shape."
msgstr "Սա %(service)s ծառայության հասցեի տեսք չունի։ Այն սովորաբար այսպիսին է՝ %(example)s․ ընտրեք «Այլ»՝ այլ ձևի հասցե ավելացնելու համար։"

#: src/postulo/applications/views.py
msgid "That entry could not be saved."
msgstr "Այդ գրառումը չհաջողվեց պահպանել։"

#: src/postulo/documents/models.py
msgid "That entry is not one of yours."
msgstr "Այդ գրառումը ձերը չէ։"

#: src/postulo/core/views_export.py
msgid "That export has expired. Ask for a new one."
msgstr "Այդ արտահանումը ժամկետանց է։ Պահանջեք նորը։"

#: src/postulo/plugins/base.py
msgid "That file carries a document type declaration, which Postulo will not read. A Europass export does not have one."
msgstr "Այդ ֆայլը պարունակում է փաստաթղթի տեսակի հայտարարություն, որը Postulo-ն չի կարդում։ Europass-ից արտահանված ֆայլն այդպիսին չունի։"

#: src/postulo/applications/ical_reader.py
msgid "That file closes a part it never opened."
msgstr "Այդ ֆայլը փակում է մի մաս, որը երբեք չի բացել։"

#: src/postulo/applications/ical_reader.py
msgid "That file could not be read as an iCalendar file."
msgstr "Այդ ֆայլը չհաջողվեց կարդալ որպես iCalendar ֆայլ։"

#: src/postulo/core/pictures.py
msgid "That file could not be read as an image."
msgstr "Այդ ֆայլը չհաջողվեց կարդալ որպես նկար։"

#: src/postulo/documents/views.py
msgid "That file could not be written. The server log has the details."
msgstr "Այդ ֆայլը հնարավոր չեղավ գրել։ Մանրամասները սերվերի մատյանում են։"

#: src/postulo/applications/ical_reader.py
msgid "That file has a line far longer than any calendar writes."
msgstr "Այդ ֆայլում կա տող, որը շատ ավելի երկար է, քան որևէ օրացույց կգրեր։"

#: src/postulo/applications/ical_reader.py
msgid "That file has more parts than a calendar of a search has."
msgstr "Այդ ֆայլում ավելի շատ մասեր կան, քան կարող է լինել աշխատանքի որոնման օրացույցում։"

#: src/postulo/core/vcard.py
#, python-format
msgid "That file holds a vCard of version %(version)s. Postulo reads versions 3.0 and 4.0; export the contacts again from where they came from, as vCard 3.0 or 4.0."
msgstr "Այդ ֆայլը պարունակում է %(version)s տարբերակի vCard։ Postulo-ն կարդում է 3.0 և 4.0 տարբերակները․ կրկին արտահանեք կոնտակտներն այնտեղից, որտեղից դրանք եկել են, որպես vCard 3.0 կամ 4.0։"

#: src/postulo/core/kind_files.py
msgid "That file holds another kind of record. Read it from the page of the kind it holds."
msgstr "Այդ ֆայլը պարունակում է այլ տեսակի գրառումներ։ Կարդացեք այն այդ տեսակի էջից։"

#: src/postulo/applications/ical_reader.py
#, python-format
msgid "That file holds more than %(limit)s events and tasks, too many to go through."
msgstr "Այդ ֆայլը պարունակում է ավելի քան %(limit)s իրադարձություն և առաջադրանք, ինչը չափազանց շատ է մշակելու համար։"

#: src/postulo/core/kind_files.py src/postulo/plugins/base.py
#: src/postulo/resume/candidate.py
msgid "That file is empty."
msgstr "Այդ ֆայլը դատարկ է։"

#: src/postulo/applications/ical_reader.py
#: src/postulo/applications/views_ical.py src/postulo/core/kind_files.py
#: src/postulo/core/vcard.py src/postulo/core/views_kind_files.py
#: src/postulo/jobs/geojson.py src/postulo/jobs/vcard_views.py
#: src/postulo/plugins/base.py src/postulo/resume/candidate.py
#: src/postulo/resume/views_candidate.py
#, python-format
msgid "That file is larger than %(limit)s MB, so it was not read."
msgstr "Այդ ֆայլն ավելի մեծ է, քան %(limit)s MB, ուստի չկարդացվեց։"

#: src/postulo/documents/forms.py
#, python-format
msgid "That file is larger than %(limit)s MB."
msgstr "Այդ ֆայլն ավելի մեծ է, քան %(limit)s MB։"

#: src/postulo/core/pictures.py src/postulo/jobs/forms.py
#: src/postulo/jobs/logos.py
msgid "That file is larger than a logo should be."
msgstr "Այդ ֆայլը լոգոյի համար չափազանց մեծ է։"

#: src/postulo/core/views_backups.py
#, python-format
msgid "That file is larger than the %(mb)s MB this instance accepts."
msgstr "Այդ ֆայլն ավելի մեծ է, քան %(mb)s ՄԲ, որքան ընդունում է այս տեղակայումը։"

#: src/postulo/jobs/geojson.py
msgid "That file is not a GeoJSON collection of features."
msgstr "Այդ ֆայլը GeoJSON տարրերի հավաքածու չէ։"

#: src/postulo/jobs/geojson.py
msgid "That file is not GeoJSON."
msgstr "Այդ ֆայլը GeoJSON չէ։"

#: src/postulo/resume/views.py
#, python-format
msgid "That file is over %(limit)s MB. A CV is not that big."
msgstr "Այդ ֆայլը %(limit)s MB-ից ավելի է։ CV-ն այդքան մեծ չի լինում։"

#: src/postulo/applications/ical_reader.py
msgid "That file nests its parts deeper than a calendar does."
msgstr "Այդ ֆայլն իր մասերը ներդնում է ավելի խորը, քան որևէ օրացույց։"

#: src/postulo/jobs/logos.py
#, python-format
msgid "That file took longer than %(seconds)s second to arrive."
msgid_plural "That file took longer than %(seconds)s seconds to arrive."
msgstr[0] "Այդ ֆայլի ժամանումը տևեց ավելի քան %(seconds)s վայրկյան։"
msgstr[1] "Այդ ֆայլի ժամանումը տևեց ավելի քան %(seconds)s վայրկյան։"

#: src/postulo/jobs/vcard_views.py
msgid "That file was read, and there was no card in it to import."
msgstr "Այդ ֆայլը կարդացվեց, և դրանում ներմուծելու քարտ չկար։"

#: src/postulo/jobs/views.py
msgid "That file was read, and there was no point in it."
msgstr "Այդ ֆայլը կարդացվեց, և դրանում ոչ մի կետ չկար։"

#: src/postulo/core/views_kind_files.py src/postulo/resume/views.py
#: src/postulo/resume/views_candidate.py
msgid "That file was read, and there was nothing in it to import."
msgstr "Այդ ֆայլը կարդացվեց, բայց դրանում ներմուծելու ոչինչ չկար։"

#: src/postulo/applications/views_ical.py
msgid "That file was read, and there were no events or tasks in it."
msgstr "Ֆայլը կարդացվեց, բայց դրանում իրադարձություններ կամ առաջադրանքներ չկային։"

#: src/postulo/jobs/logos.py
#, python-format
msgid "That file was sent with the content encoding “%(coding)s”, which Postulo does not unpack."
msgstr "Այդ ֆայլն ուղարկվել է «%(coding)s» բովանդակության կոդավորմամբ, որը Postulo-ն չի բացում։"

#: src/postulo/core/phones.py
msgid "That has words in it as well as a number. Leave them out here, and put them in the notes."
msgstr "Սա համարից բացի բառեր էլ է պարունակում։ Այստեղ բաց թողեք դրանք և գրեք նշումներում։"

#: src/postulo/core/phones.py
msgid "That has words in it as well as a number. Leave them out."
msgstr "Սա համարից բացի բառեր էլ է պարունակում։ Բաց թողեք դրանք։"

#: src/postulo/plugins/public_addresses.py
msgid "That hostname could not be resolved."
msgstr "Չհաջողվեց որոշել այդ հանգույցի անվան հասցեն։"

#: src/postulo/plugins/public_addresses.py
msgid "That hostname took too long to resolve."
msgstr "Այդ հոստի անվան որոշումը չափազանց երկար տևեց։"

#: src/postulo/core/pictures.py
msgid "That image cannot be made small enough to keep."
msgstr "Այդ պատկերը հնարավոր չէ բավականաչափ փոքրացնել՝ պահելու համար։"

#: src/postulo/core/pictures.py
msgid "That image is far larger than it needs to be."
msgstr "Այդ պատկերը շատ ավելի մեծ է, քան անհրաժեշտ է։"

#: src/postulo/accounts/views.py
msgid "That invitation has already been accepted and cannot be revoked."
msgstr "Այդ հրավերն արդեն ընդունված է և չի կարող հետ կանչվել։"

#: src/postulo/core/server_views.py
msgid "That is a lot of recovery links. Try again shortly."
msgstr "Չափազանց շատ վերականգնման հղումներ են պահանջվել։ Փորձեք քիչ անց։"

#: src/postulo/plugins/views.py
#, python-format
msgid "That is a lot of syncs. Try again in %(seconds)d second."
msgid_plural "That is a lot of syncs. Try again in %(seconds)d seconds."
msgstr[0] "Համաժամեցումները չափազանց շատ են։ Կրկին փորձեք %(seconds)d վայրկյանից։"
msgstr[1] "Համաժամեցումները չափազանց շատ են։ Կրկին փորձեք %(seconds)d վայրկյանից։"

#: src/postulo/core/server_views.py src/postulo/plugins/views.py
#, python-format
msgid "That is a lot of tests. Try again in %(seconds)d second."
msgid_plural "That is a lot of tests. Try again in %(seconds)d seconds."
msgstr[0] "Չափազանց շատ փորձարկումներ են։ Կրկին փորձեք %(seconds)d վայրկյանից։"
msgstr[1] "Չափազանց շատ փորձարկումներ են։ Կրկին փորձեք %(seconds)d վայրկյանից։"

#: src/postulo/accounts/avatars.py
msgid "That is a lot of tries. Wait a little before asking again."
msgstr "Չափազանց շատ փորձեր։ Մի փոքր սպասեք, նախքան նորից խնդրելը։"

#: src/postulo/core/phones.py
#, python-format
msgid "That is a short number in %(country)s, which can only be dialled from inside the country. It is kept as it was typed, with no country in front of it."
msgstr "Սա %(country)s երկրի կարճ համար է, որը կարելի է հավաքել միայն երկրի ներսից։ Այն պահվում է այնպես, ինչպես մուտքագրվել է, առանց դիմացը երկրի կոդի։"

#: src/postulo/jobs/pages.py
#, python-format
msgid "That is larger than %(limit)s, which is the most this instance keeps."
msgstr "Սա %(limit)s-ից մեծ է, իսկ դա առավելագույնն է, որ պահում է այս տեղակայումը։"

#: src/postulo/jobs/pages.py
#, python-format
msgid "That is not a %(kind)s, whatever it was sent as."
msgstr "Սա %(kind)s չէ, անկախ նրանից, թե ինչպես է ուղարկվել։"

#: src/postulo/resume/lookups.py
msgid "That is not a DOI."
msgstr ""

#: src/postulo/core/kind_files.py
msgid "That is not a file this page reads. It reads the JSON file it offers to download for this kind of record, as Postulo writes it, and nothing else."
msgstr "Այս էջը նման ֆայլ չի կարդում։ Այն կարդում է միայն այն JSON ֆայլը, որը ինքն է առաջարկում ներբեռնել այս տեսակի գրառումների համար, այնպես, ինչպես Postulo-ն է այն գրում, և ուրիշ ոչինչ։"

#: src/postulo/resume/candidate.py
msgid "That is not a file this page reads. It reads the JSON file it offers to download — one person's own record, as Postulo writes it — and nothing else."
msgstr "Սա այն ֆայլը չէ, որը կարդում է այս էջը։ Այն կարդում է միայն այն JSON ֆայլը, որն ինքն է առաջարկում ներբեռնել՝ մեկ մարդու սեփական գրառումները, ինչպես գրում է Postulo-ն, և ուրիշ ոչինչ։"

#: src/postulo/jobs/sharing.py
msgid "That is not a kind of access."
msgstr "Դա մուտքի իրավունքի տեսակ չէ։"

#: src/postulo/jobs/surface.py
msgid "That is not a kind of company."
msgstr "Դա ընկերության տեսակ չէ։"

#: src/postulo/accounts/avatars.py
#, python-format
msgid "That is not a kind of picture Postulo keeps. Use %(formats)s."
msgstr "Postulo-ն այդ տեսակի նկարներ չի պահում։ Օգտագործեք %(formats)s։"

#: src/postulo/core/views_access.py
msgid "That is not a name this group can have."
msgstr "Այս խումբը չի կարող այդպիսի անուն ունենալ։"

#: src/postulo/core/phones.py
#, python-format
msgid "That is not a number %(country)s uses. It is one %(territory)s uses: choose %(choice)s beside the number."
msgstr "Սա %(country)s երկրում օգտագործվող համար չէ։ Այն օգտագործվում է %(territory)s տարածքում․ համարի կողքին ընտրեք %(choice)s։"

#: src/postulo/core/phones.py
#, python-format
msgid "That is not a number %(country)s uses: no number there begins that way."
msgstr "Սա %(country)s երկրում օգտագործվող համար չէ․ այնտեղ ոչ մի համար այդպես չի սկսվում։"

#: src/postulo/core/views_backups.py
#, python-format
msgid "That is not a Postulo backup that opens cleanly: %(problem)s"
msgstr "Սա Postulo-ի պահուստային պատճեն չէ, որը բացվում է առանց խնդիրների՝ %(problem)s"

#: src/postulo/jobs/surface.py
msgid "That is not a record that has been saved."
msgstr "Դա պահպանված գրառում չէ։"

#: src/postulo/core/messaging_services.py
msgid "That is not a service a handle can be on."
msgstr "Մեսենջերի անունը չի կարող լինել այդ ծառայությունում։"

#: src/postulo/core/link_services.py
msgid "That is not a service this type of link can be on."
msgstr "Այս տեսակի հղումը չի կարող լինել այդ ծառայությունում։"

#: src/postulo/applications/views.py
