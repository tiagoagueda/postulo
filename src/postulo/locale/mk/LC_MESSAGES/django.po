msgstr "„%(title)s“, споредено со верзијата испратена пред неа."

#: src/postulo/jobs/sharing.py
#, python-format
msgid "“%(what)s” is no longer shared with you"
msgstr "„%(what)s“ повеќе не е споделено со вас"

