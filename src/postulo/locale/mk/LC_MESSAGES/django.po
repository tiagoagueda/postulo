msgstr "· сè уште трае"

#: src/postulo/core/language_field.py
#, python-format
msgid "“%(code)s” is not a language code, like %(first)s or %(second)s."
msgstr "„%(code)s“ не е код на јазик, како %(first)s или %(second)s."

#: src/postulo/core/web_links.py src/postulo/jobs/surface.py
#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(kind)s” is not one of the types of link."
msgstr "„%(kind)s“ не е еден од видовите врски."

#: src/postulo/templates/partials/table/views.html
#, python-format
msgid "“%(name)s” asks for things this table no longer has, and is shown without them:"
msgstr "„%(name)s“ бара работи што оваа табела веќе ги нема и се прикажува без нив:"

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” has %(count)s row in the file."
msgid_plural "“%(name)s” has %(count)s rows in the file."
msgstr[0] "„%(name)s“ има %(count)s ред во датотеката."
msgstr[1] "„%(name)s“ има %(count)s редови во датотеката."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is gone. Anything installed from it stays installed."
msgstr "„%(name)s“ го нема. Сè што е инсталирано од него останува инсталирано."

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” is in the file, and is not written the way this page reads it."
msgstr "„%(name)s“ е во датотеката, но не е напишано како што го чита оваа страница."

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” is not a part of an entry that Postulo translates."
msgstr "„%(name)s“ не е дел од ставка што Postulo го преведува."

#: src/postulo/resume/candidate.py
#, python-format
msgid "“%(name)s” is not a part of the career that Postulo translates."
msgstr "„%(name)s“ не е дел од кариерата што Postulo го преведува."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is off. Nothing new is installed or updated from it; what was already installed goes on working."
msgstr "„%(name)s“ е исклучен. Од него не се инсталира ниту се ажурира ништо ново; тоа што е веќе инсталирано продолжува да работи."

#: src/postulo/core/server_views.py
#, python-format
msgid "“%(name)s” is on. Plugins may be installed and updated from it."
msgstr "„%(name)s“ е вклучен. Од него може да се инсталираат и ажурираат додатоци."

#: src/postulo/resume/views.py
#, python-format
msgid "“%(name)s” was added to your companies as Education."
msgstr "„%(name)s“ е додадена во вашите компании како Образование."

#: src/postulo/templates/partials/confirm_delete.html
#, python-format
msgid "“%(name)s” will be deleted permanently."
msgstr "„%(name)s“ ќе биде трајно избришан."

#: src/postulo/templates/connections/confirm_delete.html
#, python-format
msgid "“%(name)s” will be removed, and the secrets stored for it deleted."
msgstr "„%(name)s“ ќе биде отстранет, а тајните зачувани за него избришани."

#: src/postulo/templates/jobs/conflicts.html
#, python-format
msgid "“%(record)s” is shared with %(who)s, who cannot see what it points at:"
msgstr "„%(record)s“ е споделен со %(who)s, кои не можат да го видат она на што упатува:"

#: src/postulo/jobs/sharing.py
#, python-format
msgid "“%(record)s” would be shown to %(names)s, who can see “%(parent)s”; share it with them first."
msgstr "„%(record)s“ би им се прикажал на %(names)s, кои можат да го гледаат „%(parent)s“; прво споделете го со нив."

#: src/postulo/jobs/sharing.py
#, python-format
msgid "“%(target)s” is not shared with %(names)s, who can see this; share it with them first."
msgstr "„%(target)s“ не е споделено со %(names)s, кои можат да го гледаат ова; прво споделете го со нив."

#: src/postulo/resume/models.py
#, python-format
msgid "“%(title)s”"
msgstr "„%(title)s“"

#: src/postulo/templates/documents/rendered_compare.html
#, python-format
