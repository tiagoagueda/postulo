msgstr "Sivu, josta tämä luettiin, säilytettiin: sen lähde ja renderöinti."

#: src/postulo/jobs/rendering.py
#, python-format
msgid "The page was not drawn within %(seconds)s second, so it was left."
msgid_plural "The page was not drawn within %(seconds)s seconds, so it was left."
msgstr[0] "Sivua ei saatu piirrettyä %(seconds)s sekunnissa, joten siitä luovuttiin."
msgstr[1] "Sivua ei saatu piirrettyä %(seconds)s sekunnissa, joten siitä luovuttiin."

