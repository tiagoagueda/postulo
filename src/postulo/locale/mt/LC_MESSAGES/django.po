#: src/postulo/documents/models.py:273
#, draft
msgid ""
"Your name and the details chosen below, taken from your details. Unticked, this CV prints none of them."
msgstr ""
"Ismek u d-dettalji magħżula hawn taħt, meħudin mid-dettalji tiegħek. Mingħajr marka, dan is-CV ma jistampa l-ebda wieħed minnhom."

#: src/postulo/core/models.py:296 src/postulo/core/models.py:531
#, draft
msgid "Your name for it, when none of the types above fits."
msgstr "L-isem tiegħek għalih, meta ebda wieħed mit-tipi ta' fuq ma jaqbel."

