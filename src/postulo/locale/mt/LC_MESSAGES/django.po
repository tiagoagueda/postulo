msgstr ""
"Tiegħek, mhux tal-impjegatur. Il-lista tista' tiġi ordnata u mnaqqsa bih."

#: src/postulo/applications/forms.py:631
#, draft
msgid "Yours, to prepare with. Nothing here is sent to anybody."
msgstr "Tiegħek, biex tipprepara bih. Xejn hawnhekk ma jintbagħat lil ħadd."

