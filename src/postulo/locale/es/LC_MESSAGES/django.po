msgstr "Lo que dice «%(name)s», sin la maquetación: para un formulario que pide pegar el texto. Selecciónelo todo y cópielo."

#: src/postulo/templates/server/overview.html
#, python-format
msgid "Whatever it is worth to you, once or now and then, at <a href=\"%(url)s\" class=\"underline\">buymeacoffee.com/tiagoagueda</a>."
msgstr "Lo que le parezca, una vez o de vez en cuando, en <a href=\"%(url)s\" class=\"underline\">buymeacoffee.com/tiagoagueda</a>."

