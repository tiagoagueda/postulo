#: src/postulo/templates/server/maps.html
msgid "The map is drawn on OpenStreetMap's public tiles. Each viewer's browser fetches them from tile.openstreetmap.org, which learns that browser's address and the area it looks at — where that person's companies are. It is sent this instance's address as the page asking, never the page itself."
msgstr "რუკა OpenStreetMap-ის საჯარო ფილებზეა დახატული. თითოეული მნახველის ბრაუზერი მათ tile.openstreetmap.org-დან ჩამოტვირთავს, რომელიც იგებს ამ ბრაუზერის მისამართს და არეალს, რომელსაც ის უყურებს — სად არის ამ ადამიანის კომპანიები. მას ეგზავნება ამ ინსტალაციის მისამართი, როგორც მომთხოვნი გვერდისა, და არასოდეს — თავად გვერდი."

#: src/postulo/templates/server/maps.html
msgid "The map is drawn on the tiles at the address below. When it is on another server, that server learns each viewer's address and the area they look at; on this instance's own address, nothing is sent anywhere."
msgstr "რუკა ქვემოთ მოცემულ მისამართზე არსებულ ფილებზეა დახატული. როცა ის სხვა სერვერზეა, ეს სერვერი იგებს თითოეული მნახველის მისამართს და არეალს, რომელსაც ისინი უყურებენ; ამ ინსტალაციის საკუთარ მისამართზე არაფერი იგზავნება არსად."

#: src/postulo/templates/server/maps.html
msgid "The map is drawn on the world's outline, kept on this instance. Nothing is fetched from anywhere, and the map cannot show streets."
msgstr "რუკა მსოფლიოს კონტურზეა დახატული, რომელიც ამ ინსტალაციაზე ინახება. არსაიდან არაფერი ჩამოიტვირთება და რუკა ქუჩებს ვერ აჩვენებს."

#: src/postulo/templates/resume/preview.html
msgid "The master record. A CV variant selects from this; it never copies it."
msgstr "მთავარი ჩანაწერი. CV-ის ვარიანტი აქედან ირჩევს და არასოდეს აკოპირებს მას."

#: src/postulo/documents/printing.py
msgid "The messaging handle chosen for this CV is no longer in your details, so it prints none."
msgstr "ამ CV-ისთვის არჩეული მესენჯერის სახელი აღარ არის თქვენს მონაცემებში, ამიტომ არცერთი არ იბეჭდება."

#: src/postulo/templates/server/backups.html
msgid "The next backup may not fit."
msgstr "შემდეგი სარეზერვო ასლი შეიძლება ვერ დაეტიოს."

#: src/postulo/applications/widgets.py
msgid "The next interviews in the diary, and any that passed without an outcome."
msgstr "დღიურში ჩაწერილი მომდევნო გასაუბრებები და ის გასაუბრებები, რომლებიც შედეგის გარეშე ჩატარდა."

#: src/postulo/templates/accounts/profile.html
#: src/postulo/templates/jobs/partials/row_removals.html
msgid "The next one in the list becomes the primary."
msgstr "სიაში შემდეგი გახდება მთავარი."

#: src/postulo/templates/server/data_protection.html
msgid "The notice"
msgstr "შეტყობინება"

#: src/postulo/templates/partials/phone_numbers.html
msgid "The number that gets you back in is separate from the one your documents print, so changing what a recruiter dials does not change how you prove it is you. It has to be confirmed first, and switching off several telephone numbers never takes it away."
msgstr "ნომერი, რომლითაც ანგარიშში ბრუნდებით, განცალკევებულია იმ ნომრისგან, რომელიც თქვენს დოკუმენტებზე იბეჭდება, ამიტომ იმის შეცვლა, რასაც რეკრუტერი აკრეფს, არ ცვლის იმას, თუ როგორ ადასტურებთ, რომ ეს თქვენ ხართ. ის ჯერ უნდა დადასტურდეს და ტელეფონის ნომრების გამორთვა მას არასოდეს მოხსნის."

#: src/postulo/applications/models.py
msgid "The office, the remote arrangement, or the days of each."
msgstr "ოფისი, დისტანციური მოწყობა ან თითოეულის დღეები."

#: src/postulo/core/server_views.py
msgid "The official repository is emptied, not removed."
msgstr "ოფიციალური რეპოზიტორი იცლება, მაგრამ არ იშლება."

#: src/postulo/templates/applications/report.html
msgid "The one after"
msgstr "შემდეგი"

#: src/postulo/templates/applications/report.html
msgid "The one before"
msgstr "წინა"

#: src/postulo/templates/jobs/merge.html
msgid "The one chosen here is merged into the one above. The next page shows what would move, and nothing moves before it."
msgstr "აქ არჩეული შეერწყმება ზემოთ მოცემულს. შემდეგ გვერდზე ჩანს, რა გადავიდოდა, და მანამდე არაფერი გადადის."

#: src/postulo/jobs/merging.py
msgid "The one it has"
msgstr "მისი არსებული"

#: src/postulo/documents/models.py
msgid "The opening paragraph, if you use one."
msgstr "შესავალი აბზაცი, თუ იყენებთ."

#: src/postulo/resume/importing.py
#, python-format
msgid "The ORCID iD “%(value)s” is not valid, so it was not added."
msgstr "ORCID iD „%(value)s“ არასწორია, ამიტომ არ დაემატა."

#: src/postulo/templates/jobs/merge.html
msgid "The other record is deleted once everything has moved, and this cannot be undone."
msgstr "მეორე ჩანაწერი წაიშლება, როცა ყველაფერი გადავა, და ამის გაუქმება შეუძლებელია."

#: src/postulo/templates/cotton/listing_history.html
#: src/postulo/templates/jobs/capture_page.html
#: src/postulo/templates/jobs/posting_detail.html
msgid "The page as captured"
msgstr "გვერდი აღებისას"

#: src/postulo/jobs/rendering.py
msgid "The page could not be drawn."
msgstr "გვერდის გამოსახვა ვერ მოხერხდა."

#: src/postulo/accounts/forms.py
msgid "The page exactly as it was read, kept beside what was read from it, so that you can check one against the other and a better parser can read it again. It holds whatever the page addressed to you: your name if you were signed in, and the tracking in its links. Kept as text, and never shown as a page."
msgstr "გვერდი ზუსტად ისეთი, როგორიც წაკითხვისას იყო, შენახული მისგან ამოკითხულის გვერდით, რომ ერთმანეთს შეადაროთ და უკეთესმა ანალიზატორმა ხელახლა წაიკითხოს. ის შეიცავს ყველაფერს, რაც გვერდმა თქვენთვის აჩვენა: თქვენს სახელს, თუ შესული იყავით, და თვალთვალის პარამეტრებს მის ბმულებში. ინახება ტექსტად და არასოდეს ჩანს გვერდის სახით."

#: src/postulo/jobs/capture_views.py
msgid "The page it kept, its source and its picture"
msgstr "მის მიერ შენახული გვერდი, მისი კოდი და მისი სურათი"

#: src/postulo/templates/server/capture.html
#: src/postulo/templates/settings/capture.html
#, python-format
msgid "The page of a capture that never became a listing is deleted a day after it was captured. A capture that was saved keeps its page for as long as it exists."
msgid_plural "The page of a capture that never became a listing is deleted %(counter)s days after it was captured. A capture that was saved keeps its page for as long as it exists."
msgstr[0] "აღების გვერდი, რომელიც ვაკანსიად არ იქცა, აღებიდან ერთი დღის შემდეგ იშლება. შენახული აღება თავის გვერდს ინახავს მანამ, სანამ თავად არსებობს."
msgstr[1] "აღების გვერდი, რომელიც ვაკანსიად არ იქცა, აღებიდან %(counter)s დღის შემდეგ იშლება. შენახული აღება თავის გვერდს ინახავს მანამ, სანამ თავად არსებობს."

#: src/postulo/templates/jobs/capture_review.html
msgid "The page this was read from was kept: its source, and a rendering of it."
msgstr "გვერდი, საიდანაც ეს წაიკითხა, შენახულია: მისი საწყისი კოდიც და მისი გამოსახულებაც."

#: src/postulo/jobs/rendering.py
#, python-format
msgid "The page was not drawn within %(seconds)s second, so it was left."
msgid_plural "The page was not drawn within %(seconds)s seconds, so it was left."
msgstr[0] "გვერდი %(seconds)s წამში არ დაიხატა, ამიტომ შეწყდა."
msgstr[1] "გვერდი %(seconds)s წამში არ დაიხატა, ამიტომ შეწყდა."

#: src/postulo/resume/forms.py
msgid "The page you read it on. A CV does not print it."
msgstr "გვერდი, სადაც ეს წაიკითხეთ. CV მას არ ბეჭდავს."

#: src/postulo/accounts/forms.py
msgid "The paper every document is printed on"
msgstr "ქაღალდი, რომელზეც ყოველი დოკუმენტი იბეჭდება"

#: src/postulo/jobs/forms.py
msgid "The part of the economy it is in. Narrows the suggestions below, and an industry of your own added here is filed under it."
msgstr "ეკონომიკის ნაწილი, რომელშიც ის არის. ავიწროებს ქვემოთ მოცემულ შემოთავაზებებს, და აქ დამატებული თქვენი საკუთარი დარგი მის ქვეშ მოთავსდება."

#: src/postulo/jobs/forms.py
msgid "The part of the economy this industry is in. You may leave it empty."
msgstr "ეკონომიკის ნაწილი, რომელშიც ეს დარგია. შეგიძლიათ დატოვოთ ცარიელი."

#: src/postulo/templates/server/email.html
#, python-format
msgid "The password is set by <code>%(variable)s</code> in the environment; change it there. It is never shown here."
msgstr "პაროლს აყენებს <code>%(variable)s</code> გარემოში; შეცვალეთ იქ. აქ ის არასოდეს ჩანს."

#: src/postulo/applications/models.py src/postulo/jobs/models.py
msgid "The pay"
msgstr "ანაზღაურება"

#: src/postulo/resume/registry.py
msgid "The people who will vouch for you, kept as contacts. A CV prints one only once they have agreed, and never their email address or number unless you say so."
msgstr "ადამიანები, რომლებიც თქვენ შესახებ რეკომენდაციას მოგცემენ, კონტაქტებად შენახული. CV რეკომენდატორს მხოლოდ მისი თანხმობის შემდეგ ბეჭდავს, მის ელფოსტის მისამართს ან ნომერს კი — არასოდეს, თუ თავად არ მიუთითებთ."

#: src/postulo/templates/applications/calendar_print.html
msgid "The period on screen as a PDF, with every entry of every day and none of the buttons. Downloaded, and not kept in Postulo."
msgstr ""

#: src/postulo/applications/forms.py
msgid "The person at the company this went through, where there was one."
msgstr "კომპანიის ადამიანი, რომლის მეშვეობითაც ეს წავიდა, თუ ასეთი იყო."

#: src/postulo/documents/forms.py
msgid "The person who wrote it, from your contacts."
msgstr "ადამიანი, რომელმაც ის დაწერა, თქვენი კონტაქტებიდან."

#: src/postulo/documents/models.py
msgid "The person you are writing to, if the application names one"
msgstr "პირი, რომელსაც წერთ, თუ განაცხადში ის დასახელებულია"

#: src/postulo/documents/models.py
msgid "The photo from your details, beside your name. It is in the PDF and the preview; the plain text and the Word file leave it out."
msgstr "ფოტო თქვენი მონაცემებიდან, თქვენი სახელის გვერდით. ის არის PDF-სა და წინასწარ ხედში; უბრალო ტექსტი და Word-ის ფაილი მას გამოტოვებს."

#: src/postulo/core/help.py
msgid "The picture that stands for you on these pages: one you upload, your Gravatar, or your initials."
msgstr "სურათი, რომელიც ამ გვერდებზე თქვენ წარმოგადგენთ: თქვენ მიერ ატვირთული, თქვენი Gravatar ან თქვენი ინიციალები."

#: src/postulo/core/server_views.py
msgid "The plugins that ship inside Postulo. Nothing is fetched."
msgstr "მოდულები, რომლებიც Postulo-ს თან მოჰყვება. არაფერი ჩამოიტვირთება."

#: src/postulo/templates/applications/application_detail.html
#: src/postulo/templates/jobs/partials/listing_row.html
msgid "The posting"
msgstr "ვაკანსია"

#: src/postulo/templates/applications/report.html
msgid "the posting"
msgstr "ვაკანსია"

#: src/postulo/templates/applications/application_intake.html
#: src/postulo/templates/jobs/capture_review.html
#: src/postulo/templates/jobs/listing_form.html
msgid "The posting itself"
msgstr "თავად ვაკანსია"

#: src/postulo/jobs/forms.py
msgid "The posting's own address, kept so you can go back to it. Postulo reads the page when you capture it and never fetches it again."
msgstr "ვაკანსიის საკუთარი მისამართი, შენახული, რომ მას დაუბრუნდეთ. Postulo გვერდს კითხულობს მისი აღებისას და მას აღარასოდეს ჩამოტვირთავს."

#: src/postulo/plugins/consent.py
#, python-format
msgid "The provider answered %(status)s."
msgstr "პროვაიდერმა უპასუხა: %(status)s."

#: src/postulo/core/mail_auth.py
msgid "The provider sent no refresh token, so mail would stop within the hour. Check that offline access is allowed for this application."
msgstr "პროვაიდერმა განახლების ტოკენი არ გამოგზავნა, ამიტომ ფოსტა ერთ საათში შეჩერდებოდა. შეამოწმეთ, ნებადართულია თუ არა ხაზგარეშე წვდომა ამ აპლიკაციისთვის."

#: src/postulo/plugins/consent.py
msgid "The provider will not renew this. Somebody has to agree to it again."
msgstr "პროვაიდერი ამას არ განაახლებს. ვიღაცამ ხელახლა უნდა გასცეს თანხმობა."

#: src/postulo/plugins/consent.py
msgid "The provider's reply was not readable."
msgstr "პროვაიდერის პასუხი წაკითხვადი არ იყო."

#: src/postulo/plugins/consent.py
msgid "The provider's token address redirected, and Postulo does not follow it."
msgstr "პროვაიდერის ტოკენის მისამართმა სხვაგან გადაამისამართა, Postulo კი ამას არ მიჰყვება."

#: src/postulo/applications/forms.py
msgid "The public employment service you are registered with. Add it under Companies, as a public employment service, if it is not here."
msgstr "დასაქმების სახელმწიფო სამსახური, რომელშიც რეგისტრირებული ხართ. თუ აქ არ არის, დაამატეთ ის განყოფილებაში „კომპანიები“ დასაქმების სახელმწიფო სამსახურის სახით."

#: src/postulo/core/models.py
msgid "The public key every archive is encrypted to before it leaves, starting age1. Keep the identity that opens them somewhere other than this server."
msgstr "საჯარო გასაღები, რომლისთვისაც ყოველი არქივი გაგზავნამდე იშიფრება; იწყება age1-ით. პირადი გასაღები (identity), რომელიც მათ ხსნის, ამ სერვერისგან განსხვავებულ ადგილას შეინახეთ."

#: src/postulo/resume/candidate.py
msgid "The publication it counts cannot be added, so it will be a count for all of your work."
msgstr "პუბლიკაციის, რომელსაც ის ითვლის, დამატება შეუძლებელია, ამიტომ ეს იქნება რაოდენობა ყველა თქვენი ნაშრომისთვის."

#: src/postulo/resume/candidate.py
msgid "The publication it counts is not in the file, so it will be a count for all of your work."
msgstr "პუბლიკაცია, რომელსაც ის ითვლის, ფაილში არ არის, ამიტომ ეს იქნება რაოდენობა ყველა თქვენი ნაშრომისთვის."

#: src/postulo/applications/views.py
msgid "The reason was not kept: only an application that was rejected, withdrawn or ghosted has one."
msgstr "მიზეზი არ შენახულა: მიზეზი მხოლოდ უარყოფილ, გამოთხოვილ ან უპასუხოდ დარჩენილ განაცხადს აქვს."

#: src/postulo/notifications/webhooks.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "მიმღებმა უპასუხა: %(status)s."

#: src/postulo/templates/server/data_protection.html
msgid "The record of what this instance processes, and who receives it."
msgstr "ჩანაწერი იმის შესახებ, რას ამუშავებს ეს ინსტალაცია და ვინ იღებს მას."

#: src/postulo/documents/models.py
msgid "The referee sends it themselves"
msgstr "რეკომენდატორი მას თავად აგზავნის"

#: src/postulo/jobs/register_lookup.py
msgid "The register has no entry with that number."
msgstr "რეესტრში ამ ნომრით ჩანაწერი არ არის."

#: src/postulo/jobs/register_lookup.py
msgid "The register's address is not one it declared."
msgstr "რეესტრის მისამართი არ ემთხვევა მის მიერ მითითებულს."

#: src/postulo/jobs/register_lookup.py
msgid "The register's answer could not be read."
msgstr "რეესტრის პასუხის წაკითხვა ვერ მოხერხდა."

#: src/postulo/jobs/rendering.py
msgid "The renderer could not be started."
msgstr "გამოსახვის პროგრამის გაშვება ვერ მოხერხდა."

#: src/postulo/templates/jobs/capture_page.html
msgid "The rendering"
msgstr "გამოსახულება"

#: src/postulo/jobs/rendering.py
msgid "The rendering came out larger than this instance keeps."
msgstr "გამოსახულება იმაზე დიდი გამოვიდა, ვიდრე ეს ინსტალაცია ინახავს."

#: src/postulo/templates/jobs/capture_page_forget.html
#, python-format
msgid "The rendering kept of the page that “%(title)s” was read from will be deleted permanently."
msgstr "იმ გვერდის შენახული გამოსახულება, საიდანაც „%(title)s“ წაიკითხეს, სამუდამოდ წაიშლება."

#: src/postulo/templates/jobs/capture_page.html
msgid "The rendering, in a box that scrolls"
msgstr "გამოსახულება, გადახვევად არეში"

#: src/postulo/jobs/pages.py
msgid "The request did not say how large the rendering is."
msgstr "მოთხოვნაში არ იყო მითითებული გამოსახულების ზომა."

#: src/postulo/api/problems.py
#, python-format
msgid "The request is larger than %(limit)s, which is the most this call reads."
msgstr "მოთხოვნა აღემატება %(limit)s ზღვარს — მაქსიმუმს, რასაც ეს გამოძახება კითხულობს."

#: src/postulo/api/problems.py
msgid "The request was not in the shape this call takes."
msgstr "მოთხოვნა არ იყო ისეთი ფორმის, როგორსაც ეს გამოძახება იღებს."

#: src/postulo/templates/resume/europass_import.html
msgid "The rest of the file is still worth importing. What is listed here is not, and you can add it by hand afterwards."
msgstr "ფაილის დანარჩენი ნაწილის იმპორტი მაინც ღირს. აქ ჩამოთვლილისა — არა, და მისი დამატება შემდეგ ხელით შეგიძლიათ."

#: src/postulo/templates/applications/application_intake.html
#: src/postulo/templates/jobs/capture_review.html
#: src/postulo/templates/jobs/listing_form.html
msgid "The role"
msgstr "პოზიცია"

#: src/postulo/applications/forms.py
msgid "The route it went through. The report counts by this, including how many went through the public employment service's own board."
msgstr "გზა, რომლითაც ის წავიდა. ანგარიშგება ამის მიხედვით ითვლის, მათ შორის რამდენი წავიდა დასაქმების სახელმწიფო სამსახურის საკუთარი ვაკანსიების საიტით."

#: src/postulo/jobs/conflicts.py
msgid "The same advert"
msgstr "იგივე განცხადება"

#: src/postulo/templates/jobs/capture_review.html
msgid "The same advert on another board is evidence about the job. Adding this capture to a listing's history keeps it, with any page it kept, and makes no second listing."
msgstr "იგივე ვაკანსია სხვა ვაკანსიების საიტზე ამ სამუშაოს შესახებ მტკიცებულებაა. ამ აღების ვაკანსიის ისტორიაში დამატება მას ინახავს, მის მიერ შენახულ გვერდთან ერთად, და მეორე ვაკანსიას არ ქმნის."

#: src/postulo/jobs/conflicts.py
msgid "The same email address"
msgstr "იგივე ელფოსტის მისამართი"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same email address: %(email)s"
msgstr "იგივე ელფოსტის მისამართი: %(email)s"

#: src/postulo/templates/documents/cv_detail.html
msgid "The same entries without the layout, in this document's language. None of these is filed as a version you sent."
msgstr "იგივე ჩანაწერები განლაგების გარეშე, ამ დოკუმენტის ენაზე. არცერთი მათგანი არ ინახება როგორც თქვენ მიერ გაგზავნილი ვერსია."

#: src/postulo/applications/widgets.py
msgid "The same figures by sector, and by industry within each. A company in three fields counts in all three."
msgstr "იგივე მაჩვენებლები სექტორის მიხედვით, ხოლო თითოეულ მათგანში — დარგის მიხედვით. სამ სფეროში მოქმედი კომპანია სამივეში ითვლება."

#: src/postulo/jobs/conflicts.py
msgid "The same identifier"
msgstr "იგივე იდენტიფიკატორი"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same identifier: %(identifier)s"
msgstr "იგივე იდენტიფიკატორი: %(identifier)s"

#: src/postulo/jobs/conflicts.py src/postulo/jobs/duplicates.py
msgid "The same name"
msgstr "იგივე სახელი"

#: src/postulo/jobs/duplicates.py
msgid "The same name, once the legal form is set aside"
msgstr "იგივე სახელი, სამართლებრივი ფორმის გაუთვალისწინებლად"

#: src/postulo/templates/jobs/conflicts.html
msgid "The same thing twice"
msgstr "ერთი და იგივე ორჯერ"

#: src/postulo/jobs/duplicates.py
#, python-format
msgid "The same website: %(domain)s"
msgstr "იგივე ვებგვერდი: %(domain)s"

#: src/postulo/templates/server/overview.html
msgid "The scheduler asks once a day; run manage.py check_for_updates to ask now."
msgstr "დამგეგმავი დღეში ერთხელ ამოწმებს; ახლავე შესამოწმებლად გაუშვით manage.py check_for_updates."

#: src/postulo/core/server_forms.py
msgid "The schemes were not sent with this request, so nothing was changed. To define none, empty the box and save."
msgstr "სქემები ამ მოთხოვნით არ გაიგზავნა, ამიტომ არაფერი შეცვლილა. არცერთის განსასაზღვრად დააცარიელეთ ველი და შეინახეთ."

#: src/postulo/applications/widgets.py
msgid "The search in four numbers"
msgstr "ძიება ოთხ რიცხვში"

#: src/postulo/templates/server/design.html
msgid "The second"
msgstr "მეორე"

#: src/postulo/resume/forms.py
msgid "The series it belongs to, if any."
msgstr "სერია, რომელსაც ეკუთვნის, თუ ასეთი არსებობს."

#: src/postulo/core/mail.py
msgid "The server does not offer STARTTLS. Turn it off, or use a port that does."
msgstr "სერვერს STARTTLS-ის მხარდაჭერა არ აქვს. გამორთეთ ის ან გამოიყენეთ პორტი, რომელიც მას უჭერს მხარს."

#: src/postulo/core/mail.py
#, python-format
msgid "The server refused those credentials: %(detail)s"
msgstr "სერვერმა ეს ავტორიზაციის მონაცემები უარყო: %(detail)s"

#: src/postulo/core/server_forms.py
msgid "The server that accepts the mail — its name, not an address."
msgstr "სერვერი, რომელიც ფოსტას იღებს — მისი სახელი და არა მისამართი."

#: src/postulo/core/server_forms.py
msgid "The service's base address. Left empty with Nominatim, OpenStreetMap's public instance is used: https://nominatim.openstreetmap.org. For your own: for example https://photon.example.org"
msgstr "სერვისის საბაზო მისამართი. თუ Nominatim-ისთვის ცარიელი დარჩა, გამოიყენება OpenStreetMap-ის საჯარო სერვერი: https://nominatim.openstreetmap.org. საკუთარისთვის: მაგალითად, https://photon.example.org"

#: src/postulo/plugins/fetching.py
msgid "The site asked us to slow down (429). Try again in a few minutes."
msgstr "საიტმა შენელება გვთხოვა (429). სცადეთ რამდენიმე წუთში."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "The site is having trouble (%(status)s). That is their end, not yours."
msgstr "საიტს პრობლემა აქვს (%(status)s). ეს მათი მხარის პრობლემაა და არა თქვენი."

#: src/postulo/plugins/fetching.py
msgid "The site redirected without saying where to."
msgstr "საიტმა გადაამისამართა და არ თქვა, სად."

#: src/postulo/plugins/fetching.py
#, python-format
msgid "The site refused the request (%(status)s). Large sites often sit behind bot protection that turns away anything that is not a browser, even when the page is perfectly visible to you. Paste the page source in below instead."
msgstr "საიტმა მოთხოვნა უარყო (%(status)s). დიდი საიტები ხშირად ბოტებისგან დაცვის მიღმაა, რომელიც უარყოფს ყველაფერს, რაც ბრაუზერი არ არის, მაშინაც კი, როცა გვერდი თქვენთვის სრულიად ხილულია. ამის ნაცვლად ქვემოთ ჩასვით გვერდის საწყისი კოდი."

#: src/postulo/templates/jobs/capture_form.html
msgid "The site refuses Postulo, or the posting needs a login"
msgstr "საიტი Postulo-ს უარყოფს, ან ვაკანსია შესვლას მოითხოვს"

#: src/postulo/templates/jobs/capture_form.html
msgid "The site's robots.txt is honoured."
msgstr "საიტის robots.txt-ის წესები დაცულია."

#: src/postulo/templates/server/design.html
msgid "The smallest size, for a label beside something."
msgstr "ყველაზე პატარა ზომა, რაიმეს გვერდით წარწერისთვის."

#: src/postulo/documents/printing.py
msgid "The social profile chosen for this CV is no longer in your details, so it prints none."
msgstr "ამ CV-ისთვის არჩეული სოციალური პროფილი აღარ არის თქვენს მონაცემებში, ამიტომ არცერთი არ იბეჭდება."

#: src/postulo/resume/forms.py
msgid "The sort of event. “Not stated” prints nothing."
msgstr "ღონისძიების სახე. „მითითებული არ არის“ არაფერს ბეჭდავს."

#: src/postulo/templates/jobs/capture_page.html
msgid "The source"
msgstr "საწყისი კოდი"

#: src/postulo/templates/server/capture.html
msgid "The source is a stranger's markup. It is kept as text, shown as text and downloaded as text, and never drawn as a page."
msgstr "საწყისი კოდი უცნობის მარკირებაა. ის ინახება ტექსტად, ნაჩვენებია ტექსტად და ჩამოიტვირთება ტექსტად, და გვერდად არასოდეს გამოისახება."

#: src/postulo/templates/jobs/capture_page_forget.html
#, python-format
msgid "The source kept of the page that “%(title)s” was read from will be deleted permanently."
msgstr "იმ გვერდის შენახული საწყისი კოდი, საიდანაც „%(title)s“ წაიკითხეს, სამუდამოდ წაიშლება."

#: src/postulo/jobs/pages.py
msgid "The source of the page could not be kept."
msgstr "გვერდის საწყისი კოდის შენახვა ვერ მოხერხდა."

#: src/postulo/templates/jobs/capture_review.html
msgid "The source of the page this was read from was kept."
msgstr "შენახულია იმ გვერდის საწყისი კოდი, საიდანაც ეს წაიკითხა."

#: src/postulo/jobs/pages.py
#, python-format
msgid "The source of the page was not kept. %(why)s"
msgstr "გვერდის საწყისი კოდი არ შენახულა. %(why)s"

#: src/postulo/templates/jobs/capture_page.html
msgid "The source, as text"
msgstr "საწყისი კოდი, ტექსტად"

#: src/postulo/core/csv_import.py
msgid "The spreadsheet gave a status but no date, so this application is not counted in figures measured from the date it was sent. Set it on the application to include it."
msgstr "ელცხრილში სტატუსი მითითებულია, თარიღი კი — არა, ამიტომ ეს განაცხადი არ ითვლება გაგზავნის თარიღიდან გაზომილ მაჩვენებლებში. რომ ჩაითვალოს, თარიღი განაცხადზე მიუთითეთ."

#: src/postulo/applications/widgets.py
msgid "The stage each application had reached when it was rejected, withdrawn or ghosted, and the reason where one was given."
msgstr "ეტაპი, რომელსაც თითოეულმა განაცხადმა მიაღწია, როცა უარყოფილი, გამოთხოვილი ან უპასუხოდ დარჩენილი აღმოჩნდა, და მიზეზი, თუ ის მითითებული იყო."

#: src/postulo/templates/widgets/endings.html
msgid "The stage is read from each timeline: where the application stood when it ended."
msgstr "ეტაპი თითოეული ქრონოლოგიიდან იკითხება: სად იდგა განაცხადი, როცა დასრულდა."

#: src/postulo/templates/help/identifiers.html
msgid "The star at the start of a row marks your primary identifier. A CV prints it first, and alone where its template has room for only one. Removing it hands the star to the next row."
msgstr "ვარსკვლავი სტრიქონის დასაწყისში აღნიშნავს თქვენს ძირითად იდენტიფიკატორს. CV მას პირველს ბეჭდავს, ხოლო მხოლოდ მას — თუ მის შაბლონში მხოლოდ ერთისთვისაა ადგილი. მისი წაშლისას ვარსკვლავი შემდეგ სტრიქონს გადაეცემა."

#: src/postulo/applications/forms.py
msgid "The start date they proposed, if one was."
msgstr "დაწყების თარიღი, რომელიც მათ შემოგთავაზეს, თუ ასეთი იყო."

#: src/postulo/core/mail_auth.py
msgid "The stored mail credentials cannot be read on this instance."
msgstr "შენახული საფოსტო მონაცემების წაკითხვა ამ ინსტალაციაზე შეუძლებელია."

#: src/postulo/accounts/forms.py
msgid "The subject every file carries"
msgstr "თემა, რომელსაც ყოველი ფაილი შეიცავს"

#: src/postulo/documents/forms.py
msgid "The subject has to be one line."
msgstr "თემა ერთ სტრიქონზე უნდა იყოს."

#: src/postulo/templates/settings/appearance.html
msgid "The switch at the top right cycles through the same three; this is the explicit version."
msgstr "ზედა მარჯვენა კუთხის გადამრთველი იმავე სამ ვარიანტს შორის გადართავს; ეს მისი აშკარა ვერსიაა."

#: src/postulo/core/views_tables.py
msgid "The table opens plain again."
msgstr "ცხრილი კვლავ ჩვეულებრივი სახით იხსნება."

#: src/postulo/templates/help/listings.html
msgid "The tabs sort them by where they stand, and the search box over the table narrows what is listed. Columns and filters can be chosen and kept as a saved view."
msgstr "ჩანართები მათ მდგომარეობის მიხედვით ალაგებს, ხოლო ცხრილის ზემოთ ძიების ველი ჩამოთვლილს ავიწროებს. სვეტებისა და ფილტრების არჩევა და შენახულ ხედად შენახვა შეიძლება."

#: src/postulo/templates/server/design.html
msgid "The tag palette"
msgstr "იარლიყების პალიტრა"

#: src/postulo/jobs/forms.py
msgid "The team they are in, if you know it. A new name joins the company's list."
msgstr "გუნდი, რომელშიც ის მუშაობს, თუ იცით. ახალი სახელი კომპანიის სიას დაემატება."

#: src/postulo/documents/printing.py
msgid "The telephone number chosen for this CV is no longer in your details, so it prints none."
msgstr "ამ CV-ისთვის არჩეული ტელეფონის ნომერი აღარ არის თქვენს მონაცემებში, ამიტომ არცერთი არ იბეჭდება."

#: src/postulo/resume/importing.py
#, python-format
msgid "The telephone number of %(name)s was not added."
msgstr "%(name)s-ის ტელეფონის ნომერი არ დაემატა."

#: src/postulo/core/views_backups.py
