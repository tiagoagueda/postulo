#: src/postulo/templates/accounts/profile.html
#, python-format
msgid "One more number is kept and not shown, because <em>Several telephone numbers</em> is switched off. It comes back untouched if it is switched on."
msgid_plural "%(counter)s more numbers are kept and not shown, because <em>Several telephone numbers</em> is switched off. They come back untouched if it is switched on."
msgstr[0] "კიდევ ერთი ნომერი ინახება და არ ჩანს, რადგან <em>რამდენიმე ტელეფონის ნომერი</em> გამორთულია. ის უცვლელად დაბრუნდება, თუ ეს ფუნქცია ჩაირთვება."
msgstr[1] "კიდევ %(counter)s ნომერი ინახება და არ ჩანს, რადგან <em>რამდენიმე ტელეფონის ნომერი</em> გამორთულია. ისინი უცვლელად დაბრუნდება, თუ ეს ფუნქცია ჩაირთვება."

#: src/postulo/templates/jobs/contact_form.html
#, python-format
msgid "One more number is kept for this contact and not shown, because <em>Several telephone numbers</em> is switched off."
msgid_plural "%(counter)s more numbers are kept for this contact and not shown, because <em>Several telephone numbers</em> is switched off."
msgstr[0] "კიდევ ერთი ნომერი ინახება ამ კონტაქტისთვის და არ ჩანს, რადგან <em>რამდენიმე ტელეფონის ნომერი</em> გამორთულია."
msgstr[1] "კიდევ %(counter)s ნომერი ინახება ამ კონტაქტისთვის და არ ჩანს, რადგან <em>რამდენიმე ტელეფონის ნომერი</em> გამორთულია."

#: src/postulo/resume/forms.py
