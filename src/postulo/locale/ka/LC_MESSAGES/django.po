#: src/postulo/templates/server/email.html
#, python-format
msgid "One setting below is stored here and overridden by the environment. Remove that variable and the stored value takes over, without anybody editing anything."
msgid_plural "%(counter)s of the settings below are stored here and overridden by the environment. Remove those variables and the stored values take over, without anybody editing anything."
msgstr[0] "ქვემოთ მოცემული ერთი პარამეტრი აქ ინახება, მაგრამ მას გარემოს ცვლადი გადაფარავს. მოხსენით ეს ცვლადი და ძალაში შევა შენახული მნიშვნელობა, ისე, რომ არავის არაფრის რედაქტირება არ მოუწევს."
msgstr[1] "ქვემოთ მოცემული %(counter)s პარამეტრი აქ ინახება, მაგრამ მათ გარემოს ცვლადები გადაფარავს. მოხსენით ეს ცვლადები და ძალაში შევა შენახული მნიშვნელობები, ისე, რომ არავის არაფრის რედაქტირება არ მოუწევს."

#: src/postulo/templates/applications/partials/board.html
#, python-format
msgid "One settled application matches these filters. The board shows only what is still live; <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">see it in the table</a>."
msgid_plural "%(counter)s settled applications match these filters. The board shows only what is still live; <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">see them in the table</a>."
msgstr[0] "ერთი დასრულებული განაცხადი ემთხვევა ამ ფილტრებს. დაფა მხოლოდ მიმდინარე განაცხადებს აჩვენებს; <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">ნახეთ ის ცხრილში</a>."
msgstr[1] "%(counter)s დასრულებული განაცხადი ემთხვევა ამ ფილტრებს. დაფა მხოლოდ მიმდინარე განაცხადებს აჩვენებს; <a href=\"%(url)s\" class=\"text-brand-600 underline dark:text-brand-400\">ნახეთ ისინი ცხრილში</a>."

#: src/postulo/templates/applications/interview_form.html
msgid "One that has already happened is recorded straight onto the timeline as held."
msgstr "უკვე გამართული გასაუბრება პირდაპირ ქრონოლოგიაში აღირიცხება, როგორც ჩატარებული."

#: src/postulo/templates/api/token_list.html
