#: src/postulo/core/phone_numbers.py
#, python-format
msgid "You have been told about a lot of numbers already recorded here. That answer is available again in %(minutes)d minute."
msgid_plural "You have been told about a lot of numbers already recorded here. That answer is available again in %(minutes)d minutes."
msgstr[0] "აქ უკვე აღრიცხული ბევრი ნომრის შესახებ უკვე გეცნობათ. ეს პასუხი ხელახლა ხელმისაწვდომი იქნება %(minutes)d წუთში."
msgstr[1] "აქ უკვე აღრიცხული ბევრი ნომრის შესახებ უკვე გეცნობათ. ეს პასუხი ხელახლა ხელმისაწვდომი იქნება %(minutes)d წუთში."

#: src/postulo/resume/views.py
