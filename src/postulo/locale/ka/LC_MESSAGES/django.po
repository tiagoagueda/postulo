#: src/postulo/resume/forms.py
msgid "One name per line, as you would write it: “Knuth, Donald E.”."
msgstr "თითო სახელი თითო სტრიქონზე, ისე, როგორც დაწერდით: „Knuth, Donald E.“."

#: src/postulo/templates/server/design.html
msgid "One nobody may change"
msgstr "ერთი, რომლის შეცვლაც არავის შეუძლია"

#: src/postulo/templates/server/design.html
msgid "One of a few"
msgstr "ერთი რამდენიმედან"

#: src/postulo/templates/server/design.html
msgid "One of a list. Without scripts it is the browser's own select; with them, a button and a list whose options can hold a flag or an icon."
msgstr "ერთი სიიდან. სკრიპტების გარეშე ეს ბრაუზერის საკუთარი ჩამოსაშლელი სიაა; სკრიპტებით — ღილაკი და სია, რომლის ვარიანტებს შეიძლება ჰქონდეს დროშა ან ხატულა."

#: src/postulo/documents/views.py
msgid "One of the files you chose could not be read, so nothing was sent."
msgstr "თქვენ მიერ არჩეული ერთ-ერთი ფაილის წაკითხვა ვერ მოხერხდა, ამიტომ არაფერი გაიგზავნა."

#: src/postulo/templates/documents/rendered_compare.html
msgid "One of these was frozen before Postulo kept the words of a document beside its PDF, so they cannot be compared line by line. Both can still be downloaded."
msgstr "ერთ-ერთი მათგანი გაიყინა მანამ, სანამ Postulo დოკუმენტის სიტყვებს მის PDF-თან ერთად შეინახავდა, ამიტომ მათი სტრიქონ-სტრიქონ შედარება შეუძლებელია. ორივეს ჩამოტვირთვა მაინც შეიძლება."

#: src/postulo/resume/forms.py
msgid "One of your contacts. Their name, role, company and how to reach them are kept on the contact’s page; a person who is not a contact yet is added there."
msgstr "ერთ-ერთი თქვენი კონტაქტი. მისი სახელი, პოზიცია, კომპანია და დაკავშირების გზები კონტაქტის გვერდზე ინახება; ადამიანი, რომელიც ჯერ კონტაქტი არ არის, იქ დაემატება."

#: src/postulo/templates/jobs/capture_form.html
msgid "One page is fetched — the one you pasted. Postulo never crawls."
msgstr "ჩამოიტვირთება ერთი გვერდი — ის, რომელიც ჩასვით. Postulo საიტებს არასოდეს ათვალიერებს ავტომატურად."

#: src/postulo/templates/server/capture.html
msgid "One page per request, public addresses only, never a crawl. These are fixed."
msgstr "ერთი გვერდი თითო მოთხოვნაზე, მხოლოდ საჯარო მისამართები, არასოდეს ავტომატური დათვალიერება. ეს უცვლელია."

#: src/postulo/templates/server/capture.html
#, python-format
msgid "One page, %(weight)s"
msgid_plural "%(counter)s pages, %(weight)s"
msgstr[0] "ერთი გვერდი, %(weight)s"
msgstr[1] "%(counter)s გვერდი, %(weight)s"

#: src/postulo/templates/settings/capture.html
#, python-format
msgid "One page, weighing %(weight)s of the %(room)s this instance keeps for one account."
msgid_plural "%(counter)s pages, weighing %(weight)s of the %(room)s this instance keeps for one account."
msgstr[0] "ერთი გვერდი, მოცულობით %(weight)s; ეს ინსტალაცია ერთ ანგარიშს უთმობს: %(room)s."
msgstr[1] "%(counter)s გვერდი, მოცულობით %(weight)s; ეს ინსტალაცია ერთ ანგარიშს უთმობს: %(room)s."

#: src/postulo/templates/settings/account.html
#, python-format
msgid "One passkey on this account. It signs you in with a fingerprint, your face or a PIN, and there is no password to leak."
msgid_plural "%(total)s passkeys on this account. They sign you in with a fingerprint, your face or a PIN, and there is no password to leak."
msgstr[0] "ამ ანგარიშზე ერთი წვდომის გასაღებია. ის შესვლის საშუალებას გაძლევთ თითის ანაბეჭდით, სახით ან PIN-ით, და გასაჟონი პაროლი არ არსებობს."
msgstr[1] "ამ ანგარიშზე %(total)s წვდომის გასაღებია. ისინი შესვლის საშუალებას გაძლევთ თითის ანაბეჭდით, სახით ან PIN-ით, და გასაჟონი პაროლი არ არსებობს."

#: src/postulo/resume/forms.py
msgid "One per line. A CV prints them as bullets."
msgstr "თითო სტრიქონზე თითო. CV-ში ისინი პუნქტებად იბეჭდება."

#: src/postulo/core/views_kind_files.py
#, python-format
msgid "One record was added. Nothing you already had was changed or removed."
msgid_plural "%(total)s records were added. Nothing you already had was changed or removed."
msgstr[0] "დაემატა ერთი ჩანაწერი. არაფერი, რაც უკვე გქონდათ, არ შეცვლილა და არ მოხსნილა."
msgstr[1] "დაემატა %(total)s ჩანაწერი. არაფერი, რაც უკვე გქონდათ, არ შეცვლილა და არ მოხსნილა."

#: src/postulo/templates/jobs/company_detail.html
msgid "One request to that register, carrying the number alone; nothing is kept until you say so."
msgstr "ერთი მოთხოვნა ამ რეესტრში, მხოლოდ ნომრით; არაფერი შეინახება, სანამ არ დაადასტურებთ."

#: src/postulo/templates/jobs/company_form.html
msgid "One request to www.wikidata.org for this company's item; nothing is kept until you say so."
msgstr "ერთი მოთხოვნა www.wikidata.org-ზე ამ კომპანიის ელემენტისთვის; არაფერი ინახება, სანამ თქვენ არ იტყვით."

#: src/postulo/templates/help/postal_addresses.html
msgid "One row for each address you want to keep. <em>Kind</em> says which it is and can be left blank. Choose <em>Other</em> and a box asks what to call it."
msgstr "თითო სტრიქონი თითოეული მისამართისთვის, რომლის შენახვაც გსურთ. <em>სახეობა</em> მიუთითებს, რომელია, და შეიძლება ცარიელი დარჩეს. აირჩიეთ <em>სხვა</em> და გამოჩნდება ველი, სადაც მიუთითებთ, რა დაარქვათ."

#: src/postulo/templates/help/telephone_numbers.html
msgid "One row for each number. A new number goes in the empty row at the end of the list: saving the page adds it and offers another empty row."
msgstr "თითო სტრიქონი თითოეული ნომრისთვის. ახალი ნომერი იწერება სიის ბოლოს ცარიელ სტრიქონში: გვერდის შენახვა მას ამატებს და კიდევ ერთ ცარიელ სტრიქონს გთავაზობთ."

#: src/postulo/core/kind_files.py
