#: src/postulo/jobs/surface.py
msgid "A company needs a name."
msgstr "კომპანიას სახელი სჭირდება."

#: src/postulo/templates/jobs/company_map.html
msgid "A company with addresses in several places is counted at each, so the counts add up to more than the companies there are."
msgstr "კომპანია, რომელსაც რამდენიმე ადგილას აქვს მისამართი, თითოეულში ითვლება, ამიტომ ჯამი იქ არსებულ კომპანიებზე მეტია."

#: src/postulo/core/kind_files.py
msgid "A company with the same identifier is already yours."
msgstr "იმავე იდენტიფიკატორის მქონე კომპანია უკვე გაქვთ."

#: src/postulo/api/routers/companies.py src/postulo/jobs/surface.py
msgid "A company's links are its social profiles."
msgstr "კომპანიის ბმულები მისი სოციალური პროფილებია."

#: src/postulo/templates/core/search.html
msgid "A company, a role, a phrase from a letter, a name…"
msgstr "კომპანია, პოზიცია, წინადადება წერილიდან, სახელი…"

#: src/postulo/templates/server/design.html
msgid "A confirmation asks one question and says what answering it does. Here, nothing."
msgstr "დადასტურება სვამს ერთ კითხვას და ამბობს, რას გამოიწვევს პასუხი. აქ — არაფერს."

#: src/postulo/jobs/vcards.py
#, python-format
msgid "A contact at %(company)s"
msgstr "კონტაქტი კომპანიაში %(company)s"

#: src/postulo/jobs/vcards.py
#, python-format
msgid "A contact at %(company)s, in %(department)s"
msgstr "კონტაქტი კომპანიაში %(company)s, განყოფილებაში %(department)s"

#: src/postulo/jobs/vcards.py
msgid "A contact at no company"
msgstr "კონტაქტი კომპანიის გარეშე"

#: src/postulo/core/messaging_handles.py
#, python-format
msgid "A contact has at most %(max)s messaging handles."
msgstr "კონტაქტს მაქსიმუმ %(max)s მესენჯერის სახელი შეიძლება ჰქონდეს."

#: src/postulo/jobs/surface.py
msgid "A contact needs a name."
msgstr "კონტაქტს სახელი სჭირდება."

#: src/postulo/templates/server/design.html
msgid "A country and a number in one group"
msgstr "ქვეყანა და ნომერი ერთ ჯგუფში"

#: src/postulo/templates/server/backups.html
msgid "A cron line on the host still works the same way and is described on the wiki page about backups."
msgstr "cron-ის სტრიქონი ჰოსტზე კვლავ ისევე მუშაობს და აღწერილია ვიკის გვერდზე სარეზერვო ასლების შესახებ."

#: src/postulo/templates/core/import_csv.html
msgid "A CSV file"
msgstr "CSV ფაილი"

#: src/postulo/templates/core/table_export.html
#, python-format
msgid "A CSV holds the first %(limit)s."
msgstr ""

#: src/postulo/documents/forms.py
msgid "A CV leads with a career, a portfolio with work. It decides which themes are offered below."
msgstr "CV-ში წინა პლანზეა კარიერა, პორტფოლიოში — ნამუშევრები. ამაზეა დამოკიდებული, რომელ თემებს შემოგთავაზებთ ქვემოთ."

#: src/postulo/templates/help/documents.html
msgid "A CV or a letter can be downloaded as the formats this instance offers, previewed beside its controls, and compared with an earlier version that was sent."
msgstr "CV-ის ან წერილის ჩამოტვირთვა შეიძლება იმ ფორმატებში, რომლებსაც ეს ინსტალაცია გთავაზობთ, წინასწარი ნახვა — მართვის ელემენტების გვერდით, და შედარება — ადრე გაგზავნილ ვერსიასთან."

#: src/postulo/templates/help/cv_photo.html
msgid "A CV photo is a photograph for your CVs, kept apart from your picture above: the picture stands for you on these pages, and the CV photo is only ever printed on a CV."
msgstr "CV-ის ფოტო არის ფოტოსურათი თქვენი CV-ებისთვის, რომელიც ზემოთ მოცემული სურათისგან ცალკე ინახება: სურათი ამ გვერდებზე თქვენ წარმოგადგენთ, CV-ის ფოტო კი მხოლოდ CV-ზე იბეჭდება."

#: src/postulo/templates/accounts/profile.html
msgid "A CV photo is kept."
msgstr "CV-ის ფოტო შენახულია."

#: src/postulo/templates/resume/overview.html
msgid "A CV prints a skill under its group. Open one to choose it."
msgstr "CV უნარს მისი ჯგუფის ქვეშ ბეჭდავს. ასარჩევად გახსენით ერთ-ერთი."

#: src/postulo/resume/forms.py
msgid "A CV prints only the year, so the day makes no difference."
msgstr "CV-ში მხოლოდ წელი იბეჭდება, ამიტომ დღეს მნიშვნელობა არ აქვს."

#: src/postulo/resume/forms.py
msgid "A CV prints the month and the year, so the day makes no difference."
msgstr "CV-ში იბეჭდება თვე და წელი, ამიტომ დღეს მნიშვნელობა არ აქვს."

#: src/postulo/templates/help/cv_photo.html
msgid "A CV prints the photo only when you tick that on the CV. The plain text and the Word file never carry it. Tick <em>Remove the CV photo</em> and save to take it away."
msgstr "CV ფოტოს მხოლოდ მაშინ ბეჭდავს, როცა ამას CV-ში მონიშნავთ. უბრალო ტექსტი და Word-ის ფაილი მას არასოდეს შეიცავს. მის მოსაშორებლად მონიშნეთ <em>CV-ის ფოტოს მოხსნა</em> და შეინახეთ."

#: src/postulo/templates/help/identifiers.html
msgid "A CV prints your identifiers in its contact block: all of them, the ones you tick for it, or none, as its own <em>Settings</em> say. The bin removes a row at once, after asking, and its kind can then be chosen again."
msgstr "CV თქვენს იდენტიფიკატორებს საკონტაქტო ბლოკში ბეჭდავს: ყველას, მისთვის მონიშნულებს ან არცერთს, როგორც მისივე <em>პარამეტრებშია</em> მითითებული. ურნა სტრიქონს მაშინვე მოხსნის, შეკითხვის შემდეგ, და მისი სახეობის არჩევა შემდეგ ხელახლა შეიძლება."

#: src/postulo/core/gdpr.py
msgid "A CV that was already sent keeps them, as it was sent."
msgstr "უკვე გაგზავნილი CV მათ ინახავს, ისე, როგორც გაიგზავნა."

#: src/postulo/core/personal.py
msgid "A date of birth cannot be in the future."
msgstr "დაბადების თარიღი მომავალში ვერ იქნება."

#: src/postulo/core/personal.py
#, python-format
msgid "A date of birth is not before %(year)s."
msgstr "დაბადების თარიღი %(year)s წლამდე ვერ იქნება."

#: src/postulo/core/design.py
msgid "A deep blue. Ten steps, of which the interface spends a handful."
msgstr "მუქი ლურჯი. ათი საფეხური, რომელთაგან ინტერფეისი რამდენიმეს იყენებს."

#: src/postulo/jobs/surface.py
msgid "A department needs a name."
msgstr "განყოფილებას სახელი სჭირდება."

#: src/postulo/core/server_forms.py
msgid "A destination needs an age recipient to encrypt to: nothing leaves this server unencrypted."
msgstr "დანიშნულების ადგილს სჭირდება age-ის მიმღები, რომლისთვისაც დაიშიფრება: ამ სერვერს არაფერი ტოვებს დაუშიფრავად."

#: src/postulo/accounts/forms.py
msgid "A document has none of its own, so it starts empty."
msgstr "დოკუმენტს საკუთარი არ აქვს, ამიტომ თავიდან ცარიელია."

#: src/postulo/templates/server/overview.html
msgid "A document in a script shown in red is set in the server's fonts instead."
msgstr "დოკუმენტი, რომლის დამწერლობაც წითლადაა ნაჩვენები, სანაცვლოდ სერვერის შრიფტებით აიწყობა."

#: src/postulo/resume/publications.py
msgid "A DOI looks like 10.1000/182: “10.”, a number, a slash and the rest."
msgstr "DOI ასე გამოიყურება: 10.1000/182 — „10.“, რიცხვი, დახრილი ხაზი და დანარჩენი."

#: src/postulo/templates/documents/letter_detail.html
msgid "A draft is kept nowhere, and marks whatever it has nothing to fill in. A letter is filed when you record what you sent with an application."
msgstr "მონახაზი არსად ინახება და მონიშნავს ყველაფერს, რისი შესავსებიც მონაცემები არ აქვს. წერილი ინახება, როცა განაცხადთან ერთად აღრიცხავთ, რა გაგზავნეთ."

#: src/postulo/resume/candidate.py
msgid "A driving licence"
msgstr "მართვის მოწმობა"

#: src/postulo/documents/integrity.py
msgid "a European Digital Credential"
msgstr ""

#: src/postulo/documents/forms.py
msgid "A European Digital Credential is kept as a certificate, a diploma or a diploma supplement."
msgstr ""

#: src/postulo/documents/properties.py
msgid "A few words a search of your own files could use, separated by commas. Stuffing them does not help with applicant tracking software, and can count against an application."
msgstr "რამდენიმე სიტყვა, მძიმეებით გამოყოფილი, რომლითაც თქვენი საკუთარი ფაილების ძიება ისარგებლებს. მათი ჭარბად ჩაყრა კანდიდატების აღრიცხვის პროგრამებთან არ გეხმარებათ და განაცხადს შეიძლება ზიანიც მიაყენოს."

#: src/postulo/resume/forms.py
msgid "A few words about it, where the title does not say enough."
msgstr "რამდენიმე სიტყვა მის შესახებ, თუ სათაური საკმარისად არ ამბობს."

#: src/postulo/templates/server/design.html
msgid "A field nobody may change"
msgstr "ველი, რომლის შეცვლაც არავის შეუძლია"

#: src/postulo/templates/server/design.html
msgid "A field that was refused"
msgstr "უარყოფილი ველი"

#: src/postulo/templates/server/design.html
msgid "A field whose help is a tooltip"
msgstr "ველი, რომლის დახმარებაც მინიშნებაა"

#: src/postulo/templates/server/design.html
msgid "A figure"
msgstr "მაჩვენებელი"

#: src/postulo/jobs/forms.py
msgid "A file from your documents"
msgstr "ფაილი თქვენი დოკუმენტებიდან"

#: src/postulo/templates/jobs/posting_detail.html
msgid "A file goes under Files first; an entry points at it rather than keeping a copy."
msgstr "ფაილი ჯერ „ფაილებში“ თავსდება; ჩანაწერი მასზე მიუთითებს და ასლს არ ინახავს."

#: src/postulo/templates/resume/europass_import.html
msgid "A file that Postulo itself wrote is read on a page of its own."
msgstr "ფაილი, რომელიც თავად Postulo-მ დაწერა, საკუთარ გვერდზე იკითხება."

#: src/postulo/templates/core/kind_file.html
#, python-format
msgid "A file this page made, here or on another Postulo, of up to %(size)s MB and %(most)s records. You are shown what is in it, and what adding it would do, before anything is added."
msgstr "ფაილი, რომელიც ამ გვერდმა შექმნა, აქ ან სხვა Postulo-ზე, %(size)s მბ-მდე და %(most)s ჩანაწერამდე. სანამ რამე დაემატება, გაჩვენებთ, რა არის მასში და რას გამოიწვევს მისი დამატება."

#: src/postulo/templates/resume/candidate_file.html
msgid "A file this page made, here or on another Postulo. You are shown what is in it, and what adding it would do, before anything is added."
msgstr "ფაილი, რომელიც ამ გვერდმა შექმნა, აქ ან სხვა Postulo-ზე. სანამ რამე დაემატება, გაჩვენებთ, რა არის მასში და რას გამოიწვევს მისი დამატება."

#: src/postulo/templates/help/your_name.html
msgid "A form of address is what is written before a name, and pronouns say how to refer to you. Nothing is assumed when either is blank, and neither is ever worked out from your name."
msgstr "მიმართვის ფორმა არის ის, რაც სახელის წინ იწერება, ნაცვალსახელები კი ამბობს, როგორ მოგმართონ. როცა რომელიმე ცარიელია, არაფერი იგულისხმება, და არცერთი არასოდეს გამოიყვანება თქვენი სახელიდან."

#: src/postulo/core/help.py
msgid "A form of address is written before your name, and your pronouns say how to refer to you. Both are optional, nothing is assumed when they are blank, and each is kept as a choice that your pages and documents show in their own language."
msgstr "მიმართვის ფორმა იწერება თქვენი სახელის წინ, ხოლო თქვენი ნაცვალსახელები მიუთითებს, როგორ მოგმართონ. ორივე არასავალდებულოა, ცარიელის შემთხვევაში არაფერი იგულისხმება, და თითოეული ინახება როგორც არჩევანი, რომელსაც თქვენი გვერდები და დოკუმენტები საკუთარ ენაზე აჩვენებს."

#: src/postulo/core/views_access.py
msgid "A group needs a name."
msgstr "ჯგუფს სახელი სჭირდება."

#: src/postulo/core/messaging_services.py
#, python-format
msgid "A handle is at most %(max)s characters, on one line."
msgstr "მესენჯერის სახელი მაქსიმუმ %(max)s სიმბოლოა, ერთ სტრიქონზე."

#: src/postulo/core/messaging_services.py
msgid "A handle is needed."
msgstr "მესენჯერის სახელი სავალდებულოა."

#: src/postulo/templates/help/messaging.html
msgid "A handle is shown as text and is never a link: a matrix.to or t.me address belongs to a third party, and Postulo opens and builds none that you did not ask for."
msgstr "მომხმარებლის სახელი ტექსტად ჩანს და ბმული არასოდეს არის: matrix.to ან t.me მისამართი მესამე მხარეს ეკუთვნის, და Postulo არ ხსნის და არ ქმნის ისეთს, რაც არ გითხოვიათ."

#: src/postulo/resume/candidate.py
msgid "A handle with nothing in it"
msgstr "მესენჯერის სახელი, რომელშიც არაფერი წერია"

#: src/postulo/templates/server/design.html
msgid "A heading, the sentence under it, and then whatever the card is for."
msgstr "სათაური, მის ქვეშ წინადადება და შემდეგ ის, რისთვისაც ბარათია."

#: src/postulo/jobs/vcards.py
msgid "a job title"
msgstr "თანამდებობის დასახელება"

#: src/postulo/documents/integrity.py
msgid "a JPEG picture"
msgstr "JPEG სურათი"

#: src/postulo/resume/publications.py
msgid "A key holds letters, digits and the characters - _ : . + / and nothing else."
msgstr "გასაღები შეიცავს მხოლოდ ასოებს, ციფრებს და სიმბოლოებს - _ : . + /, სხვას არაფერს."

#: src/postulo/templates/server/design.html
msgid "A key to press: <kbd class=\"kbd\">/</kbd> opens the search from anywhere."
msgstr "დასაჭერი კლავიში: <kbd class=\"kbd\">/</kbd> ძიებას ნებისმიერი ადგილიდან ხსნის."

#: src/postulo/jobs/forms.py
msgid "A known service"
msgstr "ცნობილი სერვისი"

#: src/postulo/documents/forms.py
msgid "A language tag such as fr or pt-BR. A screen reader announces the file in it."
msgstr "ენის ტეგი, მაგალითად fr ან pt-BR. ეკრანის წამკითხველი ფაილს ამ ენაზე წაიკითხავს."

#: src/postulo/templates/settings/locale.html
msgid "A language that is still being translated shows English wherever its translation has not reached. That is normal here, and the percentage says how much is done."
msgstr "ენა, რომელიც ჯერ ითარგმნება, ინგლისურს აჩვენებს ყველგან, სადაც თარგმანი ჯერ არ მისულა. ეს აქ ჩვეულებრივია და პროცენტი აჩვენებს, რამდენია შესრულებული."

#: src/postulo/documents/forms.py src/postulo/documents/models.py
msgid "A letter cannot expire before it was written."
msgstr "წერილს ვადა ვერ გაუვა მის დაწერამდე."

#: src/postulo/documents/forms.py
msgid "A letter the referee sends themselves is not offered as a file to attach to an application."
msgstr "წერილი, რომელსაც რეკომენდატორი თავად აგზავნის, განაცხადზე მისამაგრებელ ფაილად შეთავაზებული არ არის."

#: src/postulo/templates/server/data_protection.html
msgid "A limit is never enforced on its own: the dry run says what the policy would touch, and the erasures are performed one by one from a company's page. This button deletes nothing."
msgstr "ზღვარი არასოდეს სრულდება თავისით: საცდელი გაშვება ამბობს, რას შეეხებოდა წესი, ხოლო ამოშლა სათითაოდ ხდება კომპანიის გვერდიდან. ეს ღილაკი არაფერს შლის."

#: src/postulo/documents/models.py
msgid "A line at the end, which names nobody. A reference from your career is printed only once the person has agreed, whatever this says."
msgstr "სტრიქონი ბოლოში, რომელიც არავის ასახელებს. თქვენი კარიერიდან რეკომენდაცია იბეჭდება მხოლოდ მას შემდეგ, რაც ადამიანი თანხმობას განაცხადებს, რაც არ უნდა იყოს აქ მითითებული."

#: src/postulo/resume/forms.py
msgid "A line of your own, such as what the count covers."
msgstr "თქვენი საკუთარი სტრიქონი, მაგალითად, რას მოიცავს ეს რიცხვი."

#: src/postulo/resume/forms.py
msgid "A line or two. It prints under the dates on a CV."
msgstr "ერთი-ორი სტრიქონი. CV-ში იბეჭდება თარიღების ქვეშ."

#: src/postulo/core/models.py
msgid "A line under the name on the home page, and the web app's description. Optional."
msgstr "ხაზი სახელის ქვეშ მთავარ გვერდზე და ვებაპლიკაციის აღწერა. არასავალდებულო."

#: src/postulo/accounts/forms.py
msgid "A line under the navigation bar that says where you are — Companies, then this company — with a link back to each step. It stays with the bar as you scroll. Pages that have no place in a hierarchy draw none, and a phone's narrow screen never does."
msgstr "ხაზი ნავიგაციის ზოლის ქვეშ, რომელიც გიჩვენებთ, სად ხართ — კომპანიები, შემდეგ ეს კომპანია —, თითოეულ საფეხურზე დასაბრუნებელი ბმულით. გადახვევისას ზოლთან ერთად რჩება. გვერდები, რომლებსაც იერარქიაში ადგილი არ აქვს, მას არ ხატავს, ტელეფონის ვიწრო ეკრანზე კი ის არასოდეს ჩანს."

#: src/postulo/applications/widgets.py
msgid "A line when a plugin thinks something happened and is waiting for you."
msgstr "სტრიქონი, როცა მოდული ფიქრობს, რომ რაღაც მოხდა და გელოდებათ."

#: src/postulo/core/identifiers.py
msgid "A link cannot hold a curly bracket other than {value}, a backslash, or a line break."
msgstr "ბმული არ შეიძლება შეიცავდეს ფიგურულ ფრჩხილს ({value}-ის გარდა), უკუხაზს ან ხაზის გადატანას."

#: src/postulo/core/identifiers.py
msgid "A link holds {value}, which is where the identifier goes."
msgstr "ბმულში არის {value}: ადგილი, სადაც იდენტიფიკატორი ჩაისმება."

#: src/postulo/core/identifiers.py
#, python-format
msgid "A link is %(most)d characters long at most."
msgstr "ბმულის სიგრძე მაქსიმუმ %(most)d სიმბოლოა."

#: src/postulo/core/identifiers.py
msgid "A link is a complete web address that begins with http:// or https://."
msgstr "ბმული არის სრული ვებმისამართი, რომელიც იწყება http:// ან https:// თავსართით."

#: src/postulo/core/web_links.py
msgid "A link needs an address."
msgstr "ბმულს მისამართი სჭირდება."

#: src/postulo/resume/candidate.py
msgid "A link with no address"
msgstr "ბმული მისამართის გარეშე"

#: src/postulo/core/web_links.py
msgid "A LinkedIn, a Mastodon, a Bluesky — as many as are worth showing, with one of them marked as the one to show. Documents print that one."
msgstr "LinkedIn, Mastodon, Bluesky — იმდენი, რამდენის ჩვენებაც ღირს, მათგან ერთი მონიშნულია საჩვენებლად. დოკუმენტები სწორედ მას ბეჭდავენ."

#: src/postulo/core/server_forms.py
msgid "A list of schemes, checked when you save. Leave the box empty to define none. What a scheme can say is listed under the box."
msgstr "სქემების სია, რომელიც შენახვისას მოწმდება. დატოვეთ ველი ცარიელი, თუ არცერთის განსაზღვრა არ გსურთ. რისი თქმა შეუძლია სქემას, ველის ქვემოთ არის ჩამოთვლილი."

#: src/postulo/templates/server/design.html
msgid "A list with nothing in it. There were sixteen of these written two ways; there is one now."
msgstr "სია, რომელშიც არაფერია. ასეთი თექვსმეტი იყო, ორნაირად დაწერილი; ახლა ერთია."

#: src/postulo/templates/help/listings.html
msgid "A listing is a posting you have noticed, before you have decided anything about it. <em>Capture a posting</em> reads one from its address; <em>Add a listing</em> is for one you type in yourself, such as a role you heard about."
msgstr "ვაკანსია არის განცხადება, რომელიც შენიშნეთ, სანამ მის შესახებ რამეს გადაწყვეტთ. <em>ვაკანსიის აღება</em> მას მისამართიდან კითხულობს; <em>ვაკანსიის დამატება</em> იმისთვისაა, რომელსაც თავად აკრეფთ, მაგალითად, პოზიცია, რომლის შესახებაც გაიგეთ."

#: src/postulo/templates/core/import_csv.html
msgid "A listing keeps its deadline, which the closing-soon notice then watches, and its tags are written into its description."
msgstr "ვაკანსია ინარჩუნებს თავის ვადას, რომელსაც შემდეგ „მალე იხურება“ შეტყობინება ადევნებს თვალს, ხოლო მისი იარლიყები მის აღწერაში ჩაიწერება."

#: src/postulo/templates/jobs/capture_review.html
msgid "A listing with this title at this company exists; a board that mints a fresh address per visit may be showing you the same advert."
msgstr "ამ კომპანიაში ამ სათაურით ვაკანსია უკვე არსებობს; საიტი, რომელიც ყოველ ვიზიტზე ახალ მისამართს ქმნის, შესაძლოა იმავე განცხადებას გიჩვენებდეთ."

#: src/postulo/notifications/base.py
msgid "A listing you are considering closes soon"
msgstr "ვაკანსია, რომელსაც განიხილავთ, მალე იხურება"

#: src/postulo/templates/server/design.html
msgid "A long list, with a box to narrow it"
msgstr "გრძელი სია, გასაფილტრი ველით"

#: src/postulo/templates/server/design.html
msgid "A longer answer"
msgstr "უფრო გრძელი პასუხი"

#: src/postulo/resume/driving.py
msgid "a lorry with a trailer"
msgstr "სატვირთო ავტომობილი მისაბმელით"

#: src/postulo/resume/driving.py
msgid "a medium-sized lorry with a trailer"
msgstr "საშუალო ზომის სატვირთო ავტომობილი მისაბმელით"

#: src/postulo/templates/applications/appointment_form.html
msgid "A meeting with your adviser at the public employment service you are registered with. Postulo cannot read these from the service, so you enter them here."
msgstr "შეხვედრა თქვენს კონსულტანტთან დასაქმების სახელმწიფო სამსახურში, სადაც რეგისტრირებული ხართ. Postulo მათ ამ სამსახურიდან ვერ კითხულობს, ამიტომ აქ შეიყვანეთ."

#: src/postulo/core/messaging_handles.py
msgid "A messaging handle needs a handle."
msgstr "მესენჯერის სახელი სავალდებულოა."

#: src/postulo/resume/driving.py
msgid "a minibus with a trailer"
msgstr "მიკროავტობუსი მისაბმელით"

#: src/postulo/core/help.py
msgid "A mobile, a desk line, a switchboard — as many as are worth keeping, with one of them marked as the one to use. Documents print that one."
msgstr "მობილური, სამუშაო ხაზი, ცენტრალური ნომერი — იმდენი, რამდენის შენახვაც ღირს, ერთი მათგანი კი მონიშნულია, როგორც გამოსაყენებელი. დოკუმენტები სწორედ მას ბეჭდავს."

#: src/postulo/plugins/provenance.py
msgid "A module: it ships inside Postulo and cannot be removed."
msgstr "ჩაშენებული მოდული: Postulo-ს ნაწილია და მისი წაშლა შეუძლებელია."

#: src/postulo/templates/applications/report.html
msgid "A month"
msgstr "ერთი თვე"

#: src/postulo/core/messaging_services.py
#, python-format
msgid "A name is at most %(max)s characters."
msgstr "დასახელება მაქსიმუმ %(max)s სიმბოლოა."

#: src/postulo/templates/help/identifiers.html
msgid "A name is not an identity: two researchers share one, and one researcher publishes under three. An identifier says which person you are whatever the name, and an application form for an academic post asks for an ORCID by name."
msgstr "სახელი იდენტობა არ არის: ორ მკვლევარს ერთი სახელი აქვს, ერთი მკვლევარი კი სამი სახელით აქვეყნებს. იდენტიფიკატორი ამბობს, ვინ ხართ, სახელის მიუხედავად, ხოლო აკადემიური თანამდებობის სარეგისტრაციო ფორმა ORCID-ს სახელდებით ითხოვს."

#: src/postulo/templates/server/design.html
msgid "A new one"
msgstr "ახალი"

#: src/postulo/templates/connections/pairing_item.html
#, python-format
msgid "A new one: %(kind)s"
msgstr ""

#: src/postulo/templates/server/design.html
msgid "A number and what it counts. The colour is a second signal, never the only one."
msgstr "რიცხვი და ის, რასაც ითვლის. ფერი მეორე სიგნალია და არასოდეს — ერთადერთი."

#: src/postulo/core/models.py
msgid "A number has to be confirmed before it can get you back in. Nobody has answered on this one."
msgstr "ნომერი უნდა დადასტურდეს, სანამ მისი მეშვეობით ანგარიშზე წვდომას აღადგენთ. ამ ნომერზე ჯერ არავის უპასუხია."

#: src/postulo/templates/help/telephone_numbers.html
msgid "A number in its international form is kept once on this instance. If it is already recorded here, saving says so, and takes it from nobody."
msgstr "საერთაშორისო ფორმით ჩაწერილი ნომერი ამ ინსტალაციაზე მხოლოდ ერთხელ ინახება. თუ ის აქ უკვე აღრიცხულია, შენახვა ამას გეტყვით და არავის წაართმევს."

#: src/postulo/templates/partials/phone_numbers.html
msgid "A number is kept once on this instance. If one is already recorded here, saving says so rather than taking it from whoever has it."
msgstr "ნომერი ამ ინსტალაციაზე მხოლოდ ერთხელ შეიძლება იყოს შენახული. თუ ის აქ უკვე ჩაწერილია, შენახვისას ამას გაცნობებთ და მას არ წაართმევს იმას, ვისაც ის აქვს."

#: src/postulo/jobs/surface.py
msgid "A number is needed."
msgstr "საჭიროა ნომერი."

#: src/postulo/templates/help/telephone_numbers.html
msgid "A number its country cannot have is refused, and the refusal says why. A number Postulo cannot place is kept as you typed it, with a note beside it. One recorded before numbers were checked stays as it is, marked, until you change it. Nothing here proves that a number is yours."
msgstr "ნომერი, რომელიც მის ქვეყანას არ შეიძლება ჰქონდეს, უარყოფილია და უარი მიზეზს ამბობს. ნომერი, რომლის განსაზღვრაც Postulo-ს არ შეუძლია, ინახება ისე, როგორც აკრიფეთ, გვერდით შენიშვნით. ნომრების შემოწმებამდე აღრიცხული ნომერი ისე რჩება, როგორც არის, მონიშნული, სანამ არ შეცვლით. აქ არაფერი ამტკიცებს, რომ ნომერი თქვენია."

#: src/postulo/resume/candidate.py
#, fuzzy
msgid "A number with nothing in it"
msgstr "რიცხვი, რომელშიც არაფერია"

#: src/postulo/templates/server/plugins.html
#, python-format
msgid "A package registers a source under the <code>%(group)s</code> entry-point group. A plugin appears as soon as it is installed, in every part of this instance and without a restart. Entry points are all it can bring: a plugin with pages or tables of its own has to be built into the image. A source that fails to load is logged and left out, and the built-in ones keep working."
msgstr "პაკეტი წყაროს არეგისტრირებს <code>%(group)s</code> შესვლის წერტილების ჯგუფში. მოდული ჩნდება დაყენებისთანავე, ამ ინსტალაციის ყველა ნაწილში და გადატვირთვის გარეშე. შესვლის წერტილები ერთადერთია, რისი მოტანაც მას შეუძლია: მოდული, რომელსაც საკუთარი გვერდები ან ცხრილები აქვს, იმიჯში უნდა ჩაშენდეს. წყარო, რომელიც ვერ იტვირთება, ჟურნალში ჩაიწერება და გამოტოვდება, ჩაშენებულები კი მუშაობას განაგრძობენ."

#: src/postulo/templates/server/design.html
msgid "A page title"
msgstr "გვერდის სათაური"

#: src/postulo/templates/settings/account.html
#, python-format
msgid "A passkey is tied to the address you made it at, which here is %(host)s. Reaching this instance by another name, or moving it, will not carry your passkeys over."
msgstr "წვდომის გასაღები დაკავშირებულია იმ მისამართთან, სადაც ის შექმენით — აქ ეს არის %(host)s. ამ ინსტალაციასთან სხვა სახელით მისვლისას ან მისი გადატანისას თქვენი წვდომის გასაღებები არ გადაყვება."

#: src/postulo/core/server_forms.py
msgid "A password is right for your own mail server, and for Gmail with an app password. Microsoft 365 stops accepting passwords for sending mail by default at the end of December 2026; after that it needs XOAUTH2."
msgstr "პაროლი გამოდგება თქვენი საკუთარი საფოსტო სერვერისთვის, ასევე Gmail-ისთვის აპლიკაციის პაროლით. Microsoft 365 2026 წლის დეკემბრის ბოლოდან ნაგულისხმევად წყვეტს პაროლების მიღებას ფოსტის გასაგზავნად; ამის შემდეგ საჭიროა XOAUTH2."

#: src/postulo/templates/server/email.html
msgid "A password is stored. It is never shown, not even its length."
msgstr "პაროლი შენახულია. ის არასოდეს ჩანს, არც მისი სიგრძე."

#: src/postulo/core/mail_choices.py
msgid "A password, or an app password"
msgstr "პაროლი ან აპლიკაციის პაროლი"

#: src/postulo/documents/integrity.py
msgid "a PDF"
msgstr "PDF"

#: src/postulo/templates/core/table_export.html
#, python-format
msgid "A PDF holds the first %(limit)s of them and says so."
msgstr ""

#: src/postulo/templates/server/design.html
msgid "A person, a company or a plugin, as initials on a colour until there is a picture."
msgstr "ადამიანი, კომპანია ან მოდული, ინიციალებით ფერად ფონზე, სანამ სურათი გაჩნდება."

#: src/postulo/core/web_links.py
msgid "A personal site, a blog, a portfolio — as many as are worth showing, with one of them marked as the one to show. Documents print that one."
msgstr "პირადი საიტი, ბლოგი, პორტფოლიო — იმდენი, რამდენის ჩვენებაც ღირს, მათგან ერთი მონიშნულია საჩვენებლად. დოკუმენტები სწორედ მას ბეჭდავენ."

#: src/postulo/core/help.py
msgid "A photograph for your CVs, kept apart from your picture. It is kept as you frame it, and a CV prints it only when you tick that on the CV. The plain text and the Word file never carry it."
msgstr "ფოტო თქვენი CV-ებისთვის, თქვენი სურათისგან ცალკე შენახული. ინახება ისე, როგორც ჩარჩოში მოაქცევთ, და CV მას მხოლოდ მაშინ ბეჭდავს, როცა ამას CV-ში მონიშნავთ. უბრალო ტექსტი და Word-ის ფაილი მას არასოდეს შეიცავს."

#: src/postulo/templates/jobs/capture_page.html
#, python-format
msgid "A picture of the page that “%(title)s” was read from"
msgstr "იმ გვერდის სურათი, საიდანაც „%(title)s“ წაიკითხეს"

#: src/postulo/accounts/forms.py
msgid "A picture of the whole page. One sent by your browser extension shows the page as you were seeing it, signed in or not. Where there is none, one can be drawn here from the kept source, with scripts and the network off: the words of the page, without its looks."
msgstr "მთელი გვერდის გამოსახულება. თქვენი ბრაუზერის გაფართოების გამოგზავნილი გამოსახულება გვერდს ისე აჩვენებს, როგორც თქვენ ხედავდით — შესული იყავით თუ არა. სადაც ასეთი არ არის, მისი დახატვა შეიძლება აქ, შენახული კოდიდან, გამორთული სკრიპტებითა და ქსელით: გვერდის სიტყვები, მისი იერსახის გარეშე."

#: src/postulo/templates/jobs/capture_page.html
msgid "A picture taken in a browser shows the page as it was being seen there, signed in or not."
msgstr "ბრაუზერში გადაღებული სურათი აჩვენებს გვერდს ისე, როგორც იქ ჩანდა, შესული იყავით თუ არა."

#: src/postulo/templates/help/your_picture.html
#, python-format
msgid "A picture you upload has to be %(formats)s, of no more than %(megabytes)s MB and no more than %(megapixels)s megapixels. What the file is decides, not what it is called. Anything else is refused, with the reason, and the picture you had stays."
msgstr "სურათი, რომელსაც ატვირთავთ, უნდა იყოს %(formats)s, არაუმეტეს %(megabytes)s მბ-ისა და არაუმეტეს %(megapixels)s მეგაპიქსელისა. გადამწყვეტია, რა არის ფაილი, და არა ის, რა ჰქვია. ყველაფერი სხვა უარყოფილია მიზეზის მითითებით, ხოლო სურათი, რომელიც გქონდათ, რჩება."

#: src/postulo/templates/help/your_picture.html
msgid "A picture you uploaded is shown rather than your Gravatar, and your Gravatar rather than your initials. <em>Remove the uploaded picture</em> is offered once there is one: tick it and save, and the file is deleted."
msgstr "ატვირთული სურათი ჩანს თქვენი Gravatar-ის ნაცვლად, ხოლო თქვენი Gravatar — თქვენი ინიციალების ნაცვლად. <em>ატვირთული სურათის მოხსნა</em> გამოჩნდება, როგორც კი სურათი იქნება: მონიშნეთ და შეინახეთ, და ფაილი წაიშლება."

#: src/postulo/templates/accounts/profile.html
#: src/postulo/templates/jobs/contact_form.html
msgid "A pin for it is drawn on your map, at its postcode or town, and only you can see it."
msgstr "მისთვის ნიშნული გამოისახება თქვენს რუკაზე, მისი საფოსტო ინდექსის ან ქალაქის მიხედვით, და მას მხოლოდ თქვენ ხედავთ."

#: src/postulo/templates/partials/postal_addresses.html
msgid "A place rather than a whole address, and kept as it is. For post to reach it:"
msgstr "ადგილი და არა სრული მისამართი; ინახება ისე, როგორც არის. რომ ფოსტამ მიაღწიოს:"

#: src/postulo/documents/integrity.py
msgid "a plain text file"
msgstr "უბრალო ტექსტური ფაილი"

#: src/postulo/templates/widgets/suggestions.html
#, python-format
msgid "A plugin has suggested one thing that may have happened: <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">look at it</a>."
msgid_plural "Plugins have suggested %(counter)s things that may have happened: <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">look at them</a>."
msgstr[0] "მოდულმა შემოგთავაზათ ერთი რამ, რაც შესაძლოა მოხდა: <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">გადახედეთ</a>."
msgstr[1] "მოდულებმა შემოგთავაზეს %(counter)s რამ, რაც შესაძლოა მოხდა: <a href=\"%(suggestions_url)s\" class=\"font-medium underline\">გადახედეთ</a>."

#: src/postulo/templates/applications/suggestion_list.html
msgid "A plugin that reads a mailbox or a calendar for you files what it finds here, and it stays here until you accept or decline it."
msgstr "მოდული, რომელიც თქვენთვის ფოსტის ყუთს ან კალენდარს კითხულობს, ნაპოვნს აქ დებს, და ის აქ რჩება, სანამ არ მიიღებთ ან არ უარყოფთ."

#: src/postulo/templates/server/plugins.html
msgid "A plugin's own file is checked against the checksum its catalogue signed. Its requirements are not: those are fetched from PyPI when it is installed, and are whatever is served that day. Trusting a plugin means trusting its list of requirements too. Postulo installs only built wheels, never a source package that would run its own code while installing, and records everything that arrived."
msgstr "მოდულის საკუთარი ფაილი მოწმდება იმ საკონტროლო ჯამით, რომელსაც მისმა კატალოგმა ხელი მოაწერა. მისი მოთხოვნები არ მოწმდება: ისინი დაყენებისას PyPI-დან მოდის და არის ის, რაც იმ დღეს გაიცემა. მოდულის ნდობა მისი მოთხოვნების სიის ნდობასაც ნიშნავს. Postulo აყენებს მხოლოდ აგებულ wheel პაკეტებს და არასოდეს — საწყის პაკეტს, რომელიც დაყენებისას საკუთარ კოდს გაუშვებდა; ის აღრიცხავს ყველაფერს, რაც შემოვიდა."

#: src/postulo/documents/integrity.py
msgid "a PNG picture"
msgstr "PNG სურათი"

#: src/postulo/core/design.py
msgid "A popover or a menu, over the page rather than in it."
msgstr "ამომხტარი ფანჯარა ან მენიუ, გვერდის ზემოთ და არა მასში."

#: src/postulo/resume/registry.py
msgid "A portfolio, a profile, a video: work of yours that already lives somewhere."
msgstr "პორტფოლიო, პროფილი, ვიდეო: თქვენი ნამუშევარი, რომელიც უკვე სადღაც არის განთავსებული."

#: src/postulo/notifications/base.py
msgid "A posting arrives through the capture API"
msgstr "ვაკანსია შემოდის აღების API-ს გავლით"

#: src/postulo/templates/jobs/listing_form.html
msgid "A posting you have noticed. The company and the title are enough to start; the rest can come later."
msgstr "ვაკანსია, რომელიც შენიშნეთ. კომპანია და დასახელება დასაწყისისთვის საკმარისია; დანარჩენი მოგვიანებით მოვა."

#: src/postulo/resume/forms.py
msgid "A prize, a scholarship, a “best paper”: recognition, with nothing to check and no expiry. A credential that may lapse is a certification, and a degree’s classification, such as “cum laude”, is that education entry’s grade."
msgstr "პრემია, სტიპენდია, „საუკეთესო სტატია“: აღიარება, რომელსაც შესამოწმებელი არაფერი აქვს და ვადა არ გასდის. დოკუმენტი, რომელსაც შეიძლება ვადა გაუვიდეს, სერტიფიკაციაა, ხოლო დიპლომის კლასიფიკაცია, მაგალითად „cum laude“, განათლების იმ ჩანაწერის შეფასებაა."

#: src/postulo/resume/candidate.py
#, python-format
msgid "A profile holds at most %(most)s nationalities, and this lists more."
msgstr "პროფილში შეიძლება იყოს მაქსიმუმ %(most)s მოქალაქეობა, აქ კი მეტია ჩამოთვლილი."

#: src/postulo/core/web_links.py
msgid "A profile on a forge, or one project worth showing — as many as are worth listing, with one of them marked as the one to show. Documents print that one."
msgstr "პროფილი კოდის პლატფორმაზე, ან ერთი პროექტი, რომლის ჩვენებაც ღირს — იმდენი, რამდენის ჩამოთვლაც ღირს, მათგან ერთი მონიშნულია საჩვენებლად. დოკუმენტები სწორედ მას ბეჭდავენ."

#: src/postulo/core/web_links.py
msgid "A profile on GitHub, Forgejo, GitLab or similar."
msgstr "პროფილი GitHub-ზე, Forgejo-ზე, GitLab-ზე ან მსგავსზე."

#: src/postulo/resume/forms.py
msgid "A programme, the slides or a recording. A CV does not print it."
msgstr "პროგრამა, სლაიდები ან ჩანაწერი. CV-ში არ იბეჭდება."

#: src/postulo/resume/forms.py
msgid "A public page for the course or its certificate."
msgstr "კურსის ან მისი სერტიფიკატის საჯარო გვერდი."

#: src/postulo/templates/server/plugins.html
msgid "A Python wheel (<code>.whl</code>) built for any platform. Postulo reads what it says about itself and shows you that before anything is installed."
msgstr "ნებისმიერი პლატფორმისთვის აგებული Python wheel ფაილი (<code>.whl</code>). Postulo კითხულობს, რას ამბობს ის საკუთარ თავზე, და ამას გაჩვენებთ, სანამ რამე დაყენდება."

#: src/postulo/templates/applications/report.html
msgid "A quarter"
msgstr "ერთი კვარტალი"

#: src/postulo/templates/server/design.html
msgid "A question over the page, answered before anything is done. This one asks about nothing, and neither answer changes anything."
msgstr "კითხვა გვერდის ზემოთ, რომელსაც პასუხი სჭირდება, სანამ რამე გაკეთდება. ეს არაფერზე კითხულობს და არცერთი პასუხი არაფერს ცვლის."

#: src/postulo/templates/server/logs.html
msgid "A quiet log is the one you want."
msgstr "ჩუმი ჟურნალი სწორედ ის არის, რაც გინდათ."

#: src/postulo/resume/forms.py
msgid "A range such as 41–52, or one page."
msgstr "დიაპაზონი, მაგ. 41–52, ან ერთი გვერდი."

#: src/postulo/templates/connections/pairing.html
msgid "A record since deleted"
msgstr ""

#: src/postulo/documents/forms.py
msgid "A referee who is not a contact yet. Their name is enough; it is added to your contacts without a company, and is used instead of the choice above."
msgstr "რეკომენდატორი, რომელიც ჯერ კონტაქტი არ არის. მისი სახელი საკმარისია; ის თქვენს კონტაქტებს კომპანიის გარეშე დაემატება და ზემოთ არჩეულის ნაცვლად გამოიყენება."

#: src/postulo/applications/ical_import.py
msgid "A reminder"
msgstr "შეხსენება"

#: src/postulo/notifications/base.py
msgid "A reminder falls due"
msgstr "შეხსენების დრო დგება"

#: src/postulo/applications/forms.py
msgid "A reminder falls due a day ahead, when there is a day ahead."
msgstr "შეხსენების დრო დგება ერთი დღით ადრე, თუ ამისთვის დრო რჩება."

#: src/postulo/accounts/models.py
msgid "A reminder of who this is for."
msgstr "შეხსენება იმისა, ვისთვის არის ეს."

#: src/postulo/core/server_forms.py
msgid "A rendering heavier than this is refused before it is read. Left empty, the instance's own setting applies."
msgstr "ამაზე დიდი ზომის გამოსახულება წაკითხვამდე უარიყოფა. თუ ცარიელს დატოვებთ, მოქმედებს ინსტალაციის საკუთარი პარამეტრი."

#: src/postulo/jobs/pages.py
msgid "A rendering is a PNG, JPEG or WebP image, or a PDF, and the request did not say which."
msgstr "გამოსახულება არის PNG, JPEG ან WebP სურათი, ან PDF, და მოთხოვნაში არ იყო მითითებული, რომელი."

#: src/postulo/jobs/pages.py
#, python-format
msgid "A rendering is a PNG, JPEG or WebP image, or a PDF. That was %(kind)s."
msgstr "გამოსახულება არის PNG, JPEG ან WebP სურათი, ან PDF. ეს კი იყო %(kind)s."

#: src/postulo/templates/jobs/capture_review.html
msgid "A rendering of the page this was read from was kept."
msgstr "შენახულია იმ გვერდის გამოსახულება, საიდანაც ეს წაიკითხეს."

#: src/postulo/templates/widgets/shortcuts.html
msgid "A report on a period"
msgstr "ანგარიში პერიოდის შესახებ"

#: src/postulo/templates/server/backup_restore.html
msgid "A restore replaces everything on this instance with what is in the archive, so nothing else may be using the database while it runs. Stop the web service, the scheduler and the worker first, restore, and start them again. Run these on the machine that hosts the instance, not in this browser. The restore command is given <code>--force</code> because this instance already has accounts."
msgstr "აღდგენა ამ ინსტალაციაზე ყველაფერს არქივის შიგთავსით ჩაანაცვლებს, ამიტომ მისი მიმდინარეობისას მონაცემთა ბაზას სხვა არაფერი უნდა იყენებდეს. ჯერ გააჩერეთ ვებსერვისი, დამგეგმავი და ფონური პროცესი, აღადგინეთ და ხელახლა გაუშვით ისინი. ეს ბრძანებები გაუშვით მანქანაზე, რომელზეც ინსტალაციაა განთავსებული, და არა ამ ბრაუზერში. აღდგენის ბრძანებას <code>--force</code> ეძლევა, რადგან ამ ინსტალაციას უკვე აქვს ანგარიშები."

#: src/postulo/templates/server/design.html
msgid "A row"
msgstr "სტრიქონი"

#: src/postulo/templates/help/messaging.html
msgid "A row is one way of being reached on a messaging service: Matrix, XMPP, Signal, Telegram, Threema or another. Choose the service, give the handle, and name the service yourself under <em>Other</em>. As many as are worth keeping, with one marked as the one to use."
msgstr "სტრიქონი არის მესენჯერში თქვენთან დაკავშირების ერთი გზა: Matrix, XMPP, Signal, Telegram, Threema ან სხვა. აირჩიეთ სერვისი, მიუთითეთ მომხმარებლის სახელი, ხოლო <em>სხვა</em>-ს შემთხვევაში სერვისის სახელი თავად დაწერეთ. იმდენი, რამდენიც შენახვად ღირს, და ერთი მათგანი მონიშნული, როგორც გამოსაყენებელი."

#: src/postulo/templates/core/import_csv.html
msgid "A row whose status is draft becomes a listing and any other status an application; a row with no status becomes an application if it has a date applied and a listing if it has none. Applications are dated as the spreadsheet says and marked as imported on their timeline."
msgstr "სტრიქონი, რომლის სტატუსიც მონახაზია, ვაკანსიად იქცევა, ნებისმიერი სხვა სტატუსით კი — განაცხადად; სტრიქონი სტატუსის გარეშე განაცხადად იქცევა, თუ გაგზავნის თარიღი აქვს, და ვაკანსიად, თუ არ აქვს. განაცხადებს თარიღი ელცხრილის მიხედვით ენიჭება და მათ ქრონოლოგიაში იმპორტირებულად აღინიშნება."

#: src/postulo/jobs/capture_views.py
msgid "A saved capture is part of its listing. It goes when the listing does."
msgstr "შენახული აღება მისი ვაკანსიის ნაწილია. ის ვაკანსიასთან ერთად ქრება."

#: src/postulo/templates/server/overview.html
msgid "A scheduled backup was due and nothing took it."
msgstr "დაგეგმილი სარეზერვო ასლის დრო დადგა და არაფერმა შეასრულა."

#: src/postulo/templates/server/backups.html
msgid "A scheduled backup was due and nothing took it. Is the scheduler running? A backup on a schedule needs it."
msgstr "დაგეგმილი სარეზერვო ასლის დრო დადგა და არაფერმა შეასრულა. მუშაობს თუ არა დამგეგმავი? განრიგით სარეზერვო ასლს ის სჭირდება."

#: src/postulo/accounts/forms.py
msgid "A scheme left out is not drawn in a company's summary. It is never deleted: its values stay in the forms, in the export and on any CV you chose to print them on."
msgstr "გამოტოვებული სქემა კომპანიის შეჯამებაში არ ჩანს. ის არასოდეს იშლება: მისი მნიშვნელობები რჩება ფორმებში, ექსპორტში და ნებისმიერ CV-ში, რომელზეც მათი დაბეჭდვა აირჩიეთ."

#: src/postulo/resume/forms.py
msgid "A school, a company, a platform: as a CV should print it. It is linked to the company of that name among yours, and added to your companies if there is none."
msgstr "სკოლა, კომპანია, პლატფორმა: ისე, როგორც CV-ში უნდა დაიბეჭდოს. ის დაუკავშირდება თქვენს კომპანიებს შორის ამავე სახელის კომპანიას, ხოლო თუ ასეთი არ არის, თქვენს კომპანიებს დაემატება."

#: src/postulo/documents/properties.py
msgid "A screen reader reads a file in the language it declares, and the PDF standard for accessibility, PDF/UA, requires one. So stripping all metadata keeps the language unless you choose to leave it out here as well."
msgstr "ეკრანის წამკითხველი ფაილს იმ ენაზე კითხულობს, რომელსაც ფაილი აცხადებს, ხოლო PDF-ის მისაწვდომობის სტანდარტი, PDF/UA, ენის მითითებას მოითხოვს. ამიტომ ყველა მეტამონაცემის მოშორებისას ენა რჩება, თუ აქაც არ აირჩევთ მის გამოტოვებას."

#: src/postulo/core/models.py
msgid "A second signal beside the word, never instead of it."
msgstr "დამატებითი ნიშანი სიტყვის გვერდით, არასოდეს მის ნაცვლად."

#: src/postulo/templates/server/design.html
msgid "A section heading"
msgstr "განყოფილების სათაური"

#: src/postulo/templates/core/home.html
msgid "A self-hosted job application manager, written from the applicant's side of the table. Your applications, your CVs, your cover letters, on your server."
msgstr "სამუშაოზე განაცხადების მართვის თვითჰოსტირებული სისტემა, შექმნილი კანდიდატის თვალსაზრისით. თქვენი განაცხადები, თქვენი CV-ები, თქვენი სამოტივაციო წერილები — თქვენს სერვერზე."

#: src/postulo/templates/server/groups.html
msgid "A set of accounts. A group can own companies, contacts and listings, which every member can then see, change, share and delete, and records can be shared with it; it is also what an access rule on a plugin or a module points at. Whoever leaves keeps a copy of what their own records need; a group that still owns records cannot lose its last member or be deleted."
msgstr "ანგარიშების ნაკრები. ჯგუფს შეიძლება ეკუთვნოდეს კომპანიები, კონტაქტები და ვაკანსიები, რომელთა ნახვა, შეცვლა, გაზიარება და წაშლა შემდეგ ყველა წევრს შეუძლია, და მას შეიძლება ჩანაწერები გაეზიაროს; სწორედ მასზე მიუთითებს მოდულზე ან ჩაშენებულ მოდულზე წვდომის წესი. ვინც ტოვებს, ინარჩუნებს ასლს იმისა, რაც მის საკუთარ ჩანაწერებს სჭირდება; ჯგუფი, რომელსაც ჯერ კიდევ ეკუთვნის ჩანაწერები, ვერ დაკარგავს ბოლო წევრს და ვერ წაიშლება."

#: src/postulo/accounts/models.py
msgid "A short professional title, such as “Backend engineer”."
msgstr "მოკლე პროფესიული დასახელება, მაგალითად „ბექენდ ინჟინერი“."

#: src/postulo/templates/server/person_recovery.html
#, python-format
msgid "A single-use link that lets %(name)s choose a new password, good for %(minutes)s minute. Postulo does not send it anywhere: you hand it over yourself, by whatever means you already trust."
msgid_plural "A single-use link that lets %(name)s choose a new password, good for %(minutes)s minutes. Postulo does not send it anywhere: you hand it over yourself, by whatever means you already trust."
msgstr[0] "ერთჯერადი ბმული, რომლითაც %(name)s ახალ პაროლს აირჩევს, მოქმედებს %(minutes)s წუთი. Postulo მას არსად აგზავნის: თავად გადაეცით, ნებისმიერი გზით, რომელსაც უკვე ენდობით."
msgstr[1] "ერთჯერადი ბმული, რომლითაც %(name)s ახალ პაროლს აირჩევს, მოქმედებს %(minutes)s წუთი. Postulo მას არსად აგზავნის: თავად გადაეცით, ნებისმიერი გზით, რომელსაც უკვე ენდობით."

#: src/postulo/templates/help/install.html
msgid "A site can only be installed when it is served over HTTPS. If no browser offers to install it, ask whoever runs this server."
msgstr "საიტის დაყენება მხოლოდ მაშინ შეიძლება, როცა ის HTTPS-ით მიეწოდება. თუ არცერთი ბრაუზერი მის დაყენებას არ გთავაზობთ, მიმართეთ იმას, ვინც ამ სერვერს მართავს."

#: src/postulo/accounts/forms.py
msgid "A small key cap beside Save and next, Discard and next, Skip to the next and the search box. Turning it off hides the caps only; the keys keep working (see above), and a screen reader is still told about them."
msgstr "კლავიშის პატარა აღნიშვნა ღილაკების „შენახვა და შემდეგი“, „უკუგდება და შემდეგი“, „შემდეგზე გადასვლა“ და საძიებო ველის გვერდით. გამორთვა მხოლოდ აღნიშვნებს მალავს; კლავიშები კვლავ მუშაობს (იხ. ზემოთ) და ეკრანის წამკითხველი მათ შესახებ მაინც გაცნობებთ."

#: src/postulo/templates/server/design.html
msgid "A small one"
msgstr "პატარა"

#: src/postulo/templates/help/links.html
msgid "A social profile is one to a service: a service another row already uses is greyed out in the menu and cannot be chosen again, and saving refuses a second one. A service that lives on many servers, such as Mastodon, and <em>Other</em> can be used as often as you like, and so can the cards of code repositories. Rows that already shared a service stay as they are, with a note, until you change them."
msgstr "სოციალური პროფილი თითო სერვისზე ერთია: სერვისი, რომელსაც სხვა სტრიქონი უკვე იყენებს, მენიუში ნაცრისფრადაა და ხელახლა ვერ აირჩევა, შენახვა კი მეორეს უარყოფს. სერვისი, რომელიც ბევრ სერვერზეა განთავსებული, მაგალითად Mastodon, და <em>სხვა</em> შეგიძლიათ გამოიყენოთ იმდენჯერ, რამდენჯერაც გსურთ, ისევე როგორც კოდის საცავების ბარათები. სტრიქონები, რომლებიც უკვე ერთსა და იმავე სერვისზე იყო, ისე რჩება, როგორც არის, შენიშვნით, სანამ არ შეცვლით."

#: src/postulo/templates/applications/application_form.html
msgid "A status changed here is recorded on the timeline, the same as anywhere else."
msgstr "აქ შეცვლილი სტატუსი ქრონოლოგიაში იწერება, ისევე როგორც სხვაგან."

#: src/postulo/plugins/syncing.py
msgid "A sync of this connection is already running."
msgstr "ამ კავშირის სინქრონიზაცია უკვე მიმდინარეობს."

#: src/postulo/templates/server/design.html
msgid "A table inside a card"
