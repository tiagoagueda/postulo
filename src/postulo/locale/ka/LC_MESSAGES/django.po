msgstr "სააგენტოს მეშვეობით"

#: src/postulo/applications/reports.py
#: src/postulo/templates/applications/application_detail.html
msgid "Through agency"
msgstr "სააგენტოს მეშვეობით"

#: src/postulo/templates/applications/report.html
#: src/postulo/templates/documents/themes/base_report.html
msgid "Through the public employment service"
msgstr "დასაქმების სახელმწიფო სამსახურის მეშვეობით"

#: src/postulo/core/models.py
msgid "Thursday"
msgstr "ხუთშაბათი"

#: src/postulo/templates/jobs/listing_list.html
#, python-format
msgid "Tick %(title)s"
msgstr "მონიშვნა: %(title)s"

#: src/postulo/templates/help/your_picture.html
msgid "Tick <em>Use my Gravatar</em> and save, and Postulo asks gravatar.com once for the picture kept there for your primary email address. Gravatar is sent a hash of the address, not the address. Postulo keeps a copy and shows that, so nothing is fetched while pages are viewed. It asks again when your primary address changes, or when you press <em>Fetch my Gravatar again</em>. Untick the box and save, and the copy is deleted."
msgstr "მონიშნეთ <em>ჩემი Gravatar-ის გამოყენება</em> და შეინახეთ, და Postulo ერთხელ სთხოვს gravatar.com-ს იქ შენახულ სურათს თქვენი მთავარი ელფოსტის მისამართისთვის. Gravatar-ს ეგზავნება მისამართის ჰეში და არა თავად მისამართი. Postulo ინახავს ასლს და მას აჩვენებს, ამიტომ გვერდების ნახვისას არაფერი ჩამოიტვირთება. ის ხელახლა ითხოვს, როცა თქვენი მთავარი მისამართი შეიცვლება, ან როცა დააჭერთ ღილაკს <em>ჩემი Gravatar-ის ხელახლა ჩამოტვირთვა</em>. მოხსენით მონიშვნა და შეინახეთ, და ასლი წაიშლება."

#: src/postulo/resume/forms.py
msgid "Tick a category, or write the national one below."
msgstr "მონიშნეთ კატეგორია ან ქვემოთ ჩაწერეთ ეროვნული."

#: src/postulo/jobs/forms.py
msgid "Tick as many as fit. The list is your own — Industries, beside Companies, is where it is kept."
msgstr "მონიშნეთ იმდენი, რამდენიც შეესაბამება. სია თქვენია — ის ინახება გვერდზე „დარგები“, „კომპანიების“ გვერდით."

#: src/postulo/resume/views.py
#, python-format
msgid "Tick at most %(count)d at a time; nothing was added."
msgid_plural "Tick at most %(count)d at a time; nothing was added."
msgstr[0] "ერთდროულად მონიშნეთ მაქსიმუმ %(count)d; არაფერი დაემატა."
msgstr[1] "ერთდროულად მონიშნეთ მაქსიმუმ %(count)d; არაფერი დაემატა."

#: src/postulo/resume/forms.py
msgid "Tick each category the licence lists: none implies another, so somebody who holds A ticks A. A CV prints the codes."
msgstr "მონიშნეთ ყველა კატეგორია, რომელიც მოწმობაშია ჩამოთვლილი: არცერთი არ გულისხმობს მეორეს, ამიტომ ვისაც A აქვს, A-ს მონიშნავს. CV კოდებს ბეჭდავს."

#: src/postulo/applications/forms.py
msgid "Tick it once you have been. The report addressed to your adviser counts the meetings attended."
msgstr "მონიშნეთ, როცა დაესწრებით. თქვენი კონსულტანტისთვის განკუთვნილი ანგარიშგება დასწრებულ შეხვედრებს ითვლის."

#: src/postulo/templates/partials/table/bulk.html
msgid "Tick rows to act on several at once."
msgstr "მონიშნეთ სტრიქონები, რომ რამდენიმეზე ერთდროულად იმოქმედოთ."

#: src/postulo/applications/forms.py
msgid "Tick the box to add the listing anyway."
msgstr "მონიშნეთ ველი, რომ ვაკანსია მაინც დაამატოთ."

#: src/postulo/templates/resume/publication_orcid.html
