msgstr "Místo"

#: src/postulo/jobs/views.py
msgid "The logo is gone."
msgstr "Logo bylo odstraněno."

#: src/postulo/jobs/views.py
msgid "The logo was changed."
msgstr "Logo bylo změněno."

#: src/postulo/jobs/views.py
#, python-format
msgid "The logo was not changed: %(problem)s"
msgstr "Logo nebylo změněno: %(problem)s"

#: src/postulo/templates/applications/report.html
msgid "The longest gap is measured inside this period, so a silence that began before it is not carried in. A period still running is only counted up to today."
msgstr "Nejdelší mezera se měří uvnitř tohoto období, takže ticho, které začalo dříve, se do něj nepřenáší. Probíhající období se počítá jen do dneška."

#: src/postulo/templates/documents/themes/base_report.html
msgid "The longest gap is measured inside this period. A period still running is counted up to the day this was produced. A week marked (part) reaches outside the period; nothing from outside it is counted."
msgstr "Nejdelší mezera se měří uvnitř tohoto období. Probíhající období se počítá do dne, kdy byl tento dokument vytvořen. Týden označený jako (část) přesahuje mimo období; nic zvenčí se nepočítá."

#: src/postulo/core/server_views.py
msgid "The mail backend accepted nothing."
msgstr "Poštovní backend nic nepřijal."

#: src/postulo/documents/views.py
msgid "The mail server did not take the message, so nothing was sent or recorded."
msgstr "Poštovní server zprávu nepřijal, proto nebylo nic odesláno ani zaznamenáno."

#: src/postulo/templates/server/email.html
msgid "The mailbox this instance sends from"
msgstr "Schránka, ze které tato instance odesílá"

#: src/postulo/templates/server/maps.html
msgid "The map is drawn on OpenStreetMap's public tiles. Each viewer's browser fetches them from tile.openstreetmap.org, which learns that browser's address and the area it looks at — where that person's companies are. It is sent this instance's address as the page asking, never the page itself."
