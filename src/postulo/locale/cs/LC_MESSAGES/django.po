#, python-format, draft
msgid ""
"<strong>%(name)s</strong>: %(rows)s row. The guesses below come from the header names; correct any of them, then check the preview before importing."
msgid_plural ""
"<strong>%(name)s</strong>: %(rows)s rows. The guesses below come from the header names; correct any of them, then check the preview before importing."
msgstr[0] ""
"<strong>%(name)s</strong>: %(rows)s řádek. Odhady níže vycházejí z názvů záhlaví; opravte kterýkoli z nich a před importem zkontrolujte náhled."
msgstr[1] ""
"<strong>%(name)s</strong>: %(rows)s řádky. Odhady níže vycházejí z názvů záhlaví; opravte kterýkoli z nich a před importem zkontrolujte náhled."
msgstr[2] ""
"<strong>%(name)s</strong>: %(rows)s řádků. Odhady níže vycházejí z názvů záhlaví; opravte kterýkoli z nich a před importem zkontrolujte náhled."

