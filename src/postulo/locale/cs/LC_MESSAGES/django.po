msgid "The kept record's notes say what was merged into it and when, followed by the other's own notes."
msgstr "Poznámky ponechaného záznamu říkají, co se do něj sloučilo a kdy, a pak následují poznámky druhého."

#: src/postulo/jobs/page_views.py src/postulo/jobs/pages.py
msgid "The kept source could not be read back."
msgstr "Uchovaný zdroj nešlo načíst zpět."

#: src/postulo/core/server_views.py
#, python-format
msgid "The key for “%(name)s” was replaced. That key is the only thing standing between its index and code running here, so make sure it came from somewhere you trust."
msgstr "Klíč pro „%(name)s“ byl nahrazen. Tento klíč je jediná pojistka mezi jeho indexem a kódem, který zde poběží, proto se ujistěte, že pochází z důvěryhodného zdroje."

#: src/postulo/templates/server/backup_restore.html
msgid "The key the connection secrets are under is not in the archive. Restore with the same <code>.env</code> the archive was written under, or those secrets cannot be read."
msgstr "Klíč, kterým jsou zašifrovány tajné klíče připojení, v archivu není. Obnovte se stejným <code>.env</code>, se kterým byl archiv zapsán, jinak tyto tajné klíče nepůjde přečíst."

#: src/postulo/accounts/forms.py
msgid "The keywords every file carries"
msgstr "Klíčová slova v každém souboru"

#: src/postulo/documents/integrity.py
msgid "the kind of file its name says"
msgstr "druh souboru, který uvádí jeho název"

#: src/postulo/templates/server/identifier_schemes.html
#: src/postulo/templates/server/plugins.html
msgid "The kinds of identifier this instance adds to the ones Postulo ships, for a person, for a company or for both: a staff number, a register Postulo has no scheme for. Written in JSON."
msgstr "Druhy identifikátorů, které tato instance přidává k těm, jež Postulo dodává, pro osobu, pro firmu nebo pro obojí: osobní číslo, rejstřík, pro který Postulo nemá schéma. Zapsáno v JSON."

#: src/postulo/accounts/forms.py
msgid "The language every file declares"
msgstr "Jazyk deklarovaný každým souborem"

#: src/postulo/resume/forms.py
msgid "The language the work is written in."
msgstr "Jazyk, ve kterém je dílo napsáno."

#: src/postulo/accounts/forms.py
