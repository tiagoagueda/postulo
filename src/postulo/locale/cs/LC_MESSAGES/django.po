msgstr "Tím by vznikla smyčka: %(name)s už je její součástí."

#: src/postulo/jobs/models.py
#, python-format
msgid "That would make a loop: %(name)s was already acquired by this one."
msgstr "Vznikla by smyčka: %(name)s už byla touto firmou převzata."

#: src/postulo/applications/views.py src/postulo/jobs/views.py
#, python-format
msgid "The %(count)d document you sent is kept, and still says where it went."
msgid_plural "The %(count)d documents you sent are kept, and still say where they went."
msgstr[0] "%(count)d odeslaný dokument zůstává zachován a stále uvádí, kam byl odeslán."
msgstr[1] "%(count)d odeslané dokumenty zůstávají zachovány a stále uvádějí, kam byly odeslány."
msgstr[2] "%(count)d odeslaných dokumentů zůstává zachováno a stále uvádí, kam byly odeslány."

#: src/postulo/jobs/views.py
#, python-format
msgid "The %(count)d file its history points at is kept where it is."
msgid_plural "The %(count)d files its history points at are kept where they are."
msgstr[0] "Soubor, na který odkazuje jeho historie, zůstává tam, kde je."
msgstr[1] "%(count)d soubory, na které odkazuje jeho historie, zůstávají tam, kde jsou."
msgstr[2] "%(count)d souborů, na které odkazuje jeho historie, zůstává tam, kde jsou."

#: src/postulo/templates/server/backups.html
#, python-format
msgid "The %(name)s destination is chosen but not installed, so nothing is being sent."
msgstr "Cíl %(name)s je zvolen, ale není nainstalován, takže se nic neodesílá."

#: src/postulo/documents/pdf.py
#, python-format
msgid "The %(name)s PDF backend is configured but not usable. %(hint)s"
msgstr "Backend PDF %(name)s je nastaven, ale nelze ho použít. %(hint)s"

#: src/postulo/core/offsite.py
#, python-format
msgid "The %(plugin)s destination is not installed or not chosen."
msgstr "Cíl %(plugin)s není nainstalován nebo není zvolen."

#: src/postulo/documents/archiving.py src/postulo/plugins/syncing.py
#, python-format
msgid "The %(plugin)s plugin is not installed."
msgstr "Plugin %(plugin)s není nainstalován."

#: src/postulo/documents/models.py src/postulo/documents/themes.py
#, python-format
msgid "The %(theme)s theme does not set this type of document."
msgstr "Motiv %(theme)s tento druh dokumentu nesází."

#: src/postulo/documents/paper.py
#, python-format
msgid "The %(theme)s theme prints this only on: %(papers)s."
msgstr "Motiv %(theme)s tiskne toto jen na: %(papers)s."

#: src/postulo/templates/server/logs.html
msgid "The /logs endpoint is on and has no token."
msgstr "Koncový bod /logs je zapnutý a nemá token."

#: src/postulo/resume/importing.py
#, python-format
msgid "The address %(address)s is already listed for somebody you deal with, so it was not added."
msgstr "Adresa %(address)s je již uvedena u někoho, s kým jednáte, proto nebyla přidána."

#: src/postulo/jobs/logos.py src/postulo/resume/links.py
#, python-format
msgid "The address answered %(code)s."
msgstr "Adresa odpověděla %(code)s."

#: src/postulo/jobs/logos.py
msgid "The address answered with nothing."
msgstr "Adresa vrátila prázdnou odpověď."

#: src/postulo/jobs/tiles.py
msgid "The address must hold {z}, {x} and {y}, where each tile's numbers go."
msgstr "Adresa musí obsahovat {z}, {x} a {y} tam, kam patří čísla každé dlaždice."

#: src/postulo/core/server_forms.py
msgid "The address people see it came from. Many servers refuse to send as an address they do not host."
msgstr "Adresa, ze které lidé uvidí, že zpráva přišla. Mnoho serverů odmítá odesílat z adresy, kterou nehostují."

#: src/postulo/applications/forms.py
msgid "The agency or employment service it went through, from the companies you have recorded. Companies in Employment activities, and public employment services, are offered first; add that industry to a company to have it offered here. The company on the posting stays the employer."
msgstr "Agentura nebo služba zaměstnanosti, přes kterou žádost šla, z firem, které jste zaznamenali. Firmy s odvětvím Činnosti související se zaměstnáním a veřejné služby zaměstnanosti se nabízejí jako první; chcete-li, aby se zde nabízela i jiná firma, přidejte jí toto odvětví. Zaměstnavatelem zůstává firma uvedená v inzerátu."

#: src/postulo/resume/lookups.py
#, python-format
msgid "The answer from %(service)s could not be read."
msgstr "Odpověď služby %(service)s se nepodařilo přečíst."

#: src/postulo/resume/lookups.py
#, python-format
msgid "The answer from %(service)s was larger than a record should be."
msgstr "Odpověď služby %(service)s byla větší, než by záznam měl být."

#: src/postulo/jobs/models.py
msgid "The application deadline, if stated."
msgstr "Uzávěrka pro podání žádostí, pokud je uvedena."

#: src/postulo/core/server_forms.py
msgid "The application registered with the provider. Not a secret: it is the secret beside it that is."
msgstr "Aplikace registrovaná u poskytovatele. Není tajná: tajný je až tajný klíč vedle ní."

#: src/postulo/core/mail_choices.py
msgid "The application sends on its own"
msgstr "Aplikace odesílá sama"

#: src/postulo/core/offsite.py
msgid "The archive does not verify."
msgstr "Archiv neprošel ověřením."

#: src/postulo/core/offsite.py
#, python-format
msgid "The archive does not verify: %(problem)s"
msgstr "Archiv neprošel ověřením: %(problem)s"

#: src/postulo/core/offsite.py
msgid "The archive is no longer on this server."
msgstr "Archiv už na tomto serveru není."

#: src/postulo/templates/server/backup_restore.html
msgid "The archive is signed by this instance's key."
msgstr "Archiv je podepsán klíčem této instance."

#: src/postulo/templates/server/backup_restore.html
msgid "The archive opens and its database matches its checksum."
msgstr "Archiv se otevře a jeho databáze odpovídá kontrolnímu součtu."

#: src/postulo/accounts/forms.py
msgid "The arrows on Your career move an entry past its neighbour. If you cannot use them, or would rather type a number, each entry's form shows its place as a number: lower first."
msgstr "Šipky na stránce „Vaše kariéra“ posunou záznam za jeho souseda. Pokud je nemůžete použít nebo raději zadáte číslo, formulář každého záznamu ukazuje jeho pořadí jako číslo: nižší jde dřív."

#: src/postulo/templates/settings/appearance.html
msgid "The arrows put them in your order, and the order decides what stays in reach: the row across the top holds as many as there is room for and the rest are under More, and the bar at the foot of a phone's screen holds them all in this order, scrolling sideways where they do not fit."
msgstr "Šipkami je seřadíte podle sebe a pořadí rozhoduje o tom, co zůstane po ruce: řádek nahoře pojme tolik položek, kolik se vejde, a zbytek je v nabídce Více, zatímco lišta dole na obrazovce telefonu pojme všechny v tomto pořadí a tam, kde se nevejdou, se posouvá do strany."

#: src/postulo/resume/forms.py
msgid "The association, society or club, as a CV should print it. It is linked to the company of that name among yours, and added to your companies if there is none. A membership of a union, a party or a congregation says something about you, and is yours to leave off any CV; nothing here asks for one."
msgstr "Sdružení, spolek nebo klub tak, jak jej má životopis vytisknout. Propojí se s firmou stejného názvu mezi vašimi firmami, a pokud žádná taková není, přidá se do vašich firem. Členství v odborech, politické straně nebo náboženské obci o vás něco vypovídá a je jen na vás, zda je ze životopisu vynecháte; nic zde je nevyžaduje."

#: src/postulo/accounts/forms.py
msgid "The author every file names"
msgstr "Autor uváděný v každém souboru"

#: src/postulo/documents/forms.py
msgid "The author, and the title with your name in it, go into the PDF's properties, as they always have. Untick it to send files without them."
msgstr "Autor a název obsahující vaše jméno se zapíší do vlastností PDF, jako vždy. Zrušte zaškrtnutí, chcete-li soubory odeslat bez nich."

#: src/postulo/core/design.py
msgid "The background. Everything else is above it."
msgstr "Pozadí. Všechno ostatní je nad ním."

#: src/postulo/core/slow.py
msgid "The backup is written and checked."
msgstr "Záloha je zapsána a zkontrolována."

#: src/postulo/templates/server/design.html
msgid "The box first, the question beside it, and what it means under that."
msgstr "Nejdřív pole, vedle něj otázka a pod tím, co znamená."

#: src/postulo/accounts/forms.py
msgid "The breadcrumb is a thin line under the bar that opens while the pointer or the keyboard focus is on it, and closes on Escape. A touch screen has no hover, so there it is drawn whole."
msgstr "Drobečková navigace je tenký řádek pod lištou, který se rozbalí, když je na něm ukazatel nebo fokus klávesnice, a zavře se klávesou Escape. Dotyková obrazovka najetí nezná, proto se tam zobrazuje celá."

#: src/postulo/templates/jobs/company_map.html
msgid "The browser could not say where you are. The map stays where it was."
msgstr "Prohlížeč nedokázal zjistit, kde jste. Mapa zůstává tam, kde byla."

#: src/postulo/templates/jobs/company_map.html
msgid "The browser was not allowed to say where you are, so the map stays where it was."
msgstr "Prohlížeč nesměl sdělit, kde jste, takže mapa zůstává tam, kde byla."

#: src/postulo/accounts/forms.py
msgid "The calendar and the reports start their weeks on it. Left at the language's usual, it follows the language you read Postulo in."
msgstr "Kalendář a zprávy podle něj začínají týden. Při ponechání obvyklého nastavení jazyka se řídí jazykem, ve kterém Postulo používáte."

#: src/postulo/templates/help/calendar.html
msgid "The calendar can be downloaded as an iCalendar file, for the period and kinds on the screen, and a file from another calendar can be read in, with a review of what it holds before anything is added."
msgstr "Kalendář lze stáhnout jako soubor iCalendar za období a druhy zobrazené na obrazovce a lze načíst soubor z jiného kalendáře, s náhledem jeho obsahu dříve, než se cokoli přidá."

#: src/postulo/accounts/forms.py
msgid "The calendar's period buttons"
msgstr "Tlačítka období v kalendáři"

#: src/postulo/templates/jobs/capture_page_forget.html
msgid "The capture stays as it is, and so does any listing it became."
msgstr "Zachycení zůstane, jak je, stejně jako každý inzerát, kterým se stalo."

#: src/postulo/templates/jobs/contact_vcards.html
msgid "The cards in the file"
msgstr "Vizitky v souboru"

#: src/postulo/plugins/catalogue.py
#, python-format
msgid "The catalogue expired on %(date)s; an old copy may have been served."
msgstr "Platnost katalogu vypršela %(date)s; mohla být doručena stará kopie."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue is not readable JSON."
msgstr "Katalog není čitelný JSON."

#: src/postulo/plugins/catalogue.py
#, python-format
msgid "The catalogue is older than one already seen (%(old)d, after %(new)d)."
msgstr "Katalog je starší než již dříve viděný (%(old)d, po %(new)d)."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue's expiry is not a date."
msgstr "Konec platnosti katalogu není datum."

#: src/postulo/plugins/catalogue.py
#, fuzzy
msgid "The catalogue's serial number is not a counter."
msgstr "Sériové číslo katalogu není počítadlo."

#: src/postulo/plugins/catalogue.py
msgid "The catalogue's signature does not match its contents; it was not used."
msgstr "Podpis katalogu neodpovídá jeho obsahu; katalog nebyl použit."

#: src/postulo/plugins/catalogue.py
#, python-format
msgid "The catalogue's signature or key is not readable: %(error)s"
msgstr "Podpis nebo klíč katalogu není čitelný: %(error)s"

#: src/postulo/core/server_views.py
msgid "The catalogues answered, and list nothing yet."
msgstr "Katalogy odpověděly a zatím nic neuvádějí."

#: src/postulo/resume/registry.py
msgid "The categories you hold, as codes. Postulo never keeps the licence number, a photograph or anything else a licence carries."
msgstr "Kategorie, které máte, jako kódy. Postulo nikdy neuchovává číslo průkazu, fotografii ani nic jiného, co průkaz obsahuje."

#: src/postulo/resume/forms.py
msgid "The chapter's number or name, where you are citing a chapter."
msgstr "Číslo nebo název kapitoly, pokud citujete kapitolu."

#: src/postulo/templates/jobs/company_map.html
msgid "The city dataset has not been downloaded on this instance, so no place is on the map: run manage.py fetch_geonames to download it."
msgstr "Datová sada měst nebyla na této instanci stažena, proto na mapě není žádné místo: stáhněte ji příkazem manage.py fetch_geonames."

#: src/postulo/templates/server/email.html
#, python-format
msgid "The client secret is set by <code>%(variable)s</code> in the environment; change it there. It is never shown here."
msgstr "Tajný klíč klienta nastavuje <code>%(variable)s</code> v prostředí; změňte ho tam. Nikdy se tu nezobrazuje."

#: src/postulo/documents/printing.py
msgid "The code repository chosen for this CV is no longer in your details, so it prints none."
msgstr "Repozitář kódu vybraný pro tento životopis už není ve vašich údajích, proto se žádný nevytiskne."

#: src/postulo/resume/forms.py
msgid "The Common European Framework levels. “Not stated” prints nothing at all, which is the honest answer where you have never been tested — a level is a claim somebody may test in an interview."
msgstr "Úrovně Společného evropského referenčního rámce. „Neuvedeno“ nevytiskne vůbec nic, což je poctivá odpověď tam, kde jste nikdy nebyli testováni – úroveň je tvrzení, které může někdo na pohovoru prověřit."

#: src/postulo/templates/jobs/company_places.html
msgid "The companies' addresses on the map, as a file other mapping tools read, and points read back in."
msgstr "Adresy firem na mapě jako soubor, který čtou jiné mapové nástroje, a zpětné načtení bodů."

#: src/postulo/templates/partials/import_owner.html
msgid "The companies, contacts and listings it adds. Applications and notes are always yours."
msgstr "Firmy, kontakty a inzeráty, které přidává. Žádosti a poznámky jsou vždy vaše."

#: src/postulo/core/kind_files.py
#, python-format
msgid "The company %(name)s is not in your account, and is added with it."
msgstr "Firma %(name)s ve vašem účtu není a přidá se spolu s ním."

#: src/postulo/templates/jobs/company_places.html
msgid "The company has no address to place."
msgstr "Firma nemá žádnou adresu k umístění."

#: src/postulo/templates/jobs/company_wikidata.html
msgid "The company has no address to put it on: add one, and fetch again."
msgstr "Firma nemá adresu, ke které by se bod dal přiřadit: přidejte ji a načtěte znovu."

#: src/postulo/templates/applications/application_intake.html
msgid "The company is matched by name and created if it is new. Only the company and the job title are required; everything else can be filled in later."
msgstr "Firma se dohledá podle názvu, a pokud je nová, vytvoří se. Povinné jsou jen firma a název pozice; vše ostatní lze doplnit později."

#: src/postulo/applications/forms.py
msgid "The company is recorded as dissolved. Tick this to add the listing."
msgstr "Firma je zaznamenána jako zaniklá. Zaškrtnutím inzerát přesto přidáte."

#: src/postulo/jobs/models.py
msgid "The company it became part of, if that company is recorded here."
msgstr "Firma, jejíž součástí se stala, pokud je zde zaznamenána."

#: src/postulo/jobs/models.py
msgid "The company this one belongs to, if it belongs to one."
msgstr "Firma, pod kterou tato firma patří, pokud nějaká je."

#: src/postulo/documents/models.py
msgid "The company you are applying to"
msgstr "Firma, u které se ucházíte o místo"

#: src/postulo/jobs/register_lookup.py
msgid "the company's LEI"
msgstr "kód LEI firmy"

#: src/postulo/core/web_links.py
msgid "The company's LinkedIn page, or wherever it posts."
msgstr "Stránka firmy na LinkedIn nebo kdekoli jinde, kde publikuje."

#: src/postulo/core/web_links.py
msgid "The company's own pages: its LinkedIn page, its Mastodon or Bluesky account, its YouTube channel — as many as are worth keeping, with one marked as the one to show."
msgstr "Vlastní stránky firmy: její stránka na LinkedIn, účet na Mastodonu nebo Bluesky, kanál na YouTube – tolik, kolik stojí za to uchovat, s jedním označeným jako ten, který se má zobrazovat."

#: src/postulo/jobs/register_lookup.py
msgid "the company's register number"
msgstr "registrační číslo firmy"

#: src/postulo/documents/archiving.py src/postulo/notifications/webhooks.py
msgid "The connection is gone or switched off."
msgstr "Připojení zmizelo nebo je vypnuté."

#: src/postulo/plugins/secrets.py
msgid "The connection's secrets cannot be read: they were encrypted under a different key. If SECRET_KEY was rotated, set POSTULO_FIELD_KEY to the old key, or enter the secrets again."
msgstr "Tajné údaje připojení nelze přečíst: byly zašifrovány jiným klíčem. Pokud byl SECRET_KEY změněn, nastavte POSTULO_FIELD_KEY na starý klíč, nebo tajné údaje zadejte znovu."

#: src/postulo/templates/help/contact_block.html
msgid "The contact block is what a CV prints under your name, and each CV chooses which parts of it to print under its own <em>Settings</em>. A letter prints only your email address, your telephone number and where you are."
msgstr "Kontaktní blok je to, co životopis tiskne pod vaším jménem, a každý životopis si ve svém <em>Nastavení</em> vybírá, které jeho části vytiskne. Dopis tiskne jen vaši e-mailovou adresu, telefonní číslo a kde se nacházíte."

#: src/postulo/documents/views.py
msgid "The copy could not be sent; the document says why."
msgstr "Kopii se nepodařilo odeslat; důvod je uveden v dokumentu."

#: src/postulo/core/server_forms.py
msgid "The credit the tiles' licence asks for, drawn on the map as plain text. For example: © OpenStreetMap contributors"
msgstr "Uvedení autorství, které licence dlaždic vyžaduje, vykreslené na mapě jako prostý text. Například: © přispěvatelé OpenStreetMap"

#: src/postulo/templates/settings/appearance.html
msgid "The dashboard lists open applications nothing has happened to for a while, with nothing planned. Recruiters' own advice clusters around two to three weeks."
msgstr "Přehled uvádí otevřené žádosti, u nichž se už nějakou dobu nic nestalo a nic není naplánováno. Rady samotných náborářů se pohybují kolem dvou až tří týdnů."

#: src/postulo/api/routers/companies.py src/postulo/jobs/forms.py
msgid "The date cannot be in the future."
msgstr "Datum nemůže být v budoucnosti."

#: src/postulo/jobs/models.py
msgid "The date it became true, if known."
msgstr "Datum, odkdy to platí, pokud je známo."

#: src/postulo/documents/forms.py
msgid "The date on the letter, as a date. Leave it empty when you do not know."
msgstr "Datum na dopise jako datum. Pokud jej neznáte, nechte pole prázdné."

#: src/postulo/applications/forms.py
msgid "The date you mean to have sent it by. It is not a reminder — set one of those if you want telling."
msgstr "Datum, do kdy to chcete odeslat. Není to připomenutí – chcete-li být upozorněni, nastavte si ho."

#: src/postulo/jobs/forms.py
msgid "The day it was true or reported, not today's date unless it is."
msgstr "Den, kdy to platilo nebo bylo hlášeno, ne dnešní datum, pokud to není dnes."

#: src/postulo/resume/forms.py
msgid "The day you read the count. A count changes, so a CV prints the month and the year beside it."
msgstr "Den, kdy jste počet zjistili. Počet se mění, proto životopis vedle něj tiskne měsíc a rok."

#: src/postulo/templates/server/plugins.html
msgid "The default for every account. One person's exceptions are on their row under People. Switching a plugin off stops it being used and deletes nothing."
msgstr "Výchozí nastavení pro každý účet. Výjimky pro jednotlivou osobu jsou v jejím řádku v sekci Lidé. Vypnutí pluginu zastaví jeho používání a nic nemaže."

#: src/postulo/core/views_backups.py
msgid "The destination answered."
msgstr "Cíl odpověděl."

#: src/postulo/core/offsite.py
msgid "The destination did not say where it put the archive."
msgstr "Cíl neuvedl, kam archiv uložil."

#: src/postulo/core/offsite.py
msgid "The destination gave no answer."
msgstr "Cíl neodpověděl."

#: src/postulo/jobs/capture_views.py
msgid "the discarded captures"
msgstr "zahozená zachycení"

#: src/postulo/plugins/catalogue.py
msgid "The download could not be saved here."
msgstr "Stažený soubor zde nelze uložit."

#: src/postulo/plugins/catalogue.py
msgid "The download is far larger than a plugin should be."
msgstr "Stahovaný soubor je mnohem větší, než by plugin měl být."

#: src/postulo/plugins/catalogue.py
msgid "The download is taking too long."
msgstr "Stahování trvá příliš dlouho."

#: src/postulo/documents/models.py
msgid "The earlier version this supersedes. The old file is kept."
msgstr "Dřívější verze, kterou tato nahrazuje. Starý soubor se zachová."

#: src/postulo/resume/forms.py
msgid "The edition or version, as it says on it."
msgstr "Vydání nebo verze, tak jak je na díle uvedeno."

#: src/postulo/documents/printing.py
msgid "The email address chosen for this CV is no longer one of your confirmed addresses, so it prints none."
msgstr "E-mailová adresa vybraná pro tento životopis už není jednou z vašich potvrzených adres, proto se žádná nevytiskne."

#: src/postulo/applications/forms.py
msgid "The employer as a whole"
msgstr "Zaměstnavatel jako celek"

#: src/postulo/jobs/forms.py
msgid "The employer's own closing date, if the posting gives one. Empty means unknown, not open forever."
msgstr "Datum uzávěrky stanovené samotným zaměstnavatelem, pokud ho inzerát uvádí. Prázdné znamená neznámé, ne otevřené navždy."

#: src/postulo/resume/candidate.py
msgid "The entry it belongs to cannot be added."
msgstr "Záznam, ke kterému patří, nelze přidat."

#: src/postulo/resume/candidate.py
msgid "The entry it belongs to is not in the file."
msgstr "Záznam, ke kterému patří, v souboru není."

#: src/postulo/documents/forms.py
msgid "The entry of your career this is the proof of. Used for a certificate, a diploma or a diploma supplement; a diploma and its supplement point at the same entry."
msgstr "Záznam ve vašich kariérních údajích, který tento soubor dokládá. Používá se pro osvědčení, diplom nebo dodatek k diplomu; diplom a jeho dodatek odkazují na stejný záznam."

#: src/postulo/core/server_views.py src/postulo/plugins/forms.py
#, python-format
msgid "The environment sets “%(name)s”, so it cannot be changed here."
msgstr "Prostředí nastavuje „%(name)s“, takže to zde nelze změnit."

#: src/postulo/templates/500.html
msgid "The error has been logged. If you administer this instance, the server log will have the details."
msgstr "Chyba byla zaznamenána. Spravujete-li tuto instanci, podrobnosti jsou v protokolu serveru."

#: src/postulo/templates/resume/item_form.html
#, python-format
msgid "The ESCO classification knows this skill as “%(name)s”. Where you have not written your own, a CV in another of the classification's languages prints the name it gives the skill there."
msgstr "Klasifikace ESCO zná tuto dovednost jako „%(name)s“. Kde jste nenapsali vlastní název, životopis v jiném z jazyků klasifikace vytiskne název, který jí tam klasifikace dává."

#: src/postulo/resume/forms.py
msgid "The event’s name, as a CV should print it: “PyCon Portugal 2025”."
msgstr "Název události tak, jak jej má životopis vytisknout: „PyCon Portugal 2025“."

#: src/postulo/templates/jobs/industry_list.html
msgid "The fields your companies operate in, in your own words. A company may be in several."
msgstr "Obory, v nichž vaše firmy působí, popsané vlastními slovy. Firma může patřit do více oborů."

#: src/postulo/applications/forms.py
msgid "The figure as they wrote it, before tax."
msgstr "Částka tak, jak ji napsali, před zdaněním."

#: src/postulo/templates/applications/ical_import.html
#: src/postulo/templates/core/kind_file.html
#: src/postulo/templates/jobs/contact_vcards.html
#: src/postulo/templates/resume/candidate_file.html
#: src/postulo/templates/resume/europass_import.html
msgid "The file"
msgstr "Soubor"

#: src/postulo/applications/ical_import.py
#, python-format
msgid "the file %(name)s"
msgstr "soubor %(name)s"

#: src/postulo/resume/candidate.py
#, python-format
msgid "The file also holds %(names)s, which this page does not read."
msgstr "Soubor obsahuje také %(names)s, což tato stránka nečte."

#: src/postulo/core/csv_import.py
msgid "The file could not be read: a cell is over 128 KiB. A quotation mark that is never closed is the usual cause."
msgstr "Soubor nešlo přečíst: buňka přesahuje 128 KiB. Obvyklou příčinou je neuzavřená uvozovka."

#: src/postulo/applications/ical_import.py
msgid "The file does not say which time zone this is in. Choose one."
msgstr "Soubor neuvádí, ve kterém časovém pásmu to je. Vyberte je."

#: src/postulo/applications/ical_import.py
msgid "The file gives this the same identifier as an entry above it."
msgstr "Soubor tomu dává stejný identifikátor jako záznam nad ním."

#: src/postulo/applications/ical_import.py
msgid "The file gives this time without a time zone."
msgstr "Soubor uvádí tento čas bez časového pásma."

#: src/postulo/resume/candidate.py
#, fuzzy
msgid "The file has another of this type, and a person has one of each."
msgstr "Soubor obsahuje další položku tohoto typu a osoba může mít od každého jen jednu."

#: src/postulo/resume/candidate.py
#, fuzzy
msgid "The file has two groups under the number it names."
msgstr "Soubor má dvě skupiny pod číslem, které uvádí."

#: src/postulo/resume/candidate.py
msgid "The file has two publications under the number it names, so it will be a count for all of your work."
msgstr "Soubor má pod uvedeným číslem dvě publikace, proto půjde o počet za všechny vaše práce."

#: src/postulo/templates/jobs/contact_vcards.html
#, python-format
msgid "The file holds %(counter)s more card than the first %(limit)s, which are the ones shown."
msgid_plural "The file holds %(counter)s more cards than the first %(limit)s, which are the ones shown."
msgstr[0] "Soubor obsahuje o %(counter)s vizitku více než prvních %(limit)s, které se zobrazují."
msgstr[1] "Soubor obsahuje o %(counter)s vizitky více než prvních %(limit)s, které se zobrazují."
msgstr[2] "Soubor obsahuje o %(counter)s vizitek více než prvních %(limit)s, které se zobrazují."

#: src/postulo/core/kind_files.py
#, python-format
msgid "The file holds more than %(limit)s rows. The first %(limit)s are read."
msgstr "Soubor obsahuje více než %(limit)s řádků. Načte se prvních %(limit)s."

#: src/postulo/core/csv_import.py
msgid "The file holds no rows."
msgstr "Soubor neobsahuje žádné řádky."

#: src/postulo/core/csv_import.py
msgid "The file is empty."
msgstr "Soubor je prázdný."

#: src/postulo/documents/archiving.py
msgid "The file is missing from this server, so it was not sent."
msgstr "Soubor na tomto serveru chybí, proto nebyl odeslán."

#: src/postulo/core/csv_import.py src/postulo/core/views_import.py
msgid "The file is over 2 MB. A job search is not that big."
msgstr "Soubor má přes 2 MB. Tak velké hledání práce není."

#: src/postulo/templates/documents/upload_form.html
msgid "The file itself cannot be changed. Upload the new one and mark it as superseding this, so what you sent still means the file you sent."
msgstr "Samotný soubor nelze změnit. Nahrajte nový a označte ho jako náhradu za tento, aby to, co jste odeslali, stále odpovídalo souboru, který jste odeslali."

#: src/postulo/applications/ical_import.py
msgid "The file marks this as cancelled."
msgstr "Soubor to označuje jako zrušené."

#: src/postulo/applications/ical_import.py
#, python-format
msgid "The file names a time zone, “%(zone)s”, that Postulo does not know."
msgstr "Soubor uvádí časové pásmo „%(zone)s“, které Postulo nezná."

#: src/postulo/documents/archiving.py
msgid "The file no longer matches what was recorded for it, so it was not sent."
msgstr "Soubor už neodpovídá tomu, co pro něj bylo zaznamenáno, proto nebyl odeslán."

#: src/postulo/resume/candidate.py
msgid "The file words it differently. Yours is left as it is."
msgstr "Soubor to formuluje jinak. Vaše znění zůstává beze změny."

#: src/postulo/templates/help/links.html
msgid "The filled star marks the primary of each sort: the one a CV prints, unless its own <em>Settings</em> say otherwise. Letters print none. Press another row's star and save to change it. The bin removes a row at once, after asking, without waiting for <em>Save</em>."
msgstr "Plná hvězdička označuje hlavní z každého druhu: ten, který životopis tiskne, pokud jeho vlastní <em>Nastavení</em> neříká jinak. Dopisy netisknou žádný. Chcete-li změnu, klepněte na hvězdičku jiného řádku a uložte. Koš odebere řádek okamžitě po potvrzení, aniž by čekal na <em>Uložit</em>."

#: src/postulo/templates/help/postal_addresses.html
msgid "The filled star marks the primary. Your CVs and letters never print a street: they print the town and country of the primary address, unless <em>Location</em> in the contact block says something else."
msgstr "Plná hvězdička označuje hlavní. Vaše životopisy a dopisy nikdy netisknou ulici: tisknou město a zemi hlavní adresy, pokud <em>Místo</em> v kontaktním bloku neříká něco jiného."

#: src/postulo/templates/help/telephone_numbers.html
msgid "The filled star marks the primary: the number your documents print, unless a CV's own <em>Settings</em> say otherwise. Press another row's star and save to change it. The bin removes a row at once, after asking, without waiting for <em>Save</em>; removing the primary gives the star to another number, as the question says before you answer it."
msgstr "Plná hvězdička označuje hlavní: číslo, které vaše dokumenty tisknou, pokud <em>Nastavení</em> životopisu neříká jinak. Chcete-li změnu, klepněte na hvězdičku jiného řádku a uložte. Koš odebere řádek okamžitě po potvrzení, aniž by čekal na <em>Uložit</em>; odebráním hlavního se hvězdička předá jinému číslu, jak otázka říká dřív, než odpovíte."

#: src/postulo/templates/server/design.html
msgid "The first"
msgstr "První"

#: src/postulo/resume/candidate.py
#, python-format
msgid "The first %(count)s is read, and the rest are not."
msgid_plural "The first %(count)s are read, and the rest are not."
msgstr[0] "Načte se jen první, zbytek ne."
msgstr[1] "Načtou se první %(count)s, zbytek ne."
msgstr[2] "Načte se prvních %(count)s, zbytek ne."

#: src/postulo/templates/documents/cv_form.html
msgid "The first choice in each list follows your details: mark another number as primary there and this CV prints it. One you choose here stays, whatever becomes primary. If you later delete it from your details, this CV prints none of that kind until you choose again, and never another in its place. What you have already sent does not change."
msgstr "První volba v každém seznamu se řídí vašimi údaji: když tam označíte jiné číslo jako hlavní, tento životopis vytiskne to. Co zvolíte zde, zůstane, ať se hlavním stane cokoli. Pokud to později ze svých údajů smažete, tento životopis nevytiskne nic tohoto druhu, dokud znovu nezvolíte, a nikdy místo toho nevytiskne něco jiného. To, co jste již odeslali, se nemění."

#: src/postulo/notifications/slow.py
#, python-format
msgid "The first: %(title)s"
msgstr "První: %(title)s"

#: src/postulo/templates/403_csrf.html
msgid "The form had expired, or came from a page that has since been signed out. Nothing was saved."
msgstr "Platnost formuláře vypršela, nebo pocházel ze stránky, ze které jste mezitím byli odhlášeni. Nic nebylo uloženo."

#: src/postulo/core/design.py
msgid "The greys. A warm near-black rather than pure black, easier to read at length."
msgstr "Šedé. Teplá téměř černá místo čisté černé, lépe se čte delší dobu."

