msgstr "Wikidata переспрямувала запит в інше місце."

#: src/postulo/jobs/wikidata.py
msgid "Wikidata took too long to answer."
msgstr "Wikidata відповідала надто довго."

#: src/postulo/jobs/wikidata.py
msgid "Wikidata's answer was larger than an item should be."
msgstr "Відповідь Wikidata більша, ніж може бути елемент."

#: src/postulo/jobs/wikidata.py
