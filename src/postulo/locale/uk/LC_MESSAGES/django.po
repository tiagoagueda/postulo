msgstr[0] "Невдалих спроб надіслати повідомлення з цього екземпляра поспіль: %(counter)s. Остання — о %(when)s."
msgstr[1] "Невдалих спроб надіслати повідомлення з цього екземпляра поспіль: %(counter)s. Остання — о %(when)s."
msgstr[2] "Невдалих спроб надіслати повідомлення з цього екземпляра поспіль: %(counter)s. Остання — о %(when)s."

#: src/postulo/templates/jobs/capture_review.html
msgid "The last one waiting."
msgstr "Останнє в черзі."

#: src/postulo/templates/server/backups.html
