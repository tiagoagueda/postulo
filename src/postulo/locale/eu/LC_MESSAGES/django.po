msgstr "Hornitzailean erregistratutako aplikazioa. Ez da sekretua: ondoan dagoena da sekretua."

#: src/postulo/core/mail_choices.py
msgid "The application sends on its own"
msgstr "Aplikazioak bere kabuz bidaltzen du"

