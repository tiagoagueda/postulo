#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "Board recipes"
msgstr "Рэцэпты для сайтаў вакансій"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words a job advert writes just before the last day to apply, separated by |. List the ones adverts in your language use; each is matched as whole words, capitals aside."
msgid "closing date|application deadline|deadline|apply by|apply before|applications close|closes on|closing on|last day to apply|open until"
msgstr "дата закрыцця|тэрмін падачы|тэрмін падачы заявак|канчатковы тэрмін|тэрмін|падаць да|падача заявак да|прыём заявак да|прыём заявак завяршаецца|закрываецца|апошні дзень падачы|адкрыта да|дзейнічае да"

#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "For the boards that publish nothing a standard can read. A recipe records where one board puts each field; whatever it leaves empty is filled from the published standards."
msgstr "Для сайтаў вакансій, якія не публікуюць нічога ў стандартным фармаце. Рэцэпт запісвае, дзе адзін сайт размяшчае кожнае поле; усё, што ён пакідае пустым, запаўняецца з апублікаваных стандартаў."

#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "Page metadata"
msgstr "Метаданыя старонкі"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that say a pay figure is for a day, separated by |."
msgid "per day|a day|daily|/day"
msgstr "за дзень|у дзень|штодзённа|/дзень"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that say a pay figure is for an hour, separated by |."
msgid "per hour|an hour|hourly|/hour|/hr|/h"
msgstr "за гадзіну|у гадзіну|пагадзінна|/гадз|/гадзіну"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that say a pay figure is for a month, separated by |."
msgid "per month|a month|monthly|/month|/mo"
msgstr "за месяц|у месяц|штомесяц|штомесячна|/месяц|/мес"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that say a pay figure is for a year, separated by |."
msgid "per year|a year|per annum|annually|yearly|annual|p.a.|/year|/yr"
msgstr "за год|у год|штогод|штогадова|гадавы|гадавая|/год"

#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "Reads the JobPosting most large boards already publish about themselves, for search engines. A published standard the sites maintain, so it breaks far less often than guessing at their markup would."
msgstr "Чытае JobPosting, які большасць буйных сайтаў вакансій ужо публікуе пра сябе для пошукавых сістэм. Гэта апублікаваны стандарт, які падтрымліваюць самі сайты, таму ён ламаецца значна радзей, чым здагадкі пра іх разметку."

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words a job advert writes just before the pay it offers, separated by |. List the ones adverts in your language use; each is matched as whole words, capitals aside."
msgid "salary|salary range|base salary|annual salary|pay range|pay rate|compensation|remuneration|wage"
msgstr "заробак|заработная плата|вілка заробку|базавы заробак|аплата працы|узнагароджанне|кампенсацыя|аклад"

#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "The fallback, for a page with no structured data: the title it declares and its readable text. Deliberately unambitious — it saves typing and never pretends to know more than it does."
msgstr "Запасны варыянт для старонкі без структураваных даных: загаловак, які яна аб'яўляе, і яе тэкст. Наўмысна сціплы — ён эканоміць час на ўвод і ніколі не прыкідваецца, што ведае больш, чым ведае."

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that join the two figures of a pay range, as in '30,000 to 40,000', separated by |."
msgid "to|and"
msgstr "да|і"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that make a pay figure the most on offer rather than the least, as in 'up to 40,000', separated by |."
msgid "up to|maximum|max"
msgstr "не больш за|максімум|макс"
