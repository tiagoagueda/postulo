#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "Reads the JobPosting most large boards already publish about themselves, for search engines. A published standard the sites maintain, so it breaks far less often than guessing at their markup would."
msgstr "یوٹیوب پر سب سے بڑا بورڈ اپنے بارے میں پہلے ہی شائع کرتا ہے، تلاش کے انجن کے لیے ایک شائع‌کردہ سائٹس کا معیار قائم رکھتا ہے لہٰذا یہ اُن کے نشانے پر قیاس‌آرائی کرنے سے بھی کم نہیں ہوتا ۔."

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words a job advert writes just before the pay it offers, separated by |. List the ones adverts in your language use; each is matched as whole words, capitals aside."
msgid "salary|salary range|base salary|annual salary|pay range|pay rate|compensation|remuneration|wage"
msgstr "مزدوری (انگریزی: kay|salary) فہرست فحش اداکارائیں فحش فلم فحش نگاری ہے۔"

#: src/postulo/plugins/builtin/__init__.py
#, fuzzy
msgid "The fallback, for a page with no structured data: the title it declares and its readable text. Deliberately unambitious — it saves typing and never pretends to know more than it does."
msgstr "گریٹنگ، کسی صفحہ کے لیے جس میں کوئی معلومات نہیں ہیں: اس کے عنوان اور اس کے پڑھنے والے متن کو بیان کرتا ہے۔ اِس کی وجہ یہ ہے کہ اُن کی نظر میں اِس بات کی کوئی اہمیت نہیں ۔."

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that join the two figures of a pay range, as in '30,000 to 40,000', separated by |."
msgid "to|and"
msgstr "کوہان"

#: src/postulo/plugins/builtin/patterns.py
#, fuzzy
msgctxt "Words that make a pay figure the most on offer rather than the least, as in 'up to 40,000', separated by |."
