#: src/postulo/plugins/messaging_services/__init__.py
msgid "Services for messaging handles"
msgstr "Services des identifiants de messagerie instantanée"

#: src/postulo/plugins/messaging_services/__init__.py
msgid "Which messaging services a handle can be on — Matrix, XMPP, Signal, Telegram, Threema — and what a handle on each one looks like. A handle on none of them is listed as “Other”. Nothing here is ever looked up online."
msgstr "Les services de messagerie instantanée sur lesquels peut se trouver un identifiant — Matrix, XMPP, Signal, Telegram, Threema — et la forme d'un identifiant sur chacun d'eux. Un identifiant qui ne correspond à aucun d'eux est classé « Autre ». Rien n'est jamais consulté en ligne ici."
