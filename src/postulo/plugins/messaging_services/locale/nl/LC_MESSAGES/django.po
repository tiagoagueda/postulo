#: src/postulo/plugins/messaging_services/__init__.py
#, fuzzy
msgid "Services for messaging handles"
msgstr "Berichtendiensten en gebruikersnamen"

#: src/postulo/plugins/messaging_services/__init__.py
msgid "Which messaging services a handle can be on — Matrix, XMPP, Signal, Telegram, Threema — and what a handle on each one looks like. A handle on none of them is listed as “Other”. Nothing here is ever looked up online."
msgstr "Op welke berichtendiensten een gebruikersnaam kan staan — Matrix, XMPP, Signal, Telegram, Threema — en hoe een gebruikersnaam op elk ervan eruitziet. Een gebruikersnaam op geen ervan wordt vermeld als “Overig”. Er wordt hier nooit iets online opgezocht."
