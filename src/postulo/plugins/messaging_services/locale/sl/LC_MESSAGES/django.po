#: src/postulo/plugins/messaging_services/__init__.py
msgid "Services for messaging handles"
msgstr "Storitve za uporabniška imena v sporočanju"

#: src/postulo/plugins/messaging_services/__init__.py
msgid "Which messaging services a handle can be on — Matrix, XMPP, Signal, Telegram, Threema — and what a handle on each one looks like. A handle on none of them is listed as “Other”. Nothing here is ever looked up online."
msgstr "Na katerih storitvah za sporočanje je lahko uporabniško ime (Matrix, XMPP, Signal, Telegram, Threema) in kako je videti uporabniško ime na vsaki od njih. Uporabniško ime, ki ni na nobeni od njih, je navedeno kot »Drugo«. Nič od tega se nikoli ne preverja na spletu."
