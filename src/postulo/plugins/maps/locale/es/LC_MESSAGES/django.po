#: src/postulo/plugins/maps/__init__.py
#, fuzzy
msgid "Companies on a map"
msgstr "Empresas en un mapa"

#: src/postulo/plugins/maps/__init__.py
#, fuzzy
msgid "Show where the companies are on a map, and place a company from the town typed in its location, using a table of cities kept on this server. Switched off, there is no map page and no location is placed; the coordinates already stored stay recorded and come back untouched when it is switched on again."
msgstr "Mostrar dónde están las empresas en un mapa, y colocar una empresa de la ciudad escrita en su ubicación, utilizando una tabla de ciudades guardadas en este servidor. Apagado, no hay página de mapa y no se coloca ninguna ubicación; las coordenadas ya almacenadas permanecen registradas y vuelven intactas cuando se activa de nuevo."
