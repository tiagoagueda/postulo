#: src/postulo/plugins/maps/__init__.py
#, fuzzy
msgid "Maps"
msgstr "Քարտեզներ"

#: src/postulo/plugins/maps/__init__.py
#, fuzzy
msgid "Show where the companies are on a map, placing each postal address offline at its postcode or its town from tables kept on this server, or where you put it by hand; a contact's address and your own are drawn only when you ask, and their points are kept with them and erased with them. The map is drawn by Leaflet (BSD-2-Clause) over OpenStreetMap's tiles (© OpenStreetMap contributors, ODbL) unless Settings chooses other tiles or none; OpenStreetMap then learns each viewer's address and the area they look at. Places come from GeoNames (CC BY 3.0; its postal codes CC BY 4.0), the country names from the Unicode CLDR through Babel, and the world outline from Natural Earth (public domain). Switched off, there is no map page and no address is placed; the coordinates already stored stay recorded and come back untouched when it is switched on again."
msgstr "Ցույց տալ ընկերությունների գտնվելու վայրը քարտեզի վրա՝ յուրաքանչյուր փոստային հասցե անցանց տեղադրելով ըստ փոստային ինդեքսի կամ քաղաքի՝ այս սերվերում պահվող աղյուսակներից, կամ այնտեղ, որտեղ դուք այն ձեռքով եք դրել․ կոնտակտի հասցեն և ձեր սեփականը գծվում են միայն ձեր խնդրանքով, և դրանց կետերը պահվում են դրանց հետ և ոչնչացվում դրանց հետ։ Քարտեզը գծում է Leaflet-ը (BSD-2-Clause)՝ OpenStreetMap-ի սալիկների վրա (© OpenStreetMap contributors, ODbL), եթե «Կարգավորումներ» բաժնում ընտրված չեն այլ սալիկներ կամ առանց սալիկների տարբերակը․ այդ դեպքում OpenStreetMap-ն իմանում է յուրաքանչյուր դիտողի հասցեն և այն տարածքը, որը նա դիտում է։ Վայրերը վերցված են GeoNames-ից (CC BY 3.0, դրա փոստային ինդեքսները՝ CC BY 4.0), երկրների անունները՝ Unicode CLDR-ից Babel-ի միջոցով, իսկ աշխարհի ուրվագիծը՝ Natural Earth-ից (հանրային սեփականություն)։ Անջատված է, քարտեզի էջ չկա, և ոչ մի հասցե չի տեղադրվում․ արդեն պահված կոորդինատները մնում են գրանցված և կրկին միացնելիս վերադառնում են անփոփոխ։"
