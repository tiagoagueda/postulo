#: src/postulo/plugins/maps/__init__.py
#, fuzzy
msgid "Companies on a map"
msgstr "Kompanitë në hartë"

#: src/postulo/plugins/maps/__init__.py
#, fuzzy
msgid "Show where the companies are on a map, and place a company from the town typed in its location, using a table of cities kept on this server. Switched off, there is no map page and no location is placed; the coordinates already stored stay recorded and come back untouched when it is switched on again."
msgstr "Shfaq se ku janë kompanitë në hartë, dhe vendo një kompani nga qyteti të shkruar në vendndodhjen e saj, duke përdorur një tabelë qytetesh mbajtur në këtë server. U fik, nuk ka asnjë faqe hartash dhe nuk është vendosur asnjë pozicion; koordinatat tashmë të regjistruara qëndrojnë dhe kthehen të paprekura kur është ndezur përsëri."
