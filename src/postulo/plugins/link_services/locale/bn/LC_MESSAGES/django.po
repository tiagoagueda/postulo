#: src/postulo/plugins/link_services/services.py
msgid "Forgejo or Gitea"
msgstr "Forgejo বা Gitea"

#: src/postulo/plugins/link_services/__init__.py
msgid "Services for web links"
msgstr "ওয়েব লিঙ্কের পরিষেবাগুলো"

#: src/postulo/plugins/link_services/__init__.py
msgid "Which services a social profile or a code repository can be on — LinkedIn, Mastodon, Bluesky, GitHub, GitLab, Codeberg, a Forgejo instance — what an address on each one looks like, and the icon drawn beside it. An address on none of them is listed as “Other”. Nothing here is ever looked up online."
msgstr "একটি সামাজিক প্রোফাইল বা কোড রিপোজিটরি কোন কোন পরিষেবায় থাকতে পারে — LinkedIn, Mastodon, Bluesky, GitHub, GitLab, Codeberg, একটি Forgejo ইনস্ট্যান্স — প্রতিটিতে একটি ওয়েব ঠিকানা দেখতে কেমন, এবং এর পাশে আঁকা আইকন। এগুলোর কোনোটিতেই নেই এমন ঠিকানা “অন্যান্য” হিসেবে তালিকাভুক্ত হয়। এখানের কোনো কিছুই কখনো অনলাইনে খোঁজা হয় না।"
