#: src/postulo/plugins/messaging_contacts/__init__.py
#, fuzzy
msgid "Keep the ways you and the people you deal with are reached on Matrix, XMPP, Signal, Telegram, Threema or another messaging service, as many as you like, one of them marked as the one to use. Switched off, Postulo offers none; the ones already recorded stay and come back untouched when it is switched on again."
msgstr "Coinnigh na bealaí tú féin agus na daoine déileáil leat a bhfuil bainte amach ar Maitrís, XMPP, Signal, Telegram, Tríma nó seirbhís teachtaireachtaí eile, mar is maith leat, ar cheann acu marcáilte mar an ceann a úsáid. Athraigh amach, cuireann Postulo aon cheann; na cinn a taifeadadh cheana fanacht agus teacht ar ais untouched nuair a bhíonn sé aistrigh arís."

#: src/postulo/plugins/messaging_contacts/__init__.py
#, fuzzy
msgid "Multiple messaging contacts"
msgstr "Teagmhálacha teachtaireachtaí il"
