#: src/postulo/plugins/messaging_contacts/__init__.py
#, fuzzy
msgid "Keep the ways you and the people you deal with are reached on Matrix, XMPP, Signal, Telegram, Threema or another messaging service, as many as you like, one of them marked as the one to use. Switched off, Postulo offers none; the ones already recorded stay and come back untouched when it is switched on again."
msgstr "Κρατήστε τους τρόπους με τους οποίους και οι άνθρωποι που ασχολούνται με έχουν επιτευχθεί σε Matrix, XMPP, Σήμα, Telegram, Threema ή άλλη υπηρεσία μηνυμάτων, όσες θέλετε, ένα από αυτά σημειώνονται ως το ένα να χρησιμοποιήσετε. Κλείσιμο, η Postulo δεν προσφέρει τίποτα· αυτές που έχουν ήδη καταγραφεί μένουν και επιστρέφουν ανέγγιχτες όταν είναι ενεργοποιημένες ξανά."

#: src/postulo/plugins/messaging_contacts/__init__.py
#, fuzzy
msgid "Multiple messaging contacts"
msgstr "Επαφές πολλαπλών μηνυμάτων"
