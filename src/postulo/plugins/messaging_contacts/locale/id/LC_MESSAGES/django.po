#: src/postulo/plugins/messaging_contacts/__init__.py
msgid "Keep the ways you and the people you deal with are reached on Matrix, XMPP, Signal, Telegram, Threema or another messaging service, as many as you like, one of them marked as the one to use. Switched off, Postulo offers none; the ones already recorded stay and come back untouched when it is switched on again."
msgstr "Simpan cara Anda dan orang-orang yang berhubungan dengan Anda dapat dihubungi di Matrix, XMPP, Signal, Telegram, Threema, atau layanan perpesanan lain, sebanyak yang Anda mau, dengan salah satunya ditandai sebagai yang digunakan. Jika dinonaktifkan, Postulo tidak menawarkan satu pun; yang sudah tercatat tetap ada dan kembali tanpa diubah saat plugin diaktifkan lagi."

#: src/postulo/plugins/messaging_contacts/__init__.py
msgid "Multiple messaging contacts"
msgstr "Beberapa kontak perpesanan"
