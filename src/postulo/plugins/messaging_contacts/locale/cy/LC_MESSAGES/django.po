#: src/postulo/plugins/messaging_contacts/__init__.py
#, fuzzy
msgid "Keep the ways you and the people you deal with are reached on Matrix, XMPP, Signal, Telegram, Threema or another messaging service, as many as you like, one of them marked as the one to use. Switched off, Postulo offers none; the ones already recorded stay and come back untouched when it is switched on again."
msgstr "Cadwch y ffyrdd o'ch cyrraedd chi a'r bobl rydych yn ymwneud â nhw ar Matrix, XMPP, Signal, Telegram, Threema neu wasanaeth negeseua arall, cynifer ag y mynnwch, gydag un ohonynt wedi'i nodi fel yr un i'w ddefnyddio. Wedi'i ddiffodd, nid yw Postulo yn cynnig yr un; mae'r rhai a gofnodwyd eisoes yn aros, a dônt yn ôl yn ddigyffwrdd pan gaiff ei droi ymlaen eto."

#: src/postulo/plugins/messaging_contacts/__init__.py
#, fuzzy
msgid "Multiple messaging contacts"
msgstr "Sawl cyfrif negeseua"
