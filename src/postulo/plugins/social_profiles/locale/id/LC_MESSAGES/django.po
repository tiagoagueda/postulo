#: src/postulo/plugins/social_profiles/__init__.py
#, fuzzy
msgid "Keep more than one social profile for yourself and for the people you deal with — a LinkedIn, a Mastodon, a Bluesky — with one of them marked as the one to show. Switched off, Postulo shows and uses the primary profile only; the others stay recorded and come back untouched when it is switched on again."
msgstr "Simpan lebih dari satu profil sosial untuk diri sendiri dan untuk orang-orang Anda berurusan dengan - LinkedIn, Mastodon, Bluesky - dengan salah satu dari mereka ditandai sebagai salah satu untuk menunjukkan. Dimatikan, Postulo menunjukkan dan menggunakan profil utama saja; yang lain tetap direkam dan kembali tersentuh ketika diaktifkan lagi."

#: src/postulo/plugins/social_profiles/__init__.py
#, fuzzy
msgid "Several social profiles"
msgstr "Beberapa profil sosial"
