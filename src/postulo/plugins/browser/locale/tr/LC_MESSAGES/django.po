#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Bir push adresi HTTPS olmalıdır."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Anlık bildirim, tarayıcınızı yapan firmanın anlık bildirim hizmeti üzerinden gider; yolda okunamasın diye şifrelenir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Bu tarayıcıda bildirimlere izin ver"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Bu tarayıcıya soruluyor…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Browser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "“Bu tarayıcıda bildirimlere izin ver” düğmesine bastığınızda doldurulur; bunun için betikler gerekir. Olduğu gibi bırakın."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Nasıl ulaşır"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Bu yolla sunucudan hiçbir şey gönderilmez: bildirimler, Postulo onlara izin vermiş bir tarayıcıda açıkken görünür."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Bildirimlere izin verildi. Bu tarayıcı anlık bildirim alamıyor, bu yüzden bildirimler Postulo onda açıkken görünecek. Korumak için kaydedin."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Bildirimler kuruldu"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Yalnızca Postulo açıkken ve hiçbir şey bu kurulumdan çıkmaz"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s üzerinden anlık bildirimle"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Postulo kapalıyken bile bu tarayıcıya anlık bildirimle"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Hatırlatmalar ve yakalamalar da aynı yolla ulaşacak."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Gönderildi. İzin veren tarayıcıda görünmesi gerekir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Tarayıcınızda bir bildirim gösterir: alabildiğinde anlık bildirim olarak gönderilir, alamıyorsa Postulo onda bir sonraki açılışında görünür."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "O tarayıcı aboneliğini geri çekti. Bu bağlantıyı onda açın ve bildirimlere yeniden izin verin."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "The push servisi %(status)s cevap verdi."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Abonelik bir tarayıcının yazdığı bir şey değildir."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Abonelik anahtarları tarayıcının değil."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Bu tarayıcı burada bildirim gösteremez. Tarayıcılar bildirimlere yalnızca güvenli (HTTPS) bir adreste izin verir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Bu tarayıcı reddetti. Ayarlarından bu site için bildirimlere izin verin, sonra yeniden deneyin."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
