#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "پُش پتہ HTTPS ہونا چاہیے۔"

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "پُش آپ کے براؤزر بنانے والے کی پُش سروس سے ہو کر جاتا ہے، انکرپٹ کر کے، تاکہ راستے میں اسے پڑھا نہ جا سکے۔"

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "اس براؤزر میں اطلاعات کی اجازت دیں"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "اس براؤزر سے پوچھا جا رہا ہے…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "براؤزر اطلاعات"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "جب آپ “اس براؤزر میں اطلاعات کی اجازت دیں” دباتے ہیں تو یہ بھر جاتا ہے، جس کے لیے اسکرپٹس درکار ہیں۔ اسے جیسا ہے ویسا ہی رہنے دیں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "یہ کیسے پہنچتی ہے"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "اس طریقے سے سرور سے کچھ نہیں بھیجا جاتا: اطلاعات اس وقت ظاہر ہوتی ہیں جب Postulo کسی ایسے براؤزر میں کھلا ہو جس نے ان کی اجازت دی ہو۔"

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "اطلاعات کی اجازت ہے۔ یہ براؤزر پُش وصول نہیں کر سکتا، اس لیے یہ تب ظاہر ہوں گی جب Postulo اس میں کھلا ہو۔ اسے برقرار رکھنے کے لیے محفوظ کریں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "اطلاعات ترتیب دے دی گئی ہیں"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "صرف جب Postulo کھلا ہو، اور کچھ بھی اس انسٹینس سے باہر نہیں جاتا"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s کے ذریعے پُش کی گئی"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "اس براؤزر کو پُش کی گئی، Postulo بند ہونے پر بھی"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "یاد دہانیاں اور کیپچر بھی اسی طرح پہنچیں گے۔"

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "بھیج دی گئی۔ یہ اس براؤزر میں ظاہر ہونی چاہیے جس نے اس کی اجازت دی تھی۔"

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "آپ کے براؤزر میں HTML5 اطلاع دکھاتا ہے: جب براؤزر پُش وصول کر سکتا ہو تو اسے پُش کی جاتی ہے، ورنہ اگلی بار جب Postulo اس میں کھلے۔"

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "اس براؤزر نے اپنی سبسکرپشن واپس لے لی ہے۔ یہ کنکشن اس براؤزر میں کھولیں اور دوبارہ اطلاعات کی اجازت دیں۔"

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "پُش سروس نے %(status)s جواب دیا۔"

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "یہ سبسکرپشن کسی براؤزر کی لکھی ہوئی نہیں ہے۔"

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "سبسکرپشن کی کلیدیں براؤزر کی نہیں ہیں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "یہ براؤزر یہاں اطلاعات نہیں دکھا سکتا۔ براؤزر صرف محفوظ (HTTPS) پتے پر ان کی اجازت دیتے ہیں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "اس براؤزر نے انکار کر دیا۔ اس کی ترتیبات میں اس سائٹ کے لیے اطلاعات کی اجازت دیں، پھر دوبارہ کوشش کریں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "یہ براؤزر اطلاعات وصول کرے گا۔ اسے برقرار رکھنے کے لیے محفوظ کریں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "اس براؤزر نے اپنی سبسکرپشن واپس لے لی، اس لیے اسے بند کر دیا گیا۔ یہ کنکشن اسی براؤزر میں کھولیں اور دوبارہ اطلاعات کی اجازت دیں۔"

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "اس براؤزر کی سبسکرپشن"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "جب Postulo کھلا ہو"
