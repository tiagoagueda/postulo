#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "ایک پریس پتہ ایچ ٹی ٹی پی ہونا ہے."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "ایک تحریک آپ کے براؤزر بنانے والے کی حوصلہ افزائی کے ذریعے گزرتا ہے، اس پر تنقید کی تاکہ راستے میں اسے پڑھا نہ جا سکے۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "اس براؤزر میں اطلاعات کی اجازت دیں"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "اس براؤزر کو شش کریں.."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "براہِ راست"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "جب آپ اس پر دباؤ ڈالتے ہیں \"اس براؤزر میں اطلاعات\" جس کی ضرورت ہے اسے اتنا ہی چھوڑ دو."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "یہ کیسے آتا ہے؟"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "سرور سے کچھ بھی نہیں بھیجا جاتا: اطلاعات ظاہر ہوتی ہیں جبکہ پوسٹلو ایک براؤزر میں کھلی رہتی ہیں جس نے انہیں اجازت دے دی۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "نامناسب اجازت ہے. اس براؤزر کو انفلیشن نہیں مل سکتا اس لیے وہ نمودار ہوں گے جبکہ اس میں پوسٹلو کھلتا ہے۔ اسے رکھنے کے لئے محفوظ."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "نذدیک وضع کیے گئے ہیں۔"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "صرف پوسٹلو کھلے ہوئے ہیں اور اس واقعے کو کچھ نہیں چھوڑتا"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s کے ذریعے سفر"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "اس براؤزر کی طرف، پوسٹلو بند کے ساتھ"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "یاددہانیاں اور گرفتاریاں اسی طرح پہنچ جائیں گی۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "نازل. اسے اجازت دینے والے براؤزر میں ظاہر ہونا چاہئے."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "آپ کے براؤزر میں اطلاع دکھا تا هے : جب یہ ایک حاصل ہو سکے تو اس کے بعد جب اگلی بار پوسٹلو اس میں کھلتا ہے۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "اس براؤزر نے اس کی سرکوبی کرنا چھوڑ دیا ہے. اس اتصال کو اس میں کھولو اور اطلاعات دوبارہ رکھیں۔."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "فورس سروس نے %(status)s جواب دیا۔."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "اِس سلسلے میں ایک مثال پر غور کریں ۔."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "تنصیب کار کی کلیدیں براڈ بینڈ نہیں ہیں۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "یہ براؤزر یہاں اطلاعات نہیں دکھا سکتا۔ Browsers صرف انہیں ایک محفوظ (HTPS) پتے پر پتہ لگانے کی اجازت دیتا ہے۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "اس براؤزر نے انکار کر دیا۔ اس جگہ کے لئے اطلاعات دینے دیں اس کی ترتیبات، پھر کوشش کریں."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "اس براؤزر اطلاعات حاصل کریں گے. اسے رکھنے کے لئے محفوظ."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "اس براؤزر نے اپنے بلے باز کو ہٹا دیا، تو وہ دور ہو گیا. اس براؤزر میں یہ اتصال کھولو اور اطلاعات دوبارہ حاصل کریں۔."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "اس براؤزر کا ربط"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "جبکہ پوسٹلو کھلے ہوئے ہیں۔"
