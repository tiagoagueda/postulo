#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Alamat push harus berupa HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Sebuah dorongan melalui layanan push dari pembuat browser Anda, dienkripsi sehingga tidak dapat dibaca dalam perjalanan."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Ijinkan pemberitahuan dalam peramban ini"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Meminta browser ini.."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Peramban"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Isi ketika Anda menekan \"Ijinkan pemberitahuan dalam peramban ini\", yang membutuhkan skrip. Biarkan seperti itu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Bagaimana tiba"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Tidak ada yang dikirim dari server dengan cara ini: pemberitahuan muncul sementara Postulo terbuka dalam peramban yang memungkinkan mereka."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Pemberitahuan diperbolehkan. Peramban ini tidak dapat menerima Push, sehingga mereka akan muncul sementara Postulo terbuka di dalamnya. Simpan untuk menyimpannya."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Notifications are set up"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Hanya sementara Postulo terbuka, dan tidak meninggalkan instansi ini"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Didorong melalui %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Didorong ke browser ini, bahkan dengan Postulo ditutup"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Pengingat dan menangkap akan datang dengan cara yang sama."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Dikirim. Seharusnya muncul di browser yang memungkinkannya."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Tampilkan pemberitahuan dalam peramban Anda: didorong ke sana ketika ia dapat menerima satu, jika tidak lain kali Postulo terbuka di dalamnya."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Browser yang telah menarik langganan nya. Buka koneksi ini di dalamnya dan ijinkan pemberitahuan lagi."

