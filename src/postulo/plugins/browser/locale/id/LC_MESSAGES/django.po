#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Alamat push harus menggunakan HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Notifikasi push dikirim melalui layanan push dari pembuat browser Anda, terenkripsi sehingga tidak dapat dibaca selama perjalanan."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Izinkan notifikasi di browser ini"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Menanyakan browser ini…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Notifikasi browser"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Diisi saat Anda menekan “Izinkan notifikasi di browser ini”, yang memerlukan skrip. Biarkan apa adanya."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Cara tibanya"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Tidak ada yang dikirim dari server dengan cara ini: notifikasi muncul selama Postulo terbuka di browser yang mengizinkannya."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Notifikasi diizinkan. Browser ini tidak dapat menerima push, jadi notifikasi akan muncul selama Postulo terbuka di dalamnya. Simpan untuk mempertahankannya."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Notifikasi sudah disiapkan"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Hanya selama Postulo terbuka, dan tidak ada yang keluar dari instans ini"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Dikirim lewat push melalui %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Dikirim lewat push ke browser ini, bahkan saat Postulo ditutup"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Pengingat dan tangkapan akan tiba dengan cara yang sama."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Terkirim. Notifikasi seharusnya muncul di browser yang mengizinkannya."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Menampilkan notifikasi HTML5 di browser Anda: dikirim lewat push jika browser dapat menerimanya, atau saat berikutnya Postulo dibuka di browser itu."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Browser itu telah menarik langganannya. Buka koneksi ini di browser tersebut dan izinkan notifikasi lagi."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Layanan push menjawab %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Langganan ini bukan sesuatu yang ditulis oleh browser."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Kunci langganan ini bukan milik browser."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Browser ini tidak dapat menampilkan notifikasi di sini. Browser hanya mengizinkannya pada alamat yang aman (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Browser ini menolak. Izinkan notifikasi untuk situs ini di pengaturannya, lalu coba lagi."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Browser ini akan menerima notifikasi. Simpan untuk mempertahankannya."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Browser ini menarik langganannya, sehingga koneksi dinonaktifkan. Buka koneksi ini di browser tersebut dan izinkan notifikasi lagi."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Langganan browser ini"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Selama Postulo terbuka"
