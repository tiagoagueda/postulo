#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Push-aadress peab olema HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Tõuketeade läheb läbi teie brauseri valmistaja tõuketeenuse, krüpteerituna, nii et seda ei saa teel lugeda."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Luba selles brauseris teated"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Küsin sellelt brauserilt…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Brauser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Täidetakse siis, kui vajutate „Luba selles brauseris teated“, mis vajab skripte. Jätke see nii, nagu on."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Kuidas see kohale jõuab"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Serverist ei saadeta sel viisil midagi: teated ilmuvad siis, kui Postulo on avatud brauseris, mis need lubas."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Teated on lubatud. See brauser ei saa tõuketeateid vastu võtta, seega ilmuvad need siis, kui Postulo on selles avatud. Salvestage, et see alles jääks."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Teated on seadistatud"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Ainult siis, kui Postulo on avatud, ja miski ei lahku sellest instantsist"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Saadetud tõukena läbi %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Saadetakse tõukena sellesse brauserisse ka siis, kui Postulo on suletud"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Meeldetuletused ja püüdmised jõuavad kohale samal viisil."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Saadetud. See peaks ilmuma brauseris, mis selle lubas."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Näitab teadet teie brauseris: saadetakse sinna tõukena, kui see saab vastu võtta, muidu järgmine kord, kui Postulo on selles avatud."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "See brauser on oma tellimuse tagasi võtnud. Avage see ühendus selles ja lubage teated uuesti."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Push-teenus vastas %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Tellimus ei ole midagi, mille brauser kirjutas."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Tellimuse võtmed ei ole brauseri omad."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "See brauser ei saa siin teateid näidata. Brauserid lubavad neid ainult turvalisel (HTTPS) aadressil."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "See brauser keeldus. Lubage selle saidi teated brauseri seadetes ja proovige uuesti."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "See brauser võtab teateid vastu. Salvestage, et see alles jääks."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "See brauser võttis oma tellimuse tagasi, seega lülitati see välja. Avage see ühendus selles brauseris ja lubage teated uuesti."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Selle brauseri tellimus"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Kui Postulo on avatud"
