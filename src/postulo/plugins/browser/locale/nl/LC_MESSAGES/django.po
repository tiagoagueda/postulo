#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Een pushadres moet HTTPS zijn."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Een push loopt via de pushdienst van de maker van uw browser, versleuteld zodat hij onderweg niet gelezen kan worden."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Meldingen toestaan in deze browser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Deze browser wordt gevraagd…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Browser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Ingevuld wanneer u op ‘Meldingen toestaan in deze browser’ drukt, waarvoor scripts nodig zijn. Laat het zoals het is."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Hoe het aankomt"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Er wordt op deze manier niets vanaf de server verstuurd: meldingen verschijnen terwijl Postulo open staat in een browser die ze heeft toegestaan."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Meldingen zijn toegestaan. Deze browser kan geen pushes ontvangen, dus ze verschijnen terwijl Postulo erin open staat. Sla op om het te behouden."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Meldingen zijn ingesteld"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Alleen terwijl Postulo open staat, en er verlaat niets deze instantie"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Gepusht via %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Gepusht naar deze browser, ook met Postulo gesloten"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Herinneringen en vastleggingen komen op dezelfde manier aan."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Verstuurd. Het zou moeten verschijnen in de browser die het heeft toegestaan."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Toont een melding in uw browser: ernaar gepusht wanneer hij er een kan ontvangen, anders de volgende keer dat Postulo erin open staat."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Die browser heeft zijn abonnement ingetrokken. Open deze verbinding erin en sta meldingen opnieuw toe."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "De pushservice antwoordde %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Het abonnement is niet iets wat een browser heeft geschreven."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "De sleutels van het abonnement zijn niet die van de browser."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Deze browser kan hier geen meldingen tonen. Browsers staan ze alleen toe op een beveiligd (HTTPS) adres."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Deze browser weigerde. Sta meldingen voor deze site toe in zijn instellingen, en probeer het opnieuw."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Deze browser ontvangt meldingen. Sla op om het te behouden."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Deze browser heeft zijn abonnement ingetrokken, dus het is uitgezet. Open deze verbinding in die browser en sta meldingen opnieuw toe."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Het abonnement van deze browser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Terwijl Postulo open staat"
