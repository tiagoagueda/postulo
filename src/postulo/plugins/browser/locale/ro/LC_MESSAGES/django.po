#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "O adresă push trebuie să fie HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "O notificare push trece prin serviciul push al producătorului browserului dumneavoastră, criptată astfel încât să nu poată fi citită pe drum."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Permiteți notificările în acest browser"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Se întreabă acest browser…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Notificări în browser"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Se completează când apăsați „Permiteți notificările în acest browser”, ceea ce necesită scripturi. Lăsați-l așa cum este."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Cum sosește"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Nu se trimite nimic de pe server pe această cale: notificările apar cât timp Postulo este deschis într-un browser care le-a permis."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Notificările sunt permise. Acest browser nu poate primi notificări push, așa că vor apărea cât timp Postulo este deschis în el. Salvați pentru a păstra setarea."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Notificările sunt configurate"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Doar cât timp Postulo este deschis, și nimic nu părăsește această instanță"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Trimis prin %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Trimis către acest browser, chiar și cu Postulo închis"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Mementourile și capturile vor sosi în același fel."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Trimis. Ar trebui să apară în browserul care l-a permis."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Afișează o notificare HTML5 în browserul dumneavoastră: trimisă prin push când o poate primi, altfel data viitoare când Postulo este deschis în el."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Acel browser și-a retras abonamentul. Deschideți această conexiune în el și permiteți din nou notificările."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Serviciul push a răspuns %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Abonamentul nu este ceva scris de un browser."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Cheile abonamentului nu sunt ale browserului."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Acest browser nu poate afișa notificări aici. Browserele le permit doar pe o adresă securizată (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Acest browser a refuzat. Permiteți notificările pentru acest site în setările browserului, apoi încercați din nou."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Acest browser va primi notificări. Salvați pentru a păstra setarea."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Acest browser și-a retras abonamentul, așa că a fost dezactivat. Deschideți această conexiune în acel browser și permiteți din nou notificările."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Abonamentul acestui browser"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Cât timp Postulo este deschis"
