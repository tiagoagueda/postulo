#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Ця електронна адреса повинна бути HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Пуш іде через службу пуш-сповіщень виробника вашого браузера, зашифрований так, що його не прочитати в дорозі."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Дозволити сповіщення в цьому браузері"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Запитуємо цей браузер…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Веб-сайт"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Заповнюється, коли ви натискаєте «Дозволити сповіщення в цьому браузері», для чого потрібні скрипти. Залиште як є."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Як воно надходить"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Таким чином із сервера нічого не надсилається: сповіщення з’являються, поки Postulo відкрито в браузері, який їх дозволив."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Сповіщення дозволено. Цей браузер не може отримувати пуші, тож вони з’являтимуться, поки в ньому відкрито Postulo. Збережіть, щоб так і лишилося."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Сповіщення налаштовано"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Лише поки Postulo відкрито, і ніщо не покидає цю інстанцію"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Надіслано пушем через %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Надсилається пушем у цей браузер, навіть коли Postulo закрито"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Нагадування й захоплення надходитимуть так само."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Надіслано. Воно має з’явитися в браузері, який це дозволив."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Показує сповіщення у вашому браузері: надсилається пушем, коли той може його прийняти, інакше — наступного разу, коли в ньому буде відкрито Postulo."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Той браузер відкликав свою підписку. Відкрийте в ньому це з’єднання й дозвольте сповіщення знову."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Відповідна служба штовхача %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Абонемент – це не те, що записується браузер."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Ключі підписки не є браузером."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Цей браузер не може показувати тут сповіщення. Браузери дозволяють їх лише на захищеній (HTTPS) адресі."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Цей браузер відмовив. Дозвольте сповіщення для цього сайту в його налаштуваннях і спробуйте знову."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Цей браузер отримуватиме сповіщення. Збережіть, щоб так і лишилося."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Цей браузер відкликав свою підписку, тож його вимкнено. Відкрийте це з’єднання в тому браузері й дозвольте сповіщення знову."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Підписка цього браузера"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Поки Postulo відкрито"
