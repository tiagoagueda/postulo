#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Un enderezo push ten que ser HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Unha notificación push pasa polo servizo push do fabricante do teu navegador, cifrada para que non se poida ler polo camiño."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Permitir as notificacións neste navegador"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Preguntándolle a este navegador…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Notificacións do navegador"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Énchese cando premes «Permitir as notificacións neste navegador», o que precisa scripts. Déixao como está."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Como chega"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Por esta vía non se envía nada desde o servidor: as notificacións aparecen mentres o Postulo estea aberto nun navegador que as permitiu."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "As notificacións están permitidas. Este navegador non pode recibir notificacións push, así que aparecerán mentres o Postulo estea aberto nel. Garda para conservalo."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "As notificacións están configuradas"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Só mentres o Postulo estea aberto, e nada sae desta instancia"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Enviada por push a través de %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Enviada por push a este navegador, mesmo co Postulo pechado"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Os recordatorios e as capturas chegarán do mesmo xeito."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Enviado. Debería aparecer no navegador que o permitiu."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Mostra unha notificación HTML5 no teu navegador: enviada por push cando pode recibila e, se non, a próxima vez que o Postulo estea aberto nel."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Ese navegador retirou a súa subscrición. Abre nel esta conexión e permite as notificacións outra vez."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "O servizo push respondeu %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "A subscrición non é algo escrito por un navegador."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "As claves da subscrición non son do navegador."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Este navegador non pode mostrar notificacións aquí. Os navegadores só as permiten nun enderezo seguro (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Este navegador rexeitouno. Permite as notificacións para este sitio na súa configuración e téntao de novo."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Este navegador recibirá notificacións. Garda para conservalo."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Este navegador retirou a súa subscrición, así que se desactivou. Abre esta conexión nese navegador e permite as notificacións de novo."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "A subscrición deste navegador"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Mentres o Postulo estea aberto"
