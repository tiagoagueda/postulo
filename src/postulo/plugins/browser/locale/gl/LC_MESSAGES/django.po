#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Browser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Énchese cando premes «Permitir as notificacións neste navegador», o que precisa scripts. Déixao como está."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Como chega"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Por esta vía non se envía nada desde o servidor: as notificacións aparecen mentres Postulo estea aberto nun navegador que as permitiu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "As notificacións están permitidas. Este navegador non pode recibir notificacións push, así que aparecerán mentres Postulo estea aberto nel. Garda para mantelo."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "As notificacións están configuradas"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
