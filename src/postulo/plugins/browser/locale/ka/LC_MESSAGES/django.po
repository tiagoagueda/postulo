#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Push-მისამართი HTTPS უნდა იყოს."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push-შეტყობინება გადის თქვენი ბრაუზერის მწარმოებლის push-სერვისზე, დაშიფრული, რათა გზაში ვერავინ წაიკითხოს."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "შეტყობინებების დაშვება ამ ბრაუზერში"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "ვეკითხებით ამ ბრაუზერს…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "ბრაუზერის შეტყობინებები"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "ივსება მაშინ, როცა დააჭერთ „შეტყობინებების დაშვება ამ ბრაუზერში“, რისთვისაც საჭიროა სკრიპტები. დატოვეთ ისე, როგორც არის."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "როგორ მოდის"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "ამ გზით სერვერიდან არაფერი იგზავნება: შეტყობინებები ჩნდება მაშინ, როცა Postulo ღიაა ბრაუზერში, რომელმაც ისინი დაუშვა."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "შეტყობინებები დაშვებულია. ამ ბრაუზერს push-შეტყობინებების მიღება არ შეუძლია, ამიტომ ისინი გამოჩნდება მაშინ, როცა Postulo მასში ღიაა. შეინახეთ, რომ დარჩეს."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "შეტყობინებები დაყენებულია"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "მხოლოდ სანამ Postulo ღიაა, და არაფერი გადის ამ ინსტალაციიდან"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Push-ით, %(service)s-ის მეშვეობით"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Push-ით ამ ბრაუზერში, Postulo დახურულიც რომ იყოს"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "შეხსენებები და აღებები იმავე გზით მოვა."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "გაიგზავნა. უნდა გამოჩნდეს იმ ბრაუზერში, რომელმაც დაუშვა."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "აჩვენებს HTML5 შეტყობინებას თქვენს ბრაუზერში: push-ით მიეწოდება, როცა ბრაუზერს მისი მიღება შეუძლია, სხვა შემთხვევაში კი — როცა Postulo მასში შემდეგ ჯერზე გაიხსნება."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "იმ ბრაუზერმა თავისი გამოწერა გააუქმა. გახსენით ეს კავშირი მასში და ხელახლა დაუშვით შეტყობინებები."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Push-სერვისმა უპასუხა: %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "ეს გამოწერა ბრაუზერის შექმნილი არ არის."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "გამოწერის გასაღებები ბრაუზერისა არ არის."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "ამ ბრაუზერს აქ შეტყობინებების ჩვენება არ შეუძლია. ბრაუზერები მათ მხოლოდ დაცულ (HTTPS) მისამართზე უშვებენ."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "ამ ბრაუზერმა უარი თქვა. დაუშვით შეტყობინებები ამ საიტისთვის მის პარამეტრებში და სცადეთ ხელახლა."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "ეს ბრაუზერი მიიღებს შეტყობინებებს. შეინახეთ, რომ დარჩეს."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "ამ ბრაუზერმა თავისი გამოწერა გააუქმა, ამიტომ ის გამოირთო. გახსენით ეს კავშირი იმ ბრაუზერში და ხელახლა დაუშვით შეტყობინებები."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "ამ ბრაუზერის გამოწერა"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "სანამ Postulo ღიაა"
