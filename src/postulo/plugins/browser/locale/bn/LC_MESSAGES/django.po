#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "ব্রাউজার এর সাবস্ক্রিপশন প্রত্যাহার করেছে। এই সংযোগগুলি খুলে পুনরায় চালু করুন এবং পুনরায় বিজ্ঞপ্তি প্রদানের অনুমতি দিন।।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "এই সার্ভিসটি [XXXX] এর উত্তর দেয় ।।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Subscription একটি ব্রাউজার লিখিত হয়নি।।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "সাবস্ক্রিপশনের কি- ব্রাউজার রূপে প্রদর্শন করা হয় না।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "এই ব্রাউজার দ্বারা সূচনাবার্তা প্রদর্শন করা হবে না। ব্রাউজার শুধুমাত্র নিরাপদ ঠিকানার মাধ্যমে ব্রাউজার ব্যবহার করা হয়।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "ব্রাউজার দ্বারা প্রত্যাখ্যাত হয়েছে। এই সাইটের বৈশিষ্ট্যে সূচনাবার্তা প্রদর্শন করা হবে। পুনরায় প্রচেষ্টা করুন।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "ব্রাউজার দ্বারা ঘোষনা প্রদান করা হবে। এটা রেখে দিন।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "এই ব্রাউজারটি এর সাবস্ক্রিপশন প্রত্যাহার করেছে, ফলে এটি বন্ধ করা হয়েছে। ব্রাউজারের মধ্যে এই সংযোগ প্রদর্শন করে পুনরায় আরম্ভ করা হবে।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "এই ব্রাউজারের সাবস্ক্রিপশন"

