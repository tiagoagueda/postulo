#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "পুশ ঠিকানাকে অবশ্যই HTTPS হতে হবে।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "পুশ বার্তা আপনার ব্রাউজার নির্মাতার পুশ পরিষেবার মধ্য দিয়ে যায়, এনক্রিপ্ট করা অবস্থায়, যাতে পথে কেউ পড়তে না পারে।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "এই ব্রাউজারে বিজ্ঞপ্তির অনুমতি দিন"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "এই ব্রাউজারকে জিজ্ঞাসা করা হচ্ছে…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser notifications"
msgstr "ব্রাউজার বিজ্ঞপ্তি"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "আপনি “এই ব্রাউজারে বিজ্ঞপ্তির অনুমতি দিন” চাপলে এটি পূরণ হয়, যার জন্য স্ক্রিপ্ট চালু থাকা দরকার। এটি যেমন আছে তেমনই রাখুন।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "কীভাবে পৌঁছায়"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "এভাবে সার্ভার থেকে কিছুই পাঠানো হয় না: যে ব্রাউজার অনুমতি দিয়েছে, সেখানে Postulo খোলা থাকলে বিজ্ঞপ্তি দেখা যায়।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "বিজ্ঞপ্তির অনুমতি দেওয়া হয়েছে। এই ব্রাউজার পুশ বার্তা গ্রহণ করতে পারে না, তাই এতে Postulo খোলা থাকলে বিজ্ঞপ্তি দেখা যাবে। এটি রাখতে সংরক্ষণ করুন।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "বিজ্ঞপ্তি সেট আপ করা হয়েছে"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "কেবল Postulo খোলা থাকলে, এবং এই ইনস্ট্যান্স থেকে কিছুই বাইরে যায় না"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s-এর মাধ্যমে পুশ করা হয়"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "এই ব্রাউজারে পুশ করা হয়, Postulo বন্ধ থাকলেও"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "অনুস্মারক ও ক্যাপচারও একইভাবে আসবে।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "পাঠানো হয়েছে। যে ব্রাউজার অনুমতি দিয়েছে, সেখানে এটি দেখা যাওয়ার কথা।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "আপনার ব্রাউজারে একটি HTML5 বিজ্ঞপ্তি দেখায়: ব্রাউজার গ্রহণ করতে পারলে এতে পুশ করা হয়, নইলে পরের বার এতে Postulo খোলা হলে দেখানো হয়।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "ওই ব্রাউজারটি তার সাবস্ক্রিপশন প্রত্যাহার করেছে। ওই ব্রাউজারে এই সংযোগটি খুলুন এবং আবার বিজ্ঞপ্তির অনুমতি দিন।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "পুশ পরিষেবা %(status)s উত্তর দিয়েছে।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "সাবস্ক্রিপশনটি কোনো ব্রাউজারের লেখা নয়।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "সাবস্ক্রিপশনের কি-গুলো ব্রাউজারের নয়।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "এই ব্রাউজার এখানে বিজ্ঞপ্তি দেখাতে পারে না। ব্রাউজারগুলো কেবল নিরাপদ (HTTPS) ঠিকানায় এর অনুমতি দেয়।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "এই ব্রাউজার অনুমতি দেয়নি। এর সেটিংসে এই সাইটের জন্য বিজ্ঞপ্তির অনুমতি দিন, তারপর আবার চেষ্টা করুন।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "এই ব্রাউজার বিজ্ঞপ্তি পাবে। এটি রাখতে সংরক্ষণ করুন।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "এই ব্রাউজার তার সাবস্ক্রিপশন প্রত্যাহার করেছে, তাই এটি বন্ধ করা হয়েছে। ওই ব্রাউজারে এই সংযোগটি খুলুন এবং আবার বিজ্ঞপ্তির অনুমতি দিন।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "এই ব্রাউজারের সাবস্ক্রিপশন"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Postulo খোলা থাকাকালীন"
