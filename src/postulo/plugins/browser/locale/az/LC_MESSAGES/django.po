#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Push ünvanı HTTPS olmalıdır."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push bildirişi brauzerinizin istehsalçısının push xidməti vasitəsilə göndərilir və yolda oxunmasın deyə şifrələnir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Bu brauzerdə bildirişlərə icazə ver"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Bu brauzerdən soruşulur…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser notifications"
msgstr "Brauzer bildirişləri"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "«Bu brauzerdə bildirişlərə icazə ver» düyməsini basdığınız zaman doldurulur; bunun üçün skriptlər lazımdır. Olduğu kimi buraxın."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Necə çatdırılır"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Bu üsulla serverdən heç nə göndərilmir: bildirişlər Postulo onlara icazə vermiş brauzerdə açıq olduğu müddətdə görünür."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Bildirişlərə icazə verildi. Bu brauzer push bildirişlərini qəbul edə bilmir, ona görə də bildirişlər Postulo bu brauzerdə açıq olduğu müddətdə görünəcək. Bunu saxlamaq üçün yadda saxlayın."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Bildirişlər ayarlanıb"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Yalnız Postulo açıq olduqda və heç nə bu instansiyadan kənara çıxmır"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s vasitəsilə göndərilir"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Postulo bağlı olsa belə, bu brauzerə push bildirişi kimi göndərilir"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Xatırlatmalar və götürmələr də eyni yolla çatacaq."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Göndərildi. Bildiriş icazə vermiş brauzerdə görünməlidir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Brauzerinizdə HTML5 bildirişi göstərir: brauzer qəbul edə bilirsə, bildiriş ona push edilir, əks halda Postulo orada növbəti dəfə açılanda göstərilir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Həmin brauzer abunəliyini geri götürüb. Bu bağlantını həmin brauzerdə açın və bildirişlərə yenidən icazə verin."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Push xidməti bu cavabı verdi: %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Bu abunəliyi brauzer yazmayıb."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Abunəliyin açarları brauzerə aid deyil."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Bu brauzer burada bildiriş göstərə bilmir. Brauzerlər bildirişlərə yalnız təhlükəsiz (HTTPS) ünvanda icazə verir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Bu brauzer imtina etdi. Brauzerin ayarlarında bu sayt üçün bildirişlərə icazə verin, sonra yenidən cəhd edin."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Bu brauzer bildirişləri qəbul edəcək. Bunu saxlamaq üçün yadda saxlayın."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Bu brauzer abunəliyini geri götürdü, ona görə də bağlantı deaktiv edildi. Bu bağlantını həmin brauzerdə açın və bildirişlərə yenidən icazə verin."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Bu brauzerin abunəliyi"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Postulo açıq olduqda"
