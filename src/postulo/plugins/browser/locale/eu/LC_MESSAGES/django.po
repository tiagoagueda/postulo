#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Push helbideak HTTPS izan behar du."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push jakinarazpen bat zure nabigatzailearen fabrikatzailearen push zerbitzutik igarotzen da, zifratuta, bidean irakurri ezin izateko."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Baimendu jakinarazpenak nabigatzaile honetan"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Nabigatzaile honi eskatzen…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Nabigatzailearen jakinarazpenak"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "«Baimendu jakinarazpenak nabigatzaile honetan» sakatzean betetzen da, eta horrek script-ak behar ditu. Utzi dagoen moduan."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Nola iristen den"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Bide honetatik zerbitzariak ez du ezer bidaltzen: jakinarazpenak Postulo irekita dagoen bitartean agertzen dira, jakinarazpenak baimendu dituen nabigatzaile batean."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Jakinarazpenak baimenduta daude. Nabigatzaile honek ezin ditu push jakinarazpenak jaso, beraz, Postulo bertan irekita dagoen bitartean agertuko dira. Gorde hori mantentzeko."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Jakinarazpenak konfiguratuta daude"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Postulo irekita dagoen bitartean soilik, eta ezer ez da instantzia honetatik ateratzen"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s bidez bidalia"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Nabigatzaile honetara bidalia, Postulo itxita egonda ere"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Oroigarriak eta kapturak modu berean iritsiko dira."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Bidalita. Baimena eman duen nabigatzailean agertu beharko luke."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "HTML5 jakinarazpen bat erakusten du zure nabigatzailean: push bidez bidaltzen zaio jaso dezakeenean, eta bestela Postulo bertan irekitzen den hurrengo aldian."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Nabigatzaile horrek harpidetza kendu du. Ireki bertan konexio hau eta baimendu jakinarazpenak berriro."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Push zerbitzuak %(status)s egoerarekin erantzun du."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Harpidetza ez da nabigatzaile batek idatzitakoa."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Harpidetzaren gakoak ez dira nabigatzailearenak."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Nabigatzaile honek ezin ditu jakinarazpenak hemen erakutsi. Nabigatzaileek helbide seguru batean (HTTPS) bakarrik baimentzen dituzte."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Nabigatzaile honek ukatu egin du. Baimendu jakinarazpenak gune honetarako haren ezarpenetan, eta saiatu berriro."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Nabigatzaile honek jakinarazpenak jasoko ditu. Gorde hori mantentzeko."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Nabigatzaile honek harpidetza kendu du, eta, beraz, itzali egin da. Ireki konexio hau nabigatzaile horretan eta baimendu jakinarazpenak berriro."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Nabigatzaile honen harpidetza"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Postulo irekita dagoen bitartean"
