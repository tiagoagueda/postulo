#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Adresa push musí být HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push oznámení jde přes push službu výrobce vašeho prohlížeče, zašifrované tak, aby ho cestou nebylo možné přečíst."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Povolit oznámení v tomto prohlížeči"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Dotaz na tento prohlížeč…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Oznámení v prohlížeči"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Vyplní se, když stisknete „Povolit oznámení v tomto prohlížeči“, což vyžaduje skripty. Nechte to tak, jak to je."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Jak přichází"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Takto se ze serveru nic neodesílá: oznámení se objevují, dokud je Postulo otevřené v prohlížeči, který je povolil."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Oznámení jsou povolena. Tento prohlížeč neumí přijímat push oznámení, takže se budou zobrazovat, dokud v něm bude Postulo otevřené. Nastavení zachováte uložením."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Oznámení jsou nastavena"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Jen dokud je Postulo otevřené, a nic neopouští tuto instanci"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Doručováno přes push službu %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Doručováno přes push do tohoto prohlížeče, i když je Postulo zavřené"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Připomenutí a zachycení budou přicházet stejnou cestou."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Odesláno. Mělo by se objevit v prohlížeči, který to povolil."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Zobrazí oznámení HTML5 ve vašem prohlížeči: doručí ho přes push, pokud to prohlížeč umí, jinak při příštím otevření Postulo v tomto prohlížeči."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Tento prohlížeč svůj odběr zrušil. Otevřete v něm toto připojení a znovu povolte oznámení."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Služba push odpověděla %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Odběr nepochází z prohlížeče."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Klíče odběru nejsou klíče prohlížeče."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Tento prohlížeč zde nemůže zobrazovat oznámení. Prohlížeče je povolují jen na zabezpečené (HTTPS) adrese."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Tento prohlížeč to odmítl. Povolte oznámení pro tento web v jeho nastavení a zkuste to znovu."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Tento prohlížeč bude přijímat oznámení. Nastavení zachováte uložením."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Tento prohlížeč zrušil svůj odběr, a proto bylo připojení vypnuto. Otevřete toto připojení v daném prohlížeči a znovu povolte oznámení."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Odběr tohoto prohlížeče"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Dokud je Postulo otevřené"
