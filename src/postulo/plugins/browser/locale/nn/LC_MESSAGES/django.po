#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Ei push-adresse må vere HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Eit push-varsel går gjennom push-tenesta til produsenten av nettlesaren din, kryptert slik at det ikkje kan lesast på vegen."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Tillat varsel i denne nettlesaren"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Spør denne nettlesaren…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser notifications"
msgstr "Nettlesarvarsel"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Blir fylt ut når du trykkjer på «Tillat varsel i denne nettlesaren», som krev skript. La det stå som det er."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Korleis det kjem fram"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Ingenting blir sendt frå tenaren på denne måten: varsla kjem fram medan Postulo er ope i ein nettlesar som har tillate dei."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Varsel er tillatne. Denne nettlesaren kan ikkje ta imot push-varsel, så varsla kjem fram medan Postulo er ope i han. Lagre for å behalde det."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Varsla er sette opp"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Berre medan Postulo er ope, og ingenting går ut av denne instansen"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Sendt som push via %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Sendt som push til denne nettlesaren, sjølv når Postulo er lukka"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Påminningar og innhentingar kjem fram på same måten."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Sendt. Det skal dukke opp i nettlesaren som tillét det."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Viser eit HTML5-varsel i nettlesaren din: sendt som push når nettlesaren kan ta imot det, elles neste gong Postulo er ope i han."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Den nettlesaren har trekt tilbake abonnementet sitt. Opne denne tilkoplinga i han og tillat varsel på nytt."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Push-tenesta svarte %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Abonnementet er ikkje noko ein nettlesar har skrive."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Nøklane i abonnementet er ikkje nøklane til nettlesaren."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Denne nettlesaren kan ikkje vise varsel her. Nettlesarar tillèt dei berre på ei trygg adresse (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Denne nettlesaren sa nei. Tillat varsel for denne nettstaden i innstillingane til nettlesaren, og prøv så igjen."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Denne nettlesaren vil få varsel. Lagre for å behalde det."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Denne nettlesaren trekte tilbake abonnementet sitt, så tilkoplinga vart slått av. Opne denne tilkoplinga i den nettlesaren og tillat varsel på nytt."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Abonnementet til denne nettlesaren"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Medan Postulo er ope"
