#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Μια διεύθυνση push πρέπει να είναι HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Μια ειδοποίηση push περνά από την υπηρεσία push του κατασκευαστή του προγράμματος περιήγησής σας, κρυπτογραφημένη ώστε να μην μπορεί να διαβαστεί στη διαδρομή."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Να επιτρέπονται οι ειδοποιήσεις σε αυτό το πρόγραμμα περιήγησης"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Ερώτηση προς αυτό το πρόγραμμα περιήγησης…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Ειδοποιήσεις προγράμματος περιήγησης"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Συμπληρώνεται όταν πατήσετε «Να επιτρέπονται οι ειδοποιήσεις σε αυτό το πρόγραμμα περιήγησης», κάτι που απαιτεί σενάρια (JavaScript). Αφήστε το όπως είναι."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Πώς φτάνουν"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Με αυτόν τον τρόπο δεν στέλνεται τίποτα από τον διακομιστή: οι ειδοποιήσεις εμφανίζονται όσο το Postulo είναι ανοιχτό σε ένα πρόγραμμα περιήγησης που τις έχει επιτρέψει."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Οι ειδοποιήσεις επιτρέπονται. Αυτό το πρόγραμμα περιήγησης δεν μπορεί να λαμβάνει ειδοποιήσεις push, οπότε θα εμφανίζονται όσο το Postulo είναι ανοιχτό σε αυτό. Κάντε αποθήκευση για να διατηρηθεί η ρύθμιση."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Οι ειδοποιήσεις έχουν ρυθμιστεί"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Μόνο όσο το Postulo είναι ανοιχτό, και τίποτα δεν φεύγει από αυτή την εγκατάσταση"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Push μέσω %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Push σε αυτό το πρόγραμμα περιήγησης, ακόμη και με το Postulo κλειστό"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Οι υπενθυμίσεις και οι καταγραφές θα φτάνουν με τον ίδιο τρόπο."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Στάλθηκε. Θα πρέπει να εμφανιστεί στο πρόγραμμα περιήγησης που επέτρεψε τις ειδοποιήσεις."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Εμφανίζει μια ειδοποίηση HTML5 στο πρόγραμμα περιήγησής σας: αποστέλλεται ως push όταν μπορεί να τη λάβει, διαφορετικά την επόμενη φορά που το Postulo είναι ανοιχτό σε αυτό."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Εκείνο το πρόγραμμα περιήγησης απέσυρε τη συνδρομή του. Ανοίξτε αυτή τη σύνδεση σε εκείνο και επιτρέψτε ξανά τις ειδοποιήσεις."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Η υπηρεσία push απάντησε %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Η συνδρομή δεν είναι κάτι που δημιούργησε πρόγραμμα περιήγησης."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Τα κλειδιά της συνδρομής δεν ανήκουν στο πρόγραμμα περιήγησης."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Αυτό το πρόγραμμα περιήγησης δεν μπορεί να εμφανίσει ειδοποιήσεις εδώ. Τα προγράμματα περιήγησης τις επιτρέπουν μόνο σε ασφαλή (HTTPS) διεύθυνση."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Αυτό το πρόγραμμα περιήγησης αρνήθηκε. Επιτρέψτε τις ειδοποιήσεις για αυτόν τον ιστότοπο στις ρυθμίσεις του και μετά δοκιμάστε ξανά."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Αυτό το πρόγραμμα περιήγησης θα λαμβάνει ειδοποιήσεις. Κάντε αποθήκευση για να διατηρηθεί η ρύθμιση."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Αυτό το πρόγραμμα περιήγησης απέσυρε τη συνδρομή του, οπότε απενεργοποιήθηκε. Ανοίξτε αυτή τη σύνδεση σε εκείνο το πρόγραμμα περιήγησης και επιτρέψτε ξανά τις ειδοποιήσεις."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Η συνδρομή αυτού του προγράμματος περιήγησης"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Όσο το Postulo είναι ανοιχτό"
