#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Push adresei jābūt HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Paziņojums iet caur jūsu pārlūka ražotāja nosūtīšanas dienestu, šifrēts tā, lai ceļā to nevarētu izlasīt."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Atļaut paziņojumus šajā pārlūkā"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Notiek vaicāšana šim pārlūkam…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Pārlūks"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Tiek aizpildīts, kad nospiežat “Atļaut paziņojumus šajā pārlūkā”, kam nepieciešami skripti. Atstājiet, kā ir."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Kā tas pienāk"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Šādā veidā no servera netiek sūtīts nekas: paziņojumi parādās, kamēr Postulo ir atvērts pārlūkā, kas tos atļāvis."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Paziņojumi ir atļauti. Šis pārlūks nevar saņemt sūtījumus, tāpēc tie parādīsies, kamēr Postulo tajā ir atvērts. Saglabājiet, lai tas paliktu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Paziņojumi ir iestatīti"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Tikai kamēr Postulo ir atvērts, un nekas neatstāj šo instanci"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Nosūtīts caur %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Nosūtīts uz šo pārlūku, pat ar aizvērtu Postulo"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Atgādinājumi un tvērumi pienāks tāpat."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Nosūtīts. Tam vajadzētu parādīties pārlūkā, kas to atļāva."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Rāda paziņojumu jūsu pārlūkā: nosūta uz to, kad tas var saņemt, citādi — nākamajā reizē, kad Postulo tajā būs atvērts."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Tas pārlūks ir atsaucis savu abonementu. Atveriet tajā šo savienojumu un atļaujiet paziņojumus no jauna."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Push pakalpojums atbildēja %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Abonements nav kaut kas, ko uzrakstījis pārlūks."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Abonementa atslēgas nav pārlūka."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Šis pārlūks šeit nevar rādīt paziņojumus. Pārlūki tos atļauj tikai drošā (HTTPS) adresē."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Šis pārlūks atteica. Tā iestatījumos atļaujiet paziņojumus šai vietnei un mēģiniet vēlreiz."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Šis pārlūks saņems paziņojumus. Saglabājiet, lai tas paliktu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Šis pārlūks atsauca savu abonementu, tāpēc tas tika izslēgts. Atveriet šo savienojumu tajā pārlūkā un atļaujiet paziņojumus no jauna."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Šī pārlūka abonements"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Kamēr Postulo ir atvērts"
