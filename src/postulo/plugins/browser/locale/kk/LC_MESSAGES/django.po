#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Push мекенжайы HTTPS болуы керек."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push хабарландыруы браузеріңізді шығарушының push қызметі арқылы өтеді және жолда оқылмайтындай шифрланады."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Осы браузерде хабарландыруларға рұқсат беру"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Осы браузерден сұралып жатыр…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Браузер хабарландырулары"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "«Осы браузерде хабарландыруларға рұқсат беру» түймесін басқанда толтырылады, бұл үшін скрипттер қажет. Өзгертпей қалдырыңыз."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Қалай жеткізіледі"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Бұл тәсілмен серверден ештеңе жіберілмейді: хабарландырулар оларға рұқсат берген браузерде Postulo ашық тұрғанда көрсетіледі."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Хабарландыруларға рұқсат берілді. Бұл браузер push хабарландыруларын қабылдай алмайды, сондықтан олар Postulo осы браузерде ашық тұрғанда көрсетіледі. Сақтап қою үшін «Сақтау» түймесін басыңыз."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Хабарландырулар реттелді"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Тек Postulo ашық тұрғанда; осы данадан ештеңе шықпайды"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s қызметі арқылы жіберіледі"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Postulo жабық болса да, осы браузерге жіберіледі"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Еске салғыштар мен түсірілімдер де осылай келеді."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Жіберілді. Хабарландыру оған рұқсат берген браузерде көрсетілуі керек."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Браузеріңізде HTML5 хабарландыруын көрсетеді: мүмкін болса, ол push арқылы жіберіледі, әйтпесе Postulo сол браузерде келесі рет ашылғанда көрсетіледі."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Ол браузер жазылымын кері алды. Осы қосылымды сол браузерде ашып, хабарландыруларға қайта рұқсат беріңіз."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Push қызметінің жауабы: %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Бұл жазылымды браузер жазбаған."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Жазылым кілттері браузерге тиесілі емес."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Бұл браузер мұнда хабарландыруларды көрсете алмайды. Браузерлер оларға тек қауіпсіз (HTTPS) мекенжайда рұқсат береді."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Бұл браузер рұқсат бермеді. Браузер параметрлерінде осы сайт үшін хабарландыруларға рұқсат беріп, қайталап көріңіз."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Бұл браузер хабарландыруларды алады. Сақтап қою үшін «Сақтау» түймесін басыңыз."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Бұл браузер жазылымын кері алды, сондықтан ол сөндірілді. Осы қосылымды сол браузерде ашып, хабарландыруларға қайта рұқсат беріңіз."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Осы браузердің жазылымы"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Postulo ашық тұрғанда"
