#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Una dirección push tiene que ser HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Una notificación push pasa por el servicio push del fabricante de tu navegador, cifrada para que no se pueda leer en el camino."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Permitir notificaciones en este navegador"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Preguntando a este navegador…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Notificaciones del navegador"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Se llena cuando presionas \"Permitir notificaciones en este navegador\", lo cual necesita scripts. Déjalo como está."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Cómo llega"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Por esta vía no se envía nada desde el servidor: las notificaciones aparecen mientras Postulo está abierto en un navegador que las permitió."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Las notificaciones están permitidas. Este navegador no puede recibir notificaciones push, así que aparecerán mientras Postulo esté abierto en él. Guarda para conservarlo."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Las notificaciones están configuradas"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Solo mientras Postulo está abierto, y nada sale de esta instancia"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Enviado por push a través de %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Enviado por push a este navegador, incluso con Postulo cerrado"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Los recordatorios y las capturas llegarán de la misma manera."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Enviado. Debería aparecer en el navegador que lo permitió."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Muestra una notificación HTML5 en tu navegador: se le envía por push cuando puede recibirla y, si no, la próxima vez que Postulo esté abierto en él."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Ese navegador retiró su suscripción. Abre esta conexión en él y vuelve a permitir las notificaciones."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "El servicio push respondió %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "La suscripción no es algo que haya escrito un navegador."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Las claves de la suscripción no son las del navegador."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Este navegador no puede mostrar notificaciones aquí. Los navegadores solo las permiten en una dirección segura (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Este navegador lo rechazó. Permite las notificaciones para este sitio en su configuración y vuelve a intentarlo."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Este navegador recibirá notificaciones. Guarda para conservarlo."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Este navegador retiró su suscripción, así que se desactivó. Abre esta conexión en ese navegador y vuelve a permitir las notificaciones."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Suscripción de este navegador"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Mientras Postulo está abierto"
