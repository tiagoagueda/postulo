#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "In'adressa push sto esser HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Ina communicaziun push passa tras il servetsch push dal producent da Voss navigatur, criptada uschia ch'ella na po betg vegnir legida per via."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Permetter communicaziuns en quest navigatur"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Il navigatur vegn dumandà…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Communicaziuns en il navigatur"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Vegn emplenì cura che Vus smatgais «Permetter communicaziuns en quest navigatur», quai che dovra scripts. Laschai sco ch'igl è."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Co ch'ella arriva"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Uschia na vegn nagut tramess dal server: las communicaziuns cumparan durant che Postulo è avert en in navigatur che las ha permessas."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Las communicaziuns èn permessas. Quest navigatur na po betg retschaiver communicaziuns push, perquai cumparan ellas durant che Postulo è avert en el. Arcunai per las mantegnair."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Las communicaziuns èn configuradas"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Mo durant che Postulo è avert, e nagut na banduna questa instanza"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Tramess via %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Tramess a quest navigatur, era cun Postulo serrà"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Promemorias e capturas arrivan sin la medema moda."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Tramess. La communicaziun duess cumparair en il navigatur che l'ha permessa."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Mussa ina communicaziun HTML5 en Voss navigatur: tramessa directamain sch'el po retschaiver ina, uschiglio la proxima giada che Postulo è avert en el."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Quel navigatur ha retratg sia abunaziun. Avri questa connexiun en el e permettai danovamain las communicaziuns."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Il servetsch push ha respundì %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "L'abunaziun n'è betg vegnida scritta d'in navigatur."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Las clavs da l'abunaziun n'èn betg quellas dal navigatur."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Quest navigatur na po betg mussar communicaziuns qua. Ils navigaturs las permettan mo sin ina adressa segira (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Quest navigatur ha refusà. Permettai las communicaziuns per questa website en ses parameters ed empruvai lura anc ina giada."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Quest navigatur vegn a retschaiver communicaziuns. Arcunai per mantegnair quai."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Quest navigatur ha retratg sia abunaziun, perquai è ella vegnida deactivada. Avri questa connexiun en quel navigatur e permettai danovamain las communicaziuns."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Abunaziun da quest navigatur"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Durant che Postulo è avert"
