#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push prolazi kroz push-servis proizvođača vašeg preglednika, šifrovan tako da se usput ne može pročitati."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Dozvoli obavještenja u ovom pregledniku"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Pitamo ovaj preglednik…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser"
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Popunjava se kada pritisnete „Dozvoli obavještenja u ovom pregledniku“, za šta su potrebne skripte. Ostavite kako jeste."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Kako stiže"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Ništa se ovim putem ne šalje sa servera: obavještenja se pojavljuju dok je Postulo otvoren u pregledniku koji ih je dozvolio."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Obavještenja su dozvoljena. Ovaj preglednik ne može primati push poruke, pa će se pojavljivati dok je Postulo otvoren u njemu. Sačuvajte da to ostane."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Obavještenja su podešena"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Samo dok je Postulo otvoren, i ništa ne napušta ovu instancu"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Push preko %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Push u ovaj preglednik, čak i kada je Postulo zatvoren"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Podsjetnici i hvatanja stizat će na isti način."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Poslano. Trebalo bi da se pojavi u pregledniku koji je to dozvolio."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Prikazuje obavještenje u vašem pregledniku: pushom kada može da ga primi, u suprotnom sljedeći put kada Postulo bude otvoren u njemu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Taj preglednik je povukao svoju pretplatu. Otvorite ovu vezu u njemu i ponovo dozvolite obavještenja."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr ""

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr ""

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Ovaj preglednik ovdje ne može prikazivati obavještenja. Preglednici ih dozvoljavaju samo na sigurnoj (HTTPS) adresi."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Ovaj preglednik je odbio. Dozvolite obavještenja za ovaj sajt u njegovim postavkama, pa pokušajte ponovo."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Ovaj preglednik će primati obavještenja. Sačuvajte da to ostane."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Ovaj preglednik je povukao svoju pretplatu, pa je isključeno. Otvorite ovu vezu u tom pregledniku i ponovo dozvolite obavještenja."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Pretplata ovog preglednika"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
