#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Адрас для push-апавяшчэнняў павінен быць HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push-апавяшчэнне праходзіць праз push-сэрвіс вытворцы вашага браўзера ў зашыфраваным выглядзе, таму па дарозе яго нельга прачытаць."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Дазволіць апавяшчэнні ў гэтым браўзеры"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Звяртаемся да гэтага браўзера…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser notifications"
msgstr "Апавяшчэнні ў браўзеры"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Запаўняецца, калі вы націскаеце «Дазволіць апавяшчэнні ў гэтым браўзеры»; для гэтага патрэбныя скрыпты. Пакіньце як ёсць."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Спосаб дастаўкі"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Сервер гэтым спосабам нічога не адпраўляе: апавяшчэнні з'яўляюцца, пакуль Postulo адкрыты ў браўзеры, які іх дазволіў."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Апавяшчэнні дазволены. Гэты браўзер не можа атрымліваць push-апавяшчэнні, таму яны будуць з'яўляцца, пакуль у ім адкрыты Postulo. Захавайце, каб гэта пакінуць."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Апавяшчэнні наладжаны"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Толькі пакуль Postulo адкрыты, і нічога не пакідае гэтае ўсталяванне"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Дастаўляецца праз %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Дастаўляецца ў гэты браўзер, нават калі Postulo закрыты"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Напаміны і захопы будуць прыходзіць гэтак жа."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Адпраўлена. Апавяшчэнне павінна з'явіцца ў браўзеры, які яго дазволіў."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Паказвае апавяшчэнне HTML5 у вашым браўзеры: дасылае яго туды, калі браўзер можа яго атрымаць, інакш — наступным разам, калі ў ім адкрыюць Postulo."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Той браўзер адклікаў сваю падпіску. Адкрыйце ў ім гэтае падключэнне і зноў дазвольце апавяшчэнні."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Push-сэрвіс адказаў: %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Гэтую падпіску напісаў не браўзер."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Ключы падпіскі не належаць браўзеру."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Гэты браўзер не можа паказваць тут апавяшчэнні. Браўзеры дазваляюць іх толькі на абароненым (HTTPS) адрасе."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Гэты браўзер адмовіў. Дазвольце апавяшчэнні для гэтага сайта ў яго наладах і паспрабуйце зноў."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Гэты браўзер будзе атрымліваць апавяшчэнні. Захавайце, каб гэта пакінуць."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Гэты браўзер адклікаў сваю падпіску, таму падключэнне выключана. Адкрыйце гэтае падключэнне ў тым браўзеры і зноў дазвольце апавяшчэнні."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Падпіска гэтага браўзера"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Пакуль Postulo адкрыты"
