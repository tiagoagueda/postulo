#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Adresa za push mora biti HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Push obavijest ide kroz push uslugu proizvođača vašeg preglednika, šifrirana tako da se putem ne može pročitati."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Dopusti obavijesti u ovom pregledniku"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Pitam ovaj preglednik…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Obavijesti u pregledniku"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Popunjava se kad pritisnete „Dopusti obavijesti u ovom pregledniku“, za što su potrebne skripte. Ostavite kako jest."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Kako stiže"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Ovim putem sa servera ne šalje se ništa: obavijesti se pojavljuju dok je Postulo otvoren u pregledniku koji ih je dopustio."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Obavijesti su dopuštene. Ovaj preglednik ne može primati push obavijesti, pa će se pojavljivati dok je Postulo u njemu otvoren. Spremite da ostane tako."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Obavijesti su postavljene"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Samo dok je Postulo otvoren i ništa ne napušta ovu instancu"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Poslano push uslugom %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Šalje se u ovaj preglednik i kad je Postulo zatvoren"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Podsjetnici i uhvaćeni oglasi stizat će na isti način."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Poslano. Trebalo bi se pojaviti u pregledniku koji je to dopustio."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Prikazuje HTML5 obavijest u vašem pregledniku: šalje mu se odmah kad je može primiti, a inače sljedeći put kad je Postulo u njemu otvoren."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Taj je preglednik povukao svoju pretplatu. Otvorite ovu vezu u njemu i ponovno dopustite obavijesti."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Push usluga je odgovorila: %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "Pretplata nije nešto što je napisao preglednik."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "Ključevi pretplate nisu ključevi preglednika."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Ovaj preglednik ovdje ne može prikazivati obavijesti. Preglednici ih dopuštaju samo na sigurnoj (HTTPS) adresi."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Ovaj je preglednik odbio. Dopustite obavijesti za ovu stranicu u njegovim postavkama pa pokušajte ponovno."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Ovaj će preglednik primati obavijesti. Spremite da ostane tako."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Ovaj je preglednik povukao svoju pretplatu pa je isključen. Otvorite ovu vezu u tom pregledniku i ponovno dopustite obavijesti."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Pretplata ovog preglednika"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Dok je Postulo otvoren"
