#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Пушот поминува низ пуш-сервисот на производителот на вашиот прелистувач, шифриран така што не може да се прочита по патот."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Дозволи известувања во овој прелистувач"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Го прашуваме овој прелистувач…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser"
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Се пополнува кога ќе притиснете „Дозволи известувања во овој прелистувач“, за што се потребни скрипти. Оставете го како што е."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Како пристигнува"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Ништо не се испраќа од серверот на овој начин: известувањата се појавуваат додека Postulo е отворен во прелистувач што ги дозволил."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Известувањата се дозволени. Овој прелистувач не може да прима пуш пораки, па тие ќе се појавуваат додека Postulo е отворен во него. Зачувајте за да остане така."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Известувањата се поставени"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Само додека Postulo е отворен, и ништо не ја напушта оваа инстанца"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Пуш преку %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Пуш во овој прелистувач, дури и кога Postulo е затворен"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Потсетниците и фаќањата ќе пристигнуваат на истиот начин."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Испратено. Треба да се појави во прелистувачот што го дозволил тоа."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Прикажува известување во вашиот прелистувач: со пуш кога може да прими, инаку следниот пат кога Postulo ќе биде отворен во него."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Тој прелистувач ја повлече својата претплата. Отворете ја оваа врска во него и повторно дозволете известувања."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr ""

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr ""

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Овој прелистувач не може да прикажува известувања овде. Прелистувачите ги дозволуваат само на безбедна (HTTPS) адреса."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Овој прелистувач одби. Дозволете известувања за оваа страница во неговите поставки, па обидете се повторно."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Овој прелистувач ќе прима известувања. Зачувајте за да остане така."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Овој прелистувач ја повлече својата претплата, па беше исклучен. Отворете ја оваа врска во тој прелистувач и повторно дозволете известувања."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Претплатата на овој прелистувач"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Додека Postulo е отворен"
