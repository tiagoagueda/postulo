#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "En push går gjennom pushtjenesten til produsenten av nettleseren din, kryptert slik at den ikke kan leses underveis."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Tillat varsler i denne nettleseren"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Spør denne nettleseren…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser"
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Fylles inn når du trykker «Tillat varsler i denne nettleseren», som krever skript. La det stå som det er."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Hvordan det kommer fram"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Ingenting sendes fra tjeneren på denne måten: varsler vises mens Postulo er åpent i en nettleser som har tillatt dem."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Varsler er tillatt. Denne nettleseren kan ikke ta imot push, så de vises mens Postulo er åpent i den. Lagre for å beholde det."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Varsler er satt opp"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Bare mens Postulo er åpent, og ingenting forlater denne installasjonen"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Sendt som push via %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Sendt som push til denne nettleseren, også når Postulo er lukket"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Påminnelser og fangster kommer fram på samme måte."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Sendt. Det bør dukke opp i nettleseren som tillot det."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Viser et varsel i nettleseren din: sendt som push når den kan ta imot det, ellers neste gang Postulo er åpent i den."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Den nettleseren har trukket tilbake abonnementet sitt. Åpne denne tilkoblingen i den og tillat varsler på nytt."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr ""

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr ""

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr ""

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Denne nettleseren kan ikke vise varsler her. Nettlesere tillater dem bare på en sikker adresse (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Denne nettleseren nektet. Tillat varsler for dette nettstedet i innstillingene, og prøv igjen."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Denne nettleseren vil ta imot varsler. Lagre for å beholde det."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Denne nettleseren trakk tilbake abonnementet sitt, så den ble slått av. Åpne denne tilkoblingen i den nettleseren og tillat varsler på nytt."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Abonnementet til denne nettleseren"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
