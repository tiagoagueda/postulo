#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "A push-címnek HTTPS-nek kell lennie."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "A push értesítés a böngészője gyártójának push-szolgáltatásán keresztül halad, titkosítva, hogy útközben ne lehessen elolvasni."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Értesítések engedélyezése ebben a böngészőben"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "A böngésző megkérdezése…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Böngészőértesítések"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Akkor töltődik ki, amikor megnyomja az „Értesítések engedélyezése ebben a böngészőben” gombot, amihez szkriptek szükségesek. Hagyja úgy, ahogy van."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Hogyan érkezik"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "A kiszolgálóról így nem megy ki semmi: az értesítések akkor jelennek meg, amikor a Postulo nyitva van egy olyan böngészőben, amely engedélyezte őket."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Az értesítések engedélyezve vannak. Ez a böngésző nem tud push értesítést fogadni, ezért azok akkor jelennek meg, amikor a Postulo nyitva van benne. Mentse el, hogy így maradjon."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Az értesítések be vannak állítva"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Csak amíg a Postulo nyitva van, és semmi nem hagyja el ezt a példányt"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Push értesítés a(z) %(service)s szolgáltatáson át"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Push értesítésként érkezik ebbe a böngészőbe, akkor is, ha a Postulo be van zárva"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Az emlékeztetők és a rögzítések ugyanígy érkeznek majd."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Elküldve. Meg kell jelennie abban a böngészőben, amely engedélyezte."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "HTML5-értesítést jelenít meg a böngészőben: push értesítésként küldi, ha a böngésző fogadni tudja, egyébként a Postulo következő megnyitásakor jelenik meg benne."

#: src/postulo/plugins/browser/__init__.py
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Az a böngésző visszavonta a feliratkozását. Nyissa meg benne ezt a kapcsolatot, és engedélyezze újra az értesítéseket."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "A push-szolgáltatás ezt válaszolta: %(status)s."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription is not something a browser wrote."
msgstr "A feliratkozás nem böngészőtől származik."

#: src/postulo/plugins/browser/webpush.py
msgid "The subscription's keys are not the browser's."
msgstr "A feliratkozás kulcsai nem a böngészőtől származnak."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Ez a böngésző itt nem tud értesítéseket megjeleníteni. A böngészők csak biztonságos (HTTPS) címen engedélyezik őket."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Ez a böngésző elutasította a kérést. Engedélyezze az értesítéseket ehhez a webhelyhez a böngésző beállításaiban, majd próbálja újra."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Ez a böngésző fogadni fogja az értesítéseket. Mentse el, hogy így maradjon."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Ez a böngésző visszavonta a feliratkozását, ezért ki lett kapcsolva. Nyissa meg abban a böngészőben ezt a kapcsolatot, és engedélyezze újra az értesítéseket."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser's subscription"
msgstr "Ennek a böngészőnek a feliratkozása"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Amíg a Postulo nyitva van"
