#: src/postulo/plugins/browser/webpush.py
msgid "A push address has to be HTTPS."
msgstr "Ein push-vevbústaður má vera HTTPS."

#: src/postulo/plugins/browser/__init__.py
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Ein push-fráboðan fer gjøgnum push-tænastuna hjá framleiðaranum av kaganum hjá tær, bronglað, so at hon ikki kann lesast á vegnum."

#: src/postulo/plugins/browser/__init__.py
msgid "Allow notifications in this browser"
msgstr "Loyv fráboðanum í hesum kaganum"

#: src/postulo/plugins/browser/__init__.py
msgid "Asking this browser…"
msgstr "Spyr hendan kagan…"

#: src/postulo/plugins/browser/__init__.py
msgid "Browser notifications"
msgstr "Fráboðanir í kaganum"

#: src/postulo/plugins/browser/__init__.py
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Fylt út, tá ið tú trýstir á „Loyv fráboðanum í hesum kaganum“, sum krevur skript. Lat tað vera, sum tað er."

#: src/postulo/plugins/browser/__init__.py
msgid "How it arrives"
msgstr "Hvussu tað kemur"

#: src/postulo/plugins/browser/__init__.py
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Einki verður sent frá ambætaranum á henda hátt: fráboðanir koma fram, meðan Postulo er opið í einum kaga, sum hevur loyvt teimum."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Fráboðanir eru loyvdar. Hesin kagin kann ikki taka ímóti push-fráboðanum, so tær koma fram, meðan Postulo er opið í honum. Goym fyri at varðveita tað."

#: src/postulo/plugins/browser/__init__.py
msgid "Notifications are set up"
msgstr "Fráboðanir eru settar upp"

#: src/postulo/plugins/browser/__init__.py
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Bert meðan Postulo er opið, og einki fer út av hesi uppsetingini"

#: src/postulo/plugins/browser/__init__.py
#, python-format
msgid "Pushed through %(service)s"
msgstr "Sent gjøgnum %(service)s"

#: src/postulo/plugins/browser/__init__.py
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Sent til hendan kagan, eisini tá ið Postulo er latið aftur"

#: src/postulo/plugins/browser/__init__.py
msgid "Reminders and captures will arrive the same way."
msgstr "Áminningar og fangingar koma á sama hátt."

#: src/postulo/plugins/browser/__init__.py
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Sent. Tað eigur at koma fram í kaganum, sum loyvdi tí."

#: src/postulo/plugins/browser/__init__.py
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Vísir eina HTML5-fráboðan í kaganum hjá tær: send til hansara, tá ið hann kann taka ímóti henni, annars næstu ferð Postulo er opið í honum."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Hasin kagin hevur tikið hald sítt aftur. Lat hetta sambandið upp í honum og loyv fráboðanum aftur."

#: src/postulo/plugins/browser/webpush.py
#, python-format
msgid "The push service answered %(status)s."
msgstr "Push-tænastan svaraði %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Haldið er ikki nakað, sum ein kagi hevur skrivað."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Lyklarnir í haldinum eru ikki kagans."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Hesin kagin kann ikki vísa fráboðanir her. Kagar loyva teimum bert á tryggum (HTTPS) vevbústaði."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Hesin kagin noktaði. Loyv fráboðanum fyri hesa heimasíðuna í stillingunum hjá kaganum, og royn so aftur."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser will receive notifications. Save to keep it."
msgstr "Hesin kagin fer at taka ímóti fráboðanum. Goym fyri at varðveita tað."

#: src/postulo/plugins/browser/__init__.py
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Hesin kagin tók hald sítt aftur, so tað varð sløkt. Lat hetta sambandið upp í tí kaganum og loyv fráboðanum aftur."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Haldið hjá hesum kaganum"

#: src/postulo/plugins/browser/__init__.py
msgid "While Postulo is open"
msgstr "Meðan Postulo er opið"
