#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Une adresse de notification push doit être en HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Une notification poussée passe par le service push de l'éditeur de votre navigateur, chiffrée pour ne pas pouvoir être lue en chemin."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Autoriser les notifications dans ce navigateur"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Demande en cours auprès de ce navigateur…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Navigateur"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Rempli quand vous appuyez sur « Autoriser les notifications dans ce navigateur », ce qui nécessite les scripts. Laissez-le tel quel."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Comment elle arrive"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Rien n'est envoyé depuis le serveur de cette façon : les notifications apparaissent pendant que Postulo est ouvert dans un navigateur qui les a autorisées."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Les notifications sont autorisées. Ce navigateur ne peut pas recevoir de notifications poussées : elles apparaîtront pendant que Postulo y est ouvert. Enregistrez pour le conserver."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Les notifications sont configurées"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Seulement quand Postulo est ouvert, et rien ne quitte cette instance"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Poussée via %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Poussée vers ce navigateur, même avec Postulo fermé"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Les rappels et les captures arriveront de la même façon."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Envoyée. Elle devrait apparaître dans le navigateur qui l'a autorisée."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Affiche une notification dans votre navigateur : poussée vers lui s'il peut en recevoir, sinon la prochaine fois que Postulo y est ouvert."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Ce navigateur a retiré son abonnement. Ouvrez cette connexion dans ce navigateur et autorisez à nouveau les notifications."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Le service push a répondu %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "L'abonnement n'a pas été produit par un navigateur."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Les clés de l'abonnement ne sont pas celles du navigateur."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Ce navigateur ne peut pas afficher de notifications ici. Les navigateurs ne les autorisent que sur une adresse sécurisée (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Ce navigateur a refusé. Autorisez les notifications pour ce site dans ses paramètres, puis réessayez."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Ce navigateur recevra les notifications. Enregistrez pour le conserver."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Ce navigateur a retiré son abonnement, la connexion a donc été désactivée. Ouvrez-la dans ce navigateur et autorisez à nouveau les notifications."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "L'abonnement de ce navigateur"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Pendant que Postulo est ouvert"
