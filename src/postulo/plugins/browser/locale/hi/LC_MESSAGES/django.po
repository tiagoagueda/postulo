#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "एक पुश एड्रेस एचटीटीपी होना चाहिए।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "एक धक्का अपने ब्राउज़र के निर्माता की पुश सेवा के माध्यम से चला जाता है, ताकि इसे रास्ते में पढ़ा नहीं जा सके।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "इस ब्राउज़र में अधिसूचनाओं की अनुमति दें"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "इस ब्राउज़र को पूछो.."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "ब्राउज़र"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "जब आप \"इस ब्राउजर में सभी सूचनाएं\" दबाते हैं तो भरा हुआ, जिसके लिए स्क्रिप्ट की आवश्यकता होती है। इसे छोड़ दें।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "यह कैसे आता है"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "इस तरह सर्वर से कुछ भी नहीं भेजा जाता है: अधिसूचनाएं दिखाई देती हैं जबकि पोस्टुलो एक ब्राउज़र में खुलता है जो उन्हें अनुमति देता है।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "अधिसूचनाओं की अनुमति है। यह ब्राउज़र पुश प्राप्त नहीं कर सकता है, इसलिए वे दिखाई देंगे जबकि पोस्टुलो इसमें खुला है। इसे रखने के लिए सहेजें।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "अधिसूचनाएं निर्धारित की जाती हैं"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "जबकि पोस्टुलो खुला है, और कुछ भी नहीं इस उदाहरण को छोड़ देता है"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s के माध्यम से धकेल दिया"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "यहां तक कि पोस्टुलो बंद के साथ भी इस ब्राउज़र को धक्का दिया"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "अनुस्मारक और कैप्चर उसी तरह से आएंगे।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "संत यह ब्राउज़र है कि यह अनुमति में दिखाई देना चाहिए।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "अपने ब्राउज़र में एक अधिसूचना दिखाता है: जब यह एक प्राप्त कर सकता है तो इसे धक्का दिया, अन्यथा अगली बार पोस्टुलो उस में खुला है।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "उस ब्राउज़र ने अपनी सदस्यता वापस ले ली है। इस संबंध को खोलें और फिर से अधिसूचनाओं की अनुमति दें।।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "पुश सर्विस ने जवाब दिया %(status)s।।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "सदस्यता कुछ नहीं है जो ब्राउज़र लिखा है।।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "सदस्यता की कुंजी ब्राउज़र की नहीं है।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "यह ब्राउज़र यहां सूचनाएं नहीं दिखा सकता है। ब्राउज़र केवल उन्हें सुरक्षित (HTTPS) पते पर अनुमति देते हैं।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "इस ब्राउज़र ने मना कर दिया। इस साइट के लिए अपनी सेटिंग्स में अधिसूचनाओं की अनुमति दें, फिर पुनः प्रयास करें।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "इस ब्राउज़र को सूचनाएं प्राप्त होगी। इसे रखने के लिए सहेजें।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "इस ब्राउज़र ने अपनी सदस्यता वापस ले ली, इसलिए इसे बंद कर दिया गया। उस ब्राउज़र में इस कनेक्शन को खोलें और फिर से अधिसूचनाओं की अनुमति दें।।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "इस ब्राउज़र की सदस्यता"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "जबकि पोस्टुलो खुला है"
