#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "पुश पता HTTPS होना चाहिए।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "पुश आपके ब्राउज़र को बनाने वाली कंपनी की पुश सेवा से होकर जाता है, एन्क्रिप्ट करके, ताकि रास्ते में उसे पढ़ा न जा सके।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "इस ब्राउज़र में सूचनाओं की अनुमति दें"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "इस ब्राउज़र से पूछ रहे हैं…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser notifications"
msgstr "ब्राउज़र सूचनाएं"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "यह तब भरा जाता है जब आप “इस ब्राउज़र में सूचनाओं की अनुमति दें” दबाते हैं, जिसके लिए स्क्रिप्ट ज़रूरी हैं। इसे जैसा है वैसा ही रहने दें।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "यह कैसे पहुंचती है"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "इस तरह सर्वर से कुछ नहीं भेजा जाता: सूचनाएं तब दिखती हैं जब Postulo किसी ऐसे ब्राउज़र में खुला हो जिसने उनकी अनुमति दी है।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "सूचनाओं की अनुमति है। यह ब्राउज़र पुश नहीं पा सकता, इसलिए सूचनाएं तब दिखेंगी जब इसमें Postulo खुला हो। इसे रखने के लिए सेव करें।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "सूचनाएं सेट हो गई हैं"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "सिर्फ़ तब जब Postulo खुला हो, और कुछ भी इस इंस्टेंस से बाहर नहीं जाता"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "%(service)s के ज़रिए पुश किया गया"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "इस ब्राउज़र पर पुश किया जाता है, Postulo बंद होने पर भी"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "रिमाइंडर और कैप्चर भी इसी तरह आएंगे।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "भेज दिया गया। यह उस ब्राउज़र में दिखना चाहिए जिसने अनुमति दी थी।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows an HTML5 notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "आपके ब्राउज़र में HTML5 सूचना दिखाता है: जब ब्राउज़र पुश पा सकता है तो उस पर पुश की जाती है, नहीं तो अगली बार जब उसमें Postulo खुला हो।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "उस ब्राउज़र ने अपना सब्सक्रिप्शन वापस ले लिया है। यह कनेक्शन उसमें खोलें और फिर से सूचनाओं की अनुमति दें।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "पुश सेवा ने %(status)s जवाब दिया।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "यह सब्सक्रिप्शन किसी ब्राउज़र का लिखा हुआ नहीं है।"

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "सब्सक्रिप्शन में मौजूद की किसी ब्राउज़र ने नहीं बनाईं।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "यह ब्राउज़र यहां सूचनाएं नहीं दिखा सकता। ब्राउज़र इनकी अनुमति सिर्फ़ सुरक्षित (HTTPS) पते पर देते हैं।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "इस ब्राउज़र ने मना कर दिया। इसकी सेटिंग में इस साइट के लिए सूचनाओं की अनुमति दें, फिर से कोशिश करें।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "इस ब्राउज़र को सूचनाएं मिलेंगी। इसे रखने के लिए सेव करें।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "इस ब्राउज़र ने अपना सब्सक्रिप्शन वापस ले लिया, इसलिए इसे बंद कर दिया गया। यह कनेक्शन उसी ब्राउज़र में खोलें और फिर से सूचनाओं की अनुमति दें।"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "इस ब्राउज़र का सब्सक्रिप्शन"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "जब Postulo खुला हो"
