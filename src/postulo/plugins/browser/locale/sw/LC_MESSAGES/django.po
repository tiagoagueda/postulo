#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Anwani ya kushinikiza lazima iwe HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Shinikizo linapita kupitia huduma ya kushinikiza ya mtengenezaji wa kivinjari chako, iliyofichwa ili iweze kusomwa njiani."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Kuruhusu taarifa katika browser hii"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "Kwa kutumia browser hii.."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Browser"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "Kujazwa wakati bonyeza \"Kuruhusu arifa katika kivinjari hiki\", ambayo inahitaji scripts. Acha kama ilivyo."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Jinsi ya kufika"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Hakuna kitu kinachotumwa kutoka kwa seva kwa njia hii: arifa zinaonekana wakati Postulo iko wazi katika kivinjari ambacho kiliwaruhusu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Taarifa zinaruhusiwa. Kivinjari hiki hakiwezi kupokea kusukuma, hivyo itaonekana wakati Postulo iko wazi ndani yake. Kuokoa muda wako."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Taarifa zinaandaliwa"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Wakati Postulo ni wazi, na hakuna chochote kinachoacha tukio hili"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Picha zote na Wizara ya Mambo ya Ndani ya Nchi. ..................................................................."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Nenda kwenye kivinjari hiki, hata baada ya Postulo kufungwa"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Kumbukumbu na kumbukumbu zitafika kwa njia sawa."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Ya kutuma. Inapaswa kuonekana katika browser ambayo inaruhusu."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Inaonyesha taarifa katika browser yako: kusukuma kwa wakati inaweza kupokea moja, vinginevyo wakati ujao Postulo ni wazi ndani yake."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Mtumiaji huyu ameondoa usajili wake. Fungua uunganisho huu ndani yake na kuruhusu arifa tena."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "Kwa mujibu wa msemaji wa jeshi, Dk."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "Usajili sio kitu ambacho browser aliandika."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Funguo za usajili sio za browser."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Kivinjari hiki hakiwezi kuonyesha arifa hapa. Vivinjari huruhusu tu kwenye anwani salama (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Ndege hiyo ilikataa. Ruhusu arifa kwa tovuti hii katika mipangilio yake, kisha jaribu tena."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Mtumiaji huyu atapata taarifa. Kuokoa muda wako."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Kivinjari hiki kiliondoa usajili wake, kwa hivyo ilizimwa. Fungua uunganisho huu katika kivinjari hiki na uruhusu arifa tena."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser's subscription"
msgstr "Usajili wa browser hii"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "While Postulo is open"
msgstr "Wakati Postulo ni wazi"
