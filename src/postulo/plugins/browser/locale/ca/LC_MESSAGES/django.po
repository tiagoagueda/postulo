#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "A push address has to be HTTPS."
msgstr "Una adreça de pressió ha de ser HTTPS."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "A push goes through the push service of your browser's maker, encrypted so that it cannot be read on the way."
msgstr "Una notificació push passa pel servei push del fabricant del vostre navegador, xifrada perquè no es pugui llegir pel camí."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Allow notifications in this browser"
msgstr "Permet les notificacions en aquest navegador"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Asking this browser…"
msgstr "S'està demanant a aquest navegador…"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Browser"
msgstr "Navegador"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Filled in when you press “Allow notifications in this browser”, which needs scripts. Leave it as it is."
msgstr "S'omple quan premeu «Permet les notificacions en aquest navegador», cosa que necessita scripts. Deixeu-ho com està."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "How it arrives"
msgstr "Com arriba"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Nothing is sent from the server this way: notifications appear while Postulo is open in a browser that allowed them."
msgstr "Per aquesta via no s'envia res des del servidor: les notificacions apareixen mentre Postulo està obert en un navegador que les ha permès."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are allowed. This browser cannot receive pushes, so they will appear while Postulo is open in it. Save to keep it."
msgstr "Les notificacions estan permeses. Aquest navegador no pot rebre notificacions push, així que apareixeran mentre Postulo hi estigui obert. Deseu per mantenir-ho."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Notifications are set up"
msgstr "Les notificacions estan configurades"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Only while Postulo is open, and nothing leaves this instance"
msgstr "Només mentre Postulo està obert, i res no surt d'aquesta instal·lació"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy, python-format
msgid "Pushed through %(service)s"
msgstr "Push a través de %(service)s"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Pushed to this browser, even with Postulo closed"
msgstr "Push a aquest navegador, fins i tot amb Postulo tancat"

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Reminders and captures will arrive the same way."
msgstr "Els recordatoris i les captures arribaran de la mateixa manera."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Sent. It should appear in the browser that allowed it."
msgstr "Enviat. Hauria d'aparèixer al navegador que ho ha permès."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "Shows a notification in your browser: pushed to it when it can receive one, otherwise the next time Postulo is open in it."
msgstr "Mostra una notificació al vostre navegador: per push quan el navegador en pot rebre, i si no, el cop següent que Postulo hi estigui obert."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "That browser has withdrawn its subscription. Open this connection in it and allow notifications again."
msgstr "Aquell navegador ha retirat la seva subscripció. Obriu-hi aquesta connexió i torneu a permetre les notificacions."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy, python-format
msgid "The push service answered %(status)s."
msgstr "El servei d' empeny ha respost %(status)s."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription is not something a browser wrote."
msgstr "La subscripció no és una cosa que va escriure un navegador."

#: src/postulo/plugins/browser/webpush.py
#, fuzzy
msgid "The subscription's keys are not the browser's."
msgstr "Les claus de subscripció no són del navegador."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser cannot show notifications here. Browsers only allow them on a secure (HTTPS) address."
msgstr "Aquest navegador no pot mostrar notificacions aquí. Els navegadors només les permeten en una adreça segura (HTTPS)."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser refused. Allow notifications for this site in its settings, then try again."
msgstr "Aquest navegador ho ha rebutjat. Permeteu les notificacions per a aquest lloc a la seva configuració i torneu-ho a provar."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser will receive notifications. Save to keep it."
msgstr "Aquest navegador rebrà notificacions. Deseu per mantenir-ho."

#: src/postulo/plugins/browser/__init__.py
#, fuzzy
msgid "This browser withdrew its subscription, so it was switched off. Open this connection in that browser and allow notifications again."
msgstr "Aquest navegador ha retirat la seva subscripció, així que es va desactivar. Obriu aquesta connexió en aquell navegador i torneu a permetre les notificacions."

