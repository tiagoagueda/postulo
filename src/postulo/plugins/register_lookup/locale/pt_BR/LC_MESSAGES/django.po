#: src/postulo/plugins/register_lookup/adapters.py
msgid "ARES, Ministry of Finance of the Czech Republic"
msgstr "ARES, Ministério das Finanças da República Tcheca"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Brønnøysund Register Centre (Enhetsregisteret)"
msgstr "Centro de Registros de Brønnøysund (Enhetsregisteret)"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Registros de empresas"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Escritório Finlandês de Patentes e Registro (PRH), Sistema de Informações Empresariais (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
#, fuzzy
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Fundação Global do Identificador de Entidade Jurídica (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) e INPI (RNE), por meio da API Recherche d'entreprises da DINUM"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Consulta uma empresa no registro do país dela quando você pede, a partir do número de registro (França, Noruega, Finlândia, Tchéquia, Polônia) ou do LEI (GLEIF), e permite escolher o que manter entre o nome oficial, o endereço, a situação jurídica e a atividade. Uma requisição por clique, levando o número e nada mais, ao próprio serviço do registro, que assim fica sabendo qual empresa alguém aqui está consultando. Desativado até que um administrador o ative; desativado, nada é consultado e nada do que já foi mantido é alterado."

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Registro Judicial Nacional (KRS), Ministério da Justiça da Polônia"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Consulta de registros"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland) and GLEIF. Nothing here asks anything by itself."
msgstr "Quais registros a Consulta de registros pode consultar, um por país, e como a resposta de cada um é lida: o Annuaire des Entreprises (França), o Enhetsregisteret (Noruega), o YTJ (Finlândia), o ARES (Tchéquia), o KRS (Polônia) e a GLEIF. Nada aqui consulta nada por conta própria."
