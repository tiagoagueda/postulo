msgstr "ARES, Txekiar Errepublikako Finantza Ministerioa"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Brønnøysund Register Centre (Enhetsregisteret)"
msgstr "Brønnøysundeko Erregistro Zentroa (Enhetsregisteret)"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Enpresa-erregistroak"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Finlandiako Patente eta Erregistro Bulegoa (PRH), Enpresen Informazio Sistema (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Entitate Juridikoen Identifikatzailearen Fundazio Globala (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) eta INPI (RNE), DINUMen API Recherche d'entreprises bidez"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Enpresa bat bere herrialdeko erregistroan bilatzen du zuk eskatzen duzunean, bere erregistro-zenbakitik (Frantzia, Norvegia, Finlandia, Txekia, Polonia) edo bere LEItik (GLEIF), eta izen ofiziala, helbidea, egoera eta jarduera horietatik zein gorde aukeratzen uzten dizu. Eskaera bat sakatze bakoitzeko, zenbakia eta beste ezer ez daramana, erregistroaren beraren zerbitzura; horrela, zerbitzu horrek jakiten du hemen norbait zein enpresari begira dagoen. Itzalita dago administratzaile batek pizten duen arte; itzalita badago, ez da ezer eskatzen eta lehendik gordetakoa ez da ukitzen."

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Auzitegi Erregistro Nazionala (KRS), Poloniako Justizia Ministerioa"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Erregistro-bilaketa"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland) and GLEIF. Nothing here asks anything by itself."
msgstr "«Erregistro-bilaketa» pluginak zein erregistrori galde diezaiekeen, herrialde bakoitzeko bat, eta bakoitzaren erantzuna nola irakurtzen den: Annuaire des Entreprises (Frantzia), Enhetsregisteret (Norvegia), YTJ (Finlandia), ARES (Txekia), KRS (Polonia) eta GLEIF. Hemen ezerk ez du ezer galdetzen berez."
