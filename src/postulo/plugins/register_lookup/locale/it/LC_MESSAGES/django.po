#: src/postulo/plugins/register_lookup/adapters.py
msgid "ARES, Ministry of Finance of the Czech Republic"
msgstr "ARES, Ministero delle Finanze della Repubblica Ceca"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Brønnøysund Register Centre (Enhetsregisteret)"
msgstr "Centro dei registri di Brønnøysund (Enhetsregisteret)"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Registri delle imprese"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Ufficio finlandese dei brevetti e delle registrazioni (PRH), Sistema informativo delle imprese (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
#, fuzzy
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Fondazione globale per l'identificativo di entità giuridica (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) e INPI (RNE), tramite l'API Recherche d'entreprises della DINUM"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Cerca un'azienda nel registro del suo paese quando lo chiedi, dal suo numero di registro (Francia, Norvegia, Finlandia, Cechia, Polonia) o dal suo LEI (GLEIF), e ti fa scegliere che cosa conservare tra denominazione ufficiale, indirizzo, stato giuridico e attività. Una richiesta per ogni pressione, con il numero e nient'altro, al servizio del registro stesso, che così viene a sapere quale azienda qualcuno qui sta guardando. Disattivato finché un amministratore non lo attiva; disattivato, non viene chiesto nulla e nulla di quanto già conservato viene toccato."

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Registro giudiziario nazionale (KRS), Ministero della Giustizia della Polonia"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Ricerca nei registri"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland) and GLEIF. Nothing here asks anything by itself."
msgstr "Quali registri Ricerca nei registri può interrogare, uno per paese, e come viene letta la risposta di ciascuno: l'Annuaire des Entreprises (Francia), l'Enhetsregisteret (Norvegia), lo YTJ (Finlandia), l'ARES (Cechia), il KRS (Polonia) e il GLEIF. Nulla qui chiede qualcosa da solo."
