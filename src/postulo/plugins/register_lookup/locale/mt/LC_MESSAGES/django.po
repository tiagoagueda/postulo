#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Reġistri tal-kumpaniji"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Uffiċċju Finlandiż tal-Privattivi u r-Reġistrazzjoni (PRH), Sistema ta' Informazzjoni dwar in-Negozji (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Fondazzjoni Globali għall-Identifikatur tal-Entitajiet Legali (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) u INPI (RNE), permezz tal-API Recherche d'entreprises tad-DINUM"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland, and the United Kingdom once a key is saved) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Fittex kumpanija fir-reġistru ta' pajjiżha meta tagħfas il-buttuna, min-numru tar-reġistru tagħha (Franza, in-Norveġja, il-Finlandja, ir-Repubblika Ċeka, il-Polonja, u r-Renju Unit ladarba tinżamm ċavetta) jew mill-LEI tagħha (GLEIF), u agħżel liema mill-isem uffiċjali, l-indirizz, l-istat u l-attività żżomm. Talba waħda għal kull għafsa, bin-numru u xejn aktar, lis-servizz tar-reġistru stess, li b'hekk jitgħallem liema kumpanija qed ifittex xi ħadd hawn. Mitfi sakemm amministratur ma jixgħelx; meta jkun mitfi, xejn ma jiġi mitlub u xejn li diġà nżamm ma jintmiss."

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Reġistru Nazzjonali tal-Qorti (KRS), Ministeru tal-Ġustizzja tal-Polonja"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Fittxija fir-reġistru"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland), Companies House (United Kingdom, with a key) and GLEIF. Nothing here asks anything by itself."
msgstr "Liema reġistri jista' jistaqsi l-Fittxija fir-reġistru, wieħed għal kull pajjiż, u kif tinqara t-tweġiba ta' kull wieħed: l-Annuaire des Entreprises (Franza), Enhetsregisteret (in-Norveġja), YTJ (il-Finlandja), ARES (ir-Repubblika Ċeka), KRS (il-Polonja), Companies House (ir-Renju Unit, b'ċavetta) u GLEIF. Xejn hawnhekk ma jistaqsi xejn waħdu."
