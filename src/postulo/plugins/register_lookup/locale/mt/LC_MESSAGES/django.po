#: src/postulo/plugins/register_lookup/adapters.py
msgid "ARES, Ministry of Finance of the Czech Republic"
msgstr "ARES, Ministeru tal-Finanzi tar-Repubblika Ċeka"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Brønnøysund Register Centre (Enhetsregisteret)"
msgstr "Ċentru tar-Reġistri ta' Brønnøysund (Enhetsregisteret)"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Reġistri tal-kumpaniji"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Uffiċċju Finlandiż tal-Privattivi u r-Reġistrazzjoni (PRH), Sistema ta' Informazzjoni dwar in-Negozji (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Fondazzjoni Globali għall-Identifikatur tal-Entitajiet Legali (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) u INPI (RNE), permezz tal-API Recherche d'entreprises tad-DINUM"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Fittex kumpanija fir-reġistru ta' pajjiżha meta tagħfas għalih, min-numru tar-reġistrazzjoni tagħha (Franza, in-Norveġja, il-Finlandja, iċ-Ċekja, il-Polonja) jew mil-LEI tagħha (GLEIF), u agħżel liema mill-isem uffiċjali, l-indirizz, l-istat u l-attività għandhom jinżammu. Talba waħda għal kull għafsa, li ġġorr in-numru u xejn aktar, lis-servizz tar-reġistru stess, li b'hekk isir jaf liema kumpanija qed iħares lejha xi ħadd hawn. Mitfi sakemm amministratur ixgħelu; meta jkun mitfi, ma jintalab xejn u ma jintmess xejn minn dak li diġà nżamm."

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Reġistru Nazzjonali tal-Qorti (KRS), Ministeru tal-Ġustizzja tal-Polonja"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Tfittxija fir-reġistru"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland) and GLEIF. Nothing here asks anything by itself."
msgstr "Liema reġistri jista' jistaqsi Tfittxija fir-reġistru, wieħed għal kull pajjiż, u kif tinqara t-tweġiba ta' kull wieħed: l-Annuaire des Entreprises (Franza), Enhetsregisteret (in-Norveġja), YTJ (il-Finlandja), ARES (iċ-Ċekja), KRS (il-Polonja) u GLEIF. Xejn hawn ma jistaqsi xi ħaġa waħdu."
