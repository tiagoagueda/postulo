#: src/postulo/plugins/register_lookup/adapters.py
msgid "ARES, Ministry of Finance of the Czech Republic"
msgstr "ARES, Չեխիայի Հանրապետության ֆինանսների նախարարություն"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Brønnøysund Register Centre (Enhetsregisteret)"
msgstr "Բրյոննոյսունի ռեեստրների կենտրոն (Enhetsregisteret)"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Ընկերությունների ռեեստրներ"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Ֆինլանդիայի արտոնագրերի և գրանցման գրասենյակ (PRH), Բիզնես տեղեկատվական համակարգ (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Իրավաբանական անձի նույնացուցիչի գլոբալ հիմնադրամ (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) և INPI (RNE)՝ DINUM-ի API Recherche d'entreprises-ի միջոցով"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Որոնում է ընկերությունն իր երկրի ռեեստրում, երբ դա խնդրեք, ըստ գրանցման համարի (Ֆրանսիա, Նորվեգիա, Ֆինլանդիա, Չեխիա, Լեհաստան) կամ LEI-ի (GLEIF), և թույլ է տալիս ընտրել, թե պաշտոնական անվանումից, հասցեից, կարգավիճակից և գործունեությունից որոնք պահել։ Յուրաքանչյուր սեղմման համար մեկ հարցում, որը պարունակում է միայն համարը, ուղարկվում է հենց ռեեստրի ծառայությանը, որն այդպես իմանում է, թե որ ընկերությանն է այստեղ ինչ-որ մեկը նայում։ Անջատված է, մինչև ադմինիստրատորը միացնի այն․ անջատված լինելու դեպքում ոչինչ չի հարցվում, և արդեն պահվածին ոչինչ չի դիպչում։"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Ազգային դատական ռեեստր (KRS), Լեհաստանի արդարադատության նախարարություն"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Ռեեստրում որոնում"

#: src/postulo/plugins/register_lookup/__init__.py
#, fuzzy
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland) and GLEIF. Nothing here asks anything by itself."
msgstr "Որ ռեեստրներին կարող է դիմել «Ռեեստրում որոնում»-ը՝ մեկական յուրաքանչյուր երկրի համար, և ինչպես է կարդացվում յուրաքանչյուրի պատասխանը՝ Annuaire des Entreprises (Ֆրանսիա), Enhetsregisteret (Նորվեգիա), YTJ (Ֆինլանդիա), ARES (Չեխիա), KRS (Լեհաստան) և GLEIF։ Այստեղ ոչինչ ինքնուրույն որևէ բան չի հարցնում։"
