msgid "ARES, Ministry of Finance of the Czech Republic"
msgstr "ARES, Tsjekkias finansdepartement"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Brønnøysund Register Centre (Enhetsregisteret)"
msgstr "Brønnøysundregistrene (Enhetsregisteret)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Companies House"
msgstr "Companies House"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Companies House API key"
msgstr "API-nøkkel for Companies House"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Company registers"
msgstr "Foretaksregistre"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Finnish Patent and Registration Office (PRH), Business Information System (YTJ)"
msgstr "Patent- og registerstyret i Finland (PRH), Bedrifts- og organisasjonsdatasystemet (YTJ)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "Global Legal Entity Identifier Foundation (GLEIF)"
msgstr "Global Legal Entity Identifier Foundation (GLEIF)"

#: src/postulo/plugins/register_lookup/adapters.py
msgid "INSEE (Sirene) and INPI (RNE), through the DINUM's API Recherche d'entreprises"
msgstr "INSEE (Sirene) og INPI (RNE), via DINUMs API Recherche d'entreprises"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Look a company up in its country's register when you press for it, from its register number (France, Norway, Finland, Czechia, Poland, and the United Kingdom once a key is saved) or its LEI (GLEIF), and choose which of the official name, address, state and activity to keep. One request per press, carrying the number and nothing else, to the register's own service, which so learns which company somebody here is looking at. Off until an administrator switches it on; switched off, nothing is asked and nothing already kept is touched."
msgstr "Slå opp et selskap i registeret i landet sitt når du trykker på knappen, ut fra organisasjonsnummeret (Frankrike, Norge, Finland, Tsjekkia, Polen og Storbritannia når en nøkkel er lagret) eller LEI-koden (GLEIF), og velg hvilke av det offisielle navnet, adressen, statusen og virksomheten som skal beholdes. Én forespørsel per trykk, med nummeret og ingenting annet, til registerets egen tjeneste, som dermed får vite hvilket selskap noen her ser på. Når dette er slått av, til en administrator slår det på, spørres det ikke om noe, og ingenting som allerede er beholdt, røres."

#: src/postulo/plugins/register_lookup/adapters.py
msgid "National Court Register (KRS), Ministry of Justice of Poland"
msgstr "Det nasjonale rettsregisteret (KRS), Polens justisdepartement"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Register lookup"
msgstr "Registeroppslag"

#: src/postulo/plugins/register_lookup/__init__.py
msgid "Which registers Register lookup can ask, one per country, and how each one's answer is read: the Annuaire des Entreprises (France), Enhetsregisteret (Norway), YTJ (Finland), ARES (Czechia), KRS (Poland), Companies House (United Kingdom, with a key) and GLEIF. Nothing here asks anything by itself."
msgstr "Hvilke registre Registeroppslag kan spørre, ett per land, og hvordan hvert svar leses: Annuaire des Entreprises (Frankrike), Enhetsregisteret (Norge), YTJ (Finland), ARES (Tsjekkia), KRS (Polen), Companies House (Storbritannia, med nøkkel) og GLEIF. Ingenting her spør om noe av seg selv."
