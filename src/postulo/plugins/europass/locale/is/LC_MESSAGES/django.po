#: src/postulo/plugins/europass/reader.py:597
#, python-format, draft
msgid "That file is not readable JSON: %(reason)s"
msgstr "Sú skrá er ekki læsilegt JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py:317
#, python-format, draft
msgid "That file is not readable XML: %(reason)s"
msgstr "Sú skrá er ekki læsilegt XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py:594
#, draft
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Sú skrá er ekki UTF-8, svo hún er ekki Europass-útflutningur."

#: src/postulo/plugins/europass/reader.py:602
#, python-format, draft
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Sú skrá er hreiðruð dýpra en %(limit)s þrep, svo hún var ekki lesin."

#: src/postulo/plugins/europass/reader.py:236
#, draft
msgid ""
"That is not a Europass file. Postulo reads the XML the CV editor produced and the JSON europass.europa.eu exports; this is neither."
msgstr ""
"Þetta er ekki Europass-skrá. Postulo les XML-ið sem ferilskrárritillinn bjó til og JSON-ið sem europass.europa.eu flytur út; þetta er hvorugt."

#: src/postulo/plugins/europass/__init__.py:33
#, draft
msgid ""
"The European CV format: the XML the Europass editor produces and the JSON europass.europa.eu exports."
msgstr ""
"Evrópska ferilskrársniðið: XML-ið sem Europass-ritillinn býr til og JSON-ið sem europass.europa.eu flytur út."

