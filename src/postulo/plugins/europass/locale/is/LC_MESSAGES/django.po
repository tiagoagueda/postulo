#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Þetta lítur ekki út eins og Europass-skrá: hana vantar LearnerInfo-hlutann."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Sú skrá er ekki læsilegt JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Sú skrá er ekki læsilegt XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Sú skrá er ekki UTF-8, svo hún er ekki Europass-útflutningur."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Sú skrá er hreiðruð dýpra en %(limit)s þrep, svo hún var ekki lesin."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Þetta er ekki Europass-skrá. Postulo les PDF-skrána sem europass.europa.eu lætur þig fá, XML-skrána í viðhengi hennar og eldra XML og JSON frá Europass; þetta er ekkert af þessu."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Þessi PDF-skrá hefur skrár í viðhengi og engin þeirra er Europass-ferilskrá. Hladdu upp PDF-skránni sem europass.europa.eu lætur þig fá, eins og hún er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Þessi PDF-skrá hefur ekkert í viðhengi, svo það er engin Europass-ferilskrá í henni til að lesa. PDF-skráin frá europass.europa.eu ber ferilskrána sem skrá í viðhengi, og PDF-skrá sem annað forrit hefur prentað eða vistað aftur glatar henni: sæktu ferilskrána aftur á europass.europa.eu og hladdu þeirri skrá upp eins og hún er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Þessi PDF-skrá er dulrituð, svo ekki er hægt að lesa Europass-ferilskrána í viðhengi hennar. Sæktu ferilskrána aftur á europass.europa.eu og hladdu þeirri skrá upp eins og hún er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Þetta XML er ekki Europass-ferilskrá. Postulo les XML sem europass.europa.eu skrifar (Candidate) og XML Europass-ritilsins sem var á undan (SkillsPassport); þetta er hvorugt."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Evrópska ferilskrársniðið: PDF-skráin sem europass.europa.eu lætur þig fá og XML-skráin í viðhengi hennar, auk eldra XML og JSON Europass-þjónustunnar sem var á undan."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Skráin í viðhengi þessarar PDF-skrár er skemmd og ekki tókst að afþjappa hana. Sæktu ferilskrána aftur á europass.europa.eu og hladdu þeirri skrá upp eins og hún er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Skráin í viðhengi þessarar PDF-skrár er þjöppuð á hátt sem Postulo les ekki (%(filter)s). Sæktu ferilskrána aftur á europass.europa.eu og hladdu þeirri skrá upp eins og hún er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Skráin í viðhengi þessarar PDF-skrár verður stærri en %(limit)s MB þegar hún er afþjöppuð, svo hún var ekki lesin."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Skráin geymir þennan starfsferil á fleiri en einu tungumáli og aðeins það fyrsta var lesið."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Skráin telur upp %(count)d meðmælanda og aðeins fyrstu %(limit)d voru lesnir."
msgstr[1] "Skráin telur upp %(count)d meðmælendur og aðeins fyrstu %(limit)d voru lesnir."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Skráin telur upp fleiri en %(limit)d viðburði og aðeins fyrstu %(limit)d voru lesnir."

