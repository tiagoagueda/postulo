#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s stond in het bestand maar kon niet worden gelezen."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s van een referentie wordt niet gelezen: niets drukt het af. Elke referentie wordt toegevoegd als nog niet gevraagd, dus er wordt er geen afgedrukt totdat u aangeeft dat ze akkoord zijn gegaan."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Prestaties"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Links van een gebeurtenis na de eerste worden niet gelezen: een gebeurtenis bewaart één adres."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Communicatieve vaardigheden"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitale vaardigheden"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Opleiding"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Europass-import"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Vakgerelateerde vaardigheden"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Talen"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Management en leiderschap"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organisatorische vaardigheden"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Overige vaardigheden"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Vaardigheden"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Sommige onderdelen van het bestand hebben in Postulo nog nergens een plek en zijn niet gelezen: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Dit lijkt geen Europass-bestand: het heeft geen LearnerInfo-sectie."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Dat bestand is geen leesbare JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Dat bestand is geen leesbare XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Dat bestand is geen UTF-8 en dus geen Europass-export."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Dat bestand is meer dan %(limit)s niveaus diep genest en is daarom niet gelezen."

#: src/postulo/plugins/europass/credential.py
msgid "That is a European Digital Credential in the old XML format, which Postulo does not read. Download it again from your Europass wallet, where it has been converted, and upload that file."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Dat is geen Europass-bestand. Postulo leest de pdf die europass.europa.eu u geeft, de XML die eraan is gehecht, en de oudere Europass-XML en -JSON; dit is geen daarvan."

#: src/postulo/plugins/europass/credential.py
msgid "That is not a European Digital Credential Postulo can read. It reads the JSON-LD the Europass wallet gives you, sealed or not."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Die pdf heeft bijlagen, en geen daarvan is een Europass-cv. Upload de pdf die europass.europa.eu u geeft, zoals die is."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Die pdf heeft geen bijlagen, dus er zit geen Europass-cv in om te lezen. De pdf die europass.europa.eu u geeft, bevat het cv als bijgevoegd bestand, en een pdf die door een ander programma opnieuw is afgedrukt of opgeslagen, verliest dat: download het cv opnieuw van europass.europa.eu en upload dat bestand zoals het is."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Die pdf is versleuteld, dus het Europass-cv dat eraan is gehecht kan niet worden gelezen. Download het cv opnieuw van europass.europa.eu en upload dat bestand zoals het is."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Die XML is geen Europass-cv. Postulo leest de XML die europass.europa.eu schrijft (een Candidate) en die van de Europass-editor daarvoor (een SkillsPassport); dit is geen van beide."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it. Also reads what a European Digital Credential you keep under Files states."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Het bestand dat aan die pdf is gehecht, is beschadigd en kon niet worden uitgepakt. Download het cv opnieuw van europass.europa.eu en upload dat bestand zoals het is."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Het bestand dat aan die pdf is gehecht, is verpakt op een manier die Postulo niet leest (%(filter)s). Download het cv opnieuw van europass.europa.eu en upload dat bestand zoals het is."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Het bestand dat aan die pdf is gehecht, pakt uit tot meer dan %(limit)s MB, dus het is niet gelezen."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Het bestand bevat deze loopbaan in meer dan één taal, en alleen de eerste is gelezen."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Het bestand bevat %(count)d referentie, en alleen de eerste %(limit)d is gelezen."
msgstr[1] "Het bestand bevat %(count)d referenties, en alleen de eerste %(limit)d zijn gelezen."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Het bestand bevat meer dan %(limit)d gebeurtenissen en alleen de eerste %(limit)d werden gelezen."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Werkervaring"
