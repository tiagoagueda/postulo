msgstr "Digitais"

#: src/postulo/plugins/europass/reader.py:690
#, draft
msgid "Education"
msgstr "Formação"

#: src/postulo/plugins/europass/candidate.py:135
#: src/postulo/plugins/europass/reader.py:109
#, draft
msgid "Job-related"
msgstr "Relacionadas à profissão"

#: src/postulo/plugins/europass/candidate.py:131
#, draft
msgid "Management and leadership"
msgstr "Gestão e liderança"

#: src/postulo/plugins/europass/candidate.py:122
