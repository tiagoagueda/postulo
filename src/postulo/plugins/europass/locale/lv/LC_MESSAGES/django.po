#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s bija failā, bet to nevarēja nolasīt."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Atsauksmes sniedzēja %(parts)s netiek nolasīts: nekas to nedrukā. Katrs atsauksmes sniedzējs tiek pievienots kā vēl neuzrunāts, tāpēc neviens netiek drukāts, līdz jūs norādāt, ka viņi ir piekrituši."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Sasniegumi"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Notikuma saites pēc pirmās netiek nolasītas: notikumam ir viena adrese."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Saziņas prasmes"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitālās prasmes"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Izglītība"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass"
msgstr "Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Ar darbu saistītās prasmes"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Valodas"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Vadība un līderība"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organizatoriskās prasmes"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Cits"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Prasmes"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Dažām faila sadaļām Postulo vēl nav vietas, tāpēc tās netika nolasītas: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Tas neizskatās pēc Europass faila: tajā nav LearnerInfo sadaļas."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Fails nav lasāms JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Fails nav lasāms XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Fails nav UTF-8, tāpēc tas nav Europass eksports."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Fails ir ligzdots dziļāk par %(limit)s līmeņiem, tāpēc netika nolasīts."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Tas nav Europass fails. Postulo nolasa PDF, ko dod europass.europa.eu, tam pievienoto XML un vecākos Europass XML un JSON; šis nav neviens no tiem."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Šim PDF ir pievienoti faili, un neviens no tiem nav Europass CV. Augšupielādējiet PDF, ko dod europass.europa.eu, tādu, kāds tas ir."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Šim PDF nekas nav pievienots, tāpēc tajā nav Europass CV, ko nolasīt. PDF, ko dod europass.europa.eu, satur CV kā pievienotu failu, bet PDF, ko cita programma izdrukā vai saglabā no jauna, to zaudē: lejupielādējiet CV vēlreiz no europass.europa.eu un augšupielādējiet to failu tādu, kāds tas ir."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Šis PDF ir šifrēts, tāpēc tam pievienoto Europass CV nevar nolasīt. Lejupielādējiet CV vēlreiz no europass.europa.eu un augšupielādējiet to failu tādu, kāds tas ir."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Šis XML nav Europass CV. Postulo nolasa XML, ko raksta europass.europa.eu (Candidate), un iepriekšējā Europass redaktora XML (SkillsPassport); šis nav neviens no tiem."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Eiropas CV formāts: PDF, ko dod europass.europa.eu, un tam pievienotais XML, kā arī iepriekšējā Europass pakalpojuma vecākie XML un JSON."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Šim PDF pievienotais fails ir bojāts un to nevarēja izpakot. Lejupielādējiet CV vēlreiz no europass.europa.eu un augšupielādējiet to failu tādu, kāds tas ir."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Šim PDF pievienotais fails ir iepakots veidā, ko Postulo nelasa (%(filter)s). Lejupielādējiet CV vēlreiz no europass.europa.eu un augšupielādējiet to failu tādu, kāds tas ir."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Šim PDF pievienotais fails izpakojas par vairāk nekā %(limit)s MB, tāpēc tas netika nolasīts."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Failā šī karjera ir vairāk nekā vienā valodā, un tika nolasīta tikai pirmā."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Failā ir %(count)d atsauksmes sniedzējs, un tika nolasīts tikai pirmais %(limit)d."
msgstr[1] "Failā ir %(count)d atsauksmes sniedzēji, un tika nolasīti tikai pirmie %(limit)d."
msgstr[2] "Failā ir %(count)d atsauksmes sniedzēju, un tika nolasīti tikai pirmie %(limit)d."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Failā ir vairāk nekā %(limit)d notikumu, un tika nolasīti tikai pirmie %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Darba pieredze"
