#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s var i fila, men kunne ikkje lesast."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s til ein referanse blir ikkje lese: ingenting viser det. Kvar referanse blir lagd til som ikkje spurd enno, så ingen blir vist før du seier at dei har sagt ja."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Prestasjonar"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Lenker til ei hending utover den første blir ikkje lesne: ei hending har berre éi adresse."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Kommunikasjon"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitalt"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Utdanning"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass"
msgstr "Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Jobbrelatert"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Språk"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Administrasjon og leiing"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organisatorisk"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Anna"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Ferdigheiter"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Nokre delar av fila har enno ingen plass i Postulo og vart ikkje lesne: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Det ser ikkje ut som ei Europass-fil: ho har ingen LearnerInfo-del."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Den fila er ikkje lesbar JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Den fila er ikkje lesbar XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Den fila er ikkje UTF-8, så ho er ikkje ein Europass-eksport."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Den fila er nesta meir enn %(limit)s nivå djupt, så ho vart ikkje lesen."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Det er ikkje ei Europass-fil. Postulo les PDF-en du får frå europass.europa.eu, XML-en som er lagd ved han, og den eldre Europass-XML-en og -JSON-en; dette er ingen av dei."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Den PDF-en har filer lagde ved, og ingen av dei er ein Europass-CV. Last opp PDF-en du får frå europass.europa.eu, slik han er."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF-en har ingenting lagt ved, så det finst ingen Europass-CV inni han å lese. PDF-en du får frå europass.europa.eu, har CV-en som ei vedlagd fil, og ein PDF som er skriven ut eller lagra på nytt av eit anna program, mistar henne: last ned CV-en på nytt frå europass.europa.eu og last opp den fila slik ho er."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF-en er kryptert, så Europass-CV-en som er lagd ved, kan ikkje lesast. Last ned CV-en på nytt frå europass.europa.eu og last opp den fila slik ho er."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Den XML-en er ikkje ein Europass-CV. Postulo les XML-en som europass.europa.eu skriv (ein Candidate), og den frå Europass-redigeringsverktøyet før det (eit SkillsPassport); dette er ingen av dei."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Det europeiske CV-formatet: PDF-en du får frå europass.europa.eu og XML-en som er lagd ved han, og den eldre XML-en og JSON-en frå Europass-tenesta før det."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Fila som er lagd ved den PDF-en, er skadd og kunne ikkje pakkast ut. Last ned CV-en på nytt frå europass.europa.eu og last opp den fila slik ho er."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Fila som er lagd ved den PDF-en, er pakka på ein måte Postulo ikkje les (%(filter)s). Last ned CV-en på nytt frå europass.europa.eu og last opp den fila slik ho er."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Fila som er lagd ved den PDF-en, blir større enn %(limit)s MB når ho blir pakka ut, så ho vart ikkje lesen."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fila inneheld denne karrieren på meir enn eitt språk, og berre det første vart lese."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Fila listar opp %(count)d referanse, og berre dei første %(limit)d vart lesne."
msgstr[1] "Fila listar opp %(count)d referansar, og berre dei første %(limit)d vart lesne."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Fila listar opp meir enn %(limit)d hendingar, og berre dei første %(limit)d vart lesne."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Arbeidserfaring"
