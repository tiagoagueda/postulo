#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "V datoteki je bilo %(what)s, vendar tega ni bilo mogoče prebrati."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Pri priporočilu se %(parts)s ne prebere: nič tega ne natisne. Vsako priporočilo je dodano kot še ne zaprošeno, zato se nobeno ne natisne, dokler ne navedete, da so priporočitelji privolili."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Dosežki"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Prebere se le prva povezava dogodka: dogodek hrani en sam naslov."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Komunikacijske"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitalne"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Izobrazba"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr ""

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Poklicne"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Jeziki"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Vodenje in upravljanje"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organizacijske"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Drugo"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Spretnosti"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Nekateri razdelki datoteke v Postulu še nimajo svojega mesta, zato niso bili prebrani: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "To ni videti kot datoteka Europass: nima razdelka LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ta datoteka ni berljiv JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ta datoteka ni berljiv XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ta datoteka ni v UTF-8, zato ni izvoz iz Europassa."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ta datoteka je gnezdena globlje kot %(limit)s ravni, zato ni bila prebrana."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "To ni datoteka Europass. Postulo bere PDF, ki ga dobite na europass.europa.eu, njemu priloženi XML ter starejša XML in JSON Europass; to ni nič od tega."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ta PDF ima priložene datoteke, vendar nobena ni življenjepis Europass. Naložite PDF, ki ga dobite na europass.europa.eu, nespremenjen."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ta PDF nima prilog, zato v njem ni življenjepisa Europass, ki bi ga lahko prebrali. PDF, ki ga dobite na europass.europa.eu, vsebuje življenjepis kot priloženo datoteko, PDF, ki ga drug program znova natisne ali shrani, pa jo izgubi: znova prenesite življenjepis z europass.europa.eu in naložite to datoteko nespremenjeno."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ta PDF je šifriran, zato priloženega življenjepisa Europass ni mogoče prebrati. Znova prenesite življenjepis z europass.europa.eu in naložite to datoteko nespremenjeno."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ta XML ni življenjepis Europass. Postulo bere XML, ki ga zapiše europass.europa.eu (Candidate), in XML prejšnjega urejevalnika Europass (SkillsPassport); to ni nič od tega."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Evropska oblika življenjepisa: PDF, ki ga dobite na europass.europa.eu, in njemu priloženi XML ter starejša XML in JSON prejšnje storitve Europass."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Datoteka, priložena temu PDF-ju, je poškodovana in je ni bilo mogoče razpakirati. Znova prenesite življenjepis z europass.europa.eu in naložite to datoteko nespremenjeno."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Datoteka, priložena temu PDF-ju, je stisnjena na način, ki ga Postulo ne bere (%(filter)s). Znova prenesite življenjepis z europass.europa.eu in naložite to datoteko nespremenjeno."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Datoteka, priložena temu PDF-ju, se razpakira v več kot %(limit)s MB, zato ni bila prebrana."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Datoteka vsebuje to kariero v več jezikih; prebran je bil le prvi."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Datoteka navaja %(count)d priporočilo, prebrana pa so bila le prva priporočila (%(limit)d)."
msgstr[1] "Datoteka navaja %(count)d priporočili, prebrana pa so bila le prva priporočila (%(limit)d)."
msgstr[2] "Datoteka navaja %(count)d priporočila, prebrana pa so bila le prva priporočila (%(limit)d)."
msgstr[3] "Datoteka navaja %(count)d priporočil, prebrana pa so bila le prva priporočila (%(limit)d)."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Datoteka navaja več kot %(limit)d dogodkov, prebranih pa je bilo le prvih %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Delovne izkušnje"
