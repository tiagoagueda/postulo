#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ta datoteka ni v UTF-8, zato ni izvoz iz Europassa."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ta datoteka je gnezdena globlje kot %(limit)s ravni, zato ni bila prebrana."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "To ni datoteka Europass. Postulo bere PDF, ki ga da europass.europa.eu, XML, priložen njemu, ter starejši XML in JSON Europass; to ni nobeno od teh."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ta PDF ima priložene datoteke, nobena pa ni življenjepis Europass. Naložite PDF, ki ga da europass.europa.eu, takega, kot je."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ta PDF nima ničesar priloženega, zato v njem ni življenjepisa Europass za branje. PDF, ki ga da europass.europa.eu, nosi življenjepis kot priloženo datoteko, PDF, ki ga drug program znova natisne ali shrani, pa jo izgubi: znova prenesite življenjepis z europass.europa.eu in naložite to datoteko, kot je."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ta PDF je šifriran, zato življenjepisa Europass, priloženega njemu, ni mogoče prebrati. Znova prenesite življenjepis z europass.europa.eu in naložite to datoteko, kot je."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ta XML ni življenjepis Europass. Postulo bere XML, ki ga piše europass.europa.eu (Candidate), in tistega urejevalnika Europass pred njim (SkillsPassport); to ni nobeno od teh."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Evropska oblika življenjepisa: PDF, ki ga da europass.europa.eu, in XML, priložen njemu, ter starejši XML in JSON storitve Europass pred njo."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Datoteka, priložena temu PDF, je poškodovana in je ni bilo mogoče razpakirati. Znova prenesite življenjepis z europass.europa.eu in naložite to datoteko, kot je."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Datoteka, priložena temu PDF, je pakirana na način, ki ga Postulo ne bere (%(filter)s). Znova prenesite življenjepis z europass.europa.eu in naložite to datoteko, kot je."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Datoteka, priložena temu PDF, se razpakira v več kot %(limit)s MB, zato ni bila prebrana."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Datoteka vsebuje to kariero v več kot enem jeziku in prebran je bil samo prvi."

