#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Mistari iliyoongezwa ni Mathayo 17:21; 18:11; 23:14; Marko 7:16; 9:44, 46; 11:26; 15:28; Luka 17:36; 23:17; Yohana 5:4; Matendo 8:37; 15:34; 24:7; 28:29; na Waroma 16:24."
msgstr[1] "Orodha ya faili %(count)d kumbukumbu, na tu ya kwanza %(limit)d walikuwa kusoma."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Faili linaorodhesha matukio zaidi ya %(limit)d, na ni matukio %(limit)d ya kwanza tu yaliyosomwa."

