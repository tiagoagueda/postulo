#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s oli failis, kuid seda ei õnnestunud lugeda."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Soovitaja andmeid (%(parts)s) ei loeta: neid ei trükita kusagil. Iga soovitaja lisatakse veel küsimatuna, nii et ühtegi ei trükita enne, kui märgite, et ta on nõus."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Saavutused"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Sündmuse linke peale esimese ei loeta: sündmusel on üks aadress."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Suhtlemisoskused"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digioskused"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Haridus"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass"
msgstr "Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Tööalased oskused"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Keeled"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Juhtimine ja eestvedamine"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organisatoorsed oskused"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Muu"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Oskused"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Faili mõnel jaotisel pole Postulos veel kohta ja neid ei loetud: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "See ei näe välja nagu Europassi fail: sellel pole LearnerInfo jaotist."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Fail pole loetav JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Fail pole loetav XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Fail pole UTF-8, seega pole see Europassi eksport."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Fail on pesastatud sügavamale kui %(limit)s taset, seega seda ei loetud."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "See ei ole Europassi fail. Postulo loeb PDF-i, mille europass.europa.eu teile annab, sellele lisatud XML-i ning vanemat Europassi XML-i ja JSON-i; see ei ole ükski neist."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Sellele PDF-ile on lisatud faile ja ükski neist ei ole Europassi CV. Laadige üles PDF, mille europass.europa.eu teile annab, muutmata kujul."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Sellele PDF-ile ei ole midagi lisatud, seega selles pole Europassi CV-d, mida lugeda. PDF, mille europass.europa.eu teile annab, kannab CV-d lisatud failina ning teise programmiga uuesti prinditud või salvestatud PDF kaotab selle: laadige CV saidilt europass.europa.eu uuesti alla ja laadige see fail üles muutmata kujul."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "See PDF on krüptitud, seega sellele lisatud Europassi CV-d ei saa lugeda. Laadige CV saidilt europass.europa.eu uuesti alla ja laadige see fail üles muutmata kujul."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "See XML ei ole Europassi CV. Postulo loeb XML-i, mille kirjutab europass.europa.eu (Candidate), ja sellele eelnenud Europassi redaktori XML-i (SkillsPassport); see ei ole kumbki."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Euroopa CV vorming: PDF, mille europass.europa.eu teile annab, ja sellele lisatud XML ning sellele eelnenud Europassi teenuse vanem XML ja JSON."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Sellele PDF-ile lisatud fail on kahjustatud ja seda ei saanud lahti pakkida. Laadige CV saidilt europass.europa.eu uuesti alla ja laadige see fail üles muutmata kujul."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Sellele PDF-ile lisatud fail on pakitud viisil, mida Postulo ei loe (%(filter)s). Laadige CV saidilt europass.europa.eu uuesti alla ja laadige see fail üles muutmata kujul."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Sellele PDF-ile lisatud fail on lahtipakituna üle %(limit)s MB, seega seda ei loetud."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fail sisaldab seda karjääri mitmes keeles ja loeti ainult esimene."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Failis on %(count)d soovitaja ja loeti ainult esimesed %(limit)d."
msgstr[1] "Failis on %(count)d soovitajat ja loeti ainult esimesed %(limit)d."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Failis on rohkem kui %(limit)d sündmust ja loeti ainult esimesed %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Töökogemus"
