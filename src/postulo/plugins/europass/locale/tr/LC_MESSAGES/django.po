#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s dosyadaydı ama okunamadı."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Bir referansın şu bilgileri okunmaz, çünkü hiçbir yerde yazdırılmaz: %(parts)s. Her referans henüz sorulmamış olarak eklenir, bu yüzden kabul ettiklerini siz belirtene kadar hiçbiri yazdırılmaz."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Başarılar"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Bir etkinliğin ilkinden sonraki bağlantıları okunmaz: bir etkinlik tek bir adres tutar."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "İletişim becerileri"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Dijital beceriler"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Eğitim"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr ""

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "İşle ilgili beceriler"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Diller"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Yönetim ve liderlik"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Örgütsel beceriler"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Diğer beceriler"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Beceriler"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Dosyanın bazı bölümlerinin henüz Postulo'da karşılığı yok ve okunmadı: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Bu bir Europass dosyasına benzemiyor: içinde LearnerInfo bölümü yok."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "O dosya okunabilir JSON değil: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "O dosya okunabilir XML değil: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "O dosya UTF-8 değil, dolayısıyla bir Europass dışa aktarması değil."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "O dosya %(limit)s düzeyden daha derin iç içe geçmiş, bu yüzden okunmadı."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Bu bir Europass dosyası değil. Postulo, europass.europa.eu'nun size verdiği PDF'yi, ona ekli XML'i ve eski Europass XML ve JSON dosyalarını okur; bu, bunların hiçbiri değil."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Bu PDF'ye ekli dosyalar var, ancak hiçbiri bir Europass CV'si değil. europass.europa.eu'nun size verdiği PDF'yi olduğu gibi yükleyin."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF'ye ekli hiçbir şey yok, bu yüzden içinde okunacak bir Europass CV'si yok. europass.europa.eu'nun verdiği PDF, CV'yi ekli bir dosya olarak taşır; başka bir programla yazdırılan ya da yeniden kaydedilen bir PDF bunu kaybeder: CV'yi europass.europa.eu adresinden yeniden indirin ve o dosyayı olduğu gibi yükleyin."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF şifrelenmiş, bu yüzden ona ekli Europass CV'si okunamıyor. CV'yi europass.europa.eu adresinden yeniden indirin ve o dosyayı olduğu gibi yükleyin."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Bu XML bir Europass CV'si değil. Postulo, europass.europa.eu'nun yazdığı XML'i (Candidate) ve ondan önceki Europass düzenleyicisinin XML'ini (SkillsPassport) okur; bu ikisi de değil."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Avrupa CV biçimi: europass.europa.eu'nun size verdiği PDF ve ona ekli XML ile ondan önceki Europass hizmetinin eski XML ve JSON dosyaları."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF'ye ekli dosya hasarlı ve açılamadı. CV'yi europass.europa.eu adresinden yeniden indirin ve o dosyayı olduğu gibi yükleyin."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF dosyasına eklenmiş dosya, Postulo'nun okuyamadığı bir biçimde paketlenmiş (%(filter)s). CV'yi europass.europa.eu adresinden yeniden indirin ve o dosyayı olduğu gibi yükleyin."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Bu PDF'ye ekli dosya açıldığında %(limit)s MB'yi aşıyor, bu yüzden okunmadı."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Dosya bu kariyeri birden fazla dilde içeriyor; yalnızca ilki okundu."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Dosyada %(count)d referans var ve yalnızca ilk %(limit)d tanesi okundu."
msgstr[1] "Dosyada %(count)d referans var ve yalnızca ilk %(limit)d tanesi okundu."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Dosyada %(limit)d etkinlikten fazlası var ve yalnızca ilk %(limit)d tanesi okundu."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "İş deneyimi"
