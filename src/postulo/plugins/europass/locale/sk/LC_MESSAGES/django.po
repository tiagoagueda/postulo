#: src/postulo/plugins/europass/reader.py:818
#, draft
msgid "Achievements"
msgstr "Úspechy"

#: src/postulo/plugins/europass/candidate.py:727
msgid ""
"An event’s links past the first are not read: an event keeps one address."
msgstr ""

