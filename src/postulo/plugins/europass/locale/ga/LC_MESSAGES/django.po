#: src/postulo/plugins/europass/reader.py:802
#, draft
msgid "Achievements"
msgstr "Éachtaí"

#: src/postulo/plugins/europass/candidate.py:126
#: src/postulo/plugins/europass/reader.py:112
#, draft
msgid "Communication"
msgstr "Scileanna cumarsáide"

#: src/postulo/plugins/europass/candidate.py:134
#: src/postulo/plugins/europass/reader.py:110
#, draft
msgid "Digital"
msgstr "Scileanna digiteacha"

#: src/postulo/plugins/europass/reader.py:477
#: src/postulo/plugins/europass/reader.py:739
