#: src/postulo/plugins/europass/reader.py:604
#, python-format, draft
msgid "%(what)s was in the file but could not be read."
msgstr "Bhí %(what)s sa chomhad ach níorbh fhéidir é a léamh."

#: src/postulo/plugins/europass/reader.py:721
#, draft
msgid "Achievements"
msgstr "Éachtaí"

#: src/postulo/plugins/europass/reader.py:666
#, draft
msgid "Education"
msgstr "Oideachas"

#: src/postulo/plugins/europass/reader.py:299
#: src/postulo/plugins/europass/reader.py:583
#, draft
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Ní cosúil gur comhad Europass é seo: níl aon rannán LearnerInfo ann."

#: src/postulo/plugins/europass/reader.py:567
#, python-format, draft
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ní JSON inléite é an comhad seo: %(reason)s"

#: src/postulo/plugins/europass/reader.py:291
#, python-format, draft
msgid "That file is not readable XML: %(reason)s"
msgstr "Ní XML inléite é an comhad seo: %(reason)s"

#: src/postulo/plugins/europass/reader.py:564
#, draft
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Níl an comhad seo in UTF-8, mar sin ní easpórtáil Europass é."

#: src/postulo/plugins/europass/reader.py:572
#, python-format, draft
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr ""
"Tá an comhad seo neadaithe níos doimhne ná %(limit)s leibhéal, mar sin níor léadh é."

#: src/postulo/plugins/europass/reader.py:210
#, draft
msgid ""
"That is not a Europass file. Postulo reads the XML the CV editor produced and the JSON europass.europa.eu exports; this is neither."
msgstr ""
"Ní comhad Europass é sin. Léann Postulo an XML a rinne an t-eagarthóir CV agus an JSON a easpórtálann europass.europa.eu; níl an ceann seo ar cheachtar acu."

#: src/postulo/plugins/europass/__init__.py:33
#, draft
msgid ""
"The European CV format: the XML the Europass editor produces and the JSON europass.europa.eu exports."
msgstr ""
"Formáid CV na hEorpa: an XML a chruthaíonn eagarthóir Europass agus an JSON a easpórtálann europass.europa.eu."

#: src/postulo/plugins/europass/reader.py:643
#, draft
msgid "Work experience"
msgstr "Taithí oibre"
