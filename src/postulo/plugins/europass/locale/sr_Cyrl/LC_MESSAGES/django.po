#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s: постоји у датотеци, али није могло да се прочита."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Подаци препоруке (%(parts)s) се не читају: ништа их не приказује. Свака препорука се додаје као да препоручилац још није питан, па се ниједна не приказује док не наведете да је пристао."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Постигнућа"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Линкови догађаја после првог се не читају: догађај чува само једну адресу."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Комуникацијске вештине"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Дигиталне вештине"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Образовање"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Увоз из Europass-а"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Вештине везане за посао"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Језици"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Вештине управљања и руковођења"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Организационе вештине"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Остале вештине"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Вештине"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Неки одељци датотеке још немају своје место у апликацији Postulo и нису прочитани: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Ово не изгледа као Europass датотека: нема одељак LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Та датотека није читљив JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Та датотека није читљив XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Та датотека није UTF-8, па није Europass извоз."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Та датотека је угнеждена дубље од %(limit)s нивоа, па није прочитана."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "То није Europass датотека. Postulo чита PDF који даје europass.europa.eu, XML приложен уз њега и старији Europass XML и JSON; ово није ништа од тога."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Уз тај PDF су приложене датотеке, али ниједна није Europass CV. Отпремите PDF који даје europass.europa.eu, такав какав јесте."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Уз тај PDF није ништа приложено, па у њему нема Europass CV-ја за читање. PDF који даје europass.europa.eu носи CV као приложену датотеку, а PDF који је други програм поново одштампао или сачувао губи је: поново преузмите CV са europass.europa.eu и отпремите ту датотеку такву каква јесте."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Тај PDF је шифрован, па се Europass CV приложен уз њега не може прочитати. Поново преузмите CV са europass.europa.eu и отпремите ту датотеку такву каква јесте."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Тај XML није Europass CV. Postulo чита XML који пише europass.europa.eu (Candidate) и XML претходног Europass уређивача (SkillsPassport); ово није ни једно ни друго."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Европски формат CV-ја: PDF који даје europass.europa.eu и XML приложен уз њега, као и старији XML и JSON претходне услуге Europass."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Датотека приложена уз тај PDF је оштећена и није могла да се распакује. Поново преузмите CV са europass.europa.eu и отпремите ту датотеку такву каква јесте."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Датотека приложена уз тај PDF је запакована на начин који Postulo не чита (%(filter)s). Поново преузмите CV са europass.europa.eu и отпремите ту датотеку такву каква јесте."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Датотека приложена уз тај PDF се распакује у више од %(limit)s MB, па није прочитана."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Датотека садржи ову каријеру на више језика, а прочитан је само први."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Датотека наводи %(count)d препоруку, а прочитано је само првих %(limit)d."
msgstr[1] "Датотека наводи %(count)d препоруке, а прочитано је само првих %(limit)d."
msgstr[2] "Датотека наводи %(count)d препорука, а прочитано је само првих %(limit)d."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Датотека наводи више од %(limit)d догађаја, а прочитано је само првих %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Радно искуство"
