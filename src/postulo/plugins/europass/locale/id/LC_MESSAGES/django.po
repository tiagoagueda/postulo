#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s ada di dalam berkas tetapi tidak dapat dibaca."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Data %(parts)s pada referensi tidak dibaca: tidak ada yang menampilkannya. Setiap referensi ditambahkan sebagai belum ditanya, sehingga tidak ada yang dicetak sampai Anda menyatakan mereka setuju."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Prestasi"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Tautan entri selain yang pertama tidak dibaca: satu entri hanya menyimpan satu alamat."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Komunikasi"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digital"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Pendidikan"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr ""

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Terkait pekerjaan"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Bahasa"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Manajemen dan kepemimpinan"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organisasi"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Lainnya"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Keterampilan"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Beberapa bagian berkas belum memiliki tempat di Postulo dan tidak dibaca: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Itu tidak tampak seperti berkas Europass: tidak ada bagian LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Berkas itu bukan JSON yang dapat dibaca: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Berkas itu bukan XML yang dapat dibaca: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Berkas itu bukan UTF-8, jadi bukan ekspor Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Berkas itu bersarang lebih dari %(limit)s tingkat, sehingga tidak dibaca."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Itu bukan berkas Europass. Postulo membaca PDF yang diberikan europass.europa.eu, XML yang terlampir padanya, serta XML dan JSON Europass yang lebih lama; berkas ini bukan salah satunya."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "PDF itu memiliki lampiran berkas, tetapi tidak satu pun berupa CV Europass. Unggah PDF yang diberikan europass.europa.eu, apa adanya."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF itu tidak memiliki lampiran, sehingga tidak ada CV Europass di dalamnya untuk dibaca. PDF yang diberikan europass.europa.eu membawa CV sebagai berkas terlampir, dan PDF yang dicetak atau disimpan ulang oleh program lain kehilangan lampiran itu: unduh lagi CV dari europass.europa.eu dan unggah berkas itu apa adanya."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF itu terenkripsi, sehingga CV Europass yang terlampir padanya tidak dapat dibaca. Unduh lagi CV dari europass.europa.eu dan unggah berkas itu apa adanya."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "XML itu bukan CV Europass. Postulo membaca XML yang ditulis europass.europa.eu (sebuah Candidate) dan XML dari editor Europass sebelumnya (sebuah SkillsPassport); berkas ini bukan keduanya."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Format CV Eropa: PDF yang diberikan europass.europa.eu dan XML yang terlampir padanya, serta XML dan JSON lama dari layanan Europass sebelumnya."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Berkas yang terlampir pada PDF itu rusak dan tidak dapat dibongkar. Unduh lagi CV dari europass.europa.eu dan unggah berkas itu apa adanya."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Berkas yang terlampir pada PDF itu dikemas dengan cara yang tidak dibaca Postulo (%(filter)s). Unduh lagi CV dari europass.europa.eu dan unggah berkas itu apa adanya."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Berkas yang terlampir pada PDF itu berukuran lebih dari %(limit)s MB setelah dibongkar, sehingga tidak dibaca."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Berkas ini memuat riwayat karier ini dalam lebih dari satu bahasa, dan hanya yang pertama yang dibaca."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Berkas ini mencantumkan %(count)d referensi, dan hanya %(limit)d yang pertama yang dibaca."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Berkas ini mencantumkan lebih dari %(limit)d entri, dan hanya %(limit)d yang pertama yang dibaca."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Pengalaman kerja"
