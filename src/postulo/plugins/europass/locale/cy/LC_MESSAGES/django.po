#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Nid yw hwn yn edrych fel ffeil Europass: nid oes ganddi adran LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Nid yw'r ffeil honno'n JSON darllenadwy: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Nid yw'r ffeil honno'n XML darllenadwy: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Nid yw'r ffeil honno'n UTF-8, felly nid allforiad Europass mohoni."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Mae'r ffeil honno wedi'i nythu'n ddyfnach na %(limit)s lefel, felly ni chafodd ei darllen."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Nid ffeil Europass yw honno. Mae Postulo yn darllen y PDF y mae europass.europa.eu yn ei roi i chi, yr XML sydd ynghlwm wrtho, a'r hen XML a JSON Europass; nid yw hon yn un ohonynt."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Mae ffeiliau ynghlwm wrth y PDF hwnnw, ac nid yw'r un ohonynt yn CV Europass. Llwythwch i fyny'r PDF y mae europass.europa.eu yn ei roi i chi, fel y mae."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Nid oes dim ynghlwm wrth y PDF hwnnw, felly nid oes CV Europass ynddo i'w ddarllen. Mae'r PDF y mae europass.europa.eu yn ei roi i chi yn cario'r CV fel ffeil atodedig, ac mae PDF sydd wedi'i argraffu neu ei gadw eto gan raglen arall yn ei golli: llwythwch y CV i lawr eto o europass.europa.eu a llwythwch y ffeil honno i fyny fel y mae."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Mae'r PDF hwnnw wedi'i amgryptio, felly ni ellir darllen y CV Europass sydd ynghlwm wrtho. Llwythwch y CV i lawr eto o europass.europa.eu a llwythwch y ffeil honno i fyny fel y mae."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Nid CV Europass yw'r XML hwnnw. Mae Postulo yn darllen yr XML y mae europass.europa.eu yn ei ysgrifennu (Candidate) a'r un gan y golygydd Europass a ddaeth o'i flaen (SkillsPassport); nid yw hwn yn un o'r ddau."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Fformat CV Ewropeaidd: y PDF y mae europass.europa.eu yn ei roi i chi a'r XML sydd ynghlwm wrtho, a hen XML a JSON y gwasanaeth Europass a ddaeth o'i flaen."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Mae'r ffeil sydd ynghlwm wrth y PDF hwnnw wedi'i difrodi ac ni ellid ei dadbacio. Llwythwch y CV i lawr eto o europass.europa.eu a llwythwch y ffeil honno i fyny fel y mae."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Mae'r ffeil sydd ynghlwm wrth y PDF hwnnw wedi'i phacio mewn ffordd nad yw Postulo yn ei darllen (%(filter)s). Llwythwch y CV i lawr eto o europass.europa.eu a llwythwch y ffeil honno i fyny fel y mae."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Mae'r ffeil sydd ynghlwm wrth y PDF hwnnw'n dadbacio i fwy na %(limit)s MB, felly ni chafodd ei darllen."

