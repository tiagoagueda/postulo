#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Failas įdėtas giliau nei %(limit)s lygių, todėl nebuvo perskaitytas."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Tai nėra Europass failas. Postulo skaito PDF, kurį pateikia europass.europa.eu, prie jo prisegtą XML bei senesnį Europass XML ir JSON; tai nėra nė vienas iš jų."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Prie to PDF prisegti failai, ir nė vienas iš jų nėra Europass CV. Įkelkite PDF, kurį pateikia europass.europa.eu, tokį, koks jis yra."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Prie to PDF nieko neprisegta, todėl jame nėra Europass CV, kurį būtų galima perskaityti. PDF, kurį pateikia europass.europa.eu, neša CV kaip prisegtą failą, o kita programa vėl atspausdintas ar išsaugotas PDF jį praranda: atsisiųskite CV iš naujo iš europass.europa.eu ir įkelkite tą failą, koks jis yra."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Tas PDF užšifruotas, todėl prie jo prisegto Europass CV perskaityti negalima. Atsisiųskite CV iš naujo iš europass.europa.eu ir įkelkite tą failą, koks jis yra."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Tas XML nėra Europass CV. Postulo skaito XML, kurį rašo europass.europa.eu (Candidate), ir ankstesnio Europass redaktoriaus XML (SkillsPassport); šis nėra nė vienas iš jų."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Europos CV formatas: PDF, kurį pateikia europass.europa.eu, ir prie jo prisegtas XML, taip pat senesnis Europass paslaugos XML ir JSON."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Prie to PDF prisegtas failas pažeistas ir jo nepavyko išpakuoti. Atsisiųskite CV iš naujo iš europass.europa.eu ir įkelkite tą failą, koks jis yra."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Prie to PDF prisegtas failas supakuotas būdu, kurio Postulo neskaito (%(filter)s). Atsisiųskite CV iš naujo iš europass.europa.eu ir įkelkite tą failą, koks jis yra."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
