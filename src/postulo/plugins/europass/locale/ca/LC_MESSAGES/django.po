#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Una referència %(parts)s no es llegeix: res no ho imprimeix. Cada referència s' afegeix com encara no s'ha preguntat, de manera que cap no s' imprimirà fins que dieu que s'ha accedit."

