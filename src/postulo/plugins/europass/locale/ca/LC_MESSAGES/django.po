#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Això no sembla un fitxer Europass: no té cap secció LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Aquell fitxer no és JSON llegible: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
