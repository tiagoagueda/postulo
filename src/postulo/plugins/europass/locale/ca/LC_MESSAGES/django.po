#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s era al fitxer, però no s'ha pogut llegir."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "No es llegeix %(parts)s d'una referència: no es mostra enlloc. Cada referència s'afegeix com a encara no sol·licitada, de manera que no se n'imprimeix cap fins que indiqueu que hi han donat el consentiment."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Fites"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Els enllaços d'un esdeveniment a partir del segon no es llegeixen: un esdeveniment conserva una sola adreça."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Competències comunicatives"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Competències digitals"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Formació"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass"
msgstr "Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Competències professionals"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Llengües"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Gestió i lideratge"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Competències organitzatives"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Altres"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Competències"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Algunes seccions del fitxer encara no tenen lloc a Postulo i no s'han llegit: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Això no sembla un fitxer Europass: no té cap secció LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Aquell fitxer no és JSON llegible: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Aquell fitxer no és XML llegible: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Aquell fitxer no és UTF-8, així que no és una exportació d'Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Aquell fitxer té més de %(limit)s nivells d'imbricació, així que no s'ha llegit."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Aquest no és un fitxer Europass. Postulo llegeix el PDF que proporciona europass.europa.eu, l'XML que hi va adjunt i els antics XML i JSON d'Europass; aquest no és cap d'ells."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Aquest PDF té fitxers adjunts, però cap d'ells no és un CV Europass. Pugeu el PDF que us proporciona europass.europa.eu tal com és."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Aquest PDF no té res adjunt, així que no hi ha cap CV Europass a dins per llegir. El PDF que proporciona europass.europa.eu porta el CV com a fitxer adjunt, i un PDF que un altre programa imprimeix o torna a desar el perd: torneu a baixar el CV d'europass.europa.eu i pugeu aquest fitxer tal com és."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Aquest PDF està xifrat, de manera que no es pot llegir el CV Europass que hi va adjunt. Torneu a baixar el CV d'europass.europa.eu i pugeu aquest fitxer tal com és."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Aquest XML no és un CV Europass. Postulo llegeix l'XML que escriu europass.europa.eu (un Candidate) i el de l'editor Europass anterior (un SkillsPassport); aquest no és cap dels dos."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "El format europeu de CV: el PDF que proporciona europass.europa.eu i l'XML que hi va adjunt, i els antics XML i JSON del servei Europass anterior."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "El fitxer adjunt a aquest PDF està malmès i no s'ha pogut desempaquetar. Torneu a baixar el CV d'europass.europa.eu i pugeu aquest fitxer tal com és."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "El fitxer adjunt a aquest PDF està empaquetat d'una manera que Postulo no llegeix (%(filter)s). Torneu a baixar el CV d'europass.europa.eu i pugeu aquest fitxer tal com és."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "El fitxer adjunt a aquest PDF ocupa més de %(limit)s MB un cop desempaquetat, de manera que no s'ha llegit."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "El fitxer conté aquesta trajectòria en més d'un idioma, i només se n'ha llegit el primer."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "El fitxer inclou %(count)d referència, i només se n'ha llegit %(limit)d."
msgstr[1] "El fitxer inclou %(count)d referències, i només se n'han llegit les %(limit)d primeres."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "El fitxer inclou més de %(limit)d esdeveniments, i només s'han llegit els %(limit)d primers."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Experiència laboral"
