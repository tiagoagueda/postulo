#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Quella datoteca n'è betg en UTF-8, perquai n'è ella betg in export Europass."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Quella datoteca è inchaschada pli profund che %(limit)s nivels, perquai n'è ella betg vegnida legida."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Quai n'è betg ina datoteca Europass. Postulo legia il PDF che europass.europa.eu As dat, l'XML agiuntà ad el e l'XML ed il JSON Europass pli vegls; quai n'è nagin da quels."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Quel PDF ha datotecas agiuntadas, e nagina da quellas n'è in CV Europass. Chargiai si il PDF che europass.europa.eu As dat, tal qual."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Quel PDF n'ha nagut agiuntà, perquai na datti nagin CV Europass en el da leger. Il PDF che europass.europa.eu As dat porta il CV sco datoteca agiuntada, ed in PDF stampà u arcunà danovamain d'in auter program al perda: telechargiai il CV anc ina giada da europass.europa.eu e chargiai si quella datoteca tal qual."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Quel PDF è criptà, perquai na po il CV Europass agiuntà ad el betg vegnir legì. Telechargiai il CV anc ina giada da europass.europa.eu e chargiai si quella datoteca tal qual."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Quel XML n'è betg in CV Europass. Postulo legia l'XML che europass.europa.eu scriva (in Candidate) e quel da l'editur Europass precedent (in SkillsPassport); quai n'è nagin dals dus."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Il format europeic da CV: il PDF che europass.europa.eu As dat e l'XML agiuntà ad el, sco era l'XML ed il JSON pli vegls dal servetsch Europass precedent."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "La datoteca agiuntada a quel PDF è donnegiada e n'ha betg pudì vegnir decumprimida. Telechargiai il CV anc ina giada da europass.europa.eu e chargiai si quella datoteca tal qual."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "La datoteca agiuntada a quel PDF è cumprimida en ina moda che Postulo na legia betg (%(filter)s). Telechargiai il CV anc ina giada da europass.europa.eu e chargiai si quella datoteca tal qual."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "La datoteca agiuntada a quel PDF dat decumprimida dapli che %(limit)s MB, perquai n'è ella betg vegnida legida."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "La datoteca cuntegna quest percurs en pliras linguas, e mo l'emprima è vegnida legida."

