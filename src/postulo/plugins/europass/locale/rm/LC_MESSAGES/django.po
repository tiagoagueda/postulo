#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "La datoteca enumerescha %(count)d referenza, e mo l'emprima %(limit)d è vegnida legida."
msgstr[1] "La datoteca enumerescha %(count)d referenzas, e mo las emprimas %(limit)d èn vegnidas legidas."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
