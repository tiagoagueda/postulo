#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s було у файлі, але прочитати не вдалося."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Поля рекомендації (%(parts)s) не читаються: їх ніде не друкують. Кожну рекомендацію додано як ще не запитану, тож жодну не буде надруковано, доки ви не вкажете, що людина погодилася."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Досягнення"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Посилання події, крім першого, не читаються: подія зберігає одну адресу."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Комунікаційні навички"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Цифрові навички"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Освіта"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass"
msgstr "Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Навички, пов’язані з роботою"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Мови"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Управління та лідерство"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Організаційні навички"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Інші навички"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Навички"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Деяким розділам файлу ще немає місця в Postulo, тож їх не прочитано: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Це не схоже на файл Europass: у ньому немає розділу LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Цей файл не є коректним JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Цей файл не є коректним XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Цей файл не в UTF-8, тож це не експорт Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "У цьому файлі вкладеність глибша за %(limit)s рівнів, тож його не прочитано."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Це не файл Europass. Postulo читає PDF, який видає europass.europa.eu, вкладений у нього XML, а також старіші XML і JSON Europass; цей файл не є жодним із них."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "До цього PDF вкладено файли, але жоден із них не є резюме Europass. Завантажте PDF, який видає europass.europa.eu, без змін."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "До цього PDF нічого не вкладено, тож у ньому немає резюме Europass для читання. PDF, який видає europass.europa.eu, містить резюме як вкладений файл, а PDF, надрукований або повторно збережений іншою програмою, його втрачає: знову отримайте резюме з europass.europa.eu і завантажте цей файл без змін."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Цей PDF зашифровано, тому вкладене в нього резюме Europass неможливо прочитати. Знову отримайте резюме з europass.europa.eu і завантажте цей файл без змін."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Цей XML не є резюме Europass. Postulo читає XML, який створює europass.europa.eu (Candidate), і XML попереднього редактора Europass (SkillsPassport); це ні те, ні інше."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Європейський формат резюме: PDF, який видає europass.europa.eu, і вкладений у нього XML, а також старіші XML і JSON попереднього сервісу Europass."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Файл, вкладений у цей PDF, пошкоджений, і його не вдалося розпакувати. Знову отримайте резюме з europass.europa.eu і завантажте цей файл без змін."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Файл, вкладений у цей PDF, запаковано способом, який Postulo не читає (%(filter)s). Знову отримайте резюме з europass.europa.eu і завантажте цей файл без змін."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Файл, вкладений у цей PDF, після розпакування займає понад %(limit)s МБ, тож його не прочитано."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Файл містить цю кар’єру кількома мовами, і прочитано лише першу."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Рекомендацій у файлі: %(count)d; прочитано лише перші %(limit)d."
msgstr[1] "Рекомендацій у файлі: %(count)d; прочитано лише перші %(limit)d."
msgstr[2] "Рекомендацій у файлі: %(count)d; прочитано лише перші %(limit)d."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Подій у файлі більше за %(limit)d; прочитано лише перші %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Досвід роботи"
