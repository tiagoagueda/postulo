#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s se afla în fișier, dar nu a putut fi citit."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Din referințe nu se citesc %(parts)s: nu sunt tipărite nicăieri. Fiecare referință este adăugată ca încă nesolicitată, așa că niciuna nu este tipărită până când nu indicați că persoana și-a dat acordul."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Realizări"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Linkurile unui eveniment în afară de primul nu sunt citite: un eveniment păstrează o singură adresă."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Competențe de comunicare"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Competențe digitale"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Educație"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr ""

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Competențe profesionale"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Limbi"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Management și conducere"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Competențe organizatorice"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Altul"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Competențe"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Unele secțiuni ale fișierului nu au încă unde să meargă în Postulo și nu au fost citite: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Acesta nu pare un fișier Europass: nu are secțiune LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Fișierul nu este JSON lizibil: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Fișierul nu este XML lizibil: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Fișierul nu este UTF-8, deci nu este un export Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Fișierul este imbricat pe mai mult de %(limit)s niveluri, așa că nu a fost citit."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Acesta nu este un fișier Europass. Postulo citește PDF-ul pe care vi-l oferă europass.europa.eu, XML-ul atașat acestuia, precum și XML-ul și JSON-ul Europass mai vechi; acesta nu este niciunul dintre ele."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Acel PDF are fișiere atașate, dar niciunul nu este un CV Europass. Încărcați PDF-ul pe care vi-l oferă europass.europa.eu, așa cum este."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Acel PDF nu are nimic atașat, așa că nu conține niciun CV Europass de citit. PDF-ul pe care vi-l oferă europass.europa.eu conține CV-ul ca fișier atașat, iar un PDF tipărit sau salvat din nou de alt program îl pierde: descărcați din nou CV-ul de pe europass.europa.eu și încărcați acel fișier așa cum este."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Acel PDF este criptat, așa că CV-ul Europass atașat nu poate fi citit. Descărcați din nou CV-ul de pe europass.europa.eu și încărcați acel fișier așa cum este."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Acel XML nu este un CV Europass. Postulo citește XML-ul pe care îl scrie europass.europa.eu (un Candidate) și pe cel al editorului Europass dinaintea lui (un SkillsPassport); acesta nu este niciunul."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Formatul european de CV: PDF-ul pe care vi-l oferă europass.europa.eu și XML-ul atașat acestuia, precum și XML-ul și JSON-ul mai vechi ale serviciului Europass anterior."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Fișierul atașat la acel PDF este deteriorat și nu a putut fi despachetat. Descărcați din nou CV-ul de pe europass.europa.eu și încărcați acel fișier așa cum este."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Fișierul atașat la acel PDF este împachetat într-un mod pe care Postulo nu îl citește (%(filter)s). Descărcați din nou CV-ul de pe europass.europa.eu și încărcați acel fișier așa cum este."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Fișierul atașat la acel PDF se despachetează la mai mult de %(limit)s MB, așa că nu a fost citit."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fișierul conține această carieră în mai multe limbi și doar prima a fost citită."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Fișierul conține %(count)d referință și s-au citit doar primele %(limit)d."
msgstr[1] "Fișierul conține %(count)d referințe și s-au citit doar primele %(limit)d."
msgstr[2] "Fișierul conține %(count)d de referințe și s-au citit doar primele %(limit)d."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Fișierul conține mai multe evenimente decât limita de %(limit)d și s-au citit doar primele %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Experiență profesională"
