#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s figurait dans le fichier mais n'a pas pu être lu."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Ces éléments d'une référence ne sont pas lus, car rien ne les imprime : %(parts)s. Chaque référence est ajoutée comme pas encore sollicitée : aucune n'est donc imprimée tant que vous n'avez pas indiqué que la personne a donné son accord."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Réalisations"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Seul le premier lien d'un événement est lu : un événement ne garde qu'une adresse."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Compétences en communication"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Compétences numériques"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Éducation et formation"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Import Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Compétences liées à l'emploi"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Langues"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Compétences en gestion et en encadrement"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Compétences organisationnelles"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Autres compétences"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Compétences"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Certaines sections du fichier n'ont pas encore de place dans Postulo et n'ont pas été lues : %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Ce n'est pas un fichier Europass : il n'a pas de section LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ce fichier n'est pas un JSON lisible : %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ce fichier n'est pas un XML lisible : %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ce fichier n'est pas en UTF-8 : ce n'est donc pas un export Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ce fichier comporte plus de %(limit)s niveaux d'imbrication : il n'a donc pas été lu."

#: src/postulo/plugins/europass/credential.py
msgid "That is a European Digital Credential in the old XML format, which Postulo does not read. Download it again from your Europass wallet, where it has been converted, and upload that file."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Ce n'est pas un fichier Europass. Postulo lit le PDF que vous fournit europass.europa.eu, le XML qui y est joint, ainsi que l'ancien XML et l'ancien JSON Europass; ce fichier n'est rien de tout cela."

#: src/postulo/plugins/europass/credential.py
msgid "That is not a European Digital Credential Postulo can read. It reads the JSON-LD the Europass wallet gives you, sealed or not."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ce PDF contient des fichiers joints, mais aucun n'est un CV Europass. Téléversez le PDF que vous fournit europass.europa.eu, tel quel."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ce PDF ne contient aucun fichier joint : il n'y a donc pas de CV Europass à y lire. Le PDF que vous fournit europass.europa.eu contient le CV en pièce jointe, et un PDF imprimé ou réenregistré par un autre programme la perd : téléchargez à nouveau le CV depuis europass.europa.eu et téléversez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ce PDF est chiffré : le CV Europass qui y est joint ne peut donc pas être lu. Téléchargez à nouveau le CV depuis europass.europa.eu et téléversez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ce XML n'est pas un CV Europass. Postulo lit le XML qu'écrit europass.europa.eu (un Candidate) et celui de l'éditeur Europass qui l'a précédé (un SkillsPassport); ce fichier n'est ni l'un ni l'autre."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it. Also reads what a European Digital Credential you keep under Files states."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Le fichier joint à ce PDF est endommagé et n'a pas pu être décompressé. Téléchargez à nouveau le CV depuis europass.europa.eu et téléversez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Le fichier joint à ce PDF est compressé d'une façon que Postulo ne sait pas lire (%(filter)s). Téléchargez à nouveau le CV depuis europass.europa.eu et téléversez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Une fois décompressé, le fichier joint à ce PDF dépasse %(limit)s Mo : il n'a donc pas été lu."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Le fichier contient ce parcours en plusieurs langues, et seule la première a été lue."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Le fichier compte %(count)d référence, et seule la première (%(limit)d) a été lue."
msgstr[1] "Le fichier compte %(count)d références, et seules les %(limit)d premières ont été lues."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Le fichier compte plus de %(limit)d événements, et seuls les %(limit)d premiers ont été lus."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Expérience professionnelle"
