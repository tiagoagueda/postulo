#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s estaba no ficheiro, pero non se puido ler."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Non se le %(parts)s dunha referencia: nada o mostra. Cada referencia engádese como aínda non consultada, así que ningunha se mostra ata que indiques que aceptou."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Logros"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Das ligazóns dun evento só se le a primeira: un evento conserva un único enderezo."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Competencias comunicativas"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Competencias dixitais"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Formación"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Importación de Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Competencias profesionais"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Linguas"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Xestión e liderado"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Competencias organizativas"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Outro"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Competencias"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Algunhas seccións do ficheiro aínda non teñen sitio no Postulo e non se leron: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Isto non semella un ficheiro Europass: non ten ningunha sección LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ese ficheiro non é JSON lexible: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ese ficheiro non é XML lexible: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ese ficheiro non é UTF-8, así que non é unha exportación de Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ese ficheiro aniña máis de %(limit)s niveis, así que non se leu."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Ese non é un ficheiro Europass. O Postulo le o PDF que che dá europass.europa.eu, o XML anexado a el e o XML e o JSON antigos de Europass; isto non é ningún deles."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ese PDF ten ficheiros anexados, e ningún deles é un CV Europass. Carga o PDF que che dá europass.europa.eu, tal como está."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ese PDF non ten nada anexado, así que dentro non hai ningún CV Europass que ler. O PDF que che dá europass.europa.eu leva o CV como ficheiro anexado, e un PDF impreso ou gardado de novo por outro programa pérdeo: descarga de novo o CV de europass.europa.eu e carga ese ficheiro tal como está."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ese PDF está cifrado, así que non se pode ler o CV Europass anexado a el. Descarga de novo o CV de europass.europa.eu e carga ese ficheiro tal como está."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ese XML non é un CV Europass. O Postulo le o XML que escribe europass.europa.eu (un Candidate) e o do editor Europass anterior (un SkillsPassport); isto non é ningún dos dous."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "O formato europeo de CV: o PDF que che dá europass.europa.eu e o XML anexado a el, e o XML e o JSON máis antigos do servizo Europass anterior."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "O ficheiro anexado a ese PDF está danado e non se puido desempaquetar. Descarga de novo o CV de europass.europa.eu e carga ese ficheiro tal como está."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "O ficheiro anexado a ese PDF está empaquetado dun xeito que o Postulo non le (%(filter)s). Descarga de novo o CV de europass.europa.eu e carga ese ficheiro tal como está."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "O ficheiro anexado a ese PDF ocupa máis de %(limit)s MB ao desempaquetalo, así que non se leu."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "O ficheiro contén esta traxectoria en máis dun idioma, e só se leu o primeiro."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "O ficheiro inclúe %(count)d referencia, e só se leron as %(limit)d primeiras."
msgstr[1] "O ficheiro inclúe %(count)d referencias, e só se leron as %(limit)d primeiras."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "O ficheiro inclúe máis de %(limit)d eventos, e só se leron os %(limit)d primeiros."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Experiencia laboral"
