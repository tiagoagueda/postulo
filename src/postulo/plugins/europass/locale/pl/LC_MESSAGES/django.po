msgstr "Komunikacyjne"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Cyfrowe"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Wykształcenie"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr ""

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Zawodowe"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Języki"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Zarządzanie i przywództwo"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organizacyjne"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Inne"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Umiejętności"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Niektóre sekcje pliku nie mają jeszcze w Postulo miejsca i nie zostały odczytane: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "To nie wygląda na plik Europass: nie ma sekcji LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ten plik nie jest czytelnym JSON-em: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ten plik nie jest czytelnym XML-em: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ten plik nie jest w UTF-8, więc nie jest eksportem Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ten plik jest zagnieżdżony głębiej niż %(limit)s poziomów, więc nie został odczytany."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "To nie jest plik Europass. Postulo odczytuje PDF, który daje europass.europa.eu, dołączony do niego XML oraz starszy XML i JSON Europass; to nie jest żaden z nich."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ten PDF ma dołączone pliki, ale żaden z nich nie jest CV Europass. Prześlij bez zmian PDF otrzymany z europass.europa.eu."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ten PDF nie ma żadnych załączników, więc nie ma w nim CV Europass do odczytania. PDF otrzymany z europass.europa.eu zawiera CV jako załączony plik, a PDF wydrukowany lub zapisany ponownie przez inny program go traci: pobierz CV ponownie z europass.europa.eu i prześlij ten plik bez zmian."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ten PDF jest zaszyfrowany, więc dołączonego do niego CV Europass nie można odczytać. Pobierz CV ponownie z europass.europa.eu i prześlij ten plik bez zmian."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ten XML nie jest CV Europass. Postulo odczytuje XML zapisywany przez europass.europa.eu (Candidate) oraz XML poprzedniego edytora Europass (SkillsPassport); ten nie jest żadnym z nich."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Europejski format CV: PDF, który daje europass.europa.eu, dołączony do niego XML oraz starszy XML i JSON usługi Europass sprzed niego."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Plik dołączony do tego PDF jest uszkodzony i nie dało się go rozpakować. Pobierz CV ponownie z europass.europa.eu i prześlij ten plik bez zmian."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Plik dołączony do tego PDF jest spakowany w sposób, którego Postulo nie odczytuje (%(filter)s). Pobierz CV ponownie z europass.europa.eu i prześlij ten plik bez zmian."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Plik dołączony do tego PDF po rozpakowaniu zajmuje ponad %(limit)s MB, więc nie został odczytany."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Plik zawiera ten przebieg kariery w więcej niż jednym języku; odczytano tylko pierwszy."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Plik wymienia %(count)d referencję; odczytano tylko pierwsze z nich (limit: %(limit)d)."
msgstr[1] "Plik wymienia %(count)d referencje; odczytano tylko pierwsze z nich (limit: %(limit)d)."
msgstr[2] "Plik wymienia %(count)d referencji; odczytano tylko pierwsze z nich (limit: %(limit)d)."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Plik wymienia więcej wydarzeń niż %(limit)d; odczytano tylko pierwsze %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Doświadczenie zawodowe"
