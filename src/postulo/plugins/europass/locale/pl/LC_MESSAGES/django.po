#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s było w pliku, ale nie dało się tego odczytać."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Tych danych referencji nie odczytano: %(parts)s – nic ich nie drukuje. Każda referencja jest dodawana jako jeszcze niezapytana, więc żadna nie zostanie wydrukowana, dopóki nie zaznaczysz, że osoba wyraziła zgodę."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Osiągnięcia"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Linki wydarzenia poza pierwszym nie są odczytywane: wydarzenie przechowuje jeden adres."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
