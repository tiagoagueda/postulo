#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s fitxategian zegoen, baina ezin izan da irakurri."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Erreferentzia-pertsona baten %(parts)s ez da irakurtzen: ezerk ez du inprimatzen. Erreferentzia-pertsona bakoitza «oraindik galdetu gabe» gisa gehitzen da; beraz, ez da bat ere inprimatuko onartu dutela adierazi arte."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Lorpenak"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Gertaera baten lehenengoaren ondorengo estekak ez dira irakurtzen: gertaera batek helbide bakarra gordetzen du."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Komunikazio-gaitasunak"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Gaitasun digitalak"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Prestakuntza"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Europass inportazioa"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Lanari lotutako gaitasunak"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Hizkuntzak"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Kudeaketa eta lidergoa"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Antolaketa-gaitasunak"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Beste gaitasun batzuk"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Gaitasunak"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Fitxategiko atal batzuek oraindik ez dute lekurik Postulon, eta ez dira irakurri: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Honek ez du Europass fitxategi baten itxurarik: ez du LearnerInfo atalik."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Fitxategi hori ez da JSON irakurgarria: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Fitxategi hori ez da XML irakurgarria: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Fitxategi hori ez dago UTF-8 kodeketan; beraz, ez da Europass esportazio bat."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Fitxategi hori %(limit)s maila baino sakonago habiaratuta dago, beraz ez da irakurri."

#: src/postulo/plugins/europass/credential.py
msgid "That is a European Digital Credential in the old XML format, which Postulo does not read. Download it again from your Europass wallet, where it has been converted, and upload that file."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Hori ez da Europass fitxategi bat. Postulok hauek irakurtzen ditu: europass.europa.eu guneak ematen dizun PDFa, hari erantsitako XMLa, eta Europass-en XML eta JSON zaharragoak; hau ez da horietako bat ere."

#: src/postulo/plugins/europass/credential.py
msgid "That is not a European Digital Credential Postulo can read. It reads the JSON-LD the Europass wallet gives you, sealed or not."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "PDF horrek fitxategiak ditu erantsita, baina horietako bat ere ez da Europass CV bat. Igo europass.europa.eu guneak ematen dizun PDFa, dagoen bezala."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF horrek ez du ezer erantsita; beraz, ez dago barruan irakurtzeko Europass CVrik. europass.europa.eu guneak ematen dizun PDFak CVa fitxategi erantsi gisa darama, eta beste programa batek inprimatu edo berriro gordetako PDF batek galdu egiten du: deskargatu CVa berriro europass.europa.eu gunetik eta igo fitxategi hori dagoen bezala."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF hori zifratuta dago; beraz, ezin da irakurri hari erantsitako Europass CVa. Deskargatu CVa berriro europass.europa.eu gunetik eta igo fitxategi hori dagoen bezala."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "XML hori ez da Europass CV bat. Postulok europass.europa.eu guneak idazten duen XMLa (Candidate bat) eta aurreko Europass editorearena (SkillsPassport bat) irakurtzen ditu; hau ez da horietako bat ere."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it. Also reads what a European Digital Credential you keep under Files states."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF horri erantsitako fitxategia hondatuta dago, eta ezin izan da deskonprimitu. Deskargatu CVa berriro europass.europa.eu gunetik eta igo fitxategi hori dagoen bezala."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF horri erantsitako fitxategia Postulok irakurtzen ez duen modu batean dago paketatuta (%(filter)s). Deskargatu CVa berriro europass.europa.eu gunetik eta igo fitxategi hori dagoen bezala."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "PDF horri erantsitako fitxategiak %(limit)s MB baino gehiago hartzen ditu deskonprimitzean; beraz, ez da irakurri."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fitxategiak ibilbide profesional hau hizkuntza batean baino gehiagotan dauka, eta lehenengoa soilik irakurri da."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Fitxategiak erreferentzia bat zerrendatzen du, eta lehenengo %(limit)d soilik irakurri da."
msgstr[1] "Fitxategiak %(count)d erreferentzia zerrendatzen ditu, eta lehenengo %(limit)d soilik irakurri dira."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Fitxategiak %(limit)d gertaera baino gehiago zerrendatzen ditu, eta lehen %(limit)d bakarrik irakurri dira."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Lan-esperientzia"
