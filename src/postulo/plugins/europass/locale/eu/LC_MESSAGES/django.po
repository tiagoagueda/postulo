#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Fitxategi hori ez da UTF-8, beraz ez da Europass esportazioa."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Fitxategi hori %(limit)s maila baino sakonago habiaratuta dago, beraz ez da irakurri."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Hori ez da Europass fitxategia. Postulok irakurtzen du PDF europass.europa.eu-k ematen dizu, XML erantsita, eta Europass-en XML eta JSON zaharra; hau ez da horietako bat."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "PDF horrek fitxategiak ditu erantsita, eta horietako bat ere ez da Europass-eko CV bat. Igo PDF europass.europa.eu-k ematen dizuna."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF horrek ez du ezer erantsi, beraz, ez dago Europass CVrik barruan irakurtzeko. PDF europas.europa.eu-k ematen dizu CVa erantsitako fitxategi gisa, eta beste programa batek inprimatu edo gorde duen PDF batek galtzen du: deskargatu curriculuma berriro europas.europa.eu-tik eta igo fitxategia dagoen bezala."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDFa enkriptatuta dago, beraz, Europas-eko CVa ezin da irakurri. Deskargatu curriculuma berriro europas.europa.eu-tik eta igo fitxategia dagoen bezala."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "XML hori ez da Europass CV bat. Postulok XML europass.europa.eu idazten du (hautesle bat) eta Europassseko editoreak ( SkillsPassport bat), hau ez da bat ere."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Europako CV formatua: PDF europass.europa.eu-k zuri eta horri erantsitako XMLa eta Europasss zerbitzuaren XML zaharra eta JSONa."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF horri erantsitako fitxategia hondatuta dago eta ezin da deskonprimitu. Deskargatu curriculuma berriro europas.europa.eu-tik eta igo fitxategia dagoen bezala."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "PDF horri erantsitako fitxategia Postulok ez du irakurtzen (%(filter)s). Deskargatu curriculuma berriro europas.europa.eu-tik eta igo fitxategia dagoen bezala."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "PDF deskonprimitzei erantsitako fitxategia %(limit)s MB baino gehiagori, beraz ez zen irakurri."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fitxategiak karrera hau hizkuntza batean baino gehiagotan du, eta lehenengoa bakarrik irakurri da."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Fitxategiak erreferentzia zerrenda bat du, eta lehenengoa soilik irakurri da."
msgstr[1] "Fitxategiak erreferentziak zerrendatzen ditu, eta lehenak bakarrik irakurtzen dira."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Fitxategiak gertaerak baino gehiago zerrendatzen ditu, eta lehenak bakarrik irakurri ziren."

