#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s szerepelt a fájlban, de nem sikerült beolvasni."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "A referenciaszemélyeknél ezek nem kerülnek beolvasásra, mert semmi sem jeleníti meg őket: %(parts)s. Minden referenciaszemély „még nem kérdezve” állapotban kerül be, így egyik sem szerepel nyomtatásban, amíg meg nem adja, hogy hozzájárultak."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Eredmények"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Egy eseménynek csak az első hivatkozása kerül beolvasásra: egy esemény egyetlen címet tárol."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Kommunikációs készségek"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitális készségek"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Tanulmányok"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Europass-importálás"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Munkával kapcsolatos készségek"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Nyelvek"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Vezetés és irányítás"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Szervezési készségek"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Egyéb"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Készségek"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "A fájl egyes szakaszainak a Postulóban még nincs hová kerülniük, ezért nem lettek beolvasva: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Ez nem úgy néz ki, mint egy Europass-fájl: nincs benne LearnerInfo szakasz."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ez a fájl nem olvasható JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ez a fájl nem olvasható XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ez a fájl nem UTF-8, tehát nem Europass-export."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ez a fájl %(limit)s szintnél mélyebben ágyazott, ezért nem lett beolvasva."

#: src/postulo/plugins/europass/credential.py
msgid "That is a European Digital Credential in the old XML format, which Postulo does not read. Download it again from your Europass wallet, where it has been converted, and upload that file."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Ez nem Europass-fájl. A Postulo az europass.europa.eu által adott PDF-et, a hozzá csatolt XML-t, valamint a régebbi Europass XML-t és JSON-t olvassa; ez egyik sem."

#: src/postulo/plugins/europass/credential.py
msgid "That is not a European Digital Credential Postulo can read. It reads the JSON-LD the Europass wallet gives you, sealed or not."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ehhez a PDF-hez fájlok vannak csatolva, de egyik sem Europass-önéletrajz. Töltse fel az europass.europa.eu által adott PDF-et, változtatás nélkül."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ehhez a PDF-hez semmi sincs csatolva, ezért nincs benne beolvasható Europass-önéletrajz. Az europass.europa.eu által adott PDF az önéletrajzot csatolt fájlként hordozza, és egy másik program által újranyomtatott vagy újramentett PDF elveszíti azt: töltse le újra az önéletrajzot az europass.europa.eu oldalról, és azt a fájlt töltse fel változtatás nélkül."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ez a PDF titkosított, ezért a hozzá csatolt Europass-önéletrajz nem olvasható. Töltse le újra az önéletrajzot az europass.europa.eu oldalról, és azt a fájlt töltse fel változtatás nélkül."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ez az XML nem Europass-önéletrajz. A Postulo az europass.europa.eu által írt XML-t (Candidate) és az előtte használt Europass-szerkesztő XML-jét (SkillsPassport) olvassa; ez egyik sem."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it. Also reads what a European Digital Credential you keep under Files states."
msgstr ""

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "A PDF-hez csatolt fájl sérült, és nem lehetett kicsomagolni. Töltse le újra az önéletrajzot az europass.europa.eu oldalról, és azt a fájlt töltse fel változtatás nélkül."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "A PDF-hez csatolt fájl olyan módon van csomagolva, amelyet a Postulo nem olvas (%(filter)s). Töltse le újra az önéletrajzot az europass.europa.eu oldalról, és azt a fájlt töltse fel változtatás nélkül."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "A PDF-hez csatolt fájl több mint %(limit)s MB-ra csomagolódik ki, ezért nem lett beolvasva."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "A fájl ezt a pályafutást több nyelven is tartalmazza, de csak az első lett beolvasva."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "A fájl %(count)d referenciaszemélyt sorol fel, de csak az első %(limit)d lett beolvasva."
msgstr[1] "A fájl %(count)d referenciaszemélyt sorol fel, de csak az első %(limit)d lett beolvasva."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "A fájl több mint %(limit)d eseményt sorol fel, de csak az első %(limit)d lett beolvasva."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Szakmai tapasztalat"
