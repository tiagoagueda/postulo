msgstr "Ce fichier n'est pas du JSON lisible : %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ce fichier n'est pas du XML lisible : %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ce fichier n'est pas en UTF-8, ce n'est donc pas un export Europass."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ce fichier est imbriqué sur plus de %(limit)s niveaux, il n'a donc pas été lu."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Ce n'est pas un fichier Europass. Postulo lit le PDF que vous remet europass.europa.eu, le XML qui y est joint, ainsi que l'ancien XML et l'ancien JSON Europass ; celui-ci n'est rien de tout cela."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ce PDF contient des fichiers joints, mais aucun n'est un CV Europass. Envoyez le PDF que vous remet europass.europa.eu, tel quel."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ce PDF ne contient aucun fichier joint : il n'y a donc pas de CV Europass à y lire. Le PDF que vous remet europass.europa.eu porte le CV en fichier joint, et un PDF imprimé ou réenregistré par un autre programme le perd : téléchargez de nouveau le CV depuis europass.europa.eu et envoyez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ce PDF est chiffré : le CV Europass qui y est joint ne peut donc pas être lu. Téléchargez de nouveau le CV depuis europass.europa.eu et envoyez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ce XML n'est pas un CV Europass. Postulo lit le XML qu'écrit europass.europa.eu (un Candidate) et celui de l'éditeur Europass qui l'a précédé (un SkillsPassport) ; celui-ci n'est ni l'un ni l'autre."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Le format européen de CV : le PDF que vous remet europass.europa.eu et le XML qui y est joint, ainsi que l'ancien XML et l'ancien JSON du service Europass qui l'a précédé."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Le fichier joint à ce PDF est endommagé et n'a pas pu être décompressé. Téléchargez de nouveau le CV depuis europass.europa.eu et envoyez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Le fichier joint à ce PDF est compressé d'une façon que Postulo ne lit pas (%(filter)s). Téléchargez de nouveau le CV depuis europass.europa.eu et envoyez ce fichier tel quel."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Le fichier joint à ce PDF dépasse %(limit)s Mo une fois décompressé ; il n'a donc pas été lu."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Le fichier contient ce parcours en plusieurs langues, et seule la première a été lue."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Le fichier liste %(count)d référence, et seule la première %(limit)d a été lue."
msgstr[1] "Le fichier liste %(count)d références, et seules les %(limit)d premières ont été lues."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Le fichier liste plus de %(limit)d événements, et seuls les %(limit)d premiers ont été lus."

