#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s d’une référence n’est pas lu : rien ne l’imprime. Chaque référence est ajoutée comme pas encore demandée : aucune n’est imprimée avant que vous n’indiquiez son accord."

