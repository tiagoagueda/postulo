msgid "Languages"
msgstr "Lingwi"

#: src/postulo/plugins/europass/candidate.py:131
#, draft
msgid "Management and leadership"
msgstr "Ġestjoni u tmexxija"

#: src/postulo/plugins/europass/candidate.py:122
#: src/postulo/plugins/europass/reader.py:111
