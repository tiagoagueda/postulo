#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "Faylda vardı, lakin oxuna bilmədi: %(what)s."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Tövsiyəçi haqqında bu hissələr oxunmur: %(parts)s. Onları heç nə göstərmir. Hər tövsiyəçi hələ soruşulmamış kimi əlavə edilir, ona görə də razılıq verdiklərini bildirənə qədər heç biri göstərilmir."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Nailiyyətlər"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Tədbirin birincidən sonrakı keçidləri oxunmur: tədbir yalnız bir ünvan saxlayır."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Ünsiyyət"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Rəqəmsal"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Təhsil"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr ""

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "İşlə bağlı"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Dillər"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "İdarəetmə və liderlik"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Təşkilatçılıq"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Digər"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Bacarıqlar"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Faylın bəzi bölmələri üçün Postulo-da hələ yer yoxdur və onlar oxunmadı: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Bu, Europass faylına oxşamır: onda LearnerInfo bölməsi yoxdur."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Bu fayl oxunaqlı JSON deyil: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Bu fayl oxunaqlı XML deyil: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Bu fayl UTF-8 deyil, ona görə də Europass ixracı deyil."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Bu faylda iç-içə səviyyələrin sayı həddi (%(limit)s) aşır, ona görə də fayl oxunmadı."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Bu, Europass faylı deyil. Postulo europass.europa.eu saytının verdiyi PDF-i, ona qoşulmuş XML-i, həmçinin köhnə Europass XML və JSON fayllarını oxuyur; bu, onlardan heç biri deyil."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Bu PDF-ə fayllar qoşulub, lakin onlardan heç biri Europass CV-si deyil. europass.europa.eu saytının verdiyi PDF-i olduğu kimi yükləyin."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF-ə heç nə qoşulmayıb, ona görə də içində oxunacaq Europass CV-si yoxdur. europass.europa.eu saytının verdiyi PDF CV-ni qoşulmuş fayl kimi daşıyır, başqa proqramla çap edilmiş və ya yenidən yadda saxlanılmış PDF isə onu itirir: CV-ni europass.europa.eu saytından yenidən endirin və həmin faylı olduğu kimi yükləyin."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF şifrələnib, ona görə də ona qoşulmuş Europass CV-sini oxumaq mümkün deyil. CV-ni europass.europa.eu saytından yenidən endirin və həmin faylı olduğu kimi yükləyin."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Bu XML Europass CV-si deyil. Postulo europass.europa.eu saytının yazdığı XML-i (Candidate) və ondan əvvəlki Europass redaktorunun XML-ini (SkillsPassport) oxuyur; bu, heç biri deyil."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Avropa CV formatı: europass.europa.eu saytının verdiyi PDF və ona qoşulmuş XML, həmçinin ondan əvvəlki Europass xidmətinin köhnə XML və JSON formatları."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF-ə qoşulmuş fayl zədələnib və açıla bilmədi. CV-ni europass.europa.eu saytından yenidən endirin və həmin faylı olduğu kimi yükləyin."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Bu PDF-ə qoşulmuş fayl Postulo-nun oxumadığı üsulla sıxılıb (%(filter)s). CV-ni europass.europa.eu saytından yenidən endirin və həmin faylı olduğu kimi yükləyin."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Bu PDF-ə qoşulmuş faylın açılmış həcmi %(limit)s MB həddini aşır, ona görə də fayl oxunmadı."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fayl bu karyera məlumatlarını birdən çox dildə saxlayır və yalnız birincisi oxundu."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Faylda %(count)d tövsiyəçi var və yalnız ilk %(limit)d tövsiyəçi oxundu."
msgstr[1] "Faylda %(count)d tövsiyəçi var və yalnız ilk %(limit)d tövsiyəçi oxundu."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Faylda %(limit)d tədbirdən çox var və yalnız ilk %(limit)d tədbir oxundu."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "İş təcrübəsi"
