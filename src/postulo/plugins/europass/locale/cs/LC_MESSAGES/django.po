#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s bylo v souboru, ale nepodařilo se to přečíst."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "Údaj %(parts)s u reference se nenačítá: nic ho netiskne. Každá reference se přidá jako dosud neoslovená, takže se žádná nevytiskne, dokud neuvedete, že souhlasila."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Úspěchy"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Další odkazy události kromě prvního se nenačítají: událost uchovává jen jednu adresu."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Komunikační"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitální"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Vzdělání"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Import Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Odborné"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Jazyky"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Řízení a vedení"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organizační"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Jiný"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Dovednosti"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Některé oddíly souboru zatím nemají v Postulo své místo, a proto nebyly načteny: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Toto nevypadá jako soubor Europass: chybí v něm oddíl LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Tento soubor není čitelný JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Tento soubor není čitelné XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Tento soubor není v UTF-8, takže to není export z Europassu."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Tento soubor je vnořený hlouběji než %(limit)s úrovní, proto nebyl přečten."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Toto není soubor Europass. Postulo čte PDF, které vám dá europass.europa.eu, XML k němu připojené a starší Europass XML a JSON; toto není nic z toho."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Toto PDF má připojené soubory a žádný z nich není životopis Europass. Nahrajte PDF, které vám dá europass.europa.eu, tak, jak je."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Toto PDF nemá nic připojeno, takže v něm není životopis Europass ke čtení. PDF, které vám dá europass.europa.eu, nese životopis jako připojený soubor a PDF znovu vytištěné nebo uložené jiným programem jej ztrácí: stáhněte životopis znovu z europass.europa.eu a nahrajte ten soubor tak, jak je."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Toto PDF je šifrované, proto životopis Europass k němu připojený nelze přečíst. Stáhněte životopis znovu z europass.europa.eu a nahrajte ten soubor tak, jak je."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Toto XML není životopis Europass. Postulo čte XML, které píše europass.europa.eu (Candidate), a XML editoru Europass před ním (SkillsPassport); toto není ani jedno."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Evropský formát životopisu: PDF, které vám dá europass.europa.eu, XML k němu připojené a starší XML a JSON předchozí služby Europass."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Soubor připojený k tomuto PDF je poškozený a nešlo jej rozbalit. Stáhněte životopis znovu z europass.europa.eu a nahrajte ten soubor tak, jak je."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Soubor připojený k tomuto PDF je zabalen způsobem, který Postulo nečte (%(filter)s). Stáhněte životopis znovu z europass.europa.eu a nahrajte ten soubor tak, jak je."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Soubor připojený k tomuto PDF se rozbalí na více než %(limit)s MB, proto nebyl přečten."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Soubor obsahuje tuto kariéru ve více než jednom jazyce a přečten byl jen první."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Soubor uvádí %(count)d referenci a načtena byla jen první %(limit)d."
msgstr[1] "Soubor uvádí %(count)d reference a načteno bylo jen prvních %(limit)d."
msgstr[2] "Soubor uvádí %(count)d referencí a načteno bylo jen prvních %(limit)d."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Soubor uvádí více než %(limit)d událostí a načteno bylo jen prvních %(limit)d."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Pracovní zkušenosti"
