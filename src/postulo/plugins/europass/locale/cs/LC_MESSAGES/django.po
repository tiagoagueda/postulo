#: src/postulo/plugins/europass/reader.py:576
#, python-format, draft
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s bylo v souboru, ale nepodařilo se to přečíst."

#: src/postulo/plugins/europass/reader.py:686
#, draft
msgid "Achievements"
msgstr "Úspěchy"

#: src/postulo/plugins/europass/reader.py:631
#, draft
msgid "Education"
msgstr "Vzdělání"

#: src/postulo/plugins/europass/reader.py:282
#: src/postulo/plugins/europass/reader.py:555
#, draft
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Tohle nevypadá jako soubor Europass: nemá sekci LearnerInfo."

#: src/postulo/plugins/europass/reader.py:539
#, python-format, draft
msgid "That file is not readable JSON: %(reason)s"
msgstr "Tento soubor není čitelný JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py:274
#, python-format, draft
msgid "That file is not readable XML: %(reason)s"
msgstr "Tento soubor není čitelné XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py:536
#, draft
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Tento soubor není v UTF-8, takže to není export z Europassu."

#: src/postulo/plugins/europass/reader.py:544
#, python-format, draft
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr ""
"Tento soubor je vnořený hlouběji než %(limit)s úrovní, proto nebyl přečten."

#: src/postulo/plugins/europass/reader.py:193
#, draft
msgid ""
"That is not a Europass file. Postulo reads the XML the CV editor produced and the JSON europass.europa.eu exports; this is neither."
msgstr ""
"Tohle není soubor Europass. Postulo čte XML, které vytvářel editor životopisu, a JSON, který exportuje europass.europa.eu; tohle není ani jedno."

#: src/postulo/plugins/europass/__init__.py:33
#, draft
msgid ""
"The European CV format: the XML the Europass editor produces and the JSON europass.europa.eu exports."
msgstr ""
"Evropský formát životopisu: XML, které vytváří editor Europass, a JSON, který exportuje europass.europa.eu."

#: src/postulo/plugins/europass/reader.py:608
#, draft
msgid "Work experience"
msgstr "Pracovní zkušenosti"
