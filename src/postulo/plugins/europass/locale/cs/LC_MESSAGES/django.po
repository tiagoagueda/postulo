#: src/postulo/plugins/europass/reader.py:693
#, python-format, draft
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s bylo v souboru, ale nepodařilo se to přečíst."

#: src/postulo/plugins/europass/candidate.py:734
#, python-format
msgid ""
"A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr ""

#: src/postulo/plugins/europass/reader.py:549
#: src/postulo/plugins/europass/reader.py:818
#, draft
msgid "Achievements"
msgstr "Úspěchy"

#: src/postulo/plugins/europass/candidate.py:111
#: src/postulo/plugins/europass/reader.py:113
#, draft
msgid "Communication"
msgstr "Komunikační"

#: src/postulo/plugins/europass/candidate.py:119
#: src/postulo/plugins/europass/reader.py:111
