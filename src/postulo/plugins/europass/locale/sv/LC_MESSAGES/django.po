#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s fanns i filen men gick inte att läsa."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s för en referens läses inte in: ingenting skriver ut dem. Varje referens läggs till som ännu inte tillfrågad, så ingen skrivs ut förrän du anger att de har sagt ja."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Meriter"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "En händelses länkar utöver den första läses inte in: en händelse har bara en adress."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Kommunikativa färdigheter"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitala färdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Utbildning"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Europass-import"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Yrkesrelaterade färdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Språk"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Ledning och ledarskap"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organisatoriska färdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Annan"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Färdigheter"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Vissa avsnitt i filen har ingenstans att ta vägen i Postulo ännu och lästes inte: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Det här ser inte ut som en Europass-fil: den har ingen LearnerInfo-sektion."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Filen är inte läsbar JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Filen är inte läsbar XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Filen är inte UTF-8, så det är ingen Europass-export."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Filen är nästlad mer än %(limit)s nivåer djupt, så den lästes inte."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Det är ingen Europass-fil. Postulo läser PDF-filen som europass.europa.eu ger dig, XML-filen som är bifogad den och den äldre Europass-XML:en och JSON:en; det här är ingen av dem."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Den PDF-filen har filer bifogade, och ingen av dem är ett Europass-CV. Ladda upp PDF-filen som europass.europa.eu ger dig, precis som den är."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF-filen har inget bifogat, så det finns inget Europass-CV i den att läsa. PDF-filen som europass.europa.eu ger dig bär CV:t som en bifogad fil, och en PDF som skrivits ut eller sparats på nytt av ett annat program förlorar det: ladda ned CV:t igen från europass.europa.eu och ladda upp den filen precis som den är."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF-filen är krypterad, så Europass-CV:t som är bifogat i den kan inte läsas. Ladda ned CV:t igen från europass.europa.eu och ladda upp den filen precis som den är."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Den XML-filen är inget Europass-CV. Postulo läser XML-filen som europass.europa.eu skriver (en Candidate) och den från Europass-editorn före den (en SkillsPassport); det här är ingen av dem."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Det europeiska CV-formatet: PDF-filen som europass.europa.eu ger dig och XML-filen som är bifogad den, och den äldre XML:en och JSON:en från Europass-tjänsten före den."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Filen som är bifogad den PDF-filen är skadad och kunde inte packas upp. Ladda ned CV:t igen från europass.europa.eu och ladda upp den filen precis som den är."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Filen som är bifogad den PDF-filen är packad på ett sätt som Postulo inte läser (%(filter)s). Ladda ned CV:t igen från europass.europa.eu och ladda upp den filen precis som den är."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Filen som är bifogad den PDF-filen packas upp till mer än %(limit)s MB, så den lästes inte."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Filen innehåller den här karriären på mer än ett språk, och bara det första lästes."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Filen listar %(count)d referens, och bara de första %(limit)d lästes in."
msgstr[1] "Filen listar %(count)d referenser, och bara de första %(limit)d lästes in."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Filen listar fler än %(limit)d händelser, och bara de första %(limit)d lästes in."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Arbetslivserfarenhet"
