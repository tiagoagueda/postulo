#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "To nije Europass datoteka. Postulo čita PDF koji daje europass.europa.eu, XML priložen uz njega te stariji Europass XML i JSON; ovo nije ništa od toga."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Taj PDF ima priložene datoteke, ali nijedna nije Europass CV. Otpremite PDF koji daje europass.europa.eu, onakav kakav jeste."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Taj PDF nema ništa priloženo, pa u njemu nema Europass CV-ja za čitanje. PDF koji daje europass.europa.eu nosi CV kao priloženu datoteku, a PDF koji je neki drugi program ponovo odštampao ili sačuvao gubi je: ponovo preuzmite CV s europass.europa.eu i otpremite tu datoteku onakvu kakva jeste."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Taj PDF je šifriran, pa se Europass CV priložen uz njega ne može pročitati. Ponovo preuzmite CV s europass.europa.eu i otpremite tu datoteku onakvu kakva jeste."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Taj XML nije Europass CV. Postulo čita XML koji piše europass.europa.eu (Candidate) i XML Europass uređivača koji mu je prethodio (SkillsPassport); ovo nije ni jedno ni drugo."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Evropski format CV-ja: PDF koji daje europass.europa.eu i XML priložen uz njega, te stariji XML i JSON Europass usluge koja mu je prethodila."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Datoteka priložena uz taj PDF je oštećena i nije se mogla raspakovati. Ponovo preuzmite CV s europass.europa.eu i otpremite tu datoteku onakvu kakva jeste."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Datoteka priložena uz taj PDF upakovana je na način koji Postulo ne čita (%(filter)s). Ponovo preuzmite CV s europass.europa.eu i otpremite tu datoteku onakvu kakva jeste."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Datoteka priložena uz taj PDF nakon raspakivanja ima više od %(limit)s MB, pa nije pročitana."

