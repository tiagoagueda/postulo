#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s ishte në skedar, por nuk mund të lexohej."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s e një reference nuk lexohet: asgjë nuk e printon. Çdo referencë shtohet si ende e papyetur, prandaj asnjëra nuk printohet derisa të tregoni se ka dhënë pëlqimin."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Arritje"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Lidhjet e një ngjarjeje pas së parës nuk lexohen: një ngjarje mban vetëm një adresë."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "Communication"
msgstr "Aftësi komunikimi"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "Digital"
msgstr "Aftësi dixhitale"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Arsimimi"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass import"
msgstr "Importimi Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "Job-related"
msgstr "Aftësi të lidhura me punën"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Gjuhët"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Menaxhimi dhe udhëheqja"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "Organisational"
msgstr "Aftësi organizative"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Tjetër"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Aftësi"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Disa seksione të skedarit nuk kanë ende vend në Postulo dhe nuk u lexuan: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Kjo nuk duket si një skedar Europass: nuk ka seksionin LearnerInfo."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Ai skedar nuk është JSON i lexueshëm: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Ai skedar nuk është XML i lexueshëm: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Ai skedar nuk është UTF-8, prandaj nuk është eksport Europass."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Ai skedar ka më shumë se %(limit)s nivele ndërfutjeje, prandaj nuk u lexua."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Ky nuk është skedar Europass. Postulo lexon skedarin PDF që ju jep europass.europa.eu, XML-në e bashkëngjitur në të, si dhe formatet më të vjetra XML dhe JSON të Europass; ky nuk është asnjëri prej tyre."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Ai skedar PDF ka skedarë të bashkëngjitur, por asnjëri prej tyre nuk është CV Europass. Ngarkoni skedarin PDF që ju jep europass.europa.eu, ashtu siç është."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ai skedar PDF nuk ka asgjë të bashkëngjitur, prandaj nuk ka brenda tij asnjë CV Europass për t'u lexuar. Skedari PDF që ju jep europass.europa.eu e mbart CV-në si skedar të bashkëngjitur, dhe një PDF i printuar ose i ruajtur sërish nga një program tjetër e humbet atë: shkarkojeni sërish CV-në nga europass.europa.eu dhe ngarkojeni atë skedar ashtu siç është."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Ai skedar PDF është i enkriptuar, prandaj CV-ja Europass e bashkëngjitur në të nuk mund të lexohet. Shkarkojeni sërish CV-në nga europass.europa.eu dhe ngarkojeni atë skedar ashtu siç është."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Ai XML nuk është CV Europass. Postulo lexon XML-në që shkruan europass.europa.eu (një Candidate) dhe atë të redaktuesit të mëparshëm të Europass (një SkillsPassport); ky nuk është asnjëri prej tyre."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Formati evropian i CV-së: skedari PDF që ju jep europass.europa.eu dhe XML-ja e bashkëngjitur në të, si dhe XML-ja dhe JSON-i më i vjetër i shërbimit të mëparshëm Europass."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Skedari i bashkëngjitur në atë PDF është i dëmtuar dhe nuk mund të shpaketohej. Shkarkojeni sërish CV-në nga europass.europa.eu dhe ngarkojeni atë skedar ashtu siç është."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Skedari i bashkëngjitur në atë PDF është paketuar në një mënyrë që Postulo nuk e lexon (%(filter)s). Shkarkojeni sërish CV-në nga europass.europa.eu dhe ngarkojeni atë skedar ashtu siç është."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Skedari i bashkëngjitur në atë PDF, kur shpaketohet, kalon %(limit)s MB, prandaj nuk u lexua."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Skedari e mban këtë karrierë në më shumë se një gjuhë, dhe u lexua vetëm e para."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Skedari rendit %(count)d referencë, dhe u lexuan vetëm %(limit)d të parat."
msgstr[1] "Skedari rendit %(count)d referenca, dhe u lexuan vetëm %(limit)d të parat."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Skedari rendit më shumë se %(limit)d ngjarje dhe u lexuan vetëm %(limit)d të parat."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Përvoja e punës"
