#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s lå i filen, men kunne ikke leses."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s for en referanse leses ikke: ingenting skriver det ut. Hver referanse legges til som ikke spurt ennå, så ingen skrives ut før du sier at de har sagt ja."

#: src/postulo/plugins/europass/reader.py
msgid "Achievements"
msgstr "Prestasjoner"

#: src/postulo/plugins/europass/candidate.py
msgid "An event’s links past the first are not read: an event keeps one address."
msgstr "Lenker utover den første for en hendelse leses ikke: en hendelse har bare én adresse."

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Communication"
msgstr "Kommunikative ferdigheter"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Digital"
msgstr "Digitale ferdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Education"
msgstr "Utdanning"

#: src/postulo/plugins/europass/__init__.py
msgid "Europass"
msgstr "Europass"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Job-related"
msgstr "Jobbrelaterte ferdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Languages"
msgstr "Språk"

#: src/postulo/plugins/europass/candidate.py
msgid "Management and leadership"
msgstr "Administrasjon og ledelse"

#: src/postulo/plugins/europass/candidate.py
#: src/postulo/plugins/europass/reader.py
msgid "Organisational"
msgstr "Organisatoriske ferdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Other"
msgstr "Andre ferdigheter"

#: src/postulo/plugins/europass/reader.py
msgid "Skills"
msgstr "Ferdigheter"

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Noen deler av filen har ikke noe sted i Postulo ennå og ble ikke lest: %(sections)s."

#: src/postulo/plugins/europass/reader.py
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Det ser ikke ut som en Europass-fil: den har ingen LearnerInfo-del."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Den filen er ikke lesbar JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Den filen er ikke lesbar XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Den filen er ikke UTF-8, så den er ikke en Europass-eksport."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Den filen er nøstet dypere enn %(limit)s nivåer, så den ble ikke lest."

#: src/postulo/plugins/europass/reader.py
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Dette er ikke en Europass-fil. Postulo leser PDF-en du får fra europass.europa.eu, XML-en som er vedlagt den, og de eldre Europass-formatene XML og JSON; dette er ingen av dem."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Den PDF-en har vedlagte filer, men ingen av dem er en Europass-CV. Last opp PDF-en du får fra europass.europa.eu, slik den er."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF-en har ingen vedlegg, så det finnes ingen Europass-CV i den å lese. PDF-en du får fra europass.europa.eu, har CV-en som vedlagt fil, og en PDF som skrives ut eller lagres på nytt av et annet program, mister den: last ned CV-en på nytt fra europass.europa.eu og last opp den filen slik den er."

#: src/postulo/plugins/europass/reader.py
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF-en er kryptert, så Europass-CV-en som er vedlagt den, kan ikke leses. Last ned CV-en på nytt fra europass.europa.eu og last opp den filen slik den er."

#: src/postulo/plugins/europass/reader.py
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Den XML-en er ikke en Europass-CV. Postulo leser XML-en europass.europa.eu skriver (en Candidate) og den fra Europass-redigeringsverktøyet før det (et SkillsPassport); dette er ingen av dem."

#: src/postulo/plugins/europass/__init__.py
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Det europeiske CV-formatet: PDF-en du får fra europass.europa.eu og XML-en som er vedlagt den, og de eldre XML- og JSON-formatene fra Europass-tjenesten før den."

#: src/postulo/plugins/europass/reader.py
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Filen som er vedlagt den PDF-en, er skadet og kunne ikke pakkes ut. Last ned CV-en på nytt fra europass.europa.eu og last opp den filen slik den er."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Filen som er vedlagt den PDF-en, er pakket på en måte Postulo ikke leser (%(filter)s). Last ned CV-en på nytt fra europass.europa.eu og last opp den filen slik den er."

#: src/postulo/plugins/europass/reader.py
#, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Filen som er vedlagt den PDF-en, blir mer enn %(limit)s MB utpakket, så den ble ikke lest."

#: src/postulo/plugins/europass/candidate.py
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Filen inneholder denne karrieren på mer enn ett språk, og bare det første ble lest."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Filen lister opp %(count)d referanse, og bare %(limit)d ble lest."
msgstr[1] "Filen lister opp %(count)d referanser, og bare de første %(limit)d ble lest."

#: src/postulo/plugins/europass/candidate.py
#, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Filen lister opp mer enn %(limit)d hendelser, og bare de første %(limit)d ble lest."

#: src/postulo/plugins/europass/reader.py
msgid "Work experience"
msgstr "Arbeidserfaring"
