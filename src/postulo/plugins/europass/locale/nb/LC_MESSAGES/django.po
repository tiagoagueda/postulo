#, fuzzy, python-format
msgid "Some sections of the file have nowhere to go in Postulo yet and were not read: %(sections)s."
msgstr "Noen deler av filen har ingen steder å gå i Postulo enda og ble ikke lest: %(sections)s."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Det ser ikke ut som en Europass-fil: den har ingen LearnerInfo-del."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Den filen er ikke lesbar JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Den filen er ikke lesbar XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Den filen er ikke UTF-8, så den er ikke en Europass-eksport."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Den filen er nøstet dypere enn %(limit)s nivåer, så den ble ikke lest."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Dette er ikke en Europass-fil. Postulo leser PDF europass.europa.eu gir deg, XML-en knyttet til den, og den eldre Europass XML og JSON. Dette er ingen av dem."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "PDF har filer knyttet til det, og ingen av dem er en Europass CV. Last opp PDF europass.europa.eu gir deg, som det er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "At PDF ikke har noe knyttet til det, så det er ingen Europass CV inne i det å lese. PDF europass.europa.eu gir deg bærer CV som en vedlagt fil, og en PDF-fil som er skrevet ut eller lagret på nytt av et annet program mister den: Last ned CV igjen fra europass.europa.eu og last opp filen som den er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Den PDF er kryptert, så Europass CV kan ikke leses. Last ned CV igjen fra europass.europa.eu og last opp filen som den er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "XML er ikke en Europass CV. Postulo leser XML europass.europa.eu skriver (en kandidat) og i Europass redaktør før det (en SkillsPassport); dette er heller ikke."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Det europeiske CV-formatet: PDF europass.europa.eu gir deg og XML knyttet til den, og den eldre XML og JSON av Europass-tjenesten før den."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Filen som er knyttet til PDF er skadet og kunne ikke pakkes ut. Last ned CV igjen fra europass.europa.eu og last opp filen som den er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Filen som er lagt ved PDF, er pakket på en måte som Postulo ikke leser (%(filter)s). Last ned CV igjen fra europass.europa.eu og last opp filen som den er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Filen som er knyttet til PDF pakker ut til mer enn %(limit)s MB, så den ble ikke lest."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Filen har denne karrieren på mer enn ett språk, og bare den første ble lest."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Fillistene %(count)d referanse, og bare den første %(limit)d ble lest."
msgstr[1] "Fillistene %(count)d referanser, og bare de første %(limit)d ble lest."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Filen lister mer enn %(limit)d hendelser, og bare de første %(limit)d ble lest."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "Work experience"
msgstr "Arbeidserfaring"
