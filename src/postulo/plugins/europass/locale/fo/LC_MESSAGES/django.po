#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "%(what)s was in the file but could not be read."
msgstr "%(what)s var í fíluni, men kundi ikki lesast."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "A reference's %(parts)s is not read: nothing prints it. Each reference is added as not yet asked, so none is printed until you say they agreed."
msgstr "%(parts)s hjá einum viðmælara verður ikki lisið: einki vísir tað. Hvør viðmælari verður lagdur afturat sum ikki spurdur enn, so eingin verður vístur, fyrr enn tú sigur, at viðkomandi hevur játtað."

