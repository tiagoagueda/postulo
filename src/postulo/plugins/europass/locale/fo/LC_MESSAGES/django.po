#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That does not look like a Europass file: it has no LearnerInfo section."
msgstr "Hetta sær ikki út til at vera ein Europass-fíla: hon hevur ongan LearnerInfo-part."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable JSON: %(reason)s"
msgstr "Hendan fílan er ikki lesiligt JSON: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file is not readable XML: %(reason)s"
msgstr "Hendan fílan er ikki lesiligt XML: %(reason)s"

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That file is not UTF-8, so it is not a Europass export."
msgstr "Hendan fílan er ikki UTF-8, so hon er ikki ein Europass-útflutningur."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "That file nests more than %(limit)s levels deep, so it was not read."
msgstr "Hendan fílan liggur fleiri enn %(limit)s støði djúpt, so hon varð ikki lisin."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That is not a Europass file. Postulo reads the PDF europass.europa.eu gives you, the XML attached to it, and the older Europass XML and JSON; this is none of them."
msgstr "Hetta er ikki ein Europass-fíla. Postulo lesur PDF-fíluna, sum europass.europa.eu gevur tær, XML-fíluna, sum er viðheft henni, og eldri Europass XML og JSON; hetta er einki av teimum."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has files attached to it, and none of them is a Europass CV. Upload the PDF europass.europa.eu gives you, as it is."
msgstr "Hendan PDF-fílan hevur fílur viðheftar, og eingin teirra er ein Europass-lívsrás. Legg PDF-fíluna, sum europass.europa.eu gevur tær, upp, júst sum hon er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF has nothing attached to it, so there is no Europass CV inside it to read. The PDF europass.europa.eu gives you carries the CV as an attached file, and a PDF printed or saved again by another program loses it: download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Einki er viðheft hesi PDF-fíluni, so eingin Europass-lívsrás er í henni at lesa. PDF-fílan, sum europass.europa.eu gevur tær, ber lívsrásina sum viðhefta fílu, og ein PDF-fíla, sum er prentað ella goymd aftur av øðrum forriti, missir hana: tak lívsrásina niður aftur frá europass.europa.eu og legg ta fíluna upp, júst sum hon er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That PDF is encrypted, so the Europass CV attached to it cannot be read. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Hendan PDF-fílan er bronglað, so Europass-lívsrásin, sum er viðheft henni, kann ikki lesast. Tak lívsrásina niður aftur frá europass.europa.eu og legg ta fíluna upp, júst sum hon er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "That XML is not a Europass CV. Postulo reads the XML europass.europa.eu writes (a Candidate) and that of the Europass editor before it (a SkillsPassport); this is neither."
msgstr "Hendan XML-fílan er ikki ein Europass-lívsrás. Postulo lesur tað XML, sum europass.europa.eu skrivar (ein Candidate), og tað hjá Europass-ritlinum, sum var undan honum (eitt SkillsPassport); hetta er hvørki."

#: src/postulo/plugins/europass/__init__.py
#, fuzzy
msgid "The European CV format: the PDF europass.europa.eu gives you and the XML attached to it, and the older XML and JSON of the Europass service before it."
msgstr "Evropeiska lívsrásarsniðið: PDF-fílan, sum europass.europa.eu gevur tær, og XML-fílan, sum er viðheft henni, umframt eldri XML og JSON frá Europass-tænastuni, sum var undan henni."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "The file attached to that PDF is damaged and could not be unpacked. Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Fílan, sum er viðheft hesi PDF-fíluni, er skadd og kundi ikki pakkast út. Tak lívsrásina niður aftur frá europass.europa.eu og legg ta fíluna upp, júst sum hon er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF is packed in a way Postulo does not read (%(filter)s). Download the CV again from europass.europa.eu and upload that file as it is."
msgstr "Fílan, sum er viðheft hesi PDF-fíluni, er pakkað á ein hátt, sum Postulo ikki lesur (%(filter)s). Tak lívsrásina niður aftur frá europass.europa.eu og legg ta fíluna upp, júst sum hon er."

#: src/postulo/plugins/europass/reader.py
#, fuzzy, python-format
msgid "The file attached to that PDF unpacks to more than %(limit)s MB, so it was not read."
msgstr "Fílan, sum er viðheft hesi PDF-fíluni, verður størri enn %(limit)s MB, tá ið hon verður pakkað út, so hon varð ikki lisin."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy
msgid "The file holds this career in more than one language, and only the first was read."
msgstr "Fílan hevur hesa starvsleiðina á fleiri enn einum máli, og bert tað fyrsta varð lisið."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists %(count)d reference, and only the first %(limit)d was read."
msgid_plural "The file lists %(count)d references, and only the first %(limit)d were read."
msgstr[0] "Fílan nevnir %(count)d viðmælara, og bert %(limit)d varð lisin."
msgstr[1] "Fílan nevnir %(count)d viðmælarar, og bert teir fyrstu %(limit)d vórðu lisnir."

#: src/postulo/plugins/europass/candidate.py
#, fuzzy, python-format
msgid "The file lists more than %(limit)d events, and only the first %(limit)d were read."
msgstr "Fílan nevnir fleiri enn %(limit)d hendingar, og bert tær fyrstu %(limit)d vórðu lisnar."

#: src/postulo/plugins/europass/reader.py
#, fuzzy
msgid "Work experience"
msgstr "Arbeiðsroyndir"
