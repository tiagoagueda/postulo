#, fuzzy
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "„checksum“ именува една од двете што ги знае Postulo: iso7064-mod11-2, со која завршува ORCID, или iso7064-mod97-10, со која завршува идентификатор на правен субјект."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "„lower“ го претвора внесеното во мали букви пред да се провери шаблонот, а овој шаблон не прифаќа ништо напишано со мали букви: шемата не би прифатила ниту една вредност. Напишете го шаблонот со мали букви или отстранете го „lower“."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“pattern” is text in double quotes."
msgstr "„pattern“ е текст во двојни наводници."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "„subjects“ наведува што идентификува шемата: [\"person\"], [\"company\"] или [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“upper” and “lower” cannot both be true."
msgstr "„upper“ и „lower“ не може и двете да бидат true."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "„upper“ го претвора внесеното во големи букви пред да се провери шаблонот, а овој шаблон не прифаќа ништо напишано со големи букви: шемата не би прифатила ниту една вредност. Напишете го шаблонот со големи букви или отстранете го „upper“."
