#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Тут можна визначити не більше %(most)d схем."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s сьогодні було б відхилено: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Зворотна скісна риска з числом посилається на раніше прочитане, а шаблон так не вміє."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "між назвою і її значенням бракує двокрапки."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "після останнього елемента стоїть кома. Вилучіть її."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "перед цим бракує коми, або дужку вище так і не закрито."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Кількість пишеться як {3} або {2,5}, меншим числом уперед."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Кількості потрібне найбільше число: {2,} повторюється без обмеження. Напишіть {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "У регулярному виразі крапка означає будь-який символ, а в цій мові такого немає. Напишіть «\\.» для крапки або клас, як-от [^ ], для будь-якого символу, крім пробілу."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Групу не можна повторювати: після неї може стояти «?», і більше нічого."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "ключ — це малі літери, цифри й дефіси в подвійних лапках; він починається з літери або цифри й має не більше %(most)d символів."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "мітка — це назва в подвійних лапках, не більше %(most)d символів, або по одній назві для кожної мови: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Посилання — це текст у подвійних лапках."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "назва не може містити U+%(code)s — символ, який не займає місця або змінює напрямок тексту: назва читалася б не так, як написана."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "назва має містити щось видиме: ця складається лише із символів, які не відображаються."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "тут має починатися назва в подвійних лапках. Кома після останнього елемента не допускається."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Шаблон не може бути порожнім."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Шаблон не може закінчуватися зворотною скісною рискою."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Шаблон не може містити розрив рядка, табуляцію чи будь-який інший керівний символ."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Шаблон може мати не більше %(most)d символів."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Шаблон пропонує не більше %(most)d альтернатив."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Діапазон іде від одного символу до пізнішого: «%(range)s» записано у зворотному порядку або він не закінчується символом."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "схема записується між { і }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "табельний номер, національний реєстраційний номер"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "текст у подвійних лапках не може переходити на новий рядок чи містити табуляцію, тож, можливо, бракує закривальних лапок."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "тут має починатися значення: текст у подвійних лапках, список, об’єкт, true або false. Кома після останнього елемента не допускається."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "І ще %(more)d проблема такого ж типу в цій схемі."
msgstr[1] "І ще %(more)d проблеми такого ж типу в цій схемі."
msgstr[2] "І ще %(more)d проблем такого ж типу в цій схемі."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Реєстраційний номер компанії"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Зовнішні ідентифікатори"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "у «%(tag)s»: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON не знає, що означає символ після цієї зворотної скісної риски. У шаблоні зворотна скісна риска пишеться двічі: \\\\d для цифри."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Ідентифікатор юридичної особи (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Рядок %(line)d, стовпець %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Рядок %(line)d, схема № %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Рядок %(line)d, схема «%(key)s»: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Рядок %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Ніщо не можна повторити більше ніж %(most)d разів: жоден ідентифікатор не довший за це."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Одна зі сторін цього «|» порожня."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "За символом або класом може стояти лише одна кількість: «{2}?», «??» і «{2}+» до цієї мови не належать."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Інші навички"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Круглі дужки містять фіксований роздільник — символи, які шукаються як є, — і більше нічого: ні класу, ні кількості, ні «|»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Почніть із дволітерного коду країни, а далі — номер, що проходить перевірку контрольної цифри цієї країни."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Останній символ цього ISNI не збігається з рештою, тож десь є одрук."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Остання цифра цього ORCID не збігається з рештою, тож десь є одрук."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Контрольні символи цього ідентифікатора не збігаються з рештою, тож десь є одрук."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Класи цього шаблону разом надто довго готуються. Клас, записаний із «^», або клас, що охоплює тисячі символів, як-от [一-鿿], може траплятися в одному шаблоні лише обмежену кількість разів: використовуйте менше таких класів або вужчі."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "приклад не проходить перевірку контрольної суми, яку вказує схема."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "приклад не є значенням, яке приймає його власний шаблон."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "код мови «%(tag)s» пишеться як «%(written)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "мову «%(tag)s» записано двічі в «label»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Контрольні цифри цього LEI не збігаються."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "список закінчився, але після нього ще щось є."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "назва в «%(tag)s» — це текст у подвійних лапках, в одному рядку, непорожній і не довший за %(most)d символів."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "шаблон неможливо використати, символ %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Реєстраційний номер %(register)s та ідентифікатор OpenCorporates %(corporates)s вказують на різні юрисдикції. Це може бути правильно для компанії, зареєстрованої в кількох."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Реєстраційний номер %(register)s та ідентифікатор OpenCorporates %(corporates)s вказують на ту саму юрисдикцію, але на різні номери."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "схеми записуються як список, між [ і ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "схеми можуть мати не більше %(most)d символів."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "текст, який тут починається з подвійних лапок, ніде не закрито."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Перед цим немає нічого, до чого могла б застосовуватися кількість."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Тут вимагається понад %(most)d символів, а жоден ідентифікатор не довший за це."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Цю дужку так і не закрито."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Цей клас не охоплює жодного символу."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Це закриває дужку, яку не було відкрито."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "це не JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "цей ключ належить одній із власних схем Postulo, які лише доповнюються і ніколи не змінюються. Виберіть інший."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "цей ключ уже використовує одна зі схем вище."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Те, що йде далі, може починатися із символу, який підходить і цьому елементу, тож значення можна прочитати двома способами. Задайте цьому елементу точну кількість або поставте після нього роздільник, якого він не приймає."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Які зовнішні ідентифікатори розуміє Postulo — ORCID, ISNI, Wikidata, ідентифікатор юридичної особи, реєстраційний номер компанії, — який вигляд має кожен, куди він веде і що він ідентифікує: особу, організацію чи обох. Тут ніколи нічого не шукається в інтернеті."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "«%(name)s» не можна використовувати. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "«%(name)s» містить %(half)s — половину символу, яка сама по собі не є текстом. Напишіть символ, який мався на увазі, або обидві його половини."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "Бракує «%(name)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "«%(name)s» — не те, що може вказувати схема. Схема може вказувати: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(name)s» — це текст у подвійних лапках, в одному рядку, непорожній і не довший за %(most)d символів."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "«%(name)s» має бути true або false, без лапок."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "«%(name)s» написано двічі."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "«%(tag)s» — не код мови. Код мови має вигляд en-GB, fr-FR чи pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "«(?» починає групу, якої в цій мові немає: тут нічого не переглядається вперед чи назад, і жодна група не має назви."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "«*» і «+» повторюють без обмеження, а шаблон має вказувати найбільшу кількість повторень: напишіть {0,20} або {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "«[^]» нічого не виключає, тож означає будь-який символ, а в цій мові такого немає. Напишіть клас, як-от [^ ], для будь-якого символу, крім пробілу."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "«\\%(letter)s» не належить до цієї мови. Класи з назвою — це \\d (цифра) і \\w (літера, цифра або підкреслення); зворотна скісна риска перед розділовим знаком позначає сам цей знак."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "«^» і «$» дозволені лише на двох кінцях шаблону, де вони нічого не змінюють: шаблон завжди описує все значення."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "«checksum» вказує одну з двох відомих Postulo контрольних сум: iso7064-mod11-2, якою закінчується ORCID, або iso7064-mod97-10, якою закінчується ідентифікатор юридичної особи."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "«lower» переводить введене в малі літери, перш ніж застосувати шаблон, а цей шаблон не приймає нічого, записаного малими літерами: схема не прийме жодного значення. Напишіть шаблон малими літерами або вилучіть «lower»."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "«pattern» — це текст у подвійних лапках."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "«subjects» перелічує, що ідентифікує схема: [\"person\"], [\"company\"] або [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "«upper» і «lower» не можуть обидва бути true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "«upper» переводить введене у великі літери, перш ніж застосувати шаблон, а цей шаблон не приймає нічого, записаного великими літерами: схема не прийме жодного значення. Напишіть шаблон великими літерами або вилучіть «upper»."
