#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Aquí es poden definir com a màxim %(most)d esquemes."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s es rebutjaria avui: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Una barra inversa seguida d'un número fa referència a una cosa llegida abans, i un patró no ho pot fer."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "falten els dos punts entre un nom i el que diu."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "hi ha una coma després de l'últim element. Traieu-la."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "falta una coma abans d'això, o no s'ha tancat un claudàtor o una clau de més amunt."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Un quantificador s'escriu {3}, o {2,5} amb el número més petit primer."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Un quantificador necessita un número màxim: {2,} es repeteix sense límit. Escriviu {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "En una expressió regular, un punt vol dir qualsevol caràcter, i això no forma part d'aquest llenguatge. Escriviu «\\.» per a un punt, o una classe com [^ ] per a qualsevol caràcter excepte un espai."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Un grup no es pot repetir: només el pot seguir «?», i res més."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "una clau són lletres minúscules, dígits i guionets, entre cometes dobles, que comença per una lletra o un dígit, amb %(most)d caràcters com a màxim."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "una etiqueta és un nom entre cometes dobles, de %(most)d caràcters com a màxim, o un nom per a cada llengua: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Un enllaç és text entre cometes dobles."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "un nom no pot contenir U+%(code)s, un caràcter que no ocupa espai o que gira el text: el nom no es llegiria tal com està escrit."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "un nom ha de ser quelcom visible: aquest només conté caràcters que no es dibuixen."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "aquí hauria de començar un nom entre cometes dobles. No es permet una coma després de l'últim element."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Un patró no pot estar buit."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Un patró no pot acabar amb una barra inversa."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Un patró no pot contenir un salt de línia, una tabulació ni cap altre caràcter de control."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Un patró té com a màxim %(most)d caràcters."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Un patró ofereix com a màxim %(most)d alternatives."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Un interval va d'un caràcter a un de posterior: «%(range)s» està al revés, o no acaba en un caràcter."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "un esquema s'escriu entre { i }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "un número d'empleat, un registre nacional"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "un text entre cometes dobles no pot continuar després d'un salt de línia ni contenir una tabulació, de manera que potser falta una cometa de tancament."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "aquí hauria de començar un valor: text entre cometes dobles, una llista, un objecte, true o false. No es permet una coma després de l'últim element."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "I %(more)d problema més del mateix tipus en aquest esquema."
msgstr[1] "I %(more)d problemes més del mateix tipus en aquest esquema."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Número de registre de l'empresa"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Identificadors externs"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "a «%(tag)s», %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON no sap què ve després d'aquesta barra inversa. En un patró, una barra inversa s'escriu dues vegades: \\\\d per a un dígit."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Identificador d'Entitat Jurídica (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Línia %(line)d, columna %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Línia %(line)d, esquema número %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Línia %(line)d, esquema «%(key)s»: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Línia %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "No es pot repetir res més de %(most)d vegades: cap identificador no és més llarg."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Un costat d'aquest «|» és buit."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Només pot seguir un comptador a un caràcter o a una classe: «{2}?», «??» i «{2}+» no formen part d'aquest llenguatge."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Altres"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Els parèntesis contenen un separador fix, caràcters que s'han de trobar tal com són, i res més: ni classes, ni quantificadors, ni «|»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Comenceu amb el codi de dues lletres del país i després un número que superi el dígit de control d'aquest país."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "L'últim caràcter d'aquest ISNI no concorda amb la resta, així que un dels dos té una errada."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "L'últim dígit d'aquell ORCID no lliga amb la resta, així que un dels dos té una errada."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Els caràcters de control d'aquest identificador no concorden amb la resta, així que un dels dos té una errada."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Les classes d'aquest patró, en conjunt, triguen massa a preparar-se. Una classe escrita amb «^», o una que inclou milers de caràcters com [一-鿿], només pot aparèixer un nombre limitat de vegades en un patró: feu-ne servir menys, o més estretes."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "l'exemple no supera la suma de verificació que indica l'esquema."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "l'exemple no és un valor que accepti el seu propi patró."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "el codi de llengua «%(tag)s» s'escriu «%(written)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "la llengua «%(tag)s» està escrita dues vegades a «label»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Els dígits de control del LEI no lliguen."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "la llista ha acabat, i alguna cosa la segueix."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "el nom a «%(tag)s» és text entre cometes dobles, en una sola línia, amb algun contingut i com a màxim %(most)d caràcters."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "el patró no es pot fer servir, al caràcter %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "El número de registre %(register)s i l'identificador d'OpenCorporates %(corporates)s indiquen jurisdiccions diferents. Això pot ser correcte per a una empresa registrada en més d'una."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "El número de registre %(register)s i l'identificador d'OpenCorporates %(corporates)s indiquen la mateixa jurisdicció però números diferents."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "els esquemes s'escriuen com una llista, entre [ i ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "els esquemes poden tenir com a màxim %(most)d caràcters."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "el text que comença aquí amb una cometa doble no es tanca mai."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "No hi ha res abans d'això a què s'apliqui el quantificador."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Això demana més de %(most)d caràcters, i cap identificador no és tan llarg."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "This bracket is never closed."
msgstr "Aquest parèntesi no es tanca mai."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Aquesta classe no admet cap caràcter."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "This closes a bracket that was never opened."
msgstr "Això tanca un parèntesi que no s'ha obert mai."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "això no és JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "aquesta clau correspon a un dels esquemes propis de Postulo, que s'amplien però no es modifiquen mai. Trieu-ne una altra."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "aquesta clau ja la fa servir un esquema de més amunt."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "El que ve després d'això pot començar amb un caràcter que això també podria acceptar, de manera que un valor es podria llegir de dues maneres. Doneu-hi un quantificador exacte, o poseu-hi després un separador que no pugui acceptar."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Quins identificadors externs entén Postulo (ORCID, ISNI, Wikidata, un identificador d'entitat jurídica, un número de registre mercantil), quin aspecte ha de tenir cada un, on enllaça i si identifica una persona, una organització o totes dues. Res d'això no es consulta mai en línia."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "No es pot utilitzar «%(name)s». %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "«%(name)s» conté %(half)s, que és la meitat d'un caràcter i no és text per si sol. Escriviu el caràcter que havia de ser, o les seves dues meitats."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "Falta «%(name)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "«%(name)s» no és una cosa que un esquema pugui indicar. Un esquema pot indicar: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(name)s» és text entre cometes dobles, en una sola línia, amb algun contingut i com a màxim %(most)d caràcters."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "«%(name)s» és true o false, sense cometes."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "«%(name)s» està escrit dues vegades."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "«%(tag)s» no és un codi de llengua. Un codi és com en-GB, fr-FR o pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "«(?» comença un grup que aquest llenguatge no té: res no mira endavant ni enrere, i cap grup no té nom."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "«*» i «+» es repeteixen sense límit, i un patró ha d'indicar el nombre màxim de vegades: escriviu {0,20} o {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "«[^]» no exclou res, així que vol dir qualsevol caràcter, i això no forma part d'aquest llenguatge. Escriviu una classe com [^ ] per a qualsevol caràcter excepte un espai."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "«\\%(letter)s» no forma part d'aquest llenguatge. Les classes amb nom són \\d, un dígit, i \\w, una lletra, un dígit o un guió baix; una barra inversa davant d'un signe de puntuació representa el mateix signe."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "«^» i «$» només es permeten als dos extrems d'un patró, on no canvien res: un patró sempre descriu tot el valor."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "«checksum» indica una de les dues que Postulo coneix: iso7064-mod11-2, amb què acaba un ORCID, o iso7064-mod97-10, amb què acaba un identificador d'entitat jurídica."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "«lower» passa el text escrit a minúscules abans de consultar el patró, i aquest patró no admet res escrit en minúscules: l'esquema no acceptaria cap valor. Escriviu el patró en minúscules, o traieu «lower»."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "«pattern» és text entre cometes dobles."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "«subjects» indica què identifica l'esquema: [\"person\"], [\"company\"] o [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "«upper» i «lower» no poden ser tots dos true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "«upper» passa el text escrit a majúscules abans de consultar el patró, i aquest patró no admet res escrit en majúscules: l'esquema no acceptaria cap valor. Escriviu el patró en majúscules, o traieu «upper»."
