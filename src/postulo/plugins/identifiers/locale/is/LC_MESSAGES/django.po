#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Hér er hægt að skilgreina %(most)d kerfi að hámarki."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s yrði hafnað í dag: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Bakstrik og tala vísa aftur í það sem var lesið áður, og mynstur getur ekki gert það."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "tvípunkt vantar milli heitis og þess sem það segir."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "komma fylgir síðasta atriðinu. Taktu hana út."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "komma vantar á undan þessu, eða sviga ofar var aldrei lokað."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Fjöldi er skrifaður {3}, eða {2,5} með lægri töluna fyrst."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Fjöldi þarf hæstu tölu: {2,} endurtekur án takmarks. Skrifaðu {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Punktur merkir hvaða staf sem er í reglulegri segð, og það er ekki hluti af þessu máli. Skrifaðu „\\.“ fyrir punkt, eða flokk eins og [^ ] fyrir hvaða staf sem er nema bil."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Hópur getur ekki endurtekið sig: „?“ má fylgja honum og ekkert annað."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "lykill er lágstafir, tölustafir og bandstrik innan tvöfaldra gæsalappa, byrjar á bókstaf eða tölustaf og er %(most)d stafir að hámarki."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "merking er heiti innan tvöfaldra gæsalappa, %(most)d stafir að hámarki, eða eitt heiti fyrir hvert tungumál: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Tengill er texti innan tvöfaldra gæsalappa."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "heiti má ekki innihalda U+%(code)s, staf sem tekur ekkert pláss eða snýr textanum við: heitið myndi ekki lesast eins og það er skrifað."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "heiti verður að vera eitthvað sem sést: þetta inniheldur aðeins stafi sem eru ekki teiknaðir."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "heiti innan tvöfaldra gæsalappa ætti að byrja hér. Komma á eftir síðasta atriðinu er ekki leyfð."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Mynstur getur ekki verið tómt."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Mynstur getur ekki endað á bakstriki."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Mynstur getur ekki innihaldið línuskil, Tab-staf eða annan stýristaf."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Mynstur er %(most)d stafir að lengd að hámarki."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Mynstur býður %(most)d valkosti að hámarki."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Svið nær frá einum staf til annars síðari: „%(range)s“ er öfugt eða endar ekki á staf."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "kerfi er skrifað milli { og }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "starfsmannanúmer, þjóðskrárnúmer"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "texti innan tvöfaldra gæsalappa getur ekki náð yfir línuskil eða innihaldið Tab-staf, svo það gæti vantað lokagæsalappir."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "gildi ætti að byrja hér: texti innan tvöfaldra gæsalappa, listi, hlutur, true eða false. Komma á eftir síðasta atriðinu er ekki leyfð."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Og %(more)d annað vandamál af sama tagi í þessu kerfi."
msgstr[1] "Og %(more)d önnur vandamál af sama tagi í þessu kerfi."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Kennitala fyrirtækis"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Ytri auðkenni"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "í „%(tag)s“, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON þekkir ekki það sem fylgir þessu bakstriki. Bakstrik í mynstri er skrifað tvisvar: \\\\d fyrir tölustaf."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Legal Entity Identifier (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Lína %(line)d, dálkur %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Lína %(line)d, kerfi númer %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Lína %(line)d, kerfið „%(key)s“: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Lína %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Ekkert má endurtaka oftar en %(most)d sinnum: ekkert auðkenni er lengra en það."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Önnur hlið þessa „|“ er tóm."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Aðeins einn fjöldi má fylgja staf eða flokki: „{2}?“, „??“ og „{2}+“ eru ekki hluti af þessu máli."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Önnur hæfni"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Svigar geyma fast skiltákn, stafi sem á að finna eins og þeir eru, og ekkert annað: engan flokk, engan fjölda og ekkert „|“."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Byrjaðu á tveggja stafa kóða landsins og síðan númeri sem stenst vartölu þess lands."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Síðasti stafurinn í þessu ISNI-auðkenni stemmir ekki við hina, svo einhvers staðar er innsláttarvilla."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Síðasti stafurinn í þessu ORCID-auðkenni stemmir ekki við hina, svo einhvers staðar er innsláttarvilla."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Gátstafir þessa auðkennis stemma ekki við afganginn af því, svo einhvers staðar er innsláttarvilla."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Flokkar þessa mynsturs taka samanlagt of langan tíma að undirbúa. Flokk sem er skrifaður með „^“, eða flokk sem tekur þúsundir stafa eins og [一-鿿], má aðeins nota takmarkað oft í einu mynstri: notaðu færri slíka eða þrengri."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "dæmið stenst ekki gátsummuna sem kerfið tilgreinir."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "dæmið er ekki gildi sem eigið mynstur kerfisins samþykkir."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "tungumálakóðinn „%(tag)s“ er skrifaður „%(written)s“."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "tungumálið „%(tag)s“ er skrifað tvisvar í „label“."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Gátstafir LEI-númersins stemma ekki."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "listanum er lokið og eitthvað fylgir á eftir honum."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "heitið í „%(tag)s“ er texti innan tvöfaldra gæsalappa, í einni línu, með einhverju í og %(most)d stafir að hámarki."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "ekki er hægt að nota mynstrið, við staf %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Skráningarnúmerið %(register)s og OpenCorporates-auðkennið %(corporates)s tilgreina ólík lögsagnarumdæmi. Það getur staðist fyrir fyrirtæki sem er skráð í fleiri en einu."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Skráningarnúmerið %(register)s og OpenCorporates-auðkennið %(corporates)s tilgreina sama lögsagnarumdæmi en ólík númer."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "kerfin eru skrifuð sem listi, milli [ og ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "kerfin mega vera %(most)d stafir að lengd að hámarki."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "textanum sem hefst á gæsalöppum hér er aldrei lokað."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Það er ekkert á undan þessu til að telja."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Þetta biður um fleiri en %(most)d stafi og ekkert auðkenni er lengra en það."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Þessum sviga er aldrei lokað."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Þessi flokkur tekur engan staf."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Þetta lokar sviga sem var aldrei opnaður."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "þetta er ekki JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "þessi lykill er eitt af eigin kerfum Postulo, sem er bætt við en aldrei breytt. Veldu annan."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "þessi lykill er notaður af kerfi ofar."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Það sem kemur á eftir þessu getur byrjað á staf sem þetta gæti líka tekið, svo hægt væri að lesa gildi á tvo vegu. Gefðu þessu nákvæman fjölda, eða settu á eftir því skiltákn sem það getur ekki tekið."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Hvaða ytri auðkenni Postulo skilur — ORCID, ISNI, Wikidata, auðkenni lögaðila, fyrirtækjaskrárnúmer —, hvernig hvert þeirra á að líta út, hvert það vísar og hvort það auðkennir einstakling, stofnun eða hvort tveggja. Ekkert af þessu er nokkurn tíma flett upp á netinu."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "Ekki er hægt að nota „%(name)s“. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "„%(name)s“ inniheldur %(half)s, sem er hálfur stafur og ekki texti út af fyrir sig. Skrifaðu stafinn sem átti að standa þar, eða báða helminga hans."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "„%(name)s“ vantar."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "„%(name)s“ er ekki eitthvað sem kerfi getur tilgreint. Kerfi getur tilgreint: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "„%(name)s“ er texti innan tvöfaldra gæsalappa, í einni línu, með einhverju í og %(most)d stafir að hámarki."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "„%(name)s“ er true eða false, án gæsalappa."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "„%(name)s“ er skrifað tvisvar."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "„%(tag)s“ er ekki tungumálakóði. Slíkur kóði lítur út eins og en-GB, fr-FR eða pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "„(?“ byrjar hóp sem þetta mál hefur ekki: ekkert horfir fram eða aftur og enginn hópur hefur heiti."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "„*“ og „+“ endurtaka án takmarks, og mynstur verður að segja hversu oft að hámarki: skrifaðu {0,20} eða {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "„[^]“ útilokar ekkert, svo það merkir hvaða staf sem er, og það er ekki hluti af þessu máli. Skrifaðu flokk eins og [^ ] fyrir hvaða staf sem er nema bil."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "„\\%(letter)s“ er ekki hluti af þessu máli. Flokkarnir með heiti eru \\d, tölustafur, og \\w, bókstafur, tölustafur eða undirstrik; bakstrik á undan greinarmerki stendur fyrir merkið sjálft."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "„^“ og „$“ eru aðeins leyfð á endum mynsturs, þar sem þau breyta engu: mynstur lýsir alltaf öllu gildinu."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "„checksum“ tilgreinir aðra af þeim tveimur gátsummum sem Postulo þekkir: iso7064-mod11-2, sem ORCID endar á, eða iso7064-mod97-10, sem auðkenni lögaðila endar á."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "„lower“ breytir því sem var slegið inn í lágstafi áður en mynstrið er prófað, og þetta mynstur tekur ekki við neinu sem er skrifað í lágstöfum: kerfið myndi ekki samþykkja neitt gildi. Skrifaðu mynstrið í lágstöfum eða taktu „lower“ út."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "„pattern“ er texti innan tvöfaldra gæsalappa."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "„subjects“ telur upp það sem kerfið auðkennir: [\"person\"], [\"company\"] eða [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "„upper“ og „lower“ geta ekki bæði verið true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "„upper“ breytir því sem var slegið inn í hástafi áður en mynstrið er prófað, og þetta mynstur tekur ekki við neinu sem er skrifað í hástöfum: kerfið myndi ekki samþykkja neitt gildi. Skrifaðu mynstrið í hástöfum eða taktu „upper“ út."
