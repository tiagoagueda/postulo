#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Legfeljebb %(most)d séma definiálható itt."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s ma el lenne utasítva: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "A fordított perjel és egy szám a korábban beolvasott részre hivatkozik, erre pedig a minta nem képes."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "hiányzik egy kettőspont a név és az értéke között."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "az utolsó elemet vessző követi. Vegye ki."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "hiányzik egy vessző előtte, vagy feljebb egy zárójel nincs lezárva."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Az ismétlésszám alakja {3}, vagy {2,5}, elöl a kisebb számmal."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Az ismétlésszámhoz felső határ kell: a {2,} korlát nélkül ismétel. Írja így: {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "A pont a reguláris kifejezésekben bármely karaktert jelent, ez pedig nem része ennek a nyelvnek. A pontot így írja: „\\.”, a szóköztől eltérő bármely karakterhez pedig használjon osztályt, például [^ ]."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Egy csoport nem ismételhető: csak „?” követheti, más nem."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "a kulcs kisbetűkből, számjegyekből és kötőjelekből áll, dupla idézőjelek között, betűvel vagy számjeggyel kezdődik, és legfeljebb %(most)d karakter hosszú."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "a felirat egy név dupla idézőjelek között, legfeljebb %(most)d karakter, vagy egy-egy név minden nyelvhez: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "A hivatkozás szöveg dupla idézőjelek között."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "a név nem tartalmazhatja ezt: U+%(code)s, amely nem foglal helyet vagy megfordítja a szöveget: a név nem úgy olvasódna, ahogyan írták."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "a névnek láthatónak kell lennie: ez csak olyan karaktereket tartalmaz, amelyek nem rajzolódnak ki."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "itt egy dupla idézőjelek közötti névnek kellene kezdődnie. Az utolsó elem utáni vessző nem megengedett."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "A minta nem lehet üres."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "A minta nem végződhet fordított törtvonalra."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "A minta nem tartalmazhat sortörést, tabulátort vagy más vezérlőkaraktert."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "A minta legfeljebb %(most)d karakter hosszú."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "A minta legfeljebb %(most)d alternatívát tartalmazhat."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "A tartomány egy karaktertől egy későbbiig tart: a(z) „%(range)s” fordítva van, vagy nem karakterre végződik."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "a séma { és } közé írandó."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "törzsszám, nemzeti nyilvántartási szám"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "a dupla idézőjelek közötti szöveg nem futhat át sortörésen és nem tartalmazhat tabulátort, ezért lehet, hogy hiányzik a záró idézőjel."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "itt egy értéknek kellene kezdődnie: szöveg dupla idézőjelek között, lista, objektum, true vagy false. Az utolsó elem utáni vessző nem megengedett."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "És még %(more)d hasonló probléma ebben a sémában."
msgstr[1] "És még %(more)d hasonló probléma ebben a sémában."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Cégjegyzékszám"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Külső azonosítók"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "a(z) „%(tag)s” esetében: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "A JSON nem tudja, mi következik ez után a fordított perjel után. A mintában a fordított perjelt kétszer kell írni: \\\\d egy számjegyhez."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Jogalany-azonosító (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "%(line)d. sor, %(column)d. oszlop: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "%(line)d. sor, %(number)d. számú séma: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "%(line)d. sor, „%(key)s” séma: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "%(line)d. sor: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Semmi sem ismételhető többször, mint %(most)d: egyetlen azonosító sem hosszabb ennél."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "A „|” egyik oldala üres."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Egy karaktert vagy osztályt csak egyetlen ismétlésszám követhet: a „{2}?”, a „??” és a „{2}+” nem része ennek a nyelvnek."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Egyéb"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "A kerek zárójelben csak rögzített elválasztó állhat, vagyis szó szerint keresendő karakterek: nem lehet benne osztály, ismétlésszám vagy „|”."

#: src/postulo/plugins/identifiers/schemes.py
#, fuzzy
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Kezdjük az ország két betűs kódjával, aztán egy számmal, ami megfelel az ország ellenőrző számjegyének."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Az ISNI utolsó karaktere nem egyezik a többivel, tehát valahol elgépelés van."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Az ORCID utolsó számjegye nem egyezik a többivel, tehát valahol elgépelés van."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Az azonosító ellenőrző karakterei nem egyeznek a többi részével, tehát valamelyik karakter elírás."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Ennek a mintának az osztályait együttesen túl sokáig tart előkészíteni. A „^” jellel írt osztály, vagy az olyan, amely több ezer karaktert fogad el, például [一-鿿], csak korlátozott számban szerepelhet egy mintában: használjon belőlük kevesebbet, vagy szűkebbeket."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "a példa nem felel meg a séma által megnevezett ellenőrzőösszegnek."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "a példa nem olyan érték, amelyet a saját mintája elfogad."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "a(z) „%(tag)s” nyelvkód „%(written)s” alakban írandó."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "a(z) „%(tag)s” nyelv kétszer szerepel a „label” értékében."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "A LEI ellenőrző számjegyei nem egyeznek."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "a lista véget ért, de valami még következik utána."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "a(z) „%(tag)s” alatti név szöveg dupla idézőjelek között, egy sorban, tartalommal és legfeljebb %(most)d karakterrel."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "a minta nem használható, a(z) %(at)d. karakternél. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "A(z) %(register)s cégjegyzékszám és a(z) %(corporates)s OpenCorporates-azonosító különböző joghatóságot jelöl. Ez helyes lehet, ha a cég több joghatóságban is be van jegyezve."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "A(z) %(register)s cégjegyzékszám és a(z) %(corporates)s OpenCorporates-azonosító ugyanazt a joghatóságot jelöli, de eltérő számmal."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "a sémákat listaként kell írni, [ és ] között."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "a sémák legfeljebb %(most)d karakter hosszúak lehetnek."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "az itt dupla idézőjellel kezdődő szöveg soha nem záródik le."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Előtte nincs semmi, amire az ismétlésszám vonatkozhatna."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Ez több mint %(most)d karaktert kér, és egyetlen azonosító sem hosszabb ennél."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Ez a zárójel nincs lezárva."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Ez az osztály egyetlen karaktert sem fogad el."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Ez olyan zárójelet zár be, amelyet nem nyitottak meg."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "ez nem JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "ez a kulcs a Postulo saját sémáinak egyike; ezek köre csak bővül, és sosem változnak meg. Válasszon másikat."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "ezt a kulcsot egy feljebb lévő séma már használja."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Ami ezután következik, olyan karakterrel is kezdődhet, amelyet ez a rész is elfogad, így egy érték kétféleképpen is olvasható lenne. Adjon meg ehhez pontos ismétlésszámot, vagy tegyen utána olyan elválasztót, amelyet ez nem fogad el."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Mely külső azonosítókat ismeri a Postulo — ORCID, ISNI, Wikidata, jogalany-azonosító, cégjegyzékszám —, hogyan kell kinéznie mindegyiknek, hová mutat, és személyt, szervezetet vagy mindkettőt azonosít-e. Itt semmit sem kérdez le az internetről."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "A(z) „%(name)s” nem használható. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "A(z) „%(name)s” értéke %(half)s, ami egy karakter fele, és önmagában nem szöveg. Írja be a karaktert, amelyet szánt, vagy mindkét felét."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "A(z) „%(name)s” hiányzik."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "A(z) „%(name)s” nem olyan mező, amelyet egy séma megadhat. Egy séma ezeket adhatja meg: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "A(z) „%(name)s” értéke dupla idézőjelek közötti, egysoros, nem üres szöveg, legfeljebb %(most)d karakter."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "A(z) „%(name)s” értéke true vagy false, idézőjelek nélkül."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "A(z) „%(name)s” kétszer szerepel."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "A(z) „%(tag)s” nem nyelvkód. A nyelvkód például így néz ki: en-GB, fr-FR vagy pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "A „(?” olyan csoportot nyit, amely ebben a nyelvben nem létezik: nincs előre- vagy hátratekintés, és a csoportoknak nincs nevük."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "A „*” és a „+” korlát nélkül ismétel, a mintának pedig meg kell adnia, legfeljebb hányszor: írja így: {0,20} vagy {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "A „[^]” semmit sem zár ki, így bármely karaktert jelent, ez pedig nem része ennek a nyelvnek. Használjon inkább osztályt, például [^ ] a szóköztől eltérő bármely karakterhez."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "A „\\%(letter)s” nem része ennek a nyelvnek. Névvel rendelkező osztály a \\d (számjegy) és a \\w (betű, számjegy vagy aláhúzás); az írásjel előtti fordított perjel magát az írásjelet jelenti."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "A „^” és a „$” csak a minta két végén megengedett, ahol nem változtatnak semmin: a minta mindig a teljes értéket írja le."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "A „checksum” a Postulo által ismert két eljárás egyikét nevezi meg: iso7064-mod11-2 (ilyen ellenőrző jeggyel végződik az ORCID) vagy iso7064-mod97-10 (ilyen ellenőrző jegyekkel végződik a jogalany-azonosító)."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "A „lower” a beírt értéket kisbetűssé alakítja, mielőtt a mintával összevetné, ez a minta viszont semmilyen kisbetűs írást nem fogad el: így a séma egyetlen értéket sem fogadna el. Írja a mintát kisbetűkkel, vagy vegye ki a „lower” beállítást."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "A „pattern” értéke dupla idézőjelek közötti szöveg."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "A „subjects” felsorolja, mit azonosít a séma: [\"person\"], [\"company\"] vagy [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "Az „upper” és a „lower” nem lehet egyszerre true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "Az „upper” a beírt értéket nagybetűssé alakítja, mielőtt a mintával összevetné, ez a minta viszont semmilyen nagybetűs írást nem fogad el: így a séma egyetlen értéket sem fogadna el. Írja a mintát nagybetűkkel, vagy vegye ki az „upper” beállítást."
