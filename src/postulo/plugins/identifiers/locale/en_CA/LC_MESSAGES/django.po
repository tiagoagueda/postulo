#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "%(most)d schemes can be defined here at most."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s would be refused today: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "a colon is missing between a name and what it says."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "a comma follows the last item. Take it out."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "a comma is missing before this, or a bracket further up was never closed."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "A count is written {3}, or {2,5} with the smaller number first."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "A period means any character in a regular expression, and that is not part of this language. Write “\\.” for a period, or a class such as [^ ] for any character but a space."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "A group cannot repeat: “?” may follow it, and nothing else may."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "A link is text in double quotes."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "a name has to be something that can be seen: this one holds only characters that are not drawn."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "a name in double quotes should begin here. A comma after the last item is not allowed."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "A pattern cannot be empty."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "A pattern cannot end in a backslash."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "A pattern cannot hold a line break, a tab or any other control character."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "A pattern is %(most)d characters long at most."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "A pattern offers %(most)d alternatives at most."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "a scheme is written between { and }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "a staff number, a national registration"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "And %(more)d more problem of the same kind in this scheme."
msgstr[1] "And %(more)d more problems of the same kind in this scheme."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Company register number"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "External identifiers"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "in “%(tag)s”, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Legal Entity Identifier (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Line %(line)d, column %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Line %(line)d, scheme number %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Line %(line)d, scheme “%(key)s”: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Line %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Nothing can be repeated more than %(most)d times: no identifier is longer than that."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "One side of this “|” is empty."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Other"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code."
msgstr "Start with the country's two-letter code."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "That ISNI's last character does not match the rest, so one of them is a typo."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "That ORCID's last digit does not match the rest, so one of them is a typo."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "The check characters of that identifier do not match the rest of it, so one of them is a typo."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "the example does not pass the checksum the scheme names."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "the example is not a value its own pattern accepts."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "the language code “%(tag)s” is written “%(written)s”."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "the language “%(tag)s” is written twice in “label”."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "The LEI's check digits do not match."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "the list has ended, and something follows it."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "the pattern cannot be used, at character %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "the schemes are written as a list, between [ and ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "the schemes can be %(most)d characters long at most."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "the text that opens with a double quote here is never closed."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "There is nothing before this for it to count."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "This asks for more than %(most)d characters, and no identifier is longer than that."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "This bracket is never closed."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "This class takes no character at all."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "This closes a bracket that was never opened."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "this is not JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "this key is used by a scheme further up."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organization or both. Nothing here is ever looked up online."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "“%(name)s” cannot be used. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "“%(name)s” is missing."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "“%(name)s” is true or false, without quotes."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "“%(name)s” is written twice."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "“pattern” is text in double quotes."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "“upper” and “lower” cannot both be true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
