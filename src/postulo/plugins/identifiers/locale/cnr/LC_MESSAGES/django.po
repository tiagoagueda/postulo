#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Ovdje se može definisati najviše %(most)d šema."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s danas bi bilo odbijeno: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Obrnuta kosa crta i broj upućuju na nešto što je ranije pročitano, a uzorak to ne može."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "nedostaje dvotačka između naziva i onoga što on kaže."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "iza posljednje stavke stoji zarez. Uklonite ga."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "ispred ovoga nedostaje zarez ili neka zagrada iznad nikad nije zatvorena."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Broj ponavljanja piše se {3} ili {2,5}, s manjim brojem na prvom mjestu."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Broju ponavljanja potreban je najveći broj: {2,} ponavlja bez ograničenja. Napišite {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Tačka u regularnom izrazu znači bilo koji znak, a to nije dio ovog jezika. Napišite „\\.“ za tačku ili klasu kao što je [^ ] za bilo koji znak osim razmaka."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Grupa se ne može ponavljati: iza nje smije stajati „?“ i ništa drugo."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "ključ čine mala slova, cifre i crtice, u dvostrukim navodnicima, počinje slovom ili cifrom i ima najviše %(most)d znakova."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "oznaka je naziv u dvostrukim navodnicima, sa najviše %(most)d znakova, ili po jedan naziv za svaki jezik: {\"en-GB\": \"Staff number\", \"cnr\": \"Broj zaposlenog\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Link je tekst u dvostrukim navodnicima."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "naziv ne može sadržati U+%(code)s, znak koji ne zauzima prostor ili okreće smjer teksta: naziv se ne bi čitao onako kako je napisan."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "naziv mora biti nešto što se može vidjeti: ovaj sadrži samo znakove koji se ne iscrtavaju."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "ovdje bi trebalo da počne naziv u dvostrukim navodnicima. Zarez iza posljednje stavke nije dozvoljen."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Uzorak ne može biti prazan."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Uzorak se ne može završavati obrnutom kosom crtom."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Uzorak ne može sadržati prelom reda, tabulator ni bilo koji drugi kontrolni znak."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Uzorak ima najviše %(most)d znakova."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Uzorak nudi najviše %(most)d alternativa."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Raspon ide od jednog znaka do nekog kasnijeg: „%(range)s“ je obrnut ili se ne završava znakom."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "šema se piše između { i }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "broj zaposlenog, nacionalni registarski broj"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "tekst u dvostrukim navodnicima ne može prelaziti u novi red niti sadržati tabulator, pa možda nedostaje zatvarajući navodnik."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "ovdje bi trebalo da počne vrijednost: tekst u dvostrukim navodnicima, lista, objekat, true ili false. Zarez iza posljednje stavke nije dozvoljen."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "I još %(more)d problem iste vrste u ovoj šemi."
msgstr[1] "I još %(more)d problema iste vrste u ovoj šemi."
msgstr[2] "I još %(more)d problema iste vrste u ovoj šemi."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Registarski broj kompanije"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Spoljni identifikatori"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "u „%(tag)s“, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON ne zna šta slijedi iza ove obrnute kose crte. Obrnuta kosa crta u uzorku piše se dvaput: \\\\d za cifru."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Identifikator pravnog lica (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Red %(line)d, kolona %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Red %(line)d, šema broj %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Red %(line)d, šema „%(key)s“: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Red %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Ništa se ne može ponoviti više od %(most)d puta: nijedan identifikator nije duži od toga."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Jedna strana ovog „|“ je prazna."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Iza znaka ili klase smije stajati samo jedan broj ponavljanja: „{2}?“, „??“ i „{2}+“ nijesu dio ovog jezika."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Ostalo"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Okrugle zagrade sadrže fiksni separator, znakove koji se traže onakvi kakvi jesu, i ništa drugo: nijednu klasu, nijedan broj ponavljanja i nijedan „|“."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Počnite dvoslovnim kodom države, a zatim broj koji prolazi kontrolnu cifru te države."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Posljednji znak tog ISNI-ja ne odgovara ostatku, pa je jedan od njih pogrešno upisan."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Posljednja cifra tog ORCID-a ne odgovara ostatku, pa je jedna od njih pogrešno upisana."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Kontrolni znakovi tog identifikatora ne odgovaraju ostatku, pa je jedan od njih pogrešno upisan."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Klase ovog uzorka zajedno se predugo pripremaju. Klasa napisana sa „^“ ili klasa koja obuhvata hiljade znakova, kao [一-鿿], može se u jednom uzorku pojaviti samo ograničen broj puta: koristite ih manje ili uže."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "primjer ne prolazi provjeru kontrolne sume koju šema navodi."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "primjer nije vrijednost koju prihvata njegov sopstveni uzorak."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "kod jezika „%(tag)s“ piše se „%(written)s“."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "jezik „%(tag)s“ naveden je dvaput u „label“."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Kontrolne cifre LEI-ja se ne poklapaju."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "lista je završena, a iza nje slijedi još nešto."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "naziv u „%(tag)s“ je tekst u dvostrukim navodnicima, u jednom redu, nije prazan i ima najviše %(most)d znakova."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "uzorak se ne može koristiti, kod znaka %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Registarski broj %(register)s i OpenCorporates ID %(corporates)s navode različite jurisdikcije. To može biti tačno za kompaniju registrovanu u više njih."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Registarski broj %(register)s i OpenCorporates ID %(corporates)s navode istu jurisdikciju, ali različite brojeve."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "šeme se pišu kao lista, između [ i ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "šeme mogu imati najviše %(most)d znakova."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "tekst koji ovdje počinje dvostrukim navodnikom nikad nije zatvoren."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Ispred ovoga nema ničega što bi se brojalo."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Ovo traži više od %(most)d znakova, a nijedan identifikator nije duži od toga."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Ova zagrada nikad nije zatvorena."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Ova klasa ne prihvata nijedan znak."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Ovo zatvara zagradu koja nikad nije otvorena."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "ovo nije JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "ovaj ključ pripada jednoj od Postulovih sopstvenih šema, koje se dopunjuju, a nikad ne mijenjaju. Izaberite drugi."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "ovaj ključ već koristi neka šema iznad."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Ono što slijedi iza ovoga može početi znakom koji bi i ovo moglo prihvatiti, pa bi se vrijednost mogla pročitati na dva načina. Dajte ovome tačan broj ponavljanja ili iza njega stavite separator koji ono ne prihvata."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Koje spoljne identifikatore Postulo razumije — ORCID, ISNI, Wikidata, identifikator pravnog lica, registarski broj kompanije — kako bi koji trebalo da izgleda, kuda vodi i da li označava osobu, organizaciju ili oboje. Ništa se ovdje ne traži na internetu."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "„%(name)s“ se ne može koristiti. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "„%(name)s“ sadrži %(half)s, što je polovina znaka, a ne tekst sam po sebi. Napišite znak koji je to trebalo da bude ili obje njegove polovine."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "„%(name)s“ nedostaje."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "„%(name)s“ nije nešto što šema može navesti. Šema može navesti: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "„%(name)s“ je tekst u dvostrukim navodnicima, u jednom redu, nije prazan i ima najviše %(most)d znakova."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "„%(name)s“ je true ili false, bez navodnika."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "„%(name)s“ je napisano dvaput."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "„%(tag)s“ nije kod jezika. Kod jezika izgleda kao en-GB, fr-FR ili pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "„(?“ počinje grupu koju ovaj jezik nema: ništa ne gleda unaprijed ni unazad, i nijedna grupa nema ime."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "„*“ i „+“ ponavljaju bez ograničenja, a uzorak mora reći koliko puta najviše: napišite {0,20} ili {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "„[^]“ ne isključuje ništa, pa znači bilo koji znak, a to nije dio ovog jezika. Napišite klasu kao što je [^ ] za bilo koji znak osim razmaka."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "„\\%(letter)s“ nije dio ovog jezika. Klase s imenom su \\d, cifra, i \\w, slovo, cifra ili donja crta; obrnuta kosa crta ispred interpunkcijskog znaka označava sam taj znak."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "„^“ i „$“ dozvoljeni su samo na dva kraja uzorka, gdje ništa ne mijenjaju: uzorak uvijek opisuje cijelu vrijednost."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "„checksum“ navodi jednu od dvije kontrolne sume koje Postulo poznaje: iso7064-mod11-2, kojom se završava ORCID, ili iso7064-mod97-10, kojom se završava identifikator pravnog lica."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "„lower“ pretvara upisano u mala slova prije provjere uzorkom, a ovaj uzorak ne prihvata ništa napisano malim slovima: šema ne bi prihvatila nijednu vrijednost. Napišite uzorak malim slovima ili uklonite „lower“."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "„pattern“ je tekst u dvostrukim navodnicima."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "„subjects“ navodi šta šema identifikuje: [\"person\"], [\"company\"] ili [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "„upper“ i „lower“ ne mogu istovremeno biti true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "„upper“ pretvara upisano u velika slova prije provjere uzorkom, a ovaj uzorak ne prihvata ništa napisano velikim slovima: šema ne bi prihvatila nijednu vrijednost. Napišite uzorak velikim slovima ili uklonite „upper“."
