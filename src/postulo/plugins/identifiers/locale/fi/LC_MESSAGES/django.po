#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Tässä voi määrittää enintään %(most)d tunnistetyyppiä."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s hylättäisiin nyt: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Kenoviiva ja numero viittaavat aiemmin luettuun, eikä malli voi tehdä niin."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "nimen ja sen arvon välistä puuttuu kaksoispiste."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "viimeisen kohteen perässä on pilkku. Poista se."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "ennen tätä puuttuu pilkku, tai ylempänä oleva sulku jäi sulkematta."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Määrä kirjoitetaan {3} tai {2,5}, pienempi luku ensin."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Määrä tarvitsee suurimman luvun: {2,} toistuu rajoituksetta. Kirjoita {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Piste tarkoittaa säännöllisessä lausekkeessa mitä tahansa merkkiä, eikä se kuulu tähän kieleen. Kirjoita ”\\.” pisteelle tai luokka kuten [^ ] mille tahansa merkille paitsi välilyönnille."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Ryhmä ei voi toistua: sen perässä voi olla ”?”, ei mitään muuta."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "avain on pieniä kirjaimia, numeroita ja yhdysmerkkejä kaksoislainausmerkeissä, alkaen kirjaimella tai numerolla, enintään %(most)d merkkiä."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "otsikko on nimi kaksoislainausmerkeissä, enintään %(most)d merkkiä, tai yksi nimi kullekin kielelle: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Linkki on teksti kaksoislainausmerkeissä."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "nimi ei voi sisältää merkkiä U+%(code)s, joka ei vie tilaa tai kääntää tekstin suuntaa: nimi ei näyttäisi siltä, miltä se on kirjoitettu."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "nimen on oltava jotain, mikä näkyy: tässä on vain merkkejä, joita ei piirretä."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "tässä pitäisi alkaa nimi kaksoislainausmerkeissä. Pilkku viimeisen kohteen jälkeen ei ole sallittu."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Malli ei voi olla tyhjä."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Malli ei voi päättyä kenoviivaan."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Malli ei voi sisältää rivinvaihtoa, sarkainta tai muuta ohjausmerkkiä."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Malli on enintään %(most)d merkkiä pitkä."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Mallissa on enintään %(most)d vaihtoehtoa."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Alue kulkee merkistä myöhempään: ”%(range)s” on väärin päin tai ei pääty merkkiin."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "tunnistetyyppi kirjoitetaan merkkien { ja } väliin."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "henkilöstönumero, kansallinen rekisterinumero"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "kaksoislainausmerkeissä oleva teksti ei voi jatkua rivinvaihdon yli eikä sisältää sarkainta, joten lopetuslainausmerkki voi puuttua."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "tässä pitäisi alkaa arvo: teksti kaksoislainausmerkeissä, luettelo, objekti, true tai false. Pilkku viimeisen kohteen jälkeen ei ole sallittu."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Ja %(more)d samanlainen ongelma lisää tässä tunnistetyypissä."
msgstr[1] "Ja %(more)d samanlaista ongelmaa lisää tässä tunnistetyypissä."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Kaupparekisterinumero"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Ulkoiset tunnisteet"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "kohdassa ”%(tag)s”, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON ei tunne tämän kenoviivan jälkeen tulevaa merkkiä. Kenoviiva kirjoitetaan mallissa kahdesti: \\\\d numerolle."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Legal Entity Identifier (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Rivi %(line)d, sarake %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Rivi %(line)d, tunnistetyyppi numero %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Rivi %(line)d, tunnistetyyppi ”%(key)s”: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Rivi %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Mitään ei voi toistaa useammin kuin %(most)d kertaa: yksikään tunniste ei ole sitä pidempi."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Tämän ”|”-merkin toinen puoli on tyhjä."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Merkkiä tai luokkaa voi seurata vain yksi määrä: ”{2}?”, ”??” ja ”{2}+” eivät kuulu tähän kieleen."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Muut taidot"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Sulkeet sisältävät kiinteän erottimen, merkkejä, jotka etsitään sellaisenaan, eikä mitään muuta: ei luokkaa, ei määrää eikä ”|”-merkkiä."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Aloita maan kaksikirjaimisella koodilla ja jatka numerolla, joka läpäisee kyseisen maan tarkistusnumeron."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Tuon ISNI:n viimeinen merkki ei täsmää muuhun, joten jokin niistä on kirjoitusvirhe."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Tuon ORCIDin viimeinen merkki ei täsmää muihin, joten jossakin on kirjoitusvirhe."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Tuon tunnisteen tarkistusmerkit eivät täsmää muuhun, joten jokin niistä on kirjoitusvirhe."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Tämän mallin luokkien valmistelu vie yhteensä liian kauan. Luokka, joka on kirjoitettu merkillä ”^”, tai sellainen, joka ottaa tuhansia merkkejä, kuten [一-鿿], voi olla yhdessä mallissa vain tietyn määrän kertoja: käytä vähemmän niitä tai kapeampia."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "esimerkki ei läpäise tunnistetyypin nimeämää tarkistussummaa."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "esimerkki ei ole arvo, jonka sen oma malli hyväksyy."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "kielikoodi ”%(tag)s” kirjoitetaan ”%(written)s”."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "kieli ”%(tag)s” on kirjoitettu kahdesti kohdassa ”label”."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "LEI:n tarkistusnumerot eivät täsmää."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "luettelo on päättynyt, ja sen jälkeen tulee jotain."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "nimi kohdassa ”%(tag)s” on kaksoislainausmerkeissä oleva teksti yhdellä rivillä, ei tyhjä, enintään %(most)d merkkiä."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "mallia ei voi käyttää (merkki %(at)d). %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Rekisterinumero %(register)s ja OpenCorporates-tunniste %(corporates)s viittaavat eri lainkäyttöalueisiin. Se voi pitää paikkansa yritykselle, joka on rekisteröity useammalla alueella."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Rekisterinumero %(register)s ja OpenCorporates-tunniste %(corporates)s viittaavat samaan lainkäyttöalueeseen mutta eri numeroihin."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "tunnistetyypit kirjoitetaan luettelona merkkien [ ja ] väliin."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "tunnistetyyppien määrittely voi olla enintään %(most)d merkkiä pitkä."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "teksti, joka alkaa tässä kaksoislainausmerkillä, jää sulkematta."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Ennen tätä ei ole mitään, mitä se voisi laskea."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Tämä pyytää yli %(most)d merkkiä, eikä yksikään tunniste ole sitä pidempi."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Tätä sulkua ei koskaan suljeta."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Tämä luokka ei ota yhtään merkkiä."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Tämä sulkee sulun, jota ei koskaan avattu."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "tämä ei ole JSON-muotoa."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "tämä avain kuuluu Postulon omalle tunnistetyypille; niitä vain lisätään eikä koskaan muuteta. Valitse toinen."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "tämä avain on jo käytössä ylempänä olevalla tunnistetyypillä."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Se, mikä tulee tämän jälkeen, voi alkaa merkillä, jonka tämäkin voisi ottaa, joten arvon voisi lukea kahdella tavalla. Anna tälle tarkka määrä tai aseta sen perään erotin, jota se ei voi ottaa."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Mitkä ulkoiset tunnisteet Postulo tuntee — ORCID, ISNI, Wikidata, oikeushenkilön tunniste, kaupparekisterinumero —, miltä kunkin pitäisi näyttää, minne se johtaa ja yksilöikö se henkilön, organisaation vai molemmat. Mitään näistä ei koskaan haeta verkosta."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "”%(name)s” ei kelpaa. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "”%(name)s” sisältää %(half)s, joka on puolikas merkki eikä teksti sellaisenaan. Kirjoita merkki, joksi se oli tarkoitettu, tai molemmat puoliskot."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "”%(name)s” puuttuu."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "”%(name)s” ei ole asia, jonka tunnistetyyppi voi määrittää. Mahdolliset: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "”%(name)s” on kaksoislainausmerkeissä oleva teksti yhdellä rivillä, ei tyhjä, enintään %(most)d merkkiä."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "”%(name)s” on true tai false, ilman lainausmerkkejä."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "”%(name)s” on kirjoitettu kahdesti."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "”%(tag)s” ei ole kielikoodi. Sellainen näyttää tältä: en-GB, fr-FR tai pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "”(?” aloittaa ryhmän, jota tässä kielessä ei ole: mikään ei katso eteen- tai taaksepäin, eikä millään ryhmällä ole nimeä."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "”*” ja ”+” toistuvat rajoituksetta, ja mallin on sanottava, kuinka monta kertaa enintään: kirjoita {0,20} tai {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "”[^]” ei jätä mitään pois, joten se tarkoittaa mitä tahansa merkkiä, eikä se kuulu tähän kieleen. Kirjoita luokka kuten [^ ] mille tahansa merkille paitsi välilyönnille."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "”\\%(letter)s” ei kuulu tähän kieleen. Nimetyt luokat ovat \\d, numero, ja \\w, kirjain, numero tai alaviiva; kenoviiva välimerkin edessä tarkoittaa itse välimerkkiä."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "”^” ja ”$” sallitaan vain mallin kahdessa päässä, missä ne eivät muuta mitään: malli kuvaa aina koko arvon."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "”checksum” nimeää toisen kahdesta Postulon tuntemasta: iso7064-mod11-2, johon ORCID päättyy, tai iso7064-mod97-10, johon oikeushenkilön tunniste (LEI) päättyy."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "”lower” muuttaa kirjoitetun pieniksi kirjaimiksi ennen kuin mallilta kysytään, eikä tämä malli ota mitään pienillä kirjaimilla kirjoitettua: tunnistetyyppi ei hyväksyisi yhtään arvoa. Kirjoita malli pienillä kirjaimilla tai poista ”lower”."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "”pattern” on teksti kaksoislainausmerkeissä."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "”subjects” luettelee, mitä tunnistetyyppi yksilöi: [\"person\"], [\"company\"] tai [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "”upper” ja ”lower” eivät voi molemmat olla true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "”upper” muuttaa kirjoitetun isoiksi kirjaimiksi ennen kuin mallilta kysytään, eikä tämä malli ota mitään isoilla kirjaimilla kirjoitettua: tunnistetyyppi ei hyväksyisi yhtään arvoa. Kirjoita malli isoilla kirjaimilla tai poista ”upper”."
