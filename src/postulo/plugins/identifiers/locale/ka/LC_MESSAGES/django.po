#: src/postulo/plugins/identifiers/__init__.py
#, fuzzy
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "რომელ გარე იდენტიფიკატორებს იცნობს Postulo — ORCID, ISNI, Wikidata, იურიდიული პირის იდენტიფიკატორი, სამეწარმეო რეესტრის ნომერი —, როგორი უნდა იყოს თითოეული, საით მიდის და იდენტიფიცირებს თუ არა პიროვნებას, ორგანიზაციას თუ ორივეს. აქედან არაფერი ოდესმე ინტერნეტში არ იძებნება."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "„%(name)s“ ვერ გამოიყენება. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "„%(name)s“ შეიცავს სიმბოლოს ნახევარს %(half)s, რომელიც თავისთავად ტექსტი არ არის. ჩაწერეთ ის სიმბოლო, რომელიც უნდა ყოფილიყო, ან მისი ორივე ნახევარი."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” is missing."
msgstr "„%(name)s“ აკლია."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "„%(name)s“ არ არის ის, რაც სქემაში შეიძლება ეწეროს. სქემაში შეიძლება ეწეროს: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "„%(name)s“ არის ტექსტი ორმაგ ბრჭყალებში, ერთ სტრიქონზე, არაცარიელი და მაქსიმუმ %(most)d სიმბოლო."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "„%(name)s“ არის true ან false, ბრჭყალების გარეშე."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(name)s” is written twice."
msgstr "„%(name)s“ ორჯერ წერია."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "„%(tag)s“ ენის კოდი არ არის. ენის კოდი ასე გამოიყურება: en-GB, fr-FR ან pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "„(?“ იწყებს ჯგუფს, რომელიც ამ ენაში არ არსებობს: არაფერი იყურება წინ ან უკან და არცერთ ჯგუფს სახელი არ აქვს."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "„*“ და „+“ ზღვრის გარეშე იმეორებს, ნიმუში კი უნდა ამბობდეს, მაქსიმუმ რამდენჯერ: დაწერეთ {0,20} ან {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "„[^]“ არაფერს გამორიცხავს, ამიტომ ნებისმიერ სიმბოლოს ნიშნავს, ეს კი ამ ენის ნაწილი არ არის. ნებისმიერი სიმბოლოსთვის, გარდა ჰარისა, დაწერეთ კლასი, მაგ. [^ ]."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "„\\%(letter)s“ ამ ენის ნაწილი არ არის. სახელიანი კლასებია \\d — ციფრი და \\w — ასო, ციფრი ან ქვედა ტირე; პუნქტუაციის ნიშნის წინ უკუდახრილი ხაზი თავად ამ ნიშანს აღნიშნავს."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "„^“ და „$“ დასაშვებია მხოლოდ ნიმუშის ორ ბოლოში, სადაც ისინი არაფერს ცვლის: ნიმუში ყოველთვის მთელ მნიშვნელობას აღწერს."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "„checksum“ ასახელებს ერთ-ერთს იმ ორიდან, რომელსაც Postulo იცნობს: iso7064-mod11-2, რითაც ORCID მთავრდება, ან iso7064-mod97-10, რითაც იურიდიული პირის იდენტიფიკატორი მთავრდება."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "„lower“ აკრეფილს პატარა ასოებად გარდაქმნის, სანამ ნიმუშით შემოწმდება, ეს ნიმუში კი პატარა ასოებით დაწერილს არაფერს იღებს: სქემა არცერთ მნიშვნელობას არ მიიღებდა. დაწერეთ ნიმუში პატარა ასოებით ან ამოიღეთ „lower“."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“pattern” is text in double quotes."
msgstr "„pattern“ არის ტექსტი ორმაგ ბრჭყალებში."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "„subjects“ ჩამოთვლის, რას აიდენტიფიცირებს სქემა: [\"person\"], [\"company\"] ან [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“upper” and “lower” cannot both be true."
msgstr "„upper“ და „lower“ ორივე ერთდროულად ვერ იქნება true."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "„upper“ აკრეფილს დიდ ასოებად გარდაქმნის, სანამ ნიმუშით შემოწმდება, ეს ნიმუში კი დიდი ასოებით დაწერილს არაფერს იღებს: სქემა არცერთ მნიშვნელობას არ მიიღებდა. დაწერეთ ნიმუში დიდი ასოებით ან ამოიღეთ „upper“."
