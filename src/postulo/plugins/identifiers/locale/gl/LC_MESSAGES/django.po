#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Aquí pódense definir como máximo %(most)d esquemas."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s rexeitaríase hoxe: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Unha barra invertida seguida dun número remite ao que se leu antes, e un patrón non pode facer iso."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "faltan os dous puntos entre un nome e o que di."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "hai unha coma despois do último elemento. Quítaa."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "falta unha coma antes disto, ou un corchete ou unha chave máis arriba non se pechou nunca."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Unha conta escríbese {3}, ou {2,5} co número menor primeiro."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Unha conta precisa un número máximo: {2,} repite sen límite. Escribe {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Un punto significa calquera carácter nunha expresión regular, e iso non forma parte desta linguaxe. Escribe «\\.» para un punto ou unha clase como [^ ] para calquera carácter agás un espazo."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Un grupo non se pode repetir: pode ir seguido de «?» e de nada máis."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "unha clave son letras minúsculas, díxitos e guións, entre comiñas dobres, que comeza por unha letra ou un díxito e ten como máximo %(most)d caracteres."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "unha etiqueta é un nome entre comiñas dobres, de %(most)d caracteres como máximo, ou un nome para cada idioma: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Unha ligazón é texto entre comiñas dobres."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "un nome non pode conter U+%(code)s, un carácter que non ocupa espazo ou que inverte o texto: o nome non se lería tal como está escrito."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "un nome ten que ser algo que se poida ver: este só contén caracteres que non se debuxan."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "aquí debería comezar un nome entre comiñas dobres. Non se permite unha coma despois do último elemento."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Un patrón non pode estar baleiro."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Un patrón non pode rematar nunha barra invertida."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Un patrón non pode conter un salto de liña, unha tabulación nin ningún outro carácter de control."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Un patrón ten como máximo %(most)d caracteres."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Un patrón ofrece como máximo %(most)d alternativas."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Un intervalo vai dun carácter a outro posterior: «%(range)s» está ao revés ou non remata nun carácter."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "un esquema escríbese entre { e }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "un número de persoa empregada, un rexistro nacional"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "un texto entre comiñas dobres non pode pasar dunha liña á seguinte nin conter un tabulador, así que pode que falten as comiñas de peche."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "aquí debería comezar un valor: texto entre comiñas dobres, unha lista, un obxecto, true ou false. Non se permite unha coma despois do último elemento."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "E %(more)d problema máis do mesmo tipo neste esquema."
msgstr[1] "E %(more)d problemas máis do mesmo tipo neste esquema."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Número de rexistro mercantil"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Identificadores externos"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "en «%(tag)s», %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON non sabe o que segue a esta barra invertida. Unha barra invertida nun patrón escríbese dúas veces: \\\\d para un díxito."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Identificador de entidade xurídica (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Liña %(line)d, columna %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Liña %(line)d, número de esquema %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Liña %(line)d, esquema «%(key)s»: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Liña %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Nada se pode repetir máis de %(most)d veces: ningún identificador é máis longo ca iso."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Un dos lados desta «|» está baleiro."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Un carácter ou unha clase só pode ir seguido dunha conta: «{2}?», «??» e «{2}+» non forman parte desta linguaxe."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Outro"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Os parénteses conteñen un separador fixo, caracteres que se buscan tal como son, e nada máis: nin clases, nin contas, nin «|»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Comeza polo código de dúas letras do país e despois un número que supere o díxito de control dese país."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "O último carácter dese ISNI non coincide co resto, así que un dos dous ten unha errata."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "O último díxito dese ORCID non coincide co resto, así que un dos dous ten unha errata."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Os caracteres de control dese identificador non coinciden co resto, polo que un deles é unha errata."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "As clases deste patrón tardan demasiado en prepararse entre todas. Unha clase escrita con «^», ou unha que abrangue miles de caracteres como [一-鿿], só pode aparecer un número limitado de veces nun patrón: usa menos ou máis estreitas."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "o exemplo non pasa a suma de comprobación que indica o esquema."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "o exemplo non é un valor que acepte o seu propio patrón."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "o código de idioma «%(tag)s» escríbese «%(written)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "o idioma «%(tag)s» aparece dúas veces en «label»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Os díxitos de control do LEI non coinciden."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "a lista rematou e despois vén algo máis."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "o nome en «%(tag)s» é un texto entre comiñas dobres, nunha soa liña, que non está baleiro e ten como máximo %(most)d caracteres."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "non se pode usar o patrón, no carácter %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "O número de rexistro %(register)s e o identificador de OpenCorporates %(corporates)s indican xurisdicións distintas. Iso pode ser correcto para unha empresa rexistrada en máis dunha."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "O número de rexistro %(register)s e o identificador de OpenCorporates %(corporates)s indican a mesma xurisdición pero números distintos."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "os esquemas escríbense como unha lista, entre [ e ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "os esquemas poden ter como máximo %(most)d caracteres."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "o texto que se abre aquí cunhas comiñas dobres nunca se pecha."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Antes disto non hai nada que poida contar."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Isto pide máis de %(most)d caracteres, e ningún identificador é máis longo ca iso."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Este paréntese nunca se pecha."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Esta clase non admite ningún carácter."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Isto pecha un paréntese que nunca se abriu."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "isto non é JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "esta clave é a dun dos esquemas propios do Postulo, aos que só se engade e que nunca se cambian. Escolle outra."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "esta clave xa a usa un esquema máis arriba."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "O que vén despois disto pode comezar por un carácter que isto tamén podería admitir, así que un valor podería lerse de dúas maneiras. Dálle a isto unha conta exacta ou pon despois un separador que non poida admitir."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Que identificadores externos entende o Postulo — ORCID, ISNI, Wikidata, un identificador de entidade xurídica, un número de rexistro mercantil —, que aspecto debe ter cada un, a onde liga e se identifica unha persoa, unha organización ou ambas. Nada disto se consulta nunca en liña."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "«%(name)s» non se pode usar. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "«%(name)s» contén %(half)s, que é a metade dun carácter e non é texto por si só. Escribe o carácter que debía ser ou as súas dúas metades."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "Falta «%(name)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "«%(name)s» non é algo que un esquema poida dicir. Un esquema pode dicir: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(name)s» é un texto entre comiñas dobres, nunha soa liña, que non está baleiro e ten como máximo %(most)d caracteres."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "«%(name)s» é true ou false, sen comiñas."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "«%(name)s» está escrito dúas veces."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "«%(tag)s» non é un código de idioma. Un código ten esta forma: en-GB, fr-FR ou pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "«(?» abre un tipo de grupo que esta linguaxe non ten: nada mira cara adiante nin cara atrás, e ningún grupo ten nome."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "«*» e «+» repiten sen límite, e un patrón ten que dicir cantas veces como máximo: escribe {0,20} ou {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "«[^]» non deixa nada fóra, polo que significa calquera carácter, e iso non forma parte desta linguaxe. Escribe unha clase como [^ ] para calquera carácter agás un espazo."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "«\\%(letter)s» non forma parte desta linguaxe. As clases con nome son \\d, un díxito, e \\w, unha letra, un díxito ou un guión baixo; unha barra invertida diante dun signo de puntuación representa o propio signo."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "«^» e «$» só se permiten nos dous extremos dun patrón, onde non cambian nada: un patrón sempre describe o valor enteiro."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "«checksum» nomea unha das dúas sumas de comprobación que coñece o Postulo: iso7064-mod11-2, coa que remata un ORCID, ou iso7064-mod97-10, coa que remata un identificador de entidade xurídica."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "«lower» pasa a minúsculas o que se escribiu antes de aplicar o patrón, e este patrón non admite nada escrito en minúsculas: o esquema non aceptaría ningún valor. Escribe o patrón en minúsculas ou quita «lower»."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "«pattern» é un texto entre comiñas dobres."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "«subjects» enumera o que identifica o esquema: [\"person\"], [\"company\"] ou [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "«upper» e «lower» non poden ser true os dous."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "«upper» pasa a maiúsculas o que se escribiu antes de aplicar o patrón, e este patrón non admite nada escrito en maiúsculas: o esquema non aceptaría ningún valor. Escribe o patrón en maiúsculas ou quita «upper»."
