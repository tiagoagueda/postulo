#: src/postulo/plugins/identifiers/custom.py:748
#, python-format, draft
msgid "%(most)d schemes can be defined here at most."
msgstr "Šeit var definēt ne vairāk kā %(most)d shēmas."

#: src/postulo/plugins/identifiers/crosschecks.py:57
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr ""

#: src/postulo/plugins/identifiers/patterns.py:408
#, draft
msgid ""
"A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr ""
"Atpakaļvērstā slīpsvītra un skaitlis atsaucas uz agrāk nolasīto, un paraugs to nevar."

#: src/postulo/plugins/identifiers/custom.py:233
#, draft
msgid "a colon is missing between a name and what it says."
msgstr "starp nosaukumu un to, ko tas saka, trūkst kola."

#: src/postulo/plugins/identifiers/custom.py:238
#, draft
msgid "a comma follows the last item. Take it out."
msgstr "pēc pēdējā vienuma ir komats. Noņemiet to."

#: src/postulo/plugins/identifiers/custom.py:231
#, draft
msgid ""
"a comma is missing before this, or a bracket further up was never closed."
msgstr "pirms šī trūkst komata vai augstāk esoša iekava nekad netika aizvērta."

#: src/postulo/plugins/identifiers/patterns.py:361
#: src/postulo/plugins/identifiers/patterns.py:384
#, draft
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Skaitu raksta {3} vai {2,5}, ar mazāko skaitli pirmo."

#: src/postulo/plugins/identifiers/patterns.py:365
#, draft
msgid ""
"A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr ""
"Skaitam nepieciešams lielākais skaitlis: {2,} atkārtojas bez ierobežojuma. Rakstiet {2,20}."

#: src/postulo/plugins/identifiers/patterns.py:314
#, draft
msgid ""
"A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr ""
"Punkts regulārajā izteiksmē nozīmē jebkuru rakstzīmi, un tas nav šīs valodas daļa. Rakstiet “\\.” punktam vai klasi, piemēram, [^ ] jebkurai rakstzīmei, izņemot atstarpi."

#: src/postulo/plugins/identifiers/patterns.py:522
#, draft
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Grupa nevar atkārtoties: aiz tās var būt “?”, un nekas cits."

#: src/postulo/plugins/identifiers/custom.py:522
#, python-format, draft
msgid ""
"a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr ""
"atslēga ir mazie burti, cipari un defises, dubultpēdiņās, sākas ar burtu vai ciparu un ir ne garāka par %(most)d rakstzīmēm."

#: src/postulo/plugins/identifiers/custom.py:545
#, python-format, draft
msgid ""
"a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr ""
"nosaukums ir nosaukums dubultpēdiņās, ne garāks par %(most)d rakstzīmēm, vai viens nosaukums katrai valodai: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py:676
#, draft
msgid "A link is text in double quotes."
msgstr "Saite ir teksts dubultpēdiņās."

#: src/postulo/plugins/identifiers/custom.py:354
#, python-format, draft
msgid ""
"a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr ""
"nosaukumā nevar būt U+%(code)s — rakstzīme, kas neaizņem vietu vai apgriež tekstu: nosaukums neizlasītos tā, kā rakstīts."

#: src/postulo/plugins/identifiers/custom.py:359
#, draft
msgid ""
"a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr ""
"nosaukumam jābūt tādam, ko var redzēt: šajā ir tikai rakstzīmes, kas netiek zīmētas."

#: src/postulo/plugins/identifiers/custom.py:236
#, draft
msgid ""
"a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr ""
"šeit jāsākas nosaukumam dubultpēdiņās. Komats pēc pēdējā vienuma nav atļauts."

#: src/postulo/plugins/identifiers/patterns.py:283
#: src/postulo/plugins/identifiers/patterns.py:533
#, draft
msgid "A pattern cannot be empty."
msgstr "Paraugs nevar būt tukšs."

#: src/postulo/plugins/identifiers/patterns.py:402
#, draft
msgid "A pattern cannot end in a backslash."
msgstr "Paraugs nevar beigties ar atpakaļvērstu slīpsvītru."

#: src/postulo/plugins/identifiers/patterns.py:542
#, draft
msgid ""
"A pattern cannot hold a line break, a tab or any other control character."
msgstr ""
"Paraugā nevar būt rindas pārtraukums, tabulēšanas zīme vai cita vadības rakstzīme."

#: src/postulo/plugins/identifiers/patterns.py:536
#, python-format, draft
msgid "A pattern is %(most)d characters long at most."
msgstr "Paraugs ir ne garāks par %(most)d rakstzīmēm."

#: src/postulo/plugins/identifiers/patterns.py:294
#, python-format, draft
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Paraugs piedāvā ne vairāk kā %(most)d alternatīvas."

#: src/postulo/plugins/identifiers/patterns.py:453
#, python-format, draft
msgid ""
"A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr ""
"Diapazons iet no vienas rakstzīmes līdz vēlākai: “%(range)s” ir nepareizā secībā vai nebeidzas ar rakstzīmi."

#: src/postulo/plugins/identifiers/custom.py:762
#, draft
msgid "a scheme is written between { and }."
msgstr "shēma tiek rakstīta figūriekavās: starp { and }."

#: src/postulo/plugins/identifiers/schemes.py:291
#, draft
msgid "a staff number, a national registration"
msgstr "darbinieka numurs, valsts reģistrācija"

#: src/postulo/plugins/identifiers/custom.py:245
#, draft
msgid ""
"a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr ""
"teksts dubultpēdiņās nevar iet pāri rindas pārtraukumam vai saturēt tabulēšanas zīmi, tāpēc var trūkt noslēdzošo pēdiņu."

#: src/postulo/plugins/identifiers/custom.py:224
#, draft
msgid ""
"a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr ""
"šeit jāsākas vērtībai: teksts dubultpēdiņās, saraksts, objekts, true vai false. Komats pēc pēdējā vienuma nav atļauts."

#: src/postulo/plugins/identifiers/custom.py:442
#, python-format, draft
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Un vēl %(more)d tāda paša veida problēma šajā shēmā."
msgstr[1] "Un vēl %(more)d tāda paša veida problēmas šajā shēmā."
msgstr[2] "Un vēl %(more)d tāda paša veida problēmu šajā shēmā."

#: src/postulo/plugins/identifiers/schemes.py:246
#, draft
msgid "Company register number"
msgstr "Uzņēmumu reģistra numurs"

#: src/postulo/plugins/identifiers/__init__.py:63
#, draft
msgid "External identifiers"
msgstr "Ārējie identifikatori"

#: src/postulo/plugins/identifiers/custom.py:589
#, python-format, draft
msgid "in “%(tag)s”, %(reason)s"
msgstr "sadaļā “%(tag)s”, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py:252
#, draft
msgid ""
"JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr ""
"JSON nezina, kas seko šai atpakaļvērstajai slīpsvītrai. Atpakaļvērsta slīpsvītra paraugā tiek rakstīta divreiz: \\\\d ciparam."

#: src/postulo/plugins/identifiers/schemes.py:230
#, draft
msgid "Legal Entity Identifier (LEI)"
msgstr "Juridiskās personas identifikators (LEI)"

#: src/postulo/plugins/identifiers/custom.py:211
#, python-format, draft
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Rinda %(line)d, kolonna %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py:215
#, python-format, draft
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Rinda %(line)d, shēmas numurs %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py:213
#, python-format, draft
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Rinda %(line)d, shēma “%(key)s”: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py:216
#, python-format, draft
msgid "Line %(line)d: %(reason)s"
msgstr "Rinda %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py:375
#, python-format, draft
msgid ""
"Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr ""
"Nekas nevar atkārtoties vairāk nekā %(most)d reizes: neviens identifikators nav garāks."

#: src/postulo/plugins/identifiers/patterns.py:288
#: src/postulo/plugins/identifiers/patterns.py:334
#, draft
msgid "One side of this “|” is empty."
msgstr "Viena šīs “|” puse ir tukša."

#: src/postulo/plugins/identifiers/patterns.py:391
#, draft
msgid ""
"Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr ""
"Aiz rakstzīmes vai klases var sekot tikai viens skaits: “{2}?”, “??” un “{2}+” nav šīs valodas daļa."

#: src/postulo/plugins/identifiers/schemes.py:288
#, draft
msgid "Other"
msgstr "Cits"

#: src/postulo/plugins/identifiers/schemes.py:250
#, draft
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py:493
#, draft
msgid ""
"Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr ""
"Apaļajās iekavās ir fiksēts atdalītājs, rakstzīmes, kas jāatrod tādas, kādas tās ir, un nekas cits: nekādas klases, skaita vai “|”."

#: src/postulo/plugins/identifiers/schemes.py:254
#, draft
msgid "Start with the country's two-letter code."
msgstr "Sāciet ar valsts divu burtu kodu."

#: src/postulo/plugins/identifiers/schemes.py:196
#, draft
msgid ""
"That ISNI's last character does not match the rest, so one of them is a typo."
msgstr ""
"Šī ISNI pēdējā rakstzīme neatbilst pārējām, tāpēc viena no tām ir drukas kļūda."

#: src/postulo/plugins/identifiers/schemes.py:154
#, draft
msgid ""
"That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr ""
"Šī ORCID pēdējais cipars neatbilst pārējiem, tātad viens no tiem ir drukas kļūda."

#: src/postulo/plugins/identifiers/custom.py:492
#, draft
msgid ""
"The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr ""
"Šī identifikatora kontrolrakstzīmes neatbilst pārējām, tāpēc viena no tām ir drukas kļūda."

#: src/postulo/plugins/identifiers/patterns.py:552
#, draft
msgid ""
"The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr ""
"Šī parauga klases kopā aizņem pārāk ilgu laiku sagatavošanai. Klasi, kas rakstīta ar “^”, vai tādu, kas aizņem tūkstošiem rakstzīmju, piemēram, [一-鿿], vienā paraugā var izmantot tikai tik reižu: izmantojiet tādu mazāk vai šaurākas."

#: src/postulo/plugins/identifiers/custom.py:505
#, draft
msgid "the example does not pass the checksum the scheme names."
msgstr "piemērs neiztur kontrolsummu, ko shēma nosauc."

#: src/postulo/plugins/identifiers/custom.py:503
#, draft
msgid "the example is not a value its own pattern accepts."
msgstr "piemērs nav vērtība, ko pieņem tā paša shēmas paraugs."

#: src/postulo/plugins/identifiers/custom.py:579
#, python-format, draft
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "valodas kods “%(tag)s” ir uzrakstīts “%(written)s”."

#: src/postulo/plugins/identifiers/custom.py:571
#, python-format, draft
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "valoda “%(tag)s” ir uzrakstīta divreiz sadaļā “label”."

#: src/postulo/plugins/identifiers/schemes.py:241
#, draft
msgid "The LEI's check digits do not match."
msgstr "LEI kontrolcipari nesakrīt."

#: src/postulo/plugins/identifiers/custom.py:257
#, draft
msgid "the list has ended, and something follows it."
msgstr "saraksts ir beidzies, un kaut kas tam seko."

#: src/postulo/plugins/identifiers/custom.py:584
#, python-format, draft
msgid ""
"the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr ""
"nosaukums sadaļā “%(tag)s” ir teksts dubultpēdiņās, vienā rindā, ar kaut ko tajā un ne garāks par %(most)d rakstzīmēm."

#: src/postulo/plugins/identifiers/custom.py:667
#, python-format, draft
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "paraugu nevar izmantot pie rakstzīmes %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py:87
#, python-format
msgid ""
"The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr ""

#: src/postulo/plugins/identifiers/crosschecks.py:99
#, python-format
msgid ""
"The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr ""

#: src/postulo/plugins/identifiers/custom.py:739
#, draft
msgid "the schemes are written as a list, between [ and ]."
msgstr "shēmas tiek rakstītas kā saraksts starp [ un ]."

#: src/postulo/plugins/identifiers/custom.py:719
#, python-format, draft
msgid "the schemes can be %(most)d characters long at most."
msgstr "shēmas var būt ne garākas par %(most)d rakstzīmēm."

#: src/postulo/plugins/identifiers/custom.py:241
#, draft
msgid "the text that opens with a double quote here is never closed."
msgstr "teksts, kas šeit sākas ar dubultpēdiņām, nekad netiek aizvērts."

#: src/postulo/plugins/identifiers/patterns.py:309
#, draft
msgid "There is nothing before this for it to count."
msgstr "Pirms šī nav nekā, ko tas varētu skaitīt."

#: src/postulo/plugins/identifiers/patterns.py:563
#, python-format, draft
msgid ""
"This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr ""
"Tas prasa vairāk nekā %(most)d rakstzīmes, un neviens identifikators nav garāks."

#: src/postulo/plugins/identifiers/patterns.py:357
#: src/postulo/plugins/identifiers/patterns.py:435
#: src/postulo/plugins/identifiers/patterns.py:500
#, draft
msgid "This bracket is never closed."
msgstr "Šī iekava nekad netiek aizvērta."

#: src/postulo/plugins/identifiers/patterns.py:479
#, draft
msgid "This class takes no character at all."
msgstr "Šī klase neņem nevienu rakstzīmi."

#: src/postulo/plugins/identifiers/patterns.py:311
#, draft
msgid "This closes a bracket that was never opened."
msgstr "Šis aizver iekavu, kas nekad netika atvērta."

#: src/postulo/plugins/identifiers/custom.py:265
#: src/postulo/plugins/identifiers/custom.py:733
#, draft
msgid "this is not JSON."
msgstr "tas nav JSON."

#: src/postulo/plugins/identifiers/custom.py:531
#, draft
msgid ""
"this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr ""
"šī atslēga ir viena no Postulo paša shēmām, kuras tiek papildinātas un nekad nemainītas. Izvēlieties citu."

#: src/postulo/plugins/identifiers/custom.py:770
#, draft
msgid "this key is used by a scheme further up."
msgstr "šo atslēgu izmanto augstāk esoša shēma."

#: src/postulo/plugins/identifiers/patterns.py:582
#, draft
msgid ""
"What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr ""
"Tam, kas seko pēc šī, var sākties ar rakstzīmi, ko arī šis varētu ņemt, tāpēc vērtību varētu nolasīt divējādi. Dodiet tam precīzu skaitu vai ielieciet aiz tā atdalītāju, ko tas nevar ņemt."

#: src/postulo/plugins/identifiers/__init__.py:65
#, draft
msgid ""
"Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr ""
"Kurus ārējos identifikatorus Postulo saprot — ORCID, ISNI, Wikidata, juridiskās personas identifikatoru, komercreģistra numuru —, kā katram vajadzētu izskatīties, uz kurieni tas ved un vai tas identificē personu, organizāciju vai abas. Nekas no tā nekad netiek meklēts tiešsaistē."

#: src/postulo/plugins/identifiers/custom.py:680
#, python-format, draft
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "“%(name)s” nevar izmantot. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py:420
#, python-format, draft
msgid ""
"“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr ""
"“%(name)s” satur %(half)s, kas ir puse rakstzīmes un pats par sevi nav teksts. Rakstiet rakstzīmi, kāda tai bija jābūt, vai abas tās puses."

#: src/postulo/plugins/identifiers/custom.py:463
#, python-format, draft
msgid "“%(name)s” is missing."
msgstr "“%(name)s” trūkst."

#: src/postulo/plugins/identifiers/custom.py:395
#, python-format, draft
msgid ""
"“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr ""
"“%(name)s” nav kaut kas, ko shēma var pateikt. Shēma var pateikt: %(names)s."

#: src/postulo/plugins/identifiers/custom.py:510
#, python-format, draft
msgid ""
"“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr ""
"“%(name)s” ir teksts dubultpēdiņās, vienā rindā, ar kaut ko tajā un ne garāks par %(most)d rakstzīmēm."

#: src/postulo/plugins/identifiers/custom.py:688
#, python-format, draft
msgid "“%(name)s” is true or false, without quotes."
msgstr "“%(name)s” ir true vai false, bez pēdiņām."

#: src/postulo/plugins/identifiers/custom.py:391
#, python-format, draft
msgid "“%(name)s” is written twice."
msgstr "“%(name)s” ir uzrakstīts divreiz."

#: src/postulo/plugins/identifiers/custom.py:575
#, python-format, draft
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "“%(tag)s” nav valodas kods. Viens izskatās kā en-GB, fr-FR vai pt-BR."

#: src/postulo/plugins/identifiers/patterns.py:487
#, draft
msgid ""
"“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr ""
"“(?” sāk grupu, kuras šai valodai nav: nekas neskatās uz priekšu vai atpakaļ, un nevienai grupai nav nosaukuma."

#: src/postulo/plugins/identifiers/patterns.py:346
#, draft
msgid ""
"“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr ""
"“*” un “+” atkārtojas bez ierobežojuma, un paraugam jānorāda, cik reižu maksimāli: rakstiet {0,20} vai {1,20}."

#: src/postulo/plugins/identifiers/patterns.py:468
#, draft
msgid ""
"“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr ""
"“[^]” neatstāj ārpus nekā, tāpēc tas nozīmē jebkuru rakstzīmi, un tas nav šīs valodas daļa. Rakstiet klasi, piemēram, [^ ] jebkurai rakstzīmei, izņemot atstarpi."

#: src/postulo/plugins/identifiers/patterns.py:416
#, python-format, draft
msgid ""
"“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr ""
"“\\%(letter)s” nav šīs valodas daļa. Klases ar nosaukumu ir \\d, cipars, un \\w, burts, cipars vai pasvītrojums; atpakaļvērsta slīpsvītra pirms pieturzīmes apzīmē pašu zīmi."

#: src/postulo/plugins/identifiers/patterns.py:323
#, draft
msgid ""
"“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr ""
"“^” un “$” ir atļauti tikai parauga abos galos, kur tie neko nemaina: paraugs vienmēr apraksta visu vērtību."

#: src/postulo/plugins/identifiers/custom.py:696
#, draft
msgid ""
"“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr ""
"“checksum” nosauc vienu no diviem, ko Postulo pazīst: iso7064-mod11-2, ar ko beidzas ORCID, vai iso7064-mod97-10, ar ko beidzas juridiskās personas identifikators."

#: src/postulo/plugins/identifiers/custom.py:632
#, draft
msgid ""
"“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr ""
"“lower” pārvērš ierakstīto mazajos burtos, pirms paraugs tiek vaicāts, un šis paraugs neņem neko, kas rakstīts mazajos burtos: shēma nepieņemtu nevienu vērtību. Rakstiet paraugu mazajos burtos vai noņemiet “lower”."

#: src/postulo/plugins/identifiers/custom.py:661
#, draft
msgid "“pattern” is text in double quotes."
msgstr "“pattern” ir teksts dubultpēdiņās."

#: src/postulo/plugins/identifiers/custom.py:649
#, draft
msgid ""
"“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr ""
"“subjects” uzskaita, ko shēma identificē: [\"person\"], [\"company\"] vai [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py:470
#, draft
msgid "“upper” and “lower” cannot both be true."
msgstr "“upper” un “lower” nevar būt abi true."

#: src/postulo/plugins/identifiers/custom.py:622
#, draft
msgid ""
"“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr ""
"“upper” pārvērš ierakstīto lielajos burtos, pirms paraugs tiek vaicāts, un šis paraugs neņem neko, kas rakstīts lielajos burtos: shēma nepieņemtu nevienu vērtību. Rakstiet paraugu lielajos burtos vai noņemiet “upper”."
