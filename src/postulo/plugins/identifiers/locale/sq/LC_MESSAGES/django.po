#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Këtu mund të përcaktohen më së shumti %(most)d skema."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s do të refuzohej sot: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Një vijë e pjerrët mbrapsht dhe një numër i referohen asaj që është lexuar më parë, dhe një model nuk mund ta bëjë këtë."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "mungojnë dy pikat midis një emri dhe asaj që thotë."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "pas elementit të fundit ka një presje. Hiqeni."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "mungon një presje para kësaj, ose një kllapë më lart nuk është mbyllur kurrë."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Një numërim shkruhet {3}, ose {2,5} me numrin më të vogël të parin."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Një numërim ka nevojë për një numër maksimal: {2,} përsëritet pa kufi. Shkruani {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Një pikë në një shprehje të rregullt do të thotë çdo karakter, dhe kjo nuk është pjesë e kësaj gjuhe. Shkruani “\\.” për një pikë, ose një klasë si [^ ] për çdo karakter përveç hapësirës."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Një grup nuk mund të përsëritet: mund ta ndjekë “?”, dhe asgjë tjetër."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "një çelës përbëhet nga shkronja të vogla, shifra dhe viza ndarëse, në thonjëza dyshe, fillon me një shkronjë ose një shifër dhe ka të shumtën %(most)d karaktere."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "një etiketë është një emër në thonjëza dyshe, me të shumtën %(most)d karaktere, ose një emër për çdo gjuhë: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Një lidhje është tekst në thonjëza dyshe."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "një emër nuk mund të përmbajë U+%(code)s, një karakter që nuk zë vend ose e kthen tekstin së prapthi: emri nuk do të lexohej ashtu siç është shkruar."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "një emër duhet të jetë diçka që shihet: ky përmban vetëm karaktere që nuk vizatohen."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "këtu duhet të fillojë një emër në thonjëza dyshe. Një presje pas elementit të fundit nuk lejohet."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Një model nuk mund të jetë bosh."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Një model nuk mund të përfundojë me një vijë të pjerrët mbrapsht."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Një model nuk mund të përmbajë ndërprerje rreshti, tabulator apo ndonjë karakter tjetër kontrolli."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Një model ka më së shumti %(most)d karaktere."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Një model ofron më së shumti %(most)d alternativa."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Një interval shkon nga një karakter te një i mëvonshëm: “%(range)s” është së prapthi, ose nuk përfundon me një karakter."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "një skemë shkruhet midis { dhe }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "një numër punonjësi, një numër regjistrimi kombëtar"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "një tekst në thonjëza dyshe nuk mund të kalojë përtej një ndërprerjeje rreshti ose të përmbajë tabulator, ndaj mund të mungojë një thonjëz mbyllëse."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "këtu duhet të fillojë një vlerë: tekst në thonjëza dyshe, një listë, një objekt, true ose false. Një presje pas elementit të fundit nuk lejohet."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Si dhe %(more)d problem tjetër i të njëjtit lloj në këtë skemë."
msgstr[1] "Si dhe %(more)d probleme të tjera të të njëjtit lloj në këtë skemë."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Numri i regjistrimit të kompanisë"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Identifikues të jashtëm"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "te “%(tag)s”, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON nuk e di se çfarë vjen pas kësaj vije të pjerrët mbrapsht. Një vijë e pjerrët mbrapsht në një model shkruhet dy herë: \\\\d për një shifër."

#: src/postulo/plugins/identifiers/schemes.py
#, fuzzy
msgid "Legal Entity Identifier (LEI)"
msgstr "Identifikuesi i Personit Juridik (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Rreshti %(line)d, kolona %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Rreshti %(line)d, skema numër %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Rreshti %(line)d, skema “%(key)s”: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Rreshti %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Asgjë nuk mund të përsëritet më shumë se %(most)d herë: asnjë identifikues nuk është më i gjatë se kaq."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Njëra anë e këtij “|” është bosh."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Një karakter ose një klasë mund të ndiqet nga vetëm një numërim: “{2}?”, “??” dhe “{2}+” nuk janë pjesë e kësaj gjuhe."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Tjetër"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Kllapat e rrumbullakëta mbajnë një ndarës fiks, karaktere që duhen gjetur ashtu siç janë, dhe asgjë tjetër: asnjë klasë, asnjë numërim dhe asnjë “|”."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Filloni me kodin dyshkronjësh të vendit, pastaj një numër që kalon shifrën e kontrollit të atij vendi."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Karakteri i fundit i atij ISNI-i nuk përputhet me pjesën tjetër, prandaj njëri prej tyre është gabim shtypi."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Shifra e fundit e atij ORCID-i nuk përputhet me pjesën tjetër, prandaj njëra prej tyre është gabim shtypi."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Karakteret e kontrollit të atij identifikuesi nuk përputhen me pjesën tjetër të tij, prandaj njëri prej tyre është gabim shtypi."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Klasat e këtij modeli kërkojnë së bashku tepër kohë për t'u përgatitur. Një klasë e shkruar me “^”, ose një që përfshin mijëra karaktere si [一-鿿], mund të shfaqet në një model vetëm një numër të kufizuar herësh: përdorni më pak të tilla, ose më të ngushta."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "shembulli nuk e kalon shumën e kontrollit që emërton skema."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "shembulli nuk është vlerë që e pranon modeli i vet."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "kodi i gjuhës “%(tag)s” shkruhet “%(written)s”."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "gjuha “%(tag)s” është shkruar dy herë te “label”."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Shifrat e kontrollit të LEI-t nuk përputhen."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "lista ka përfunduar, por diçka vjen pas saj."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "emri te “%(tag)s” është tekst në thonjëza dyshe, në një rresht, jo bosh dhe me të shumtën %(most)d karaktere."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "modeli nuk mund të përdoret, te karakteri %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Numri i regjistrit %(register)s dhe ID-ja e OpenCorporates %(corporates)s tregojnë juridiksione të ndryshme. Kjo mund të jetë e saktë për një kompani të regjistruar në më shumë se një juridiksion."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Numri i regjistrit %(register)s dhe ID-ja e OpenCorporates %(corporates)s tregojnë të njëjtin juridiksion, por numra të ndryshëm."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "skemat shkruhen si listë, midis [ dhe ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "skemat mund të kenë më së shumti %(most)d karaktere."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "teksti që hapet këtu me thonjëza dyshe nuk mbyllet kurrë."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Para kësaj nuk ka asgjë për të numëruar."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Kjo kërkon më shumë se %(most)d karaktere, dhe asnjë identifikues nuk është më i gjatë se kaq."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Kjo kllapë nuk mbyllet kurrë."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Kjo klasë nuk përfshin asnjë karakter."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Kjo mbyll një kllapë që nuk është hapur kurrë."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "ky nuk është JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "ky çelës është një nga skemat e vetë Postulo-s, të cilat vetëm shtohen dhe nuk ndryshohen kurrë. Zgjidhni një tjetër."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "ky çelës përdoret nga një skemë më lart."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Ajo që vjen pas kësaj mund të fillojë me një karakter që mund ta marrë edhe kjo, prandaj një vlerë mund të lexohej në dy mënyra. Jepini kësaj një numërim të saktë, ose vendosni pas saj një ndarës që ajo nuk mund ta marrë."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Cilët identifikues të jashtëm kupton Postulo — ORCID, ISNI, Wikidata, një identifikues personi juridik, një numër regjistrimi kompanie — si duhet të duket secili, ku të çon dhe nëse identifikon një person, një organizatë apo të dyja. Asgjë këtu nuk kërkohet kurrë në internet."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "“%(name)s” nuk mund të përdoret. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "“%(name)s” përmban %(half)s, që është gjysma e një karakteri dhe jo tekst më vete. Shkruani karakterin që duhej të ishte, ose të dyja gjysmat e tij."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "Mungon “%(name)s”."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "“%(name)s” nuk është diçka që një skemë mund të thotë. Një skemë mund të thotë: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(name)s” është tekst në thonjëza dyshe, në një rresht, jo bosh dhe me të shumtën %(most)d karaktere."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "“%(name)s” është true ose false, pa thonjëza."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "“%(name)s” është shkruar dy herë."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "“%(tag)s” nuk është kod gjuhe. Një kod duket si en-GB, fr-FR ose pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "“(?” hap një grup që kjo gjuhë nuk e ka: asgjë nuk shikon përpara apo prapa, dhe asnjë grup nuk ka emër."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "“*” dhe “+” përsëriten pa kufi, ndërsa një model duhet të thotë sa herë më së shumti: shkruani {0,20} ose {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "“[^]” nuk përjashton asgjë, prandaj do të thotë çdo karakter, dhe kjo nuk është pjesë e kësaj gjuhe. Shkruani një klasë si [^ ] për çdo karakter përveç hapësirës."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "“\\%(letter)s” nuk është pjesë e kësaj gjuhe. Klasat me emër janë \\d, një shifër, dhe \\w, një shkronjë, një shifër ose një nënvizë; një vijë e pjerrët mbrapsht para një shenje pikësimi qëndron për vetë shenjën."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "“^” dhe “$” lejohen vetëm në dy skajet e një modeli, ku nuk ndryshojnë asgjë: një model përshkruan gjithmonë të gjithë vlerën."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "“checksum” emërton njërën nga të dyja që njeh Postulo: iso7064-mod11-2, me të cilën përfundon një ORCID, ose iso7064-mod97-10, me të cilën përfundon një identifikues personi juridik."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "“lower” e kthen në shkronja të vogla atë që u shtyp para se të pyetet modeli, ndërsa ky model nuk pranon asgjë të shkruar me shkronja të vogla: skema nuk do të pranonte asnjë vlerë. Shkruajeni modelin me shkronja të vogla, ose hiqni “lower”."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "“pattern” është tekst në thonjëza dyshe."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "“subjects” liston çfarë identifikon skema: [\"person\"], [\"company\"] ose [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "“upper” dhe “lower” nuk mund të jenë të dyja true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "“upper” e kthen në shkronja të mëdha atë që u shtyp para se të pyetet modeli, ndërsa ky model nuk pranon asgjë të shkruar me shkronja të mëdha: skema nuk do të pranonte asnjë vlerë. Shkruajeni modelin me shkronja të mëdha, ose hiqni “upper”."
