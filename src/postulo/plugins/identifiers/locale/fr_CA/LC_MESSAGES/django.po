#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "%(most)d systèmes au plus peuvent être définis ici."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s serait refusé aujourd'hui : %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Une barre oblique inversée suivie d'un nombre renvoie à ce qui a été lu plus tôt, ce qu'un motif ne peut pas faire."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "il manque un deux-points entre un nom et ce qu'il dit."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "une virgule suit le dernier élément. Retirez-la."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "il manque une virgule avant ceci, ou un crochet ou une accolade ouverts plus haut n'ont jamais été fermés."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Un quantificateur s'écrit {3}, ou {2,5} avec le plus petit nombre en premier."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Un quantificateur a besoin d'un nombre maximal : {2,} répète sans limite. Écrivez {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Dans une expression régulière, un point désigne n'importe quel caractère, et cela ne fait pas partie de ce langage. Écrivez « \\. » pour un point, ou une classe comme [^ ] pour tout caractère sauf une espace."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Un groupe ne peut pas se répéter : « ? » peut le suivre, et rien d'autre."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "une clé se compose de lettres minuscules, de chiffres et de traits d'union, entre guillemets doubles, commence par une lettre ou un chiffre et compte %(most)d caractères au plus."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "un libellé est un nom entre guillemets doubles, de %(most)d caractères au plus, ou un nom par langue : {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Un lien est un texte entre guillemets doubles."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "un nom ne peut pas contenir U+%(code)s, un caractère qui n'occupe aucune place ou qui inverse le sens du texte : le nom ne se lirait pas comme il est écrit."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "un nom doit être visible : celui-ci ne contient que des caractères qui ne s'affichent pas."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "un nom entre guillemets doubles devrait commencer ici. Une virgule après le dernier élément n'est pas permise."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Un motif ne peut pas être vide."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Un motif ne peut pas se terminer par une barre oblique inversée."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Un motif ne peut contenir ni saut de ligne, ni tabulation, ni aucun autre caractère de contrôle."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Un motif compte %(most)d caractères au plus."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Un motif propose %(most)d variantes au plus."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Un intervalle va d'un caractère à un caractère situé après lui : « %(range)s » est à l'envers, ou ne se termine pas par un caractère."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "un système s'écrit entre { et }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "un matricule, un numéro d'inscription national"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "un texte entre guillemets doubles ne peut ni passer à la ligne ni contenir de tabulation; il manque peut-être un guillemet fermant."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "une valeur devrait commencer ici : un texte entre guillemets doubles, une liste, un objet, true ou false. Une virgule après le dernier élément n'est pas permise."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Et %(more)d autre problème du même genre dans ce système."
msgstr[1] "Et %(more)d autres problèmes du même genre dans ce système."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Numéro au registre des entreprises"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Identifiants externes"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "dans « %(tag)s », %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON ne connaît pas ce qui suit cette barre oblique inversée. Dans un motif, une barre oblique inversée s'écrit deux fois : \\\\d pour un chiffre."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Identifiant d'entité juridique (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Ligne %(line)d, colonne %(column)d : %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Ligne %(line)d, système numéro %(number)d : %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Ligne %(line)d, système « %(key)s » : %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Ligne %(line)d : %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Rien ne peut être répété plus de %(most)d fois : aucun identifiant n'est plus long que cela."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Un côté de ce « | » est vide."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Un seul quantificateur peut suivre un caractère ou une classe : « {2}? », « ?? » et « {2}+ » ne font pas partie de ce langage."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Autres compétences"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Les parenthèses contiennent un séparateur fixe, des caractères à retrouver tels quels, et rien d'autre : ni classe, ni quantificateur, ni « | »."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code."
msgstr "Commencez par le code à deux lettres du pays."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Le dernier caractère de cet ISNI ne correspond pas au reste : l'un des deux comporte donc une faute de frappe."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Le dernier chiffre de cet ORCID ne correspond pas au reste : l'un des deux comporte donc une faute de frappe."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Les caractères de contrôle de cet identifiant ne correspondent pas au reste : l'un des deux comporte donc une faute de frappe."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Les classes de ce motif sont, à elles toutes, trop longues à préparer. Une classe écrite avec « ^ », ou une classe qui accepte des milliers de caractères comme [一-鿿], ne peut figurer qu'un nombre limité de fois dans un motif : utilisez-en moins, ou de plus étroites."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "l'exemple ne passe pas la somme de contrôle indiquée par le système."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "l'exemple n'est pas une valeur acceptée par son propre motif."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "le code de langue « %(tag)s » s'écrit « %(written)s »."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "la langue « %(tag)s » figure deux fois dans « label »."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Les chiffres de contrôle du LEI ne correspondent pas."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "la liste est terminée, et quelque chose la suit."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "le nom dans « %(tag)s » est un texte entre guillemets doubles, sur une seule ligne, non vide et de %(most)d caractères au plus."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "le motif est inutilisable, au caractère %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Le numéro au registre %(register)s et l'identifiant OpenCorporates %(corporates)s désignent des juridictions différentes. Cela peut être exact pour une entreprise immatriculée dans plusieurs."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Le numéro au registre %(register)s et l'identifiant OpenCorporates %(corporates)s désignent la même juridiction mais des numéros différents."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "les systèmes s'écrivent sous forme de liste, entre [ et ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "les systèmes peuvent compter %(most)d caractères au plus."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "le texte qui s'ouvre ici par un guillemet double n'est jamais fermé."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Il n'y a rien avant ceci à quantifier."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Ceci demande plus de %(most)d caractères, et aucun identifiant n'est plus long que cela."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Cette parenthèse ou ce crochet n'est jamais fermé."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Cette classe n'accepte aucun caractère."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Ceci ferme une parenthèse ou un crochet jamais ouvert."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "ce n'est pas du JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "cette clé est celle d'un des systèmes propres à Postulo, que l'on peut compléter mais jamais modifier. Choisissez-en une autre."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "cette clé est déjà utilisée par un système plus haut."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Ce qui suit peut commencer par un caractère que ceci accepte aussi, si bien qu'une valeur pourrait se lire de deux façons. Donnez-lui un quantificateur exact, ou faites-le suivre d'un séparateur qu'il n'accepte pas."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Les identifiants externes que Postulo comprend — ORCID, ISNI, Wikidata, identifiant d'entité juridique, numéro au registre des entreprises —, la forme que chacun doit avoir, vers où il pointe, et s'il identifie une personne, une organisation ou les deux. Rien n'est jamais consulté en ligne ici."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "« %(name)s » est inutilisable. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "« %(name)s » contient %(half)s, qui n'est que la moitié d'un caractère et pas du texte à elle seule. Écrivez le caractère voulu, ou ses deux moitiés."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "Il manque « %(name)s »."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "« %(name)s » ne fait pas partie de ce qu'un système peut dire. Un système peut dire : %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "« %(name)s » est un texte entre guillemets doubles, sur une seule ligne, non vide et de %(most)d caractères au plus."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "« %(name)s » vaut true ou false, sans guillemets."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "« %(name)s » figure deux fois."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "« %(tag)s » n'est pas un code de langue. Un code de langue ressemble à en-GB, fr-FR ou pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "« (? » ouvre un groupe que ce langage ne connaît pas : rien ne regarde en avant ni en arrière, et aucun groupe ne porte de nom."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "« * » et « + » répètent sans limite, et un motif doit indiquer un nombre maximal de répétitions : écrivez {0,20} ou {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "« [^] » n'exclut rien et désigne donc n'importe quel caractère, ce qui ne fait pas partie de ce langage. Écrivez une classe comme [^ ] pour tout caractère sauf une espace."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "« \\%(letter)s » ne fait pas partie de ce langage. Les classes qui ont un nom sont \\d, un chiffre, et \\w, une lettre, un chiffre ou un trait de soulignement; une barre oblique inversée devant un signe de ponctuation désigne ce signe lui-même."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "« ^ » et « $ » ne sont permis qu'aux deux extrémités d'un motif, où ils ne changent rien : un motif décrit toujours la valeur entière."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "« checksum » nomme l'une des deux sommes de contrôle que Postulo connaît : iso7064-mod11-2, par laquelle se termine un ORCID, ou iso7064-mod97-10, par laquelle se termine un identifiant d'entité juridique."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "« lower » met la saisie en minuscules avant de la soumettre au motif, et ce motif n'accepte rien en minuscules : le système n'accepterait aucune valeur. Écrivez le motif en minuscules, ou retirez « lower »."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "« pattern » est un texte entre guillemets doubles."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "« subjects » liste ce que le système identifie : [\"person\"], [\"company\"] ou [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "« upper » et « lower » ne peuvent pas être true tous les deux."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "« upper » met la saisie en majuscules avant de la soumettre au motif, et ce motif n'accepte rien en majuscules : le système n'accepterait aucune valeur. Écrivez le motif en majuscules, ou retirez « upper »."
