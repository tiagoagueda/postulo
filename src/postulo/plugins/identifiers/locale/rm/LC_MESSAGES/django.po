#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Qua pon vegnir definids maximalmain %(most)d sistems."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s vegniss refusà oz: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Ina backslash ed in numer sa refereschan a quai ch'è vegnì legì pli baud, ed in muster na po betg far quai."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "i manca in dubel punct tranter in num e quai ch'el di."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "ina comma suonda l'ultim element. Stizzai la."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "i manca ina comma avant quai, u ina parantesa pli si n'è mai vegnida serrada."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "In dumber vegn scrit {3}, u {2,5} cun il numer pli pitschen l'emprim."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "In dumber dovra in numer maximal: {2,} repeta senza limit. Scrivai {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "In punct munta en in'expressiun regulara mintga caracter, e quai na fa betg part da questa lingua. Scrivai «\\.» per in punct, u ina classa sco [^ ] per mintga caracter auter ch'in spazi."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Ina gruppa na po betg vegnir repetida: «?» la po suandar, e nagut auter."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "ina clav è fatga da bustabs pitschens, cifras e stritgs, tranter virgulettas dublas, cumenza cun in bustab u ina cifra ed ha maximalmain %(most)d caracters."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "ina etichetta è in num tranter virgulettas dublas, cun maximalmain %(most)d caracters, u in num per mintga lingua: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Ina colliaziun è text tranter virgulettas dublas."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "in num na po betg cuntegnair U+%(code)s, in caracter che n'occupa nagin spazi u che volva il text: il num na sa legiss betg sco ch'el è scrit."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "in num sto esser insatge che sa vesa: quest qua cuntegna mo caracters che na vegnan betg mussads."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "qua duess cumenzar in num tranter virgulettas dublas. Ina comma suenter l'ultim element n'è betg permessa."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "In muster na po betg esser vid."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A pattern cannot end in a backslash."
msgstr "In muster na po betg finir cun ina backslash."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "In muster na po betg cuntegnair ina rupta da lingia, in tabulatur u in auter caracter da controlla."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "In muster ha maximalmain %(most)d caracters."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "In muster porscha maximalmain %(most)d alternativas."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "In interval va d'in caracter ad in caracter suandant: «%(range)s» è en la successiun sbagliada u na finescha betg cun in caracter."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "in sistem vegn scrit tranter { e }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "in numer da collavuratur, ina registraziun naziunala"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "in text tranter virgulettas dublas na po betg ir sur ina rupta da lingia u cuntegnair in tabulatur, forsa manca pia ina virguletta finala."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "qua duess cumenzar ina valur: text tranter virgulettas dublas, ina glista, in object, true u false. Ina comma suenter l'ultim element n'è betg permessa."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Ed anc %(more)d problem da la medema sort en quest sistem."
msgstr[1] "Ed anc %(more)d problems da la medema sort en quest sistem."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Numer dal register da commerzi"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Identificaturs externs"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "en «%(tag)s», %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON na sa betg tge che suonda questa backslash. Ina backslash en in muster vegn scritta duas giadas: \\\\d per ina cifra."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Identificatur d'entitad giuridica (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Lingia %(line)d, colonna %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Lingia %(line)d, sistem numer %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Lingia %(line)d, sistem «%(key)s»: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Lingia %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Nagut na po vegnir repetì dapli che %(most)d giadas: nagin identificatur n'è pli lung che quai."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Ina vart da quest «|» è vida."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Mo in dumber po suandar in caracter u ina classa: «{2}?», «??» e «{2}+» na fan betg part da questa lingua."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Auter"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Parantesas radundas cuntegnan in separatur fix, caracters che duain vegnir chattads tals quals, e nagut auter: nagina classa, nagin dumber e nagin «|»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Cumenzai cun il code da dus bustabs dal pajais, suandà d'in numer che passa la cifra da controlla da quel pajais."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "L'ultim caracter da quel ISNI na correspunda betg al rest, pia è in dad els in sbagl da tippar."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "L'ultima cifra da quel ORCID na correspunda betg al rest, pia è ina dad ellas in sbagl da tippar."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Ils caracters da controlla da quel identificatur na correspundan betg al rest, pia è in dad els in sbagl da tippar."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Las classas da quest muster dovran ensemen memia ditg per vegnir preparadas. Ina classa scritta cun «^», u ina che prenda milliers da caracters sco [一-鿿], po star mo in tschert dumber giadas en in muster: duvrai main da quellas u pli strettas."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "l'exempel na passa betg la summa da controlla ch'il sistem numna."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "l'exempel n'è betg ina valur che ses agen muster accepta."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "il code da lingua «%(tag)s» vegn scrit «%(written)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "la lingua «%(tag)s» è scritta duas giadas en «label»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Las cifras da controlla dal LEI na correspundan betg."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "la glista è finida, ed insatge la suonda."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "il num en «%(tag)s» è text tranter virgulettas dublas, sin ina lingia, cun insatge en el e maximalmain %(most)d caracters."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "il muster na po betg vegnir duvrà, tar il caracter %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Il numer dal register %(register)s e l'ID OpenCorporates %(corporates)s numnan differentas giurisdicziuns. Quai po esser correct per in'interpresa registrada en pliras."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Il numer dal register %(register)s e l'ID OpenCorporates %(corporates)s numnan la medema giurisdicziun, ma differents numers."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "ils sistems vegnan scrits sco glista, tranter [ e ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "ils sistems pon avair maximalmain %(most)d caracters."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "il text che s'avra qua cun ina virguletta dubla na vegn mai serrà."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "I na dat nagut avant quai ch'el pudess dumbrar."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Quai pretenda dapli che %(most)d caracters, e nagin identificatur n'è pli lung che quai."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Questa parantesa na vegn mai serrada."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Questa classa na prenda nagin caracter."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Quai serra ina parantesa che n'è mai vegnida averta."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "quai n'è betg JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "questa clav è in dals sistems da Postulo sez, ils quals vegnan cumplettads e mai midads. Tschernai in'autra."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "questa clav vegn gia duvrada d'in sistem pli si."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Quai che suonda pudess cumenzar cun in caracter che quai pudess prender era, uschia ch'ina valur pudess vegnir legida en duas modas. Dai a quai in dumber exact, u mettai suenter el in separatur ch'el na po betg prender."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Tge identificaturs externs che Postulo chapescha — ORCID, ISNI, Wikidata, in identificatur d'entitad giuridica, in numer dal register da commerzi —, co che mintgin duess vesair ora, nua ch'el maina e sch'el identifitgescha ina persuna, in'organisaziun u omadus. Nagut qua na vegn mai tschertgà online."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "«%(name)s» na po betg vegnir duvrà. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "«%(name)s» cuntegna %(half)s, che è la mesadad d'in caracter e betg text per sasez. Scrivai il caracter ch'igl era manegià, u sias duas mesadads."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "«%(name)s» manca."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "«%(name)s» n'è betg insatge ch'in sistem po dir. In sistem po dir: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(name)s» è text tranter virgulettas dublas, sin ina lingia, cun insatge en el e maximalmain %(most)d caracters."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "«%(name)s» è true u false, senza virgulettas."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "«%(name)s» è scrit duas giadas."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "«%(tag)s» n'è betg in code da lingua. In code vesa ora sco en-GB, fr-FR u pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "«(?» cumenza ina gruppa che questa lingua n'enconuscha betg: nagut na guarda enavant u enavos, e nagina gruppa n'ha in num."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "«*» e «+» repetan senza limit, ed in muster sto dir quantas giadas al maximum: scrivai {0,20} u {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "«[^]» na lascha ora nagut, uschia ch'el munta mintga caracter, e quai na fa betg part da questa lingua. Scrivai ina classa sco [^ ] per mintga caracter auter ch'in spazi."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "«\\%(letter)s» na fa betg part da questa lingua. Las classas cun in num èn \\d, ina cifra, e \\w, in bustab, ina cifra u ina lingia bassa; ina backslash avant in segn d'interpuncziun stat per il segn sez."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "«^» e «$» èn permess mo a las duas extremitads d'in muster, nua ch'els na midan nagut: in muster descriva adina l'entira valur."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "«checksum» numna ina da las duas che Postulo enconuscha: iso7064-mod11-2, cun la quala in ORCID finescha, u iso7064-mod97-10, cun la quala in identificatur d'entitad giuridica finescha."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "«lower» metta quai ch'è vegnì endatà en bustabs pitschens avant che controllar il muster, e quest muster na prenda nagut scrit en bustabs pitschens: il sistem n'acceptass nagina valur. Scrivai il muster en bustabs pitschens u allontanai «lower»."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "«pattern» è text tranter virgulettas dublas."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "«subjects» enumerescha tge ch'il sistem identifitgescha: [\"person\"], [\"company\"] u [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "«upper» e «lower» na pon betg esser omadus true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "«upper» metta quai ch'è vegnì endatà en maiusclas avant che controllar il muster, e quest muster na prenda nagut scrit en maiusclas: il sistem n'acceptass nagina valur. Scrivai il muster en maiusclas u allontanai «upper»."
