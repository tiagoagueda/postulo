#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Мұнда ең көбі %(most)d схема анықтауға болады."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s бүгін қабылданбас еді: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Кері қиғаш сызық пен сан бұрын оқылған бөлікке сілтейді, ал өрнек мұны істей алмайды."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "атау мен оның мәні арасында қос нүкте жетіспейді."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "соңғы элементтен кейін үтір тұр. Оны алып тастаңыз."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "мұның алдында үтір жетіспейді немесе жоғарыдағы жақша жабылмаған."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Қайталау саны {3} немесе кіші саны бірінші тұратын {2,5} түрінде жазылады."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Қайталау санының ең үлкен шегі болуы керек: {2,} шексіз қайталайды. {2,20} деп жазыңыз."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Тұрақты өрнекте нүкте кез келген таңбаны білдіреді, ал бұл осы тілге кірмейді. Нүкте үшін «\\.» деп, ал бос орыннан басқа кез келген таңба үшін [^ ] сияқты класс жазыңыз."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Топ қайталана алмайды: одан кейін тек «?» тұра алады, басқа ештеңе тұра алмайды."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "кілт — қос тырнақшадағы, әріптен немесе цифрдан басталатын, ең көбі %(most)d таңбадан тұратын кіші әріптер, цифрлар мен дефистер."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "белгі — қос тырнақшадағы ең көбі %(most)d таңбалы атау немесе әр тілге бір атау: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Сілтеме — қос тырнақшадағы мәтін."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "атауда U+%(code)s болмауы керек: бұл орын алмайтын немесе мәтін бағытын өзгертетін таңба, сондықтан атау жазылғандай оқылмайды."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "атау көрінетін болуы керек: бұл атауда тек салынбайтын таңбалар бар."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "мұнда қос тырнақшадағы атау басталуы керек. Соңғы элементтен кейін үтір қоюға болмайды."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Өрнек бос болмауы керек."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Өрнек кері қиғаш сызықпен аяқталмауы керек."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Өрнекте жол үзілімі, табуляция немесе басқа басқару таңбасы болмауы керек."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Өрнектің ұзындығы ең көбі %(most)d таңба."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Өрнекте ең көбі %(most)d балама болады."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Ауқым бір таңбадан кейінгі таңбаға дейін созылады: «%(range)s» кері ретте жазылған немесе таңбамен аяқталмайды."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "схема { және } арасында жазылады."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "табель нөмірі, ұлттық тіркеу нөмірі"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "қос тырнақшадағы мәтін келесі жолға өте алмайды және табуляцияны қамти алмайды, сондықтан жабатын тырнақша жетіспеуі мүмкін."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "мұнда мән басталуы керек: қос тырнақшадағы мәтін, тізім, нысан, true немесе false. Соңғы элементтен кейін үтір қоюға болмайды."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Бұл схемада тағы %(more)d осындай мәселе бар."
msgstr[1] "Бұл схемада тағы %(more)d осындай мәселе бар."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Компанияның тіркеу нөмірі"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Сыртқы идентификаторлар"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "«%(tag)s» ішінде: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON бұл кері қиғаш сызықтан кейінгі таңбаны танымайды. Өрнектегі кері қиғаш сызық екі рет жазылады: цифр үшін \\\\d."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Заңды тұлға идентификаторы (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "%(line)d-жол, %(column)d-баған: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "%(line)d-жол, %(number)d-схема: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "%(line)d-жол, «%(key)s» схемасы: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "%(line)d-жол: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Ештеңе %(most)d реттен артық қайталана алмайды: одан ұзын идентификатор жоқ."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Осы «|» таңбасының бір жағы бос."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Таңбадан немесе кластан кейін тек бір қайталау саны тұра алады: «{2}?», «??» және «{2}+» осы тілге кірмейді."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Басқа"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Дөңгелек жақшаларда тек тұрақты бөлгіш, яғни сол күйінде ізделетін таңбалар болады, басқа ештеңе болмайды: класс та, қайталау саны да, «|» да жоқ."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Елдің екі әріпті кодынан бастаңыз, содан кейін сол елдің бақылау санынан өтетін нөмірді жазыңыз."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Бұл ISNI идентификаторының соңғы таңбасы қалған бөлігіне сәйкес келмейді, демек біреуінде қате бар."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Бұл ORCID идентификаторының соңғы цифры қалған бөлігіне сәйкес келмейді, демек біреуінде қате бар."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Бұл идентификатордың бақылау таңбалары қалған бөлігіне сәйкес келмейді, демек біреуінде қате бар."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Бұл өрнектің кластарын дайындауға тым көп уақыт кетеді. «^» арқылы жазылған немесе [一-鿿] сияқты мыңдаған таңбаны қамтитын класс бір өрнекте тек шектеулі рет кездесе алады: оларды азырақ немесе тарырақ етіп пайдаланыңыз."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "мысал схема көрсеткен бақылау сомасы тексеруінен өтпейді."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "мысал схеманың өз өрнегі қабылдайтын мән емес."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "«%(tag)s» тіл коды «%(written)s» түрінде жазылады."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "«%(tag)s» тілі «label» ішінде екі рет жазылған."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "LEI бақылау цифрлары сәйкес келмейді."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "тізім аяқталды, бірақ одан кейін тағы бір нәрсе тұр."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(tag)s» ішіндегі атау — қос тырнақшадағы, бір жолдағы, бос емес және ең көбі %(most)d таңбадан тұратын мәтін."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "өрнекті пайдалану мүмкін емес, қате орны — %(at)d-таңба. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "%(register)s тіркеу нөмірі мен %(corporates)s OpenCorporates идентификаторы әртүрлі юрисдикцияларды көрсетеді. Бірнеше юрисдикцияда тіркелген компания үшін бұл дұрыс болуы мүмкін."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "%(register)s тіркеу нөмірі мен %(corporates)s OpenCorporates идентификаторы бір юрисдикцияны, бірақ әртүрлі нөмірлерді көрсетеді."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "схемалар [ және ] арасында тізім ретінде жазылады."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "схемалардың ұзындығы ең көбі %(most)d таңба болуы мүмкін."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "мұнда қос тырнақшамен ашылған мәтін жабылмаған."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Мұның алдында ол санайтын ештеңе жоқ."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Бұл %(most)d таңбадан көп таңба сұрайды, ал одан ұзын идентификатор жоқ."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Бұл жақша жабылмаған."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Бұл класс бірде-бір таңбаны қабылдамайды."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Бұл ашылмаған жақшаны жабады."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "бұл JSON емес."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "бұл кілт — Postulo-ның өз схемаларының бірі, олар тек толықтырылады, ешқашан өзгертілмейді. Басқасын таңдаңыз."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "бұл кілтті жоғарыдағы схема пайдаланады."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Мұнан кейінгі бөлік осы бөлік те қабылдай алатын таңбадан басталуы мүмкін, сондықтан мәнді екі түрлі оқуға болады. Мұнда нақты қайталау санын көрсетіңіз немесе одан кейін бұл бөлік қабылдамайтын бөлгіш қойыңыз."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Postulo қандай сыртқы идентификаторларды түсінеді — ORCID, ISNI, Wikidata, заңды тұлға идентификаторы, компанияның тіркеу нөмірі — әрқайсысы қандай болуы керек, қайда сілтейді және адамды, ұйымды немесе екеуін де анықтай ма. Мұнда ештеңе желіден ізделмейді."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "«%(name)s» пайдалануға болмайды. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "«%(name)s» өрісінде %(half)s бар, бұл — таңбаның жартысы ғана, өз алдына мәтін емес. Көзделген таңбаны немесе оның екі жартысын да жазыңыз."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "«%(name)s» жетіспейді."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "«%(name)s» — схема көрсете алатын нәрсе емес. Схема мыналарды көрсете алады: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(name)s» — қос тырнақшадағы, бір жолдағы, бос емес және ең көбі %(most)d таңбадан тұратын мәтін."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "«%(name)s» мәні тырнақшасыз true немесе false болады."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "«%(name)s» екі рет жазылған."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "«%(tag)s» тіл коды емес. Тіл коды en-GB, fr-FR немесе pt-BR сияқты болады."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "«(?» осы тілде жоқ топты бастайды: ештеңе алға не артқа қарамайды және ешбір топтың атауы болмайды."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "«*» және «+» шексіз қайталайды, ал өрнек ең көбі неше рет екенін көрсетуі керек: {0,20} немесе {1,20} деп жазыңыз."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "«[^]» ештеңені шығарып тастамайды, сондықтан кез келген таңбаны білдіреді, ал бұл осы тілге кірмейді. Бос орыннан басқа кез келген таңба үшін [^ ] сияқты класс жазыңыз."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "«\\%(letter)s» осы тілге кірмейді. Атауы бар кластар: \\d — цифр және \\w — әріп, цифр немесе астын сызу таңбасы; тыныс белгісі алдындағы кері қиғаш сызық сол белгінің өзін білдіреді."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "«^» және «$» тек өрнектің екі шетінде ғана рұқсат етіледі, онда олар ештеңені өзгертпейді: өрнек әрқашан бүкіл мәнді сипаттайды."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "«checksum» Postulo білетін екі әдістің бірін атайды: ORCID соңындағы iso7064-mod11-2 немесе заңды тұлға идентификаторы соңындағы iso7064-mod97-10."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "«lower» енгізілген мәнді өрнек тексермес бұрын кіші әріптерге айналдырады, ал бұл өрнек кіші әріппен жазылған ештеңені қабылдамайды: схема ешбір мәнді қабылдамас еді. Өрнекті кіші әріптермен жазыңыз немесе «lower» параметрін алып тастаңыз."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "«pattern» — қос тырнақшадағы мәтін."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "«subjects» схеманың нені анықтайтынын тізімдейді: [\"person\"], [\"company\"] немесе [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "«upper» мен «lower» екеуі бірдей true бола алмайды."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "«upper» енгізілген мәнді өрнек тексермес бұрын бас әріптерге айналдырады, ал бұл өрнек бас әріппен жазылған ештеңені қабылдамайды: схема ешбір мәнді қабылдамас еді. Өрнекті бас әріптермен жазыңыз немесе «upper» параметрін алып тастаңыз."
