#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Paling banyak %(most)d skema dapat ditentukan di sini."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s akan ditolak hari ini: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Garis miring terbalik yang diikuti angka merujuk kembali ke apa yang dibaca sebelumnya, dan pola tidak dapat melakukan itu."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "titik dua tidak ada di antara nama dan isinya."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "ada koma setelah item terakhir. Hapus koma itu."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "koma tidak ada sebelum ini, atau kurung di atasnya tidak pernah ditutup."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Jumlah ulangan ditulis {3}, atau {2,5} dengan angka yang lebih kecil terlebih dahulu."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Jumlah ulangan memerlukan angka terbesar: {2,} berulang tanpa batas. Tulis {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Titik berarti karakter apa pun dalam ekspresi reguler, dan itu bukan bagian dari bahasa ini. Tulis “\\.” untuk titik, atau kelas seperti [^ ] untuk karakter apa pun selain spasi."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Grup tidak dapat diulang: “?” boleh mengikutinya, selain itu tidak boleh."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "kunci terdiri dari huruf kecil, angka, dan tanda hubung, di dalam tanda kutip ganda, diawali huruf atau angka, dan paling banyak %(most)d karakter."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "label adalah nama di dalam tanda kutip ganda, paling banyak %(most)d karakter, atau satu nama untuk setiap bahasa: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Tautan adalah teks di dalam tanda kutip ganda."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "nama tidak boleh memuat U+%(code)s, karakter yang tidak memakan ruang atau membalik arah teks: nama itu tidak akan terbaca seperti yang ditulis."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "nama harus berupa sesuatu yang dapat dilihat: nama ini hanya berisi karakter yang tidak digambar."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "nama di dalam tanda kutip ganda seharusnya dimulai di sini. Koma setelah item terakhir tidak diperbolehkan."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Pola tidak dapat kosong."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Pola tidak dapat diakhiri dengan garis miring terbalik."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Pola tidak dapat berisi pemisah baris, tab, atau karakter kontrol lainnya."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Pola paling panjang %(most)d karakter."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Pola paling banyak menawarkan %(most)d alternatif."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Rentang berjalan dari satu karakter ke karakter sesudahnya: “%(range)s” terbalik, atau tidak diakhiri dengan karakter."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "skema ditulis di antara { dan }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "nomor pegawai, nomor registrasi nasional"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "teks di dalam tanda kutip ganda tidak boleh melewati jeda baris atau memuat tab, jadi mungkin ada tanda kutip penutup yang hilang."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "nilai seharusnya dimulai di sini: teks di dalam tanda kutip ganda, daftar, objek, true, atau false. Koma setelah item terakhir tidak diperbolehkan."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Dan %(more)d masalah lain yang sejenis dalam skema ini."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Nomor registrasi perusahaan"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Pengenal eksternal"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "dalam “%(tag)s”, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON tidak mengenali apa yang mengikuti garis miring terbalik ini. Garis miring terbalik dalam pola ditulis dua kali: \\\\d untuk angka."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Pengenal badan hukum (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Baris %(line)d, kolom %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Baris %(line)d, nomor skema %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Baris %(line)d, skema “%(key)s”: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Baris %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Tidak ada yang dapat diulang lebih dari %(most)d kali: tidak ada pengenal yang lebih panjang dari itu."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Salah satu sisi “|” ini kosong."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Hanya satu jumlah ulangan yang boleh mengikuti karakter atau kelas: “{2}?”, “??”, dan “{2}+” bukan bagian dari bahasa ini."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Lainnya"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Tanda kurung biasa berisi pemisah tetap, yaitu karakter yang dicari apa adanya, dan tidak ada yang lain: tanpa kelas, tanpa jumlah ulangan, dan tanpa “|”."

#: src/postulo/plugins/identifiers/schemes.py
#, fuzzy
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Mulailah dengan kode dua huruf negara, lalu angka yang melewati angka cek negara itu."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Karakter terakhir ISNI itu tidak cocok dengan bagian lainnya, jadi salah satunya salah ketik."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Digit terakhir ORCID itu tidak cocok dengan bagian lainnya, jadi salah satunya salah ketik."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Karakter pemeriksa pengenal itu tidak cocok dengan bagian lainnya, jadi salah satunya salah ketik."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Kelas-kelas dalam pola ini terlalu lama untuk disiapkan bersama-sama. Kelas yang ditulis dengan “^”, atau yang mencakup ribuan karakter seperti [一-鿿], hanya dapat muncul beberapa kali dalam satu pola: gunakan lebih sedikit kelas, atau kelas yang lebih sempit."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "contoh tidak lolos checksum yang disebutkan skema."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "contoh bukan nilai yang diterima oleh polanya sendiri."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "kode bahasa “%(tag)s” ditulis “%(written)s”."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "bahasa “%(tag)s” ditulis dua kali dalam “label”."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Digit pemeriksa LEI tidak cocok."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "daftar sudah berakhir, tetapi ada sesuatu setelahnya."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "nama dalam “%(tag)s” adalah teks dalam tanda kutip ganda, dalam satu baris, tidak kosong, dan paling banyak %(most)d karakter."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "pola tidak dapat digunakan, pada karakter ke-%(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Nomor registrasi %(register)s dan ID OpenCorporates %(corporates)s menyebutkan yurisdiksi yang berbeda. Hal itu bisa benar untuk perusahaan yang terdaftar di lebih dari satu yurisdiksi."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Nomor registrasi %(register)s dan ID OpenCorporates %(corporates)s menyebutkan yurisdiksi yang sama tetapi nomor yang berbeda."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "skema ditulis sebagai daftar, di antara [ dan ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "skema paling banyak %(most)d karakter."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "teks yang dibuka dengan tanda kutip ganda di sini tidak pernah ditutup."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Tidak ada apa pun di depan ini yang dapat dihitungnya."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Ini meminta lebih dari %(most)d karakter, dan tidak ada pengenal yang lebih panjang dari itu."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Tanda kurung ini tidak pernah ditutup."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Kelas ini tidak menerima karakter apa pun."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Ini menutup tanda kurung yang tidak pernah dibuka."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "ini bukan JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "kunci ini adalah salah satu skema bawaan Postulo, yang hanya bertambah dan tidak pernah diubah. Pilih kunci lain."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "kunci ini sudah digunakan oleh skema di atasnya."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Bagian sesudahnya dapat diawali dengan karakter yang juga dapat diterima bagian ini, sehingga sebuah nilai dapat dibaca dengan dua cara. Beri bagian ini jumlah ulangan yang pasti, atau letakkan sesudahnya pemisah yang tidak dapat diterimanya."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Pengenal eksternal yang dipahami Postulo — ORCID, ISNI, Wikidata, pengenal badan hukum, nomor registrasi perusahaan — bentuk masing-masing, ke mana tautannya, dan apakah pengenal itu mengidentifikasi orang, organisasi, atau keduanya. Tidak ada yang pernah dicari secara daring di sini."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "“%(name)s” tidak dapat digunakan. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "“%(name)s” berisi %(half)s, yaitu setengah dari sebuah karakter dan bukan teks dengan sendirinya. Tulis karakter yang dimaksud, atau kedua bagiannya."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "“%(name)s” tidak ada."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "“%(name)s” bukan sesuatu yang dapat dinyatakan oleh skema. Skema dapat menyatakan: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(name)s” adalah teks dalam tanda kutip ganda, dalam satu baris, tidak kosong, dan paling banyak %(most)d karakter."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "“%(name)s” bernilai true atau false, tanpa tanda kutip."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "“%(name)s” ditulis dua kali."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "“%(tag)s” bukan kode bahasa. Kode bahasa berbentuk seperti en-GB, fr-FR, atau pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "“(?” memulai grup yang tidak ada dalam bahasa ini: tidak ada yang melihat ke depan atau ke belakang, dan tidak ada grup yang bernama."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "“*” dan “+” berulang tanpa batas, dan pola harus menyatakan berapa kali paling banyak: tulis {0,20} atau {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "“[^]” tidak mengecualikan apa pun, sehingga berarti karakter apa pun, dan itu bukan bagian dari bahasa ini. Tulis kelas seperti [^ ] untuk karakter apa pun selain spasi."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "“\\%(letter)s” bukan bagian dari bahasa ini. Kelas yang bernama adalah \\d, sebuah digit, dan \\w, sebuah huruf, digit, atau garis bawah; garis miring terbalik di depan tanda baca berarti tanda baca itu sendiri."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "“^” dan “$” hanya diizinkan di kedua ujung pola, dan di sana keduanya tidak mengubah apa pun: pola selalu menggambarkan seluruh nilai."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "“checksum” menyebut salah satu dari dua yang dikenal Postulo: iso7064-mod11-2, yang mengakhiri ORCID, atau iso7064-mod97-10, yang mengakhiri pengenal badan hukum (LEI)."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "“lower” mengubah apa yang diketik menjadi huruf kecil sebelum dicocokkan dengan pola, dan pola ini tidak menerima apa pun yang ditulis dalam huruf kecil: skema tidak akan menerima nilai apa pun. Tulis pola dalam huruf kecil, atau keluarkan “lower”."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "“pattern” adalah teks dalam tanda kutip ganda."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "“subjects” mencantumkan apa yang diidentifikasi skema: [\"person\"], [\"company\"], atau [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "“upper” dan “lower” tidak dapat keduanya bernilai true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "“upper” mengubah apa yang diketik menjadi huruf kapital sebelum dicocokkan dengan pola, dan pola ini tidak menerima apa pun yang ditulis dalam huruf kapital: skema tidak akan menerima nilai apa pun. Tulis pola dalam huruf kapital, atau keluarkan “upper”."
