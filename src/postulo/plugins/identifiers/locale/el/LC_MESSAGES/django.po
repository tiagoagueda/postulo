#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Εδώ μπορούν να οριστούν το πολύ %(most)d σχήματα."

#: src/postulo/plugins/identifiers/crosschecks.py
#, fuzzy, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s θα πρέπει να απορριφθεί σήμερα: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Μια ανάστροφη κάθετος και ένας αριθμός παραπέμπουν σε ό,τι διαβάστηκε νωρίτερα, και ένα μοτίβο δεν μπορεί να το κάνει αυτό."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "a colon is missing between a name and what it says."
msgstr "λείπει μια άνω και κάτω τελεία ανάμεσα σε ένα όνομα και σε ό,τι λέει."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "a comma follows the last item. Take it out."
msgstr "ένα κόμμα ακολουθεί το τελευταίο στοιχείο. Αφαιρέστε το."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "λείπει ένα κόμμα πριν από αυτό, ή μια αγκύλη πιο πάνω δεν έκλεισε ποτέ."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Ένας αριθμός επαναλήψεων γράφεται {3}, ή {2,5} με τον μικρότερο αριθμό πρώτο."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Ένας αριθμός επαναλήψεων χρειάζεται ανώτατο όριο: το {2,} επαναλαμβάνεται χωρίς όριο. Γράψτε {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Μια τελεία σημαίνει οποιονδήποτε χαρακτήρα σε μια κανονική έκφραση, και αυτό δεν ανήκει σε αυτή τη γλώσσα. Γράψτε «\\.» για τελεία, ή μια κλάση όπως [^ ] για οποιονδήποτε χαρακτήρα εκτός από κενό."

#: src/postulo/plugins/identifiers/patterns.py
#, fuzzy
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Μια ομάδα δεν μπορεί να επαναλαμβάνεται: μπορεί να την ακολουθεί το «?» και τίποτα άλλο."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "ένα κλειδί αποτελείται από πεζά γράμματα, ψηφία και παύλες, σε διπλά εισαγωγικά, αρχίζει με γράμμα ή ψηφίο, και έχει το πολύ %(most)d χαρακτήρες."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "μια ετικέτα είναι ένα όνομα σε διπλά εισαγωγικά, με το πολύ %(most)d χαρακτήρες, ή ένα όνομα για κάθε γλώσσα: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
#, fuzzy
