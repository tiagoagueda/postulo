#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Овде се може дефинисати највише %(most)d шема."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s данас би било одбијено: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Обрнута коса црта и број упућују на нешто прочитано раније, а образац то не може."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "недостаје двотачка између имена и онога што оно каже."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "иза последње ставке стоји зарез. Уклоните га."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "пре овога недостаје зарез или заграда отворена изнад никада није затворена."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Број понављања пише се {3} или {2,5}, са мањим бројем на првом месту."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Број понављања мора имати горњу границу: {2,} понавља без ограничења. Напишите {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Тачка у регуларном изразу значи било који знак, а то није део овог језика. Напишите „\\.“ за тачку или класу као што је [^ ] за било који знак осим размака."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Група се не може понављати: иза ње може стајати „?“ и ништа друго."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "кључ се састоји од малих слова, цифара и цртица, стоји у двоструким наводницима, почиње словом или цифром и има највише %(most)d знакова."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "ознака је име у двоструким наводницима, од највише %(most)d знакова, или по једно име за сваки језик: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Линк је текст у двоструким наводницима."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "име не може садржати U+%(code)s, знак који не заузима простор или окреће смер текста: име се не би читало онако како је написано."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "име мора бити нешто што се види: ово садржи само знакове који се не исцртавају."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "овде треба да почне име у двоструким наводницима. Зарез иза последње ставке није дозвољен."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Образац не може бити празан."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Образац се не може завршавати обрнутом косом цртом."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Образац не може садржати прелом реда, табулатор ни било који други контролни знак."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Образац има највише %(most)d знакова."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Образац нуди највише %(most)d алтернатива."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Опсег иде од једног знака до неког каснијег: „%(range)s“ је обрнут или се не завршава знаком."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "шема се пише између { и }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "број запосленог, број у националном регистру"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "текст у двоструким наводницима не може прелазити у нови ред нити садржати табулатор, па можда недостаје затварајући наводник."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "овде треба да почне вредност: текст у двоструким наводницима, листа, објекат, true или false. Зарез иза последње ставке није дозвољен."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "И још %(more)d проблем исте врсте у овој шеми."
msgstr[1] "И још %(more)d проблема исте врсте у овој шеми."
msgstr[2] "И још %(more)d проблема исте врсте у овој шеми."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Матични број компаније"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Спољни идентификатори"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "у „%(tag)s“, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON не зна шта следи иза ове обрнуте косе црте. Обрнута коса црта у обрасцу пише се двапут: \\\\d за цифру."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Идентификатор правног лица (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Ред %(line)d, колона %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Ред %(line)d, шема број %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Ред %(line)d, шема „%(key)s“: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Ред %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Ништа се не може поновити више од %(most)d пута: ниједан идентификатор није дужи од тога."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Једна страна овог „|“ је празна."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Иза знака или класе може стајати само један број понављања: „{2}?“, „??“ и „{2}+“ нису део овог језика."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Остале вештине"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Обле заграде садрже фиксни раздвајач, знакове који се траже такви какви јесу, и ништа друго: ни класу, ни број понављања, ни „|“."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Почните двословним кодом државе, а затим унесите број који пролази проверу контролне цифре те државе."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Последњи знак тог ISNI-ја не одговара остатку, па негде постоји грешка у куцању."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Последња цифра тог ORCID-а не одговара остатку, па негде постоји грешка у куцању."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Контролни знакови тог идентификатора не одговарају остатку, па негде постоји грешка у куцању."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Класе овог обрасца заједно се предуго припремају. Класа написана са „^“ или класа која обухвата хиљаде знакова, као што је [一-鿿], може се у једном обрасцу појавити само ограничен број пута: користите их мање или уже."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "пример не пролази проверу контролне суме коју шема наводи."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "пример није вредност коју прихвата сопствени образац шеме."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "код језика „%(tag)s“ пише се „%(written)s“."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "језик „%(tag)s“ наведен је двапут у „label“."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "Контролне цифре LEI-ја се не поклапају."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "листа се завршила, а иза ње нешто следи."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "име у „%(tag)s“ је текст у двоструким наводницима, у једном реду, није празно и има највише %(most)d знакова."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "образац се не може користити, код знака %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Матични број %(register)s и OpenCorporates ID %(corporates)s наводе различите јурисдикције. То може бити тачно за компанију регистровану у више њих."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Матични број %(register)s и OpenCorporates ID %(corporates)s наводе исту јурисдикцију, али различите бројеве."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "шеме се пишу као листа, између [ и ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "шеме могу имати највише %(most)d знакова."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "текст који овде почиње двоструким наводником никада није затворен."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Испред овога нема ничега што би се бројало."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Ово тражи више од %(most)d знакова, а ниједан идентификатор није дужи од тога."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Ова заграда никада није затворена."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Ова класа не обухвата ниједан знак."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Ово затвара заграду која никада није отворена."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "ово није JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "овај кључ припада једној од сопствених шема апликације Postulo, које се допуњују, али никада не мењају. Изаберите други."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "овај кључ већ користи једна шема изнад."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Оно што следи може почети знаком који би и ово могло да обухвати, па би се вредност могла прочитати на два начина. Задајте овоме тачан број понављања или иза њега ставите раздвајач који оно не може да обухвати."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Које спољне идентификаторе Postulo познаје — ORCID, ISNI, Wikidata, идентификатор правног лица, матични број компаније — како сваки треба да изгледа, куда води и да ли означава особу, организацију или обоје. Ништа од тога се никада не проверава на интернету."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "„%(name)s“ се не може користити. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "„%(name)s“ садржи %(half)s, што је половина знака и само по себи није текст. Напишите знак који је требало да буде или обе његове половине."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "„%(name)s“ недостаје."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "„%(name)s“ није нешто што шема може да наведе. Шема може да наведе: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "„%(name)s“ је текст у двоструким наводницима, у једном реду, није празан и има највише %(most)d знакова."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "„%(name)s“ је true или false, без наводника."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "„%(name)s“ је наведено двапут."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "„%(tag)s“ није код језика. Код језика изгледа као en-GB, fr-FR или pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "„(?“ почиње групу коју овај језик нема: ништа не гледа унапред ни уназад и ниједна група нема име."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "„*“ и „+“ понављају без ограничења, а образац мора да наведе највећи број понављања: напишите {0,20} или {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "„[^]“ ништа не изоставља, па значи било који знак, а то није део овог језика. Напишите класу као што је [^ ] за било који знак осим размака."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "„\\%(letter)s“ није део овог језика. Класе са именом су \\d, цифра, и \\w, слово, цифра или доња црта; обрнута коса црта испред интерпункцијског знака означава сам тај знак."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "„^“ и „$“ су дозвољени само на два краја обрасца, где ништа не мењају: образац увек описује целу вредност."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "„checksum“ наводи један од два која Postulo познаје: iso7064-mod11-2, којим се завршава ORCID, или iso7064-mod97-10, којим се завршава идентификатор правног лица."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "„lower“ претвара унето у мала слова пре провере обрасцем, а овај образац не прихвата ништа написано малим словима: шема не би прихватила ниједну вредност. Напишите образац малим словима или уклоните „lower“."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "„pattern“ је текст у двоструким наводницима."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "„subjects“ наводи шта шема идентификује: [\"person\"], [\"company\"] или [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "„upper“ и „lower“ не могу оба бити true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "„upper“ претвара унето у велика слова пре провере обрасцем, а овај образац не прихвата ништа написано великим словима: шема не би прихватила ниједну вредност. Напишите образац великим словима или уклоните „upper“."
