#: src/postulo/plugins/identifiers/custom.py
#, fuzzy, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Du kan definere høyst %(most)d identifikatortyper her."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s ville blitt avvist i dag: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "En omvendt skråstrek og et tall viser tilbake til noe som ble lest tidligere, og det kan ikke et mønster gjøre."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "et kolon mangler mellom et navn og det som står etter det."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "et komma står etter det siste elementet. Fjern det."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "et komma mangler foran dette, eller en parentes lenger opp ble aldri lukket."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Et antall skrives {3}, eller {2,5} med det minste tallet først."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Et antall trenger et høyeste tall: {2,} gjentas uten grense. Skriv {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Et punktum betyr et hvilket som helst tegn i et regulært uttrykk, og det er ikke en del av dette språket. Skriv «\\.» for et punktum, eller en klasse som [^ ] for et hvilket som helst tegn unntatt mellomrom."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "En gruppe kan ikke gjentas: «?» kan stå etter den, men ingenting annet."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "en nøkkel består av små bokstaver, sifre og bindestreker i doble anførselstegn, begynner med en bokstav eller et siffer og er på høyst %(most)d tegn."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "en etikett er et navn i doble anførselstegn på høyst %(most)d tegn, eller ett navn for hvert språk: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "En lenke er tekst i doble anførselstegn."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "et navn kan ikke inneholde U+%(code)s, et tegn som ikke tar plass eller snur teksten: navnet ville ikke leses slik det er skrevet."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "et navn må være noe som kan ses: dette inneholder bare tegn som ikke vises."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "et navn i doble anførselstegn skulle begynt her. Komma etter det siste elementet er ikke tillatt."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Et mønster kan ikke være tomt."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Et mønster kan ikke slutte med en omvendt skråstrek."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Et mønster kan ikke inneholde linjeskift, tabulator eller andre kontrolltegn."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Et mønster er på høyst %(most)d tegn."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Et mønster har høyst %(most)d alternativer."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Et område går fra ett tegn til et senere: «%(range)s» er feil vei, eller slutter ikke med et tegn."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "en identifikatortype skrives mellom { og }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "et ansattnummer, et nasjonalt registreringsnummer"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "en tekst i doble anførselstegn kan ikke gå over et linjeskift eller inneholde tabulator, så et avsluttende anførselstegn mangler kanskje."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "en verdi skulle begynt her: tekst i doble anførselstegn, en liste, et objekt, true eller false. Komma etter det siste elementet er ikke tillatt."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Og %(more)d problem til av samme slag i denne identifikatortypen."
msgstr[1] "Og %(more)d problemer til av samme slag i denne identifikatortypen."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Organisasjonsnummer"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Eksterne identifikatorer"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "i «%(tag)s», %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON vet ikke hva som følger etter denne omvendte skråstreken. En omvendt skråstrek i et mønster skrives to ganger: \\\\d for et siffer."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Legal Entity Identifier (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Linje %(line)d, kolonne %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Linje %(line)d, identifikatortype nummer %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Linje %(line)d, identifikatortype «%(key)s»: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Linje %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Ingenting kan gjentas mer enn %(most)d ganger: ingen identifikator er lenger enn det."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Den ene siden av denne «|» er tom."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Bare ett antall kan stå etter et tegn eller en klasse: «{2}?», «??» og «{2}+» er ikke en del av dette språket."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Andre ferdigheter"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Runde parenteser inneholder en fast skilletegnsekvens, tegn som skal finnes slik de er, og ingenting annet: ingen klasse, intet antall og ingen «|»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Begynn med landets tobokstavskode, deretter et nummer som består landets kontrollsiffer."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Det siste tegnet i den ISNI-en stemmer ikke med resten, så ett av dem er en skrivefeil."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Det siste sifferet i den ORCID-en stemmer ikke med resten, så ett av dem er en skrivefeil."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Kontrolltegnene i den identifikatoren stemmer ikke med resten av den, så ett av dem er en skrivefeil."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Klassene i dette mønsteret tar til sammen for lang tid å forberede. En klasse skrevet med «^», eller en som omfatter tusenvis av tegn, som [一-鿿], kan bare stå et begrenset antall ganger i ett mønster: bruk færre av dem, eller smalere."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "eksemplet består ikke kontrollsummen som identifikatortypen angir."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "eksemplet er ikke en verdi som dets eget mønster godtar."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "språkkoden «%(tag)s» skrives «%(written)s»."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "språket «%(tag)s» er skrevet to ganger i «label»."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "LEI-ens kontrollsifre stemmer ikke."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "listen er avsluttet, og noe kommer etter den."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "navnet i «%(tag)s» er tekst i doble anførselstegn, på én linje, ikke tom og på høyst %(most)d tegn."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "mønsteret kan ikke brukes, ved tegn %(at)d. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Registernummeret %(register)s og OpenCorporates-ID-en %(corporates)s angir ulike jurisdiksjoner. Det kan stemme for et selskap som er registrert i mer enn én."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Registernummeret %(register)s og OpenCorporates-ID-en %(corporates)s angir samme jurisdiksjon, men ulike numre."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "identifikatortypene skrives som en liste, mellom [ og ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "identifikatortypene kan være på høyst %(most)d tegn."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "teksten som begynner med et dobbelt anførselstegn her, blir aldri avsluttet."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Det finnes ingenting foran dette som det kan telle."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Dette ber om mer enn %(most)d tegn, og ingen identifikator er lengre enn det."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Denne parentesen blir aldri lukket."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Denne klassen omfatter ikke noe tegn i det hele tatt."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Dette lukker en parentes som aldri ble åpnet."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "dette er ikke JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "denne nøkkelen tilhører en av Postulos egne identifikatortyper, som bare legges til og aldri endres. Velg en annen."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "denne nøkkelen brukes av en identifikatortype lenger opp."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Det som kommer etter dette, kan begynne med et tegn som dette også kan omfatte, så en verdi kan leses på to måter. Gi dette et nøyaktig antall, eller sett et skilletegn etter det som det ikke kan omfatte."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Hvilke eksterne identifikatorer Postulo forstår (ORCID, ISNI, Wikidata, en identifikator for juridiske enheter, et organisasjonsnummer), hvordan hver enkelt skal se ut, hvor den lenker til, og om den identifiserer en person, en organisasjon eller begge deler. Ingenting her slås noen gang opp på nettet."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "«%(name)s» kan ikke brukes. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "«%(name)s» inneholder %(half)s, som er halvparten av et tegn og ikke tekst i seg selv. Skriv tegnet det skulle være, eller begge halvdelene."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "«%(name)s» mangler."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "«%(name)s» er ikke noe en identifikatortype kan angi. En identifikatortype kan angi: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "«%(name)s» er tekst i doble anførselstegn, på én linje, ikke tom og på høyst %(most)d tegn."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "«%(name)s» er true eller false, uten anførselstegn."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "«%(name)s» er skrevet to ganger."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "«%(tag)s» er ikke en språkkode. En språkkode ser ut som en-GB, fr-FR eller pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "«(?» innleder en gruppe dette språket ikke har: ingenting ser framover eller bakover, og ingen gruppe har navn."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "«*» og «+» gjentar uten grense, og et mønster må angi høyeste antall ganger: skriv {0,20} eller {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "«[^]» utelater ingenting, så det betyr et hvilket som helst tegn, og det er ikke en del av dette språket. Skriv en klasse som [^ ] for et hvilket som helst tegn unntatt mellomrom."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "«\\%(letter)s» er ikke en del av dette språket. Klassene med navn er \\d, et siffer, og \\w, en bokstav, et siffer eller et understrekingstegn; en omvendt skråstrek foran et skilletegn står for selve tegnet."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "«^» og «$» er bare tillatt i de to endene av et mønster, der de ikke endrer noe: et mønster beskriver alltid hele verdien."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "«checksum» angir en av de to Postulo kjenner: iso7064-mod11-2, som en ORCID slutter med, eller iso7064-mod97-10, som en identifikator for juridiske enheter slutter med."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "«lower» gjør det som ble skrevet, om til små bokstaver før mønsteret brukes, og dette mønsteret godtar ingenting skrevet med små bokstaver: identifikatortypen ville ikke godta noen verdi i det hele tatt. Skriv mønsteret med små bokstaver, eller fjern «lower»."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "«pattern» er tekst i doble anførselstegn."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "«subjects» viser hva identifikatortypen identifiserer: [\"person\"], [\"company\"] eller [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "«upper» og «lower» kan ikke begge være true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "«upper» gjør det som ble skrevet, om til store bokstaver før mønsteret brukes, og dette mønsteret godtar ingenting skrevet med store bokstaver: identifikatortypen ville ikke godta noen verdi i det hele tatt. Skriv mønsteret med store bokstaver, eller fjern «upper»."
