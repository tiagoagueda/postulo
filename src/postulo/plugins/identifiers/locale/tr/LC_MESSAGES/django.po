#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Burada en fazla %(most)d şema tanımlanabilir."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s bugün reddedilecektir: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Ters eğik çizgi ve bir sayı, daha önce okunan bir şeye geri başvurur; bir desen bunu yapamaz."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "bir ad ile değeri arasında iki nokta eksik."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "son öğeden sonra bir virgül var. Onu kaldırın."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "bundan önce bir virgül eksik ya da daha yukarıdaki bir parantez hiç kapatılmamış."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Bir tekrar sayısı {3} ya da küçük sayı önce gelecek şekilde {2,5} biçiminde yazılır."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Bir tekrar sayısının en büyük değeri olmalı: {2,} sınırsız tekrarlar. {2,20} yazın."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Düzenli ifadelerde nokta herhangi bir karakter anlamına gelir ve bu, bu dilin parçası değil. Nokta için “\\.” yazın; boşluk dışındaki herhangi bir karakter için [^ ] gibi bir sınıf yazın."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Bir grup tekrarlanamaz: ardından “?” gelebilir, başka hiçbir şey gelemez."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "anahtar; küçük harflerden, rakamlardan ve tirelerden oluşur, çift tırnak içinde yazılır, bir harf ya da rakamla başlar ve en fazla %(most)d karakterdir."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "etiket; çift tırnak içinde, en fazla %(most)d karakterlik bir ad ya da her dil için bir addır: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Bağlantı, çift tırnak içinde bir metindir."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "ad U+%(code)s karakterini içeremez; bu karakter yer kaplamaz ya da metnin yönünü çevirir: ad yazıldığı gibi okunmazdı."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "ad görülebilen bir şey olmalı: bu ad yalnızca çizilmeyen karakterlerden oluşuyor."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "burada çift tırnak içinde bir ad başlamalı. Son öğeden sonra virgül kullanılamaz."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Desen boş olamaz."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Desen ters eğik çizgiyle bitemez."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Desen satır sonu, sekme ya da başka bir denetim karakteri içeremez."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Desen en fazla %(most)d karakter uzunluğunda olabilir."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Bir desen en fazla %(most)d alternatif sunar."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Bir aralık bir karakterden daha sonraki bir karaktere uzanır: “%(range)s” ters yönde ya da bir karakterle bitmiyor."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "şema { ile } arasına yazılır."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "bir sicil numarası, bir ulusal kayıt"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "çift tırnak içindeki bir metin satır sonunu aşamaz ya da sekme içeremez, bu yüzden bir kapanış tırnağı eksik olabilir."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "burada bir değer başlamalı: çift tırnak içinde metin, bir liste, bir nesne, true ya da false. Son öğeden sonra virgül kullanılamaz."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Bu şemada aynı türden %(more)d sorun daha var."
msgstr[1] "Bu şemada aynı türden %(more)d sorun daha var."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Ticaret sicil numarası"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Dış tanımlayıcılar"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "“%(tag)s” içinde, %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON bu ters eğik çizgiden sonra geleni tanımıyor. Desendeki bir ters eğik çizgi iki kez yazılır: bir rakam için \\\\d."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Tüzel Kişi Tanımlayıcısı (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Satır %(line)d, sütun %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Satır %(line)d, şema numarası %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Satır %(line)d, “%(key)s” şeması: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Satır %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Hiçbir şey %(most)d kereden fazla tekrarlanamaz: hiçbir tanımlayıcı bundan uzun değildir."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Bu “|” işaretinin bir tarafı boş."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Bir karakterin ya da sınıfın ardından yalnızca bir tekrar sayısı gelebilir: “{2}?”, “??” ve “{2}+” bu dilin parçası değil."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Diğer beceriler"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Normal parantezler sabit bir ayırıcı, yani olduğu gibi aranacak karakterler içerir, başka hiçbir şey içermez: sınıf, tekrar sayısı ya da “|” olmaz."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Ülkenin iki harfli koduyla başlayın, ardından o ülkenin denetim basamağı kontrolünden geçen bir numara yazın."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Bu ISNI'nin son karakteri geri kalanıyla uyuşmuyor, yani birinde yazım hatası var."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "O ORCID'in son basamağı gerisiyle uyuşmuyor, yani birinde yazım hatası var."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Bu tanımlayıcının denetim karakterleri geri kalanıyla uyuşmuyor, yani birinde yazım hatası var."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Bu desenin sınıflarının hazırlanması toplamda çok uzun sürüyor. “^” ile yazılan ya da [一-鿿] gibi binlerce karakteri kapsayan bir sınıf bir desende ancak sınırlı sayıda kullanılabilir: daha az ya da daha dar sınıflar kullanın."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "örnek, şemanın belirttiği sağlama toplamı denetiminden geçmiyor."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "örnek, kendi deseninin kabul ettiği bir değer değil."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "“%(tag)s” dil kodu “%(written)s” olarak yazılır."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "“%(tag)s” dili “label” içinde iki kez yazılmış."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "LEI'nin denetim basamakları uyuşmuyor."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "liste bitti ama ardından bir şey geliyor."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(tag)s” içindeki ad; çift tırnak içinde, tek satırda, boş olmayan ve en fazla %(most)d karakterlik bir metindir."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "desen %(at)d. karakterde kullanılamıyor. %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "%(register)s sicil numarası ile %(corporates)s OpenCorporates kimliği farklı yargı bölgelerini belirtiyor. Birden fazla yerde kayıtlı bir şirket için bu doğru olabilir."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "%(register)s sicil numarası ile %(corporates)s OpenCorporates kimliği aynı yargı bölgesini ama farklı numaraları belirtiyor."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "şemalar [ ile ] arasında bir liste olarak yazılır."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "şemalar en fazla %(most)d karakter uzunluğunda olabilir."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "burada çift tırnakla açılan metin hiç kapatılmamış."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Bundan önce tekrarlanacak hiçbir şey yok."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Bu, %(most)d karakterden fazlasını istiyor ve hiçbir tanımlayıcı bundan uzun değildir."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Bu parantez hiç kapatılmamış."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Bu sınıf hiçbir karakteri kapsamıyor."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Bu, hiç açılmamış bir parantezi kapatıyor."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "bu JSON değil."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "bu anahtar Postulo'nun kendi şemalarından biri; bunlara yalnızca ekleme yapılır, hiçbir zaman değiştirilmezler. Başka bir anahtar seçin."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "bu anahtar daha yukarıdaki bir şema tarafından kullanılıyor."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Bundan sonra gelen kısım, bunun da alabileceği bir karakterle başlayabilir; bu yüzden bir değer iki şekilde okunabilir. Buna kesin bir tekrar sayısı verin ya da ardına bunun alamayacağı bir ayırıcı koyun."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Postulo'nun anladığı dış tanımlayıcılar — ORCID, ISNI, Wikidata, tüzel kişilik tanımlayıcısı, ticaret sicil numarası —, her birinin nasıl görünmesi gerektiği, nereye bağlandığı ve bir kişiyi mi, bir kuruluşu mu, yoksa ikisini de mi tanımladığı. Bunların hiçbiri hiçbir zaman çevrimiçi olarak aranmaz."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "“%(name)s” kullanılamıyor. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "“%(name)s”, %(half)s içeriyor; bu, bir karakterin yarısıdır ve tek başına metin değildir. Olması gereken karakteri ya da her iki yarısını yazın."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "“%(name)s” eksik."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "“%(name)s”, bir şemanın belirtebileceği bir şey değil. Bir şema şunları belirtebilir: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(name)s”; çift tırnak içinde, tek satırda, boş olmayan ve en fazla %(most)d karakterlik bir metindir."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "“%(name)s” tırnaksız olarak true ya da false olur."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "“%(name)s” iki kez yazılmış."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "“%(tag)s” bir dil kodu değil. Dil kodları en-GB, fr-FR ya da pt-BR gibi görünür."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "“(?” bu dilde olmayan bir grup başlatıyor: ileriye ya da geriye bakan bir şey yoktur ve hiçbir grubun adı olmaz."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "“*” ve “+” sınırsız tekrarlar; bir desen en fazla kaç kez olacağını belirtmelidir: {0,20} ya da {1,20} yazın."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "“[^]” hiçbir şeyi dışarıda bırakmaz, yani herhangi bir karakter anlamına gelir ve bu, bu dilin parçası değil. Boşluk dışındaki herhangi bir karakter için [^ ] gibi bir sınıf yazın."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "“\\%(letter)s” bu dilin bir parçası değil. Adı olan sınıflar şunlardır: \\d, bir rakam; \\w, bir harf, bir rakam veya alt çizgi. Bir noktalama işaretinden önce gelen ters eğik çizgi, işaretin kendisini ifade eder."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "“^” ve “$” yalnızca bir desenin iki ucunda kullanılabilir ve orada hiçbir şeyi değiştirmez: bir desen her zaman değerin tamamını tanımlar."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "“checksum”, Postulo'nun bildiği iki yöntemden birini belirtir: bir ORCID'in sonundaki iso7064-mod11-2 ya da bir tüzel kişilik tanımlayıcısının sonundaki iso7064-mod97-10."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "“lower”, girilen değeri desene sormadan önce küçük harfe çevirir ve bu desen küçük harfle yazılmış hiçbir şeyi kabul etmiyor: şema hiçbir değeri kabul etmezdi. Deseni küçük harflerle yazın ya da “lower” ayarını kaldırın."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "“pattern”, çift tırnak içinde bir metindir."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "“subjects”, şemanın neyi tanımladığını listeler: [\"person\"], [\"company\"] ya da [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "“upper” ve “lower” aynı anda true olamaz."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "“upper”, girilen değeri desene sormadan önce büyük harfe çevirir ve bu desen büyük harfle yazılmış hiçbir şeyi kabul etmiyor: şema hiçbir değeri kabul etmezdi. Deseni büyük harflerle yazın ya da “upper” ayarını kaldırın."
