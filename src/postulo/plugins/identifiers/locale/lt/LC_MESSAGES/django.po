#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "Didžiausias schemų, kurias čia galima apibrėžti, skaičius: %(most)d."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s šiandien būtų atmestas: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "Atvirkštinis brūkšnys su skaičiumi nurodo atgal į tai, kas nuskaityta anksčiau, o reiškinys to daryti negali."

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "trūksta dvitaškio tarp pavadinimo ir jo reikšmės."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "po paskutinio elemento yra kablelis. Pašalinkite jį."

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "prieš tai trūksta kablelio arba aukščiau esantis skliaustas nebuvo uždarytas."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "Kiekis rašomas {3} arba {2,5}, pirma mažesnis skaičius."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "Kiekiui reikia didžiausio skaičiaus: {2,} kartojasi be ribos. Rašykite {2,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "Reguliariajame reiškinyje taškas reiškia bet kurį simbolį, o tai nėra šios kalbos dalis. Taškui rašykite „\\.“, o bet kuriam simboliui, išskyrus tarpą, – klasę, pavyzdžiui, [^ ]."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "Grupė negali kartotis: po jos gali eiti „?“ ir nieko daugiau."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "raktą sudaro mažosios raidės, skaitmenys ir brūkšneliai dvigubose kabutėse; jis prasideda raide arba skaitmeniu ir yra ne ilgesnis kaip %(most)d simb."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "etiketė – tai pavadinimas dvigubose kabutėse, ne ilgesnis kaip %(most)d simb., arba po vieną pavadinimą kiekvienai kalbai: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "Nuoroda yra tekstas dvigubose kabutėse."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "pavadinime negali būti U+%(code)s – simbolio, kuris neužima vietos arba apgręžia tekstą: pavadinimas nebūtų skaitomas taip, kaip parašytas."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "pavadinimas turi būti matomas: šiame yra tik nematomi simboliai."

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "čia turėtų prasidėti pavadinimas dvigubose kabutėse. Kablelis po paskutinio elemento neleidžiamas."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "Reiškinys negali būti tuščias."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "Reiškinys negali baigtis atvirkštiniu brūkšniu."

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "Reiškinyje negali būti eilutės lūžio, tabuliacijos ar kito valdymo simbolio."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "Didžiausias reiškinio ilgis simboliais: %(most)d."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "Didžiausias alternatyvų skaičius reiškinyje: %(most)d."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "Intervalas eina nuo vieno simbolio iki vėlesnio: „%(range)s“ užrašytas atvirkščiai arba nesibaigia simboliu."

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "schema rašoma tarp { ir }."

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "darbuotojo numeris, nacionalinis registracijos numeris"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "tekstas dvigubose kabutėse negali tęstis per eilutės lūžį ar turėti tabuliacijos, todėl gali trūkti uždarančios kabutės."

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "čia turėtų prasidėti reikšmė: tekstas dvigubose kabutėse, sąrašas, objektas, true arba false. Kablelis po paskutinio elemento neleidžiamas."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "Ir dar %(more)d tos pačios rūšies problema šioje schemoje."
msgstr[1] "Ir dar %(more)d tos pačios rūšies problemos šioje schemoje."
msgstr[2] "Ir dar %(more)d tos pačios rūšies problemų šioje schemoje."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "Įmonės kodas"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "Išoriniai identifikatoriai"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "„%(tag)s“: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON nežino, kas eina po šio atvirkštinio brūkšnio. Reguliariajame reiškinyje atvirkštinis brūkšnys rašomas du kartus: \\\\d – skaitmuo."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "Juridinio asmens identifikatorius (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "Eilutė %(line)d, stulpelis %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "Eilutė %(line)d, schemos numeris %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "Eilutė %(line)d, schema „%(key)s“: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "Eilutė %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "Didžiausias kartojimų skaičius: %(most)d – joks identifikatorius nėra ilgesnis."

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "Viena „|“ pusė tuščia."

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "Po simbolio ar klasės gali eiti tik vienas kiekis: „{2}?“, „??“ ir „{2}+“ nėra šios kalbos dalis."

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "Kita"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "Apvaliuosiuose skliaustuose rašomas tik pastovus skyriklis – simboliai, ieškomi tokie, kokie yra, ir nieko daugiau: jokios klasės, kiekio ar „|“."

#: src/postulo/plugins/identifiers/schemes.py
#, fuzzy
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "Pradėkite nuo šalies dviejų raidžių kodo, tada skaičius, kuris atitinka tos šalies kontrolinį skaitmenį."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "Paskutinis šio ISNI simbolis neatitinka likusių, todėl kažkur yra rašybos klaida."

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "Paskutinis šio ORCID skaitmuo neatitinka likusių, todėl kažkur yra rašybos klaida."

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "Šio identifikatoriaus kontroliniai simboliai nesutampa su likusia jo dalimi, todėl kažkuris simbolis įvestas klaidingai."

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "Šio reiškinio klasių paruošimas kartu užtrunka per ilgai. Klasė, parašyta su „^“, arba klasė, apimanti tūkstančius simbolių, pavyzdžiui, [一-鿿], viename reiškinyje gali būti tik ribotą skaičių kartų: naudokite jų mažiau arba siauresnes."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "pavyzdys neatitinka schemos nurodytos kontrolinės sumos."

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "pavyzdys nėra reikšmė, kurią priima jo paties reiškinys."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "kalbos kodas „%(tag)s“ rašomas „%(written)s“."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "kalba „%(tag)s“ lauke „label“ nurodyta du kartus."

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "LEI kontroliniai skaitmenys nesutampa."

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "sąrašas baigėsi, bet po jo dar kažkas yra."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "„%(tag)s“ pavadinimas turi būti netuščias tekstas dvigubose kabutėse, vienoje eilutėje, ne ilgesnis kaip %(most)d simb."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "reiškinio negalima naudoti (ties simboliu Nr. %(at)d). %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "Registro numeris %(register)s ir OpenCorporates ID %(corporates)s nurodo skirtingas jurisdikcijas. Tai gali būti teisinga, jei įmonė registruota daugiau nei vienoje."

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "Registro numeris %(register)s ir OpenCorporates ID %(corporates)s nurodo tą pačią jurisdikciją, bet skirtingus numerius."

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "schemos rašomos kaip sąrašas tarp [ ir ]."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "schemų tekstas gali būti ne ilgesnis kaip %(most)d simb."

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "čia dvigubomis kabutėmis prasidedantis tekstas niekur neuždaromas."

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "Prieš šį kiekį nėra nieko, kam jis būtų taikomas."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "Čia reikalaujama daugiau simbolių nei %(most)d, o joks identifikatorius nėra toks ilgas."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "Šis skliaustas niekur neuždarytas."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "Ši klasė nepriima jokio simbolio."

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "Šis skliaustas uždaro skliaustą, kuris nebuvo atidarytas."

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "tai nėra JSON."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "šis raktas yra viena iš Postulo schemų, kurios pridedamos ir niekada nekeičiamos. Pasirinkite kitą."

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "šį raktą naudoja aukščiau esanti schema."

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "Tai, kas eina po šito, gali prasidėti simboliu, kurį galėtų priimti ir šitas, todėl reikšmę būtų galima nuskaityti dviem būdais. Nurodykite tikslų kiekį arba po šito įdėkite skyriklį, kurio jis negali priimti."

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Kuriuos išorinius identifikatorius supranta Postulo – ORCID, ISNI, Wikidata, juridinio asmens identifikatorių, įmonės kodą, – kaip kiekvienas turėtų atrodyti, kur veda jo nuoroda ir ar jis identifikuoja asmenį, organizaciją ar abu. Niekas iš to niekada netikrinama internete."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "„%(name)s“ negalima naudoti. %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "„%(name)s“ reikšmėje yra %(half)s – pusė simbolio, kuri pati savaime nėra tekstas. Parašykite simbolį, kuris turėjo būti, arba abi jo puses."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "„%(name)s“ trūksta."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "„%(name)s“ nėra tai, ką schema gali nurodyti. Schema gali nurodyti: %(names)s."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "„%(name)s“ – tai netuščias tekstas dvigubose kabutėse, vienoje eilutėje; daugiausia simbolių: %(most)d."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "„%(name)s“ yra true arba false, be kabučių."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "„%(name)s“ parašyta du kartus."

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "„%(tag)s“ nėra kalbos kodas. Kalbos kodas atrodo taip: en-GB, fr-FR ar pt-BR."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "„(?“ pradeda grupę, kurios ši kalba neturi: niekas nežiūri į priekį ar atgal, ir jokia grupė neturi pavadinimo."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "„*“ ir „+“ kartoja be ribos, o reiškinys turi nurodyti, kiek daugiausia kartų: rašykite {0,20} arba {1,20}."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "„[^]“ nieko neatmeta, todėl reiškia bet kurį simbolį, ir tai nėra šios kalbos dalis. Rašykite klasę, pavyzdžiui, [^ ] – bet kuriam simboliui, išskyrus tarpą."

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "„\\%(letter)s“ nėra šios kalbos dalis. Klasės su pavadinimu yra \\d – skaitmuo ir \\w – raidė, skaitmuo ar apatinis brūkšnys; atvirkštinis brūkšnys prieš skyrybos ženklą reiškia patį ženklą."

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "„^“ ir „$“ leidžiami tik abiejuose reiškinio galuose, kur nieko nekeičia: reiškinys visada apibūdina visą reikšmę."

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "„checksum“ nurodo vieną iš dviejų Postulo žinomų kontrolinių sumų: iso7064-mod11-2, kuria baigiasi ORCID, arba iso7064-mod97-10, kuria baigiasi juridinio asmens identifikatorius."

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "„lower“ paverčia įvestą tekstą mažosiomis raidėmis prieš tikrinant jį pagal reiškinį, o šis reiškinys nepriima nieko, kas parašyta mažosiomis raidėmis: schema nepriimtų jokios reikšmės. Parašykite reiškinį mažosiomis raidėmis arba pašalinkite „lower“."

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "„pattern“ yra tekstas dvigubose kabutėse."

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "„subjects“ išvardija, ką schema identifikuoja: [\"person\"], [\"company\"] arba [\"person\", \"company\"]."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "„upper“ ir „lower“ negali būti abu true."

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "„upper“ paverčia įvestą tekstą didžiosiomis raidėmis prieš tikrinant jį pagal reiškinį, o šis reiškinys nepriima nieko, kas parašyta didžiosiomis raidėmis: schema nepriimtų jokios reikšmės. Parašykite reiškinį didžiosiomis raidėmis arba pašalinkite „upper“."
