#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "%(most)d schemes can be defined here at most."
msgstr "یہاں زیادہ سے زیادہ %(most)d اسکیمیں متعین کی جا سکتی ہیں۔"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "%(scheme)s %(value)s would be refused today: %(reason)s"
msgstr "%(scheme)s %(value)s آج مسترد کر دیا جاتا: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A backslash and a number refer back to what was read earlier, and a pattern cannot do that."
msgstr "بیک سلیش اور اس کے بعد عدد پہلے پڑھی گئی چیز کا حوالہ دیتے ہیں، اور پیٹرن ایسا نہیں کر سکتا۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a colon is missing between a name and what it says."
msgstr "کسی نام اور اس کی قدر کے درمیان کالن غائب ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma follows the last item. Take it out."
msgstr "آخری آئٹم کے بعد کوما ہے۔ اسے ہٹا دیں۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a comma is missing before this, or a bracket further up was never closed."
msgstr "اس سے پہلے کوما غائب ہے، یا اوپر کوئی بریکٹ کبھی بند نہیں ہوئی۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count is written {3}, or {2,5} with the smaller number first."
msgstr "گنتی {3} لکھی جاتی ہے، یا {2,5}، چھوٹا عدد پہلے۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A count needs a largest number: {2,} repeats without a limit. Write {2,20}."
msgstr "گنتی کے لیے ایک سب سے بڑا عدد ضروری ہے: {2,} بغیر حد کے دہراتا ہے۔ {2,20} لکھیں۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A full stop means any character in a regular expression, and that is not part of this language. Write “\\.” for a full stop, or a class such as [^ ] for any character but a space."
msgstr "ریگولر ایکسپریشن میں نقطے کا مطلب کوئی بھی حرف ہوتا ہے، اور یہ اس زبان کا حصہ نہیں۔ نقطے کے لیے “\\.” لکھیں، یا اسپیس کے سوا کسی بھی حرف کے لیے [^ ] جیسی کلاس۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A group cannot repeat: “?” may follow it, and nothing else may."
msgstr "گروپ دہرایا نہیں جا سکتا: اس کے بعد “?” آ سکتا ہے، اور کچھ نہیں۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a key is lower-case letters, digits and hyphens, in double quotes, beginning with a letter or a digit, and %(most)d characters at most."
msgstr "کلید چھوٹے حروف، ہندسوں اور ہائفن پر مشتمل ہوتی ہے، ڈبل کوٹس میں، کسی حرف یا ہندسے سے شروع ہوتی ہے، اور زیادہ سے زیادہ %(most)d حروف کی ہوتی ہے۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a label is a name in double quotes, %(most)d characters at most, or one name for each language: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}."
msgstr "لیبل ڈبل کوٹس میں ایک نام ہوتا ہے، زیادہ سے زیادہ %(most)d حروف، یا ہر زبان کے لیے ایک نام: {\"en-GB\": \"Staff number\", \"pt-PT\": \"Número de funcionário\"}۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "A link is text in double quotes."
msgstr "لنک ڈبل کوٹس میں متن ہوتا ہے۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "a name cannot hold U+%(code)s, a character that takes no room or turns the text around: the name would not read as it is written."
msgstr "نام میں U+%(code)s نہیں ہو سکتا، یہ ایسا حرف ہے جو کوئی جگہ نہیں لیتا یا متن کا رخ پلٹ دیتا ہے: نام ویسا نہیں پڑھا جائے گا جیسا لکھا گیا ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a name has to be something that can be seen: this one holds only characters that are not drawn."
msgstr "نام ایسی چیز ہونی چاہیے جو دکھائی دے: اس میں صرف ایسے حروف ہیں جو نظر نہیں آتے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a name in double quotes should begin here. A comma after the last item is not allowed."
msgstr "یہاں ڈبل کوٹس میں ایک نام شروع ہونا چاہیے۔ آخری آئٹم کے بعد کوما کی اجازت نہیں۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot be empty."
msgstr "پیٹرن خالی نہیں ہو سکتا۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot end in a backslash."
msgstr "پیٹرن بیک سلیش پر ختم نہیں ہو سکتا۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "A pattern cannot hold a line break, a tab or any other control character."
msgstr "پیٹرن میں لائن بریک، ٹیب یا کوئی اور کنٹرول حرف نہیں ہو سکتا۔"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern is %(most)d characters long at most."
msgstr "پیٹرن زیادہ سے زیادہ %(most)d حروف لمبا ہو سکتا ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A pattern offers %(most)d alternatives at most."
msgstr "پیٹرن زیادہ سے زیادہ %(most)d متبادل پیش کر سکتا ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "A range runs from one character to a later one: “%(range)s” is the wrong way round, or does not end in a character."
msgstr "رینج ایک حرف سے بعد والے کسی حرف تک جاتی ہے: “%(range)s” الٹی ہے، یا کسی حرف پر ختم نہیں ہوتی۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a scheme is written between { and }."
msgstr "اسکیم { اور } کے درمیان لکھی جاتی ہے۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "a staff number, a national registration"
msgstr "اسٹاف نمبر، قومی رجسٹریشن"

#: src/postulo/plugins/identifiers/custom.py
msgid "a text in double quotes cannot run over a line break or hold a tab, so a closing quote may be missing."
msgstr "ڈبل کوٹس میں متن لائن بریک سے آگے نہیں جا سکتا اور نہ اس میں ٹیب ہو سکتا ہے، اس لیے شاید بند کرنے والا کوٹ غائب ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "a value should begin here: text in double quotes, a list, an object, true or false. A comma after the last item is not allowed."
msgstr "یہاں ایک قدر شروع ہونی چاہیے: ڈبل کوٹس میں متن، فہرست، آبجیکٹ، true یا false۔ آخری آئٹم کے بعد کوما کی اجازت نہیں۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "And %(more)d more problem of the same kind in this scheme."
msgid_plural "And %(more)d more problems of the same kind in this scheme."
msgstr[0] "اور اس اسکیم میں اسی قسم کا %(more)d مزید مسئلہ۔"
msgstr[1] "اور اس اسکیم میں اسی قسم کے %(more)d مزید مسائل۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "Company register number"
msgstr "کمپنی رجسٹر نمبر"

#: src/postulo/plugins/identifiers/__init__.py
msgid "External identifiers"
msgstr "بیرونی شناخت کنندگان"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "in “%(tag)s”, %(reason)s"
msgstr "“%(tag)s” میں، %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
msgid "JSON does not know what follows this backslash. A backslash in a pattern is written twice: \\\\d for a digit."
msgstr "JSON نہیں جانتا کہ اس بیک سلیش کے بعد کیا ہے۔ پیٹرن میں بیک سلیش دو بار لکھا جاتا ہے: ہندسے کے لیے \\\\d۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "Legal Entity Identifier (LEI)"
msgstr "قانونی ادارے کا شناخت کنندہ (LEI)"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, column %(column)d: %(reason)s"
msgstr "سطر %(line)d، کالم %(column)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme number %(number)d: %(reason)s"
msgstr "سطر %(line)d، اسکیم نمبر %(number)d: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d, scheme “%(key)s”: %(reason)s"
msgstr "سطر %(line)d، اسکیم “%(key)s”: %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "Line %(line)d: %(reason)s"
msgstr "سطر %(line)d: %(reason)s"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "Nothing can be repeated more than %(most)d times: no identifier is longer than that."
msgstr "کسی چیز کو %(most)d بار سے زیادہ نہیں دہرایا جا سکتا: کوئی شناخت کنندہ اس سے لمبا نہیں ہوتا۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "One side of this “|” is empty."
msgstr "اس “|” کی ایک طرف خالی ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Only one count may follow a character or a class: “{2}?”, “??” and “{2}+” are not part of this language."
msgstr "کسی حرف یا کلاس کے بعد صرف ایک گنتی آ سکتی ہے: “{2}?”، “??” اور “{2}+” اس زبان کا حصہ نہیں۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "Other"
msgstr "دیگر"

#: src/postulo/plugins/identifiers/schemes.py
msgid "PT 501234567, FR 552081317, DE HRB 12345"
msgstr "PT 501234567, FR 552081317, DE HRB 12345"

#: src/postulo/plugins/identifiers/patterns.py
msgid "Round brackets hold a fixed separator, characters to be found as they are, and nothing else: no class, no count and no “|”."
msgstr "گول بریکٹس میں ایک مقررہ جداکار ہوتا ہے، یعنی ایسے حروف جو جوں کے توں تلاش کیے جائیں، اور کچھ نہیں: نہ کلاس، نہ گنتی اور نہ “|”۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "Start with the country's two-letter code, then a number that passes that country's check digit."
msgstr "ملک کے دو حرفی کوڈ سے شروع کریں، پھر ایک ایسا نمبر جو اس ملک کے چیک ہندسے پر پورا اترے۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ISNI's last character does not match the rest, so one of them is a typo."
msgstr "اس ISNI کا آخری حرف باقی سے مطابقت نہیں رکھتا، اس لیے ان میں سے کسی ایک میں ٹائپنگ کی غلطی ہے۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "That ORCID's last digit does not match the rest, so one of them is a typo."
msgstr "اس ORCID کا آخری ہندسہ باقی سے مطابقت نہیں رکھتا، اس لیے ان میں سے کسی ایک میں ٹائپنگ کی غلطی ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "The check characters of that identifier do not match the rest of it, so one of them is a typo."
msgstr "اس شناخت کنندہ کے چیک حروف اس کے باقی حصے سے مطابقت نہیں رکھتے، اس لیے ان میں سے کسی ایک میں ٹائپنگ کی غلطی ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "The classes of this pattern take too long to prepare between them. A class written with “^”, or one that takes thousands of characters such as [一-鿿], can stand in one pattern only so many times: use fewer of them, or narrower ones."
msgstr "اس پیٹرن کی کلاسیں مل کر تیار ہونے میں بہت زیادہ وقت لیتی ہیں۔ “^” کے ساتھ لکھی گئی کلاس، یا ہزاروں حروف لینے والی کلاس جیسے [一-鿿]، ایک پیٹرن میں صرف محدود بار آ سکتی ہے: ان میں سے کم استعمال کریں، یا تنگ تر کلاسیں۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "the example does not pass the checksum the scheme names."
msgstr "مثال اس چیک سم پر پوری نہیں اترتی جس کا اسکیم نام لیتی ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "the example is not a value its own pattern accepts."
msgstr "مثال ایسی قدر نہیں جسے اس کا اپنا پیٹرن قبول کرے۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language code “%(tag)s” is written “%(written)s”."
msgstr "زبان کا کوڈ “%(tag)s” اس طرح لکھا جاتا ہے: “%(written)s”۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the language “%(tag)s” is written twice in “label”."
msgstr "زبان “%(tag)s” “label” میں دو بار لکھی گئی ہے۔"

#: src/postulo/plugins/identifiers/schemes.py
msgid "The LEI's check digits do not match."
msgstr "LEI کے چیک ہندسے مطابقت نہیں رکھتے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "the list has ended, and something follows it."
msgstr "فہرست ختم ہو چکی ہے، اور اس کے بعد بھی کچھ موجود ہے۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the name in “%(tag)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(tag)s” میں نام ڈبل کوٹس میں لکھا متن ہے، ایک سطر میں، خالی نہیں اور زیادہ سے زیادہ %(most)d حروف کا۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the pattern cannot be used, at character %(at)d. %(reason)s"
msgstr "پیٹرن استعمال نہیں کیا جا سکتا، حرف %(at)d پر۔ %(reason)s"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name different jurisdictions. That can be right for a company registered in more than one."
msgstr "رجسٹر نمبر %(register)s اور OpenCorporates id %(corporates)s مختلف دائرہ ہائے اختیار بتاتے ہیں۔ یہ ایسی کمپنی کے لیے درست ہو سکتا ہے جو ایک سے زیادہ میں رجسٹرڈ ہو۔"

#: src/postulo/plugins/identifiers/crosschecks.py
#, python-format
msgid "The register number %(register)s and the OpenCorporates id %(corporates)s name the same jurisdiction but different numbers."
msgstr "رجسٹر نمبر %(register)s اور OpenCorporates id %(corporates)s ایک ہی دائرۂ اختیار لیکن مختلف نمبر بتاتے ہیں۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "the schemes are written as a list, between [ and ]."
msgstr "اسکیمیں ایک فہرست کے طور پر [ اور ] کے درمیان لکھی جاتی ہیں۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "the schemes can be %(most)d characters long at most."
msgstr "اسکیمیں زیادہ سے زیادہ %(most)d حروف طویل ہو سکتی ہیں۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "the text that opens with a double quote here is never closed."
msgstr "یہاں ڈبل کوٹ سے شروع ہونے والا متن کبھی بند نہیں ہوتا۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "There is nothing before this for it to count."
msgstr "اس سے پہلے کچھ نہیں جسے یہ گن سکے۔"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "This asks for more than %(most)d characters, and no identifier is longer than that."
msgstr "یہ %(most)d سے زیادہ حروف مانگتا ہے، اور کوئی شناخت کنندہ اس سے لمبا نہیں ہوتا۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "This bracket is never closed."
msgstr "یہ بریکٹ کبھی بند نہیں ہوتی۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "This class takes no character at all."
msgstr "یہ کلاس کوئی بھی حرف قبول نہیں کرتی۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "This closes a bracket that was never opened."
msgstr "یہ ایک ایسی بریکٹ بند کرتا ہے جو کبھی کھولی ہی نہیں گئی۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "this is not JSON."
msgstr "یہ JSON نہیں ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is one of Postulo's own schemes, which are added to and never changed. Choose another."
msgstr "یہ کلید Postulo کی اپنی اسکیموں میں سے ایک ہے، جن میں اضافہ تو ہوتا ہے لیکن تبدیلی کبھی نہیں۔ کوئی اور منتخب کریں۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "this key is used by a scheme further up."
msgstr "یہ کلید اوپر کی ایک اسکیم پہلے ہی استعمال کر رہی ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "What comes after this can begin with a character this could take as well, so a value could be read in two ways. Give this an exact count, or put a separator after it that it cannot take."
msgstr "اس کے بعد آنے والی چیز ایسے حرف سے شروع ہو سکتی ہے جسے یہ بھی لے سکتا ہے، اس لیے کوئی قدر دو طرح سے پڑھی جا سکتی ہے۔ اسے ایک قطعی گنتی دیں، یا اس کے بعد ایسا جداکار رکھیں جسے یہ نہ لے سکے۔"

#: src/postulo/plugins/identifiers/__init__.py
msgid "Which external identifiers Postulo understands — ORCID, ISNI, Wikidata, a legal-entity identifier, a company register number — what each one should look like, where it links, and whether it identifies a person, an organisation or both. Nothing here is ever looked up online."
msgstr "Postulo کون سے بیرونی شناخت کنندگان سمجھتا ہے — ORCID، ISNI، Wikidata، قانونی ادارے کا شناخت کنندہ، کمپنی رجسٹر نمبر — ہر ایک کیسا دکھائی دینا چاہیے، یہ کہاں لنک کرتا ہے، اور آیا یہ کسی شخص، کسی تنظیم یا دونوں کی شناخت کرتا ہے۔ یہاں کی کوئی بھی چیز کبھی آن لائن تلاش نہیں کی جاتی۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” cannot be used. %(reason)s"
msgstr "“%(name)s” استعمال نہیں کیا جا سکتا۔ %(reason)s"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” holds %(half)s, which is half of a character and not text by itself. Write the character it was meant to be, or both of its halves."
msgstr "“%(name)s” میں %(half)s ہے، جو ایک حرف کا آدھا حصہ ہے اور بذاتِ خود متن نہیں۔ وہ حرف لکھیں جو مقصود تھا، یا اس کے دونوں حصے۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is missing."
msgstr "“%(name)s” موجود نہیں۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is not something a scheme can say. A scheme can say: %(names)s."
msgstr "“%(name)s” ایسی چیز نہیں جو اسکیم بیان کر سکے۔ اسکیم یہ بیان کر سکتی ہے: %(names)s۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is text in double quotes, on one line, with something in it and %(most)d characters at most."
msgstr "“%(name)s” ڈبل کوٹس میں لکھا متن ہے، ایک سطر میں، خالی نہیں اور زیادہ سے زیادہ %(most)d حروف کا۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is true or false, without quotes."
msgstr "“%(name)s” کی قدر true یا false ہوتی ہے، کوٹس کے بغیر۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(name)s” is written twice."
msgstr "“%(name)s” دو بار لکھا گیا ہے۔"

#: src/postulo/plugins/identifiers/custom.py
#, python-format
msgid "“%(tag)s” is not a language code. One looks like en-GB, fr-FR or pt-BR."
msgstr "“%(tag)s” زبان کا کوڈ نہیں۔ زبان کا کوڈ en-GB، fr-FR یا pt-BR جیسا ہوتا ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "“(?” begins a group this language does not have: nothing looks ahead or behind, and no group has a name."
msgstr "“(?” ایک ایسا گروپ شروع کرتا ہے جو اس زبان میں نہیں ہے: کچھ بھی آگے یا پیچھے نہیں دیکھتا، اور کسی گروپ کا نام نہیں ہوتا۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "“*” and “+” repeat without a limit, and a pattern has to say how many times at the most: write {0,20} or {1,20}."
msgstr "“*” اور “+” بغیر حد کے دہراتے ہیں، اور پیٹرن کو بتانا ہوتا ہے کہ زیادہ سے زیادہ کتنی بار: {0,20} یا {1,20} لکھیں۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "“[^]” leaves nothing out, so it means any character, and that is not part of this language. Write a class such as [^ ] for any character but a space."
msgstr "“[^]” کچھ بھی باہر نہیں چھوڑتی، اس لیے اس کا مطلب کوئی بھی حرف ہے، اور یہ اس زبان کا حصہ نہیں۔ اسپیس کے سوا کسی بھی حرف کے لیے [^ ] جیسی کلاس لکھیں۔"

#: src/postulo/plugins/identifiers/patterns.py
#, python-format
msgid "“\\%(letter)s” is not part of this language. The classes with a name are \\d, a digit, and \\w, a letter, a digit or an underscore; a backslash before a punctuation mark stands for the mark itself."
msgstr "“\\%(letter)s” اس زبان کا حصہ نہیں۔ نام والی کلاسیں \\d، یعنی ایک ہندسہ، اور \\w، یعنی ایک حرف، ایک ہندسہ یا ایک انڈر اسکور ہیں؛ کسی رموزِ اوقاف کی علامت سے پہلے بیک سلیش خود اسی علامت کی نمائندگی کرتا ہے۔"

#: src/postulo/plugins/identifiers/patterns.py
msgid "“^” and “$” are allowed only at the two ends of a pattern, where they change nothing: a pattern always describes the whole value."
msgstr "“^” اور “$” کی اجازت صرف پیٹرن کے دونوں سروں پر ہے، جہاں یہ کچھ نہیں بدلتے: پیٹرن ہمیشہ پوری قدر کو بیان کرتا ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "“checksum” names one of the two Postulo knows: iso7064-mod11-2, which an ORCID ends in, or iso7064-mod97-10, which a legal-entity identifier ends in."
msgstr "“checksum” ان دو میں سے ایک کا نام لیتا ہے جنہیں Postulo جانتا ہے: iso7064-mod11-2، جس پر ORCID ختم ہوتا ہے، یا iso7064-mod97-10، جس پر قانونی ادارے کا شناخت کنندہ ختم ہوتا ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "“lower” puts what was typed into small letters before the pattern is asked, and this pattern takes nothing written in small letters: the scheme would accept no value at all. Write the pattern in small letters, or take “lower” out."
msgstr "“lower” پیٹرن سے پوچھنے سے پہلے ٹائپ کی گئی چیز کو چھوٹے حروف میں بدل دیتا ہے، اور یہ پیٹرن چھوٹے حروف میں لکھی کوئی چیز قبول نہیں کرتا: اسکیم کوئی بھی قدر قبول نہیں کرے گی۔ پیٹرن چھوٹے حروف میں لکھیں، یا “lower” ہٹا دیں۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "“pattern” is text in double quotes."
msgstr "“pattern” ڈبل کوٹس میں متن ہوتا ہے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "“subjects” lists what the scheme identifies: [\"person\"], [\"company\"] or [\"person\", \"company\"]."
msgstr "“subjects” بتاتا ہے کہ اسکیم کس کی شناخت کرتی ہے: [\"person\"]، [\"company\"] یا [\"person\", \"company\"]۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” and “lower” cannot both be true."
msgstr "“upper” اور “lower” دونوں true نہیں ہو سکتے۔"

#: src/postulo/plugins/identifiers/custom.py
msgid "“upper” puts what was typed into capitals before the pattern is asked, and this pattern takes nothing written in capitals: the scheme would accept no value at all. Write the pattern in capitals, or take “upper” out."
msgstr "“upper” پیٹرن سے پوچھنے سے پہلے ٹائپ کی گئی چیز کو بڑے حروف میں بدل دیتا ہے، اور یہ پیٹرن بڑے حروف میں لکھی کوئی چیز قبول نہیں کرتا: اسکیم کوئی بھی قدر قبول نہیں کرے گی۔ پیٹرن بڑے حروف میں لکھیں، یا “upper” ہٹا دیں۔"
