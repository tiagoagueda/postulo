#: src/postulo/plugins/phone_numbers/__init__.py
#, fuzzy
msgid "Keep more than one number for yourself and for the people you deal with — a mobile, a desk line, a switchboard — with one of them marked as the one to use. Switched off, Postulo shows and uses the primary number only; the others stay recorded and come back untouched when it is switched on again."
msgstr "Gardez plus d'un numéro pour vous-même et pour les personnes avec qui vous avez affaire — un mobile, une ligne de bureau, un standard — avec l'un d'eux marqué comme celui à utiliser. Désactivé, Postulo affiche et utilise le numéro primaire seulement; les autres restent enregistrés et reviennent intacts lorsqu'il est activé à nouveau."

#: src/postulo/plugins/phone_numbers/__init__.py
#, fuzzy
msgid "Several telephone numbers"
msgstr "Plusieurs numéros de téléphone"
