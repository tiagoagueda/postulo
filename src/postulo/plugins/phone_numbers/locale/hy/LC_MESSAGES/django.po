#: src/postulo/plugins/phone_numbers/__init__.py:37
#, draft
msgid ""
"Keep more than one number for yourself and for the people you deal with — a mobile, a desk line, a switchboard — with one of them marked as the one to use. Switched off, Postulo shows and uses the primary number only; the others stay recorded and come back untouched when it is switched on again."
msgstr ""
"Պահեք մեկից ավելի համար ձեզ և այն մարդկանց համար, ում հետ գործ ունեք — բջջային, ֆիքսված գիծ, հեռախոսակայան — մեկը նշված որպես օգտագործվողը։ Անջատված լինելիս Postulo-ն ցույց է տալիս և օգտագործում միայն հիմնական համարը. մնացածը մնում են գրանցված և վերադառնում են անփոփոխ, հենց որ այն նորից միացվի։"

#: src/postulo/plugins/phone_numbers/__init__.py:35
#, draft
msgid "Several telephone numbers"
msgstr "Մի քանի հեռախոսահամար"
