#: src/postulo/plugins/phone_numbers/__init__.py
#, fuzzy
msgid "Keep more than one number for yourself and for the people you deal with — a mobile, a desk line, a switchboard — with one of them marked as the one to use. Switched off, Postulo shows and uses the primary number only; the others stay recorded and come back untouched when it is switched on again."
msgstr "Simpan lebih dari satu nomor untuk diri sendiri dan untuk orang-orang yang Anda berurusan dengan - ponsel, garis meja, switchboard - dengan salah satu dari mereka ditandai sebagai salah satu untuk digunakan. Dimatikan, Postulo menunjukkan dan menggunakan nomor utama saja; yang lain tetap direkam dan kembali tersentuh ketika diaktifkan lagi."

#: src/postulo/plugins/phone_numbers/__init__.py
#, fuzzy
msgid "Several telephone numbers"
msgstr "Beberapa nomor telepon"
