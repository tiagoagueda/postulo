#: src/postulo/plugins/phone_numbers/__init__.py
msgid "Keep more than one number for yourself and for the people you deal with — a mobile, a desk line, a switchboard — with one of them marked as the one to use. Switched off, Postulo shows and uses the primary number only; the others stay recorded and come back untouched when it is switched on again."
msgstr "Simpan lebih dari satu nomor untuk Anda sendiri dan untuk orang-orang yang berhubungan dengan Anda — ponsel, telepon meja, operator telepon — dengan salah satunya ditandai sebagai yang digunakan. Jika dinonaktifkan, Postulo hanya menampilkan dan menggunakan nomor utama; nomor lainnya tetap tercatat dan kembali tanpa diubah saat plugin diaktifkan lagi."

#: src/postulo/plugins/phone_numbers/__init__.py
msgid "Multiple telephone numbers"
msgstr "Beberapa nomor telepon"
