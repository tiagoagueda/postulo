#: src/postulo/plugins/employer_structure/__init__.py
#, fuzzy
msgid "Companies with a structure"
msgstr "Spoločnosti so štruktúrou"

#: src/postulo/plugins/employer_structure/__init__.py
#, fuzzy
msgid "Record that one company is part of another, keep departments inside a company, and say which part of a company an application was aimed at. Switched off, Postulo shows one company per posting and nothing else; the parents, the departments and the attachments stay recorded and come back untouched when it is switched on again."
msgstr "Zaznamenajte, že jedna spoločnosť je súčasťou druhej spoločnosti, udržujú oddelenia v spoločnosti a hovoria, na ktorú časť spoločnosti bola žiadosť zameraná. Vypnúť, Postulo ukazuje jednu spoločnosť za vysielanie a nič iné; rodičia, oddelenia a prílohy zostať zaznamenané a vrátiť sa nedotknutý, keď je zapnutý znovu."
