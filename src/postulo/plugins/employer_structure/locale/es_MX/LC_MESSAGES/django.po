#: src/postulo/plugins/employer_structure/__init__.py
#, fuzzy
msgid "Employers with a structure"
msgstr "Empleadores con estructura"

#: src/postulo/plugins/employer_structure/__init__.py
#, fuzzy
msgid "Record that one company is part of another, keep departments inside a company, and say which part of an employer an application was aimed at. Switched off, Postulo shows one company per posting and nothing else; the parents, the departments and the attachments stay recorded and come back untouched when it is switched on again."
msgstr "Recordar que una empresa es parte de otra, mantener departamentos dentro de una empresa, y decir a qué parte de un empleador una solicitud fue dirigida. Apagado, Postulo muestra una empresa por correo y nada más; los padres, los departamentos y los apegos permanecen registrados y regresan sin tocar cuando se activa de nuevo."
