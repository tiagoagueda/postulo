#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 pro STARTTLS, 465 pro TLS od prvního bajtu."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Heslo je správné pro váš vlastní poštovní server. Zvolte svého poskytovatele a přihlaste se místo toho na jeho stránce, což bude Microsoft 365 vyžadovat."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Heslo, nebo heslo aplikace"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID klienta"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Tajný klíč klienta"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID adresáře (tenanta)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Šifrování"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Pouze Microsoft. Ponechte prázdné pro přijetí jakéhokoli adresáře."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Téměř každý poskytovatel chce STARTTLS na 587. Někteří chtějí TLS na 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Není nastavena žádná adresa."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Pouze při přihlašování přes poskytovatele: z aplikace u něj registrované. Zeptejte se toho, kdo tuto instanci provozuje, zda nemá nějakou ke sdílení."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Heslo"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Odesílat z"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Odesílejte z vlastní adresy přes vlastní poštovní server místo z této instance. To, co odchází, nese vaše jméno a vaši doménu, a odpověď nebo vrácení se vrací vám. Vypnuto se nemění nic z toho, co tato instance posílá na vlastní účet — oznámení, přihlašovací kódy, cesta zpět dovnitř."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Přihlásit se přes"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Uloženo zašifrovaně a nikdy znovu nezobrazeno. Mnoho poskytovatelů zde chce heslo pro aplikaci místo toho, kterým se přihlašujete."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adresa, kterou příjemci uvidí a kam půjdou jejich odpovědi. Váš poštovní server z ní musí mít právo odesílat."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Uživatelské jméno"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Vaše vlastní pošta"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Vaše heslo nebo token by putovaly sítí nešifrovaně. Zvolte STARTTLS nebo TLS od prvního bajtu v části Šifrování."
