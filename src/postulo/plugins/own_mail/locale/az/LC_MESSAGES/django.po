#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "STARTTLS üçün 587, ilk baytdan TLS üçün 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Parol öz poçt serveriniz üçün uyğundur. Bunun əvəzinə provayderin öz səhifəsində daxil olmaq üçün provayderinizi seçin — Microsoft 365 bunu tələb edəcək."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Parol və ya tətbiq parolu"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Müştəri ID-si"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Müştəri məxfi açarı"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Kataloq (tenant) ID-si"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Şifrələmə"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Yalnız Microsoft. İstənilən kataloqu qəbul etmək üçün boş buraxın."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Demək olar ki, hər provayder 587 portunda STARTTLS istəyir. Bəziləri 465 portunda TLS istəyir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Ünvan təyin edilməyib."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Yalnız provayder ilə daxil olduqda: onda qeydiyyatdan keçirilmiş tətbiqdən. Bu instansiyanı idarə edən şəxsdən paylaşa biləcəyi belə bir tətbiqin olub-olmadığını soruşun."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Parol"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Göndərən ünvan"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Bu instansiyadan deyil, öz ünvanınızdan, öz poçt serveriniz vasitəsilə göndərin. Göndərilən məktublar sizin adınızı və domeninizi daşıyır, cavab və ya geri qayıdan məktub sizə gəlir. Deaktiv edildikdə bu instansiyanın öz adından göndərdiyi hər şey (bildirişlər, giriş kodları, hesaba yenidən giriş) bundan təsirlənmir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Daxil olma üsulu"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Şifrələnmiş saxlanılır və heç vaxt yenidən göstərilmir. Bir çox provayder burada daxil olduğunuz parolu deyil, tətbiqə xas parolu istəyir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Alıcıların görəcəyi və cavablarının gedəcəyi ünvan. Poçt serveriniz bu ünvandan göndərməyə səlahiyyətli olmalıdır."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "İstifadəçi adı"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Öz e-poçtunuz"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Parolunuz və ya tokeniniz şəbəkədən şifrələnmədən keçərdi. «Şifrələmə» bölməsində STARTTLS və ya ilk baytdan TLS seçin."
