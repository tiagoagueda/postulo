#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 STARTTLS gadījumā, 465 TLS gadījumā no pirmā baita."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Parole der jūsu pašu pasta serverim. Izvēlieties savu nodrošinātāju, lai tā vietā pieteiktos tā lapā — to prasīs Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Parole vai lietotnes parole"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "Klienta ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Klienta noslēpums"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Direktorija (nomnieka) ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Šifrēšana"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Tikai Microsoft. Atstājiet tukšu, lai pieņemtu jebkuru direktoriju."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Gandrīz katrs pakalpojumu sniedzējs vēlas STARTTLS uz 587. Daži vēlas TLS uz 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Adrese nav norādīta."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Tikai piesakoties ar nodrošinātāju: no tur reģistrētās lietotnes. Pajautājiet šīs instances uzturētājam, vai tam ir kāda, ar ko dalīties."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Parole"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Ports"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Sūtīt no"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Sūtiet no savas adreses caur savu pasta serveri, nevis no šīs instances. Tas, kas aiziet, nes jūsu vārdu un jūsu domēnu, un atbilde vai atgrieztā vēstule nonāk pie jums. Izslēgts nekas nemainās tajā, ko šī instance sūta savā vārdā — paziņojumi, pieteikšanās kodi, ceļš atpakaļ iekšā."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Serveris"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Pieteikties ar"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Glabājas šifrēta un vairs netiek rādīta. Daudzi pakalpojumu sniedzēji vēlas šeit lietotnei specifisku paroli, nevis to, ar kuru pieteicāties."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adrese, ko redzēs saņēmēji un uz kuru nonāks viņu atbildes. Jūsu pasta serverim ir jābūt tiesīgam sūtīt no tās."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Lietotājvārds"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Jūsu pašu e-pasts"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Jūsu parole vai žetons šķērsotu tīklu nešifrēti. Sadaļā Šifrēšana izvēlieties STARTTLS vai TLS no pirmā baita."
