#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 untuk STARTTLS, 465 untuk TLS dari byte pertama."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Kata sandi tepat untuk server surat Anda sendiri. Pilih penyedia Anda untuk masuk pada halamannya sendiri, yang Microsoft 365 akan butuhkan."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Sandi, atau sandi aplikasi"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID Klien"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Rahasia klien"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID Direktori (penyewa)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Enkripsi"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Microsoft saja. Tinggalkan kosong untuk menerima direktori apapun."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Hampir semua penyedia menginginkan STARTTLS pada 587. Beberapa ingin TLS di 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Tak ada alamat."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Hanya ketika menandatangani dengan penyedia: dari aplikasi yang terdaftar dengannya. Tanyakan siapa pun yang menjalankan instansi ini apakah mereka memiliki satu untuk berbagi."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Sandi"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Kirim dari"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Kirim dari alamat Anda sendiri, melalui server surat Anda sendiri, daripada dari contoh ini. Apa daun membawa nama dan domain Anda, dan jawaban atau bouncing datang kembali kepada Anda. Dimatikan, segala sesuatu instansi ini mengirimkan pada akun sendiri - pemberitahuan, sign- dalam kode, mendapatkan kembali - tidak terpengaruh."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Masuk dengan"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Terenkripsi dan tidak pernah ditampilkan kembali. Banyak penyedia ingin kata sandi spesifik di sini daripada yang Anda mendaftar dengan."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Penerima alamat akan melihat, dan di mana jawaban mereka akan pergi. Server surat Anda harus berhak untuk mengirim dari itu."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Nama pengguna"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Surel Anda sendiri"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Kata sandi atau token Anda akan menyeberangi jaringan tanpa terenkripsi. Pilih STARTTLS atau TLS dari byte pertama di bawah Enkripsi."
