#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 untuk STARTTLS, 465 untuk TLS dari byte pertama."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Kata sandi cocok untuk server email Anda sendiri. Pilih penyedia Anda untuk masuk di halamannya sendiri, yang diwajibkan oleh Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Kata sandi, atau kata sandi aplikasi"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID klien"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Rahasia klien"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID direktori (tenant)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Enkripsi"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Hanya untuk Microsoft. Kosongkan untuk menerima direktori apa pun."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Hampir semua penyedia menginginkan STARTTLS pada 587. Beberapa ingin TLS di 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Belum ada alamat yang diatur."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Hanya saat masuk dengan penyedia: dari aplikasi yang terdaftar padanya. Tanyakan kepada pengelola instans ini apakah mereka punya satu untuk dibagikan."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Kata sandi"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Kirim dari"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Kirim dari alamat Anda sendiri, melalui server email Anda sendiri, bukan dari instans ini. Pesan yang keluar membawa nama dan domain Anda, dan balasan atau pesan pentalan kembali kepada Anda. Jika dinonaktifkan, semua yang dikirim instans ini atas namanya sendiri — notifikasi, kode masuk, pemulihan akses — tidak terpengaruh."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Masuk dengan"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Disimpan terenkripsi dan tidak pernah ditampilkan lagi. Banyak penyedia menginginkan kata sandi khusus aplikasi di sini, bukan kata sandi yang Anda gunakan untuk masuk."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Alamat yang akan dilihat penerima, dan tujuan balasan mereka. Server email Anda harus berhak mengirim dari alamat ini."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Nama pengguna"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Email Anda sendiri"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Kata sandi atau token Anda akan melintasi jaringan tanpa enkripsi. Pilih STARTTLS atau TLS dari byte pertama di bawah Enkripsi."
