#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 for STARTTLS, 465 for TLS fra første byte."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Et passord passer for din egen e-postserver. Velg leverandøren din for heller å logge inn på dens egen side, noe Microsoft 365 kommer til å kreve."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Et passord eller et app-passord"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "Klient-ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Klienthemmelighet"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Katalog-ID (leietaker)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Kryptering"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Bare Microsoft. La stå tomt for å godta enhver katalog."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Nesten alle leverandører vil ha STARTTLS på 587. Noen vil ha TLS på 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Ingen adresse angitt."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Bare ved innlogging via en leverandør: fra programmet som er registrert der. Spør den som driver denne instansen om det finnes et å dele."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Passord"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Send fra"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Send fra din egen adresse via din egen e-postserver i stedet for fra denne instansen. Det som går ut bærer navnet og domenet ditt, og et svar eller en retur kommer tilbake til deg. Slått av endres ingenting av det instansen sender for egen regning — varsler, innloggingskoder, veien tilbake inn."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Tjener"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Logg inn med"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Lagres kryptert og vises aldri igjen. Mange leverandører vil ha et app-spesifikt passord her i stedet for det du logger inn med."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adressen mottakerne ser, og dit svarene deres går. E-posttjeneren din må ha lov til å sende fra den."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Brukernavn"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Din egen e-post"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Ditt passord eller symbol vil krysse nettverket ukryptert. Velg STARTTLS eller TLS fra første byte under kryptering."
