#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 para STARTTLS, 465 para TLS desde o primeiro byte."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Un contrasinal é o axeitado para o teu propio servidor de correo. Escolle o teu provedor para iniciar sesión na súa páxina, algo que Microsoft 365 esixirá."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Un contrasinal ou un contrasinal de aplicación"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID de cliente"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Segredo de cliente"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID de directorio (inquilino)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Cifrado"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Só Microsoft. Déixao en branco para aceptar calquera directorio."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Case todos os provedores queren STARTTLS no 587. Algúns queren TLS no 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Non hai ningún enderezo definido."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Só ao iniciar sesión cun provedor: da aplicación rexistrada nel. Pregunta a quen xestiona esta instancia se ten unha para compartir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Contrasinal"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Porto"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Enviar desde"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Enviar desde o teu propio enderezo, a través do teu propio servidor de correo, en vez de desde esta instancia. O que sae leva o teu nome e o teu dominio, e as respostas ou as devolucións chegan a ti. Desactivado, nada do que esta instancia envía pola súa conta —notificacións, códigos de inicio de sesión, recuperación do acceso— se ve afectado."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Servidor"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Iniciar sesión con"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Gárdase cifrado e nunca se volve mostrar. Moitos provedores queren aquí un contrasinal específico de aplicación en vez do que usas para iniciar sesión."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "O enderezo que verán os destinatarios e ao que irán as súas respostas. O teu servidor de correo ten que estar autorizado para enviar desde el."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Nome de usuario"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "O teu propio correo electrónico"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "O teu contrasinal ou testemuño cruzaría a rede sen cifrar. Escolle STARTTLS ou TLS desde o primeiro byte en Cifrado."
