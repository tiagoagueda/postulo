#: src/postulo/plugins/own_mail/__init__.py:77
#, draft
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 para STARTTLS, 465 para TLS desde o primeiro byte."

#: src/postulo/plugins/own_mail/__init__.py:81
#, draft
msgid "Encryption"
msgstr "Cifrado"

#: src/postulo/plugins/own_mail/__init__.py:85
#, draft
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr ""
"Case todos os provedores queren STARTTLS no 587. Algúns queren TLS no 465."

#: src/postulo/plugins/own_mail/__init__.py:146
#, draft
msgid "No address set."
msgstr "Non hai ningún enderezo definido."

#: src/postulo/plugins/own_mail/__init__.py:92
#, draft
msgid "Password"
msgstr "Contrasinal"

#: src/postulo/plugins/own_mail/__init__.py:74
#, draft
msgid "Port"
msgstr "Porto"

#: src/postulo/plugins/own_mail/__init__.py:63
#, draft
msgid "Send from"
msgstr "Enviar desde"

#: src/postulo/plugins/own_mail/__init__.py:46
#, draft
msgid ""
"Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr ""
"Envíe desde o seu propio enderezo, polo seu propio servidor de correo, no canto de desde esta instancia. O que sae leva o seu nome e o seu dominio, e unha resposta ou unha devolución volve a vostede. Desactivado, non cambia nada do que esta instancia envía pola súa conta: notificacións, códigos de acceso, volver entrar."

#: src/postulo/plugins/own_mail/__init__.py:71
#, draft
msgid "Server"
msgstr "Servidor"

#: src/postulo/plugins/own_mail/__init__.py:96
#, draft
msgid ""
"Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr ""
"Gárdase cifrado e nunca se volve amosar. Moitos provedores queren aquí un contrasinal específico da aplicación no canto do de acceso."

#: src/postulo/plugins/own_mail/__init__.py:66
#, draft
msgid ""
"The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr ""
"O enderezo que verán os destinatarios e ao que irán as súas respostas. O seu servidor de correo ten que estar autorizado a enviar desde el."

#: src/postulo/plugins/own_mail/__init__.py:89
#, draft
msgid "Username"
msgstr "Nome de usuario"

#: src/postulo/plugins/own_mail/__init__.py:44
#, draft
msgid "Your own email"
msgstr "O seu propio correo"
