#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 مع STARTTLS، و465 مع TLS من البايت الأول."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "كلمة المرور مناسبة لخادم البريد الخاص بك. اختر مزوّدك لتسجيل الدخول في صفحته بدلًا من ذلك، وهو ما سيشترطه Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "كلمة مرور، أو كلمة مرور التطبيق"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "معرّف العميل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "سر العميل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "معرّف الدليل (المستأجر)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "التشفير"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "يخص Microsoft فقط. اتركه فارغًا لقبول أي دليل."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "يطلب كل المزوّدين تقريبًا STARTTLS على المنفذ 587. وبعضهم يطلب TLS على 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "لم يُعيَّن أي عنوان."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "فقط عند تسجيل الدخول عبر مزوّد: من التطبيق المسجّل لديه. اسأل من يدير هذا المثيل إن كان لديه واحد يمكن مشاركته."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "كلمة المرور"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "المنفذ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "عنوان الإرسال"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "الإرسال من عنوانك الخاص، عبر خادم البريد الخاص بك، بدلًا من هذا المثيل. ما يُرسَل يحمل اسمك ونطاقك، ويعود إليك أي رد أو رسالة ارتداد. معطّل، لا يتأثر كل ما يرسله هذا المثيل باسمه — الإشعارات ورموز تسجيل الدخول واستعادة الوصول."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "الخادم"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "تسجيل الدخول عبر"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "يُخزَّن مشفّرًا ولا يُعرض مرة أخرى. يطلب كثير من المزوّدين هنا كلمة مرور خاصة بالتطبيق بدلًا من التي تسجّل الدخول بها."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "العنوان الذي سيراه المستلمون، وإليه تصل ردودهم. يجب أن يكون خادم البريد الخاص بك مخوّلًا بالإرسال منه."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "اسم المستخدم"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "بريدك الإلكتروني الخاص"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "ستعبر كلمة المرور أو الرمز المميز الشبكة دون تشفير. اختر STARTTLS أو TLS من البايت الأول ضمن التشفير."
