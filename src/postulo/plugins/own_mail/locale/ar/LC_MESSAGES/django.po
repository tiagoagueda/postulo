#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 لـ (ستارتلس)، 465 لـ (تي إل إس) من البداية الأولى."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "كلمة السر صحيحة لخادم البريد الخاص بك. اختر مزودك للتوقيع على صفحته بدلاً من ذلك، الذي سيحتاجه مايكروسوفت 365."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "كلمة سر أو كلمة سر"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "هوية العميل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "سر العملاء"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "دليل (كبير) الهوية"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "التشفير"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "مايكروسوفت فقط إتركْ فارغَ للقَبْل أيّ دليل."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "تقريباً كُلّ مقدم يُريدُ ستارتل إس في 587. البعض يريد \" تي إل إس \" في 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "لا يوجد عنوان."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Only when signing in with a provider: from the application registered with it. إسأل من يدير هذه الحالة إذا كان لديهم واحدة لتشاركها."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "كلمة السر"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "الميناء"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "أرسل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "إرسال من عنوانك الخاص، على خادم البريد الخاص بك، بدلا من هذه الحالة. ما يترك يحمل اسمك ومجالك، والرد أو المكافأة يعود لك. غير متأثر كل ما ترسله هذه الحالة لحسابها الخاص - الإخطارات، رموز الإشارة، العودة إلى الداخل."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "سيرفر"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "وقع"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "مسروقة مشفرة ولم تظهر العديد من المزودين يريدون كلمة سر خاصة بالتطبيق هنا بدلاً من تلك التي توقعين عليها."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "وسيرى المتلقين للعنوان، وأين ستذهب ردودهم. خادم البريد الخاص بك يجب أن يكون الحق في إرسال منه."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "المستعمل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "بريدك الإلكتروني الخاص"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "كلمة سرك أو رمزك ستعبر الشبكة بدون شفرة اختر ستارتلس أو تي إل إس من أول طرف تحت التشفير."
