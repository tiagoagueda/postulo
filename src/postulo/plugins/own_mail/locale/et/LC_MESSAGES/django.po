#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 STARTTLS-i jaoks, 465 TLS-i jaoks esimesest baidist."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Parool sobib teie enda e-posti serverile. Valige oma teenusepakkuja, et logida selle asemel sisse pakkuja enda lehel – seda nõuab Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Parool või rakenduse parool"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Kliendi ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Kliendi saladus"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Kataloogi (rentniku) ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Krüptimine"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Ainult Microsoft. Jätke tühjaks, et lubada mis tahes kataloogi."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Peaaegu iga teenusepakkuja tahab STARTTLS-i pordil 587. Mõni tahab TLS-i pordil 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Aadressi pole määratud."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Ainult teenusepakkuja kaudu sisse logides: sellega registreeritud rakendusest. Küsige selle Postulo haldajalt, kas tal on mõni jagamiseks."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Parool"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Saada aadressilt"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Saatke oma aadressilt oma e-posti serveri kaudu, mitte selle Postulo kaudu. Väljuvad kirjad kannavad teie nime ja domeeni ning vastus või tagastus jõuab teieni. Välja lülitatuna ei muutu midagi selles, mida see Postulo oma nimel saadab – teavitused, sisselogimiskoodid, konto taastamine."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Logi sisse teenusega"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Salvestatakse krüptitult ja seda ei näidata enam. Paljud teenusepakkujad soovivad siia rakendusepõhist parooli, mitte seda, millega te sisse logite."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Aadress, mida saajad näevad ja kuhu nende vastused lähevad. Teie e-posti serveril peab olema õigus sellelt saata."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Kasutajanimi"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Teie enda e-post"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Teie parool või tõend liiguks võrgus krüptimata. Valige jaotises „Krüptimine“ STARTTLS või TLS esimesest baidist."
