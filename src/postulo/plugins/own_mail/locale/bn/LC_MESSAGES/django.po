#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "STARTTLS-এর জন্য 587, প্রথম বাইট থেকে TLS-এর জন্য 465।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "আপনার নিজের মেল সার্ভারের জন্য পাসওয়ার্ডই সঠিক। এর বদলে প্রদানকারীর নিজস্ব পৃষ্ঠায় সাইন ইন করতে আপনার প্রদানকারী বেছে নিন; Microsoft 365-এর জন্য এটি আবশ্যক।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "একটি পাসওয়ার্ড, বা একটি অ্যাপ পাসওয়ার্ড"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ক্লায়েন্ট আইডি"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "ক্লায়েন্ট সিক্রেট"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ডিরেক্টরি (টেন্যান্ট) আইডি"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "এনক্রিপশন"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "কেবল Microsoft-এর জন্য। যেকোনো ডিরেক্টরি গ্রহণ করতে ফাঁকা রাখুন।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "প্রায় প্রতিটি প্রদানকারী 587-এ STARTTLS চায়। কয়েকটি 465-এ TLS চায়।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "কোনো ইমেল ঠিকানা সেট করা নেই।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "কেবল কোনো প্রদানকারীর মাধ্যমে সাইন ইন করার সময়: সেই প্রদানকারীর কাছে নিবন্ধিত অ্যাপ থেকে। এই ইনস্ট্যান্স যিনি চালান, তাঁর কাছে শেয়ার করার মতো একটি আছে কি না জিজ্ঞেস করুন।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "পাসওয়ার্ড"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "পোর্ট"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "যে ঠিকানা থেকে পাঠানো হবে"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "এই ইনস্ট্যান্স থেকে নয়, বরং আপনার নিজের মেল সার্ভারের মাধ্যমে আপনার নিজের ইমেল ঠিকানা থেকে পাঠান। যা পাঠানো হয় তাতে আপনার নাম ও আপনার ডোমেইন থাকে, এবং কোনো উত্তর বা ফেরত আসা মেল আপনার কাছেই আসে। বন্ধ থাকলে এই ইনস্ট্যান্স নিজে থেকে যা কিছু পাঠায় — বিজ্ঞপ্তি, সাইন-ইন কোড, অ্যাকাউন্টে আবার প্রবেশ — তাতে কোনো প্রভাব পড়ে না।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "সার্ভার"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "সাইন ইনের পদ্ধতি"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "এনক্রিপ্ট করে সংরক্ষণ করা হয় এবং কখনো আবার দেখানো হয় না। অনেক প্রদানকারী এখানে আপনার সাইন ইন করার পাসওয়ার্ডের বদলে একটি অ্যাপ-নির্দিষ্ট পাসওয়ার্ড চায়।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "প্রাপকেরা যে ঠিকানা দেখবেন, এবং তাঁদের উত্তর যেখানে যাবে। এই ঠিকানা থেকে পাঠানোর অধিকার আপনার মেল সার্ভারের থাকতে হবে।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "ব্যবহারকারীর নাম"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "আপনার নিজের ইমেল"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "আপনার পাসওয়ার্ড বা টোকেন এনক্রিপশন ছাড়াই নেটওয়ার্কের ওপর দিয়ে যাবে। “এনক্রিপশন” ফিল্ডে STARTTLS বা প্রথম বাইট থেকে TLS বেছে নিন।"
