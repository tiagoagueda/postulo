#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "B87, প্রথম বাইট থেকে TLS জন্য 455।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "আপনার মেইল সার্ভারের পাসওয়ার্ড সঠিক। আপনার নিজের পাতায় সাইন ইন করতে হলে, Microsoft 365 প্রয়োজন।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "পাসওয়ার্ড অথবা একটি অ্যাপ্লিকেশন"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ক্লায়েন্ট ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "ক্লায়েন্ট গোপনীয়"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ডিরেক্টরি (টেনার্ট)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "এনক্রিপশন প্রক্রিয়া"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "শুধু মাইক্রোসফট। কোনো ডিরেক্টরি গ্রহণ করার উদ্দেশ্যে ফাঁকা রাখুন।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "প্রায় প্রতিটা প্রোভাইডারই 5877 সালে ফিরে আসতে চায়. কেউ কেউ ৪৬৫ এ TLS চায়।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "কোন ঠিকানা নির্ধারিত হয়নি।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "শুধুমাত্র পরিসেবা উপলব্ধকারীর সাথে সংযোগ স্থাপন করা হলে: এই অ্যাপ্লিকেশনের সাথে যুক্ত রয়েছে। এমন কাউকে জিজ্ঞেস করো যে, তাদের কোন শেয়ার আছে কি না।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "পাসওয়ার্ড"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "পোর্ট"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "প্রেরণ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "সার্ভারের ঠিকানার পরিবর্তে আপনার মেইল প্রেরণের চেষ্টা করুন। যা আপনার নাম এবং আপনার ডোমেইন বহন করে, এবং একটি উত্তর অথবা একটি বাউন্স ফিরে আসে আপনার কাছে। বন্ধ করে দেওয়া, এই সমস্ত কিছু তার নিজের একাউন্টে পাঠানো হয়েছে — বিজ্ঞপ্তি, সাইন কোড, ফিরে আসা, বিচ্ছিন্ন নয়।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "সার্ভার"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "সাইন ইন করুন"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "এনক্রিপ্ট করা তথ্য সংরক্ষণ করে কখনো প্রদর্শিত হবে না। অনেক প্রোভাইডার একটি অ্যাপস-এর পাসওয়ার্ড চায়, তার সাথে সাইন করার বদলে।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "বার্তায় শুধুমাত্র অপ্রকাশিত অনুলিপি প্রাপকদের নাম লেখা হবে। আপনার মেইল সার্ভারের মাধ্যমে মেইল প্রেরণের অনুমতি রয়েছে।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "ব্যবহারকারীর নাম"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "আপনার নিজের ই-মেইল"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "আপনার পাসওয়ার্ড বা টোকেন বিনা এনক্রিপশনে প্রবেশ করা যাবে। এনক্রিপশনের অধীনে প্রথম বাইট থেকে STARTTLS অথবা TLS নির্বাচন করুন ।।"
