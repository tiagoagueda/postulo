#, fuzzy
msgid "Client secret"
msgstr "क्लाइंट सीक्रेट"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "डायरेक्टरी (टेनेंट) ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "एन्क्रिप्शन"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "सिर्फ़ Microsoft के लिए। किसी भी डायरेक्टरी को स्वीकार करने के लिए खाली छोड़ें।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "लगभग हर प्रोवाइडर 587 पर STARTTLS चाहता है। कुछ 465 पर TLS चाहते हैं।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "कोई पता सेट नहीं है।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "सिर्फ़ किसी प्रोवाइडर से साइन इन करते समय: उसके साथ रजिस्टर किए गए ऐप से। इस इंस्टेंस को चलाने वाले व्यक्ति से पूछें कि क्या उनके पास शेयर करने के लिए कोई ऐप है।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "पासवर्ड"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "पोर्ट"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "भेजने वाला पता"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "इस इंस्टेंस के बजाय, अपने पते से, अपने मेल सर्वर के ज़रिए भेजें। जो भी भेजा जाता है उसमें आपका नाम और आपका डोमेन होता है, और कोई जवाब या बाउंस आपके पास वापस आता है। बंद है, तो यह इंस्टेंस अपनी ओर से जो कुछ भेजता है — सूचनाएं, साइन-इन कोड, खाते में फिर से पहुंचने के लिंक — उस पर कोई असर नहीं पड़ता।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "सर्वर"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "इससे साइन इन करें"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "एन्क्रिप्ट करके रखा जाता है और फिर कभी नहीं दिखाया जाता। कई प्रोवाइडर यहां साइन इन वाले पासवर्ड के बजाय ऐप के लिए खास पासवर्ड चाहते हैं।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "वह पता जो प्राप्तकर्ताओं को दिखेगा, और जहां उनके जवाब जाएंगे। आपके मेल सर्वर को इस पते से भेजने का अधिकार होना चाहिए।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "यूज़रनेम"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "आपका अपना ईमेल"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "आपका पासवर्ड या टोकन बिना एन्क्रिप्शन के नेटवर्क से गुज़रेगा। एन्क्रिप्शन में STARTTLS या पहले बाइट से TLS चुनें।"
