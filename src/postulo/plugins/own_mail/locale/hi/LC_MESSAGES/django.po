#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "STARTTLS के लिए 587, पहले बाइट से TLS के लिए 465।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "आपके अपने मेल सर्वर के लिए पासवर्ड सही है। इसके बजाय प्रोवाइडर के अपने पेज पर साइन इन करने के लिए अपना प्रोवाइडर चुनें; Microsoft 365 के लिए यह ज़रूरी होगा।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "पासवर्ड, या ऐप पासवर्ड"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "क्लाइंट ID"

