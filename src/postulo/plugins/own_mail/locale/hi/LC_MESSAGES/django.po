#, fuzzy
msgid "Port"
msgstr "पोर्ट"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "से भेजें"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "इस उदाहरण के बजाय, अपने स्वयं के मेल सर्वर पर अपने पते से भेजें। क्या पत्तियां आपका नाम और आपका डोमेन रखती हैं, और एक जवाब या उछाल आपको वापस आती है। बंद हो गया, यह सब कुछ अपने खाते पर भेजता है - अधिसूचनाएं, साइन-इन कोड, वापस मिल रहा है - अप्रभावित है।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "सर्वर"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "साइन इन करें"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "संग्रहीत एन्क्रिप्टेड और कभी नहीं दिखाया गया है। कई प्रदाताओं के साथ साइन इन करने के बजाय यहां एक ऐप-विशिष्ट पासवर्ड चाहते हैं।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "पता प्राप्तकर्ता देखेंगे और उनके उत्तर कहाँ जाएंगे। आपके मेल सर्वर को इससे भेजने का हकदार होना चाहिए।।"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "उपयोगकर्ता नाम"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "अपना खुद का ईमेल"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "आपका पासवर्ड या टोकन नेटवर्क को अनइंक्रिप्टेड कर देगा। एन्क्रिप्शन के तहत पहले बाइट से STARTTLS या TLS चुनें।।"
