#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 STARTTLS erabiltzeko, 465 lehen bytetik TLS erabiltzeko."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Pasahitz bat egokia da zure posta-zerbitzarirako. Aukeratu zure hornitzailea horren ordez bere orrian saioa hasteko; Microsoft 365-ek hori eskatuko du."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Pasahitz bat, edo aplikazio-pasahitz bat"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Bezero-IDa"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Bezero-sekretua"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Direktorioaren (maizterraren) IDa"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Zifratzea"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Microsoft soilik. Utzi hutsik edozein direktorio onartzeko."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Ia hornitzaile guztiek STARTTLS erabiltzen dute 587 atakan. Batzuek TLS 465 atakan."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Ez da helbiderik ezarri."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Hornitzaile batekin saioa hastean soilik: bertan erregistratutako aplikaziotik. Galdetu instantzia hau kudeatzen duenari partekatzeko baten bat duen."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Pasahitza"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Ataka"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Bidali hemendik"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Bidali zure helbidetik, zure posta-zerbitzariaren bidez, instantzia honetatik bidali beharrean. Ateratzen denak zure izena eta zure domeinua darama, eta erantzunak edo itzulitako mezuak zuregana itzultzen dira. Itzalita, instantzia honek bere kontura bidaltzen duen guztia (jakinarazpenak, saio-hasierako kodeak, sarbidea berreskuratzea) ez da aldatzen."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Zerbitzaria"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Hasi saioa honekin"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Zifratuta gordetzen da eta ez da berriro erakusten. Hornitzaile askok aplikazio-pasahitz berezi bat eskatzen dute hemen, saioa hasteko erabiltzen duzuna beharrean."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Hartzaileek ikusiko duten helbidea eta haien erantzunak joango diren tokia. Zure posta-zerbitzariak hortik bidaltzeko eskubidea izan behar du."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Erabiltzaile-izena"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Zure posta elektroniko propioa"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Zure pasahitza edo tokena zifratu gabe igaroko litzateke saretik. Aukeratu STARTTLS edo lehen bytetik TLS, «Zifratzea» atalean."
