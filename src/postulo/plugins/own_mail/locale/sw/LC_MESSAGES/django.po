#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 kwa ajili ya STARTTLS, 465 kwa ajili ya TLS."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Neno la siri ni sahihi kwa server yako ya barua pepe. Chagua mtoa huduma wako kuingia kwenye ukurasa wake mwenyewe, ambayo Microsoft 365 itahitaji."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Neno la siri au password ya programu"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "Mtumiaji ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Siri ya Wateja"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Mwongozo wa utambulisho (tenant ID)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Usajili"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Ya Microsoft. Acha tupu kukubali maelekezo yoyote."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Karibu kila mtoa huduma anataka kuanza kwenye 587. Baadhi ya watu wanataka TLS 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Hakuna anwani iliyowekwa."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Ni wakati tu wa kuingia na mtoa huduma: kutoka kwa programu iliyosajiliwa nayo. Waulize wale ambao wana uwezo wa kufanya hivyo."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Neno la siri"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Ujumbe kutoka kwa"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Tuma kutoka kwa anwani yako mwenyewe, juu ya seva yako ya barua pepe, badala ya kutoka kwa mfano huu. Jina la kikoa na anwani yako, na jibu au bounce linarudi kwako. Ilibadilishwa, kila kitu ambacho mfano huu hutuma kwenye akaunti yake mwenyewe - arifa, nambari za kuingia, kurudi - haziathiriwa."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Kuingia kwa pamoja"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Hifadhi imefungwa na haijawahi kuonyeshwa tena. Watoa huduma wengi wanataka nywila maalum ya programu hapa badala ya ile unayoingia nayo."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Wasikilizaji wataangalia na wapi majibu yao yataenda. server yako lazima kuwa na haki ya kutuma kutoka."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Jina la mtumiaji"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Email yako mwenyewe"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Nenosiri yako au ishara itavuka mtandao bila kufichwa. Chagua STARTTLS au TLS kutoka kwa chombo cha kwanza chini ya encryption."
