#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 pre STARTTLS, 465 pre TLS od prvého bajtu."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Heslo je vhodné pre váš vlastný poštový server. Namiesto toho si zvoľte poskytovateľa a prihláste sa na jeho vlastnej stránke, čo bude Microsoft 365 vyžadovať."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Heslo alebo heslo aplikácie"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID klienta"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Tajný kľúč klienta"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID adresára (nájomníka)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Šifrovanie"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Iba pre Microsoft. Ak chcete prijať akýkoľvek adresár, nechajte prázdne."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Takmer každý poskytovateľ chce STARTTLS na 587. Niektorí chcú TLS na 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Nie je nastavená žiadna adresa."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Iba pri prihlasovaní cez poskytovateľa: z aplikácie u neho registrovanej. Opýtajte sa toho, kto túto inštanciu prevádzkuje, či nemá nejakú na zdieľanie."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Heslo"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Odosielať z"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Odosielajte z vlastnej adresy cez vlastný poštový server namiesto z tejto inštancie. To, čo odchádza, nesie vaše meno a vašu doménu a odpoveď alebo vrátená správa sa vráti k vám. Keď je vypnuté, nič z toho, čo táto inštancia posiela vo vlastnom mene – oznámenia, prihlasovacie kódy, obnovenie prístupu –, sa nemení."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Prihlásiť sa cez"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Ukladá sa zašifrovane a už sa nikdy nezobrazí. Mnohí poskytovatelia tu chcú heslo aplikácie namiesto toho, ktorým sa prihlasujete."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adresa, ktorú príjemcovia uvidia a kam pôjdu ich odpovede. Váš poštový server z nej musí mať právo odosielať."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Používateľské meno"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Vlastný e-mail"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Vaše heslo alebo token by prešli sieťou nezašifrované. V časti Šifrovanie zvoľte STARTTLS alebo TLS od prvého bajtu."
