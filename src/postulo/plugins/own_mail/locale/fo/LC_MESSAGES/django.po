#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 fyri STARTTLS, 465 fyri TLS frá fyrsta byti."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Eitt loyniorð hóskar til tín egna postambætara. Vel heldur veitaran hjá tær fyri at rita inn á hansara egnu síðu, sum Microsoft 365 fer at krevja."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Eitt loyniorð ella eitt appaloyniorð"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "Kundaeyðmerki"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Kundaloyndarlykil"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Mappueyðmerki (leigari)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Bronglan"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Bert Microsoft. Lat vera tómt fyri at góðtaka hvørja mappu sum helst."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Næstan hvør veitari vil hava STARTTLS á 587. Summir vilja hava TLS á 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Eingin teldupostbústaður ásettur."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Bert tá ið innritað verður við einum veitara: úr forritinum, sum er skrásett hjá honum. Spyr tann, sum rekur hesa uppsetingina, um eitt slíkt er at deila."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Loyniorð"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Portur"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Send frá"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Send frá tínum egna teldupostbústaði, gjøgnum tín egna postambætara, heldur enn frá hesi uppsetingini. Tað, sum fer avstað, ber navn títt og navnaøki títt, og eitt svar ella eitt afturvíst boð kemur aftur til tín. Er tað sløkt, verður alt, sum henda uppsetingin sendir í egnum navni — fráboðanir, innritingarkotur, at sleppa inn aftur — ikki ávirkað."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Ambætari"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Rita inn við"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Goymt bronglað og ongantíð víst aftur. Nógvir veitarar vilja hava eitt appaloyniorð her heldur enn tað, tú ritar inn við."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Teldupostbústaðurin, sum móttakararnir síggja, og hagar svarini frá teimum fara. Postambætarin hjá tær má hava rætt til at senda frá honum."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Brúkaranavn"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Tín egni teldupostur"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Loyniorðið ella tekinið hjá tær hevði farið óbronglað gjøgnum netið. Vel STARTTLS ella TLS frá fyrsta byti undir Bronglan."
