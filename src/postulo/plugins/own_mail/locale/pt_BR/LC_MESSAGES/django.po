#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 para STARTTLS, 465 para TLS desde o primeiro byte."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Uma senha é o certo para o seu próprio servidor de e-mail. Escolha o seu provedor para fazer login na página dele, o que o Microsoft 365 vai exigir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Uma senha, ou uma senha de app"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID do cliente"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Segredo do cliente"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID do diretório (locatário)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Criptografia"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Só Microsoft. Deixe em branco para aceitar qualquer diretório."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Quase todos os provedores querem STARTTLS na 587. Alguns querem TLS na 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Nenhum endereço definido."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Só ao fazer login com um provedor: do aplicativo registrado nele. Pergunte a quem administra esta instância se há um para compartilhar."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Senha"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Porta"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Enviar de"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Envie do seu próprio endereço, pelo seu próprio servidor de e-mail, em vez de a partir desta instância. O que sai leva o seu nome e o seu domínio, e uma resposta ou uma devolução volta para você. Desligado, nada muda no que esta instância envia por conta própria — notificações, códigos de acesso, voltar a entrar."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Servidor"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Entrar com"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Armazenada criptografada e nunca mais exibida. Muitos provedores pedem aqui uma senha específica de app em vez da senha que você usa para entrar."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "O endereço que os destinatários verão e para onde irão as respostas. Seu servidor de e-mail precisa estar autorizado a enviar a partir dele."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Nome de usuário"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Seu próprio e-mail"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Sua senha ou seu token atravessaria a rede sem criptografia. Escolha STARTTLS ou TLS desde o primeiro byte em Criptografia."
