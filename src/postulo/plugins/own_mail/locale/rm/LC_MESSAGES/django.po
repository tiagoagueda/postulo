#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 per STARTTLS, 465 per TLS dapi l'emprim byte."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "In pled-clav è adattà per Voss agen server dad e-mail. Tschernai Voss purschider per s'annunziar sin sia atgna pagina, quai che Microsoft 365 vegn a pretender."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "In pled-clav u in pled-clav d'applicaziun"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID dal client"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Secret dal client"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID dal register (tenant)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Criptaziun"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Mo Microsoft. Laschai vid per acceptar mintga register."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Quasi mintga purschider vul STARTTLS sin 587. Intgins vulan TLS sin 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Nagina adressa definida."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Mo cura che Vus As annunziais cun in purschider: da l'applicaziun registrada tar el. Dumandai la persuna che maina questa instanza sch'ella ha ina da cundivider."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Pled-clav"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Trametter da"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Trametter da Vossa atgna adressa, via Voss agen server dad e-mail, empè da questa instanza. Quai che parta porta Voss num e Vossa domena, ed ina resposta u in return turna tar Vus. Deactivà, na vegn nagut da quai che questa instanza trametta en atgn num — communicaziuns, codes d'annunzia, il return en il conto — pertutgà."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "S'annunziar cun"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Memorisà criptà e mai pli mussà. Blers purschiders vulan qua in pled-clav specific per l'applicaziun empè da quel cun il qual Vus As annunziais."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "L'adressa che destinataris vegnan a vesair e nua che lur respostas vegnan ad ir. Voss server dad e-mail sto avair il dretg da trametter da quella."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Num d'utilisader"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Voss agen e-mail"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Voss pled-clav u Voss token traversass la rait betg criptà. Tschernai STARTTLS u TLS dapi l'emprim byte sut Criptaziun."
