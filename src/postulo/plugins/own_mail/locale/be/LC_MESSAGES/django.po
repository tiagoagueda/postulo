#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 для STARTTLS, 465 для TLS з першага байта."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Пароль падыходзіць для вашага ўласнага паштовага сервера. Каб уваходзіць на старонцы пастаўшчыка, выберыце яго — гэтага патрабуе Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Пароль або пароль праграмы"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID кліента"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Сакрэт кліента"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID даведніка (арандатара)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Шыфраванне"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Толькі для Microsoft. Пакіньце пустым, каб прымаць любы даведнік."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Амаль кожны пастаўшчык патрабуе STARTTLS на порце 587. Некаторыя — TLS на порце 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Адрас не зададзены."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Толькі пры ўваходзе праз пастаўшчыка: з праграмы, зарэгістраванай у ім. Спытайце ў таго, хто адмініструе гэтае ўсталяванне, ці ёсць у яго такая праграма, якой ён можа падзяліцца."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Пароль"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Порт"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Адпраўляць з адраса"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Адпраўляйце пошту са свайго адраса праз свой паштовы сервер, а не з гэтага ўсталявання. Тое, што адпраўляецца, мае ваша імя і ваш дамен, а адказ або вернуты ліст прыходзіць вам. Калі выключана, усё, што гэтае ўсталяванне адпраўляе ад свайго імя — апавяшчэнні, коды ўваходу, аднаўленне доступу, — працуе як раней."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Сервер"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Уваход праз"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Захоўваецца ў зашыфраваным выглядзе і больш ніколі не паказваецца. Многія пастаўшчыкі патрабуюць тут асобны пароль праграмы, а не той, з якім вы ўваходзіце."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Адрас, які ўбачаць атрымальнікі і на які пойдуць іх адказы. Ваш паштовы сервер павінен мець права адпраўляць з яго."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Імя карыстальніка"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Уласная пошта"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Ваш пароль або токен перадаваўся б па сетцы незашыфраваным. Выберыце ў полі «Шыфраванне» STARTTLS або TLS з першага байта."
