#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 за STARTTLS, 465 за TLS од првиот бајт."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Лозинката е соодветна за вашиот сопствен сервер за пошта. Наместо тоа, изберете го вашиот давател за да се најавите на неговата страница, што Microsoft 365 ќе го бара."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Лозинка или лозинка за апликација"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID на клиент"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Тајна на клиент"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID на директориум (закупец)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Шифрирање"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Само Microsoft. Оставете празно за да прифатите кој било директориум."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Речиси секој давател бара STARTTLS на 587. Некои бараат TLS на 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Не е поставена адреса."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Само при најава преку давател: од апликацијата регистрирана кај него. Прашајте го оној што ја одржува оваа инстанца дали има некоја што може да ја сподели."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Лозинка"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Порта"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Испрати од"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Испраќајте од сопствената адреса, преку сопствениот сервер за пошта, наместо од оваа инстанца. Она што заминува го носи вашето име и вашиот домен, а одговорите и вратените пораки стигнуваат кај вас. Кога е исклучено, ништо не се менува во она што оваа инстанца го испраќа во свое име — известувања, кодови за најава, враќање во сметката."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Сервер"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Најава преку"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Се чува шифрирана и повеќе не се прикажува. Многу даватели тука бараат лозинка за апликација наместо онаа со која се најавувате."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Адресата што ќе ја видат примачите и каде ќе одат нивните одговори. Вашиот поштенски сервер мора да има право да испраќа од неа."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Корисничко име"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Вашата сопствена пошта"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Вашата лозинка или токен би минале низ мрежата нешифрирани. Изберете STARTTLS или TLS од првиот бајт под „Шифрирање“."
