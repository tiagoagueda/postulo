#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 για STARTTLS, 465 για TLS από το πρώτο byte."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Ένας κωδικός πρόσβασης αρκεί για τον δικό σας διακομιστή αλληλογραφίας. Αλλιώς, επιλέξτε τον πάροχό σας για να συνδεθείτε στη δική του σελίδα, κάτι που θα απαιτήσει το Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Κωδικός πρόσβασης ή κωδικός εφαρμογής"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Αναγνωριστικό πελάτη"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Μυστικό πελάτη"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Αναγνωριστικό καταλόγου (tenant)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Κρυπτογράφηση"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Μόνο Microsoft. Αφήστε κενό για να γίνεται δεκτός οποιοσδήποτε κατάλογος."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Σχεδόν κάθε πάροχος θέλει STARTTLS στη 587. Κάποιοι θέλουν TLS στη 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Δεν έχει οριστεί διεύθυνση."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Μόνο όταν συνδέεστε μέσω παρόχου: από την εφαρμογή που είναι καταχωρισμένη σε αυτόν. Ρωτήστε όποιον διαχειρίζεται αυτή την εγκατάσταση αν έχει μία να μοιραστεί."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Κωδικός πρόσβασης"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Θύρα"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Αποστολή από"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Αποστολή από τη δική σας διεύθυνση, μέσω του δικού σας διακομιστή αλληλογραφίας, αντί από αυτή την εγκατάσταση. Ό,τι αποστέλλεται φέρει το όνομα και τον τομέα σας, και μια απάντηση ή μια επιστροφή (bounce) έρχεται σε εσάς. Όταν είναι απενεργοποιημένο, όσα στέλνει η εγκατάσταση για δικό της λογαριασμό — ειδοποιήσεις, κωδικοί σύνδεσης, ανάκτηση πρόσβασης — δεν επηρεάζονται."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Διακομιστής"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Σύνδεση με"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Αποθηκεύεται κρυπτογραφημένος και δεν εμφανίζεται ποτέ ξανά. Πολλοί πάροχοι ζητούν εδώ έναν κωδικό ειδικά για εφαρμογές αντί για αυτόν με τον οποίο συνδέεστε."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Η διεύθυνση που θα δουν οι παραλήπτες και όπου θα πάνε οι απαντήσεις τους. Ο διακομιστής αλληλογραφίας σας πρέπει να δικαιούται να στέλνει από αυτήν."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Όνομα χρήστη"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Το δικό σας email"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Ο κωδικός πρόσβασης ή το διακριτικό σας θα διέσχιζε το δίκτυο χωρίς κρυπτογράφηση. Επιλέξτε STARTTLS ή TLS από το πρώτο byte στο πεδίο «Κρυπτογράφηση»."
