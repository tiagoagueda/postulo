#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 a STARTTLS-hez, 465 a TLS-hez az első bájttól."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "A jelszó a saját levelezőkiszolgálójához megfelelő. Ehelyett kiválaszthatja a szolgáltatóját is, és annak saját oldalán jelentkezhet be — a Microsoft 365 ezt megköveteli."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Jelszó vagy alkalmazásjelszó"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Ügyfél-azonosító"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Ügyfélkulcs"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Címtár- (bérlő-) azonosító"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Titkosítás"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Csak Microsoft esetén. Hagyja üresen, ha bármely címtár elfogadható."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Szinte minden szolgáltató STARTTLS-t kér az 587-es porton, néhány TLS-t a 465-ösön."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Nincs cím megadva."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Csak szolgáltatón keresztüli bejelentkezéskor: a nála regisztrált alkalmazásból. Kérdezze meg a példány üzemeltetőjét, van-e megosztható."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Jelszó"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Feladó címe"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Küldés a saját címéről, a saját levelezőkiszolgálóján keresztül, nem pedig ebből a példányból. Ami elmegy, az Ön nevét és tartományát viseli, a válasz vagy a visszapattanó levél pedig Önhöz érkezik vissza. Kikapcsolva mindaz, amit ez a példány a saját nevében küld — értesítések, bejelentkezési kódok, fiók-helyreállítás —, változatlanul működik."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Kiszolgáló"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Bejelentkezés módja"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Titkosítva tárolva, és többé nem jelenik meg. Sok szolgáltató itt alkalmazásjelszót kér a bejelentkezéshez használt jelszó helyett."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "A cím, amelyet a címzettek látnak, és ahová a válaszaik érkeznek. A levelezőkiszolgálónak jogosultnak kell lennie arra, hogy erről a címről küldjön."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Felhasználónév"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Saját e-mail"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "A jelszava vagy tokenje titkosítatlanul haladna át a hálózaton. Válassza a STARTTLS-t vagy a TLS-t az első bájttól a Titkosítás alatt."
