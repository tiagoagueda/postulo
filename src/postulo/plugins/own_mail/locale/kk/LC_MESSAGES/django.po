#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "STARTTLS үшін 587, бірінші байттан бастап TLS үшін 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Құпия сөз өзіңіздің пошта серверіңіз үшін жарамды. Оның орнына провайдеріңізді таңдап, оның өз бетінде кіріңіз; Microsoft 365 мұны талап етеді."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Құпия сөз немесе қолданба құпия сөзі"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "Клиент ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Клиент құпиясы"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Каталог (тенант) ID"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Шифрлау"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Тек Microsoft үшін. Кез келген каталогты қабылдау үшін бос қалдырыңыз."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Провайдерлердің барлығы дерлік 587 портында STARTTLS талап етеді. Кейбіреулері 465 портында TLS талап етеді."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Мекенжай орнатылмаған."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Тек провайдер арқылы кіргенде: онда тіркелген қолданбадан алынады. Осы дананы басқаратын адамнан бөлісуге болатын қолданба бар-жоғын сұраңыз."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Құпия сөз"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Порт"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Жіберуші мекенжай"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Хаттарды осы данадан емес, өз мекенжайыңыздан, өз пошта серверіңіз арқылы жіберіңіз. Жіберілген хатта сіздің атыңыз бен доменіңіз болады, ал жауап немесе қайтарылған хат сізге оралады. Сөндірулі болса, осы дана өз атынан жіберетін нәрселердің бәріне — хабарландыруларға, кіру кодтарына, тіркелгіге қайта кіруге — әсер етпейді."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Сервер"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Кіру тәсілі"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Шифрланып сақталады және қайта көрсетілмейді. Көптеген провайдерлер мұнда кіру құпия сөзінің орнына қолданбаға арналған құпия сөзді талап етеді."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Алушылар көретін мекенжай және олардың жауаптары баратын жер. Пошта серверіңіздің осы мекенжайдан хат жіберуге құқығы болуы керек."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Пайдаланушы аты"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Өз электрондық поштаңыз"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Құпия сөзіңіз немесе токеніңіз желі арқылы шифрланбай жіберілер еді. «Шифрлау» өрісінде STARTTLS немесе бірінші байттан бастап TLS таңдаңыз."
