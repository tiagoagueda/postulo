#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 ar gyfer STARTTLS, 465 ar gyfer TLS o'r beit cyntaf."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Mae cyfrinair yn iawn ar gyfer eich gweinydd e-bost eich hun. Dewiswch eich darparwr i fewngofnodi ar ei dudalen ei hun yn lle hynny, a bydd Microsoft 365 yn mynnu hynny."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Cyfrinair, neu gyfrinair ap"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID cleient"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Cyfrinach cleient"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID cyfeiriadur (tenant)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Amgryptio"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Microsoft yn unig. Gadewch yn wag i dderbyn unrhyw gyfeiriadur."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Mae bron pob darparwr eisiau STARTTLS ar 587. Mae rhai eisiau TLS ar 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Dim cyfeiriad wedi'i osod."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Dim ond wrth fewngofnodi gyda darparwr: o’r rhaglen sydd wedi’i chofrestru gydag ef. Gofynnwch i bwy bynnag sy’n rhedeg yr achos hwn a oes ganddynt un i’w rannu."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
