#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Anfonwch o'ch cyfeiriad eich hun, drwy eich gweinydd e-bost eich hun, yn hytrach nag o'r enghraifft hon. Mae'r hyn sy'n gadael yn cario eich enw a'ch parth, ac mae ateb neu sborion yn dod yn ôl atoch chi. Wedi'i ddiffodd, nid oes dim yn newid yn yr hyn y mae'r enghraifft hon yn ei anfon ar ei liwt ei hun — hysbysiadau, codau mewngofnodi, y ffordd yn ôl i mewn."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Gweinydd"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Mewngofnodi gyda"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Wedi'i storio wedi'i amgryptio ac ni chaiff ei ddangos eto. Mae llawer o ddarparwyr eisiau cyfrinair penodol i'r ap yma yn lle'r un rydych yn mewngofnodi ag ef."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Y cyfeiriad y bydd derbynwyr yn ei weld a lle bydd eu hatebion yn mynd. Rhaid i'ch gweinydd e-bost fod â hawl i anfon ohono."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Enw defnyddiwr"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Eich e-bost eich hun"

#: src/postulo/plugins/own_mail/__init__.py
