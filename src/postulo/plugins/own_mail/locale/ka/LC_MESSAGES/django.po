#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 STARTTLS-ისთვის, 465 TLS-ისთვის პირველივე ბაიტიდან."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "პაროლი გამოდგება თქვენი საკუთარი საფოსტო სერვერისთვის. სანაცვლოდ შეგიძლიათ აირჩიოთ თქვენი პროვაიდერი და შეხვიდეთ მის საკუთარ გვერდზე — Microsoft 365 სწორედ ამას მოითხოვს."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "პაროლი ან აპლიკაციის პაროლი"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "კლიენტის ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "კლიენტის საიდუმლო"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "დირექტორიის (მოიჯარის) ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "დაშიფვრა"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "მხოლოდ Microsoft. დატოვეთ ცარიელი ნებისმიერი დირექტორიის მისაღებად."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "თითქმის ყველა პროვაიდერი იყენებს STARTTLS-ს 587 პორტზე. ზოგი — TLS-ს 465 პორტზე."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "მისამართი მითითებული არ არის."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "მხოლოდ პროვაიდერით შესვლისას: მასთან რეგისტრირებული აპლიკაციიდან. ჰკითხეთ ამ ინსტალაციის ადმინისტრატორს, აქვს თუ არა გასაზიარებელი."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "პაროლი"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "პორტი"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "გამგზავნის მისამართი"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "გააგზავნეთ წერილები თქვენივე მისამართიდან, თქვენივე საფოსტო სერვერით და არა ამ ინსტალაციიდან. გაგზავნილს თქვენი სახელი და დომენი ექნება, პასუხი ან დაბრუნებული წერილი კი თქვენთან მოვა. გამორთვის შემთხვევაში არაფერი იცვლება იმაში, რასაც ეს ინსტალაცია თავისი სახელით აგზავნის: შეტყობინებები, შესვლის კოდები, ანგარიშზე წვდომის აღდგენა."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "სერვერი"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "შესვლა:"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "ინახება დაშიფრულად და აღარასოდეს ჩანს. ბევრი პროვაიდერი აქ ითხოვს აპლიკაციისთვის განკუთვნილ ცალკე პაროლს და არა იმას, რომლითაც შედიხართ."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "მისამართი, რომელსაც მიმღებები დაინახავენ და სადაც მათი პასუხები წავა. თქვენს საფოსტო სერვერს უფლება უნდა ჰქონდეს, ამ მისამართიდან გააგზავნოს."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "მომხმარებლის სახელი"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "თქვენივე ფოსტა"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "თქვენი პაროლი ან ტოკენი ქსელში დაუშიფრავად გადაიცემოდა. ველში „დაშიფვრა“ აირჩიეთ STARTTLS ან TLS პირველივე ბაიტიდან."
