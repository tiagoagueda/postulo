#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 za STARTTLS, 465 za TLS od prvog bajta."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Lozinka je prava za vaš vlastiti mail server. Odaberite svog pružaoca da se umjesto toga prijavite na njegovoj stranici, što će Microsoft 365 zahtijevati."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Lozinka ili lozinka aplikacije"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID klijenta"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Tajna klijenta"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID direktorija (zakupca)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Šifriranje"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Samo Microsoft. Ostavite prazno za prihvatanje bilo kojeg direktorija."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Skoro svaki provajder želi STARTTLS na 587. Neki žele TLS na 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Adresa nije postavljena."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Samo pri prijavi preko pružaoca: iz aplikacije registrovane kod njega. Pitajte onoga ko vodi ovu instancu ima li neku za dijeljenje."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Lozinka"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Pošalji s"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Šaljite sa svoje adrese, preko svog mail servera, umjesto s ove instance. Ono što odlazi nosi vaše ime i vaš domen, a odgovor ili povrat vraća se vama. Isključeno, ništa se ne mijenja u onome što ova instanca šalje za svoj račun — obavještenja, kodovi za prijavu, put nazad."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Prijava putem"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Pohranjena šifrirano i nikad se više ne prikazuje. Mnogi provajderi ovdje žele lozinku specifičnu za aplikaciju umjesto one kojom se prijavljujete."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adresa koju će primaoci vidjeti i na koju će ići njihovi odgovori. Vaš mail server mora imati pravo slati s nje."

