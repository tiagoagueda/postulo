#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 – STARTTLS, 465 – TLS nuo pirmojo baito."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Slaptažodis tinka jūsų pačių pašto serveriui. Užuot jį naudoję, pasirinkite teikėją ir prisijunkite jo puslapyje – to reikalaus Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Slaptažodis arba programos slaptažodis"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Kliento ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Kliento paslaptis"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Katalogo (nuomininko) ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Šifravimas"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Tik Microsoft. Palikite tuščią, kad būtų priimamas bet kuris katalogas."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Beveik visi teikėjai naudoja STARTTLS per 587 prievadą. Kai kurie – TLS per 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Adresas nenurodytas."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Tik prisijungiant per teikėją: iš jame užregistruotos programos. Paklauskite šio egzemplioriaus operatoriaus, ar jis turi tokią, kuria gali pasidalyti."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Slaptažodis"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Prievadas"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Siųsti iš"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Siųsti iš savo adreso per savo pašto serverį, o ne iš šio egzemplioriaus. Išsiųsti laiškai neša jūsų vardą ir domeną, o atsakymai ir grąžinti laiškai grįžta jums. Išjungus tai, ką šis egzempliorius siunčia savo vardu — pranešimai, prisijungimo kodai, prieigos atkūrimas, — nepasikeičia."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Serveris"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Prisijungti per"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Saugomas užšifruotas ir daugiau nerodomas. Daugelis teikėjų čia reikalauja programai skirto slaptažodžio, o ne to, kuriuo prisijungiate."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adresas, kurį matys gavėjai ir į kurį eis jų atsakymai. Jūsų pašto serveris turi turėti teisę siųsti iš jo."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Naudotojo vardas"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Jūsų pačių el. paštas"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Jūsų slaptažodis ar žetonas keliautų tinklu neužšifruotas. Skiltyje „Šifravimas“ pasirinkite STARTTLS arba TLS nuo pirmojo baito."
