#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 fyrir STARTTLS, 465 fyrir TLS frá fyrsta bæti."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Lykilorð hentar þínum eigin póstþjóni. Veldu veituna þína til að skrá þig frekar inn á hennar eigin síðu, sem Microsoft 365 mun krefjast."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Lykilorð, eða forritslykilorð"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Auðkenni biðlara"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Leynilykill biðlara"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Auðkenni möppu (leigjanda)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Dulritun"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Aðeins Microsoft. Hafðu autt til að taka við hvaða möppu sem er."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Næstum allir þjónustuaðilar vilja STARTTLS á 587. Sumir vilja TLS á 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Ekkert netfang stillt."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Aðeins við innskráningu með veitu: úr forritinu sem er skráð hjá henni. Spurðu þann sem rekur þessa uppsetningu hvort hann hafi eitt sem hann getur deilt."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Lykilorð"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Gátt"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Senda frá"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Sendu frá þínu eigin netfangi um þinn eigin póstþjón í stað þessarar uppsetningar. Það sem fer út ber nafn þitt og lén þitt, og svör eða endursendur póstur koma aftur til þín. Sé slökkt á þessu breytist ekkert af því sem þessi uppsetning sendir fyrir eigin reikning — tilkynningar, innskráningarkóðar, leiðin aftur inn."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Netþjónn"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Skrá inn með"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Geymt dulritað og aldrei sýnt aftur. Margir þjónustuaðilar vilja forritssértækt lykilorð hér frekar en það sem þú skráir þig inn með."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Netfangið sem viðtakendur sjá og þangað sem svör þeirra fara. Póstþjónninn þinn verður að hafa heimild til að senda frá því."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Notandanafn"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Þinn eigin tölvupóstur"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Lykilorðið þitt eða teiknið færi ódulritað yfir netið. Veldu STARTTLS eða TLS frá fyrsta bæti undir Dulritun."
