#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 voor STARTTLS, 465 voor TLS vanaf de eerste byte."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Een wachtwoord is geschikt voor uw eigen mailserver. Kies in plaats daarvan uw aanbieder om op diens eigen pagina in te loggen; Microsoft 365 vereist dat."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Een wachtwoord, of een app-wachtwoord"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "Client-ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Clientgeheim"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Directory-ID (tenant)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Versleuteling"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Alleen Microsoft. Laat leeg om elke directory te accepteren."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Bijna elke aanbieder wil STARTTLS op 587. Sommige willen TLS op 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Geen adres ingesteld."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Alleen bij inloggen via een aanbieder: van de applicatie die daar is geregistreerd. Vraag de beheerder van deze instantie of die er een heeft om te delen."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Wachtwoord"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Poort"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Verzenden vanaf"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Verstuur vanaf uw eigen adres, via uw eigen mailserver, in plaats van vanaf deze instantie. Wat vertrekt, draagt uw naam en uw domein, en een antwoord of een bounce komt bij u terug. Uitgeschakeld verandert er niets aan wat deze instantie voor eigen rekening verstuurt — meldingen, inlogcodes, weer toegang krijgen."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Inloggen met"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Versleuteld opgeslagen en nooit teruggetoond. Veel aanbieders willen hier een app-specifiek wachtwoord in plaats van het wachtwoord waarmee u inlogt."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Het adres dat ontvangers zien en waar hun antwoorden heen gaan. Uw mailserver moet gemachtigd zijn om vanaf dat adres te verzenden."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Gebruikersnaam"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Uw eigen e-mail"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Uw wachtwoord of token zou onversleuteld over het netwerk gaan. Kies STARTTLS of TLS vanaf de eerste byte onder Versleuteling."
