#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 għal STARTTLS, 465 għal TLS mill-ewwel byte."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Password hija t-tajba għas-server tal-posta tiegħek. Agħżel il-fornitur tiegħek biex minflok tidħol fil-paġna tiegħu, ħaġa li Microsoft 365 se jitlob."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Password, jew password tal-app"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID tal-klijent"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Sigriet tal-klijent"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID tad-direttorju (kerrej)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Kriptaġġ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Microsoft biss. Ħallih vojt biex taċċetta kull direttorju."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Kważi kull fornitur irid STARTTLS fuq 587. Xi wħud iridu TLS fuq 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "L-ebda indirizz issettjat."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Biss meta tidħol permezz ta’ fornitur: mill-applikazzjoni rreġistrata miegħu. Staqsi lil min imexxi din l-istanza jekk għandux waħda x’jaqsam."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Password"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Ibgħat minn"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Ibgħat mill-indirizz tiegħek stess, mis-server tal-posta tiegħek stess, minflok minn din l-istanza. Dak li joħroġ iġorr ismek u d-dominju tiegħek, u tweġiba jew ritorn jiġi lura għandek. Mitfi, xejn ma jinbidel f'dak li din l-istanza tibgħat għaliha nfisha — notifiki, kodiċi tad-dħul, it-triq lura."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Server"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Idħol b’"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Maħżuna kriptata u qatt ma tintwera mill-ġdid. Ħafna fornituri jridu hawn password speċifika għall-applikazzjoni minflok dik li tidħol biha."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "L-indirizz li r-riċevituri se jaraw u fejn imorru t-tweġibiet tagħhom. Is-server tal-posta tiegħek irid ikun intitolat jibgħat minnu."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Isem tal-utent"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Il-posta tiegħek stess"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Il-password jew it-token tiegħek jaqsmu n-netwerk mhux kriptati. Agħżel STARTTLS jew TLS mill-ewwel byte taħt Encryption."
