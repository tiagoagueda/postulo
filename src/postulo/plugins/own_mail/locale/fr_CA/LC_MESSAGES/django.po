#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 pour STARTTLS, 465 pour TLS du premier octet."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Un mot de passe est approprié pour votre propre serveur de messagerie. Choisissez votre fournisseur pour se connecter sur sa propre page à la place, ce que Microsoft 365 exigera."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Un mot de passe ou un mot de passe d'application"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID client"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Secret client"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Numéro d'identification du répertoire"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Chiffrement"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Microsoft seulement. Laisser en blanc pour accepter n'importe quel répertoire."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Presque tous les fournisseurs veulent STARTTLS sur 587. Certains veulent TLS sur 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Pas d'adresse."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Seulement lors de la signature avec un fournisseur: de la demande enregistrée avec lui. Demandez à celui qui dirige cette instance s'il en a un à partager."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Mot de passe"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Envoyer depuis"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Envoyez depuis votre propre adresse, sur votre propre serveur de messagerie, plutôt que depuis cette instance. Ce qui laisse porte votre nom et votre domaine, et une réponse ou un rebond vous revient. Désactivé, tout ce que cette instance envoie pour son propre compte — notifications, codes de connexion, retour — n'est pas affecté."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Serveur"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Connexion avec"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Stocké crypté et jamais montré. Beaucoup de fournisseurs veulent un mot de passe spécifique à l'application ici plutôt que celui avec lequel vous vous connectez."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Les destinataires de l'adresse verront, et où leurs réponses iront. Votre serveur de messagerie doit pouvoir l'envoyer."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Nom d'utilisateur"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Votre propre email"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Votre mot de passe ou jeton traverserait le réseau non chiffré. Choisissez STARTTLS ou TLS à partir du premier octet sous Encryption."
