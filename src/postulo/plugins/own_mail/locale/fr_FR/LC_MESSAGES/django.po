#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 pour STARTTLS, 465 pour TLS dès le premier octet."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Un mot de passe convient à votre propre serveur de messagerie. Choisissez plutôt votre fournisseur pour vous connecter sur sa propre page, ce que Microsoft 365 exigera."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Un mot de passe, ou un mot de passe d'application"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID client"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Secret client"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID de l'annuaire (locataire)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Chiffrement"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Microsoft uniquement. Laissez vide pour accepter n'importe quel annuaire."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Presque tous les fournisseurs demandent STARTTLS sur le port 587. Certains demandent TLS sur le 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Aucune adresse définie."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Uniquement pour une connexion via un fournisseur : fourni par l'application enregistrée auprès de lui. Demandez à la personne qui gère cette instance si elle en a une à partager."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Mot de passe"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Envoyer depuis"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Envoyez depuis votre propre adresse, par votre propre serveur de messagerie, plutôt que depuis cette instance. Ce qui part porte votre nom et votre domaine, et une réponse ou un rejet vous revient. Désactivé, tout ce que cette instance envoie pour son propre compte — notifications, codes de connexion, récupération d'accès — n'est pas affecté."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Serveur"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Se connecter avec"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Conservé chiffré et jamais réaffiché. Beaucoup de fournisseurs demandent ici un mot de passe propre à l'application plutôt que celui avec lequel vous vous connectez."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "L'adresse que verront les destinataires, et à laquelle iront leurs réponses. Votre serveur de messagerie doit être autorisé à envoyer depuis cette adresse."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Nom d'utilisateur"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Votre propre messagerie"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Votre mot de passe ou votre jeton circulerait sur le réseau sans chiffrement. Choisissez STARTTLS ou TLS dès le premier octet sous Chiffrement."
