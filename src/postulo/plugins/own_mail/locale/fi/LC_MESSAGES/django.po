#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 STARTTLS:lle, 465 TLS:lle ensimmäisestä tavusta."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Salasana sopii omalle sähköpostipalvelimellesi. Valitse palveluntarjoajasi kirjautuaksesi sen sijaan sen omalla sivulla, mitä Microsoft 365 tulee vaatimaan."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Salasana tai sovellussalasana"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "Asiakastunnus"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Asiakassalaisuus"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "Hakemiston (vuokraajan) tunnus"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Salaus"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Vain Microsoft. Jätä tyhjäksi hyväksyäksesi minkä tahansa hakemiston."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Lähes jokainen palveluntarjoaja haluaa STARTTLS:n porttiin 587. Jotkin haluavat TLS:n porttiin 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Osoitetta ei ole asetettu."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Vain kirjauduttaessa palveluntarjoajan kautta: siellä rekisteröidystä sovelluksesta. Kysy tämän instanssin ylläpitäjältä, onko hänellä jaettavaa sovellusta."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Salasana"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Portti"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Lähetä osoitteesta"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Lähetä omasta osoitteestasi oman postipalvelimesi kautta tämän instanssin sijaan. Lähtevä posti kantaa nimesi ja verkkotunnuksesi, ja vastaus tai palautus tulee sinulle. Pois päältä mikään ei muutu siinä, mitä tämä instanssi lähettää omaan lukuunsa — ilmoitukset, kirjautumiskoodit, tie takaisin sisään."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Palvelin"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Kirjaudu palvelulla"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Tallennetaan salattuna eikä näytetä enää. Monet palveluntarjoajat haluavat tähän sovelluskohtaisen salasanan kirjautumissalasanan sijaan."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Osoite, jonka vastaanottajat näkevät ja johon heidän vastauksensa menevät. Postipalvelimellasi on oltava oikeus lähettää siitä."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Käyttäjätunnus"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "Oma sähköpostisi"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Salasanasi tai tunnuksesi kulkisi verkon yli salaamattomana. Valitse STARTTLS tai TLS heti ensimmäisestä tavusta kohdasta Salaus."
