#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 per a STARTTLS, 465 per a TLS des del primer byte."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Una contrasenya és adequada per al vostre propi servidor de correu. Trieu el vostre proveïdor per iniciar la sessió a la seva pròpia pàgina; Microsoft 365 ho exigirà."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Una contrasenya o una contrasenya d'aplicació"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID de client"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Secret de client"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID del directori (inquilí)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Xifratge"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Només Microsoft. Deixeu-ho en blanc per acceptar qualsevol directori."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Gairebé tots els proveïdors volen STARTTLS al 587. Alguns volen TLS al 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "No s'ha definit cap adreça."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Només si s'inicia la sessió amb un proveïdor: de l'aplicació registrada en aquest proveïdor. Pregunteu a qui administra aquesta instància si en té una per compartir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Contrasenya"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Envia des de"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Envieu des de la vostra pròpia adreça, a través del vostre servidor de correu, en lloc de des d'aquesta instància. El que surt porta el vostre nom i el vostre domini, i les respostes o els rebots tornen a vós. Si es desactiva, tot el que aquesta instància envia pel seu compte (notificacions, codis d'inici de sessió, recuperació de l'accés) no es veu afectat."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Servidor"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Inicia la sessió amb"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Es desa xifrada i no es torna a mostrar mai. Molts proveïdors demanen aquí una contrasenya específica d'aplicació en lloc de la que feu servir per iniciar la sessió."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "L'adreça que veuran els destinataris i on aniran les seves respostes. El vostre servidor de correu ha de tenir permís per enviar des d'aquesta adreça."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Nom d'usuari"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "El vostre propi correu"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "La vostra contrasenya o el vostre testimoni viatjarien per la xarxa sense xifrar. Trieu STARTTLS o TLS des del primer byte a Xifratge."
