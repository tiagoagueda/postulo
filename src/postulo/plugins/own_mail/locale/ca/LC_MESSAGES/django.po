#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 per a STARTTLS, 465 per a TLS des del primer byte."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Una contrasenya és el que cal per al teu propi servidor de correu. Tria el teu proveïdor per iniciar sessió a la seva pàgina, cosa que Microsoft 365 exigirà."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "Una contrasenya, o una contrasenya d’aplicació"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "ID de client"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "Secret de client"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ID de directori (inquilí)"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "Xifratge"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Només Microsoft. Deixa-ho en blanc per acceptar qualsevol directori."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Gairebé tots els proveïdors volen STARTTLS al 587. Alguns volen TLS al 465."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "Cap adreça definida."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Només en iniciar sessió amb un proveïdor: de l’aplicació registrada amb ell. Pregunta a qui gestiona aquesta instància si en té una per compartir."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "Contrasenya"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "Port"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "Envia des de"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Envieu des de la vostra adreça, pel vostre servidor de correu, en lloc de des d'aquesta instància. El que surt duu el vostre nom i el vostre domini, i una resposta o un rebot us torna a vós. Desactivat, no canvia res del que aquesta instància envia pel seu compte: notificacions, codis d'accés, tornar a entrar."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "Servidor"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "Inicia sessió amb"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Es desa xifrada i no es torna a mostrar. Molts proveïdors volen aquí una contrasenya específica de l'aplicació en lloc de la d'accés."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "L'adreça que veuran els destinataris i on aniran les seves respostes. El vostre servidor de correu ha de tenir dret a enviar-hi des d'ella."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "Nom d'usuari"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "El vostre propi correu"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "La vostra contrasenya o fitxa creuarien la xarxa sense xifrar. Escolliu RTTLS o TLS des del primer byte sota encriptatge. @ info: whatsthis."
