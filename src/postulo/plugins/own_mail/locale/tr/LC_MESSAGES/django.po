#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "STARTTLS için 587, ilk bayttan itibaren TLS için 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Kendi posta sunucunuz için parola doğru seçimdir. Bunun yerine sağlayıcının kendi sayfasında giriş yapmak için sağlayıcınızı seçin; Microsoft 365 bunu gerektirir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Parola ya da uygulama parolası"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "İstemci kimliği"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "İstemci gizli anahtarı"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "Dizin (kiracı) kimliği"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Şifreleme"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Yalnızca Microsoft. Her dizini kabul etmek için boş bırakın."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Neredeyse her sağlayıcı 587'de STARTTLS ister. Bazıları 465'te TLS ister."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Adres ayarlanmadı."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Yalnızca bir sağlayıcıyla giriş yaparken: sağlayıcıya kayıtlı uygulamadan alınır. Bu kurulumu yöneten kişiye paylaşabileceği bir tane olup olmadığını sorun."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Parola"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Bağlantı noktası"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Şuradan gönder"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Bu kurulum yerine kendi adresinizden, kendi posta sunucunuz üzerinden gönderin. Giden ileti adınızı ve alan adınızı taşır; bir yanıt ya da geri dönen ileti size gelir. Kapatıldığında bu kurulumun kendi adına gönderdiği hiçbir şey etkilenmez — bildirimler, giriş kodları, hesaba geri dönüş."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Sunucu"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Şununla giriş yap"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Şifrelenmiş olarak saklanır ve bir daha gösterilmez. Birçok sağlayıcı burada giriş yaptığınız parola yerine uygulamaya özel bir parola ister."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Alıcıların göreceği ve yanıtlarının gideceği adres. Posta sunucunuzun bu adresten göndermeye yetkisi olmalı."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Kullanıcı adı"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Kendi e-postanız"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Parolanız ya da belirteciniz ağda şifrelenmeden iletilirdi. Şifreleme bölümünde STARTTLS'i ya da ilk bayttan itibaren TLS'i seçin."
