#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 za STARTTLS, 465 za TLS od prvega bajta."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Geslo je primerno za vaš lastni poštni strežnik. Če se želite namesto tega prijaviti na strani ponudnika, kar zahteva Microsoft 365, izberite svojega ponudnika."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Geslo ali geslo za aplikacije"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID odjemalca"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Skrivnost odjemalca"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID imenika (najemnika)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Šifriranje"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Samo za Microsoft. Pustite prazno, če želite sprejeti kateri koli imenik."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Skoraj vsak ponudnik zahteva STARTTLS na vratih 587. Nekateri zahtevajo TLS na vratih 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Naslov ni nastavljen."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Samo pri prijavi prek ponudnika: iz aplikacije, registrirane pri njem. Vprašajte skrbnika te instance, ali ima kakšno, ki jo lahko deli z vami."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Geslo"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Vrata"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Pošlji z naslova"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Pošiljajte s svojega naslova prek svojega poštnega strežnika namesto s te instance. Kar odide, nosi vaše ime in vašo domeno, odgovor ali vrnjeno sporočilo pa pride nazaj k vam. Ko je izklopljeno, to ne vpliva na nič, kar ta instanca pošilja v svojem imenu — obvestila, kode za prijavo, obnovitev dostopa."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Strežnik"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Prijava z"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Shranjeno šifrirano in nikoli več prikazano. Mnogi ponudniki tukaj želijo geslo za aplikacijo namesto tistega, s katerim se prijavljate."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Naslov, ki ga bodo videli prejemniki in kamor bodo šli njihovi odgovori. Vaš poštni strežnik mora imeti pravico pošiljati z njega."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Uporabniško ime"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Vaša lastna e-pošta"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Vaše geslo ali žeton bi po omrežju potoval nešifrirano. Pod Šifriranje izberite STARTTLS ali TLS od prvega bajta."
