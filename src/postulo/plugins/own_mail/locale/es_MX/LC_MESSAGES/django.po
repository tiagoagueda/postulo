#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 para STARTTLS, 465 para TLS desde el primer byte."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Una contraseña sirve para tu propio servidor de correo. En su lugar, elige tu proveedor para iniciar sesión en su propia página, como exige Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Una contraseña o una contraseña de aplicación"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID de cliente"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Secreto de cliente"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID de directorio (inquilino)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Cifrado"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Solo Microsoft. Déjalo en blanco para aceptar cualquier directorio."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Casi todos los proveedores usan STARTTLS en el 587. Algunos usan TLS en el 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Sin dirección definida."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Solo al iniciar sesión con un proveedor: se obtiene de la aplicación registrada en él. Pregúntale a la persona que administra esta instancia si tiene una que pueda compartir."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Contraseña"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Puerto"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Enviar desde"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Envía desde tu propia dirección, a través de tu propio servidor de correo, en lugar de desde esta instancia. Lo que sale lleva tu nombre y tu dominio, y las respuestas o los rebotes vuelven a ti. Desactivado, todo lo que esta instancia envía por su cuenta — notificaciones, códigos de inicio de sesión, recuperación del acceso — no se ve afectado."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Servidor"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Iniciar sesión con"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Se guarda cifrada y no se vuelve a mostrar. Muchos proveedores piden aquí una contraseña específica de aplicación en lugar de la que usas para iniciar sesión."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "La dirección que verán los destinatarios y a la que irán sus respuestas. Tu servidor de correo tiene que estar autorizado para enviar desde ella."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Nombre de usuario"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Tu propio correo"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Tu contraseña o token viajaría por la red sin cifrar. Elige STARTTLS o TLS desde el primer byte en Cifrado."
