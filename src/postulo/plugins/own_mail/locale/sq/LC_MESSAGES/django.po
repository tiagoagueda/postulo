#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 për STARTTLS, 465 për TLS që nga bajti i parë."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "Një fjalëkalim është i përshtatshëm për serverin tuaj të postës. Përndryshe, zgjidhni ofruesin tuaj për të hyrë në faqen e tij, gjë që e kërkon Microsoft 365."

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "Një fjalëkalim, ose një fjalëkalim aplikacioni"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "ID klienti"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "Sekret klienti"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ID direktorie (qiramarrësi)"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "Enkriptimi"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "Vetëm për Microsoft. Lëreni bosh për të pranuar çdo direktori."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "Pothuajse çdo ofrues kërkon STARTTLS në 587. Disa kërkojnë TLS në 465."

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "Nuk është caktuar asnjë adresë."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "Vetëm kur hyni me një ofrues: nga aplikacioni i regjistruar te ai. Pyetni atë që administron këtë instancë nëse ka një për të ndarë."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "Fjalëkalimi"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "Porta"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "Dërgo nga"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "Dërgoni nga adresa juaj, përmes serverit tuaj të postës, në vend të kësaj instance. Ajo që dërgohet mban emrin dhe domenin tuaj, dhe një përgjigje ose një kthim mesazhi vjen te ju. Kur është çaktivizuar, gjithçka që kjo instancë dërgon në emër të vet — njoftimet, kodet e hyrjes, rikthimi në llogari — nuk preket."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "Serveri"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "Hyr me"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "Ruhet i enkriptuar dhe nuk shfaqet më. Shumë ofrues kërkojnë këtu një fjalëkalim specifik aplikacioni në vend të atij me të cilin hyni."

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "Adresa që do të shohin marrësit dhe ku do të shkojnë përgjigjet e tyre. Serveri juaj i postës duhet të ketë të drejtë të dërgojë prej saj."

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "Emri i përdoruesit"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "Emaili juaj"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "Fjalëkalimi ose tokeni juaj do të kalonte nëpër rrjet i paenkriptuar. Te Enkriptimi zgjidhni STARTTLS ose TLS që nga bajti i parë."
