#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "587 for FormTLS, 465 from TLS."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "پاس ورڈ آپ کے اپنے میل سرور کے لیے ٹھیک ہے. اپنی جگہ پر دستخط کرنے کے لیے اپنا فراہم کُنندہ منتخب کریں جسے مائکروسوفٹ 365 کا تقاضا کرے گا۔."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "A password, or an app password"
msgstr "پاس ورڈ یا کوئی اطلاقیہ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client ID"
msgstr "کلنٹ آئی ڈی"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Client secret"
msgstr "راز"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Directory (tenant) ID"
msgstr "ڈائریکٹری (ٹیننٹ) آئی ڈی:"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Encryption"
msgstr "غیر متصل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "مائیکروسافٹ صرف۔ کسی بھی ڈائریکٹری قبول کرنے کے لئے نامزدگی چھوڑ دیں۔."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "تقریباً ہر فراہم کنندہ 587 پر جی ٹی ایل ایس چاہتا ہے۔ کچھ 465 پر TLS چاہتے ہیں۔."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "No address set."
msgstr "کوئی پتہ نہیں."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "صرف فراہم کُنندہ کے دستخط پر مشتمل ہے: اِس سلسلے میں ایک مثال پر غور کریں ۔."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Password"
msgstr "پاس ورڈ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Port"
msgstr "پورٹ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from"
msgstr "بھیجو"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "اپنے ذاتی پتہ سے، اپنے ذاتی میل سرور پر، اس واقعے کی بجائے. جو کچھ نکلتا ہے وہ آپ کا نام اور آپ کا ڈومین رکھتا ہے اور جواب یا بونے والا آپ کے پاس واپس آتا ہے۔ سونیا کی مثال سے ظاہر ہوتا ہے کہ یہ سب کچھ اپنے اکاؤنٹ پر بھیج دیتا ہے — اطلاعات ، اشاروں کے کوڈ وغیرہ —."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Server"
msgstr "سرور"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Sign in with"
msgstr "علامات کے ساتھ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "دفن کیا گیا اور کبھی واپس نہیں دکھایا. بہت سے فراہم کنندگان یہاں ایک ایپ شناختی سند چاہتے ہیں بجائے کہ آپ کے ساتھ کوئی نشان ہو۔."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "اُن کا جواب کیا ہوگا ؟ آپ کے ڈاک سرور کو اس سے بھیجنے کا حق ہے۔."

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Username"
msgstr "پرنٹ"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your own email"
msgstr "آپ کا ای میل"

#: src/postulo/plugins/own_mail/__init__.py
#, fuzzy
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "آپ کا پاس ورڈ یا نشانی غیر نیٹ ورک کو عبور کریں. انفنٹرینگ کے تحت پہلی طرف سے پہلی طرف کے ٹی ایل ایس یا ٹی ایل ایس منتخب کریں۔."
