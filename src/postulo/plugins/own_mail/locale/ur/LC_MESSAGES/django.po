#: src/postulo/plugins/own_mail/__init__.py
msgid "587 for STARTTLS, 465 for TLS from the first byte."
msgstr "STARTTLS کے لیے 587، پہلے بائٹ سے TLS کے لیے 465۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password is right for your own mail server. Choose your provider to sign in on its own page instead, which Microsoft 365 will require."
msgstr "پاس ورڈ آپ کے اپنے میل سرور کے لیے مناسب ہے۔ اس کی بجائے اپنا فراہم کنندہ منتخب کریں تاکہ اس کے اپنے صفحے پر سائن ان کریں، جس کا Microsoft 365 تقاضا کرے گا۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "A password, or an app password"
msgstr "پاس ورڈ، یا ایپ پاس ورڈ"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client ID"
msgstr "کلائنٹ ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Client secret"
msgstr "کلائنٹ سیکرٹ"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Directory (tenant) ID"
msgstr "ڈائریکٹری (ٹیننٹ) ID"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Encryption"
msgstr "انکرپشن"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Microsoft only. Leave blank to accept any directory."
msgstr "صرف Microsoft کے لیے۔ کوئی بھی ڈائریکٹری قبول کرنے کے لیے خالی چھوڑ دیں۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Nearly every provider wants STARTTLS on 587. Some want TLS on 465."
msgstr "تقریباً ہر فراہم کنندہ 587 پر STARTTLS چاہتا ہے۔ کچھ 465 پر TLS چاہتے ہیں۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "No address set."
msgstr "کوئی پتہ مقرر نہیں۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Only when signing in with a provider: from the application registered with it. Ask whoever runs this instance whether they have one to share."
msgstr "صرف کسی فراہم کنندہ کے ساتھ سائن ان کرتے وقت: اس کے پاس رجسٹرڈ ایپلیکیشن سے۔ اس انسٹینس کو چلانے والے سے پوچھیں کہ کیا ان کے پاس شیئر کرنے کے لیے کوئی ہے۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Password"
msgstr "پاس ورڈ"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Port"
msgstr "پورٹ"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from"
msgstr "کس پتے سے بھیجیں"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Send from your own address, over your own mail server, rather than from this instance. What leaves carries your name and your domain, and a reply or a bounce comes back to you. Switched off, everything this instance sends on its own account — notifications, sign-in codes, getting back in — is unaffected."
msgstr "اس انسٹینس کی بجائے اپنے پتے سے، اپنے میل سرور کے ذریعے بھیجیں۔ جو کچھ باہر جاتا ہے اس پر آپ کا نام اور آپ کا ڈومین ہوتا ہے، اور جواب یا واپس لوٹنے والی میل آپ کے پاس آتی ہے۔ بند ہونے پر وہ سب کچھ جو یہ انسٹینس اپنی طرف سے بھیجتا ہے — اطلاعات، سائن ان کوڈز، اکاؤنٹ میں واپسی — متاثر نہیں ہوتا۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Server"
msgstr "سرور"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Sign in with"
msgstr "سائن ان بذریعہ"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Stored encrypted and never shown back. Many providers want an app-specific password here rather than the one you sign in with."
msgstr "انکرپٹ کر کے محفوظ کیا جاتا ہے اور دوبارہ کبھی نہیں دکھایا جاتا۔ بہت سے فراہم کنندگان یہاں سائن ان والے پاس ورڈ کی بجائے ایپ کے لیے مخصوص پاس ورڈ چاہتے ہیں۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "The address recipients will see, and where their replies will go. Your mail server has to be entitled to send from it."
msgstr "وہ پتہ جو وصول کنندگان دیکھیں گے، اور جہاں ان کے جوابات جائیں گے۔ آپ کے میل سرور کو اس پتے سے بھیجنے کا اختیار ہونا چاہیے۔"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Username"
msgstr "صارف نام"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your own email"
msgstr "آپ کی اپنی ای میل"

#: src/postulo/plugins/own_mail/__init__.py
msgid "Your password or token would cross the network unencrypted. Choose STARTTLS or TLS from the first byte under Encryption."
msgstr "آپ کا پاس ورڈ یا ٹوکن بغیر انکرپشن کے نیٹ ورک پر جائے گا۔ “انکرپشن” کے تحت STARTTLS یا پہلے بائٹ سے TLS منتخب کریں۔"
