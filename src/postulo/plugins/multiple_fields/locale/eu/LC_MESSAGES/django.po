#: src/postulo/plugins/multiple_fields/__init__.py
msgid "Let a field hold more than one value: several email addresses, telephone numbers, websites, social profiles, code repositories and messaging contacts. This is the switch for all of them at once; each can still be switched off on its own while this is on. Switched off, every one of them shows and uses its primary value only, and the others stay recorded and come back untouched."
msgstr "Utzi eremu batek balio bat baino gehiago izaten: hainbat helbide elektroniko, telefono-zenbaki, webgune, profil sozial, kode-biltegi eta mezularitza-kontaktu. Hau guztientzako etengailua da aldi berean; bakoitza bere aldetik itzal daiteke hau piztuta dagoen bitartean. Itzalita, bakoitzak bere balio nagusia besterik ez du erakusten eta erabiltzen, eta gainerakoak erregistratuta geratzen dira eta ukitu gabe itzultzen dira."

#: src/postulo/plugins/multiple_fields/__init__.py
msgid "Multiple fields"
msgstr "Balio anitzeko eremuak"
