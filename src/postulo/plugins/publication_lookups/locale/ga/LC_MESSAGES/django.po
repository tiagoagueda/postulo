#: src/postulo/plugins/publication_lookups/__init__.py
#, fuzzy
msgid "Fill in a publication from its DOI, and suggest publications from your ORCID record, when you press for it: one request to doi.org, which passes the DOI to Crossref or DataCite, or one to ORCID for your public works. Nothing else about you is sent, and nothing is kept until you save. Switched off, nothing is asked."
msgstr "Líonann sé foilseachán óna DOI, agus molann sé foilseacháin ó do thaifead ORCID, nuair a iarrann tú é: iarratas amháin chuig doi.org, a sheolann an DOI ar aghaidh chuig Crossref nó DataCite, nó iarratas amháin chuig ORCID le haghaidh do shaothair phoiblí. Ní sheoltar aon rud eile fút, agus ní choinnítear aon rud go sábhálann tú. Múchta, ní iarrtar aon rud."

#: src/postulo/plugins/publication_lookups/__init__.py
#, fuzzy
msgid "Publication lookups"
msgstr "Cuardach foilseachán"
