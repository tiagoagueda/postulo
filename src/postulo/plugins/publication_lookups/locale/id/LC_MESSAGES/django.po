#: src/postulo/plugins/publication_lookups/__init__.py
msgid "Fill in a publication from its DOI, and suggest publications from your ORCID record, when you press for it: one request to doi.org, which passes the DOI to Crossref or DataCite, or one to ORCID for your public works. Nothing else about you is sent, and nothing is kept until you save. Switched off, nothing is asked."
msgstr "Isi publikasi dari DOI-nya, dan sarankan publikasi dari catatan ORCID Anda, saat Anda memintanya: satu permintaan ke doi.org, yang meneruskan DOI ke Crossref atau DataCite, atau satu permintaan ke ORCID untuk karya publik Anda. Tidak ada hal lain tentang Anda yang dikirim, dan tidak ada yang disimpan sampai Anda menyimpannya. Jika dinonaktifkan, tidak ada yang ditanyakan."

#: src/postulo/plugins/publication_lookups/__init__.py
msgid "Publication lookups"
msgstr "Pencarian publikasi"
