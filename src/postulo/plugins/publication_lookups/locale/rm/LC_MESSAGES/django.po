#: src/postulo/plugins/publication_lookups/__init__.py
#, fuzzy
msgid "Fill in a publication from its DOI, and suggest publications from your ORCID record, when you press for it: one request to doi.org, which passes the DOI to Crossref or DataCite, or one to ORCID for your public works. Nothing else about you is sent, and nothing is kept until you save. Switched off, nothing is asked."
msgstr "Emplenescha ina publicaziun a basa da ses DOI e propona publicaziuns da Vossa inscripziun ORCID, sche Vus al dumandais: ina dumonda a doi.org, che dat vinavant il DOI a Crossref u DataCite, u ina ad ORCID per Vossas ovras publicas. Nagut auter davart Vus na vegn tramess, e nagut na vegn conservà fin che Vus arcunais. Deactivà, na vegn dumandà nagut."

#: src/postulo/plugins/publication_lookups/__init__.py
#, fuzzy
msgid "Publication lookups"
msgstr "Tschertga da publicaziuns"
