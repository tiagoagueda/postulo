#: src/postulo/plugins/publication_lookups/__init__.py
msgid "Fill in a publication from its DOI, and suggest publications from your ORCID record, when you press for it: one request to doi.org, which passes the DOI to Crossref or DataCite, or one to ORCID for your public works. Nothing else about you is sent, and nothing is kept until you save. Switched off, nothing is asked."
msgstr "Udfylder en publikation ud fra dens DOI og foreslår publikationer fra din ORCID-profil, når du beder om det: én forespørgsel til doi.org, som giver DOI'en videre til Crossref eller DataCite, eller én til ORCID efter dine offentlige værker. Intet andet om dig sendes, og intet gemmes, før du gemmer. Slået fra spørges der ikke om noget."

#: src/postulo/plugins/publication_lookups/__init__.py
#, fuzzy
msgid "Publication lookups"
msgstr "Slå publikationer op"
