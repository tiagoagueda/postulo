#: src/postulo/plugins/file_formats/__init__.py
#, fuzzy
msgid "Contacts, companies and your own details as .vcf cards, and a card file read in. Switched off, the downloads and the import are not offered and their addresses answer as if there were nothing there."
msgstr "Cysylltiadau, cwmnïau a'ch manylion eich hun fel cardiau .vcf, a ffeil cardiau wedi'i darllen i mewn. Pan fydd wedi'i ddiffodd, dyw'r lawrlwythiadau a'r mewnforio ddim yn cael eu cynnig ac mae eu cyfeiriadau'n ateb fel pe na bai dim byd yno."

#: src/postulo/plugins/file_formats/__init__.py
#, fuzzy
msgid "DOCX"
msgstr "DOCX"

#: src/postulo/plugins/file_formats/__init__.py
