#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Posta elektronikoko jakinarazpenak"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Zure helbideetako bat ere ez da egiaztatu, beraz ez dago nora bidali."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Jakinarazpenak konfiguratuta daude"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Zure helbide egiaztatuetako bat. Gehitu beste bat «Zure datuak» atalean."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Bidali hona"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Jakinarazpena mezu elektroniko arrunt gisa bidaltzen du, instantzia honek posta bidaltzeko erabiltzen duen bidearen bitartez."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "%(to)s helbidera bidali da."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Posta-motorrak ez du ezer onartu."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Konexio honek %(to)s helbidera bidaltzen du, baina jada ez da zure helbide egiaztatuetako bat. Aukeratu beste bat."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Hau zure Postulo jakinarazpenen konexioaren proba-mezua da. Oroigarriak eta kapturak modu berean iritsiko dira."
