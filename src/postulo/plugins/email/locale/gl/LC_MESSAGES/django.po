#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Notificacións por correo electrónico"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ningún dos teus enderezos está verificado, así que non hai onde enviar isto."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "As notificacións están configuradas"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Un dos teus enderezos verificados. Engade outro en «Os teus datos»."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Enviar a"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Envía unha notificación como correo simple, mediante o que esta instancia usa para enviar correo."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Enviado a %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "O motor de correo non aceptou nada."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Esta conexión envía a %(to)s, que xa non é un dos teus enderezos verificados. Escolle outro."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Esta é a mensaxe de proba da túa conexión de notificacións do Postulo. Os recordatorios e as capturas chegarán do mesmo xeito."
