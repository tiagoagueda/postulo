#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "ईमेल सूचनाएं"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "आपका कोई भी ईमेल पता वेरिफ़ाई नहीं किया गया है, इसलिए इसे भेजने की कोई जगह नहीं है।"

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "सूचनाएं सेट हो गई हैं"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "आपके वेरिफ़ाई किए गए पतों में से एक। “आपका विवरण” में दूसरा पता जोड़ें।"

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "इस पर भेजें"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "सूचना को सादे ईमेल के रूप में भेजता है, उसी के ज़रिए जिससे यह इंस्टेंस मेल भेजता है।"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "%(to)s को भेजा गया।"

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "मेल बैकएंड ने कुछ भी स्वीकार नहीं किया।"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "यह कनेक्शन %(to)s पर भेजता है, जो अब आपके वेरिफ़ाई किए गए पतों में से नहीं है। कोई दूसरा चुनें।"

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "यह आपके Postulo सूचना कनेक्शन से भेजा गया टेस्ट मैसेज है। रिमाइंडर और कैप्चर भी इसी तरह आएंगे।"
