#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-mailové oznámenia"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Žiadna z vašich adries nie je overená, preto nie je kam to poslať."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Oznámenia sú nastavené"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Jedna z vašich overených adries. Ďalšiu pridajte v časti Vaše údaje."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Poslať na"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Posiela oznámenie ako obyčajný e-mail cez to, čo táto inštancia používa na odosielanie pošty."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Odoslané na %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Poštový backend nič neprijal."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Toto pripojenie posiela na %(to)s, čo už nie je jednou z vašich overených adries. Vyberte inú."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Toto je skúšobná správa z vášho pripojenia oznámení Postulo. Pripomienky a zachytenia budú chodiť rovnakou cestou."
