#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Известия по имейл"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Нито един от адресите ви не е потвърден, затова няма къде да се изпрати това."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Известията са настроени"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Един от потвърдените ви адреси. Добавете друг в „Вашите данни“."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Изпращане до"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Изпраща известие като обикновен имейл чрез това, което тази инстанция използва за изпращане на поща."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Изпратено до %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Пощенският модул не прие нищо."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Тази връзка изпраща до %(to)s, който вече не е сред потвърдените ви адреси. Изберете друг."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Това е тестовото съобщение от вашата връзка за известия на Postulo. Напомнянията и прихващанията ще пристигат по същия начин."
