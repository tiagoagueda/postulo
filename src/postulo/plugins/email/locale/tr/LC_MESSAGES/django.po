#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-posta bildirimleri"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Adreslerinizin hiçbiri doğrulanmamış, bu yüzden bunun gönderilebileceği bir yer yok."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Bildirimler kuruldu"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Doğrulanmış adreslerinizden biri. Başka bir adresi Bilgileriniz bölümünden ekleyin."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Şuraya gönder"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Bildirimi, bu kurulumun posta göndermek için kullandığı yol üzerinden düz e-posta olarak gönderir."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "%(to)s adresine gönderildi."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Posta arka ucu hiçbir şeyi kabul etmedi."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Bu bağlantı %(to)s adresine gönderiyor, ancak bu adres artık doğrulanmış adreslerinizden biri değil. Başka birini seçin."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Bu, Postulo bildirim bağlantınızdan gelen test iletisidir. Hatırlatmalar ve yakalamalar da aynı yolla gelecek."
