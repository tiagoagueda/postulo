#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "El. pašto pranešimai"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Nė vienas jūsų el. pašto adresas nepatvirtintas, todėl nėra kur to išsiųsti."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Pranešimai nustatyti"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Vienas iš jūsų patvirtintų adresų. Kitą galite pridėti skiltyje „Jūsų duomenys“."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Siųsti adresu"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Siunčia pranešimą kaip paprastą el. laišką tuo būdu, kuriuo šis egzempliorius siunčia paštą."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Išsiųsta adresu %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Pašto posistemė nepriėmė nė vieno laiško."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Šis ryšys siunčia adresu %(to)s, kuris nebėra tarp jūsų patvirtintų adresų. Pasirinkite kitą."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Tai bandomasis pranešimas iš jūsų Postulo pranešimų ryšio. Priminimai ir fiksavimai atkeliaus tuo pačiu būdu."
