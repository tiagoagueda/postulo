#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "ای میل اطلاعات"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "آپ کا کوئی بھی پتہ تصدیق شدہ نہیں ہے، اس لیے اسے بھیجنے کی کوئی جگہ نہیں۔"

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "اطلاعات ترتیب دے دی گئی ہیں"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "آپ کے تصدیق شدہ پتوں میں سے ایک۔ “آپ کی تفصیلات” میں ایک اور شامل کریں۔"

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "کس پتے پر بھیجیں"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "سادہ ای میل کے طور پر اطلاع بھیجتا ہے، اسی ذریعے سے جو یہ انسٹینس میل بھیجنے کے لیے استعمال کرتا ہے۔"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "%(to)s کو بھیج دیا گیا۔"

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "میل بیک اینڈ نے کچھ قبول نہیں کیا۔"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "یہ کنکشن %(to)s کو بھیجتا ہے، جو اب آپ کے تصدیق شدہ پتوں میں شامل نہیں۔ کوئی دوسرا منتخب کریں۔"

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "یہ آپ کے Postulo اطلاعات کنکشن کا آزمائشی پیغام ہے۔ یاد دہانیاں اور کیپچر بھی اسی طرح پہنچیں گے۔"
