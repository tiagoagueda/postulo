#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Obavještenja e-poštom"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Nijedna vaša adresa nije verifikovana, pa nema kuda ovo poslati."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Obavještenja su podešena"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Jedna od vaših verifikovanih adresa. Dodajte još jednu pod Vaši podaci."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Pošalji na"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Šalje obavještenje kao običnu e-poruku, preko onoga što ova instanca koristi za slanje pošte."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Poslano na %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Pozadinski sistem pošte nije prihvatio ništa."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Ova veza šalje na %(to)s, koja više nije jedna od vaših verifikovanih adresa. Odaberite drugu."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Ovo je probna poruka s vaše Postulo veze za obavještenja. Podsjetnici i uhvaćeni oglasi stizat će na isti način."
