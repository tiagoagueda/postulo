#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-Mail-Benachrichtigungen"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Keine Ihrer Adressen ist bestätigt, daher gibt es keine Adresse, an die dies gesendet werden kann."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Benachrichtigungen sind eingerichtet"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Eine Ihrer bestätigten Adressen. Fügen Sie unter „Ihre Angaben“ eine weitere hinzu."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Senden an"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Sendet eine Benachrichtigung als einfache E-Mail, über den Weg, den diese Instanz zum Versenden von E-Mails nutzt."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Gesendet an %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Das Mail-Backend hat nichts angenommen."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Diese Verbindung sendet an %(to)s, die nicht mehr zu Ihren bestätigten Adressen gehört. Wählen Sie eine andere."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Dies ist die Testnachricht Ihrer Postulo-Benachrichtigungsverbindung. Erinnerungen und Erfassungen kommen auf demselben Weg an."
