#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "ইমেল বিজ্ঞপ্তি"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "আপনার কোনো ঠিকানাই যাচাই করা হয়নি, তাই এটি পাঠানোর কোনো জায়গা নেই।"

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "বিজ্ঞপ্তি সেট আপ করা হয়েছে"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "আপনার যাচাই করা ঠিকানাগুলোর একটি। “আপনার তথ্য”-তে আরেকটি যোগ করুন।"

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "যে ঠিকানায় পাঠানো হবে"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "এই ইনস্ট্যান্স মেল পাঠাতে যা ব্যবহার করে তার মাধ্যমে প্লেন টেক্সট ইমেল হিসেবে একটি বিজ্ঞপ্তি পাঠায়।"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "%(to)s-এ পাঠানো হয়েছে।"

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "মেল ব্যাকএন্ড কিছুই গ্রহণ করেনি।"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "এই সংযোগটি %(to)s-এ পাঠায়, যা আর আপনার যাচাই করা ঠিকানাগুলোর একটি নয়। অন্য একটি বেছে নিন।"

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "এটি আপনার Postulo বিজ্ঞপ্তি সংযোগ থেকে পাঠানো পরীক্ষামূলক বার্তা। অনুস্মারক ও ক্যাপচারও একইভাবে আসবে।"
