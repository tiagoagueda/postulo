#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Njoftime me email"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Asnjë nga adresat tuaja nuk është verifikuar, prandaj nuk ka ku të dërgohet ky mesazh."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Njoftimet janë konfiguruar"

#: src/postulo/plugins/email/__init__.py
#, fuzzy
msgid "One of your verified addresses. Add another under Your details."
msgstr "Një nga adresat tuaja të verifikuara. Shtoni një tjetër te Të dhënat tuaja."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Dërgo te"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Dërgon një njoftim si email të thjeshtë, përmes asaj që përdor kjo instancë për të dërguar postë."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "U dërgua te %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Shërbimi i postës nuk pranoi asgjë."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Kjo lidhje dërgon te %(to)s, e cila nuk është më një nga adresat tuaja të verifikuara. Zgjidhni një tjetër."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Ky është mesazhi provë nga lidhja juaj e njoftimeve të Postulo-s. Kujtesat dhe kapjet do të vijnë në të njëjtën mënyrë."
