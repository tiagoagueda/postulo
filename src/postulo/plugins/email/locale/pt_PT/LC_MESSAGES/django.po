#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Notificações por e-mail"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Nenhum dos seus endereços está verificado, por isso não há para onde enviar isto."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "As notificações estão configuradas"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Um dos seus endereços verificados. Adicione outro em Os seus dados."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Enviar para"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Envia uma notificação por e-mail simples, através do que esta instância usa para enviar correio."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Enviado para %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "O servidor de correio não aceitou nada."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Esta ligação envia para %(to)s, que já não é um dos seus endereços verificados. Escolha outro."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Esta é a mensagem de teste da sua ligação de notificações do Postulo. Os lembretes e as capturas chegarão da mesma forma."
