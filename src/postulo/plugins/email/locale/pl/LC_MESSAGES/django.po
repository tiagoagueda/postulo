#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Powiadomienia e-mail"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Żaden z Twoich adresów nie jest zweryfikowany, więc nie ma dokąd tego wysłać."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Powiadomienia są skonfigurowane"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Jeden z Twoich zweryfikowanych adresów. Dodaj kolejny w sekcji Twoje dane."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Wyślij do"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Wysyła powiadomienie jako zwykły e-mail, za pomocą tego, czego ta instancja używa do wysyłania poczty."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Wysłano do %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Mechanizm wysyłania poczty niczego nie przyjął."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "To połączenie wysyła na adres %(to)s, który nie jest już jednym z Twoich zweryfikowanych adresów. Wybierz inny."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "To wiadomość testowa z Twojego połączenia powiadomień Postulo. Przypomnienia i przechwycenia będą przychodzić w ten sam sposób."
