#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-postvarsler"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ingen av adressene dine er bekreftet, så det finnes ingen steder å sende dette."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Varsler er satt opp"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "En av de bekreftede adressene dine. Legg til en annen under Opplysningene dine."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Send til"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Sender et varsel som vanlig e-post, via det denne installasjonen bruker til å sende e-post."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Sendt til %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "E-posttjenesten tok ikke imot noe."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Denne tilkoblingen sender til %(to)s, som ikke lenger er en av de bekreftede adressene dine. Velg en annen."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Dette er testmeldingen fra Postulo-varseltilkoblingen din. Påminnelser og fangster kommer fram på samme måte."
