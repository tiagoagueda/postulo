#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Известувања по е-пошта"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ниту една од вашите адреси не е потврдена, па нема каде да се испрати ова."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Известувањата се поставени"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Една од вашите потврдени адреси. Додајте друга под „Вашите податоци“."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Испрати до"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Испраќа известување како обична пошта, преку тоа што оваа инстанца го користи за испраќање пошта."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Испратено до %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Поштенскиот систем не прифати ништо."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Оваа врска испраќа до %(to)s, која повеќе не е меѓу вашите потврдени адреси. Изберете друга."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Ова е пробната порака од вашата врска за известувања на Postulo. Потсетниците и зачуваните огласи ќе пристигнуваат на ист начин."
