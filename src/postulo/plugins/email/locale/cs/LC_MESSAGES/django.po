#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-mailová oznámení"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Žádná z vašich adres není ověřená, takže to není kam poslat."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Oznámení jsou nastavena"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Jedna z vašich ověřených adres. Další přidáte v sekci Vaše údaje."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Odesílat na"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Posílá oznámení jako prostý e-mail přes to, co tato instance používá k odesílání pošty."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Odesláno na %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Poštovní backend nic nepřijal."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Toto připojení posílá na %(to)s, což už není jedna z vašich ověřených adres. Zvolte jinou."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Toto je testovací zpráva z vašeho připojení pro oznámení Postulo. Připomenutí a zachycení budou přicházet stejnou cestou."
