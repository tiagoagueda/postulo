#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Notificaciones por correo electrónico"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ninguna de tus direcciones está verificada, así que no hay adónde enviar esto."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Las notificaciones están configuradas"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Una de tus direcciones verificadas. Agrega otra en Tus datos de contacto."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Enviar a"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Envía una notificación como correo de texto sin formato, a través de lo que use esta instancia para enviar correo."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Enviado a %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "El sistema de envío de correo no aceptó nada."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Esta conexión envía a %(to)s, que ya no es una de tus direcciones verificadas. Elige otra."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Este es el mensaje de prueba de tu conexión de notificaciones de Postulo. Los recordatorios y las capturas llegarán de la misma manera."
