#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-mail-értesítések"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Egyik címe sincs ellenőrizve, ezért nincs hová küldeni ezt."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Az értesítések be vannak állítva"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Az egyik ellenőrzött címe. Másikat az Ön elérhetőségei oldalon adhat hozzá."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Küldés ide"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Egyszerű e-mailként küld értesítést azon keresztül, amit ez a példány levélküldésre használ."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Elküldve ide: %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "A levelezési háttérrendszer semmit sem fogadott el."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Ez a kapcsolat ide küld: %(to)s, amely már nem tartozik az ellenőrzött címei közé. Válasszon másikat."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Ez a tesztüzenet a Postulo értesítési kapcsolatából érkezett. Az emlékeztetők és a rögzítések ugyanígy érkeznek majd."
