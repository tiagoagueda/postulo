#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Notificări prin e-mail"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Niciuna dintre adresele dumneavoastră nu este verificată, așa că nu există unde să fie trimis acest mesaj."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Notificările sunt configurate"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Una dintre adresele dumneavoastră verificate. Adăugați alta în Datele dumneavoastră."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Trimitere către"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Trimite o notificare ca e-mail simplu, prin mijlocul pe care această instanță îl folosește pentru a trimite e-mailuri."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Trimis către %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Serviciul de trimitere a e-mailurilor nu a acceptat nimic."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Această conexiune trimite către %(to)s, care nu mai este una dintre adresele dumneavoastră verificate. Alegeți alta."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Acesta este mesajul de test de la conexiunea dumneavoastră de notificări Postulo. Mementourile și capturile vor sosi în același fel."
