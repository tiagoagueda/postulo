#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-mailmeldingen"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Geen van uw adressen is geverifieerd, dus er is geen adres om dit naartoe te sturen."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Meldingen zijn ingesteld"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Een van uw geverifieerde adressen. Voeg een ander toe onder Uw gegevens."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Sturen naar"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Verstuurt een melding als gewone e-mail, via wat deze instantie gebruikt om mail te versturen."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Verstuurd naar %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "De mailbackend accepteerde niets."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Deze koppeling verstuurt naar %(to)s, dat niet langer een van uw geverifieerde adressen is. Kies een ander."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Dit is het testbericht van uw Postulo-meldingskoppeling. Herinneringen en vastleggingen komen op dezelfde manier aan."
