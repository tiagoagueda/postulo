#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Notifikasi email"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Tidak ada alamat Anda yang terverifikasi, jadi tidak ada tujuan untuk mengirim ini."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Notifikasi sudah disiapkan"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Salah satu alamat Anda yang terverifikasi. Tambahkan alamat lain di Data Anda."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Kirim ke"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Mengirim notifikasi sebagai email biasa, melalui apa pun yang digunakan instans ini untuk mengirim email."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Dikirim ke %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Backend email tidak menerima apa pun."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Koneksi ini mengirim ke %(to)s, yang tidak lagi termasuk alamat Anda yang terverifikasi. Pilih alamat lain."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Ini adalah pesan uji dari koneksi notifikasi Postulo Anda. Pengingat dan tangkapan akan tiba dengan cara yang sama."
