#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-pasta paziņojumi"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Neviena no jūsu adresēm nav apstiprināta, tāpēc nav kur to sūtīt."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Paziņojumi ir iestatīti"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Viena no jūsu apstiprinātajām adresēm. Pievienojiet citu sadaļā Jūsu dati."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Sūtīt uz"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Sūta paziņojumu kā vienkāršu e-pastu, izmantojot to, ko šī instance lieto pasta sūtīšanai."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Nosūtīts uz %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Pasta sistēma neko nepieņēma."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Šis savienojums sūta uz %(to)s, kas vairs nav neviena no jūsu apstiprinātajām adresēm. Izvēlieties citu."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Šī ir testa ziņa no jūsu Postulo paziņojumu savienojuma. Atgādinājumi un tvērumi pienāks tāpat."
