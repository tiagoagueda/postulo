#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Communicaziuns per e-mail"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Nagina da Vossas adressas n'è verifitgada, perquai na datti nagin lieu nua trametter quai."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Las communicaziuns èn configuradas"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Ina da Vossas adressas verifitgadas. Agiuntai in'autra sut Vossas datas da contact."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Trametter a"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Trametta ina communicaziun sco e-mail en text simpel, cun quai che questa instanza dovra per trametter e-mails."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Tramess a %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Il backend dad e-mail n'ha acceptà nagut."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Questa connexiun trametta a %(to)s, che n'è betg pli ina da Vossas adressas verifitgadas. Tschernai in'autra."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Quai è il messadi da test da Vossa connexiun da communicaziuns Postulo. Promemorias e capturas arrivan sin la medema moda."
