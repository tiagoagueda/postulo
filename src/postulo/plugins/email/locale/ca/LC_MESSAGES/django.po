#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Notificacions per correu electrònic"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Cap de les vostres adreces no està verificada, així que no hi ha on enviar això."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Les notificacions estan configurades"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Una de les vostres adreces verificades. Afegiu-ne una altra a Les vostres dades."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Envia a"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Envia una notificació com a correu electrònic senzill, mitjançant el que faci servir aquesta instància per enviar correu."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "S'ha enviat a %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "El motor de correu no ha acceptat res."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Aquesta connexió envia a %(to)s, que ja no és una de les vostres adreces verificades. Trieu-ne una altra."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Aquest és el missatge de prova de la vostra connexió de notificacions de Postulo. Els recordatoris i les captures arribaran igual."
