#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "ელფოსტის შეტყობინებები"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "არცერთი თქვენი მისამართი დადასტურებული არ არის, ამიტომ ამის გასაგზავნი არსად არის."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "შეტყობინებები დაყენებულია"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "ერთ-ერთი თქვენი დადასტურებული მისამართი. სხვის დამატება შეგიძლიათ განყოფილებაში „თქვენი მონაცემები“."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "გაგზავნა მისამართზე"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "აგზავნის შეტყობინებას უბრალო წერილად იმის მეშვეობით, რასაც ეს ინსტალაცია ფოსტის გასაგზავნად იყენებს."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "გაიგზავნა მისამართზე %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "ფოსტის ძრავამ არაფერი მიიღო."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "ეს კავშირი აგზავნის მისამართზე %(to)s, რომელიც აღარ არის თქვენი დადასტურებული მისამართი. აირჩიეთ სხვა."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "ეს არის სატესტო შეტყობინება თქვენი Postulo-ს შეტყობინებების კავშირიდან. შეხსენებები და აღებები იმავე გზით მოვა."
