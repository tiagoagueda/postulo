#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Ειδοποιήσεις μέσω email"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Καμία από τις διευθύνσεις σας δεν έχει επαληθευτεί, οπότε δεν υπάρχει πού να σταλεί αυτό."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Οι ειδοποιήσεις έχουν ρυθμιστεί"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Μία από τις επαληθευμένες διευθύνσεις σας. Προσθέστε κι άλλη στα «Τα στοιχεία σας»."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Αποστολή σε"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Στέλνει την ειδοποίηση ως απλό email, μέσω του τρόπου αποστολής αλληλογραφίας που χρησιμοποιεί αυτή η εγκατάσταση."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Στάλθηκε στη διεύθυνση %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Το σύστημα αλληλογραφίας δεν δέχτηκε τίποτα."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Αυτή η σύνδεση στέλνει στη διεύθυνση %(to)s, που δεν είναι πια μία από τις επαληθευμένες διευθύνσεις σας. Επιλέξτε άλλη."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Αυτό είναι το δοκιμαστικό μήνυμα από τη σύνδεση ειδοποιήσεων του Postulo σας. Οι υπενθυμίσεις και οι καταγραφές θα φτάνουν με τον ίδιο τρόπο."
