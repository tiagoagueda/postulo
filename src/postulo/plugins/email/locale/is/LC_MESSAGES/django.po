#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Tilkynningar í tölvupósti"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ekkert netfanga þinna er staðfest, svo hvergi er hægt að senda þetta."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Tilkynningar hafa verið settar upp"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Eitt af staðfestum netföngum þínum. Bættu öðru við undir Upplýsingar um þig."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Senda á"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Sendir tilkynningu sem venjulegan tölvupóst, um það sem þessi uppsetning notar til að senda póst."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Sent á %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Póstbakendinn tók ekki við neinu."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Þessi tenging sendir á %(to)s, sem er ekki lengur eitt af staðfestum netföngum þínum. Veldu annað."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Þetta eru prófunarskilaboðin frá Postulo-tilkynningatengingunni þinni. Áminningar og grip berast á sama hátt."
