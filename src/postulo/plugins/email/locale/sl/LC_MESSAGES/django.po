#: src/postulo/plugins/email/__init__.py:68
#, draft
msgid "No address to send to."
msgstr "Ni naslova za pošiljanje."

#: src/postulo/plugins/email/__init__.py:70
#, draft
msgid "Notifications are set up"
msgstr "Obvestila so nastavljena"

#: src/postulo/plugins/email/__init__.py:49
#, draft
msgid "Send to"
msgstr "Pošlji na"

#: src/postulo/plugins/email/__init__.py:39
#, draft
msgid ""
"Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr ""
"Pošlje obvestilo kot navadno e-pošto prek tega, kar ta instanca uporablja za pošiljanje pošte."

#: src/postulo/plugins/email/__init__.py:84
#, python-format, draft
msgid "Sent to %(to)s."
msgstr "Poslano na %(to)s."

#: src/postulo/plugins/email/__init__.py:83
#, draft
msgid "The mail backend accepted nothing."
msgstr "Zaledni sistem za pošto ni sprejel ničesar."

#: src/postulo/plugins/email/__init__.py:72
#, draft
msgid ""
"This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr ""
"To je preizkusno sporočilo vaše povezave za obvestila Postula. Opomniki in zajemi bodo prispeli na enak način."

#: src/postulo/plugins/email/__init__.py:51
#, draft
msgid "Usually your own address. Anything the instance's mail can reach."
msgstr "Običajno vaš lastni naslov. Karkoli, kar pošta instance lahko doseže."
