#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "E-posti teavitused"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ükski teie aadress pole kinnitatud, seega pole seda kuhugi saata."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Teavitused on seadistatud"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Üks teie kinnitatud aadressidest. Lisage veel üks jaotises „Teie andmed“."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Saada aadressile"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Saadab teavituse tavalise e-kirjana selle kaudu, mida see Postulo e-kirjade saatmiseks kasutab."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Saadetud: %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Kirjade taustsüsteem ei võtnud midagi vastu."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "See ühendus saadab aadressile %(to)s, mis ei ole enam teie kinnitatud aadresside hulgas. Valige mõni muu."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "See on testsõnum teie Postulo teavituste ühendusest. Meeldetuletused ja jäädvustused saabuvad samamoodi."
