#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Ծանուցումներ էլ. փոստով"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ձեր հասցեներից ոչ մեկը հաստատված չէ, ուստի սա ուղարկելու տեղ չկա։"

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Ծանուցումները կարգավորված են"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Ձեր հաստատված հասցեներից մեկը։ Ավելացրեք ևս մեկը «Ձեր տվյալները» բաժնում։"

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Ուղարկել հասցեին"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Ուղարկում է ծանուցումը որպես պարզ էլ. նամակ՝ այն միջոցով, որով այս տեղակայումը փոստ է ուղարկում։"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Ուղարկվեց %(to)s հասցեին։"

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Փոստ ուղարկող համակարգը ոչինչ չընդունեց։"

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Այս կապն ուղարկում է %(to)s հասցեին, որն այլևս ձեր հաստատված հասցեներից չէ։ Ընտրեք մեկ այլը։"

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Սա ձեր Postulo ծանուցումների կապի փորձնական հաղորդագրությունն է։ Հիշեցումներն ու որսերը կհասնեն նույն ձևով։"
