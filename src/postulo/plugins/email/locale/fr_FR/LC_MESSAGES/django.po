#: src/postulo/plugins/email/__init__.py:55
#, draft
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr ""
"Aucune de vos adresses n’est vérifiée, il n’y a donc nulle part où envoyer ceci."

#: src/postulo/plugins/email/__init__.py:129
#, draft
msgid "Notifications are set up"
msgstr "Les notifications sont configurées"

#: src/postulo/plugins/email/__init__.py:110
#, draft
msgid "One of your verified addresses. Add another under Your details."
msgstr ""
"Une de vos adresses vérifiées. Ajoutez-en une autre dans Vos coordonnées."

#: src/postulo/plugins/email/__init__.py:106
#, draft
msgid "Send to"
msgstr "Envoyer à"

#: src/postulo/plugins/email/__init__.py:89
#, draft
msgid ""
"Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr ""
"Envoie une notification par courriel simple, via ce que cette instance utilise pour envoyer du courrier."

#: src/postulo/plugins/email/__init__.py:143
#, python-format, draft
msgid "Sent to %(to)s."
msgstr "Envoyé à %(to)s."

#: src/postulo/plugins/email/__init__.py:142
#, draft
msgid "The mail backend accepted nothing."
msgstr "Le serveur de messagerie n'a rien accepté."

#: src/postulo/plugins/email/__init__.py:64
#, python-format, draft
msgid ""
"This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr ""
"Cette connexion envoie à %(to)s, qui n’est plus une de vos adresses vérifiées. Choisissez-en une autre."

#: src/postulo/plugins/email/__init__.py:131
#, draft
msgid ""
"This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr ""
"Ceci est le message de test de votre connexion de notifications Postulo. Les rappels et les captures arriveront de la même manière."
