#: src/postulo/plugins/email/__init__.py
msgid "Email notifications"
msgstr "Обавештења е-поштом"

#: src/postulo/plugins/email/__init__.py
msgid "None of your addresses is verified, so there is nowhere to send this."
msgstr "Ниједна ваша адреса није потврђена, па нема куда да се ово пошаље."

#: src/postulo/plugins/email/__init__.py
msgid "Notifications are set up"
msgstr "Обавештења су подешена"

#: src/postulo/plugins/email/__init__.py
msgid "One of your verified addresses. Add another under Your details."
msgstr "Једна од ваших потврђених адреса. Додајте још једну на страници Ваши подаци."

#: src/postulo/plugins/email/__init__.py
msgid "Send to"
msgstr "Пошаљи на"

#: src/postulo/plugins/email/__init__.py
msgid "Sends a notification as plain email, through whatever this instance uses to send mail."
msgstr "Шаље обавештење као обичну пошту, преко онога што ова инстанца користи за слање поште."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "Sent to %(to)s."
msgstr "Послато на %(to)s."

#: src/postulo/plugins/email/__init__.py
msgid "The mail backend accepted nothing."
msgstr "Позадински систем поште није прихватио ништа."

#: src/postulo/plugins/email/__init__.py
#, python-format
msgid "This connection sends to %(to)s, which is no longer one of your verified addresses. Choose another."
msgstr "Ова веза шаље на %(to)s, која више није међу вашим потврђеним адресама. Изаберите другу."

#: src/postulo/plugins/email/__init__.py
msgid "This is the test message from your Postulo notifications connection. Reminders and captures will arrive the same way."
msgstr "Ово је пробна порука са ваше Postulo везе за обавештења. Подсетници и хватања стизаће на исти начин."
