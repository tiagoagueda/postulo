#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https://."
msgstr "Ina adressa che cumenza cun https://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Respundì %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Almain %(n)s caracters."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Almain %(n)s caracters. Il retschavider al dovra per controllar ch'ina dumonda vegn da Postulo; el na vegn mai tramess."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Trametta mintga eveniment sco JSON suttascrit ad ina adressa che Vus inditgais, per ch'ina automatisaziun u in script possia reagir. Consegnà dal planisader, empruvà danovamain sch'il retschavider n'è betg disponibel."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo po cuntanscher questa adressa."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Adressa dal retschavider"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Secret da suttascripziun"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Il retschavider ha respundì %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Il retschavider ha renvià a %(location)s; duvrai empè quella adressa."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Nua ch'il JSON vegn tramess. HTTPS, ed ina adressa publica, nun che l'operatur haja lubì adressas privatas; HTTP simpel mo per in retschavider en ina tala rait privata."
