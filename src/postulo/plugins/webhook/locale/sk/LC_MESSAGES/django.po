#: src/postulo/plugins/webhook/__init__.py:184
#, draft
msgid "An address starting with https:// or http://."
msgstr "Adresa začínajúca https:// alebo http://."

#: src/postulo/plugins/webhook/__init__.py:231
#, python-format, draft
msgid "Answered %(status)s."
msgstr "Odpovedané %(status)s."

#: src/postulo/plugins/webhook/__init__.py:192
#, python-format, draft
msgid "At least %(n)s characters."
msgstr "Aspoň %(n)s znakov."

#: src/postulo/plugins/webhook/__init__.py:171
#, python-format, draft
msgid ""
"At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr ""
"Aspoň %(n)s znakov. Príjemca ho používa na overenie, že požiadavka prišla z Postulo; nikdy sa neposiela."

#: src/postulo/plugins/webhook/__init__.py:134
#, draft
msgid ""
"Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr ""
"Posiela každú udalosť ako podpísaný JSON na zadanú adresu, aby podľa nej konala automatizácia alebo skript. Doručuje plánovač a opakuje, ak je príjemca nedostupný."

#: src/postulo/plugins/webhook/__init__.py:213
#, draft
msgid "Postulo can reach this address."
msgstr "Postulo sa na túto adresu dokáže dostať."

#: src/postulo/plugins/webhook/__init__.py:157
#, draft
msgid "Receiver address"
msgstr "Adresa príjemcu"

#: src/postulo/plugins/webhook/__init__.py:167
#, draft
msgid "Signing secret"
msgstr "Podpisové tajomstvo"

#: src/postulo/plugins/webhook/__init__.py:234
#, python-format, draft
msgid "The receiver answered %(status)s."
msgstr "Príjemca odpovedal %(status)s."

#: src/postulo/plugins/webhook/__init__.py:259
#, python-format, draft
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Príjemca presmeroval na %(location)s; použite namiesto toho túto adresu."

#: src/postulo/plugins/webhook/__init__.py:159
#, draft
msgid ""
"Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr ""
"Kam sa JSON posiela. HTTPS a verejná adresa, pokiaľ prevádzkovateľ nepovolil súkromné."
