#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Adresa začínajúca https:// alebo http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Odpovedané %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Aspoň %(n)s znakov."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Aspoň %(n)s znakov. Príjemca ho používa na overenie, že požiadavka prišla z Postulo; nikdy sa neposiela."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Posiela každú udalosť ako podpísaný JSON na zadanú adresu, aby podľa nej konala automatizácia alebo skript. Doručuje plánovač a opakuje, ak je príjemca nedostupný."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo sa na túto adresu dokáže dostať."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Adresa príjemcu"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Podpisové tajomstvo"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Príjemca odpovedal %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Príjemca presmeroval na %(location)s; použite namiesto toho túto adresu."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Kam sa JSON posiela. HTTPS a verejná adresa, pokiaľ prevádzkovateľ nepovolil súkromné."
