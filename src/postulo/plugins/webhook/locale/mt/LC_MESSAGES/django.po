#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Indirizz li jibda b'https:// jew http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Wieġeb %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Mill-inqas %(n)s karattri."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Mill-inqas %(n)s karattri. Ir-riċevitur jużah biex jiċċekkja li talba ġiet minn Postulo; qatt ma jintbagħat."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Jibgħat kull avveniment bħala JSON iffirmat lil indirizz li tagħti, biex awtomazzjoni jew skript jaġixxi fuqu. Ikkunsinnat mill-ischeduler, jerġa' jiġi pprovat jekk ir-riċevitur ikun mitfi."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo jista' jilħaq dan l-indirizz."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Indirizz tar-riċevitur"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Sigriet tal-firma"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Ir-riċevitur wieġeb %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Ir-riċevitur ridirezzjona lil %(location)s; uża dak l-indirizz minflok."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Fejn jintbagħat il-JSON. HTTPS, u indirizz pubbliku sakemm l-operatur ma jkunx ippermetta privati."
