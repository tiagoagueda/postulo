#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Una dirección que empieza por https:// o http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Respondió %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Al menos %(n)s caracteres."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Al menos %(n)s caracteres. El receptor lo usa para comprobar que una solicitud vino de Postulo; nunca se envía."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Envía cada evento como JSON firmado a una dirección que indiques, para que una automatización o un script actúe en consecuencia. Lo entrega el programador y se reintenta si el receptor está caído."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo puede llegar a esta dirección."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Dirección del receptor"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Secreto de firma"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "El receptor respondió %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "El receptor redirigió a %(location)s; usa esa dirección en su lugar."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Adónde se envía el JSON. HTTPS, y una dirección pública salvo que el operador haya permitido las privadas."
