#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Une adresse commençant par https:// ou http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Réponse %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Au moins les caractères %(n)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Au moins les caractères %(n)s. Le récepteur l'utilise pour vérifier qu'une demande provient de Postulo; elle n'est jamais envoyée."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Affiche chaque événement signé JSON à une adresse que vous donnez, pour qu'une automatisation ou un script agisse. Livré par le planificateur, rejugé si le récepteur est en panne."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo peut atteindre cette adresse."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Adresse du destinataire"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Signature secrète"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Le récepteur a répondu %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Le récepteur est redirigé vers %(location)s; utilisez plutôt cette adresse."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Où le JSON est affiché. HTTPS, et une adresse publique à moins que l'opérateur n'ait autorisé des adresses privées."
