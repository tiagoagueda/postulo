#: src/postulo/plugins/webhook/__init__.py:181
msgid "An address starting with https:// or http://."
msgstr "Une adresse commençant par https:// ou http://."

#: src/postulo/plugins/webhook/__init__.py:225
#, python-format
msgid "Answered %(status)s."
msgstr "A répondu %(status)s."

#: src/postulo/plugins/webhook/__init__.py:189
#, python-format
msgid "At least %(n)s characters."
msgstr "Au moins %(n)s caractères."

#: src/postulo/plugins/webhook/__init__.py:168
#, python-format
msgid ""
"At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr ""
"Au moins %(n)s caractères. Le destinataire s’en sert pour vérifier qu’une requête vient de Postulo ; il n’est jamais envoyé."

#: src/postulo/plugins/webhook/__init__.py:134
msgid ""
"Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr ""
"Envoie chaque événement en JSON signé à l’adresse de votre choix, pour qu’une automatisation ou un script agisse. Livré par le planificateur, réessayé si le destinataire ne répond pas."

#: src/postulo/plugins/webhook/__init__.py:210
msgid "Postulo can reach this address."
msgstr "Postulo peut joindre cette adresse."

#: src/postulo/plugins/webhook/__init__.py:154
msgid "Receiver address"
msgstr "Adresse du destinataire"

#: src/postulo/plugins/webhook/__init__.py:164
msgid "Signing secret"
msgstr "Secret de signature"

#: src/postulo/plugins/webhook/__init__.py:228
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Le destinataire a répondu %(status)s."

#: src/postulo/plugins/webhook/__init__.py:156
msgid ""
"Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr ""
"Où le JSON est envoyé. En HTTPS, et une adresse publique sauf si l’opérateur a autorisé les adresses privées."
