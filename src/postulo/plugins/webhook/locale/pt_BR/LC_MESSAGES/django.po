#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Um endereço começando com https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Respondeu %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Pelo menos %(n)s caracteres."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Pelo menos %(n)s caracteres. O receptor o usa para verificar se uma requisição veio do Postulo; ele nunca é enviado."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Envia cada evento como JSON assinado para um endereço que você indicar, para uma automação ou um script agir. Entregue pelo agendador, tentado de novo se o receptor estiver fora do ar."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "O Postulo consegue chegar a este endereço."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Endereço do receptor"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Segredo de assinatura"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "O receptor respondeu %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "O receptor redirecionou para %(location)s; use esse endereço em vez deste."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Para onde o JSON é enviado. HTTPS, e um endereço público, a menos que o operador tenha permitido endereços privados; HTTP simples apenas para um receptor em uma rede privada desse tipo."
