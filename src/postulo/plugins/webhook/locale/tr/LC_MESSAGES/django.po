#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "https:// ile başlayan bir adres."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Yanıt: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "En az %(n)s karakter."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "En az %(n)s karakter. Alıcı, bir isteğin Postulo'dan geldiğini kontrol etmek için bunu kullanır; kendisi hiçbir zaman gönderilmez."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Her olayı, bir otomasyonun ya da betiğin işlem yapması için imzalı JSON olarak verdiğiniz adrese gönderir. Zamanlayıcı tarafından iletilir; alıcı çalışmıyorsa yeniden denenir."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo bu adrese ulaşabilir."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Alıcı adresi"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Gizli imza anahtarı"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Alıcı şu yanıtı verdi: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Alıcı şu adrese yönlendirdi: %(location)s; bunun yerine o adresi kullanın."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhook'lar"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "JSON'un gönderildiği yer. HTTPS ve, işletmeci özel adreslere izin vermedikçe, herkese açık bir adres olmalı; düz HTTP yalnızca böyle özel bir ağdaki alıcı için."
