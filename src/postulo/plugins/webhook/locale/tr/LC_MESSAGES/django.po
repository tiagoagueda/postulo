#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Https:// veya http:// ile başlayan bir adres."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Cevap verdi %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "En azından %(n)s karakterler."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "En azından %(n)s karakterler. Alıcı, bir talebin Postulo'dan geldiğini kontrol etmek için kullanır; asla gönderilmez."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "JSON'u verdiğiniz bir adrese imzaladığınız her olay, bir otomasyon veya senaryo için harekete geçmek için. Programcı tarafından teslim edildi, alıcının aşağı olup olmadığını tekrarladı."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo bu adrese ulaşabilir."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Alıcı adresi"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Sırf"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Alıcı cevap verdi %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Alıcı %(location)s'a yönlendirildi; bunun yerine bu adresi kullanın."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "JSON yayınlandığı yerde. HTTPS ve operatör özellere izin vermediği sürece bir kamu adresi."
