#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Naslov, ki se začne s https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Odgovor: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Vsaj %(n)s znakov."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Vsaj %(n)s znakov. Prejemnik ga uporablja za preverjanje, da je zahteva prišla iz Postula; nikoli se ne pošlje."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Vsak dogodek pošlje kot podpisan JSON na naslov, ki ga navedete, da se nanj odzove avtomatizacija ali skript. Dostavlja ga razporejevalnik, ki poskusi znova, če prejemnik ne deluje."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo lahko doseže ta naslov."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Naslov prejemnika"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Skrivnost za podpisovanje"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Prejemnik je odgovoril %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Prejemnik je preusmeril na %(location)s; uporabite namesto tega ta naslov."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Spletni kavlji"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Kam se pošlje JSON. HTTPS in javni naslov, razen če je skrbnik instance dovolil zasebne; navadni HTTP samo za prejemnika v takem zasebnem omrežju."
