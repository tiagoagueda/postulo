#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Адрас, які пачынаецца з https:// або http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Адказ: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Не менш за %(n)s сімвалаў."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Не менш за %(n)s сімвалаў. Атрымальнік выкарыстоўвае яго, каб праверыць, што запыт прыйшоў ад Postulo; сам ён ніколі не адпраўляецца."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Адпраўляе кожную падзею ў выглядзе падпісанага JSON на ўказаны вамі адрас, каб на яе адрэагавала аўтаматызацыя або скрыпт. Дастаўляецца планавальнікам, з паўторнымі спробамі, калі атрымальнік недаступны."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo можа звязацца з гэтым адрасам."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Адрас атрымальніка"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Сакрэт подпісу"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Атрымальнік адказаў: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Атрымальнік перанакіраваў на %(location)s; выкарыстоўвайце гэты адрас."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Webhook"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Куды адпраўляецца JSON. HTTPS і публічны адрас, калі аператар не дазволіў прыватныя."
