#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Адреса, що починається з https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Відповідь: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Не менше %(n)s символів."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Не менше %(n)s символів. Отримувач використовує його, щоб перевірити, що запит надійшов від Postulo; сам секрет ніколи не надсилається."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Надсилає кожну подію як підписаний JSON на вказану вами адресу, щоб на неї могла зреагувати автоматизація чи скрипт. Доставляється планувальником, з повторними спробами, якщо отримувач недоступний."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo може зв’язатися з цією адресою."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Адреса одержувача"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Секрет підпису"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Отримувач відповів %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Отримувач переспрямував на %(location)s; використовуйте натомість цю адресу."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Вебхуки"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Куди надсилається JSON. HTTPS і публічна адреса, якщо оператор не дозволив приватні; звичайний HTTP — лише для отримувача в такій приватній мережі."
