#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Anwani huanza na https:// au http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "19,416,893,755 (sawa na asilimia 65)."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "[hariri | hariri chanzo]."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "[hariri | hariri chanzo] Mpokeaji anaitumia kuangalia kwamba ombi limetoka Postulo; halijatumwa."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Tuma kila tukio kama ilivyosainiwa JSON kwa anwani unayotoa, kwa automatisering au script ya kutenda. Baada ya hapo, chemsha chini ya joto mpaka nyanya ziwe tayari."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo inaweza kufikia anwani hii."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Anwani ya kupokea"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Ishara ya siri"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Mshtakiwa huyo alijibu sh."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Mpokeaji itaelekezwa kwa %(location)s; tumia anwani hiyo badala yake."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Ambapo taarifa ya JSON inatolewa. HTTPS, na anwani ya umma isipokuwa operator ameruhusu wale binafsi."
