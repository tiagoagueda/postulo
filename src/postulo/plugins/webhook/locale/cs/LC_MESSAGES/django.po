#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Adresa začínající https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Odpověď: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Alespoň %(n)s znaků."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Alespoň %(n)s znaků. Příjemce ho používá k ověření, že požadavek přišel z Postulo; nikdy se neodesílá."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Odesílá každou událost jako podepsaný JSON na adresu, kterou zadáte, aby na ni reagovala automatizace nebo skript. Doručuje plánovač, při nedostupnosti příjemce se opakuje."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo se k této adrese dostane."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Adresa příjemce"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Podpisový klíč"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Příjemce odpověděl stavem %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Příjemce přesměroval na %(location)s; použijte místo toho tuto adresu."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooky"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Kam se JSON odesílá. HTTPS a veřejná adresa, pokud správce serveru nepovolil soukromé; prosté HTTP jen pro příjemce v takové soukromé síti."
