#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "عنوان يبدأ بالبادئة https:// أو http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "أجاب بالرمز %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "%(n)s من الأحرف على الأقل."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "%(n)s من الأحرف على الأقل. يستخدمه المستقبِل للتحقق من أن طلب HTTP جاء من Postulo؛ ولا يُرسَل أبدًا."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "يرسل كل حدث بصيغة JSON موقّعة إلى عنوان تحدده، لتتصرف بناءً عليه أداة أتمتة أو برنامج نصي. يتولى المُجدوِل التسليم، وتُعاد المحاولة إذا كان المستقبِل متوقفًا."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "يستطيع Postulo الوصول إلى هذا العنوان."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "عنوان المستقبِل"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "سر التوقيع"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "أجاب المستقبِل بالرمز %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "أعاد المستقبِل التوجيه إلى %(location)s؛ استخدم ذلك العنوان بدلًا من هذا."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "خطافات الويب"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "العنوان الذي يُرسَل إليه JSON. يجب أن يكون HTTPS، وعنوانًا عامًا ما لم يسمح المشغّل بالعناوين الخاصة."
