#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Una adreça que comenci per https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Ha respost %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Com a mínim %(n)s caràcters."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Com a mínim %(n)s caràcters. El receptor el fa servir per comprovar que una petició ve de Postulo; no s'envia mai."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Envia cada esdeveniment com a JSON signat a una adreça que indiqueu, perquè una automatització o un script hi actuï. El lliura el planificador, i es reintenta si el receptor no està disponible."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo pot accedir a aquesta adreça."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Adreça del receptor"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Secret de signatura"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "El receptor ha respost %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "El receptor ha redirigit a %(location)s; feu servir aquesta adreça en el seu lloc."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "On s'envia el JSON. HTTPS, i una adreça pública tret que l'operador hagi permès les privades; HTTP sense xifrar només per a un receptor en una xarxa privada d'aquest tipus."
