#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Una dirección que empiece con https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Respondió %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Al menos %(n)s caracteres."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Al menos %(n)s caracteres. El destinatario lo usa para comprobar que una solicitud viene de Postulo; nunca se envía."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Envía cada evento como JSON firmado a una dirección que indiques, para que una automatización o un script actúe en consecuencia. Lo entrega el programador, con reintentos si el destinatario no está disponible."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo puede llegar a esta dirección."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Dirección del destinatario"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Secreto de firma"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "El destinatario respondió %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "El destinatario redirigió a %(location)s; usa esa dirección en su lugar."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Dónde se envía el JSON. HTTPS y una dirección pública, a menos que el operador haya permitido las privadas; HTTP simple solo para un receptor en una red privada de ese tipo."
