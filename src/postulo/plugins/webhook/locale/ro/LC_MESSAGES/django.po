#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "O adresă care începe cu https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "A răspuns cu %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Cel puțin %(n)s caractere."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Cel puțin %(n)s caractere. Destinatarul îl folosește pentru a verifica dacă o cerere a venit de la Postulo; nu este trimis niciodată."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Trimite fiecare eveniment ca JSON semnat la o adresă pe care o indicați, pentru ca o automatizare sau un script să reacționeze. Livrat de planificator, cu reîncercări dacă destinatarul nu este disponibil."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo poate ajunge la această adresă."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Adresa destinatarului"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Secret de semnare"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Destinatarul a răspuns %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Destinatarul a redirecționat către %(location)s; folosiți în schimb acea adresă."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhookuri"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Adresa la care este trimis JSON-ul. HTTPS și o adresă publică, cu excepția cazului în care administratorul serverului a permis adrese private; HTTP simplu numai pentru un destinatar dintr-o astfel de rețea privată."
