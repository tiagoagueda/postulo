#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Alamat dimulai dengan https: / / atau http: / /."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Menjawab %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Setidaknya %(n)s karakter."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Setidaknya %(n)s karakter. Penerima itu menggunakannya untuk memeriksa permintaan yang berasal dari Postulo, tidak pernah terkirim."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Posts every event as signed JSON to an address you give, for an automatiation or a script to act on. Dikirim oleh penjadwalan, dicoba ulang jika penerima turun."

