#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https:// or http://."
msgstr "Alamat yang diawali dengan https:// atau http://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Menjawab %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Setidaknya %(n)s karakter."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Setidaknya %(n)s karakter. Penerima menggunakannya untuk memeriksa bahwa permintaan berasal dari Postulo; rahasia ini tidak pernah dikirim."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Mengirim setiap peristiwa sebagai JSON yang ditandatangani ke alamat yang Anda berikan, untuk ditindaklanjuti oleh otomatisasi atau skrip. Dikirim oleh penjadwal, dicoba lagi jika penerima sedang tidak aktif."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo dapat menjangkau alamat ini."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Alamat penerima"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Rahasia penandatanganan"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Penerima menjawab %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Penerima mengalihkan ke %(location)s; gunakan alamat itu sebagai gantinya."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhook"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Tempat JSON dikirim. HTTPS, dan alamat publik kecuali operator telah mengizinkan alamat pribadi."
