#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Osoite, joka alkaa https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Vastaus: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Vähintään %(n)s merkkiä."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Vähintään %(n)s merkkiä. Vastaanottaja käyttää sitä tarkistaakseen, että pyyntö tuli Postulosta; sitä ei koskaan lähetetä."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Lähettää jokaisen tapahtuman allekirjoitettuna JSON-viestinä antamaasi osoitteeseen automaation tai skriptin käsiteltäväksi. Ajastin toimittaa viestit ja yrittää uudelleen, jos vastaanottaja ei vastaa."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo tavoittaa tämän osoitteen."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Vastaanottajan osoite"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Allekirjoitussalaisuus"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Vastaanottaja vastasi: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Vastaanottaja ohjasi osoitteeseen %(location)s; käytä sitä osoitetta sen sijaan."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhookit"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Osoite, johon JSON lähetetään. HTTPS ja julkinen osoite, ellei palvelimen ylläpitäjä ole sallinut yksityisiä; pelkkä HTTP vain, jos vastaanottaja on tällaisessa yksityisessä verkossa."
