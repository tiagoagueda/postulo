#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https://."
msgstr "Ein adressa, sum byrjar við https://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Svaraði %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Í minsta lagi %(n)s stavir."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Í minsta lagi %(n)s stavir. Móttakarin brúkar hann til at kanna, at ein umbøn kom frá Postulo; hann verður ongantíð sendur."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Sendir hvørja hending sum undirskrivað JSON til ein vevbústað, sum tú gevur, so at ein sjálvvirkni ella eitt skript kann gera nakað við hana. Borið út av tíðarskiparanum og roynt aftur, um móttakarin er niðri."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo kann røkka hendan vevbústaðin."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Vevbústaður hjá móttakaranum"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Undirskriftarlykil"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Móttakarin svaraði %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Móttakarin vísti víðari til %(location)s; brúka heldur tann vevbústaðin."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Vevkrókar"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Har JSON verður sent. HTTPS, og ein almenn adressa, uttan so at rakstrarábyrgdarin hevur loyvt privatum; vanligt HTTP bert til ein móttakara á slíkum privatum neti."
