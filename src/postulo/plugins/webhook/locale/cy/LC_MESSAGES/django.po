msgid "An address starting with https://."
msgstr ""

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Atebodd %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "O leiaf %(n)s nod."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "O leiaf %(n)s nod. Mae'r derbynnydd yn ei ddefnyddio i wirio bod cais wedi dod gan Postulo; nid yw byth yn cael ei anfon."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Yn postio pob digwyddiad fel JSON wedi'i lofnodi i gyfeiriad a roddwch, er mwyn i awtomeiddiad neu sgript weithredu arno. Caiff ei ddanfon gan yr amserlennydd, a'i ailgynnig os yw'r derbynnydd i lawr."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Gall Postulo gyrraedd y cyfeiriad hwn."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Cyfeiriad y derbynnydd"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Cyfrinach llofnodi"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Atebodd y derbynnydd %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Ailgyfeiriodd y derbynnydd i %(location)s; defnyddiwch y cyfeiriad hwnnw yn lle."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Bachau gwe"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr ""
