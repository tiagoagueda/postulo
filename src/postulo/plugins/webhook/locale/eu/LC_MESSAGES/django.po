#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "https:// aurrizkiarekin hasten den helbide bat."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "%(status)s egoerarekin erantzun du."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Gutxienez %(n)s karaktere."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Gutxienez %(n)s karaktere. Hartzaileak eskaera bat Postulotik datorrela egiaztatzeko erabiltzen du; ez da inoiz bidaltzen."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Gertaera bakoitza JSON sinatu gisa bidaltzen du zuk emandako helbide batera, automatizazio edo script batek horren arabera jardun dezan. Planifikatzaileak entregatzen du, eta berriro saiatzen da hartzailea erorita badago."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo helbide honetara iritsi daiteke."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Hartzailearen helbidea"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Sinatzeko sekretua"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Hartzaileak %(status)s egoerarekin erantzun du."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Hartzaileak beste helbide honetara birbideratu du: %(location)s; erabili helbide hori horren ordez."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhookak"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "JSONa bidaltzen den helbidea. HTTPS, eta helbide publiko bat, operadoreak pribatuak baimendu ez baditu; HTTP arrunta, soilik sare pribatu horretako hartzaile batentzat."
