#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Https:// या http:// से शुरू होने वाला एक पता।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "उत्तर %(status)s।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "कम से कम %(n)s वर्ण।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "कम से कम %(n)s वर्ण। रिसीवर यह जांचने के लिए उपयोग करता है कि एक अनुरोध पोस्टुलो से आया था; यह कभी नहीं भेजा जाता है।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "प्रत्येक घटना के बाद JSON को आपके द्वारा दिए गए पते पर, स्वचालन या स्क्रिप्ट पर कार्य करने के लिए हस्ताक्षर किए गए। शेड्यूलर द्वारा वितरित, अगर रिसीवर नीचे है तो पुनः प्राप्त करें।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "पोस्टुलो इस पते तक पहुंच सकता है।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "रिसीवर पता"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "गुप्त हस्ताक्षर"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "रिसीवर ने जवाब दिया %(status)s।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "रिसीवर %(location)s के लिए पुनर्निर्देशित; इसके बजाय उस पते का उपयोग करें।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "जहां JSON पोस्ट किया गया है। एचटीटीपी, और एक सार्वजनिक पता जब तक कि ऑपरेटर ने निजी लोगों को अनुमति नहीं दी है।।"
