#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "https:// या http:// से शुरू होने वाला पता।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "जवाब मिला: %(status)s।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "कम से कम %(n)s अक्षर।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "कम से कम %(n)s अक्षर। रिसीवर इससे जांचता है कि अनुरोध Postulo से आया है; इसे कभी भेजा नहीं जाता।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "हर इवेंट को साइन किए गए JSON के रूप में आपके दिए पते पर भेजता है, ताकि कोई ऑटोमेशन या स्क्रिप्ट उस पर काम कर सके। शेड्यूलर इसे डिलीवर करता है, और रिसीवर बंद होने पर फिर से कोशिश की जाती है।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo इस पते तक पहुंच सकता है।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "रिसीवर का पता"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "साइनिंग सीक्रेट"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "पाने वाले सर्वर ने %(status)s जवाब दिया।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
