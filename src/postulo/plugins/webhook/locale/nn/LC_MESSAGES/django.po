#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Ei adresse som byrjar med https:// eller http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Svarte %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Minst %(n)s teikn."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Minst %(n)s teikn. Mottakaren brukar han til å kontrollere at ein førespurnad kom frå Postulo; han blir aldri sendt."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Sender kvar hending som signert JSON til ei adresse du oppgjev, slik at ein automasjon eller eit skript kan handle ut frå henne. Blir levert av planleggjaren, og prøvd på nytt dersom mottakaren er nede."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo kan nå denne adressa."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Adressa til mottakaren"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Signeringsløyndom"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Mottakaren svarte %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
