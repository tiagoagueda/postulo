#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "https:// سے شروع ہونے والا پتہ۔"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "جواب %(status)s ملا۔"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "کم از کم %(n)s حروف۔"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "کم از کم %(n)s حروف۔ وصول کنندہ اسے یہ جانچنے کے لیے استعمال کرتا ہے کہ درخواست Postulo سے آئی ہے؛ یہ کبھی بھیجا نہیں جاتا۔"

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "ہر ایونٹ کو دستخط شدہ JSON کے طور پر آپ کے دیے ہوئے پتے پر پوسٹ کرتا ہے، تاکہ کوئی آٹومیشن یا اسکرپٹ اس پر عمل کرے۔ شیڈولر کے ذریعے پہنچایا جاتا ہے، اور وصول کنندہ بند ہو تو دوبارہ کوشش کی جاتی ہے۔"

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo اس پتے تک پہنچ سکتا ہے۔"

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "وصول کنندہ کا پتہ"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "دستخط کا سیکرٹ"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "وصول کنندہ نے %(status)s جواب دیا۔"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "وصول کنندہ نے %(location)s کی طرف ری ڈائریکٹ کیا؛ اس کی بجائے وہ پتہ استعمال کریں۔"

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "ویب ہکس"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "جہاں JSON پوسٹ کیا جاتا ہے۔ HTTPS، اور ایک عوامی پتہ، الا یہ کہ آپریٹر نے نجی پتوں کی اجازت دی ہو؛ سادہ HTTP صرف ایسے نجی نیٹ ورک پر موجود وصول کنندہ کے لیے۔"
