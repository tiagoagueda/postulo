#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "En adresse, der begynder med https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Svarede %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Mindst %(n)s tegn."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Mindst %(n)s tegn. Modtageren bruger den til at kontrollere, at en forespørgsel kom fra Postulo; den sendes aldrig."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Sender hver hændelse som signeret JSON til en adresse, du angiver, så en automatisering eller et script kan handle på den. Leveres af planlæggeren og forsøges igen, hvis modtageren er nede."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo kan nå denne adresse."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Modtageradresse"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Signeringshemmelighed"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Modtageren svarede med %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Modtageren omdirigerede til %(location)s; brug den adresse i stedet."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Hvor JSON'en sendes hen. HTTPS og en offentlig adresse, medmindre driftsansvarlig har tilladt private; almindelig HTTP kun for en modtager på et sådant privat netværk."
