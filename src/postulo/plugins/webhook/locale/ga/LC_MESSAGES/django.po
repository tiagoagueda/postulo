#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "Seoladh a thosaíonn le https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "D’fhreagair sé %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "%(n)s carachtar ar a laghad."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "%(n)s carachtar ar a laghad. Úsáideann an glacadóir é chun a sheiceáil gur tháinig iarratas ó Postulo; ní sheoltar riamh é."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Postálann sé gach imeacht mar JSON sínithe chuig seoladh a thugann tú, le go ngníomhóidh uathoibriú nó script air. Seachadann an sceidealóir é, agus déantar iarracht arís má bhíonn an glacadóir as feidhm."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Is féidir le Postulo an seoladh seo a bhaint amach."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Seoladh an ghlacadóra"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Rún sínithe"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "D’fhreagair an glacadóir %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "D’atreoraigh an glacadóir chuig %(location)s; úsáid an seoladh sin ina ionad."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Crúcaí gréasáin"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Áit a bpostáiltear an JSON. HTTPS, agus seoladh poiblí mura bhfuil seoltaí príobháideacha ceadaithe ag an oibreoir; HTTP simplí amháin do ghlacadóir ar líonra príobháideach den sórt sin."
