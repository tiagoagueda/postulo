#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https://."
msgstr "একটি ঠিকানা চালু করা হচ্ছে।।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "%(status)s দিয়ে উত্তর দিয়েছে।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "অন্তত %(n)s অক্ষর।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "অন্তত %(n)s অক্ষর। কোনো অনুরোধ Postulo থেকে এসেছে কি না তা যাচাই করতে গ্রহণকারী এটি ব্যবহার করে; এটি কখনো পাঠানো হয় না।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "প্রতিটি ইভেন্ট আপনার দেওয়া একটি ওয়েব ঠিকানায় স্বাক্ষরিত JSON হিসেবে পাঠায়, যাতে কোনো অটোমেশন বা স্ক্রিপ্ট সে অনুযায়ী কাজ করতে পারে। শিডিউলার এটি পৌঁছে দেয়, এবং গ্রহণকারী বন্ধ থাকলে আবার চেষ্টা করে।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo এই ওয়েব ঠিকানায় পৌঁছাতে পারে।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "গ্রহণকারীর ওয়েব ঠিকানা"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "স্বাক্ষর করার সিক্রেট"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "গ্রহণকারী %(status)s দিয়ে উত্তর দিয়েছে।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "গ্রহণকারী %(location)s-এ রিডাইরেক্ট করেছে; এর বদলে সেই ঠিকানা ব্যবহার করুন।"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "ওয়েবহুক"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "যেখানে JSON পোস্ট করা হয়েছে. মোবাইল ফোন এবং পাবলিক ঠিকানা, যদি অপারেটররা প্রাইভেট নেটওয়ার্ক ব্যবহারের অনুমতি না দেয়; শুধুমাত্র একটি ব্যক্তিগত নেটওয়ার্ক গ্রহণের জন্য HTTP-র মাধ্যমে উপলব্ধ না হয়।।"
