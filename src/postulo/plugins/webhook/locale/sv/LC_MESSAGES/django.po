#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https://."
msgstr "En adress som börjar med https://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Svarade %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Minst %(n)s tecken."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Minst %(n)s tecken. Mottagaren använder den för att kontrollera att en begäran kom från Postulo; den skickas aldrig."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Skickar varje händelse som signerad JSON till en adress du anger, för en automatisering eller ett skript att agera på. Levereras av schemaläggaren och försöks igen om mottagaren ligger nere."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "Postulo kan nå den här adressen."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Mottagarens adress"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Signeringshemlighet"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Mottagaren svarade %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Mottagaren omdirigerade till %(location)s; använd den adressen i stället."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Dit JSON skickas. HTTPS och en offentlig adress, om inte driftansvarig har tillåtit privata; vanlig HTTP endast för en mottagare i ett sådant privat nätverk."
