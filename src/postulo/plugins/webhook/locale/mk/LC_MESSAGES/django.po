#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https://."
msgstr "Адреса што започнува со https://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Одговорено %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Најмалку %(n)s знаци."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Најмалку %(n)s знаци. Примачот ја користи за да провери дали барањето дошло од Postulo; таа никогаш не се испраќа."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Го испраќа секој настан како потпишан JSON на адреса што ќе ја наведете, за да постапи автоматизација или скрипта. Го испорачува распоредувачот и се обидува повторно ако примачот не е достапен."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo може да ја достигне оваа адреса."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Адреса на примачот"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Тајна за потпишување"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Примачот одговори %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Примачот пренасочи кон %(location)s; користете ја таа адреса наместо оваа."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Webhook-ови"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Каде се испраќа JSON. HTTPS и јавна адреса, освен ако операторот дозволил приватни; обичен HTTP само за примач на таква приватна мрежа."
