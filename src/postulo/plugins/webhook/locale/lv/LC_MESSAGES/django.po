#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Adrese, kas sākas ar https:// vai http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Atbildēja %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Vismaz %(n)s rakstzīmes."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Vismaz %(n)s rakstzīmes. Saņēmējs to izmanto, lai pārbaudītu, ka pieprasījums nācis no Postulo; tas netiek nosūtīts nekad."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Sūta katru notikumu kā parakstītu JSON uz jūsu norādītu adresi, lai automatizācija vai skripts uz to reaģētu. Piegādā plānotājs, atkārto, ja saņēmējs nedarbojas."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo var sasniegt šo adresi."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Saņēmēja adrese"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Paraksta noslēpums"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Saņēmējs atbildēja %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Saņēmējs pārvirzīja uz %(location)s; izmantojiet tā vietā šo adresi."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Kur tiek sūtīts JSON. HTTPS un publiska adrese, ja vien operators nav atļāvis privātas."
