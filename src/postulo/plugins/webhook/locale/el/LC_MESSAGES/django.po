#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Μια διεύθυνση που αρχίζει με https:// ή http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Απάντησε %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Τουλάχιστον %(n)s χαρακτήρες."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Τουλάχιστον %(n)s χαρακτήρες. Ο παραλήπτης το χρησιμοποιεί για να ελέγξει ότι ένα αίτημα προήλθε από το Postulo· δεν στέλνεται ποτέ."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Στέλνει κάθε γεγονός ως υπογεγραμμένο JSON σε μια διεύθυνση που δίνετε, για να ενεργήσει ένας αυτοματισμός ή ένα σενάριο. Παραδίδεται από τον χρονοπρογραμματιστή, με νέες προσπάθειες αν ο παραλήπτης δεν λειτουργεί."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Το Postulo μπορεί να φτάσει σε αυτή τη διεύθυνση."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Διεύθυνση παραλήπτη"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Μυστικό υπογραφής"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Ο παραλήπτης απάντησε %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Ο παραλήπτης ανακατεύθυνε στο %(location)s· χρησιμοποιήστε αυτή τη διεύθυνση."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Πού στέλνεται το JSON. HTTPS, και δημόσια διεύθυνση εκτός αν ο διαχειριστής έχει επιτρέψει ιδιωτικές."
