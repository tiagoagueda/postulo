#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Յուրաքանչյուր իրադարձություն ուղարկում է որպես ստորագրված JSON ձեր նշած հասցեին, որպեսզի ավտոմատացումը կամ սկրիպտը գործի դրա հիման վրա։ Առաքվում է պլանավորիչի միջոցով և կրկին փորձվում, եթե ստացողը հասանելի չէ։"

