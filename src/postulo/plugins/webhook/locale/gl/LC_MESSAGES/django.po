#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https:// or http://."
msgstr "Unha dirección que comeza con https:// ou http://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Feito %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "%(n)s caracteres."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "%(n)s caracteres. O receptor úsase para comprobar que unha solicitude procede de Postulo; nunca se envía."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Publica todos os eventos como JSON asinado para un enderezo que dá, para unha automatización ou un guión para actuar. Entregado polo programador, retribuída se o receptor está abaixo."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Póster pode chegar a esta dirección."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Enderezo recibidor"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Asinar segredo"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "O receptor responde [x22x]."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "O receptor redireccionouse a %(location)s; use esta dirección."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Onde se publica o JSON. Https e unha dirección pública a non ser que o operador permita os privados."
