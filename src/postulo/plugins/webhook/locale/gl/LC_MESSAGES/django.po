#: src/postulo/plugins/webhook/__init__.py
msgid "An address starting with https:// or http://."
msgstr "Un enderezo que comece por https:// ou http://."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "Answered %(status)s."
msgstr "Respondeu %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters."
msgstr "Polo menos %(n)s caracteres."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Polo menos %(n)s caracteres. O receptor úsao para comprobar que unha petición vén do Postulo; nunca se envía."

#: src/postulo/plugins/webhook/__init__.py
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Envía cada evento como JSON asinado a un enderezo que indiques, para que unha automatización ou un script actúe en consecuencia. Entrégao o planificador, que o tenta de novo se o receptor non está dispoñible."

#: src/postulo/plugins/webhook/__init__.py
msgid "Postulo can reach this address."
msgstr "O Postulo pode chegar a este enderezo."

#: src/postulo/plugins/webhook/__init__.py
msgid "Receiver address"
msgstr "Enderezo do receptor"

#: src/postulo/plugins/webhook/__init__.py
msgid "Signing secret"
msgstr "Segredo de sinatura"

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver answered %(status)s."
msgstr "O receptor respondeu %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "O receptor redirixiu a %(location)s; usa ese enderezo no seu lugar."

#: src/postulo/plugins/webhook/__init__.py
msgid "Webhooks"
msgstr "Webhooks"

#: src/postulo/plugins/webhook/__init__.py
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones."
msgstr "Onde se envía o JSON. HTTPS, e un enderezo público a menos que o operador permitise os privados."
