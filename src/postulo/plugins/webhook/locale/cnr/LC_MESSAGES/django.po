#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "An address starting with https://."
msgstr "Adresa koja počinje sa https://."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "Answered %(status)s."
msgstr "Odgovor: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters."
msgstr "Najmanje %(n)s znakova."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "At least %(n)s characters. The receiver uses it to check that a request came from Postulo; it is never sent."
msgstr "Najmanje %(n)s znakova. Prijemnik je koristi da provjeri da je zahtjev stigao iz Postula; nikad se ne šalje."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Posts every event as signed JSON to an address you give, for an automation or a script to act on. Delivered by the scheduler, retried if the receiver is down."
msgstr "Šalje svaki događaj kao potpisani JSON na adresu koju navedete, da bi automatizacija ili skripta postupila po njemu. Isporučuje ga planer, uz ponovni pokušaj ako prijemnik nije dostupan."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Postulo can reach this address."
msgstr "Postulo može da dođe do ove adrese."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Receiver address"
msgstr "Adresa prijemnika"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Signing secret"
msgstr "Tajna za potpisivanje"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver answered %(status)s."
msgstr "Prijemnik je odgovorio: %(status)s."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy, python-format
msgid "The receiver redirected to %(location)s; use that address instead."
msgstr "Prijemnik je preusmjerio na %(location)s; umjesto ove koristite tu adresu."

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Webhooks"
msgstr "Webhookovi"

#: src/postulo/plugins/webhook/__init__.py
#, fuzzy
msgid "Where the JSON is posted. HTTPS, and a public address unless the operator has allowed private ones; plain HTTP only for a receiver on such a private network."
msgstr "Kuda se šalje JSON. HTTPS i javna adresa, osim ako je operater dozvolio privatne; običan HTTP samo za primaoca na takvoj privatnoj mreži."
