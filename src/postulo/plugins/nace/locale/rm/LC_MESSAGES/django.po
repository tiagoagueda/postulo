#: src/postulo/plugins/nace/__init__.py
#, fuzzy
msgid "NACE sectors and industries"
msgstr "Secturs e branschas NACE"

#: src/postulo/plugins/nace/__init__.py
#, fuzzy
msgid "Suggests industries from the short names Postulo offers and from NACE, the European classification of economic activities, in your language where Eurostat published it, each under its sector. It reads files that ship with Postulo and asks no service. Switched off, the industry field is a plain box and every industry already kept stays as it is."
msgstr "Propona branschas a partir dals nums curts che Postulo porscha e da la NACE, la classificaziun europeica da las activitads economicas, en ta lingua nua che Eurostat l'ha publitgada, mintgamai sut ses sectur. Legia datotecas che vegnan cun Postulo e dumonda nagin servetsch. Deactivà daventa il champ da la branscha ina simpla chaschetta, e mintga branscha gia memorisada resta sco ch'ella è."
