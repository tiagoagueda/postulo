#: src/postulo/plugins/nace/__init__.py
#, fuzzy
msgid "NACE sectors and industries"
msgstr "Sectorau a diwydiannau NACE"

#: src/postulo/plugins/nace/__init__.py
#, fuzzy
msgid "Suggests industries from the short names Postulo offers and from NACE, the European classification of economic activities, in your language where Eurostat published it, each under its sector. It reads files that ship with Postulo and asks no service. Switched off, the industry field is a plain box and every industry already kept stays as it is."
msgstr "Yn awgrymu diwydiannau o'r enwau byr y mae Postulo yn eu cynnig ac o NACE, dosbarthiad Ewropeaidd o weithgareddau economaidd, yn eich iaith chi lle cyhoeddodd Eurostat ef, pob un o dan ei sector. Mae'n darllen ffeiliau sy'n dod gyda Postulo ac nid yw'n gofyn i unrhyw wasanaeth. Pan fydd wedi'i ddiffodd, mae'r maes diwydiant yn flwch syml ac mae pob diwydiant sydd eisoes wedi'i gadw yn aros fel y mae."
