#: src/postulo/plugins/geonames/__init__.py
#, fuzzy
msgid "GeoNames places"
msgstr "GeoNamesen lekuak"

#: src/postulo/plugins/geonames/__init__.py
#, fuzzy
msgid "Suggests the name of a city as you type it into an address, from the table of the cities of more than a thousand inhabitants that GeoNames publishes, kept on this server. Nothing you type is sent anywhere. Switched off, the city box suggests only what you have typed before, no address is placed from this table, and every place and address already kept stays as it is."
msgstr "Hiri baten izena iradokitzen du helbide batean idazten duzun bitartean, GeoNamesek argitaratzen duen mila biztanletik gorako hirien taulatik abiatuta, zerbitzari honetan gordeta. Idazten duzun ezer ez da inora bidaltzen. Desaktibatuta, hiriaren koadroak lehenago idatzitakoa soilik iradokitzen du, ez da helbiderik jartzen taula honetatik eta jada gordetako leku eta helbide guztiak berdin geratzen dira."
