#: src/postulo/plugins/geonames/__init__.py
#, fuzzy
msgid "GeoNames places"
msgstr "Lleoedd GeoNames"

#: src/postulo/plugins/geonames/__init__.py
#, fuzzy
msgid "Suggests the name of a city as you type it into an address, from the table of the cities of more than a thousand inhabitants that GeoNames publishes, kept on this server. Nothing you type is sent anywhere. Switched off, the city box suggests only what you have typed before, no address is placed from this table, and every place and address already kept stays as it is."
msgstr "Mae'n awgrymu enw dinas wrth i chi ei deipio mewn cyfeiriad, o'r tabl o ddinasoedd â mwy na mil o drigolion y mae GeoNames yn ei gyhoeddi, wedi'i gadw ar y gweinydd hwn. Ni chaiff dim a deipiwch ei anfon i unman. Pan fydd wedi'i ddiffodd, dim ond yr hyn a deipiwyd gennych o'r blaen y mae'r blwch dinas yn ei awgrymu, ni roddir unrhyw gyfeiriad o'r tabl hwn, ac mae pob lle a chyfeiriad sydd eisoes wedi'u cadw yn aros fel y maent."
