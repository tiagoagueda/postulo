#: src/postulo/plugins/esco/__init__.py
#, fuzzy
msgid "ESCO occupations and skills"
msgstr "ESCO մասնագիտություններ և հմտություններ"

#: src/postulo/plugins/esco/__init__.py
#, fuzzy
msgid "Suggests job titles from ESCO, the European classification of occupations, in your language, and recognises the skills you record against ESCO's list of skills. It reads files an administrator downloads once with manage.py fetch_esco and asks no service while you work. Switched off, the title and skill boxes are plain and every code and skill already kept stays as it is."
msgstr "Առաջարկում է աշխատանքի անվանումներ ESCO-ից՝ մասնագիտությունների եվրոպական դասակարգչից, ձեր լեզվով և ճանաչում է ձեր գրանցած հմտությունները ESCO-ի հմտությունների ցանկով։ Այն կարդում է ֆայլեր, որոնք ադմինիստրատորը մեկ անգամ ներբեռնում է manage.py fetch_esco հրամանով, և ձեր աշխատելու ընթացքում որևէ ծառայության չի դիմում։ Երբ անջատված է, անվանման և հմտության դաշտերը սովորական են, և արդեն պահված բոլոր կոդերն ու հմտությունները մնում են նույնը։"
