#: src/postulo/plugins/writing_basics/__init__.py
msgid "A letter that names nobody"
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Hints about a letter before it goes: one that names neither the company nor the role, a note left from the starter, its length for its kind, a word written twice, several spaces, a very long sentence. It reads the letter as it is stored, asks no service and keeps nothing. Off until an administrator switches it on."
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Length"
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Long sentences"
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Notes left from the starter"
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Repeated words and spaces"
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Says when a note in square brackets, as the starter text writes them, is still in."
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Says when a sentence runs past forty words."
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Says when the letter is longer than its kind usually keeps to on a page: about 400 words for a cover or speculative letter, 150 for a follow-up note, 800 for a motivation letter."
msgstr ""

#: src/postulo/plugins/writing_basics/__init__.py
msgid "Says when the same word is written twice in a row, or several spaces stand where one would do, and offers to put it right."
msgstr ""

#: src/postulo/plugins/writing_basics/checks.py
#, python-format
msgid "The letter does not name the company: neither {{ company }} nor “%(name)s” is in it."
msgstr ""

#: src/postulo/plugins/writing_basics/checks.py
#, python-format
msgid "The letter does not name the role: neither {{ role }} nor “%(role)s” is in it."
msgstr ""

#: src/postulo/plugins/writing_basics/checks.py
#, python-format
msgid "The letter is %(count)d character long, more than the %(limit)d a letter of this kind usually keeps to. The PDF shows how many pages it takes."
msgid_plural "The letter is %(count)d characters long, more than the %(limit)d a letter of this kind usually keeps to. The PDF shows how many pages it takes."
msgstr[0] ""
msgstr[1] ""

#: src/postulo/plugins/writing_basics/checks.py
#, python-format
msgid "The letter is %(count)d word long, more than the %(limit)d a letter of this kind usually keeps to. The PDF shows how many pages it takes."
msgid_plural "The letter is %(count)d words long, more than the %(limit)d a letter of this kind usually keeps to. The PDF shows how many pages it takes."
msgstr[0] ""
msgstr[1] ""

#: src/postulo/plugins/writing_basics/checks.py
#, python-format
msgid "The sentence beginning “%(start)s” is %(count)d word long; a shorter one is easier to read."
