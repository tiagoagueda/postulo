# Copy to .env and adjust. Every variable is optional in development.

# --- core -------------------------------------------------------------------
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# POSTULO_SECRET_KEY=

POSTULO_DEBUG=true
POSTULO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when running behind a reverse proxy on a real domain:
# POSTULO_CSRF_TRUSTED_ORIGINS=https://postulo.example.org

POSTULO_TIME_ZONE=Europe/Paris
POSTULO_LOG_LEVEL=INFO

# Move the admin off a guessable path on a public instance.
# POSTULO_ADMIN_URL=some-private-path/

# --- database ---------------------------------------------------------------
# Defaults to SQLite at data/postulo.sqlite3. For PostgreSQL:
# POSTULO_DATABASE_URL=postgres://postulo:password@localhost:5432/postulo

# --- accounts ---------------------------------------------------------------
# Leave false to keep the instance invite-only.
POSTULO_REGISTRATION_OPEN=false

# --- storage ----------------------------------------------------------------
# POSTULO_MEDIA_ROOT=/var/lib/postulo/media
# POSTULO_STATIC_ROOT=/var/lib/postulo/static

# --- documents --------------------------------------------------------------
# auto | weasyprint | chromium. WeasyPrint is the default and ships with Postulo;
# "auto" prefers it and falls back to Chromium where its system libraries are missing.
# PDF export is optional: without a working renderer everything else still works.
# POSTULO_PDF_BACKEND=auto

# Hand finished downloads to the web server instead of streaming them through Django.
# POSTULO_MEDIA_ACCEL_PREFIX=/protected-media/
# POSTULO_MEDIA_SENDFILE=false

# --- capture ----------------------------------------------------------------
# Postulo honours robots.txt when fetching a posting. Turning this off makes you
# responsible for the requests your instance makes.
# POSTULO_CAPTURE_IGNORE_ROBOTS=false

# --- email ------------------------------------------------------------------
POSTULO_DEFAULT_FROM_EMAIL=postulo@example.org
# POSTULO_EMAIL_HOST=smtp.example.org
# POSTULO_EMAIL_PORT=587
# POSTULO_EMAIL_HOST_USER=
# POSTULO_EMAIL_HOST_PASSWORD=
# POSTULO_EMAIL_USE_TLS=true

# --- https (production only) ------------------------------------------------
# POSTULO_SSL_REDIRECT=true
# POSTULO_HSTS_SECONDS=31536000
