# Postulo's configuration. Copy this file to .env and adjust it. Every variable is optional
# in development; production needs POSTULO_SECRET_KEY and POSTULO_ALLOWED_HOSTS.
#
# Written from src/postulo/core/configuration.py by scripts/configuration_docs.py: change the
# registry and run the script, rather than editing this file. The wiki's Configuration page
# says the same, and `manage.py settings` prints what an instance is actually running with.
#
# How a value is written:
#   boolean   true or false (also yes/no, on/off, 1/0), in any case
#   size      a whole number in the unit the name gives, or 25MB, 2GB (counted in 1024s)
#   duration  a whole number in the unit the name gives, or 90s, 15m, 2h, 7d
#   list      values separated by commas
#   rate      <count>/<s|m|h|d>, such as 30/h; empty or 0 switches the limit off
#   secret    the value itself, or NAME_FILE=/path naming a file that holds it (Docker and
#             Kubernetes secrets); set one or the other, not both

# --- The server ---------------------------------------------------------------------------
# Required in production: POSTULO_SECRET_KEY and POSTULO_ALLOWED_HOSTS.

# The key that signs sessions and derives the key stored credentials are encrypted with.
# Required in production, and refused if it is not a secret: at least 50 characters, at
# least 5 distinct ones, and not a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Do not replace it on a running instance without reading Configuration first: set
# POSTULO_FIELD_KEY to the old one, or the stored credentials become unreadable.
# Secret: text, or POSTULO_SECRET_KEY_FILE naming a file that holds it. Default: unset.
POSTULO_SECRET_KEY=

# Django's debug mode: detailed error pages. Never on a public instance.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false (true in the development
# settings; the production settings ignore it).
POSTULO_DEBUG=true

# The host names this instance answers to.
# A '*' is refused in production: it accepts any Host header. To start anyway while you plan
# the change, set POSTULO_ALLOW_WILDCARD_HOSTS=true.
# List: values separated by commas. Default: localhost,127.0.0.1.
POSTULO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins a form may be posted from, needed behind a reverse proxy on a real domain.
# List: values separated by commas. Default: empty.
# POSTULO_CSRF_TRUSTED_ORIGINS=https://postulo.example.org

# The addresses or networks a reverse proxy may be at; forwarding headers from anywhere else
# are dropped.
# Postulo believes X-Forwarded-Proto and X-Forwarded-For only from these, so an instance
# published straight onto a port cannot be told by a stranger that their request arrived
# over HTTPS, and nobody can choose the address the sign-in limits count them under. A proxy
# on the host reaching the container arrives from the Docker network's gateway; a proxy
# container in the same Compose project arrives from that network. Server settings ->
# Overview shows the address the current request came from, which is what to name here. Set
# it to nothing at all if there is no proxy. The image gives gunicorn the same list.
# List: values separated by commas. Default: 127.0.0.0/8,::1/128.
# POSTULO_TRUSTED_PROXIES=172.18.0.0/16

# The path Django's admin is mounted at; empty, the admin does not exist.
# Server settings covers people, sign-in policy, plugins, email, logs and defaults without
# it; an admin nobody mounted is one nobody can guess at. It has no login of its own: you
# sign in to Postulo and are taken there.
# Text. Default: empty.
# POSTULO_ADMIN_URL=some-private-path/

# Where this instance is reached from outside, for links in messages sent with no request
# around.
# URL. Default: empty.
# POSTULO_PUBLIC_URL=https://postulo.example.org

# Where this instance's code can be had, linked as Source code at the foot of every page.
# The AGPL entitles the people using a modified Postulo you run as a service to its source,
# and this is where that offer points: set it to wherever your code lives. Unset, it is the
# upstream repository.
# URL. Default: https://source.tiagoagueda.com/postulo/postulo.
# POSTULO_SOURCE_URL=https://source.tiagoagueda.com/postulo/postulo

# Your legal notice (an imprint or a contact page), linked at the foot of every page.
# Some countries require one. No link at all when unset.
# URL. Default: empty.
# POSTULO_LEGAL_NOTICE_URL=

# --- Database and cache -------------------------------------------------------------------

# The database, as a URL.
# sqlite:///path or postgres://user@host:port/name.
# URL. Default: SQLite at data/postulo.sqlite3.
# POSTULO_DATABASE_URL=postgres://postulo@localhost:5432/postulo

# The database's password, for one a URL cannot carry.
# A password with a `/`, `?` or `%` in it cannot be written into the URL. Leave it out of
# the URL and give it here instead, exactly as it is. It wins over POSTGRES_PASSWORD where
# both are set.
# Secret: text, or POSTULO_DATABASE_PASSWORD_FILE naming a file that holds it. Default:
# empty.
# POSTULO_DATABASE_PASSWORD=

# The PostgreSQL container's password, read by Postulo too when the URL has none.
# With the PostgreSQL compose file use this one: it passes this same file to its database
# container, which understands only this name, so one line serves both. Mind that it gives
# the database container this whole file, the secret keys included; the threat model says
# why that is accepted.
# Secret: text, or POSTGRES_PASSWORD_FILE naming a file that holds it. Default: empty.
# POSTGRES_PASSWORD=

# The cache, as a URL; by default a table in the database.
# Postulo keeps things there that must be counted the same way by every worker -- how many
# times a password has been got wrong, above all -- so the default is shared and survives a
# restart. Redis or Memcached are faster; anything else makes those counts per worker again.
# URL. Default: dbcache://postulo_cache.
# POSTULO_CACHE_URL=redis://localhost:6379/1

# How many entries the database cache holds before it starts to cull.
# The rate limits and the sign-in lockout live in it, and a cull deletes keys in
# alphabetical order, not the oldest, so the default is far past what honest traffic
# reaches. Not used with Redis or Memcached.
# Integer: a whole number, 1 or more. Default: 200000.
# POSTULO_CACHE_MAX_ENTRIES=200000

# Where Postulo's own allowances are counted, in files, with the database cache.
# Outside any request's transaction, so a charge survives a view that failed.
# Path. Default: data/ratelimit.
# POSTULO_RATELIMIT_DIR=

# --- HTTPS (production only) --------------------------------------------------------------
# Read by the production settings alone.

# Start in production even though POSTULO_ALLOWED_HOSTS contains '*'.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_ALLOW_WILDCARD_HOSTS=false

# Start in production with a secret key that is too weak, while you plan replacing it.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_ALLOW_WEAK_SECRET_KEY=false

# Redirect plain HTTP to HTTPS.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: true.
# POSTULO_SSL_REDIRECT=true

# How long a browser is told to use HTTPS only.
# Duration: a whole number of seconds, or a duration such as 90s, 15m, 2h or 7d, 0 or more.
# Default: 31536000.
# POSTULO_HSTS_SECONDS=31536000

# Whether that applies to every subdomain too.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: true.
# POSTULO_HSTS_INCLUDE_SUBDOMAINS=true

# Ask to be put on the browsers' preload list, which is close to irreversible.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_HSTS_PRELOAD=false

# Send cookies over HTTPS only.
# Turn it off only for an instance reached solely inside a mesh VPN (NetBird, Tailscale),
# where the browser sees plain HTTP but the wire is already encrypted, and turn
# POSTULO_SSL_REDIRECT off with it.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: true.
# POSTULO_SECURE_COOKIES=true

# --- Sign-in and registration -------------------------------------------------------------

# Whether anybody may sign up; off, the instance is invite-only.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
POSTULO_REGISTRATION_OPEN=false

# How long a sign-in code sent by email stays valid.
# Signing in with a code sent by email is an administrator's choice under Server settings ->
# Sign-in. Three minutes is long enough for mail to arrive and short enough that a code left
# in an inbox stops being a key.
# Duration: a whole number of seconds, or a duration such as 90s, 15m, 2h or 7d, 1 or more.
# Default: 180.
# POSTULO_EMAIL_CODE_TIMEOUT=180

# How many wrong tries one sign-in code allows.
# Integer: a whole number, 1 or more. Default: 3.
# POSTULO_EMAIL_CODE_ATTEMPTS=3

# How many times one sign-in code may be sent again.
# Bounded because each is an email somebody may not have asked for.
# Integer: a whole number, 0 or more. Default: 3.
# POSTULO_EMAIL_CODE_RESENDS=3

# The name on the single sign-on button.
# Text. Default: Single sign-on.
# POSTULO_OIDC_NAME=Single sign-on

# The OpenID Connect provider's address; with the client ID, turns single sign-on on.
# URL. Default: empty.
# POSTULO_OIDC_SERVER_URL=https://id.example.org/realms/postulo

# The client ID Postulo has at the provider.
# Text. Default: empty.
# POSTULO_OIDC_CLIENT_ID=

# The client secret Postulo has at the provider.
# Secret: text, or POSTULO_OIDC_CLIENT_SECRET_FILE naming a file that holds it. Default:
# empty.
# POSTULO_OIDC_CLIENT_SECRET=

# Whether somebody new arriving through the provider gets an account.
# Off, single sign-on signs in accounts that exist; the provider is not an invitation.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_OIDC_AUTO_SIGNUP=false

# Whether an address the provider has verified signs somebody in to the local account
# holding it.
# On, single sign-on just works and nobody connects anything by hand. It also means this
# instance takes the provider's word that the person proved they hold that address -- true
# of a Keycloak or Authentik you run, not automatically true of every endpoint that speaks
# OpenID Connect. Off, a person signs in here once and connects the provider from their own
# account page. With a provider and this unset, start-up says so.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_OIDC_LINK_BY_EMAIL=false

# Whether arriving through the provider counts as the second factor.
# Off, because Postulo cannot see how the provider checked anybody: that is your judgement
# about your own provider. It never applies to a password sign-in and it removes nobody's
# app. A passkey already counts on its own. Also settable under Server settings -> Sign-in.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_OIDC_IS_SECOND_FACTOR=false

# --- Email --------------------------------------------------------------------------------
# All of these can be set from Server settings -> Email instead, where they take effect
# without a restart and can be tested before they are saved. Set them here to pin them: the
# page then shows the value read-only and says which variable it came from.

# The address Postulo's own messages are sent from.
# Text. Default: postulo@localhost.
POSTULO_DEFAULT_FROM_EMAIL=postulo@example.org

# The mail server.
# Text. Default: localhost.
# POSTULO_EMAIL_HOST=smtp.example.org

# The mail server's port.
# Integer: a whole number, 1 to 65535. Default: 25.
# POSTULO_EMAIL_PORT=587

# The user name at the mail server.
# Text. Default: empty.
# POSTULO_EMAIL_HOST_USER=

# The password at the mail server.
# Secret: text, or POSTULO_EMAIL_HOST_PASSWORD_FILE naming a file that holds it. Default:
# empty.
# POSTULO_EMAIL_HOST_PASSWORD=

# How the connection to the mail server is encrypted.
# starttls is usually port 587 and ssl port 465. They are not interchangeable: point one at
# the other's port and each waits for the other to speak, which looks exactly like the
# server being down.
# Choice: one of: none, starttls, ssl. Default: starttls (none when POSTULO_EMAIL_USE_TLS is
# false).
# POSTULO_EMAIL_SECURITY=starttls

# The older switch POSTULO_EMAIL_SECURITY replaces: true is starttls, false is none.
# Still honoured, so an existing .env goes on meaning what it meant; it cannot express ssl,
# which is why POSTULO_EMAIL_SECURITY exists.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: true.
# POSTULO_EMAIL_USE_TLS=true

# How long to wait for the mail server.
# Duration: a whole number of seconds, or a duration such as 90s, 15m, 2h or 7d, 1 or more.
# Default: 10.
# POSTULO_EMAIL_TIMEOUT=10

# How the mail server is told who is connecting.
# A relay of your own, Mailcow, Postfix, or Gmail with an app password: leave this alone.
# Microsoft 365 stops accepting passwords for SMTP by default at the end of December 2026;
# after that it has to be xoauth2. See Configuration -> Email in the wiki.
# Choice: one of: password, xoauth2. Default: password.
# POSTULO_EMAIL_AUTH=password

# With xoauth2: whose sign-in the token comes from.
# Choice: one of: microsoft, google, or empty. Default: empty.
# POSTULO_EMAIL_OAUTH_PROVIDER=

# With xoauth2: application (the application sends on its own) or mailbox (signed in once as
# the mailbox).
# Choice: one of: mailbox, application, or empty. Default: empty.
# POSTULO_EMAIL_OAUTH_GRANT=

# With Microsoft: the directory (tenant) ID.
# Text. Default: empty.
# POSTULO_EMAIL_OAUTH_TENANT=

# With xoauth2: the client ID registered with the provider.
# Text. Default: empty.
# POSTULO_EMAIL_OAUTH_CLIENT_ID=

# With xoauth2: the client secret registered with the provider.
# Secret: text, or POSTULO_EMAIL_OAUTH_CLIENT_SECRET_FILE naming a file that holds it.
# Default: empty.
# POSTULO_EMAIL_OAUTH_CLIENT_SECRET=

# --- Logs, metrics and updates ------------------------------------------------------------
# Make a token for /metrics or /logs with `openssl rand -hex 32`; one shorter than 24
# characters is reported at start-up, and ten wrong ones in an hour shut an address out.

# Where Postulo keeps its own log, to be read under Server settings; empty keeps none.
# Everything still goes to the console as well, so `docker logs` is unaffected.
# Path. Default: data/logs.
# POSTULO_LOG_DIR=

# How large one log file grows before the next is started.
# Size: a whole number of bytes, or a size such as 25MB or 2GB (in 1024s), 0 or more.
# Default: 5242880.
# POSTULO_LOG_MAX_BYTES=5242880

# How many full log files are kept behind the current one.
# About 20 MB in all with the defaults.
# Integer: a whole number, 0 or more. Default: 3.
# POSTULO_LOG_BACKUPS=3

# What the console gets: simple, a line a person reads, or json, for a collector.
# The file is always JSON.
# Choice: one of: simple, json. Default: simple.
# POSTULO_LOG_FORMAT=simple

# The least serious record written: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Text. Default: INFO.
POSTULO_LOG_LEVEL=INFO

# Serve the log at /logs for a collector to scrape.
# Off, and a 404 when off, so nothing confirms the endpoint is there. On, it needs a token:
# with no token it refuses to serve. Unlike metrics, a log entry names connections,
# companies and applications, so this is personal data leaving the instance.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_LOGS_ENDPOINT_ENABLED=false

# The token a collector sends to read /logs.
# Secret: text, or POSTULO_LOGS_TOKEN_FILE naming a file that holds it. Default: empty.
# POSTULO_LOGS_TOKEN=

# Serve Prometheus metrics at /metrics.
# Off, and a 404 when off. They carry nothing about anybody: counts of records, work
# waiting, and what has failed. With no token they are readable by whoever can reach the
# instance, which Server settings -> Logs says plainly.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_METRICS_ENABLED=false

# The token a scraper sends to read /metrics.
# Secret: text, or POSTULO_METRICS_TOKEN_FILE naming a file that holds it. Default: empty.
# POSTULO_METRICS_TOKEN=

# Let the scheduler ask once a day whether a newer Postulo exists.
# One request to the address below and to nothing else, never from a page. Off, Server
# settings -> Overview cannot say whether the version it shows is the newest. Postulo makes
# no request on your behalf unless you say so, which is why this is off.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_UPDATE_CHECK=false

# Where the update check asks.
# URL. Default: https://source.tiagoagueda.com/api/v1/repos/postulo/postulo/releases/latest.
# POSTULO_UPDATE_SOURCE=https://source.tiagoagueda.com/api/v1/repos/postulo/postulo/releases/latest

# --- Defaults -----------------------------------------------------------------------------

# The instance's time zone, an IANA name such as Europe/Paris.
# Text. Default: Europe/Paris.
POSTULO_TIME_ZONE=Europe/Paris

# --- Storage ------------------------------------------------------------------------------
# A relative default is under the installation; the image keeps it in /app/data.

# Where uploaded documents are kept. Never served directly.
# The image sets /app/data/media.
# Path. Default: data/media.
# POSTULO_MEDIA_ROOT=/app/data/media

# Where collectstatic writes the stylesheets, scripts and pictures.
# The image sets /app/staticfiles.
# Path. Default: staticfiles.
# POSTULO_STATIC_ROOT=/app/staticfiles

# Hand a download to nginx at this internal location instead of streaming it.
# Text. Default: empty.
# POSTULO_MEDIA_ACCEL_PREFIX=/protected-media/

# Hand a download to Apache's mod_xsendfile instead of streaming it.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_MEDIA_SENDFILE=false

# Let the scheduler remove a file under the media root that no record names.
# Off, that is left to `manage.py prune_media`.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: true.
# POSTULO_MEDIA_SWEEP=true

# How old such a file must be before it is removed.
# Duration: a whole number of hours, or a duration such as 90s, 15m, 2h or 7d, 0 or more.
# Default: 24.
# POSTULO_MEDIA_SWEEP_GRACE_HOURS=24

# How long the scheduler leaves an uploaded file it has checked before reading it again.
# Each file is read against the size and checksum recorded when it arrived, a few on every
# pass. 0 reads them again on every pass. `manage.py verify_media` reads all of them at
# once.
# Duration: a whole number of days, or a duration such as 90s, 15m, 2h or 7d, 0 or more.
# Default: 7.
# POSTULO_SCRUB_EVERY_DAYS=7

# Where `manage.py backup` and Server settings -> Backups write.
# Move it elsewhere if the data volume is the thing being backed up.
# The image sets /app/data/backups.
# Path. Default: data/backups.
# POSTULO_BACKUP_DIR=/app/data/backups

# The largest archive Server settings -> Backups accepts for a restore.
# A reverse proxy in front has its own limit, which has to be raised to match.
# Size: a whole number of megabytes, or a size such as 25MB or 2GB (in 1024s), 1 or more.
# Default: 512.
# POSTULO_BACKUP_UPLOAD_MAX_MB=512

# The largest request body any page but the backup and plugin uploads accepts.
# A longer one is refused with 413 before it is read. Also set client_max_body_size at the
# proxy.
# Size: a whole number of megabytes, or a size such as 25MB or 2GB (in 1024s), 1 or more.
# Default: 25.
# POSTULO_UPLOAD_CEILING_MB=25

# Who may download a backup through the browser.
# administrators is every administrator, operator only the superuser, and console nobody:
# the files are taken from the data volume.
# Choice: one of: administrators, operator, console. Default: administrators.
# POSTULO_BACKUP_DOWNLOAD=administrators

# A key of its own for the stored connection credentials, instead of one derived from
# POSTULO_SECRET_KEY.
# Set it to the old secret key before replacing POSTULO_SECRET_KEY.
# Secret: text, or POSTULO_FIELD_KEY_FILE naming a file that holds it. Default: empty.
# POSTULO_FIELD_KEY=

# --- Documents ----------------------------------------------------------------------------

# What draws a PDF.
# WeasyPrint is the default and ships with Postulo; auto prefers it and falls back to
# Chromium where its system libraries are missing. PDF export is optional: without a working
# renderer everything else still works.
# Choice: one of: auto, weasyprint, chromium. Default: auto.
# POSTULO_PDF_BACKEND=auto

# --- Background work ----------------------------------------------------------------------

# Send the slow work to a worker instead of doing it while the person waits.
# Fetching a posting's page, finding a logo, rendering a PDF, building an export archive,
# telling notifiers. Off by default: one container is the recommended shape for a personal
# instance, and a queue nobody empties is a button that does nothing. Set it together with
# starting the worker, never separately:
#   docker compose -f docker/compose.yml --profile worker up -d
# or, on PostgreSQL, with the file you started with:
#   docker compose -f docker/compose.postgres.yml --profile worker up -d
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_BACKGROUND_WORK=false

# The file the worker touches as it goes round.
# Path. Default: data/worker-heartbeat.
# POSTULO_WORKER_HEARTBEAT=

# The file the scheduler touches at the end of each pass.
# Path. Default: data/scheduler-heartbeat.
# POSTULO_SCHEDULER_HEARTBEAT=

# How long a built export archive waits to be downloaded before it is deleted.
# Duration: a whole number of hours, or a duration such as 90s, 15m, 2h or 7d, 0 or more.
# Default: 24.
# POSTULO_EXPORT_KEEP_HOURS=24

# --- Capture ------------------------------------------------------------------------------
# Keeping pages and ignoring robots.txt can also be set from Server settings -> Capture; set
# them here to pin them.

# Fetch a posting even where robots.txt asks not to.
# On, you are responsible for the requests your instance makes.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_CAPTURE_IGNORE_ROBOTS=false

# Whether a capture may keep the source of the page it was read from.
# Off, because keeping a copy of somebody else's page is a decision to make on purpose. This
# is the instance's half: each person switches it on for their own captures under Settings
# -> Capture, and a no here is final.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_CAPTURE_KEEP_SOURCE=false

# Whether a capture may keep a rendering of the whole page.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_CAPTURE_KEEP_RENDERING=false

# What one kept source may weigh, refused before it is read.
# Size: a whole number of bytes, or a size such as 25MB or 2GB (in 1024s). Default: 2000000.
# POSTULO_CAPTURE_SOURCE_MAX_BYTES=2000000

# What one kept rendering may weigh, refused before it is read.
# Size: a whole number of bytes, or a size such as 25MB or 2GB (in 1024s). Default:
# 10485760.
# POSTULO_CAPTURE_RENDERING_MAX_BYTES=10485760

# What one account's kept pages may weigh together.
# Size: a whole number of bytes, or a size such as 25MB or 2GB (in 1024s). Default:
# 1073741824.
# POSTULO_CAPTURE_ACCOUNT_MAX_BYTES=1073741824

# How long the page of a capture that never became a listing is kept; 0 keeps them all.
# Duration: a whole number of days, or a duration such as 90s, 15m, 2h or 7d. Default: 30.
# POSTULO_CAPTURE_PAGE_KEEP_DAYS=30

# --- What the server may dial -------------------------------------------------------------

# Whether a connection (a Paperless on your network, a mail relay) may reach a private or
# local address.
# It is one switch for the whole instance: on, every account can aim a webhook or an
# own-mail connection at any address the server can reach and read what the Test button says
# back. Leave it off on an instance with more than one person; there is no per-address
# allowlist.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_CONNECTIONS_ALLOW_PRIVATE=false

# The ports a fetch of something public (a posting, a link check, a logo) may dial.
# The ordinary web ports, so an account cannot use the server to probe other ports of a
# public host. A connection is not limited by this list. * lifts the limit.
# List: values separated by commas. Default: 80,443,8080,8443.
# POSTULO_FETCH_PORTS=80,443,8080,8443

# Whether outbound requests honour HTTP_PROXY, HTTPS_PROXY and NO_PROXY.
# A proxy tunnel verifies the certificate against the address the destination check pinned,
# not the name. Only for an instance whose sole way out is a proxy.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_OUTBOUND_USE_ENV_PROXY=false

# --- Maps and places ----------------------------------------------------------------------
# The tiles and the geocoder can also be set from Server settings -> Maps when not set here.

# Where the companies' map takes its tiles: OpenStreetMap, your own, or none.
# osm is OpenStreetMap's public tiles, fetched by the viewer's browser; custom the address
# below; none the world's outline, nothing fetched.
# Choice: one of: osm, custom, none. Default: osm.
# POSTULO_MAP_TILES=osm

# With custom tiles: the tile address, https:// or a path on this instance.
# URL. Default: empty.
# POSTULO_MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png

# With custom tiles: the credit shown on the map.
# Text. Default: empty.
# POSTULO_MAP_TILE_ATTRIBUTION=

# Whether an address with a street is pinned at that street, and by which service.
# Set here, the choice is your word that the service may be sent the addresses on the map,
# people's and contacts' included.
# Choice: one of: off, nominatim, photon, addok, or empty. Default: off.
# POSTULO_GEOCODER=

# The geocoding service's base address.
# URL. Default: empty.
# POSTULO_GEOCODER_URL=

# Where the GeoNames tables the map places locations from are read and kept.
# The container fetches the city table here on first start; what it keeps is the lookup
# built from it (geonames-cities1000.sqlite) and the country table.
# The image sets /app/data/geonames.
# Path. Default: src/postulo/jobs/data.
# POSTULO_GEOLOCATIONS_DIR=/app/data/geonames

# Also fetch the GeoNames postal codes, so an address is placed at its postcode.
# Boolean: true or false (also yes/no, on/off, 1/0). Default: false.
# POSTULO_GEONAMES_POSTCODES=false

# Where the ESCO classification of occupations and skills is read from.
# The image sets /app/data/esco.
# Path. Default: src/postulo/jobs/data.
# POSTULO_ESCO_DIR=/app/data/esco

# --- Plugins ------------------------------------------------------------------------------

# Where plugins installed through the interface live.
# The image sets /app/data/plugins.
# Path. Default: data/plugins.
# POSTULO_PLUGINS_DIR=/app/data/plugins

# Catalogues an administrator may install plugins from, as name|url|public-key entries
# separated by commas.
# Empty: an index is a list of code to run, so pointing at one is a decision.
# Text. Default: empty.
# POSTULO_PLUGIN_CATALOGUES=

# --- Rate limits --------------------------------------------------------------------------
# What one account may make the server do: <count>/<s|m|h|d>, such as 30/h; empty or 0
# switches a limit off. A rate is named for what it bounds, so its name begins with that and
# not with an area.

# Captures one account may make.
# The tightest, because it is the only one that makes this server fetch an address somebody
# else chose. A capture that arrives with its own page source is not counted.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 30/h.
# POSTULO_CAPTURE_RATE=30/h

# Other fetches of an address somebody typed: link checks, logo addresses, Find logo.
# Counted once per address, so Check all on forty links spends forty.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 300/h.
# POSTULO_FETCH_RATE=300/h

# Fetch from Wikidata presses, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 60/h.
# POSTULO_WIKIDATA_RATE=60/h

# DOI and ORCID look-ups together, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 20/h.
# POSTULO_LOOKUP_RATE=20/h

# Look-ups in a company register, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 30/h.
# POSTULO_REGISTER_LOOKUP_RATE=30/h

# Calls one API token may make.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 600/h.
# POSTULO_API_RATE=600/h

# Calls every token of one account may make together.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 3000/h.
# POSTULO_API_ACCOUNT_RATE=3000/h

# API tokens one account may make; each is a way in with no second factor.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 10/h.
# POSTULO_API_TOKEN_RATE=10/h

# Messages one account may send as itself.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 60/h.
# POSTULO_OUTBOX_RATE=60/h

# Reads of /logs and /metrics, per calling address.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 120/h.
# POSTULO_ENDPOINT_RATE=120/h

# Confirmations one account may ask to be sent again, across every kind of contact.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 5/h.
# POSTULO_CONFIRMATION_RATE=5/h

# How often one account may be told a telephone number is already recorded here.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 20/h.
# POSTULO_NUMBER_RATE=20/h

# Text messages, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 5/h.
# POSTULO_TEXT_RATE=5/h

# Text messages, per receiving number.
# A stranger whose number was mistyped into a form has no way to make it stop.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 3/h.
# POSTULO_TEXT_PER_NUMBER_RATE=3/h

# Recovery links one administrator may issue.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 10/h.
# POSTULO_RECOVERY_RATE=10/h

# How often one account may be told its sharer already has a company by a name.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 20/h.
# POSTULO_COMPANY_NAME_RATE=20/h

# Usernames one account may try to change to.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 10/h.
# POSTULO_USERNAME_RATE=10/h

# People one account may look up on a record's Sharing page.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 20/h.
# POSTULO_SHARE_LOOKUP_RATE=20/h

# Tests of a connection, or of the mail settings, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 10/h.
# POSTULO_CONNECTION_TEST_RATE=10/h

# Sync now presses, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 20/h.
# POSTULO_CONNECTION_SYNC_RATE=20/h

# Questions to a sync connection's plugin from its Pairing page, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 120/h.
# POSTULO_CONNECTION_PAIRING_RATE=120/h

# Suggestions the skill box asks for as somebody types, per account.
# Rate: <count>/<s|m|h|d>, such as 30/h; empty or 0 for no limit. Default: 600/h.
# POSTULO_SUGGESTION_RATE=600/h

# --- The container ------------------------------------------------------------------------
# Read by the image's start-up script and by the programs it starts.

# 1 stops the container fetching the GeoNames city tables on its first start.
# The download (a few megabytes, from download.geonames.org) is the one request made with
# nobody asking for it. Skipped, put geonames-cities1000.txt and geonames-countryinfo.txt in
# POSTULO_GEOLOCATIONS_DIR by hand to have the map anyway.
# Boolean: 1 to switch it on or 0 to leave it off, and nothing else. Default: false.
# POSTULO_SKIP_GEONAMES=false

# 1 stops the container applying migrations as it starts.
# The compose files set it on the scheduler and the worker, which start after the web
# container.
# Boolean: 1 to switch it on or 0 to leave it off, and nothing else. Default: false.
# POSTULO_SKIP_MIGRATE=false

# 1 stops the container installing again the plugins the data volume lists.
# Boolean: 1 to switch it on or 0 to leave it off, and nothing else. Default: false.
# POSTULO_SKIP_PLUGIN_SYNC=false

# gunicorn's own options, read as if typed on its command line.
# Setting it replaces the image's whole string, so repeat anything you want to keep. The
# bind address, the worker count and the log destinations are in the image's command and are
# not affected. Two minutes rather than gunicorn's thirty seconds: drawing a PDF on a small
# machine can take longer. See Configuration in the wiki.
# The image sets --timeout 120 --max-requests 500 --max-requests-jitter 50.
# Text. Default: empty.
# GUNICORN_CMD_ARGS=

# The addresses gunicorn believes forwarding headers from.
# The container gives gunicorn POSTULO_TRUSTED_PROXIES unless you set this.
# List: values separated by commas. Default: POSTULO_TRUSTED_PROXIES.
# FORWARDED_ALLOW_IPS=
